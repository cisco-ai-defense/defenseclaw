+/// Private contributor adapter: export the existing x86_64 default-deny BPF
+/// with all socket creation denied, including AF_UNIX. No filter is installed
+/// in this process and no backend, filesystem or resource limit is selected.
+/// The caller must separately enforce those policy components and arrange
+/// no_new_privs plus filter installation before any workload instruction.
+pub fn export_offline_mxc_bpf(policy: &ProcessPolicy) -> Result<Vec<u8>, String> {
+    let mut policy = policy.clone();
+    for syscall in ["socket", "socketpair"] {
+        if !policy.blocked_syscalls.iter().any(|name| name == syscall) {
+            policy.blocked_syscalls.push(syscall.to_owned());
+        }
+    }
+    let filter =
+        prepare_seccomp_with_options(&policy, SeccompOptions::deny_network_socket_domains())?;
+    Ok(filter.export_bpf_bytes())
+}
