+        return Err(refused());
+    }
+    let mut token = HANDLE::default();
+    let opened = unsafe { OpenProcessToken(GetCurrentProcess(), 8, &mut token) };
+    if token.0.is_null() || token.0 as isize == -1 {
+        return Err(refused());
+    }
+    let token = unsafe { OwnedHandle::from_raw_handle(token.0) };
+    if opened == 0 {
+        return Err(refused());
+    }
