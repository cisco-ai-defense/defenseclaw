+// Contributor-only ownership adapter. The shared AXIS Owner remains the only
+// event-loop/controller. This value reuses the existing native child and Job.
+pub struct OwnedPsecProcess {
+    child: BaseChild,
+    _files: Vec<std::fs::File>,
+    stop_requested: bool,
+    code: Option<i32>,
+}
+#[repr(C)]
+struct OwnedJobAccounting {
+    times: [i64; 4],
+    faults: u32,
+    total: u32,
+    active: u32,
+    terminated: u32,
+}
+#[link(name = "kernel32")]
+unsafe extern "system" {
+    #[link_name = "QueryInformationJobObject"]
+    fn owned_query_job(
+        job: HANDLE,
+        class: u32,
+        output: *mut c_void,
+        size: u32,
+        used: *mut u32,
+    ) -> i32;
+}
+impl OwnedPsecProcess {
+    fn empty(&self) -> std::io::Result<bool> {
+        let job = self
+            .child
+            .job
+            .as_ref()
+            .ok_or_else(|| std::io::Error::other("owned PSEC Job absent"))?;
+        let mut accounting: OwnedJobAccounting = unsafe { std::mem::zeroed() };
+        let mut used = 0;
+        if unsafe {
+            owned_query_job(
+                HANDLE(job.handle_value() as *mut c_void),
+                1,
+                (&mut accounting as *mut OwnedJobAccounting).cast(),
+                std::mem::size_of::<OwnedJobAccounting>() as u32,
+                &mut used,
+            )
+        } == 0
+            || used != std::mem::size_of::<OwnedJobAccounting>() as u32
+        {
+            return Err(std::io::Error::other("owned PSEC Job accounting refused"));
+        }
+        Ok(accounting.active == 0)
+    }
+    pub fn stop(&mut self) -> std::io::Result<()> {
+        self.stop_requested = true;
+        let job = self
+            .child
+            .job
+            .as_ref()
+            .ok_or_else(|| std::io::Error::other("owned PSEC Job absent"))?;
+        let job_result = job.terminate(u32::MAX);
+        let root = unsafe { WaitForSingleObject(self.child.process.get(), 0) };
+        let root_result = if root == WAIT_TIMEOUT {
+            unsafe { TerminateProcess(self.child.process.get(), u32::MAX) }
+                .map_err(|_| std::io::Error::other("owned PSEC root stop refused"))
+        } else if root == WAIT_OBJECT_0 {
+            Ok(())
+        } else {
+            Err(std::io::Error::other("owned PSEC root wait refused"))
+        };
+        if job_result.is_err() || root_result.is_err() {
+            return Err(std::io::Error::other("owned PSEC stop incomplete"));
+        }
+        Ok(())
+    }
+    pub fn try_wait(&mut self) -> std::io::Result<Option<i32>> {
+        let wait = unsafe { WaitForSingleObject(self.child.process.get(), 0) };
+        if wait == WAIT_TIMEOUT {
+            return Ok(None);
+        }
+        if wait != WAIT_OBJECT_0 {
+            return Err(std::io::Error::other("owned PSEC root wait refused"));
+        }
+        if self.code.is_none() {
+            let mut code = 0;
+            unsafe { GetExitCodeProcess(self.child.process.get(), &mut code) }
+                .map_err(|_| std::io::Error::other("owned PSEC root result refused"))?;
+            self.code = Some(code as i32);
+        }
+        // Root exit alone is insufficient: stop remaining descendants, then
+        // observe Job active0 with a nonblocking accounting query before exit.
+        if !self.stop_requested {
+            self.stop()?;
+        }
+        if !self.empty()? {
+            return Ok(None);
+        }
+        self.child.security_environment.take();
+        Ok(self.code)
+    }
+}
+impl Drop for OwnedPsecProcess {
+    fn drop(&mut self) {
+        // No wait, thread join, or new launch is hidden here. The exact owned
+        // Job's kill-on-close plus the independent Go outer Job contain error
+        // exits. Only try_wait above can establish normal teardown completion.
+        let _ = self.stop();
+    }
+}
+impl BaseContainerRunner {
+    pub(crate) fn spawn_owned_psec(
+        &mut self,
+        request: ExecutionRequest,
+        argv: crate::mxc_common::literal_argv::LiteralArgv,
+        custody: LocalExecutableCustody,
+        files: Vec<std::fs::File>,
+        stdio: crate::owned_windows_psec::OwnedWindowsStdio,
+    ) -> Result<OwnedPsecProcess, ScriptResponse> {
+        crate::mxc_common::validator::validate_argv_common(&request, &argv)?;
+        self.validate(&request)?;
+        windows_literal_argv_buffers(&argv)?;
+        crate::owned_windows_psec::validate_stdio(&stdio)
+            .map_err(|_| ScriptResponse::rejected("owned synchronous workload stdio refused"))?;
+        let mut logger = Logger::new(crate::mxc_common::logger::Mode::Buffer);
+        let child = self.spawn_base(
+            &request,
+            &mut logger,
+            false,
+            Some(&argv),
+            Some(&custody),
+            Some(&stdio),
+        )?;
+        Ok(OwnedPsecProcess {
+            child,
+            _files: files,
+            stop_requested: false,
+            code: None,
+        })
+    }
+}
