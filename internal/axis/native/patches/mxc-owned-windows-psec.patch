+fn private_root(file: &File) -> io::Result<()> {
+    use std::os::windows::io::FromRawHandle;
+    let mut thread = HANDLE::default();
+    let opened = unsafe { OpenThreadToken(GetCurrentThread(), 8, 1, &mut thread) };
+    let thread_error = unsafe { GetLastError() };
+    let thread_owner = if !thread.0.is_null() && thread.0 as isize != -1 {
+        Some(unsafe { OwnedHandle::from_raw_handle(thread.0) })
+    } else {
+        None
+    };
