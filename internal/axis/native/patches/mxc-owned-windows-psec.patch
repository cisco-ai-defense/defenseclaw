+    let mut used = 0;
+    if unsafe {
+        GetTokenInformation(
+            HANDLE(token.as_raw_handle()),
+            1,
+            buffer.as_mut_ptr().cast(),
+            1024,
+            &mut used,
+        )
+    } == 0
+        || used < 16
+        || used > 1024
+    {
+        return Err(refused());
+    }
+    let user = buffer[0] as *const c_void;
+    let start = buffer.as_ptr() as usize;
+    let user_address = user as usize;
+    if user_address < start + 16
+        || user_address
+            .checked_add(8)
+            .is_none_or(|p| p > start + used as usize)
+        || unsafe { IsValidSid(user) } == 0
+    {
+        return Err(refused());
+    }
+    let length = unsafe { GetLengthSid(user) } as usize;
+    if !(8..=68).contains(&length)
+        || user_address
+            .checked_add(length)
+            .is_none_or(|p| p > start + used as usize)
+    {
+        return Err(refused());
+    }
+    let mut owner = std::ptr::null_mut();
+    let mut acl = std::ptr::null_mut();
+    let mut descriptor = std::ptr::null_mut();
+    let status = unsafe {
+        GetSecurityInfo(
+            HANDLE(file.as_raw_handle()),
+            1,
+            5,
+            &mut owner,
+            std::ptr::null_mut(),
+            &mut acl,
+            std::ptr::null_mut(),
+            &mut descriptor,
+        )
+    };
+    let _descriptor = Descriptor(descriptor);
+    if status != 0
+        || descriptor.is_null()
+        || owner.is_null()
+        || acl.is_null()
+        || unsafe { IsValidSid(owner) } == 0
+        || unsafe { EqualSid(user, owner) } == 0
+    {
+        return Err(refused());
+    }
+    let mut control = 0;
+    let mut revision = 0;
+    if unsafe { GetSecurityDescriptorControl(descriptor, &mut control, &mut revision) } == 0
+        || control & 0x1004 != 0x1004
+        || revision != 1
+    {
+        return Err(refused());
+    }
+    // GetSecurityInfo returns one complete self-relative descriptor. The OS
+    // parser owns pointer bounds; the exact two ordinary allow ACEs are checked
+    // before SID comparison, with no path- or SID-bearing error formatting.
+    let acl_header = unsafe { &*acl };
+    if acl_header.revision != 2 || acl_header.count != 2 || acl_header.size < 8 {
+        return Err(refused());
+    }
+    let acl_start = acl as usize;
+    let acl_end = acl_start
+        .checked_add(acl_header.size as usize)
+        .ok_or_else(refused)?;
+    // Native SID storage must retain DWORD alignment (this target is amd64).
+    let system = [0x00000101u32, 0x05000000, 18];
+    let mut user_seen = false;
+    let mut system_seen = false;
+    for index in 0..2 {
+        let mut ace = std::ptr::null_mut();
+        if unsafe { GetAce(acl, index, &mut ace) } == 0 || ace.is_null() {
+            return Err(refused());
+        }
+        let address = ace as usize;
+        if address < acl_start + 8 || address.checked_add(8).is_none_or(|end| end > acl_end) {
+            return Err(refused());
+        }
+        let a = unsafe { &*ace };
+        if a.kind != 0
+            || a.flags & !3 != 0
+            || a.size < 16
+            || a.size % 4 != 0
+            || address
+                .checked_add(a.size as usize)
+                .is_none_or(|end| end > acl_end)
+            || a.access != 0x1f01ff
+        {
+            return Err(refused());
+        }
+        let sid = unsafe { ace.cast::<u8>().add(8) }.cast::<c_void>();
+        if unsafe { IsValidSid(sid) } == 0 {
+            return Err(refused());
+        }
+        let sid_length = unsafe { GetLengthSid(sid) } as usize;
+        if !(8..=68).contains(&sid_length) || sid_length + 8 != a.size as usize {
+            return Err(refused());
+        }
+        if unsafe { EqualSid(sid, user) } != 0 && !user_seen {
+            user_seen = true;
+        } else if unsafe { EqualSid(sid, system.as_ptr().cast()) } != 0 && !system_seen {
+            system_seen = true;
+        } else {
+            return Err(refused());
+        }
+    }
+    if !user_seen || !system_seen {
+        return Err(refused());
+    }
+    Ok(())
+}
