+#define OWNED_MOUNTINFO_LIMIT (4 * 1024 * 1024)
+#define OWNED_MOUNTINFO_ENTRIES 4096
+#define OWNED_IMAGE_LIMIT ((off_t) 512 * 1024 * 1024)
+
+static bool
+owned_path_valid (const char *path, bool locator)
+{
+  const char *part;
+  const char *end;
+  if (path == NULL || path[0] != '/' || strlen (path) >= PATH_MAX)
+    return FALSE;
+  if (locator && (strstr (path, " (deleted)") != NULL || strstr (path, "(unreachable)") != NULL))
+    return FALSE;
+  if (strcmp (path, "/") == 0)
+    return TRUE;
+  for (part = path + 1; *part != 0; part = end + 1)
+    {
+      size_t size;
+      end = strchr (part, '/');
+      if (end == NULL)
+        end = part + strlen (part);
+      size = end - part;
+      if (size == 0 || (size == 1 && part[0] == '.') ||
+          (size == 2 && part[0] == '.' && part[1] == '.'))
+        return FALSE;
+      if (locator)
+        for (const unsigned char *p = (const unsigned char *) part;
+             p < (const unsigned char *) end; p++)
+          if (*p < 32 || *p == 127)
+            return FALSE;
+      if (*end == 0)
+        return TRUE;
+      if (end[1] == 0)
+        return FALSE;
+    }
+  return FALSE;
+}
+
+static bool
+owned_device_number (const char *text)
+{
+  const char *colon = strchr (text, ':');
+  char *end;
+  unsigned long long major, minor;
+  if (colon == NULL || colon == text || colon[1] == 0 || strchr (colon + 1, ':') != NULL)
+    return FALSE;
+  for (const char *p = text; *p != 0; p++)
+    if (p != colon && (*p < '0' || *p > '9'))
+      return FALSE;
+  errno = 0;
+  major = strtoull (text, &end, 10);
+  if (errno != 0 || end != colon || major > UINT_MAX)
+    return FALSE;
+  errno = 0;
+  minor = strtoull (colon + 1, &end, 10);
+  return errno == 0 && *end == 0 && minor <= UINT_MAX;
+}
+
+static bool
+owned_number (const char *text, uint64_t *number)
+{
+  char *end;
+  unsigned long long value;
+  if (text[0] < '0' || text[0] > '9')
+    return FALSE;
+  errno = 0;
+  value = strtoull (text, &end, 10);
+  if (errno != 0 || *end != 0 || value == 0)
+    return FALSE;
+  *number = value;
+  return TRUE;
+}
+
+/* mountinfo escapes exactly these four bytes. Unknown/truncated escapes fail,
+ * rather than changing where a mountpoint appears relative to the grant. */
+static bool
+owned_decode_mount_path (char *text, bool require_path)
+{
+  char *output = text;
+  for (char *input = text; *input != 0; input++)
+    {
+      if (*input != '\\')
+        *output++ = *input;
+      else
+        {
+          if (strncmp (input, "\\040", 4) == 0)
+            *output++ = ' ';
+          else if (strncmp (input, "\\011", 4) == 0)
+            *output++ = '\t';
+          else if (strncmp (input, "\\012", 4) == 0)
+            *output++ = '\n';
+          else if (strncmp (input, "\\134", 4) == 0)
+            *output++ = '\\';
+          else
+            return FALSE;
+          input += 3;
+        }
+    }
+  *output = 0;
+  return *text != 0 && (!require_path || owned_path_valid (text, FALSE));
+}
+
+/* No st_dev-only topology test: bind mounts can share device and inode. Parse
+ * the complete bounded namespace inventory, require a reachable source mount
+ * ID and refuse every nested mountpoint, including same-filesystem aliases. */
+static bool
+owned_mountinfo_admits (const char *inventory, const char *locator, uint64_t source_mount_id)
+{
+  cleanup_free char *copy = NULL;
+  uint64_t seen[OWNED_MOUNTINFO_ENTRIES];
+  size_t count = 0;
+  bool found = FALSE;
+  char *line;
+  char *next_line;
+  size_t length = strlen (inventory);
+  if (length == 0 || length > OWNED_MOUNTINFO_LIMIT || inventory[length - 1] != '\n' ||
+      !owned_path_valid (locator, TRUE))
+    return FALSE;
+  copy = xstrdup (inventory);
+  line = copy;
+  while ((next_line = strchr (line, '\n')) != NULL)
+    {
+      char *fields[64];
+      size_t fields_count = 0;
+      size_t separator = 0;
+      char *cursor = line;
+      char *field;
+      uint64_t mount_id, parent_id;
+      *next_line = 0;
+      if (next_line - line > 65536 || count == OWNED_MOUNTINFO_ENTRIES)
+        return FALSE;
+      for (const unsigned char *p = (const unsigned char *) line; *p != 0; p++)
+        if (*p < 32 || *p == 127)
+          return FALSE;
+      while ((field = strsep (&cursor, " ")) != NULL)
+        {
+          if (*field == 0 || fields_count == 64)
+            return FALSE;
+          if (strcmp (field, "-") == 0)
+            {
+              if (separator != 0)
+                return FALSE;
+              separator = fields_count;
+            }
+          fields[fields_count++] = field;
+        }
+      if (fields_count < 10 || separator < 6 || separator + 4 != fields_count ||
+          !owned_number (fields[0], &mount_id) || !owned_number (fields[1], &parent_id) ||
+          !owned_device_number (fields[2]) ||
+          !owned_decode_mount_path (fields[3], FALSE) || !owned_decode_mount_path (fields[4], TRUE))
+        return FALSE;
+      for (size_t i = 0; i < count; i++)
+        if (seen[i] == mount_id)
+          return FALSE;
+      seen[count++] = mount_id;
+      if (mount_id == source_mount_id)
+        {
+          if (!has_path_prefix (locator, fields[4]))
+            return FALSE;
+          found = TRUE;
+        }
+      if (strcmp (locator, fields[4]) != 0 && has_path_prefix (fields[4], locator))
+        return FALSE;
+      line = next_line + 1;
+    }
+  return found && *line == 0;
+}
+
+static char *
+owned_mountinfo_snapshot (void)
+{
+  cleanup_fd int fd = openat (proc_fd, "self/mountinfo", O_RDONLY | O_CLOEXEC);
+  char *data = xmalloc (OWNED_MOUNTINFO_LIMIT + 1);
+  size_t used = 0;
+  if (fd < 0)
+    die_with_error ("Can't inspect owned source mount topology");
+  for (;;)
+    {
+      ssize_t got = TEMP_FAILURE_RETRY (read (fd, data + used, OWNED_MOUNTINFO_LIMIT + 1 - used));
+      if (got < 0)
+        die_with_error ("Can't read owned source mount topology");
+      if (got == 0)
+        break;
+      used += got;
+      if (used > OWNED_MOUNTINFO_LIMIT)
+        die ("Owned source mount topology exceeds its bound");
+    }
+  if (used == 0 || memchr (data, 0, used) != NULL || data[used - 1] != '\n')
+    die ("Owned source mount topology is truncated or invalid");
+  data[used] = 0;
+  return data;
+}
+
+static uint64_t
+owned_mount_id (int fd)
+{
+  struct statx identity = { 0 };
+  if (syscall (SYS_statx, fd, "", AT_EMPTY_PATH | AT_NO_AUTOMOUNT, STATX_MNT_ID, &identity) != 0 ||
+      !(identity.stx_mask & STATX_MNT_ID) || identity.stx_mnt_id == 0)
+    die ("Owned source requires a supported exact mount identity");
+  return identity.stx_mnt_id;
+}
+
+static uint64_t
+owned_reopen_resolve (void)
+{
+  /* No lookup may trigger I/O/revalidation or an intermediate automount,
+   * especially while examining the original namespace. EAGAIN is refusal;
+   * never retry with a weaker resolution policy. */
+  return RESOLVE_BENEATH | RESOLVE_NO_SYMLINKS | RESOLVE_NO_MAGICLINKS | RESOLVE_CACHED;
+}
+
+static int
+owned_reopen (int root_fd, const char *locator)
+{
+  struct open_how how = {
+    .flags = O_PATH | O_CLOEXEC | O_NOFOLLOW,
+    .resolve = owned_reopen_resolve (),
+  };
+  if (!owned_path_valid (locator, TRUE))
+    die ("Owned source locator is not representable");
+  if (strcmp (locator, "/") == 0)
+    return fcntl (root_fd, F_DUPFD_CLOEXEC, 3);
+  return syscall (SYS_openat2, root_fd, locator + 1, &how, sizeof (how));
+}
+
+static bool
+owned_preserves_flags (unsigned long original, unsigned long local)
+{
+  /* Include unknown restrictive flags too, rather than keeping a partial
+   * hand-maintained subset that might accidentally omit NOEXEC. */
+  return (original & ~local) == 0;
+}
+
+static uint64_t
+owned_source_attribute_set (bool readonly, unsigned long original)
+{
+  /* Clone preserves mount attributes; reinforce these restrictions explicitly
+   * as well, including a source whose filesystem was initially readonly. */
+  return MOUNT_ATTR_NOSUID | MOUNT_ATTR_NODEV |
+         ((readonly || (original & ST_RDONLY)) ? MOUNT_ATTR_RDONLY : 0) |
+         ((original & ST_NOEXEC) ? MOUNT_ATTR_NOEXEC : 0);
+}
+
+static bool
+owned_source_matches (SetupOp *op, int fd)
+{
+  struct stat value;
+  struct statfs filesystem;
+  struct statvfs flags;
+  return fstat (fd, &value) == 0 && fstatfs (fd, &filesystem) == 0 && fstatvfs (fd, &flags) == 0 &&
+         value.st_dev == op->owned_original_stat.st_dev && value.st_ino == op->owned_original_stat.st_ino &&
+         (value.st_mode & S_IFMT) == (op->owned_original_stat.st_mode & S_IFMT) &&
+         filesystem.f_type == op->owned_original_fs.f_type &&
+         memcmp (&filesystem.f_fsid, &op->owned_original_fs.f_fsid, sizeof (filesystem.f_fsid)) == 0 &&
+         owned_preserves_flags (op->owned_original_flags, flags.f_flag);
+}
+
+static void
+owned_capture_original_sources (void)
+{
+  cleanup_free char *before = owned_mountinfo_snapshot ();
+  cleanup_free char *after = NULL;
+  owned_original_root_fd = open ("/", O_PATH | O_DIRECTORY | O_NOFOLLOW | O_CLOEXEC);
+  if (owned_original_root_fd < 0)
+    die_with_error ("Can't retain original source root");
+  for (SetupOp *op = ops; op != NULL; op = op->next)
+    if (op->type == SETUP_OWNED_FD_MOUNT || op->type == SETUP_OWNED_RO_FD_MOUNT)
+      {
+        cleanup_fd int reachable = -1;
+        struct statvfs flags;
+        char descriptor[64];
+        char locator[PATH_MAX + 1];
+        ssize_t length;
+        uint64_t mount_id;
+        if (fstat (op->fd, &op->owned_original_stat) != 0 ||
+            fstatfs (op->fd, &op->owned_original_fs) != 0 || fstatvfs (op->fd, &flags) != 0)
+          die_with_error ("Can't inspect original owned source");
+        op->owned_original_flags = flags.f_flag;
+        snprintf (descriptor, sizeof (descriptor), "self/fd/%d", op->fd);
+        length = readlinkat (proc_fd, descriptor, locator, PATH_MAX);
+        if (length <= 0 || length >= PATH_MAX)
+          die ("Owned source locator is unavailable or truncated");
+        locator[length] = 0;
+        /* bwrap stages a fresh tmpfs at /tmp. A covering source would gain
+         * a nested setup mount after the no-submount check. Descendant source
+         * descriptors do not copy a mount attached above their own root. */
+        if (has_path_prefix ("/tmp", locator))
+          die ("Owned source must not cover the private staging mountpoint");
+        reachable = owned_reopen (owned_original_root_fd, locator);
+        if (reachable < 0)
+          die_with_error ("Owned source namespace-local reopen failed");
+        if (!owned_source_matches (op, reachable))
+          die ("Owned source namespace-local object or restrictions differ");
+        /* The trusted private factory may have cloned its mount namespace
+         * before this executable. An imported FD still holds the old mount;
+         * copy_mnt_ns does not translate its file path to the cloned mount ID.
+         * Keep that FD as object/flag authority, but inspect the actual view
+         * reopened in our current namespace, which is the only view cloned.
+         * This requires the factory's clone-only origin/idmap provenance;
+         * matching an arbitrary foreign FD's inode is not that provenance. */
+        mount_id = owned_mount_id (reachable);
+        if (!owned_mountinfo_admits (before, locator, mount_id))
+          die ("Owned source namespace-local topology is unsupported");
+        op->source = xstrdup (locator);
+      }
+  after = owned_mountinfo_snapshot ();
+  if (strcmp (before, after) != 0)
+    die ("Original owned source mount topology changed during admission");
+}
+
+static void
+owned_require_new_namespace (void)
+{
+  cleanup_fd int active = openat (proc_fd, "self/ns/mnt", O_RDONLY | O_CLOEXEC);
+  struct stat original, current;
+  if (original_mount_ns_fd < 0 || active < 0 || fstat (original_mount_ns_fd, &original) != 0 ||
+      fstat (active, &current) != 0 ||
+      (original.st_dev == current.st_dev && original.st_ino == current.st_ino))
+    die ("Owned setup requires a held distinct private mount namespace");
+}
+
+static void
+owned_prepare_local_sources (void)
+{
+  cleanup_free char *before = owned_mountinfo_snapshot ();
+  cleanup_free char *after = NULL;
+  owned_local_root_fd = open ("/", O_PATH | O_DIRECTORY | O_NOFOLLOW | O_CLOEXEC);
+  if (owned_local_root_fd < 0)
+    die_with_error ("Can't retain namespace-local source root");
+  for (SetupOp *op = ops; op != NULL; op = op->next)
+    if (op->type == SETUP_OWNED_FD_MOUNT || op->type == SETUP_OWNED_RO_FD_MOUNT)
+      {
+        op->owned_local_fd = owned_reopen (owned_local_root_fd, op->source);
+        if (op->owned_local_fd < 0 || !owned_source_matches (op, op->owned_local_fd) ||
+            !owned_mountinfo_admits (before, op->source, owned_mount_id (op->owned_local_fd)))
+          die ("Namespace-local owned source identity or topology differs");
+      }
+  after = owned_mountinfo_snapshot ();
+  if (strcmp (before, after) != 0)
+    die ("Private owned source mount topology changed during admission");
+}
+
+static bool
+owned_image_sealed (int fd, const struct stat *expected)
+{
+  struct stat value;
+  int seals = fcntl (fd, F_GET_SEALS);
+  int required = F_SEAL_SEAL | F_SEAL_SHRINK | F_SEAL_GROW | F_SEAL_WRITE;
+  return fstat (fd, &value) == 0 && S_ISREG (value.st_mode) && value.st_size >= 20 &&
+         value.st_size <= OWNED_IMAGE_LIMIT && (value.st_mode & 06000) == 0 &&
+         value.st_dev == expected->st_dev && value.st_ino == expected->st_ino &&
+         value.st_size == expected->st_size && seals >= 0 && (seals & required) == required;
+}
+
+static void
+owned_copy_image (int source, int target, const struct stat *expected)
+{
+  unsigned char input[16384], output[16384];
+  off_t offset = 0;
+  struct stat value;
+  if (!owned_image_sealed (source, expected))
+    die ("Owned image requires an immutable bounded sealed source");
+  /* The caller holds a newly O_EXCL-created file in the private tmpfs. No
+   * untrusted process exists in this namespace during setup. Source identity,
+   * size and seals remain held through a full second byte comparison. Go keeps
+   * the admission digest of this same immutable source; equality proves that
+   * the copied image has that digest without another crypto implementation. */
+  while (offset < expected->st_size)
+    {
+      size_t size = expected->st_size - offset > (off_t) sizeof (input) ?
+                    sizeof (input) : (size_t) (expected->st_size - offset);
+      if (TEMP_FAILURE_RETRY (pread (source, input, size, offset)) != (ssize_t) size)
+        die ("Owned image source read was incomplete");
+      if (TEMP_FAILURE_RETRY (pwrite (target, input, size, offset)) != (ssize_t) size)
+        die ("Owned image private copy was incomplete");
+      offset += size;
+    }
+  if (fstat (target, &value) != 0 || !S_ISREG (value.st_mode) || value.st_nlink != 1 ||
+      value.st_size != expected->st_size || !owned_image_sealed (source, expected))
+    die ("Owned image private copy identity or size differs");
+  for (offset = 0; offset < expected->st_size;)
+    {
+      size_t size = expected->st_size - offset > (off_t) sizeof (input) ?
+                    sizeof (input) : (size_t) (expected->st_size - offset);
+      if (TEMP_FAILURE_RETRY (pread (source, input, size, offset)) != (ssize_t) size ||
+          TEMP_FAILURE_RETRY (pread (target, output, size, offset)) != (ssize_t) size ||
+          memcmp (input, output, size) != 0)
+        die ("Owned image private copy byte comparison failed");
+      offset += size;
+    }
+  if (!owned_image_sealed (source, expected) || fchmod (target, 0555) != 0)
+    die ("Owned image source changed or copy permissions failed");
+}
+
+static void
+owned_fd_mount (SetupOp *op)
+{
+  int source_fd = op->owned_local_fd;
+  const char *destination = op->dest;
+  bool image = op->type == SETUP_OWNED_RO_IMAGE;
+  bool readonly = op->type != SETUP_OWNED_FD_MOUNT;
+  cleanup_fd int current_ns = -1;
+  cleanup_fd int root_fd = -1;
+  cleanup_fd int parent_fd = -1;
+  cleanup_fd int target_fd = -1;
+  cleanup_fd int tree_fd = -1;
+  cleanup_fd int image_fd = -1;
+  cleanup_free char *relative = NULL;
+  struct stat original_ns, active_ns, source_st, target_st, root_st, parent_st;
+  struct statfs root_fs;
+  struct mount_attr attr = { 0 };
+  char *component, *next;
+  unsigned tree_flags = OPEN_TREE_CLONE | OPEN_TREE_CLOEXEC | AT_EMPTY_PATH | AT_NO_AUTOMOUNT;
+  unsigned attr_flags = AT_EMPTY_PATH;
+
+  /* All mutation below must be in bwrap's newly created mount namespace.
+   * Keep the original namespace alive: an inode must not be compared after
+   * releasing the object whose identity it represents. */
+  current_ns = openat (proc_fd, "self/ns/mnt", O_RDONLY | O_CLOEXEC);
+  if (original_mount_ns_fd < 0 || current_ns < 0 ||
+      fstat (original_mount_ns_fd, &original_ns) != 0 ||
+      fstat (current_ns, &active_ns) != 0 ||
+      (original_ns.st_dev == active_ns.st_dev && original_ns.st_ino == active_ns.st_ino))
+    die ("Owned FD mounts require a new private mount namespace");
+
+  if (image)
+    source_fd = op->fd;
+  if (fstat (source_fd, &source_st) != 0 ||
+      (!S_ISDIR (source_st.st_mode) && !S_ISREG (source_st.st_mode)))
+    die ("Owned FD mount source must be an open directory or regular file");
+  if (!owned_path_valid (destination, TRUE) || destination[1] == 0 ||
+      destination[strlen (destination) - 1] == '/' ||
+      has_path_prefix (destination, "/dev") || has_path_prefix (destination, "/proc") ||
+      (image ? strcmp (destination, "/.defenseclaw/payload") != 0 :
+       has_path_prefix (destination, "/.defenseclaw")))
+    die ("Owned FD mount destination must be a normalized non-root absolute path");
+
+  root_fd = fcntl (owned_destination_root_fd, F_DUPFD_CLOEXEC, 3);
+  if (root_fd < 0 || fstat (root_fd, &root_st) != 0 ||
+      fstatfs (root_fd, &root_fs) != 0 || root_fs.f_type != TMPFS_MAGIC)
+    die ("Owned FD mount destination root is not bwrap's private tmpfs");
+  parent_fd = fcntl (root_fd, F_DUPFD_CLOEXEC, 3);
+  if (parent_fd < 0)
+    die_with_error ("Can't retain owned destination root");
+
+  relative = xstrdup (destination + 1);
+  component = relative;
+  for (;;)
+    {
+      bool is_directory;
+      next = strchr (component, '/');
+      if (next != NULL)
+        *next = 0;
+      if (component[0] == 0 || strcmp (component, ".") == 0 || strcmp (component, "..") == 0)
+        die ("Owned FD mount destination has an invalid component");
+      if (fstat (parent_fd, &parent_st) != 0)
+        die_with_error ("Can't inspect owned destination parent");
+      is_directory = next != NULL || S_ISDIR (source_st.st_mode);
+      /* An earlier mount may cover a destination ancestor. Never create a
+       * placeholder in that source filesystem: only this new private tmpfs
+       * may be changed. Existing targets remain usable through held FDs. */
+      if (parent_st.st_dev == root_st.st_dev && is_directory)
+        {
+          if (mkdirat (parent_fd, component, 0755) != 0 && errno != EEXIST)
+            die_with_error ("Can't create owned destination directory");
+        }
+      else if (image)
+        {
+          if (parent_st.st_dev != root_st.st_dev)
+            die ("Owned image destination is not private tmpfs");
+          image_fd = openat (parent_fd, component, O_CREAT | O_EXCL | O_RDWR | O_NOFOLLOW | O_CLOEXEC, 0500);
