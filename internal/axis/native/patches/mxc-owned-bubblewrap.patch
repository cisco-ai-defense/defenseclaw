+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    fn inert_image(kind: u32, seal: bool) -> File {
+        // This is deliberately not executable code and is never spawned.
+        let descriptor = unsafe {
+            libc::memfd_create(
+                c"inert-static-image".as_ptr(),
+                libc::MFD_CLOEXEC | libc::MFD_ALLOW_SEALING,
+            )
+        };
+        assert!(descriptor >= 0);
+        let mut file = unsafe { File::from_raw_fd(descriptor) };
+        let mut bytes = [0; 120];
+        bytes[..6].copy_from_slice(b"\x7fELF\x02\x01");
+        bytes[16..18].copy_from_slice(&2u16.to_le_bytes());
+        bytes[18..20].copy_from_slice(&62u16.to_le_bytes());
+        bytes[32..40].copy_from_slice(&64u64.to_le_bytes());
+        bytes[52..54].copy_from_slice(&64u16.to_le_bytes());
+        bytes[54..56].copy_from_slice(&56u16.to_le_bytes());
+        bytes[56..58].copy_from_slice(&1u16.to_le_bytes());
+        bytes[64..68].copy_from_slice(&kind.to_le_bytes());
+        file.write_all(&bytes).unwrap();
+        if seal {
+            assert_eq!(
+                unsafe { libc::fcntl(descriptor, libc::F_ADD_SEALS, SEALED) },
+                0
+            );
+        }
+        file
+    }
+
+    #[test]
+    fn filter_copy_starts_at_zero_and_ignores_caller_offset_changes() {
+        let original = inert_image(1, true);
+        let length = original.metadata().unwrap().len();
+        assert_eq!(
+            unsafe { libc::lseek(original.as_raw_fd(), 0, libc::SEEK_CUR) },
+            length as i64
+        );
+        let copy = private_filter(&original).unwrap();
+        assert_eq!(
+            unsafe { libc::lseek(original.as_raw_fd(), 8, libc::SEEK_SET) },
+            8
+        );
+        assert_eq!(
+            unsafe { libc::lseek(copy.as_raw_fd(), 0, libc::SEEK_CUR) },
+            0
+        );
+        let mut expected = vec![0; length as usize];
+        original.read_exact_at(&mut expected, 0).unwrap();
+        let mut actual = Vec::new();
+        (&copy).read_to_end(&mut actual).unwrap();
+        assert_eq!(actual, expected);
+    }
+
+    #[test]
+    fn static_structure_refuses_interpreter_dynamic_and_mutable_images() {
+        assert!(static_image(&inert_image(1, true)).is_ok());
+        for kind in [2, 3] {
+            assert!(static_image(&inert_image(kind, true)).is_err());
+        }
+        assert!(static_image(&inert_image(1, false)).is_err());
+    }
+
+    #[test]
+    fn guest_destinations_refuse_alias_components_and_synthetic_roots() {
+        for path in ["/", "relative", "/a//b", "/a/../b", "/a/./b", "/a/"] {
+            assert!(!guest_path(path));
+        }
+        for path in [
+            "/dev",
+            "/dev/x",
+            "/proc",
+            "/proc/1",
+            "/.defenseclaw",
+            PAYLOAD,
+        ] {
+            assert!(reserved(path));
+        }
+        for path in ["/device", "/process", "/workspace", "/usr", "/lib"] {
+            assert!(guest_path(path));
+            assert!(!reserved(path));
+        }
+    }
+
+    #[test]
+    fn fixed_image_uses_verified_copy_route_without_path_or_legacy_data_options() {
+        let prepared = PreparedOwnedBubblewrap::new(
+            inert_image(1, true),
+            inert_image(1, true),
+            inert_image(1, true),
+            vec![OwnedMount::new(
+                File::open(std::env::temp_dir()).unwrap(),
+                "/work".into(),
+                false,
+            )
+            .unwrap()],
+            vec![PAYLOAD.into()],
+            vec![],
+            "/work".into(),
+        )
+        .unwrap();
+        let arguments: Vec<_> = prepared
+            .argv
+            .iter()
+            .map(|value| value.to_str().unwrap())
+            .collect();
+        assert_eq!(
+            arguments
+                .iter()
+                .filter(|value| **value == "--dc-ro-image-fd")
+                .count(),
+            1
+        );
+        assert!(!arguments.iter().any(|value| matches!(
+            *value,
+            "--ro-bind-data" | "--bind-data" | "--bind" | "--ro-bind"
+        )));
+        assert_eq!(arguments.last().copied(), Some(PAYLOAD));
+    }
+}
