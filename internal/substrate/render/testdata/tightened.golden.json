{
  "policy": {
    "rules": [
      {
        "http": {
          "effects": {
            "replaceHeaders": [
              {
                "actorJwt": {
                  "audiences": [
                    "defenseclaw"
                  ],
                  "expirationSeconds": "900"
                },
                "header": "x-defenseclaw-actor",
                "prefix": "Bearer "
              }
            ]
          },
          "hostnames": [
            "defenseclaw-actor.defenseclaw-system.svc"
          ],
          "ports": {
            "numbers": [
              80
            ]
          }
        }
      },
      {
        "https": {
          "effects": {
            "replaceHeaders": [
              {
                "credentialUri": "ate-secret://k8s.io/default/dc-people/p-8def678da0d076709ba7-npm/token",
                "header": "Authorization",
                "prefix": "Bearer "
              }
            ]
          },
          "hostnames": [
            "registry.npmjs.org"
          ],
          "ports": {
            "numbers": [
              443
            ]
          }
        }
      },
      {
        "https": {
          "hostnames": [
            "github.com",
            "pypi.org"
          ],
          "ports": {
            "numbers": [
              443
            ]
          }
        }
      }
    ]
  },
  "dropped": [
    {
      "host": "pins.example.org",
      "source": "passthrough",
      "reason": "not_in_allow_only"
    },
    {
      "host": "api.github.com",
      "source": "allow",
      "reason": "blocked",
      "detail": "api.github.com"
    },
    {
      "host": "*.githubusercontent.com",
      "source": "allow",
      "reason": "not_in_allow_only"
