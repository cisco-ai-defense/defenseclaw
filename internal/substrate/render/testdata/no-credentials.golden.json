{
  "policy": {
    "rules": [
      {
        "https": {
          "effects": {
            "replaceHeaders": [
              {
                "actorJwt": {
                  "audiences": [
                    "defenseclaw"
                  ],
                  "expirationSeconds": "900"
                },
                "header": "x-defenseclaw-actor",
                "prefix": "Bearer "
              }
            ]
          },
          "hostnames": [
            "defenseclaw-actor.defenseclaw-system.svc"
          ],
          "ports": {
            "numbers": [
              443
            ]
          }
        }
      },
      {
        "https": {
          "hostnames": [
            "*.githubusercontent.com",
            "api.github.com",
            "crates.io",
            "docs.example.com",
            "files.pythonhosted.org",
            "ghcr.io",
            "github.com",
            "mcp.internal.example.com",
            "proxy.golang.org",
            "pypi.org",
            "registry.example.com",
            "registry.npmjs.org",
            "registry.yarnpkg.com",
            "sum.golang.org"
          ],
          "ports": {
            "numbers": [
              443
            ]
          }
        }
      },
      {
        "tlsPassthrough": {
          "hostnames": [
            "pins.example.org"
          ],
          "ports": {
            "numbers": [
              443
            ]
          }
        }
      }
    ]
  },
  "dropped": [
    {
      "host": "api.openai.com",
      "source": "allow",
      "reason": "provider_host",
      "detail": "openai.com"
    },
    {
      "host": "*",
      "source": "allow",
      "reason": "defenseclaw_internal",
      "detail": "defenseclaw-actor.defenseclaw-system.svc"
    },
    {
      "host": "10.0.0.1",
      "source": "allow",
      "reason": "invalid_pattern"
    },
    {
      "host": "*.us-east-1.amazonaws.com",
      "source": "allow",
      "reason": "provider_host",
      "detail": "^bedrock(-runtime|-agent|-agent-runtime)?(-fips)?\\.[a-z0-9-]+\\.amazonaws\\.com$"
    },
    {
      "host": "defenseclaw-admin.defenseclaw-system.svc",
      "source": "allow",
      "reason": "defenseclaw_internal",
      "detail": "defenseclaw-system.svc"
    },
    {
      "host": "*.defenseclaw-system.svc",
      "source": "allow",
      "reason": "defenseclaw_internal",
      "detail": "defenseclaw-actor.defenseclaw-system.svc"
    },
    {
      "host": "bad_host",
      "source": "allow",
      "reason": "invalid_pattern"
    },
    {
      "host": "index.crates.io",
      "source": "pack:crates",
      "reason": "blocked",
      "detail": "crates.io"
    },
    {
      "host": "static.crates.io",
      "source": "pack:crates",
      "reason": "blocked",
      "detail": "crates.io"
    },
    {
      "secret": "bad-uri",
      "source": "secret",
      "reason": "secret_not_in_allowed_credentials"
    },
    {
      "secret": "dup-header",
      "source": "secret",
      "reason": "secret_not_in_allowed_credentials"
    },
    {
      "secret": "github-push",
      "source": "secret",
      "reason": "secret_not_in_allowed_credentials"
    },
    {
      "secret": "mine-npm",
      "source": "secret",
      "reason": "secret_not_in_allowed_credentials"
    },
    {
      "secret": "no-profiles",
      "source": "secret",
      "reason": "secret_not_for_profile"
    },
    {
      "secret": "pinned",
      "source": "secret",
      "reason": "secret_not_in_allowed_credentials"
    },
    {
      "secret": "sales-only",
      "source": "secret",
      "reason": "secret_not_for_profile"
    },
    {
      "secret": "to-provider",
      "source": "secret",
      "reason": "secret_not_in_allowed_credentials"
    }
  ],
  "bindings": null
}
