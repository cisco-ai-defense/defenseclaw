id: {{.ID}}
display_name: Amazon Bedrock Mantle (OpenAI-compatible routes) (DefenseClaw)
description: Binds a Bedrock API key to the Mantle OpenAI-compatible routes (https://{{.Host}}/v1) as a bearer; only the pinned harness binaries may use it
category: inference
inference_capable: true
credentials:
  - name: api_key
    description: Amazon Bedrock API key (short-term or long-term)
    env_vars: [BEDROCK_MANTLE_API_KEY]
    required: true
    auth_style: bearer
    header_name: authorization
endpoints:
  - host: {{quote .Host}}
    port: 443
    protocol: rest
    access: full
    enforcement: enforce
binaries: [{{range $i, $b := .Binaries}}{{if $i}}, {{end}}{{quote $b}}{{end}}]
