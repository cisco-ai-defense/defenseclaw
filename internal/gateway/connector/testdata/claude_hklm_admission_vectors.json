   "settings": "{\"allowManagedHooksOnly\":true,\"hooks\":{\"MessageDisplay\":[@MSG@],\"PreToolUse\":[@PRE@,{\"hooks\":[{\"args\":@ARGS@,\"command\":\"@HOOK@\",\"timeout\":1,\"type\":\"command\"}],\"matcher\":\"Bash\"}],\"Stop\":[@STOP@]}}",
