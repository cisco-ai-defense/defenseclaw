   "settings": "{\"allowManagedHooksOnly\":true,\"hooks\":{\"MessageDisplay\":[@MSG@],\"PreToolUse\":[{\"hooks\":[{\"args\":@ARGS@,\"command\":\"@HOOK@\",\"timeout\":30,\"type\":\"command\"}],\"matcher\":\"*\",\"Matcher\":\"Bash\"}],\"Stop\":[@STOP@]}}",
   "want": "refuse"
