   "settings": "{\"allowManagedHooksOnly\":true,\"hooks\":{\"MessageDisplay\":[@MSG@],\"PreToolUse\":[@PRE@,{\"hooks\":[{\"type\":\"command\",\"command\":\"C:\\\\audit.exe\"},{\"args\":@ARGS@,\"command\":\"@HOOK@\",\"timeout\":30,\"type\":\"command\"}],\"matcher\":\"*\"}],\"Stop\":[@STOP@]}}",
   "want": "refuse"
  },
  {
