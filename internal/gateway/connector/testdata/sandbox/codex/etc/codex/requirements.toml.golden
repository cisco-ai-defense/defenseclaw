# DefenseClaw managed Codex requirements (OpenShell sandbox image, root-owned).
# Hook contract codex-hooks-v4; regenerate with the image, never edit.
allow_managed_hooks_only = true

[features]
hooks = true

[hooks]
managed_dir = '/usr/local/lib/defenseclaw/hooks'

[[hooks.PermissionRequest]]
matcher = '*'

[[hooks.PermissionRequest.hooks]]
command = '/usr/local/lib/defenseclaw/hooks/codex-hook.sh --event PermissionRequest --hook-contract codex-hooks-v4'
timeout = 30
type = 'command'

[[hooks.PostCompact]]
[[hooks.PostCompact.hooks]]
command = '/usr/local/lib/defenseclaw/hooks/codex-hook.sh --event PostCompact --hook-contract codex-hooks-v4'
timeout = 30
type = 'command'

[[hooks.PostToolUse]]
matcher = '*'

[[hooks.PostToolUse.hooks]]
command = '/usr/local/lib/defenseclaw/hooks/codex-hook.sh --event PostToolUse --hook-contract codex-hooks-v4'
timeout = 30
type = 'command'

[[hooks.PreCompact]]
[[hooks.PreCompact.hooks]]
command = '/usr/local/lib/defenseclaw/hooks/codex-hook.sh --event PreCompact --hook-contract codex-hooks-v4'
timeout = 30
type = 'command'

[[hooks.PreToolUse]]
matcher = '*'

[[hooks.PreToolUse.hooks]]
command = '/usr/local/lib/defenseclaw/hooks/codex-hook.sh --event PreToolUse --hook-contract codex-hooks-v4'
timeout = 30
type = 'command'

[[hooks.SessionEnd]]
[[hooks.SessionEnd.hooks]]
command = '/usr/local/lib/defenseclaw/hooks/codex-hook.sh --event SessionEnd --hook-contract codex-hooks-v4'
timeout = 3
type = 'command'

[[hooks.SessionStart]]
matcher = 'startup|resume|clear|compact'

[[hooks.SessionStart.hooks]]
command = '/usr/local/lib/defenseclaw/hooks/codex-hook.sh --event SessionStart --hook-contract codex-hooks-v4'
timeout = 30
type = 'command'

[[hooks.Stop]]
[[hooks.Stop.hooks]]
command = '/usr/local/lib/defenseclaw/hooks/codex-hook.sh --event Stop --hook-contract codex-hooks-v4'
timeout = 90
type = 'command'

[[hooks.SubagentStart]]
matcher = '*'

[[hooks.SubagentStart.hooks]]
command = '/usr/local/lib/defenseclaw/hooks/codex-hook.sh --event SubagentStart --hook-contract codex-hooks-v4'
timeout = 30
type = 'command'

[[hooks.SubagentStop]]
matcher = '*'

[[hooks.SubagentStop.hooks]]
command = '/usr/local/lib/defenseclaw/hooks/codex-hook.sh --event SubagentStop --hook-contract codex-hooks-v4'
timeout = 90
type = 'command'

[[hooks.UserPromptSubmit]]
[[hooks.UserPromptSubmit.hooks]]
command = '/usr/local/lib/defenseclaw/hooks/codex-hook.sh --event UserPromptSubmit --hook-contract codex-hooks-v4'
timeout = 30
type = 'command'
