# DefenseClaw managed Hermes configuration (OpenShell sandbox image, root-owned).
# Hermes merges this layer over ~/.hermes/config.yaml and it wins per key.
# Hook contract hermes-hooks-v1; regenerate with the image, never edit.
agent:
    disabled_toolsets:
        - code_execution
hooks:
    api_request_error:
        - command: /usr/local/lib/defenseclaw/hooks/hermes-hook.sh
          timeout: 30
    kanban_task_blocked:
        - command: /usr/local/lib/defenseclaw/hooks/hermes-hook.sh
          timeout: 30
    kanban_task_claimed:
        - command: /usr/local/lib/defenseclaw/hooks/hermes-hook.sh
          timeout: 30
    kanban_task_completed:
        - command: /usr/local/lib/defenseclaw/hooks/hermes-hook.sh
          timeout: 30
    on_session_end:
        - command: /usr/local/lib/defenseclaw/hooks/hermes-hook.sh
          timeout: 30
    on_session_finalize:
        - command: /usr/local/lib/defenseclaw/hooks/hermes-hook.sh
          timeout: 30
    on_session_reset:
        - command: /usr/local/lib/defenseclaw/hooks/hermes-hook.sh
          timeout: 30
    on_session_start:
        - command: /usr/local/lib/defenseclaw/hooks/hermes-hook.sh
          timeout: 30
    post_api_request:
        - command: /usr/local/lib/defenseclaw/hooks/hermes-hook.sh
          timeout: 30
    post_approval_response:
        - command: /usr/local/lib/defenseclaw/hooks/hermes-hook.sh
          timeout: 30
    post_llm_call:
        - command: /usr/local/lib/defenseclaw/hooks/hermes-hook.sh
          timeout: 30
    post_tool_call:
        - command: /usr/local/lib/defenseclaw/hooks/hermes-hook.sh
          matcher: .*
          timeout: 30
    pre_api_request:
        - command: /usr/local/lib/defenseclaw/hooks/hermes-hook.sh
          timeout: 30
    pre_approval_request:
        - command: /usr/local/lib/defenseclaw/hooks/hermes-hook.sh
          timeout: 30
    pre_gateway_dispatch:
        - command: /usr/local/lib/defenseclaw/hooks/hermes-hook.sh
          timeout: 30
    pre_llm_call:
        - command: /usr/local/lib/defenseclaw/hooks/hermes-hook.sh
          timeout: 30
    pre_tool_call:
        - command: /usr/local/lib/defenseclaw/hooks/hermes-hook.sh
          matcher: .*
          timeout: 30
    pre_verify:
        - command: /usr/local/lib/defenseclaw/hooks/hermes-hook.sh
          timeout: 30
    subagent_start:
        - command: /usr/local/lib/defenseclaw/hooks/hermes-hook.sh
          timeout: 30
    subagent_stop:
        - command: /usr/local/lib/defenseclaw/hooks/hermes-hook.sh
          timeout: 30
    transform_llm_output:
        - command: /usr/local/lib/defenseclaw/hooks/hermes-hook.sh
          timeout: 30
    transform_terminal_output:
        - command: /usr/local/lib/defenseclaw/hooks/hermes-hook.sh
          timeout: 30
    transform_tool_result:
        - command: /usr/local/lib/defenseclaw/hooks/hermes-hook.sh
          timeout: 30
hooks_auto_accept: true
plugins:
    enabled: []
providers:
    defenseclaw:
        api_mode: chat_completions
        base_url: ${HERMES_DEFENSECLAW_BASE_URL}
        key_env: HERMES_DEFENSECLAW_API_KEY
        name: DefenseClaw sandbox provider
security:
    allow_lazy_installs: false
    tirith_enabled: false
terminal:
    backend: local
