{
  "description": "DefenseClaw-guarded Kiro agent (OpenShell sandbox)",
  "hooks": {
    "postToolUse": [
      {
        "command": "/usr/local/lib/defenseclaw/hooks/kiro-hook.sh",
        "description": "DefenseClaw tool-use audit",
        "matcher": "*"
      }
    ],
    "preToolUse": [
      {
        "command": "/usr/local/lib/defenseclaw/hooks/kiro-hook.sh",
        "description": "DefenseClaw tool-use inspection",
        "matcher": "*"
      }
    ],
    "stop": [
      {
        "command": "/usr/local/lib/defenseclaw/hooks/kiro-hook.sh",
        "description": "DefenseClaw session stop",
        "matcher": "*"
      }
    ],
    "userPromptSubmit": [
      {
        "command": "/usr/local/lib/defenseclaw/hooks/kiro-hook.sh",
        "description": "DefenseClaw prompt inspection",
        "matcher": "*"
      }
    ]
  },
  "includeMcpJson": true,
  "name": "defenseclaw",
  "tools": [
    "*"
  ]
}
