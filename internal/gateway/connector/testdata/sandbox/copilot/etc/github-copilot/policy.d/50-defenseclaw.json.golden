{
  "hooks": {
    "agentStop": [
      {
        "bash": "'/usr/local/lib/defenseclaw/hooks/copilot-hook.sh' --event 'agentStop'",
        "timeoutSec": 30,
        "type": "command"
      }
    ],
    "errorOccurred": [
      {
        "bash": "'/usr/local/lib/defenseclaw/hooks/copilot-hook.sh' --event 'errorOccurred'",
