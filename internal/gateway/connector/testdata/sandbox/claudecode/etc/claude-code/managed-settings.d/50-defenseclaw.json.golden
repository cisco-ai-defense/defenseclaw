{
  "allowManagedHooksOnly": true,
  "apiKeyHelper": "",
  "awsAuthRefresh": "",
  "awsCredentialExport": "",
  "env": {
    "ANTHROPIC_API_URL": "",
    "ANTHROPIC_AUTH_TOKEN": "",
    "ANTHROPIC_BASE_URL": "",
    "ANTHROPIC_CUSTOM_HEADERS": "",
    "BASH_ENV": "",
    "CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC": "1",
    "CLAUDE_CODE_DISABLE_OFFICIAL_MARKETPLACE_AUTOINSTALL": "1",
    "CLAUDE_CODE_ENABLE_TELEMETRY": "1",
    "CLAUDE_CODE_SESSIONEND_HOOKS_TIMEOUT_MS": "",
    "CLAUDE_CODE_SHELL": "",
    "CLAUDE_CODE_SHELL_PREFIX": "",
    "CLAUDE_CODE_SIMPLE": "0",
    "CLAUDE_CODE_STOP_HOOK_BLOCK_CAP": "",
    "CLAUDE_CODE_USE_BEDROCK": "",
    "CLAUDE_CODE_USE_VERTEX": "",
    "DISABLE_AUTOUPDATER": "1",
    "ENV": "",
    "LD_AUDIT": "",
    "LD_LIBRARY_PATH": "",
    "LD_PRELOAD": "",
    "OTEL_EXPORTER_OTLP_ENDPOINT": "http://host.openshell.internal:18971",
    "OTEL_EXPORTER_OTLP_LOGS_ENDPOINT": "http://host.openshell.internal:18971/v1/logs",
    "OTEL_EXPORTER_OTLP_LOGS_PROTOCOL": "http/json",
    "OTEL_EXPORTER_OTLP_METRICS_ENDPOINT": "http://host.openshell.internal:18971/v1/metrics",
    "OTEL_EXPORTER_OTLP_METRICS_PROTOCOL": "http/json",
    "OTEL_EXPORTER_OTLP_PROTOCOL": "http/json",
    "OTEL_EXPORTER_OTLP_TRACES_ENDPOINT": "http://host.openshell.internal:18971/v1/traces",
    "OTEL_EXPORTER_OTLP_TRACES_PROTOCOL": "http/json",
    "OTEL_LOGS_EXPORTER": "otlp",
    "OTEL_LOG_ASSISTANT_RESPONSES": "0",
    "OTEL_LOG_RAW_API_BODIES": "0",
    "OTEL_LOG_TOOL_CONTENT": "0",
    "OTEL_LOG_TOOL_DETAILS": "0",
    "OTEL_LOG_USER_PROMPTS": "0",
    "OTEL_METRICS_EXPORTER": "otlp",
    "OTEL_RESOURCE_ATTRIBUTES": "defenseclaw.connector=claudecode,service.name=claudecode",
    "OTEL_SERVICE_NAME": "claudecode",
    "OTEL_TRACES_EXPORTER": "none",
    "SHELL": "/bin/bash"
  },
  "gcpAuthRefresh": "",
  "hooks": {
    "ConfigChange": [
      {
        "hooks": [
          {
            "command": "/usr/local/lib/defenseclaw/hooks/claude-code-hook.sh",
            "timeout": 30,
            "type": "command"
          }
        ],
        "matcher": "*"
      }
    ],
    "CwdChanged": [
      {
        "hooks": [
          {
            "command": "/usr/local/lib/defenseclaw/hooks/claude-code-hook.sh",
            "timeout": 30,
            "type": "command"
          }
        ]
      }
    ],
    "Elicitation": [
      {
        "hooks": [
          {
            "command": "/usr/local/lib/defenseclaw/hooks/claude-code-hook.sh",
            "timeout": 30,
            "type": "command"
          }
        ],
        "matcher": "*"
      }
    ],
    "ElicitationResult": [
      {
        "hooks": [
          {
            "command": "/usr/local/lib/defenseclaw/hooks/claude-code-hook.sh",
            "timeout": 30,
            "type": "command"
          }
        ],
        "matcher": "*"
      }
    ],
    "FileChanged": [
      {
        "hooks": [
          {
            "command": "/usr/local/lib/defenseclaw/hooks/claude-code-hook.sh",
            "timeout": 30,
            "type": "command"
          }
        ],
        "matcher": ".+"
      }
    ],
    "InstructionsLoaded": [
      {
        "hooks": [
          {
            "command": "/usr/local/lib/defenseclaw/hooks/claude-code-hook.sh",
            "timeout": 30,
            "type": "command"
          }
        ],
        "matcher": "*"
      }
    ],
    "MessageDisplay": [
      {
        "hooks": [
          {
            "async": true,
            "command": "/usr/local/lib/defenseclaw/hooks/claude-code-hook.sh",
            "timeout": 10,
            "type": "command"
          }
        ]
      }
    ],
    "Notification": [
      {
        "hooks": [
          {
            "command": "/usr/local/lib/defenseclaw/hooks/claude-code-hook.sh",
            "timeout": 30,
            "type": "command"
          }
        ],
        "matcher": "*"
      }
    ],
    "PermissionDenied": [
      {
        "hooks": [
          {
            "command": "/usr/local/lib/defenseclaw/hooks/claude-code-hook.sh",
            "timeout": 30,
            "type": "command"
          }
        ],
        "matcher": "*"
      }
    ],
    "PermissionRequest": [
      {
        "hooks": [
          {
            "command": "/usr/local/lib/defenseclaw/hooks/claude-code-hook.sh",
            "timeout": 30,
            "type": "command"
          }
        ],
        "matcher": "*"
      }
    ],
    "PostCompact": [
      {
        "hooks": [
          {
            "command": "/usr/local/lib/defenseclaw/hooks/claude-code-hook.sh",
            "timeout": 30,
            "type": "command"
          }
        ],
        "matcher": "*"
      }
    ],
    "PostToolBatch": [
      {
        "hooks": [
          {
            "command": "/usr/local/lib/defenseclaw/hooks/claude-code-hook.sh",
            "timeout": 90,
            "type": "command"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "command": "/usr/local/lib/defenseclaw/hooks/claude-code-hook.sh",
            "timeout": 30,
            "type": "command"
          }
        ],
        "matcher": "*"
      }
    ],
    "PostToolUseFailure": [
      {
        "hooks": [
          {
            "command": "/usr/local/lib/defenseclaw/hooks/claude-code-hook.sh",
            "timeout": 30,
            "type": "command"
          }
        ],
        "matcher": "*"
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "command": "/usr/local/lib/defenseclaw/hooks/claude-code-hook.sh",
            "timeout": 30,
            "type": "command"
          }
        ],
        "matcher": "*"
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "command": "/usr/local/lib/defenseclaw/hooks/claude-code-hook.sh",
            "timeout": 30,
            "type": "command"
          }
        ],
        "matcher": "*"
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "command": "/usr/local/lib/defenseclaw/hooks/claude-code-hook.sh",
            "timeout": 60,
            "type": "command"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "/usr/local/lib/defenseclaw/hooks/claude-code-hook.sh",
            "timeout": 30,
            "type": "command"
          }
        ],
        "matcher": "startup|resume|clear|compact|fork"
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "command": "/usr/local/lib/defenseclaw/hooks/claude-code-hook.sh",
            "timeout": 90,
            "type": "command"
          }
        ]
      }
    ],
    "StopFailure": [
      {
        "hooks": [
          {
            "command": "/usr/local/lib/defenseclaw/hooks/claude-code-hook.sh",
            "timeout": 30,
            "type": "command"
          }
        ],
        "matcher": "*"
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "command": "/usr/local/lib/defenseclaw/hooks/claude-code-hook.sh",
            "timeout": 30,
            "type": "command"
          }
        ],
        "matcher": "*"
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "command": "/usr/local/lib/defenseclaw/hooks/claude-code-hook.sh",
            "timeout": 90,
            "type": "command"
          }
        ],
        "matcher": "*"
      }
    ],
    "TaskCompleted": [
      {
        "hooks": [
          {
            "command": "/usr/local/lib/defenseclaw/hooks/claude-code-hook.sh",
            "timeout": 30,
            "type": "command"
          }
        ]
      }
    ],
    "TaskCreated": [
      {
        "hooks": [
          {
            "command": "/usr/local/lib/defenseclaw/hooks/claude-code-hook.sh",
            "timeout": 30,
            "type": "command"
          }
        ]
      }
    ],
    "TeammateIdle": [
      {
        "hooks": [
          {
            "command": "/usr/local/lib/defenseclaw/hooks/claude-code-hook.sh",
            "timeout": 30,
            "type": "command"
          }
        ]
      }
    ],
    "UserPromptExpansion": [
      {
        "hooks": [
          {
            "command": "/usr/local/lib/defenseclaw/hooks/claude-code-hook.sh",
            "timeout": 30,
            "type": "command"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "command": "/usr/local/lib/defenseclaw/hooks/claude-code-hook.sh",
            "timeout": 30,
            "type": "command"
          }
        ]
      }
    ],
    "WorktreeRemove": [
      {
        "hooks": [
          {
            "command": "/usr/local/lib/defenseclaw/hooks/claude-code-hook.sh",
            "timeout": 30,
            "type": "command"
          }
        ]
      }
    ]
  },
  "otelHeadersHelper": "/usr/local/lib/defenseclaw/otel-headers.sh",
  "sandbox": {
    "enabled": false
  },
  "skipDangerousModePermissionPrompt": true
}
