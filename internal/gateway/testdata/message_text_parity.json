    "pad": 100000
   },
   "text_len": 200001
  },
  {
   "name": "non-string values: numbers are text, flags and nulls are not",
   "params": {
    "text": 42,
    "b": true,
    "n": null,
    "a": [
     1.5
    ]
   },
   "text": "42\n1.5"
  },
  {
   "name": "a number beside a message",
   "params": {
    "message": "hi",
    "n": 1234567,
    "price": 19.5,
    "flag": true
   },
   "text": "hi\n1234567\n19.5"
  },
  {
   "name": "a number under a routing key is a control value",
   "params": {
    "to": 15551230000,
    "text": "x",
    "timeoutMs": 5000
   },
   "text": "x"
  },
  {
   "name": "priority then sorted",
   "params": {
    "zz": "last",
    "aa": "mid",
    "content": "first",
    "caption": "cap"
   },
   "text": "first\ncap\nmid\nlast"
  },
  {
   "name": "nested arrays in blocks",
   "params": {
    "to": "+1",
    "blocks": [
     {
      "type": "text",
      "id": "b",
      "text": "b1"
     },
     [
      "x",
      [
       "y"
      ]
     ]
    ]
   },
   "text": "b1\nx\ny",
   "routing": {
    "to": "+1",
    "blocks.type": "text",
    "blocks.id": "b"
   }
  },
  {
   "name": "routing keys in any case",
   "params": {
    "To": "a",
    "CHANNEL": "b",
    "accountId": "c"
   },
   "text": "",
   "routing": {
    "To": "a",
    "CHANNEL": "b",
    "accountId": "c"
   }
  },
  {
   "name": "mixed-case duplicates are both read",
   "params": {
    "Text": "x",
    "text": "y"
   },
   "text": "x\ny"
  },
  {
   "name": "non-ASCII keys sort by code point",
   "params": {
    "～": "fullwidth",
    "😀": "emoji"
   },
   "text": "fullwidth\nemoji"
  },
  {
   "name": "a dotted capital I is not an ASCII id key",
   "params": {
    "İd": "dotted"
   },
   "text": "dotted"
  },
  {
   "name": "OpenClaw send fields rank after the generic ones",
   "params": {
    "voiceText": "v",
    "quoteText": "q",
    "presentation": {
     "title": "t",
     "blocks": [
      {
       "text": "p"
      }
     ]
    },
    "message": "m"
   },
   "text": "m\nv\nq\nt\np",
   "routing": {}
  },
  {
   "name": "a text past the node limit is dropped and flagged",
   "gen": {
    "nodes": 5000
   },
   "text_len": 0,
   "over_cap": true
  },
  {
   "name": "multibyte text under the byte limit is whole",
   "gen": {
    "multibyte": 100000
   },
   "text_len": 200000,
   "valid_utf8": true
  },
  {
   "name": "multibyte text over the byte limit is cut on a character",
   "gen": {
    "multibyte": 140000
   },
   "text_len": 262145,
   "over_cap": true,
   "valid_utf8": true
  }
 ]
