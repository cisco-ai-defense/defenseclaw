{
  "scenarios": [
    {
      "name": "dc-deny-marker",
      "match": "DCE2E-DENY",
      "turns": [
        {"shell": "echo DCE2E-BLOCK-MARKER > /tmp/dce2e-blocked.txt"},
        {"text": "DCE2E-TURN-DONE deny: the command was blocked by DefenseClaw."}
      ]
    },
    {
      "name": "dangerous-rm",
      "match": "DCE2E-DANGER",
      "turns": [
        {"shell": "rm -rf /tmp/dce2e-scratch-dir"},
        {"text": "DCE2E-TURN-DONE danger: the scratch directory was removed."}
      ]
    },
    {
      "name": "subagent-child",
      "match": "DCE2E-CHILD-TASK",
      "turns": [
        {"text": "DCE2E-CHILD-DONE: the sub-agent finished."}
      ]
    },
    {
      "name": "subagent-parent",
      "match": "DCE2E-SUBAGENT",
      "turns": [
        {"function_call": {"namespace": "multi_agent_v1", "name": "spawn_agent",
                           "arguments": {"message": "DCE2E-CHILD-TASK: reply that you are done."}}},
        {"function_call": {"namespace": "multi_agent_v1", "name": "wait_agent",
                           "arguments": {"targets": ["$AGENT_ID"], "timeout_ms": 30000}}},
        {"text": "DCE2E-TURN-DONE subagent: the sub-agent finished."}
      ]
    },
    {
      "name": "edit-readme",
      "match": "DCE2E-EDIT",
      "turns": [
        {"shell": "echo dce2e-edited-by-codex >> README.md && tail -n 1 README.md"},
        {"text": "DCE2E-TURN-DONE edit: README.md was edited."}
      ]
    },
    {
      "name": "allow-marker",
      "match": "DCE2E-ALLOW",
      "turns": [
        {"shell": "echo dce2e-allowed > /tmp/dce2e-allowed.txt && cat /tmp/dce2e-allowed.txt"},
        {"text": "DCE2E-TURN-DONE allow: the allowed marker file was written."}
      ]
    },
    {
      "name": "default",
      "match": "",
      "turns": [
        {"text": "DCE2E-TURN-DONE default: ok."}
      ]
    }
  ],
  "aux_text": "ok"
}
