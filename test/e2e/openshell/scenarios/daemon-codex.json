{
  "scenarios": [
    {
      "name": "dc-deny-marker",
      "match": "DCE2E-DENY",
      "turns": [
        {"shell": "echo DCE2E-BLOCK-MARKER > /tmp/dce2e-blocked.txt"},
        {"text": "The command was blocked by DefenseClaw."}
      ]
    },
    {
      "name": "dc-fetch",
      "match": "DCE2E-FETCH",
      "turns": [
