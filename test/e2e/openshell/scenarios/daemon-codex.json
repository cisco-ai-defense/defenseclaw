        {"text": "Fetched."}
      ]
    },
    {
      "name": "default",
      "match": "",
      "turns": [
        {"shell": "echo dce2e-allowed > /tmp/dce2e-allowed.txt && cat /tmp/dce2e-allowed.txt"},
        {"text": "Done: the marker file was written."}
      ]
    }
  ]
