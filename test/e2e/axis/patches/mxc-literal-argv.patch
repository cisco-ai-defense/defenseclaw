+//! Additive typed argv entry points; no JSON/schema or legacy command changes.
+
+use std::ffi::OsString;
+
+use crate::mxc_common::literal_argv::LiteralArgv;
+use crate::mxc_common::mxc_error::MxcError;
+use crate::mxc_common::sandbox_process::StdioMode;
+use crate::mxc_engine::Error;
+use crate::policy::{ContainerRequest, PreparedContainerRequest};
+use crate::sandbox::{MxcProcess, MxcPtyProcess};
+
+struct PreparedArgvRequest {
+    policy: PreparedContainerRequest,
+    argv: LiteralArgv,
+}
+
+fn prepare(
+    request: ContainerRequest,
+    values: Vec<OsString>,
+    telemetry: Option<crate::options::TelemetryConfig>,
+) -> Result<PreparedArgvRequest, Error> {
+    if !request.command.is_empty() {
+        return Err(MxcError::malformed_request(
+            "literal argv requires an empty legacy command field",
+        )
+        .into());
+    }
+    if !matches!(
+        request.containment,
+        crate::policy::Containment::Bubblewrap | crate::policy::Containment::Seatbelt(_)
+    ) {
+        return Err(MxcError::unsupported_containment(
+            "literal argv requires an explicit supported backend, not an abstract process intent",
+        )
+        .into());
+    }
+    let argv = LiteralArgv::new(values)?;
+    let policy = crate::policy::prepare_literal_creation_request(&request, &argv, telemetry)?;
+    // The opaque value cannot exist while a legacy command/token is present.
+    crate::mxc_common::validator::validate_argv_common(&policy.inner, &argv).map_err(|_| {
+        MxcError::malformed_request(
+            "literal argv preparation retained an invalid legacy command or policy",
+        )
+    })?;
+    Ok(PreparedArgvRequest { policy, argv })
+}
+
+/// Spawn literal native OS arguments in an explicitly selected supported
+/// backend. `request.command` must be empty; argv[0] must be absolute.
+/// This contributor seam supports Bubblewrap and Seatbelt only and never
+/// retries through another backend or the legacy shell-command API.
+pub fn spawn(
+    request: ContainerRequest,
+    argv: Vec<OsString>,
+    options: crate::options::SpawnOptions,
+) -> Result<MxcProcess, Error> {
+    let PreparedArgvRequest { policy, argv } = prepare(request, argv, options.telemetry)?;
+    crate::mxc_engine::spawn_literal_argv(&policy.inner, &argv, StdioMode::Pipes)
+        .map(MxcProcess::new)
+}
+
+/// Spawn literal native OS arguments attached to the selected backend's PTY.
+/// Policy, environment, timeout and handle ownership match `argv::spawn`.
+pub fn spawn_with_pty(
+    request: ContainerRequest,
+    argv: Vec<OsString>,
+    options: crate::options::SpawnWithPtyOptions,
+) -> Result<MxcPtyProcess, Error> {
+    options.size.validate()?;
+    let PreparedArgvRequest { policy, argv } = prepare(request, argv, options.telemetry)?;
+    crate::mxc_engine::spawn_literal_argv(&policy.inner, &argv, StdioMode::Pty(options.size.into()))
+        .and_then(MxcPtyProcess::new)
+}
