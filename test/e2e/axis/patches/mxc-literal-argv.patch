+pub(crate) fn prepare_literal_creation_request(
+    request: &ContainerRequest,
+    argv: &crate::mxc_common::literal_argv::LiteralArgv,
+    telemetry: Option<crate::options::TelemetryConfig>,
+) -> Result<PreparedContainerRequest, crate::Error> {
+    if !request.command.is_empty() {
+        return Err(crate::mxc_common::mxc_error::MxcError::malformed_request(
+            "literal argv requires an empty legacy command field",
+        )
+        .into());
+    }
+    let policy = request_policy(request);
+    let mut prepared = exact::build_literal_request(
+        &policy,
+        &request.containment,
+        argv,
+        request.container_name.as_deref(),
+    )?;
+    apply_process_options(request, &mut prepared);
+    apply_creation_options(request, &mut prepared, telemetry);
