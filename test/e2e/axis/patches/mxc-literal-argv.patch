+mod tests {
+    use super::*;
+
+    fn program() -> OsString {
+        if cfg!(windows) {
+            r"C:\fixed\probe.exe".into()
+        } else {
+            "/fixed/probe".into()
+        }
+    }
+
+    #[test]
+    fn argv_preparation_rejects_ambiguous_legacy_command() {
+        assert!(prepare(
+            ContainerRequest::new("legacy command"),
+            vec![program()],
+            None
+        )
+        .is_err());
+    }
+
+    #[test]
+    fn argv_preparation_refuses_abstract_process_selection() {
+        assert!(prepare(ContainerRequest::new(""), vec![program()], None).is_err());
+    }
+
+    #[test]
+    fn argv_preparation_preserves_empty_environment_and_policy() {
+        let request = ContainerRequest {
+            containment: crate::policy::Containment::Bubblewrap,
+            working_directory: Some("/fixed/workspace".into()),
+            environment: Some(Vec::new()),
+            inherit_default_environment: Some(false),
+            timeout_ms: Some(1234),
+            ..ContainerRequest::new("")
+        };
+        let PreparedArgvRequest {
+            policy: prepared,
+            argv,
+        } = prepare(request, vec![program(), "".into()], None).unwrap();
+        assert_eq!(prepared.inner.env, Some(Vec::new()));
+        assert!(!prepared.inner.inherit_default_env);
+        assert_eq!(prepared.inner.working_directory, "/fixed/workspace");
+        assert_eq!(prepared.inner.script_timeout, 1234);
+        assert_eq!(argv.arguments(), &[OsString::new()]);
+        assert!(!prepared.inner.experimental_enabled);
+        assert!(prepared.inner.script_code.is_empty());
+        assert!(crate::mxc_common::validator::validate_common(&prepared.inner).is_err());
+        assert!(crate::mxc_common::validator::validate_argv_common(&prepared.inner, &argv).is_ok());
+        assert!(!serde_json::to_string(&prepared.inner)
+            .unwrap()
+            .contains("mxc-literal-policy-normalization-only"));
+    }
+}
