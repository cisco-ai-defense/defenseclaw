+/// Preserve the legacy command path, or replace only its fixed command tail
+/// with explicit OS argv. No argument is rendered or parsed as shell text.
+pub(crate) fn command_with_argv(
+    args: &[String],
+    literal: Option<&crate::mxc_common::literal_argv::LiteralArgv>,
+) -> Result<std::process::Command, crate::mxc_common::models::ScriptResponse> {
+    let mut command = std::process::Command::new("bwrap");
+    if let Some(argv) = literal {
+        let prefix = args
+            .len()
+            .checked_sub(COMMAND_TAIL.len() + 1)
+            .ok_or_else(|| {
+                crate::mxc_common::models::ScriptResponse::rejected(
+                    "unrecognized Bubblewrap command layout",
+                )
+            })?;
+        if args[prefix..prefix + COMMAND_TAIL.len()] != COMMAND_TAIL {
+            return Err(crate::mxc_common::models::ScriptResponse::rejected(
+                "unrecognized Bubblewrap command layout",
+            ));
+        }
+        command.args(&args[..prefix]).arg("--").args(argv.values());
+    } else {
+        command.args(args);
+    }
+    Ok(command)
+}
