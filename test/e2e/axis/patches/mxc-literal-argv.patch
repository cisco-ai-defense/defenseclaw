+// Copyright 2026 Cisco Systems, Inc. and its affiliates
+// SPDX-License-Identifier: MIT
+
+//! Explicit, non-serialized literal argv. Construction does not authorize execution.
+
+use std::ffi::{OsStr, OsString};
+use std::path::Path;
+#[cfg(any(target_os = "macos", test))]
+use std::process::Command;
+
+use super::mxc_error::MxcError;
+
+#[derive(Clone)]
+pub struct LiteralArgv {
+    values: Vec<OsString>,
+}
+
+impl std::fmt::Debug for LiteralArgv {
+    fn fmt(&self, formatter: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+        formatter
+            .debug_struct("LiteralArgv")
+            .field("argc", &self.values.len())
+            .finish_non_exhaustive()
+    }
+}
+
+impl LiteralArgv {
+    pub fn new(values: Vec<OsString>) -> Result<Self, MxcError> {
+        if values.is_empty() || values.len() > 4096 {
+            return Err(MxcError::malformed_request(
+                "literal argv requires 1..4096 entries",
+            ));
+        }
+        if values[0].is_empty() || !Path::new(&values[0]).is_absolute() {
+            return Err(MxcError::malformed_request(
+                "literal argv requires an absolute executable path",
+            ));
+        }
+        let mut bytes = 0usize;
+        for value in &values {
+            let encoded = value.as_encoded_bytes();
+            if encoded.contains(&0) {
+                return Err(MxcError::malformed_request(
+                    "literal argv contains an embedded NUL",
+                ));
+            }
+            bytes = bytes.checked_add(encoded.len() + 1).ok_or_else(|| {
+                MxcError::malformed_request("literal argv exceeds its size bound")
+            })?;
+            if bytes > 1024 * 1024 {
+                return Err(MxcError::malformed_request(
+                    "literal argv exceeds its size bound",
+                ));
+            }
+        }
+        Ok(Self { values })
+    }
+
+    pub fn program(&self) -> &OsStr {
+        &self.values[0]
+    }
+    pub fn arguments(&self) -> &[OsString] {
+        &self.values[1..]
+    }
+    pub fn values(&self) -> &[OsString] {
+        &self.values
+    }
+
+    #[cfg(any(target_os = "macos", test))]
+    pub(crate) fn command(&self) -> Command {
+        let mut command = Command::new(self.program());
+        command.args(self.arguments());
+        command
+    }
+}
