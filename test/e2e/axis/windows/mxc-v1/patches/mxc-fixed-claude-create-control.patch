+// This entire helper exists only in the separately reviewed fifth overlay.
+// Store exact bounded call buffers, not hashes that expose private path facts.
+#[derive(Clone, PartialEq, Eq)]
+struct FixedClaudeControlInputs {
+    buffers: [Vec<u16>; 4],
+    flags: u32,
+    inherit: bool,
+    // Native STARTUPINFOW fields compared individually: never compare padding.
+    startup: [usize; 18],
+    handles: Vec<usize>,
+}
+
+impl FixedClaudeControlInputs {
+    fn freeze(
+        buffers: [&[u16]; 4],
+        flags: u32,
+        inherit: bool,
+        startup: &STARTUPINFOW,
+        handles: &[HANDLE],
+    ) -> Result<Self, ScriptResponse> {
+        if buffers
+            .iter()
+            .any(|value| value.is_empty() || value.len() > 65_536)
+            || handles.len() != 3
+        {
+            return Err(ScriptResponse::rejected(
+                "fixed control inputs are not bounded",
+            ));
+        }
+        Ok(Self {
+            buffers: buffers.map(<[u16]>::to_vec),
+            flags,
+            inherit,
+            startup: [
+                startup.cb as usize,
+                startup.lpReserved.0 as usize,
+                startup.lpDesktop.0 as usize,
+                startup.lpTitle.0 as usize,
+                startup.dwX as usize,
+                startup.dwY as usize,
+                startup.dwXSize as usize,
+                startup.dwYSize as usize,
+                startup.dwXCountChars as usize,
+                startup.dwYCountChars as usize,
+                startup.dwFillAttribute as usize,
+                startup.dwFlags.0 as usize,
+                startup.wShowWindow as usize,
+                startup.cbReserved2 as usize,
+                startup.lpReserved2 as usize,
+                startup.hStdInput.0 as usize,
+                startup.hStdOutput.0 as usize,
+                startup.hStdError.0 as usize,
+            ],
+            handles: handles.iter().map(|handle| handle.0 as usize).collect(),
+        })
+    }
+}
+
+fn fixed_claude_control_admitted(
+    argv: Option<&crate::mxc_common::literal_argv::LiteralArgv>,
+    capture: bool,
+    request: &ExecutionRequest,
+) -> bool {
+    let Some(argv) = argv else { return false };
+    let values = argv.values();
+    let expected = [
+        "APPDATA",
+        "HOME",
+        "LOCALAPPDATA",
+        "SYSTEMROOT",
+        "TEMP",
+        "TMP",
+        "USERPROFILE",
+        "WINDIR",
+    ];
+    let Some(environment) = request.env.as_ref() else {
+        return false;
+    };
+    let mut names: Vec<_> = environment
+        .iter()
+        .filter_map(|entry| entry.split_once('=').map(|(name, _)| name))
+        .collect();
+    names.sort_unstable();
+    capture
+        && !request.inherit_default_env
+        && values.len() == 2
+        && Path::new(&values[0]).file_name() == Some(std::ffi::OsStr::new("claude-reviewed.exe"))
+        && values[1] == std::ffi::OsStr::new("--version")
+        && environment.len() == 8
+        && names == expected
+        && request.policy.capture_denials.is_none()
+}
