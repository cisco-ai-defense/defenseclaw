+        let calls = std::cell::RefCell::new(Vec::new());
+        let failure = capture_native_launch_failure(
+            || {
+                calls.borrow_mut().push("win32");
+                87
+            },
+            || {
+                calls.borrow_mut().push("ntstatus");
+                0xc000000du32 as i32
+            },
+        );
+        assert_eq!(calls.into_inner(), ["win32", "ntstatus"]);
+        assert_eq!(failure.win32, 87);
+        assert_eq!(failure.nt_status as u32, 0xc000000d);
+        let text = NativeLaunchShape::bounded([44, 55, 66, 77, 2, 8]).describe(failure);
+        assert_eq!(
+            text,
+            "native_launch_failure win32=87 ntstatus=0xc000000d application_utf16_units=44 command_utf16_units=55 environment_utf16_units=66 cwd_utf16_units=77 argv_entries=2 environment_entries=8 counts_capped=false"
+        );
+        let maximum = NativeLaunchShape::bounded([usize::MAX; 6]).describe(failure);
+        assert!(maximum.ends_with("counts_capped=true"));
+        assert_eq!(maximum.matches("=65536").count(), 6);
+        assert!(maximum.len() < 320);
+        assert!(!maximum.contains('\\'));
+    }
+
