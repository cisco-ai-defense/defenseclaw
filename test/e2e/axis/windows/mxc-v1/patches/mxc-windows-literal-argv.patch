+        assert!(windows_literal_argv_buffers(&argv).is_err());
+        let argv = LiteralArgv::new(vec!["C:\\fixed\\bad\"name.exe".into()]).unwrap();
+        assert!(windows_literal_argv_buffers(&argv).is_err());
+    }
