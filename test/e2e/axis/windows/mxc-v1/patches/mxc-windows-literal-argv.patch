+    #[test]
+    fn literal_image_mapping_requires_exact_success_before_resume() {
+        use std::cell::RefCell;
+        for status in [0_i32, 1, 0x8000_0005_u32 as i32, 0xc000_0001_u32 as i32] {
+            let events = RefCell::new(Vec::new());
+            let result = resume_after_literal_image_match(
+                || {
+                    events.borrow_mut().push("query");
+                    status
+                },
+                || {
+                    events.borrow_mut().push("resume");
+                    1
+                },
+                |refused| {
+                    events.borrow_mut().push("cleanup");
+                    refused
+                },
+            );
+            if status == 0 {
+                assert_eq!(result, Ok(1));
+                assert_eq!(*events.borrow(), vec!["query", "resume"]);
+            } else {
+                assert_eq!(result, Err(status));
+                assert_eq!(*events.borrow(), vec!["query", "cleanup"]);
+            }
+        }
+    }
