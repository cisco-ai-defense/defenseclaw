+#[derive(Clone, Copy)]
+struct NativeLaunchShape {
+    lengths: [usize; 6],
+    capped: bool,
+}
+
+impl NativeLaunchShape {
+    fn bounded(lengths: [usize; 6]) -> Self {
+        // Diagnostic counts only: never allocate from a reported length or
+        // retain any argument, environment value or filesystem spelling.
+        const LIMIT: usize = 65_536;
+        Self {
+            capped: lengths.iter().any(|length| *length > LIMIT),
+            lengths: lengths.map(|length| length.min(LIMIT)),
+        }
+    }
+
+    fn describe(self, failure: NativeLaunchFailure) -> String {
+        let [
+            application,
+            command,
+            environment,
+            cwd,
+            argv_entries,
+            env_entries,
+        ] = self.lengths;
+        format!(
+            "native_launch_failure win32={} ntstatus=0x{:08x} application_utf16_units={} command_utf16_units={} environment_utf16_units={} cwd_utf16_units={} argv_entries={} environment_entries={} counts_capped={}",
+            failure.win32,
+            failure.nt_status as u32,
+            application,
+            command,
+            environment,
+            cwd,
+            argv_entries,
+            env_entries,
+            self.capped
+        )
+    }
+}
