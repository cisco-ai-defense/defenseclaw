+/// Pure admission: local drive or verbatim-drive syntax only. Do not normalize
+/// a caller path first: that could traverse a remote junction on the host.
+fn local_executable_parts(
+    program: &std::ffi::OsStr,
+) -> Result<(u16, Vec<std::ffi::OsString>), ScriptResponse> {
+    use std::os::windows::ffi::{OsStrExt, OsStringExt};
+    let units: Vec<u16> = program.encode_wide().collect();
+    let prefix = if units.starts_with(&[92, 92, 63, 92]) {
+        4
+    } else {
+        0
+    };
+    let drive = units.get(prefix).copied().unwrap_or_default();
+    if !((65..=90).contains(&drive) || (97..=122).contains(&drive))
+        || units.get(prefix + 1) != Some(&58)
+        || units.get(prefix + 2) != Some(&92)
+        || units.len() > 32_766
+    {
+        return Err(ScriptResponse::rejected(
+            "literal executable requires an absolute local drive path",
+        ));
+    }
+    let mut parts = Vec::new();
+    for part in units[prefix + 3..].split(|unit| *unit == 92) {
+        let name = String::from_utf16_lossy(part);
+        let stem = name
+            .split('.')
+            .next()
+            .unwrap_or("")
+            .trim_end_matches(' ')
+            .to_ascii_uppercase();
+        let dos_device = ["CON", "PRN", "AUX", "NUL", "CLOCK$", "CONIN$", "CONOUT$"]
+            .contains(&stem.as_str())
+            || ["COM", "LPT"].iter().any(|prefix| {
+                stem.strip_prefix(*prefix).is_some_and(|suffix| {
+                    matches!(
+                        suffix,
+                        "1" | "2" | "3" | "4" | "5" | "6" | "7" | "8" | "9" | "¹" | "²" | "³"
+                    )
+                })
+            });
+        if part.is_empty()
+            || part == [46]
+            || part == [46, 46]
+            || dos_device
+            || part.last().is_some_and(|unit| *unit == 46 || *unit == 32)
+            || part
+                .iter()
+                .any(|unit| *unit < 32 || [34, 42, 47, 58, 60, 62, 63, 124].contains(unit))
+        {
+            return Err(ScriptResponse::rejected(
+                "literal executable refuses UNC/device/ADS/dot or ambiguous path components",
+            ));
+        }
+        parts.push(std::ffi::OsString::from_wide(part));
+    }
+    Ok((
+        if (97..=122).contains(&drive) {
+            drive - 32
+        } else {
+            drive
+        },
+        parts,
+    ))
+}
+
+struct LocalExecutableCustody {
+    // DOS spelling is only a CreateProcess compatibility input, not authority.
+    application: Vec<u16>,
+    // Hold directory names against rename; hold the image against writes/rename.
+    // Directory metadata and contents remain mutable under the caller's rights.
+    // This is not a digest-based executable authorization for a production host.
+    _handles: Vec<OwnedHandle>,
+}
+
+// Native PROCESSINFOCLASS ProcessImageFileMapping (44) reads an input HANDLE
+// and compares the process image's SectionObjectPointer with that held file.
+// It requires PROCESS_QUERY_INFORMATION and FILE_EXECUTE | SYNCHRONIZE on the
+// file. Unlike a queried pathname followed by a reopen, no mutable name selects
+// the comparison object. Unsupported, warning and failed statuses all refuse.
+// Primary definitions: m417z/ntdoc descriptions/processinfoclass.md and
+// winsiderss/systeminformer phnt/include/ntpsapi.h (q: HANDLE input).
+fn literal_image_mapping_status(process: HANDLE, custody: &LocalExecutableCustody) -> i32 {
+    let Some(image) = custody._handles.last() else {
+        return 0xc000_0008_u32 as i32; // STATUS_INVALID_HANDLE, fail closed
+    };
+    let mut image_handle = image.get();
+    // SAFETY: both handles remain owned, the input buffer is exactly one native
+    // HANDLE, class 44 reads it without writing output, and ReturnLength is optional.
+    unsafe {
+        literal_query_process_information(
+            process,
+            44,
+            (&mut image_handle as *mut HANDLE).cast(),
+            std::mem::size_of::<HANDLE>() as u32,
+            ptr::null_mut(),
+        )
+    }
+}
+
+fn resume_after_literal_image_match<E>(
+    query: impl FnOnce() -> i32,
+    resume: impl FnOnce() -> u32,
+    refuse: impl FnOnce(i32) -> E,
+) -> Result<u32, E> {
+    let status = query();
+    if status != 0 {
+        return Err(refuse(status));
+    }
+    Ok(resume())
+}
