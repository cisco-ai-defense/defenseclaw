+    #[test]
+    fn native_local_file_custody_holds_image_against_write_without_spawning() {
+        let directory = tempfile::tempdir().unwrap();
+        let parent = directory.path().join("fixed-parent");
+        let moved = directory.path().join("fixed-renamed-parent");
+        std::fs::create_dir(&parent).unwrap();
+        let image = parent.join("fixed-not-executed.exe");
+        std::fs::write(&image, b"fixed public file; never executed").unwrap();
+        drop(
+            std::fs::OpenOptions::new()
+                .write(true)
+                .open(&image)
+                .unwrap(),
+        );
+        // Positive control: this exact ancestor can be renamed before pinning.
+        std::fs::rename(&parent, &moved).unwrap();
+        std::fs::rename(&moved, &parent).unwrap();
+        let mut custody = pin_local_executable(image.as_os_str()).unwrap();
+        let error = std::fs::OpenOptions::new()
+            .write(true)
+            .open(&image)
+            .unwrap_err();
+        assert_eq!(error.raw_os_error(), Some(32)); // ERROR_SHARING_VIOLATION
+        let application =
+            String::from_utf16(&custody.application[..custody.application.len() - 1]).unwrap();
+        assert!(!application.starts_with(r"\\"));
+        local_executable_parts(std::ffi::OsStr::new(&application)).unwrap();
+        // A held image can independently prevent parent rename. Release only
+        // that final image handle so it cannot mask weak directory custody.
+        drop(custody._handles.pop().unwrap());
+        let rename = std::fs::rename(&parent, &moved).unwrap_err();
+        assert_eq!(rename.raw_os_error(), Some(32)); // ERROR_SHARING_VIOLATION
+        let sibling = parent.join("fixed-public-sibling.txt");
+        std::fs::write(&sibling, b"fixed public sibling").unwrap();
+        std::fs::remove_file(sibling).unwrap();
+        drop(custody);
+        drop(
+            std::fs::OpenOptions::new()
+                .write(true)
+                .open(&image)
+                .unwrap(),
+        );
+        std::fs::rename(&parent, &moved).unwrap();
+        std::fs::rename(&moved, &parent).unwrap();
+    }
