+    #[test]
+    fn native_process_image_mapping_matches_current_image_and_refuses_wrong_file() {
+        use std::io::{Read, Seek, SeekFrom, Write};
+        use std::os::windows::io::BorrowedHandle;
+        use windows::Win32::Storage::FileSystem::{
+            FileIdInfo, GetFileInformationByHandleEx, FILE_ID_INFO,
+        };
+        use windows::Win32::System::Threading::GetCurrentProcess;
+        fn held_file(custody: &LocalExecutableCustody) -> std::fs::File {
+            // Clone ownership without reopening a name or taking the custody handle.
+            let borrowed =
+                unsafe { BorrowedHandle::borrow_raw(custody._handles.last().unwrap().get().0) };
+            std::fs::File::from(borrowed.try_clone_to_owned().unwrap())
+        }
+        fn identity(custody: &LocalExecutableCustody) -> (u64, [u8; 16]) {
+            let mut information = FILE_ID_INFO::default();
+            unsafe {
+                GetFileInformationByHandleEx(
+                    custody._handles.last().unwrap().get(),
+                    FileIdInfo,
+                    (&mut information as *mut FILE_ID_INFO).cast(),
+                    std::mem::size_of::<FILE_ID_INFO>() as u32,
+                )
+            }
+            .unwrap();
+            (
+                information.VolumeSerialNumber,
+                information.FileId.Identifier,
+            )
+        }
+        // Read-only current-process API qualification; never create a child.
+        let current = pin_local_executable(std::env::current_exe().unwrap().as_os_str()).unwrap();
+        let process = unsafe { GetCurrentProcess() };
+        assert_eq!(literal_image_mapping_status(process, &current), 0);
+        let directory = tempfile::tempdir().unwrap();
+        let copied_path = directory
+            .path()
+            .join("fixed-public-unexecuted-identical-image.exe");
+        let mut original = held_file(&current);
+        let size = original.metadata().unwrap().len();
+        assert!(size > 0 && size <= 256 * 1024 * 1024);
+        let mut output = std::fs::OpenOptions::new()
+            .create_new(true)
+            .write(true)
+            .open(&copied_path)
+            .unwrap();
+        original.seek(SeekFrom::Start(0)).unwrap();
+        assert_eq!(
+            std::io::copy(&mut (&mut original).take(size + 1), &mut output).unwrap(),
+            size
+        );
+        output.flush().unwrap();
+        drop(output);
+        let copied = pin_local_executable(copied_path.as_os_str()).unwrap();
+        // A valid PE with identical bytes must still be a different kernel file.
+        assert!(identity(&current) != identity(&copied));
+        let mut copy_reader = held_file(&copied);
+        original.seek(SeekFrom::Start(0)).unwrap();
+        copy_reader.seek(SeekFrom::Start(0)).unwrap();
+        let mut left = [0_u8; 8192];
+        let mut right = [0_u8; 8192];
+        let mut remaining = size;
+        while remaining != 0 {
+            let count = remaining.min(left.len() as u64) as usize;
+            original.read_exact(&mut left[..count]).unwrap();
+            copy_reader.read_exact(&mut right[..count]).unwrap();
+            assert!(left[..count] == right[..count]);
+            remaining -= count as u64;
+        }
+        assert_eq!(original.read(&mut left[..1]).unwrap(), 0);
+        assert_eq!(copy_reader.read(&mut right[..1]).unwrap(), 0);
+        assert_ne!(literal_image_mapping_status(process, &copied), 0);
+        let wrong = directory.path().join("fixed-public-wrong-image.bin");
+        std::fs::write(&wrong, b"fixed public synthetic unrelated file").unwrap();
+        let wrong = pin_local_executable(wrong.as_os_str()).unwrap();
+        assert_ne!(literal_image_mapping_status(process, &wrong), 0);
+    }
+}
