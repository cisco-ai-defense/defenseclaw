+            r"C:\fixed path\child.exe"
+        );
+        assert_eq!(
+            String::from_utf16(&command[..command.len() - 1]).unwrap(),
+            r#""C:\fixed path\child.exe" "" "a b" "a\"b" "tail\\" "λ-雪;$()`&|<>*?""#
+        );
+        assert_eq!(application.last(), Some(&0));
