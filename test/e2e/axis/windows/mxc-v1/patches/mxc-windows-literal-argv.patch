+fn pin_local_executable(
+    program: &std::ffi::OsStr,
+) -> Result<LocalExecutableCustody, ScriptResponse> {
+    use std::os::windows::ffi::{OsStrExt, OsStringExt};
+    use windows::Win32::Storage::FileSystem::{
+        CreateFileW, GetDriveTypeW, GetFileInformationByHandle, GetFinalPathNameByHandleW,
+        QueryDosDeviceW, BY_HANDLE_FILE_INFORMATION, FILE_ATTRIBUTE_DIRECTORY,
+        FILE_ATTRIBUTE_REPARSE_POINT, FILE_EXECUTE, FILE_FLAG_BACKUP_SEMANTICS,
+        FILE_FLAG_OPEN_REPARSE_POINT, FILE_GENERIC_READ, FILE_LIST_DIRECTORY, FILE_NAME_NORMALIZED,
+        FILE_READ_ATTRIBUTES, FILE_SHARE_READ, FILE_SHARE_WRITE, GETFINALPATHNAMEBYHANDLE_FLAGS,
+        OPEN_EXISTING, VOLUME_NAME_DOS, VOLUME_NAME_GUID,
+    };
+    let (drive, parts) = local_executable_parts(program)?;
+    let alias = [drive, 58, 0];
+    let mut target = vec![0u16; 1024];
+    let count = unsafe { QueryDosDeviceW(PCWSTR(alias.as_ptr()), Some(&mut target)) };
+    if count == 0 || count as usize >= target.len() {
+        return Err(ScriptResponse::rejected(
+            "cannot resolve the local executable drive",
+        ));
+    }
+    let end = target
+        .iter()
+        .position(|unit| *unit == 0)
+        .unwrap_or(target.len());
+    let target = String::from_utf16(&target[..end])
+        .map_err(|_| ScriptResponse::rejected("invalid local drive mapping"))?;
+    let volume = target
+        .strip_prefix(r"\Device\HarddiskVolume")
+        .filter(|suffix| !suffix.is_empty() && suffix.bytes().all(|byte| byte.is_ascii_digit()))
+        .ok_or_else(|| {
+            ScriptResponse::rejected(
+                "literal executable refuses mapped, SUBST and redirected drives",
+            )
+        })?;
+    // Resolve the trusted kernel volume directly, rather than re-reading a
+    // caller's mutable DOS drive alias during path traversal.
+    let native_root = PathBuf::from(format!(r"\\?\GLOBALROOT\Device\HarddiskVolume{volume}\"));
+    let open = |path: &Path, directory: bool| -> Result<OwnedHandle, ScriptResponse> {
+        let mut wide: Vec<u16> = path.as_os_str().encode_wide().collect();
+        wide.push(0);
+        // Attribute-only directory opens do not participate in rename-sharing
+        // enforcement. List access makes no-delete sharing an effective pin.
+        // Share directory writes so holding ordinary ancestors does not deny
+        // unrelated content operations; the image still denies write sharing.
+        let (access, share) = if directory {
+            (
+                FILE_LIST_DIRECTORY.0 | FILE_READ_ATTRIBUTES.0,
+                FILE_SHARE_READ | FILE_SHARE_WRITE,
+            )
+        } else {
+            (FILE_GENERIC_READ.0 | FILE_EXECUTE.0, FILE_SHARE_READ)
+        };
+        let handle = unsafe {
+            CreateFileW(
+                PCWSTR(wide.as_ptr()),
+                access,
+                share,
+                None,
+                OPEN_EXISTING,
+                FILE_FLAG_BACKUP_SEMANTICS | FILE_FLAG_OPEN_REPARSE_POINT,
+                None,
+            )
+        }
+        .map_err(|_| {
+            ScriptResponse::rejected(
+                "cannot hold local executable directory names or read-only image",
+            )
+        })?;
+        let handle = OwnedHandle::new(handle);
+        let mut information = BY_HANDLE_FILE_INFORMATION::default();
+        unsafe { GetFileInformationByHandle(handle.get(), &mut information) }
+            .map_err(|_| ScriptResponse::rejected("cannot inspect an executable path handle"))?;
+        if information.dwFileAttributes & FILE_ATTRIBUTE_REPARSE_POINT.0 != 0
+            || (information.dwFileAttributes & FILE_ATTRIBUTE_DIRECTORY.0 != 0) != directory
+        {
+            return Err(ScriptResponse::rejected(
+                "literal executable refuses reparse points or unexpected path object types",
+            ));
+        }
+        Ok(handle)
+    };
+    let final_path = |handle: HANDLE, volume: u32| -> Result<Vec<u16>, ScriptResponse> {
+        let mut result = vec![0u16; 32_768];
+        let count = unsafe {
+            GetFinalPathNameByHandleW(
+                handle,
+                &mut result,
+                GETFINALPATHNAMEBYHANDLE_FLAGS(FILE_NAME_NORMALIZED.0 | volume),
+            )
+        };
+        if count == 0 || count as usize >= result.len() {
+            return Err(ScriptResponse::rejected(
+                "cannot bind executable custody to a local volume GUID",
+            ));
+        }
+        result.truncate(count as usize);
+        let value = String::from_utf16_lossy(&result);
+        if volume == VOLUME_NAME_GUID.0
+            && (!value.starts_with(r"\\?\Volume{") || !value.contains(r"}\"))
+        {
+            return Err(ScriptResponse::rejected(
+                "executable handle is not on a local GUID volume",
+            ));
+        }
+        result.push(0);
+        Ok(result)
+    };
+    let root = open(&native_root, true)?;
+    let volume_root = final_path(root.get(), VOLUME_NAME_GUID.0)?;
+    // DRIVE_FIXED == 3. Query by the held volume's GUID, before traversing any
+    // caller path component; do not query a potentially redirected drive alias.
+    if unsafe { GetDriveTypeW(PCWSTR(volume_root.as_ptr())) } != 3 {
+        return Err(ScriptResponse::rejected(
+            "literal executable requires a local fixed volume",
+        ));
+    }
+    let mut path = PathBuf::from(std::ffi::OsString::from_wide(
+        &volume_root[..volume_root.len() - 1],
+    ));
+    let mut handles = vec![root];
+    for (index, part) in parts.iter().enumerate() {
+        path.push(part);
+        handles.push(open(&path, index + 1 != parts.len())?);
+    }
+    let dos_application = final_path(
+        handles
+            .last()
+            .expect("root and nonempty lexical path")
+            .get(),
+        VOLUME_NAME_DOS.0,
+    )?;
+    let dos_name = std::ffi::OsString::from_wide(&dos_application[..dos_application.len() - 1]);
+    local_executable_parts(&dos_name)?;
+    // Match the measured compatible ordinary-DOS form. Retained file/ancestor
+    // handles remain the authority; the kernel image check below must succeed
+    // before any primary thread is resumed, even if a DOS alias changes.
+    let prefix = [92_u16, 92, 63, 92];
+    let application = if dos_application.starts_with(&prefix) {
+        dos_application[4..].to_vec()
+    } else {
+        dos_application
+    };
+    Ok(LocalExecutableCustody {
+        application,
+        _handles: handles,
+    })
+}
