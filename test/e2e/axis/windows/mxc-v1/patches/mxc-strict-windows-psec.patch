+    #[cfg(target_os = "windows")]
+    pub fn spawn_windows_psec(
+        request: ContainerRequest,
+        options: SpawnOptions,
+    ) -> Result<MxcProcess, Error> {
+        if !matches!(request.containment, Containment::ProcessContainer(_)) {
+            return Err(crate::mxc_common::mxc_error::MxcError::unsupported_containment(
+                "strict Windows PSEC requires explicit ProcessContainer containment",
+            ).into());
+        }
+        let mut prepared = crate::policy::prepare_creation_request(&request, options.telemetry)?;
+        let filesystem = request.filesystem.as_ref().ok_or_else(|| {
+            crate::mxc_common::mxc_error::MxcError::malformed_request(
+                "contributor PSEC requires an explicit filesystem policy",
+            )
+        })?;
+        if filesystem.readwrite_paths.iter().any(|path| !prepared.inner.policy.readwrite_paths.contains(path))
+            || filesystem.readonly_paths.iter().any(|path| !prepared.inner.policy.readonly_paths.contains(path))
+            || filesystem.denied_paths.iter().any(|path| !prepared.inner.policy.denied_paths.contains(path))
+        {
+            return Err(crate::mxc_common::mxc_error::MxcError::malformed_request(
+                "contributor PSEC refuses normalization that drops explicit filesystem grants or denies",
+            ).into());
+        }
+        prepared.inner.policy.fallback.allow_dacl_mutation = false;
+        crate::mxc_engine::spawn_windows_psec(&prepared.inner).map(MxcProcess::new)
+    }
