+/// Contributor-only native Windows PSEC path. Validation and spawn happen on
+/// the same direct backend; the fallback dispatcher is never called.
+#[cfg(target_os = "windows")]
+pub fn spawn_windows_psec(
+    request: &ExecutionRequest,
+) -> Result<Box<dyn SandboxProcess>, Error> {
+    validate_contributor_psec_request(request)?;
+    spawn_execution_request_with_logger_and(request, Logger::new(Mode::Buffer), |request, logger| {
+        use crate::mxc_common::sandbox_process::{SandboxBackend, StdioMode};
+        crate::mxc_engine::run::log_policy_hash(request, logger);
+        let mut native = crate::process_container_common::base_container_runner::BaseContainerRunner::new();
+        // new() leaves request serviceability unconfirmed. SandboxBackend's
+        // spawn() invokes native validation for this exact request before
+        // entering spawn_validated(); construction itself is not validation.
+        native.spawn(request, logger, StdioMode::Pipes).map_err(dispatch::map_spawn_error)
+    })
+}
