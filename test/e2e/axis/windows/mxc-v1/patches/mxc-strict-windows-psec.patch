+#[cfg(target_os = "windows")]
+fn validate_contributor_psec_request(request: &ExecutionRequest) -> Result<(), MxcError> {
+    use crate::mxc_common::models::NetworkAction;
+    if !matches!(request.containment, ContainmentBackend::ProcessContainer)
+        || request.policy.fallback.allow_dacl_mutation
+        || request.dry_run
+    {
+        return Err(MxcError::malformed_request(
+            "strict PSEC requires explicit ProcessContainer, no DACL fallback and a live request",
+        ));
+    }
+    let offline_egress = request.policy.network_egress.as_ref().is_some_and(|policy| {
+        policy.default == NetworkAction::Deny && policy.allow.is_empty() && policy.deny.is_empty()
+    });
+    let offline_ingress = request.policy.network_ingress.as_ref().is_some_and(|policy| {
+        policy.default == NetworkAction::Deny && policy.host_loopback == NetworkAction::Deny
+    });
+    if !offline_egress || !offline_ingress
+        || request.policy.network_proxy.is_enabled()
+        || request.policy.runtime_network_proxy_specified
+        || request.policy.allowed_proxy_peer.is_some()
+        || !request.policy.capabilities.is_empty()
+        || request.policy.capture_denials.is_some()
+    {
+        return Err(MxcError::malformed_request(
+            "contributor PSEC entry point requires explicit offline deny policy without proxy, capabilities or denial capture",
+        ));
+    }
+    Ok(())
+}
