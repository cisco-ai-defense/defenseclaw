+struct AxisConsoleRelayGuard;
+
+unsafe extern "system" fn axis_console_relay_handler(event: u32) -> windows::core::BOOL {
+    use windows::Win32::System::Console::CTRL_C_EVENT;
+    // This process-local callback is not inherited. Windows independently
+    // delivers the same event to the contained workload. Never set NULL/TRUE.
+    windows::core::BOOL((event == CTRL_C_EVENT) as i32)
+}
+
+impl AxisConsoleRelayGuard {
+    fn install() -> Result<Self, String> {
+        use windows::Win32::System::Console::{
+            GetConsoleMode, GetStdHandle, SetConsoleCtrlHandler, CONSOLE_MODE,
+            STD_ERROR_HANDLE, STD_INPUT_HANDLE, STD_OUTPUT_HANDLE,
+        };
+        for kind in [STD_INPUT_HANDLE, STD_OUTPUT_HANDLE, STD_ERROR_HANDLE] {
+            let mut mode = CONSOLE_MODE::default();
+            // SAFETY: the OS supplies the current process's standard handle;
+            // the mode output is a live local allocation.
+            unsafe { GetStdHandle(kind).and_then(|handle| GetConsoleMode(handle, &mut mode)) }
+                .map_err(|error| format!("AXIS console relay requires three console handles: {error}"))?;
+        }
+        // Register the Base cleanup handler first. Its OnceLock makes the
+        // later runner registration a no-op, leaving this relay LAST in the
+        // handler chain. CTRL_C cannot consume the Base tracking slot.
+        appcontainer_common::sandbox_tracking::install_ctrl_handler();
+        // SAFETY: this callback has the required ABI and consumes only CTRL_C.
+        unsafe { SetConsoleCtrlHandler(Some(axis_console_relay_handler), true) }
+            .map_err(|error| format!("AXIS console relay registration failed: {error}"))?;
+        Ok(Self)
+    }
+}
+
+impl Drop for AxisConsoleRelayGuard {
+    fn drop(&mut self) {
+        use windows::Win32::System::Console::SetConsoleCtrlHandler;
+        // SAFETY: remove only this callback from this executor's handler list.
+        let _ = unsafe { SetConsoleCtrlHandler(Some(axis_console_relay_handler), false) };
+    }
+}
+
+fn validate_axis_console_relay_request(request: &ExecutionRequest) -> Result<(), &'static str> {
+    if !matches!(request.containment, ContainmentBackend::ProcessContainer)
+        || !is_base_container_version(&request.schema_version)
+        || request.policy.fallback.allow_dacl_mutation
+    {
+        return Err("AXIS console relay requires one-shot BaseContainer with DACL fallback disabled");
+    }
+    Ok(())
+}
