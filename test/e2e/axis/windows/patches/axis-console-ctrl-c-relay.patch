+
+// Process-local handler registrations are not inherited by the child. Windows
+// still delivers CTRL_C_EVENT to the contained workload sharing this console.
+// A NULL/TRUE ignore handler must not be used: that ignore state is inherited.
+static CONSOLE_RELAY_USERS: std::sync::atomic::AtomicUsize =
+    std::sync::atomic::AtomicUsize::new(0);
+static CONSOLE_RELAY_LOCK: std::sync::Mutex<()> = std::sync::Mutex::new(());
+
+struct ConsoleRelayGuard;
+
+unsafe extern "system" fn console_relay_handler(event: u32) -> windows::core::BOOL {
+    use std::sync::atomic::Ordering;
+    windows::core::BOOL(relay_console_event(event, CONSOLE_RELAY_USERS.load(Ordering::SeqCst)) as i32)
+}
+
+fn relay_console_event(event: u32, active_users: usize) -> bool {
+    event == windows::Win32::System::Console::CTRL_C_EVENT && active_users > 0
+}
+
+impl ConsoleRelayGuard {
+    fn install() -> Result<Self, MxcWindowsError> {
+        use std::sync::atomic::Ordering;
+        use windows::Win32::System::Console::SetConsoleCtrlHandler;
+        let _lock = CONSOLE_RELAY_LOCK.lock().unwrap_or_else(|p| p.into_inner());
+        if CONSOLE_RELAY_USERS.load(Ordering::SeqCst) == 0 {
+            // SAFETY: the callback has the Windows ABI and performs only an
+            // atomic load. It consumes CTRL_C_EVENT in this supervisor only.
+            unsafe { SetConsoleCtrlHandler(Some(console_relay_handler), true) }
+                .map_err(|error| MxcWindowsError::Executor(format!("console relay: {error}")))?;
+        }
+        CONSOLE_RELAY_USERS.fetch_add(1, Ordering::SeqCst);
+        Ok(Self)
+    }
+}
+
+impl Drop for ConsoleRelayGuard {
+    fn drop(&mut self) {
+        use std::sync::atomic::Ordering;
+        use windows::Win32::System::Console::SetConsoleCtrlHandler;
+        let _lock = CONSOLE_RELAY_LOCK.lock().unwrap_or_else(|p| p.into_inner());
+        if CONSOLE_RELAY_USERS.fetch_sub(1, Ordering::SeqCst) == 1 {
+            // SAFETY: remove only this registered process-local callback.
+            let _ = unsafe { SetConsoleCtrlHandler(Some(console_relay_handler), false) };
+        }
+    }
+}
 
