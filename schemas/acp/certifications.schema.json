{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.defenseclaw.dev/acp/certifications.schema.json",
  "title": "DefenseClaw ACP certification evidence",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "certification_levels", "required_evidence", "certifications"],
  "properties": {
    "schema_version": {"type": "integer", "const": 1},
    "certification_levels": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cataloged", "tested", "certified"],
      "properties": {
        "cataloged": {"type": "string", "minLength": 1, "maxLength": 1024},
        "tested": {"type": "string", "minLength": 1, "maxLength": 1024},
        "certified": {"type": "string", "minLength": 1, "maxLength": 1024}
      }
    },
    "required_evidence": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1, "maxLength": 512}
    },
    "certifications": {
      "type": "array",
      "maxItems": 256,
      "items": {"$ref": "#/$defs/certification"}
    }
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"},
    "certification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["client_id", "agent_id", "level", "protocol_release", "evidence"],
      "properties": {
        "client_id": {"$ref": "#/$defs/id"},
        "agent_id": {"$ref": "#/$defs/id"},
        "level": {"enum": ["tested", "certified"]},
        "protocol_release": {"type": "string", "pattern": "^schema-v[0-9]+\\.[0-9]+\\.[0-9]+$"},
        "evidence": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1, "maxLength": 1024}
        }
      }
    }
  }
}
