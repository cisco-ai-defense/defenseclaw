#ifndef DCLAW_CONFIG_H
#define DCLAW_CONFIG_H

#ifndef DCLAW_VERSION
#define DCLAW_VERSION "1.0.0"
#endif

#define DCLAW_PROFILE_@DCLAW_PROFILE@ 1
#define DCLAW_PROFILE_NAME "@DCLAW_PROFILE@"

#define DCLAW_AUDIT_RING_SIZE          @DCLAW_AUDIT_RING_SIZE@
#define DCLAW_VERDICT_CACHE_SIZE       @DCLAW_VERDICT_CACHE_SIZE@
#define DCLAW_HEARTBEAT_INTERVAL_SEC   @DCLAW_HEARTBEAT_INTERVAL_SEC@
#define DCLAW_AUDIT_RAM_BUFFER_SIZE    @DCLAW_AUDIT_RAM_BUFFER_SIZE@
#define DCLAW_CANARY_WINDOW_SEC        @DCLAW_CANARY_WINDOW_SEC@
#define DCLAW_MAX_SESSIONS             @DCLAW_MAX_SESSIONS@

#cmakedefine01 DCLAW_MQTT_ENABLED
#cmakedefine01 DCLAW_PII_REDACTION
#cmakedefine01 DCLAW_BLOOM_FILTER
#cmakedefine01 DCLAW_SPECULATIVE_EXECUTION
#cmakedefine01 DCLAW_CONTENT_SCAN

#define DCLAW_SESSION_HISTORY_DEPTH    8
#define DCLAW_PENDING_SLOTS            8
#define DCLAW_SPECULATIVE_SLOTS        4
#define DCLAW_RATE_LIMITERS            3
#define DCLAW_CANARY_SPIKE_MULT        5
#define DCLAW_CANARY_SPIKE_CONSEC      3
#define DCLAW_AUDIT_FLUSH_SEC          60
/* BLOCK audit entries are written to flash at once, but their fdatasync is
 * group-committed: at most one per window. An entry is durable no later
 * than this many ms after it was written (the main loop drives the sync). */
#define DCLAW_AUDIT_BLOCK_SYNC_MS      100
#define DCLAW_VERDICT_TIMEOUT_MS       500
/* How long a speculatively allowed call keeps its pending verdict slot. Until
 * the gateway answers or this deadline passes, the slot is not reused, so a
 * late BLOCK can still revoke the session. At the deadline the session is
 * revoked (fail closed) and the slot is released. */
#define DCLAW_SPECULATIVE_VERDICT_TIMEOUT_MS 30000
/* Must be at least 2x DCLAW_CONTENT_MAX to accommodate JSON-RPC framing. */
#define DCLAW_IPC_MAX_PAYLOAD          8192
#define DCLAW_IPC_RATE_LIMIT_PER_SEC   100
#define DCLAW_TOOL_NAME_MAX            64
#define DCLAW_DESTINATION_MAX          128
#define DCLAW_BROKER_URL_MAX           128
/* 4096 bytes covers the vast majority of tool call content while staying
 * within embedded RAM budgets. */
#define DCLAW_CONTENT_MAX              4096
#define DCLAW_MAX_SCAN_FINDINGS        4
#define DCLAW_MAX_DFA_STATES           128
#define DCLAW_MAX_DFA_CATEGORIES       6
#define DCLAW_ESCALATION_PAYLOAD_MAX   @DCLAW_ESCALATION_PAYLOAD_MAX@
#define DCLAW_PENDING_RING_SIZE        @DCLAW_PENDING_RING_SIZE@

/* Dev mode flag. When ON (default for development), missing DCLAW_AUDIT_KEY
 * uses a dev fallback key with a warning. When OFF (production/release builds),
 * the audit ring refuses to start without a real key.
 * Set via cmake: -DDCLAW_DEV_MODE=OFF for release. */
#cmakedefine01 DCLAW_DEV_MODE

#endif /* DCLAW_CONFIG_H */
