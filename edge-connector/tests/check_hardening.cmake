# Checks the hardening properties of a built executable.
#   cmake -DBIN=<path> -DSANITIZE=<ON|OFF> -DSYSTEM=<CMAKE_SYSTEM_NAME> -P check_hardening.cmake
# Fails when a property the build is meant to have is missing. Checks that
# need a tool that is not installed are skipped.

if(NOT BIN OR NOT EXISTS "${BIN}")
    message(FATAL_ERROR "BIN not set or missing: ${BIN}")
endif()

set(_failures "")

function(_run out_var)
    execute_process(COMMAND ${ARGN} OUTPUT_VARIABLE _o ERROR_VARIABLE _e RESULT_VARIABLE _r)
    if(NOT _r EQUAL 0)
        set(_o "")
    endif()
    set(${out_var} "${_o}" PARENT_SCOPE)
endfunction()

find_program(NM nm)
find_program(OTOOL otool)
find_program(READELF readelf)

if(SYSTEM STREQUAL "Darwin")
    if(OTOOL)
        _run(_hdr ${OTOOL} -hv "${BIN}")
        if(NOT _hdr MATCHES "PIE")
            list(APPEND _failures "not a PIE executable")
        endif()
    endif()
    set(_nm_args -u)
elseif(SYSTEM STREQUAL "Linux")
    if(READELF)
        _run(_hdr ${READELF} -h "${BIN}")
        if(NOT _hdr MATCHES "Type:[ \t]+DYN")
            list(APPEND _failures "not a PIE executable (ELF type is not DYN)")
        endif()
        _run(_dyn ${READELF} -d "${BIN}")
        if(NOT _dyn MATCHES "BIND_NOW" AND NOT _dyn MATCHES "FLAGS[^\n]*NOW")
            list(APPEND _failures "no immediate binding (-z now)")
        endif()
        _run(_ph ${READELF} -lW "${BIN}")
        if(NOT _ph MATCHES "GNU_RELRO")
            list(APPEND _failures "no RELRO segment (-z relro)")
        endif()
        if(_ph MATCHES "GNU_STACK[^\n]*RWE")
            list(APPEND _failures "executable stack")
        endif()
    endif()
    set(_nm_args -D --undefined-only)
endif()

if(NM AND _nm_args)
    _run(_syms ${NM} ${_nm_args} "${BIN}")
    if(NOT _syms MATCHES "__stack_chk_fail")
        list(APPEND _failures "no stack protector (__stack_chk_fail not referenced)")
    endif()
    if(NOT SANITIZE AND NOT _syms MATCHES "_chk")
        list(APPEND _failures "no _FORTIFY_SOURCE checked calls (__*_chk not referenced)")
    endif()
endif()

if(_failures)
    string(REPLACE ";" "\n  " _msg "${_failures}")
    message(FATAL_ERROR "${BIN}: hardening check failed:\n  ${_msg}")
endif()
message(STATUS "${BIN}: hardening check passed")
