{
  "dashboard": {
    "id": null,
    "uid": "dclaw-fleet-001",
    "title": "DefenseClaw IoT Fleet",
    "schemaVersion": 39,
    "timezone": "browser",
    "templating": {
      "list": [
        {
          "name": "DS_PROMETHEUS",
          "type": "datasource",
          "query": "prometheus",
          "current": {},
          "hide": 0,
          "includeAll": false,
          "multi": false,
          "options": [],
          "refresh": 1,
          "regex": "",
          "skipUrlSync": false
        }
      ]
    },
    "annotations": {
      "list": []
    },
    "panels": [
      {
        "title": "Devices Online",
        "type": "stat",
        "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
        "targets": [{"expr": "defenseclaw_fleet_devices_total{status=\"online\"}"}],
        "gridPos": {"x": 0, "y": 0, "w": 6, "h": 4}
      },
      {
        "title": "Devices Offline",
        "type": "stat",
        "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
        "targets": [{"expr": "defenseclaw_fleet_devices_total{status=\"offline\"}"}],
        "gridPos": {"x": 6, "y": 0, "w": 6, "h": 4}
      },
      {
        "title": "Active Alerts",
        "type": "stat",
        "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
        "targets": [{"expr": "increase(defenseclaw_fleet_audit_chain_breaks_total[5m]) + increase(defenseclaw_fleet_emergency_seq_gaps_total[5m])"}],
        "gridPos": {"x": 12, "y": 0, "w": 6, "h": 4}
      },
      {
        "title": "Block Rate",
        "type": "stat",
        "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
        "targets": [{"expr": "sum(rate(defenseclaw_fleet_blocks_total[5m]))"}],
        "gridPos": {"x": 18, "y": 0, "w": 6, "h": 4}
      },
      {
        "title": "Block Rate Over Time (24h)",
        "type": "graph",
        "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
        "targets": [{"expr": "sum(rate(defenseclaw_fleet_blocks_total[5m]))"}],
        "gridPos": {"x": 0, "y": 4, "w": 24, "h": 8}
      },
      {
        "title": "Verdict Cache Hit Rate",
        "type": "gauge",
        "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
        "targets": [{"expr": "sum(rate(defenseclaw_fleet_verdict_cache_hits_total[5m])) / (sum(rate(defenseclaw_fleet_verdict_cache_hits_total[5m])) + sum(rate(defenseclaw_fleet_verdict_cache_misses_total[5m]))) or vector(0)"}],
        "gridPos": {"x": 0, "y": 12, "w": 8, "h": 6}
      },
      {
        "title": "Policy Version Distribution",
        "type": "piechart",
        "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
        "targets": [{"expr": "sum by (policy_version) (defenseclaw_fleet_devices_total)"}],
        "gridPos": {"x": 8, "y": 12, "w": 8, "h": 6}
      },
      {
        "title": "Policy Rollbacks",
        "type": "stat",
        "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
        "targets": [{"expr": "sum(defenseclaw_fleet_policy_rollback_total)"}],
        "gridPos": {"x": 16, "y": 12, "w": 8, "h": 6}
      }
    ],
    "time": {"from": "now-24h", "to": "now"},
    "refresh": "30s"
  }
}
