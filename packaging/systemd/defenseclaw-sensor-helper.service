# DefenseClaw sensor helper — holds the privileges the gateway does not and
# answers a fixed, fieldless set of questions about processes, connections
# and host events for AI Discovery.
#
# The socket lives in the helper's own runtime directory, so a gateway
# restart never removes it. The helper resolves the gateway account itself
# and reads the watched homes from the protected guardian manifest; no
# environment file is involved.
#
# SystemCallFilter: start from @system-service plus @network-io (netlink and
# packet sockets), plus fanotify_init and fanotify_mark for the Plane C
# file-access watch on credential roots: they belong to @privileged, which
# @system-service does not include, and the filter would answer EPERM even
# with CAP_SYS_ADMIN granted. Re-derive on a new kernel with SystemCallLog=
# in audit mode before tightening further.

[Unit]
Description=DefenseClaw sensor helper (privileged AI runtime acquisition)
Documentation=https://cisco-ai-defense.github.io/defenseclaw/docs/ai-discovery/
Wants=network-online.target
After=network-online.target
Before=defenseclaw-gateway.service
StartLimitIntervalSec=0

[Service]
Type=simple
User=root
Group=root
Environment=DEFENSECLAW_DEPLOYMENT_MODE=managed_enterprise
Environment=DEFENSECLAW_ENTERPRISE_PROFILE=standalone
ExecStart=/opt/defenseclaw/bin/defenseclaw-sensor-helper --managed-enterprise --service-account defenseclaw --home-dirs-from-manifest /etc/defenseclaw/hook-guardian/targets.yaml
Restart=always
RestartSec=5s
RuntimeDirectory=defenseclaw-sensor
RuntimeDirectoryMode=0750
WorkingDirectory=/
UMask=0007

NoNewPrivileges=true
CapabilityBoundingSet=CAP_SYS_ADMIN CAP_NET_RAW CAP_NET_ADMIN CAP_DAC_READ_SEARCH CAP_SYS_PTRACE CAP_CHOWN CAP_FOWNER
AmbientCapabilities=CAP_SYS_ADMIN CAP_NET_RAW CAP_NET_ADMIN CAP_DAC_READ_SEARCH CAP_SYS_PTRACE CAP_CHOWN CAP_FOWNER
PrivateTmp=true
ProtectHome=read-only
ProtectSystem=strict
ReadOnlyPaths=/etc/defenseclaw /opt/defenseclaw
ProtectClock=true
ProtectControlGroups=true
ProtectHostname=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
# No MemoryDenyWriteExecute: this binary links bytedance/sonic through
# internal/ipc -> internal/gateway. On x86_64 sonic maps executable memory in
# package init, and under the directive mprotect(PROT_EXEC) fails with EPERM
# and the helper panics at start (seen on RHEL 9 x86_64).
RemoveIPC=true
RestrictAddressFamilies=AF_UNIX AF_NETLINK AF_PACKET AF_INET AF_INET6
SystemCallArchitectures=native
SystemCallFilter=@system-service @network-io
SystemCallFilter=fanotify_init fanotify_mark
SystemCallFilter=~@clock @cpu-emulation @module @mount @obsolete @raw-io @reboot @swap
SystemCallErrorNumber=EPERM

[Install]
WantedBy=multi-user.target
