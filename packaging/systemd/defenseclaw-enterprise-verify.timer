# Daily evidence that the managed deployment is intact. The JSON result
# lands in the journal for SIEM collection.

[Unit]
Description=Daily DefenseClaw managed deployment verification
Documentation=https://cisco-ai-defense.github.io/defenseclaw/docs/enterprise/linux/

[Timer]
OnCalendar=daily
RandomizedDelaySec=1h
Persistent=true
Unit=defenseclaw-enterprise-verify.service

[Install]
WantedBy=timers.target
