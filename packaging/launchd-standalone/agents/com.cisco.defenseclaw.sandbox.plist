<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  DefenseClaw sandbox daemon: a LaunchAgent, one per account, in
  /Library/LaunchAgents. launchd loads it at every login but never starts it
  there: it has neither RunAtLoad nor KeepAlive (KeepAlive's SuccessfulExit
  implies RunAtLoad). The `defenseclaw sandbox` launcher bootstraps and
  kickstarts it on demand (gui/<uid> when a GUI session exists, else
  user/<uid>), and starts it again after it exited: idle, for a deferred
  restart, or after a failure (the sandboxes' hooks fail closed meanwhile).
  The daemon binds its own 0600 socket under ~/Library/Application
  Support/DefenseClaw Sandbox. Umask 18 is 0022.
-->
<plist version="1.0">
<dict>
	<key>EnvironmentVariables</key>
	<dict>
		<key>PATH</key>
		<string>/usr/bin:/bin:/usr/sbin:/sbin</string>
	</dict>
	<key>Label</key>
	<string>com.cisco.defenseclaw.sandbox</string>
	<key>LimitLoadToSessionType</key>
	<array>
		<string>Aqua</string>
		<string>Background</string>
	</array>
	<key>ProcessType</key>
	<string>Standard</string>
	<key>ProgramArguments</key>
	<array>
		<string>/opt/cisco/defenseclaw/bin/defenseclaw-gateway</string>
		<string>sandbox-daemon</string>
	</array>
	<key>ThrottleInterval</key>
	<integer>5</integer>
	<key>Umask</key>
	<integer>18</integer>
</dict>
</plist>
