    if ($null -ne $script:DefenseClawNativeSecurityType) {
        $script:DefenseClawNativeSecurityType::StandaloneHolderProbe = [bool](Test-DefenseClawStandaloneProfile)
        return $script:DefenseClawNativeSecurityType
