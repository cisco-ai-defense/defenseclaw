        // GAP-0240: publishes replacement at destination so that destination
        // can be started at every moment. ReplaceFile moves the old file
        // aside and holds the new one open for writing while it merges
        // metadata; an agent starting the hook then got a sharing violation,
        // "Access is denied" or "file not found", and ran the tool call with
        // no DefenseClaw decision. Here the replacement first gets the
        // destination's access list, a second name (backup) is linked to the
        // old file, and a POSIX-semantics rename replaces destination in one
        // step. Windows refuses to remove the last name of a running image,
        // but the old file keeps the backup name, so the rename does not
        // wait for running hook processes. Returns "" on success, otherwise
        // "<stage>:<win32 error>" with stage dacl, open, link or rename; nothing
        // changed then (a backup link made for the attempt is removed, or
        // ";backup-kept" is added when it could not be).
        public static string SwapLaunchableFile(string replacement, string destination, string backup)
        {
            return SwapLaunchableFileCore(replacement, destination, backup, true);
        }

        // GAP-0656 review M2: the same swap for a destination whose own
        // object is not trusted (a foreign owner or writer). The replacement
        // keeps the access list it was created with (inherited from the
        // protected install folder), so no untrusted entry of the old object
        // reaches the new one before Setup stamps it.
        public static string SwapLaunchableFileKeepingAccess(string replacement, string destination, string backup)
        {
            return SwapLaunchableFileCore(replacement, destination, backup, false);
        }

        private static string SwapLaunchableFileCore(string replacement, string destination, string backup, bool copyDestinationAccess)
        {
            const uint READ_CONTROL = 0x00020000;
            const uint WRITE_DAC = 0x00040000;
            const uint DELETE = 0x00010000;
            const uint SYNCHRONIZE = 0x00100000;
            const uint FILE_SHARE_READ = 0x00000001;
            const uint FILE_SHARE_WRITE = 0x00000002;
            const uint FILE_SHARE_DELETE = 0x00000004;
            const uint OPEN_EXISTING = 3;
            const uint FILE_FLAG_OPEN_REPARSE_POINT = 0x00200000;
            const int SE_FILE_OBJECT = 1;
            const uint DACL_SECURITY_INFORMATION = 0x00000004;
            const uint PROTECTED_DACL_SECURITY_INFORMATION = 0x80000000;
            const uint UNPROTECTED_DACL_SECURITY_INFORMATION = 0x20000000;
            const ushort SE_DACL_PROTECTED = 0x1000;
            IntPtr invalid = new IntPtr(-1);

            if (!copyDestinationAccess)
            {
                IntPtr own = CreateFileW(replacement, DELETE | SYNCHRONIZE,
                    FILE_SHARE_READ | FILE_SHARE_DELETE,
                    IntPtr.Zero, OPEN_EXISTING, FILE_FLAG_OPEN_REPARSE_POINT, IntPtr.Zero);
                if (own == invalid)
                    return "open:" + Marshal.GetLastWin32Error().ToString(System.Globalization.CultureInfo.InvariantCulture);
                try
                {
                    return LinkBackupAndRename(own, destination, backup);
                }
                finally
                {
                    CloseHandle(own);
                }
            }

            IntPtr current = CreateFileW(destination, READ_CONTROL,
                FILE_SHARE_READ | FILE_SHARE_WRITE | FILE_SHARE_DELETE,
                IntPtr.Zero, OPEN_EXISTING, FILE_FLAG_OPEN_REPARSE_POINT, IntPtr.Zero);
            if (current == invalid)
                return "dacl:" + Marshal.GetLastWin32Error().ToString(System.Globalization.CultureInfo.InvariantCulture);
            IntPtr owner, group, dacl, sacl;
            IntPtr descriptor = IntPtr.Zero;
            uint status;
            try
            {
                status = GetSecurityInfo(current, SE_FILE_OBJECT, DACL_SECURITY_INFORMATION,
                    out owner, out group, out dacl, out sacl, out descriptor);
            }
            finally
            {
                CloseHandle(current);
            }
            if (status != 0)
                return "dacl:" + status.ToString(System.Globalization.CultureInfo.InvariantCulture);
            try
            {
                ushort control;
                uint revision;
                if (dacl == IntPtr.Zero)
                    return "dacl:null";
                if (!GetSecurityDescriptorControl(descriptor, out control, out revision))
                    return "dacl:" + Marshal.GetLastWin32Error().ToString(System.Globalization.CultureInfo.InvariantCulture);
                IntPtr file = CreateFileW(replacement, READ_CONTROL | WRITE_DAC | DELETE | SYNCHRONIZE,
                    FILE_SHARE_READ | FILE_SHARE_DELETE,
                    IntPtr.Zero, OPEN_EXISTING, FILE_FLAG_OPEN_REPARSE_POINT, IntPtr.Zero);
                if (file == invalid)
                    return "open:" + Marshal.GetLastWin32Error().ToString(System.Globalization.CultureInfo.InvariantCulture);
                try
                {
                    uint information = DACL_SECURITY_INFORMATION |
                        ((control & SE_DACL_PROTECTED) != 0
                            ? PROTECTED_DACL_SECURITY_INFORMATION
                            : UNPROTECTED_DACL_SECURITY_INFORMATION);
                    status = SetSecurityInfo(file, SE_FILE_OBJECT, information,
                        IntPtr.Zero, IntPtr.Zero, dacl, IntPtr.Zero);
                    if (status != 0)
                        return "dacl:" + status.ToString(System.Globalization.CultureInfo.InvariantCulture);
                    return LinkBackupAndRename(file, destination, backup);
                }
                finally
                {
                    CloseHandle(file);
                }
            }
            finally
            {
                if (descriptor != IntPtr.Zero)
                    LocalFree(descriptor);
            }
        }

        // Links backup to the old destination, then renames the open
        // replacement over destination with POSIX semantics in one step.
        private static string LinkBackupAndRename(IntPtr file, string destination, string backup)
        {
            const int FileRenameInfoEx = 22;
            const uint FILE_RENAME_REPLACE_IF_EXISTS = 0x00000001;
            const uint FILE_RENAME_POSIX_SEMANTICS = 0x00000002;
            if (!CreateHardLinkNative(backup, destination, IntPtr.Zero))
                return "link:" + Marshal.GetLastWin32Error().ToString(System.Globalization.CultureInfo.InvariantCulture);
            byte[] name = Encoding.Unicode.GetBytes(destination);
            int nameOffset = IntPtr.Size == 8 ? 20 : 12;
            byte[] rename = new byte[nameOffset + name.Length + 2];
            BitConverter.GetBytes(FILE_RENAME_REPLACE_IF_EXISTS | FILE_RENAME_POSIX_SEMANTICS).CopyTo(rename, 0);
            BitConverter.GetBytes((uint)name.Length).CopyTo(rename, nameOffset - 4);
            name.CopyTo(rename, nameOffset);
            if (!SetFileInformationByHandleNative(file, FileRenameInfoEx, rename, (uint)rename.Length))
            {
                string failure = "rename:" + Marshal.GetLastWin32Error().ToString(System.Globalization.CultureInfo.InvariantCulture);
                if (!DeleteFileNative(backup))
                    failure += ";backup-kept";
                return failure;
            }
            return "";
        }

        // GAP-0656 review M2: 0 when path opens for reading with sharing
        // limited to read and delete, as a program start opens it, so no
        // handle has it open for writing; otherwise the Win32 error (32: a
        // handle holds it for writing).
        public static int GetReadOpenWithoutWriteSharingError(string path)
        {
            const uint GENERIC_READ = 0x80000000;
            const uint FILE_SHARE_READ = 0x00000001;
            const uint FILE_SHARE_DELETE = 0x00000004;
            const uint OPEN_EXISTING = 3;
            const uint FILE_FLAG_OPEN_REPARSE_POINT = 0x00200000;
            IntPtr handle = CreateFileW(path, GENERIC_READ,
                FILE_SHARE_READ | FILE_SHARE_DELETE,
                IntPtr.Zero, OPEN_EXISTING, FILE_FLAG_OPEN_REPARSE_POINT, IntPtr.Zero);
            if (handle == new IntPtr(-1))
                return Marshal.GetLastWin32Error();
            CloseHandle(handle);
            return 0;
        }

        // GAP-0656 review M2 (the g582 trust class): "" when path is an object
        // Setup could have made, otherwise what is wrong with it: more than
        // one name, an owner outside owners or a writer outside writers
        // (OWNER RIGHTS counts as the owner, so it may write only when the
        // owner is a trusted writer), a null or unreadable access list, or a
        // handle open for writing. Deny and inherit-only entries grant
        // nothing here. As in Assert-DefenseClawStandaloneContentTrusted
        // (GAP-0603), the account Setup runs as is trusted as an owner only,
        // never as a writer (review L4).
        public static string GetKeptFileDrift(string path, string[] owners, string[] writers)
        {
            const int WRITE_LIKE = 0x00000002 | 0x00000004 | 0x00000010 | 0x00000040 |
                0x00000100 | 0x00010000 | 0x00040000 | 0x00080000 |
                0x10000000 | 0x40000000;
            uint links = GetRegularFileLinkCountNoFollow(path);
            if (links != 1)
                return "it has " + links.ToString(System.Globalization.CultureInfo.InvariantCulture) + " names (hard links)";
            HashSet<string> allowedOwners = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
            foreach (string sid in owners)
                if (!String.IsNullOrEmpty(sid))
                    allowedOwners.Add(sid);
            HashSet<string> allowedWriters = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
            foreach (string sid in writers)
                if (!String.IsNullOrEmpty(sid))
                    allowedWriters.Add(sid);
            System.Security.AccessControl.RawSecurityDescriptor descriptor =
                new System.Security.AccessControl.RawSecurityDescriptor(GetFileSecurityDescriptor(path), 0);
            string owner = descriptor.Owner == null ? "" : descriptor.Owner.Value;
            if (!allowedOwners.Contains(owner))
                return "its owner " + (owner.Length == 0 ? "(none)" : owner) +
                    " is not SYSTEM, Administrators, TrustedInstaller or the account Setup runs as";
            if (descriptor.DiscretionaryAcl == null)
                return "it has a null access list";
            foreach (System.Security.AccessControl.GenericAce ace in descriptor.DiscretionaryAcl)
            {
                if ((ace.AceFlags & System.Security.AccessControl.AceFlags.InheritOnly) != 0)
                    continue;
                System.Security.AccessControl.AceType type = ace.AceType;
                if (type == System.Security.AccessControl.AceType.AccessDenied ||
                    type == System.Security.AccessControl.AceType.AccessDeniedObject ||
                    type == System.Security.AccessControl.AceType.AccessDeniedCallback ||
                    type == System.Security.AccessControl.AceType.AccessDeniedCallbackObject)
                    continue;
                System.Security.AccessControl.KnownAce known = ace as System.Security.AccessControl.KnownAce;
                if (known == null)
                    return "its access list has an entry of type " + type.ToString();
                string sid = known.SecurityIdentifier.Value;
                if ((known.AccessMask & WRITE_LIKE) != 0 && !allowedWriters.Contains(sid) &&
                    !(sid == "S-1-3-4" && allowedWriters.Contains(owner)))
                    return "the access entry for " + sid + " can change it";
            }
            int open = GetReadOpenWithoutWriteSharingError(path);
            if (open != 0)
                return "it does not open as a program start opens it (Win32 error " +
                    open.ToString(System.Globalization.CultureInfo.InvariantCulture) +
                    "; 32: a handle has it open for writing)";
            return "";
        }

        public static uint GetRegularFileLinkCountNoFollow(string path)
        {
            const uint FILE_FLAG_OPEN_REPARSE_POINT = 0x00200000;
            const uint FILE_ATTRIBUTE_DIRECTORY = 0x00000010;
            const uint FILE_ATTRIBUTE_REPARSE_POINT = 0x00000400;
            IntPtr handle = OpenFileMetadataHandle(
                path,
                FILE_FLAG_OPEN_REPARSE_POINT,
                "open regular file for link-count query failed: ");
            try
            {
                BY_HANDLE_FILE_INFORMATION information;
                if (!GetFileInformationByHandle(handle, out information))
                    throw new Win32Exception(
                        Marshal.GetLastWin32Error(),
                        "query regular file link count failed: " + path);
                if ((information.FileAttributes & FILE_ATTRIBUTE_REPARSE_POINT) != 0 &&
                    ((information.FileAttributes & FILE_ATTRIBUTE_DIRECTORY) != 0 ||
                        !IsBenignFileReparseHandle(handle, path)))
                    throw new InvalidOperationException(
                        "refusing link-count query through a reparse point: " + path);
                if ((information.FileAttributes & FILE_ATTRIBUTE_DIRECTORY) != 0)
                    throw new InvalidOperationException(
                        "link-count query requires a regular file: " + path);
                if (information.NumberOfLinks == 0)
                    throw new InvalidOperationException(
                        "regular file reported an invalid zero link count: " + path);
                return information.NumberOfLinks;
            }
            finally
            {
                CloseHandle(handle);
            }
        }

        // Opens the folder itself (never what a link or junction there
        // names) and holds it without sharing delete access, so it cannot be
        // renamed or replaced while the handle is open. A link, junction or
        // non-folder is refused.
        public static IntPtr OpenDirectoryPinNoFollow(string path)
        {
            const uint FILE_LIST_DIRECTORY = 0x00000001;
            const uint FILE_READ_ATTRIBUTES = 0x00000080;
            const uint SYNCHRONIZE = 0x00100000;
            const uint FILE_SHARE_READ = 0x00000001;
            const uint FILE_SHARE_WRITE = 0x00000002;
            const uint OPEN_EXISTING = 3;
            const uint FILE_FLAG_OPEN_REPARSE_POINT = 0x00200000;
            const uint FILE_FLAG_BACKUP_SEMANTICS = 0x02000000;
            const uint FILE_ATTRIBUTE_DIRECTORY = 0x00000010;
            const uint FILE_ATTRIBUTE_REPARSE_POINT = 0x00000400;
            IntPtr handle = CreateFileW(
                path,
                FILE_LIST_DIRECTORY | FILE_READ_ATTRIBUTES | SYNCHRONIZE,
                FILE_SHARE_READ | FILE_SHARE_WRITE,
                IntPtr.Zero,
                OPEN_EXISTING,
                FILE_FLAG_OPEN_REPARSE_POINT | FILE_FLAG_BACKUP_SEMANTICS,
                IntPtr.Zero);
            if (handle == new IntPtr(-1))
                throw new Win32Exception(
                    Marshal.GetLastWin32Error(),
                    "open folder without following failed: " + path);
            BY_HANDLE_FILE_INFORMATION information;
            if (!GetFileInformationByHandle(handle, out information))
            {
                int error = Marshal.GetLastWin32Error();
                CloseHandle(handle);
                throw new Win32Exception(
                    error,
                    "query folder attributes failed: " + path);
            }
            if ((information.FileAttributes & FILE_ATTRIBUTE_REPARSE_POINT) != 0 ||
                (information.FileAttributes & FILE_ATTRIBUTE_DIRECTORY) == 0)
            {
                CloseHandle(handle);
                throw new InvalidOperationException(
                    "refusing a link, junction or non-folder: " + path);
            }
            return handle;
        }

        public static void CloseDirectoryPin(IntPtr handle)
        {
            if (handle != IntPtr.Zero && handle != new IntPtr(-1))
                CloseHandle(handle);
        }

        // Pin every ancestor before opening the next one. Neither an ancestor
        // nor the leaf can be exchanged for a junction while a user file is
        // read or restored by SYSTEM.
        private static List<IntPtr> PinUserFileParent(string path)
        {
            string full = Path.GetFullPath(path);
            string root = Path.GetPathRoot(full);
            if (root == null || root.Length != 3 || root[1] != ':' ||
                root[2] != '\\' || !Char.IsLetter(root[0]) ||
                !String.Equals(full, path, StringComparison.OrdinalIgnoreCase))
                throw new InvalidOperationException("user file path is not canonical");
            List<IntPtr> pins = new List<IntPtr>();
            try
            {
                string current = root;
                pins.Add(OpenDirectoryPinNoFollow(current));
                string parent = Path.GetDirectoryName(full);
                foreach (string part in parent.Substring(root.Length).Split('\\'))
                {
                    if (part.Length == 0)
                        continue;
                    current = Path.Combine(current, part);
                    pins.Add(OpenDirectoryPinNoFollow(current));
                }
                return pins;
            }
            catch
            {
                CloseUserFilePins(pins);
                throw;
            }
        }

        private static void CloseUserFilePins(List<IntPtr> pins)
        {
            for (int i = pins.Count - 1; i >= 0; i--)
                CloseDirectoryPin(pins[i]);
        }

        private static BY_HANDLE_FILE_INFORMATION CheckUserFileHandle(
            IntPtr handle, string path)
        {
            BY_HANDLE_FILE_INFORMATION information;
            if (!GetFileInformationByHandle(handle, out information))
                throw new Win32Exception(Marshal.GetLastWin32Error(),
                    "query user file failed: " + path);
            if ((information.FileAttributes & 0x00000410) != 0 ||
                information.NumberOfLinks != 1)
                throw new InvalidOperationException(
                    "user file is a link, directory or multiply linked file: " + path);
            ulong size = ((ulong)information.FileSizeHigh << 32) |
                information.FileSizeLow;
            if (size > 4194304)
                throw new InvalidOperationException("user file exceeds capture limit: " + path);
            return information;
        }

        private static string UserFileSddl(IntPtr handle, string path)
        {
            return new System.Security.AccessControl.RawSecurityDescriptor(
                GetFileSecurityDescriptorFromHandle(handle, path), 0).GetSddlForm(
                    System.Security.AccessControl.AccessControlSections.All);
        }

        public static UserFileSnapshot CaptureUserFileNoFollowIfExists(string path)
        {
            const uint GENERIC_READ = 0x80000000;
            const uint READ_CONTROL = 0x00020000;
            const uint FILE_READ_ATTRIBUTES = 0x00000080;
            const uint FILE_SHARE_READ = 0x00000001;
            const uint OPEN_EXISTING = 3;
            const uint FILE_FLAG_OPEN_REPARSE_POINT = 0x00200000;
            List<IntPtr> pins;
            try { pins = PinUserFileParent(path); }
            catch (Win32Exception error)
            {
                // An absent agent directory is a captured absent file, not
                // an unreadable file whose preimage must be skipped.
                if (error.NativeErrorCode == 2 || error.NativeErrorCode == 3)
                    return null;
                throw;
            }
            try
            {
                IntPtr handle = CreateFileW(path,
                    GENERIC_READ | READ_CONTROL | FILE_READ_ATTRIBUTES,
                    FILE_SHARE_READ, IntPtr.Zero, OPEN_EXISTING,
                    FILE_FLAG_OPEN_REPARSE_POINT, IntPtr.Zero);
                if (handle == new IntPtr(-1))
                {
                    int error = Marshal.GetLastWin32Error();
                    if (error == 2 || error == 3)
                        return null;
                    throw new Win32Exception(error, "open user file failed: " + path);
                }
                try
                {
                    BY_HANDLE_FILE_INFORMATION information =
                        CheckUserFileHandle(handle, path);
                    int length = checked((int)(((ulong)information.FileSizeHigh << 32) |
                        information.FileSizeLow));
                    byte[] content = new byte[length];
                    using (var stream = new FileStream(
                        new Microsoft.Win32.SafeHandles.SafeFileHandle(handle, false),
                        FileAccess.Read))
                    {
                        int read = 0;
                        while (read < length)
                        {
                            int count = stream.Read(content, read, length - read);
                            if (count == 0)
                                throw new IOException("user file changed during capture: " + path);
                            read += count;
                        }
                    }
                    return new UserFileSnapshot(content, UserFileSddl(handle, path),
                        File.GetCreationTimeUtc(path), File.GetLastWriteTimeUtc(path));
                }
                finally { CloseHandle(handle); }
            }
            finally { CloseUserFilePins(pins); }
        }

        public static string RestoreUserFileNoFollow(string path, byte[] content,
            string sddl, DateTime creationTimeUtc, DateTime lastWriteTimeUtc,
            string expectedCurrentSha256)
        {
            if (content == null || content.Length > 4194304)
                throw new InvalidOperationException("user file restore size is invalid");
            const uint GENERIC_READ = 0x80000000;
            const uint GENERIC_WRITE = 0x40000000;
            const uint READ_CONTROL = 0x00020000;
            const uint WRITE_DAC = 0x00040000;
            const uint WRITE_OWNER = 0x00080000;
            const uint FILE_SHARE_READ = 0x00000001;
            const uint CREATE_NEW = 1;
            const uint OPEN_EXISTING = 3;
            const uint OPEN_ALWAYS = 4;
            const uint FILE_FLAG_OPEN_REPARSE_POINT = 0x00200000;
            const uint FILE_FLAG_BACKUP_SEMANTICS = 0x02000000;
            const int SE_FILE_OBJECT = 1;
            const uint OWNER_SECURITY_INFORMATION = 0x00000001;
            const uint GROUP_SECURITY_INFORMATION = 0x00000002;
            const uint DACL_SECURITY_INFORMATION = 0x00000004;
            const uint PROTECTED_DACL_SECURITY_INFORMATION = 0x80000000;
            const uint UNPROTECTED_DACL_SECURITY_INFORMATION = 0x20000000;
            IntPtr descriptor;
            SECURITY_ATTRIBUTES ignored = SecurityAttributes(sddl, out descriptor);
            try
            {
                IntPtr owner, group, dacl;
                bool ownerDefaulted, groupDefaulted, daclPresent, daclDefaulted;
                if (!GetSecurityDescriptorOwner(descriptor, out owner, out ownerDefaulted) ||
                    !GetSecurityDescriptorGroup(descriptor, out group, out groupDefaulted) ||
                    !GetSecurityDescriptorDacl(descriptor, out daclPresent, out dacl,
                        out daclDefaulted) || !daclPresent || dacl == IntPtr.Zero)
                    throw new InvalidOperationException("user file descriptor is invalid");
                var saved = new System.Security.AccessControl.RawSecurityDescriptor(sddl);
                uint protection = (saved.ControlFlags &
                    System.Security.AccessControl.ControlFlags.DiscretionaryAclProtected) != 0
                    ? PROTECTED_DACL_SECURITY_INFORMATION
                    : UNPROTECTED_DACL_SECURITY_INFORMATION;
                using (new UninstallFilePrivilegeScope())
                {
                    List<IntPtr> pins = PinUserFileParent(path);
                    try
                    {
                        IntPtr handle = CreateFileW(path,
                            GENERIC_READ | GENERIC_WRITE | READ_CONTROL |
                                WRITE_DAC | WRITE_OWNER,
                            FILE_SHARE_READ, IntPtr.Zero,
                            expectedCurrentSha256 == null ? OPEN_ALWAYS :
                                expectedCurrentSha256 == "absent" ? CREATE_NEW : OPEN_EXISTING,
                            FILE_FLAG_OPEN_REPARSE_POINT | FILE_FLAG_BACKUP_SEMANTICS,
                            IntPtr.Zero);
                        if (handle == new IntPtr(-1))
                            throw new Win32Exception(Marshal.GetLastWin32Error(),
                                "open user file for restore failed: " + path);
                        try
                        {
                            CheckUserFileHandle(handle, path);
                            using (var stream = new FileStream(
                                new Microsoft.Win32.SafeHandles.SafeFileHandle(handle, false),
                                FileAccess.ReadWrite))
                            {
                                if (expectedCurrentSha256 != null &&
                                    expectedCurrentSha256 != "absent")
                                {
                                    stream.Position = 0;
                                    using (var sha = System.Security.Cryptography.SHA256.Create())
                                    {
                                        string actual = BitConverter.ToString(
                                            sha.ComputeHash(stream)).Replace("-", "")
                                            .ToLowerInvariant();
                                        if (!String.Equals(actual, expectedCurrentSha256,
                                                StringComparison.Ordinal))
                                            throw new InvalidOperationException(
                                                "user file changed after transaction postimage capture");
                                    }
                                }
                                stream.Position = 0;
                                stream.Write(content, 0, content.Length);
                                stream.SetLength(content.Length);
                                stream.Flush(true);
                            }
                            uint result = SetSecurityInfo(handle, SE_FILE_OBJECT,
                                OWNER_SECURITY_INFORMATION | GROUP_SECURITY_INFORMATION |
                                    DACL_SECURITY_INFORMATION | protection,
                                owner, group, dacl, IntPtr.Zero);
                            if (result != 0)
                                throw new Win32Exception(checked((int)result),
                                    "restore user file descriptor failed: " + path);
                            if (protection == UNPROTECTED_DACL_SECURITY_INFORMATION)
                            {
                                // A second handle-based update is needed to
                                // clear a previously protected DACL on Windows.
                                result = SetSecurityInfo(handle, SE_FILE_OBJECT,
                                    UNPROTECTED_DACL_SECURITY_INFORMATION,
                                    IntPtr.Zero, IntPtr.Zero, IntPtr.Zero, IntPtr.Zero);
                                if (result != 0)
                                    throw new Win32Exception(checked((int)result),
                                        "restore user file inheritance failed: " + path);
                            }
                            // SetSecurityInfo marks an unprotected DACL as
                            // auto-inherited (SE_DACL_AUTO_INHERITED). A file
                            // an agent created never had that bit, so its
                            // preimage then read back with other control
                            // flags and the rollback reported its ACL as not
                            // restored. Write the preimage's DACL and control
                            // bits as they were.
                            if (!String.Equals(UserFileSddl(handle, path), sddl,
                                    StringComparison.Ordinal) &&
                                !SetKernelObjectSecurity(handle,
                                    DACL_SECURITY_INFORMATION, descriptor))
                                throw new Win32Exception(Marshal.GetLastWin32Error(),
                                    "restore user file DACL control failed: " + path);
                            long creation = creationTimeUtc.ToFileTimeUtc();
                            long modified = lastWriteTimeUtc.ToFileTimeUtc();
                            var creationFileTime = new System.Runtime.InteropServices.ComTypes.FILETIME();
                            creationFileTime.dwLowDateTime = (int)creation;
                            creationFileTime.dwHighDateTime = (int)(creation >> 32);
                            var modifiedFileTime = new System.Runtime.InteropServices.ComTypes.FILETIME();
                            modifiedFileTime.dwLowDateTime = (int)modified;
                            modifiedFileTime.dwHighDateTime = (int)(modified >> 32);
                            if (!SetFileTime(handle, ref creationFileTime,
                                    IntPtr.Zero, ref modifiedFileTime))
                                throw new Win32Exception(Marshal.GetLastWin32Error(),
                                    "restore user file times failed: " + path);
                            return UserFileSddl(handle, path);
                        }
                        finally { CloseHandle(handle); }
                    }
                    finally { CloseUserFilePins(pins); }
                }
            }
            finally { LocalFree(descriptor); }
        }

        [DllImport("kernel32.dll", SetLastError = true, EntryPoint = "SetFileInformationByHandle")]
        [return: MarshalAs(UnmanagedType.Bool)]
        private static extern bool SetFileDispositionInformationByHandle(
            IntPtr file, int informationClass, ref byte deleteFile, uint size);

        // Deletes one regular, singly linked user file through a handle that
        // did not follow a link, with every ancestor pinned. Returns false
        // when the file (or its folder) is absent.
        public static bool RemoveUserFileNoFollow(string path)
        {
            const uint DELETE = 0x00010000;
            const uint FILE_READ_ATTRIBUTES = 0x00000080;
            const uint FILE_SHARE_READ = 0x00000001;
            const uint FILE_SHARE_DELETE = 0x00000004;
            const uint OPEN_EXISTING = 3;
            const uint FILE_FLAG_OPEN_REPARSE_POINT = 0x00200000;
            const uint FILE_FLAG_BACKUP_SEMANTICS = 0x02000000;
            const int FileDispositionInfo = 4;
            using (new UninstallFilePrivilegeScope())
            {
                List<IntPtr> pins;
                try { pins = PinUserFileParent(path); }
                catch (Win32Exception error)
                {
                    if (error.NativeErrorCode == 2 || error.NativeErrorCode == 3)
                        return false;
                    throw;
                }
                try
                {
                    IntPtr handle = CreateFileW(path, DELETE | FILE_READ_ATTRIBUTES,
                        FILE_SHARE_READ | FILE_SHARE_DELETE, IntPtr.Zero, OPEN_EXISTING,
                        FILE_FLAG_OPEN_REPARSE_POINT | FILE_FLAG_BACKUP_SEMANTICS,
                        IntPtr.Zero);
                    if (handle == new IntPtr(-1))
                    {
                        int error = Marshal.GetLastWin32Error();
                        if (error == 2 || error == 3)
                            return false;
                        throw new Win32Exception(error, "open user file for delete failed: " + path);
                    }
                    try
                    {
                        CheckUserFileHandle(handle, path);
                        byte deleteFile = 1;
                        if (!SetFileDispositionInformationByHandle(handle,
                                FileDispositionInfo, ref deleteFile, 1))
                            throw new Win32Exception(Marshal.GetLastWin32Error(),
                                "delete user file failed: " + path);
                        return true;
                    }
                    finally { CloseHandle(handle); }
                }
                finally { CloseUserFilePins(pins); }
            }
        }

        public static void RemoveEmptyUserCasStateNoFollow(string path)
        {
            List<IntPtr> pins;
            try { pins = PinUserFileParent(path); }
            catch (Win32Exception error)
            {
                if (error.NativeErrorCode == 2 || error.NativeErrorCode == 3)
                    return;
                throw;
            }
            try
            {
                IntPtr state;
                try { state = OpenDirectoryPinNoFollow(path); }
                catch (Win32Exception error)
                {
                    if (error.NativeErrorCode == 2 || error.NativeErrorCode == 3)
                        return;
                    throw;
                }
                try
                {
                    string[] children = Directory.GetFileSystemEntries(path);
                    string expected = Path.Combine(path,
                        ".defenseclaw-v2-protocol.lock");
                    if (children.Length != 1 ||
                        !String.Equals(children[0], expected,
                            StringComparison.OrdinalIgnoreCase) ||
                        (File.GetAttributes(expected) & FileAttributes.ReparsePoint) != 0 ||
                        new FileInfo(expected).Length != 0)
                        throw new InvalidOperationException(
                            "native OTLP rollback found unexpected compare-and-swap state");
                    File.Delete(expected);
                }
                finally { CloseDirectoryPin(state); }
                Directory.Delete(path, false);
            }
            finally { CloseUserFilePins(pins); }
        }

        public static byte[] GetFileSecurityDescriptor(string path)
        {
            const uint READ_CONTROL = 0x00020000;
            const uint FILE_SHARE_READ = 0x00000001;
            const uint FILE_SHARE_WRITE = 0x00000002;
            const uint FILE_SHARE_DELETE = 0x00000004;
            const uint OPEN_EXISTING = 3;
            const uint FILE_FLAG_OPEN_REPARSE_POINT = 0x00200000;
            const uint FILE_FLAG_BACKUP_SEMANTICS = 0x02000000;
            const uint FILE_ATTRIBUTE_DIRECTORY = 0x00000010;
            const uint FILE_ATTRIBUTE_REPARSE_POINT = 0x00000400;
            const int SE_FILE_OBJECT = 1;
            const uint OWNER_SECURITY_INFORMATION = 0x00000001;
            const uint GROUP_SECURITY_INFORMATION = 0x00000002;
            const uint DACL_SECURITY_INFORMATION = 0x00000004;
            const ushort SE_SELF_RELATIVE = 0x8000;
            const int ERROR_INSUFFICIENT_BUFFER = 122;

            IntPtr handle = CreateFileW(
                path,
                READ_CONTROL,
                FILE_SHARE_READ | FILE_SHARE_WRITE | FILE_SHARE_DELETE,
                IntPtr.Zero,
                OPEN_EXISTING,
                FILE_FLAG_OPEN_REPARSE_POINT | FILE_FLAG_BACKUP_SEMANTICS,
                IntPtr.Zero);
            if (handle == new IntPtr(-1))
                throw new Win32Exception(
                    Marshal.GetLastWin32Error(),
                    "open file for raw security query failed: " + path);
            try
            {
                BY_HANDLE_FILE_INFORMATION information;
                if (!GetFileInformationByHandle(handle, out information))
                    throw new Win32Exception(
                        Marshal.GetLastWin32Error(),
                        "query file attributes for raw security failed: " + path);
                if ((information.FileAttributes & FILE_ATTRIBUTE_REPARSE_POINT) != 0 &&
                    ((information.FileAttributes & FILE_ATTRIBUTE_DIRECTORY) != 0 ||
                        !IsBenignFileReparseHandle(handle, path)))
                    throw new InvalidOperationException(
                        "refusing raw security query through a reparse point: " + path);

                IntPtr owner;
                IntPtr group;
                IntPtr dacl;
                IntPtr sacl;
                IntPtr descriptor;
                uint result = GetSecurityInfo(
                    handle,
                    SE_FILE_OBJECT,
                    OWNER_SECURITY_INFORMATION |
                        GROUP_SECURITY_INFORMATION |
                        DACL_SECURITY_INFORMATION,
                    out owner,
                    out group,
                    out dacl,
                    out sacl,
                    out descriptor);
                if (result != 0)
                    throw new Win32Exception(
                        checked((int)result),
                        "raw file security query failed: " + path);
                if (descriptor == IntPtr.Zero)
                    throw new InvalidOperationException(
                        "raw file security query returned a null descriptor: " + path);
                try
                {
                    ushort control;
                    uint revision;
                    if (!GetSecurityDescriptorControl(
                        descriptor,
                        out control,
                        out revision))
                        throw new Win32Exception(
                            Marshal.GetLastWin32Error(),
                            "query raw security descriptor control failed: " + path);

                    if ((control & SE_SELF_RELATIVE) != 0)
                    {
                        uint length = GetSecurityDescriptorLength(descriptor);
                        if (length == 0 || length > 1048576)
                            throw new InvalidOperationException(
                                "raw security descriptor length is invalid: " + path);
                        byte[] bytes = new byte[checked((int)length)];
                        Marshal.Copy(descriptor, bytes, 0, bytes.Length);
                        return bytes;
                    }

                    uint required = 0;
                    if (MakeSelfRelativeSD(descriptor, null, ref required))
                        throw new InvalidOperationException(
                            "raw security conversion returned no required length: " + path);
                    int conversionError = Marshal.GetLastWin32Error();
                    if (conversionError != ERROR_INSUFFICIENT_BUFFER ||
                        required == 0 ||
                        required > 1048576)
                        throw new Win32Exception(
                            conversionError,
                            "size raw self-relative security descriptor failed: " + path);
                    byte[] relative = new byte[checked((int)required)];
                    if (!MakeSelfRelativeSD(descriptor, relative, ref required))
                        throw new Win32Exception(
                            Marshal.GetLastWin32Error(),
                            "convert raw security descriptor failed: " + path);
                    if (required != relative.Length)
                        throw new InvalidOperationException(
                            "raw security descriptor conversion length changed: " + path);
                    return relative;
                }
                finally
                {
                    LocalFree(descriptor);
                }
            }
            finally
            {
                CloseHandle(handle);
            }
        }

        private static string FileIdentity(
            BY_HANDLE_FILE_INFORMATION information)
        {
            return String.Format(
                System.Globalization.CultureInfo.InvariantCulture,
                "{0:x8}:{1:x8}{2:x8}",
                information.VolumeSerialNumber,
                information.FileIndexHigh,
                information.FileIndexLow);
        }

        private static void ValidateFixedRegularFile(
            IntPtr handle,
            BY_HANDLE_FILE_INFORMATION information,
            uint expectedSize,
            string path)
        {
            const uint FILE_ATTRIBUTE_DIRECTORY = 0x00000010;
            const uint FILE_ATTRIBUTE_REPARSE_POINT = 0x00000400;
            if ((information.FileAttributes & FILE_ATTRIBUTE_DIRECTORY) != 0 ||
                ((information.FileAttributes & FILE_ATTRIBUTE_REPARSE_POINT) != 0 &&
                    !IsBenignFileReparseHandle(handle, path)))
                throw new InvalidOperationException(
                    "managed secret is not a no-follow regular file: " + path);
            if (information.NumberOfLinks != 1)
                throw new InvalidOperationException(
                    "managed secret must have exactly one hard link: " + path);
            // expectedSize == 0 opts out of the fixed-length invariant; used
            // by variable-size protected files (e.g. cleanup receipts) that
            // still want the no-follow + single-link invariants.
            if (expectedSize == 0)
                return;
            ulong size = ((ulong)information.FileSizeHigh << 32) |
                (ulong)information.FileSizeLow;
            if (size != expectedSize)
                throw new InvalidOperationException(
                    "managed secret has an invalid fixed length: " + path);
        }

        private static byte[] GetFileSecurityDescriptorFromHandle(
            IntPtr handle,
            string path)
        {
            const int SE_FILE_OBJECT = 1;
            const uint OWNER_SECURITY_INFORMATION = 0x00000001;
            const uint GROUP_SECURITY_INFORMATION = 0x00000002;
            const uint DACL_SECURITY_INFORMATION = 0x00000004;
            const ushort SE_SELF_RELATIVE = 0x8000;
            const int ERROR_INSUFFICIENT_BUFFER = 122;
            IntPtr owner;
            IntPtr group;
            IntPtr dacl;
            IntPtr sacl;
            IntPtr descriptor;
            uint result = GetSecurityInfo(
                handle,
                SE_FILE_OBJECT,
                OWNER_SECURITY_INFORMATION |
                    GROUP_SECURITY_INFORMATION |
                    DACL_SECURITY_INFORMATION,
                out owner,
                out group,
                out dacl,
                out sacl,
                out descriptor);
            if (result != 0)
                throw new Win32Exception(
                    checked((int)result),
                    "query managed secret security failed: " + path);
            if (descriptor == IntPtr.Zero)
                throw new InvalidOperationException(
                    "managed secret security query returned null: " + path);
            try
            {
                ushort control;
                uint revision;
                if (!GetSecurityDescriptorControl(
                    descriptor,
                    out control,
                    out revision))
                    throw new Win32Exception(
                        Marshal.GetLastWin32Error(),
                        "query managed secret security control failed: " + path);
                if ((control & SE_SELF_RELATIVE) != 0)
                {
                    uint length = GetSecurityDescriptorLength(descriptor);
                    if (length == 0 || length > 1048576)
                        throw new InvalidOperationException(
                            "managed secret security length is invalid: " + path);
                    byte[] bytes = new byte[checked((int)length)];
                    Marshal.Copy(descriptor, bytes, 0, bytes.Length);
                    return bytes;
                }
                uint required = 0;
                if (MakeSelfRelativeSD(descriptor, null, ref required))
                    throw new InvalidOperationException(
                        "managed secret security conversion returned no size: " + path);
                int conversionError = Marshal.GetLastWin32Error();
                if (conversionError != ERROR_INSUFFICIENT_BUFFER ||
                    required == 0 ||
                    required > 1048576)
                    throw new Win32Exception(
                        conversionError,
                        "size managed secret security failed: " + path);
                byte[] relative = new byte[checked((int)required)];
                if (!MakeSelfRelativeSD(descriptor, relative, ref required))
                    throw new Win32Exception(
                        Marshal.GetLastWin32Error(),
                        "convert managed secret security failed: " + path);
                if (required != relative.Length)
                    throw new InvalidOperationException(
                        "managed secret security conversion changed length: " + path);
                return relative;
            }
            finally
            {
                LocalFree(descriptor);
            }
        }

        // Opens without following links, sharing read, write and delete, and
        // retries a sharing violation with a short bounded backoff. Access
        // denied and not found are returned at once; they are not transient.
        private static IntPtr CreateFileNoFollowWithRetry(
            string path,
            uint desiredAccess,
            uint flags,
            out int error)
        {
            const uint FILE_SHARE_READ = 0x00000001;
            const uint FILE_SHARE_WRITE = 0x00000002;
            const uint FILE_SHARE_DELETE = 0x00000004;
            const uint OPEN_EXISTING = 3;
            const int ERROR_SHARING_VIOLATION = 32;
            const int ERROR_LOCK_VIOLATION = 33;
            IntPtr handle = new IntPtr(-1);
            error = 0;
            for (int attempt = 1; attempt <= 6; attempt++)
            {
                handle = CreateFileW(
                    path,
                    desiredAccess,
                    FILE_SHARE_READ | FILE_SHARE_WRITE | FILE_SHARE_DELETE,
                    IntPtr.Zero,
                    OPEN_EXISTING,
                    flags,
                    IntPtr.Zero);
                if (handle != new IntPtr(-1))
                    return handle;
                error = Marshal.GetLastWin32Error();
                if ((error != ERROR_SHARING_VIOLATION &&
                        error != ERROR_LOCK_VIOLATION) ||
                    attempt == 6)
                    return handle;
                System.Threading.Thread.Sleep(100 * attempt);
            }
            return handle;
        }

        // Re-stamps the canonical owner, group and protected DACL on a
        // DefenseClaw-owned path through a no-follow handle. Backup, restore
        // and take-ownership are enabled on a thread-bound duplicate token
        // before the open, so another administrator's owner or a DACL that
        // removed WRITE_DAC from Administrators can still be repaired. When a
        // user-rights policy removed restore, take-ownership first makes
        // Administrators the owner, whose implicit WRITE_DAC then completes
        // the repair. Reparse points, the wrong object type and extra hard
        // links are refused before anything is written.
        public static PathSecuritySnapshot SetPathSecurityDescriptorPrivilegedNoFollow(
            string path,
            string sddl,
            bool directory)
        {
            using (UninstallFilePrivilegeScope scope = new UninstallFilePrivilegeScope(true))
            {
                // Without restore the token may assign only an owner it holds
                // itself, so Administrators is stamped instead of SYSTEM.
                string effective = sddl;
                if (!scope.RestoreEnabled)
                {
                    effective = WithAdministratorsOwner(sddl);
                    if (!String.Equals(effective, sddl, StringComparison.Ordinal))
                        RecordPrivilegeFallback(
                            path,
                            "SeRestorePrivilege",
                            "owner Administrators stamped instead of the canonical owner");
                }
                return SetPathSecurityDescriptorPrivilegedNoFollowCore(
                    path,
                    effective,
                    directory,
                    scope);
            }
        }

        private static PathSecuritySnapshot SetPathSecurityDescriptorPrivilegedNoFollowCore(
            string path,
            string sddl,
            bool directory,
            UninstallFilePrivilegeScope scope)
        {
            const uint FILE_READ_ATTRIBUTES = 0x00000080;
            const uint READ_CONTROL = 0x00020000;
            const uint WRITE_DAC = 0x00040000;
            const uint WRITE_OWNER = 0x00080000;
            const uint FILE_FLAG_OPEN_REPARSE_POINT = 0x00200000;
            const uint FILE_FLAG_BACKUP_SEMANTICS = 0x02000000;
            const int SE_FILE_OBJECT = 1;
            const uint OWNER_SECURITY_INFORMATION = 0x00000001;
            const uint GROUP_SECURITY_INFORMATION = 0x00000002;
            const uint DACL_SECURITY_INFORMATION = 0x00000004;
            const uint PROTECTED_DACL_SECURITY_INFORMATION = 0x80000000;
            const int ERROR_ACCESS_DENIED = 5;
            const uint flags = FILE_FLAG_OPEN_REPARSE_POINT | FILE_FLAG_BACKUP_SEMANTICS;

            IntPtr descriptor;
            SECURITY_ATTRIBUTES ignored = SecurityAttributes(sddl, out descriptor);
            try
            {
                IntPtr owner;
                IntPtr group;
                IntPtr dacl;
                bool ownerDefaulted;
                bool groupDefaulted;
                bool daclPresent;
                bool daclDefaulted;
                if (!GetSecurityDescriptorOwner(descriptor, out owner, out ownerDefaulted) ||
                    owner == IntPtr.Zero)
                    throw new Win32Exception(
                        Marshal.GetLastWin32Error(),
                        "canonical descriptor has no owner");
                if (!GetSecurityDescriptorGroup(descriptor, out group, out groupDefaulted) ||
                    group == IntPtr.Zero)
                    throw new Win32Exception(
                        Marshal.GetLastWin32Error(),
                        "canonical descriptor has no group");
                if (!GetSecurityDescriptorDacl(descriptor, out daclPresent, out dacl, out daclDefaulted) ||
                    !daclPresent ||
                    dacl == IntPtr.Zero)
                    throw new Win32Exception(
                        Marshal.GetLastWin32Error(),
                        "canonical descriptor has no DACL");

                {
                    int openError;
                    IntPtr handle = CreateFileNoFollowWithRetry(
                        path,
                        FILE_READ_ATTRIBUTES | READ_CONTROL | WRITE_DAC | WRITE_OWNER,
                        flags,
                        out openError);
                    if (handle == new IntPtr(-1))
                    {
                        if (openError != ERROR_ACCESS_DENIED || !scope.TakeOwnershipEnabled)
                            throw new Win32Exception(
                                openError,
                                "open managed path for ACL repair failed: " + path +
                                    (openError == ERROR_ACCESS_DENIED
                                        ? MissingPrivilegeSuffix(scope)
                                        : String.Empty));
                        IntPtr ownerHandle = CreateFileNoFollowWithRetry(
                            path,
                            FILE_READ_ATTRIBUTES | WRITE_OWNER,
                            flags,
                            out openError);
                        if (ownerHandle == new IntPtr(-1))
                            throw new Win32Exception(
                                openError,
                                "take ownership of managed path for ACL repair failed: " + path);
                        try
                        {
                            BY_HANDLE_FILE_INFORMATION ownerInformation;
                            if (!GetFileInformationByHandle(ownerHandle, out ownerInformation))
                                throw new Win32Exception(
                                    Marshal.GetLastWin32Error(),
                                    "query managed path identity failed: " + path);
                            ValidateRepairTarget(ownerHandle, ownerInformation, directory, path);
                            uint ownerResult = SetSecurityInfo(
                                ownerHandle,
                                SE_FILE_OBJECT,
                                OWNER_SECURITY_INFORMATION,
                                owner,
                                IntPtr.Zero,
                                IntPtr.Zero,
                                IntPtr.Zero);
                            if (ownerResult != 0)
                                throw new Win32Exception(
                                    checked((int)ownerResult),
                                    "take ownership of managed path failed: " + path);
                        }
                        finally
                        {
                            CloseHandle(ownerHandle);
                        }
                        handle = CreateFileNoFollowWithRetry(
                            path,
                            FILE_READ_ATTRIBUTES | READ_CONTROL | WRITE_DAC | WRITE_OWNER,
                            flags,
                            out openError);
                        if (handle == new IntPtr(-1))
                            throw new Win32Exception(
                                openError,
                                "reopen managed path for ACL repair failed: " + path);
                    }
                    try
                    {
                        BY_HANDLE_FILE_INFORMATION before;
                        if (!GetFileInformationByHandle(handle, out before))
                            throw new Win32Exception(
                                Marshal.GetLastWin32Error(),
                                "query managed path identity failed: " + path);
                        ValidateRepairTarget(handle, before, directory, path);
                        uint result = 0;
                        if (directory)
                        {
                            // A repaired folder can hold files DefenseClaw
                            // doesn't own; only the folder is re-stamped.
                            if (!SetKernelObjectSecurity(
                                    handle,
                                    OWNER_SECURITY_INFORMATION |
                                        GROUP_SECURITY_INFORMATION |
                                        DACL_SECURITY_INFORMATION |
                                        PROTECTED_DACL_SECURITY_INFORMATION,
                                    descriptor))
                                result = checked((uint)Marshal.GetLastWin32Error());
                        }
                        else
                        {
                            result = SetSecurityInfo(
                                handle,
                                SE_FILE_OBJECT,
                                OWNER_SECURITY_INFORMATION |
                                    GROUP_SECURITY_INFORMATION |
                                    DACL_SECURITY_INFORMATION |
                                    PROTECTED_DACL_SECURITY_INFORMATION,
                                owner,
                                group,
                                dacl,
                                IntPtr.Zero);
                        }
                        if (result != 0)
                            throw new Win32Exception(
                                checked((int)result),
                                "set managed path owner and DACL failed: " + path);
                        BY_HANDLE_FILE_INFORMATION after;
                        if (!GetFileInformationByHandle(handle, out after))
                            throw new Win32Exception(
                                Marshal.GetLastWin32Error(),
                                "recheck managed path identity failed: " + path);
                        string identity = FileIdentity(after);
                        if (!String.Equals(FileIdentity(before), identity, StringComparison.Ordinal))
                            throw new InvalidOperationException(
                                "managed path identity changed during ACL repair: " + path);
                        return new PathSecuritySnapshot(
                            identity,
                            GetFileSecurityDescriptorFromHandle(handle, path));
                    }
                    finally
                    {
                        CloseHandle(handle);
                    }
                }
            }
            finally
            {
                LocalFree(descriptor);
            }
        }

        private static void ValidateRepairTarget(
            IntPtr handle,
            BY_HANDLE_FILE_INFORMATION information,
            bool directory,
            string path)
        {
            const uint FILE_ATTRIBUTE_DIRECTORY = 0x00000010;
            const uint FILE_ATTRIBUTE_REPARSE_POINT = 0x00000400;
            if ((information.FileAttributes & FILE_ATTRIBUTE_REPARSE_POINT) != 0 &&
                (directory || !IsBenignFileReparseHandle(handle, path)))
                throw new InvalidOperationException(
                    "refusing ACL repair through a reparse point: " + path);
            bool isDirectory = (information.FileAttributes & FILE_ATTRIBUTE_DIRECTORY) != 0;
            if (isDirectory != directory)
                throw new InvalidOperationException(
                    "managed path has the wrong object type for ACL repair: " + path);
            if (!directory && information.NumberOfLinks != 1)
                throw new InvalidOperationException(
                    "managed file must have exactly one hard link: " + path);
        }

        // Deletes a DefenseClaw tree during the purge without rewriting any
        // ACL. Backup and restore privileges on a thread-bound duplicate token
        // let a no-follow backup-semantics handle list and delete entries
        // whatever their DACL or owner, including a subfolder that denies
        // Administrators list access. Reparse points are deleted as links and
        // never followed. Every path that could not be deleted is returned;
        // nothing is thrown for one entry.
        public static string[] DeleteTreePrivileged(string root)
        {
            return DeleteTreePrivilegedCore(root, null, false);
        }

        // GAP-0890: deleted, when given, receives the path of each entry whose
        // deletion was requested (links are named as links), so the caller can
        // log every privileged deletion.
        //
        // This overload enables backup and restore only (GAP-0890 review S3):
        // the delete opens each entry with backup semantics for DELETE and the
        // listing (backup traverses and lists, restore grants DELETE) and
        // never rewrites an owner or an access list, so take-ownership, which
        // the one-argument overload keeps for the forced-uninstall path, is
        // not asked for.
        public static string[] DeleteTreePrivileged(string root, List<string> deleted)
        {
            return DeleteTreePrivilegedCore(root, deleted, true);
        }

        private static string[] DeleteTreePrivilegedCore(string root, List<string> deleted, bool backupRestoreOnly)
        {
            List<string> failures = new List<string>();
            using (UninstallFilePrivilegeScope scope = new UninstallFilePrivilegeScope(true, backupRestoreOnly))
            {
                DeleteEntryPrivileged(root, failures, 0, deleted);
                string missing = MissingPrivilegeSuffix(scope);
                if (missing.Length != 0)
                {
                    for (int index = 0; index < failures.Count; index++)
                        failures[index] = failures[index] + missing;
                }
            }
            return failures.ToArray();
        }

        private static void DeleteEntryPrivileged(
            string path,
            List<string> failures,
            int depth,
            List<string> deleted)
        {
            const uint DELETE = 0x00010000;
            const uint SYNCHRONIZE = 0x00100000;
            const uint FILE_LIST_DIRECTORY = 0x00000001;
            const uint FILE_READ_ATTRIBUTES = 0x00000080;
            const uint FILE_WRITE_ATTRIBUTES = 0x00000100;
            const uint FILE_FLAG_OPEN_REPARSE_POINT = 0x00200000;
            const uint FILE_FLAG_BACKUP_SEMANTICS = 0x02000000;
            const uint FILE_ATTRIBUTE_READONLY = 0x00000001;
            const uint FILE_ATTRIBUTE_DIRECTORY = 0x00000010;
            const uint FILE_ATTRIBUTE_REPARSE_POINT = 0x00000400;
            const int ERROR_FILE_NOT_FOUND = 2;
            const int ERROR_PATH_NOT_FOUND = 3;
            const int ERROR_NO_MORE_FILES = 18;
            const int FileBasicInfo = 0;
            const int FileDispositionInfo = 4;
            const int FileFullDirectoryInfo = 14;
            const int FileFullDirectoryRestartInfo = 15;
            if (depth > 128)
            {
                failures.Add(path + ": nesting is too deep");
                return;
            }
            int openError;
            IntPtr handle = CreateFileNoFollowWithRetry(
                path,
                DELETE | SYNCHRONIZE | FILE_LIST_DIRECTORY |
                    FILE_READ_ATTRIBUTES | FILE_WRITE_ATTRIBUTES,
                FILE_FLAG_OPEN_REPARSE_POINT | FILE_FLAG_BACKUP_SEMANTICS,
                out openError);
            if (handle == new IntPtr(-1))
            {
                if (openError != ERROR_FILE_NOT_FOUND &&
                    openError != ERROR_PATH_NOT_FOUND)
                    failures.Add(path + ": open failed (" + openError + ")");
                return;
            }
            try
            {
                BY_HANDLE_FILE_INFORMATION information;
                if (!GetFileInformationByHandle(handle, out information))
                {
                    failures.Add(path + ": query failed (" + Marshal.GetLastWin32Error() + ")");
                    return;
                }
                uint attributes = information.FileAttributes;
                if ((attributes & FILE_ATTRIBUTE_DIRECTORY) != 0 &&
                    (attributes & FILE_ATTRIBUTE_REPARSE_POINT) == 0)
                {
                    List<string> names = new List<string>();
                    byte[] buffer = new byte[65536];
                    int informationClass = FileFullDirectoryRestartInfo;
                    while (true)
                    {
                        if (!GetFileInformationByHandleEx(
                                handle,
                                informationClass,
                                buffer,
                                (uint)buffer.Length))
                        {
                            int listError = Marshal.GetLastWin32Error();
                            if (listError != ERROR_NO_MORE_FILES)
                                failures.Add(path + ": list failed (" + listError + ")");
                            break;
                        }
                        informationClass = FileFullDirectoryInfo;
                        int offset = 0;
                        while (true)
                        {
                            int next = BitConverter.ToInt32(buffer, offset);
                            int nameLength = BitConverter.ToInt32(buffer, offset + 60);
                            string name = System.Text.Encoding.Unicode.GetString(
                                buffer,
                                offset + 68,
                                nameLength);
                            if (name != "." && name != "..")
                                names.Add(name);
                            if (next == 0)
                                break;
                            offset += next;
                        }
                    }
                    foreach (string name in names)
                        DeleteEntryPrivileged(
                            System.IO.Path.Combine(path, name),
                            failures,
                            depth + 1,
                            deleted);
                }
                if ((attributes & FILE_ATTRIBUTE_READONLY) != 0)
                {
                    // FILE_BASIC_INFO: four timestamps (zero keeps them),
                    // then the attributes.
                    byte[] basic = new byte[40];
                    uint cleared = attributes & ~FILE_ATTRIBUTE_READONLY;
                    if (cleared == 0)
                        cleared = 0x00000080;
                    BitConverter.GetBytes(cleared).CopyTo(basic, 32);
                    SetFileInformationByHandle(handle, FileBasicInfo, basic, (uint)basic.Length);
                }
                byte[] disposition = new byte[] { 1 };
                if (!SetFileInformationByHandle(
                        handle,
                        FileDispositionInfo,
                        disposition,
                        (uint)disposition.Length))
                    failures.Add(path + ": delete failed (" + Marshal.GetLastWin32Error() + ")");
                else if (deleted != null)
                    deleted.Add(
                        (attributes & FILE_ATTRIBUTE_REPARSE_POINT) != 0
                            ? path + " (link, not followed)"
                            : path);
            }
            finally
            {
                CloseHandle(handle);
            }
        }

        // Lists a tree for restart deletion the way DeleteTreePrivileged walks
        // it: every entry is opened no-follow with backup semantics, and only
        // a handle that is a directory and not a reparse point is descended,
        // so a root or child swapped for a junction is listed as the link
        // itself and its target is never reached. Entries are returned
        // parent first; failures name what could not be opened or listed.
        public static string[] ListTreeNoFollow(string root, out string[] failures)
        {
            List<string> entries = new List<string>();
            List<string> errors = new List<string>();
            using (UninstallFilePrivilegeScope scope = new UninstallFilePrivilegeScope(true))
            {
                ListEntryNoFollow(root, entries, errors, 0);
            }
            failures = errors.ToArray();
            return entries.ToArray();
        }

        private static void ListEntryNoFollow(
            string path,
            List<string> entries,
            List<string> errors,
            int depth)
        {
            const uint SYNCHRONIZE = 0x00100000;
            const uint FILE_LIST_DIRECTORY = 0x00000001;
            const uint FILE_READ_ATTRIBUTES = 0x00000080;
            const uint FILE_FLAG_OPEN_REPARSE_POINT = 0x00200000;
            const uint FILE_FLAG_BACKUP_SEMANTICS = 0x02000000;
            const uint FILE_ATTRIBUTE_DIRECTORY = 0x00000010;
            const uint FILE_ATTRIBUTE_REPARSE_POINT = 0x00000400;
            const int ERROR_FILE_NOT_FOUND = 2;
            const int ERROR_PATH_NOT_FOUND = 3;
            const int ERROR_NO_MORE_FILES = 18;
            const int FileFullDirectoryInfo = 14;
            const int FileFullDirectoryRestartInfo = 15;
            if (depth > 128)
            {
                errors.Add(path + ": nesting is too deep");
                return;
            }
            int openError;
            IntPtr handle = CreateFileNoFollowWithRetry(
                path,
                SYNCHRONIZE | FILE_LIST_DIRECTORY | FILE_READ_ATTRIBUTES,
                FILE_FLAG_OPEN_REPARSE_POINT | FILE_FLAG_BACKUP_SEMANTICS,
                out openError);
            if (handle == new IntPtr(-1))
            {
                if (openError != ERROR_FILE_NOT_FOUND &&
                    openError != ERROR_PATH_NOT_FOUND)
                    errors.Add(path + ": open failed (" + openError + ")");
                return;
            }
            try
            {
                entries.Add(path);
                BY_HANDLE_FILE_INFORMATION information;
                if (!GetFileInformationByHandle(handle, out information))
                {
                    errors.Add(path + ": query failed (" + Marshal.GetLastWin32Error() + ")");
                    return;
                }
                uint attributes = information.FileAttributes;
                if ((attributes & FILE_ATTRIBUTE_DIRECTORY) == 0 ||
                    (attributes & FILE_ATTRIBUTE_REPARSE_POINT) != 0)
                    return;
                List<string> names = new List<string>();
                byte[] buffer = new byte[65536];
                int informationClass = FileFullDirectoryRestartInfo;
                while (true)
                {
                    if (!GetFileInformationByHandleEx(
                            handle,
                            informationClass,
                            buffer,
                            (uint)buffer.Length))
                    {
                        int listError = Marshal.GetLastWin32Error();
                        if (listError != ERROR_NO_MORE_FILES)
                            errors.Add(path + ": list failed (" + listError + ")");
                        break;
                    }
                    informationClass = FileFullDirectoryInfo;
                    int offset = 0;
                    while (true)
                    {
                        int next = BitConverter.ToInt32(buffer, offset);
                        int nameLength = BitConverter.ToInt32(buffer, offset + 60);
                        string name = System.Text.Encoding.Unicode.GetString(
                            buffer,
                            offset + 68,
                            nameLength);
                        if (name != "." && name != "..")
                            names.Add(name);
                        if (next == 0)
                            break;
                        offset += next;
                    }
                }
                foreach (string name in names)
                    ListEntryNoFollow(
                        System.IO.Path.Combine(path, name),
                        entries,
                        errors,
                        depth + 1);
            }
            finally
            {
                CloseHandle(handle);
            }
        }

        // Reads a managed file's bytes through a no-follow backup-semantics
        // handle with backup privilege enabled, so a transaction can capture
        // the preimage of a file whose DACL no longer grants Administrators
        // read. One hard link and a regular file are still required.
        public static byte[] ReadFileBackupSemantics(string path, int limit)
        {
            const uint GENERIC_READ = 0x80000000;
            const uint FILE_FLAG_OPEN_REPARSE_POINT = 0x00200000;
            const uint FILE_FLAG_BACKUP_SEMANTICS = 0x02000000;
            using (UninstallFilePrivilegeScope scope = new UninstallFilePrivilegeScope(true))
            {
                int openError;
                IntPtr handle = CreateFileNoFollowWithRetry(
                    path,
                    GENERIC_READ,
                    FILE_FLAG_OPEN_REPARSE_POINT | FILE_FLAG_BACKUP_SEMANTICS,
                    out openError);
                if (handle == new IntPtr(-1))
                    throw new Win32Exception(
                        openError,
                        "open managed file with backup semantics failed: " + path +
                            MissingPrivilegeSuffix(scope));
                try
                {
                    BY_HANDLE_FILE_INFORMATION information;
                    if (!GetFileInformationByHandle(handle, out information))
                        throw new Win32Exception(
                            Marshal.GetLastWin32Error(),
                            "query managed file identity failed: " + path);
                    ValidateRepairTarget(handle, information, false, path);
                    ulong size = ((ulong)information.FileSizeHigh << 32) |
                        (ulong)information.FileSizeLow;
                    if (size > (ulong)limit)
                        throw new InvalidOperationException(
                            "managed file exceeds its read limit: " + path);
                    using (Microsoft.Win32.SafeHandles.SafeFileHandle safe =
                        new Microsoft.Win32.SafeHandles.SafeFileHandle(handle, false))
                    using (System.IO.FileStream stream = new System.IO.FileStream(
                        safe,
                        System.IO.FileAccess.Read))
                    {
                        byte[] bytes = new byte[(int)size];
                        int read = 0;
                        while (read < bytes.Length)
                        {
                            int chunk = stream.Read(bytes, read, bytes.Length - read);
                            if (chunk <= 0)
                                throw new InvalidOperationException(
                                    "managed file changed size while it was read: " + path);
                            read += chunk;
                        }
                        return bytes;
                    }
                }
                finally
                {
                    CloseHandle(handle);
                }
            }
        }

