    return $false
}

function Get-DefenseClawServiceSID {
    param([Parameter(Mandatory)][string]$ServiceName)
    $account = [Security.Principal.NTAccount]::new("NT SERVICE\$ServiceName")
    try {
        return $account.Translate([Security.Principal.SecurityIdentifier]).Value
    }
    catch {
        throw "cannot resolve virtual service SID for $ServiceName; create the SCM service before applying runtime ACLs"
    }
}

function Get-DefenseClawDeterministicServiceSID {
    param([Parameter(Mandatory)][string]$ServiceName)
    Assert-DefenseClawServiceName -Name $ServiceName
    # `sc.exe showsid` computes the S-1-5-80 virtual-service SID from the
    # service name even when the SCM row is missing. This lets authenticated
    # active-deployment repair validate a service-owned secret before safely
    # recreating the service, and lets committed uninstall recovery retire the
    # exact SID grant after the service row is gone. Fresh installs never use
    # this path.
    $lines = @(Invoke-DefenseClawNative `
        -File $script:ScExe `
        -Arguments @('showsid', $ServiceName) `
        -Capture)
    $matches = [regex]::Matches(
        ($lines -join "`n"),
        '(?<![0-9-])S-1-5-80-(?:[0-9]{1,10}-){4}[0-9]{1,10}(?![0-9-])',
        [Text.RegularExpressions.RegexOptions]::CultureInvariant
    )
    $values = [Collections.Generic.HashSet[string]]::new(
        [StringComparer]::Ordinal
    )
    foreach ($match in $matches) {
        [void]$values.Add([string]$match.Value)
    }
    if ($values.Count -ne 1) {
        throw "sc.exe showsid did not return exactly one virtual-service SID for $ServiceName"
    }
    $value = @($values)[0]
    try {
        $sid = [Security.Principal.SecurityIdentifier]::new($value)
    }
    catch {
        throw "sc.exe showsid returned an invalid SID for $ServiceName"
    }
    if (-not $sid.Value.StartsWith('S-1-5-80-', [StringComparison]::Ordinal)) {
        throw "sc.exe showsid returned a SID outside the NT SERVICE authority for $ServiceName"
    }
    if (Test-DefenseClawServiceExists -Name $ServiceName) {
        $resolved = Get-DefenseClawServiceSID -ServiceName $ServiceName
        if ($resolved -cne $sid.Value) {
            throw "resolved and deterministic service SIDs disagree for $ServiceName"
        }
    }
    return $sid.Value
}

function Get-DefenseClawServiceSIDForRecovery {
    param([Parameter(Mandatory)][string]$ServiceName)
    if (Test-DefenseClawServiceExists -Name $ServiceName) {
        return Get-DefenseClawServiceSID -ServiceName $ServiceName
    }
    return Get-DefenseClawDeterministicServiceSID -ServiceName $ServiceName
}

function New-DefenseClawCanonicalPathAcl {
    param(
        [Parameter(Mandatory)][bool]$IsDirectory,
        [Parameter(Mandatory)]
        [ValidateSet('InstallDirectory', 'InstallFile', 'ServiceInstallDirectory', 'ServiceInstallFile', 'SecureClientMarkerDirectory', 'StateDirectory', 'AdminDirectory', 'AdminFile', 'ConfigDirectory', 'ConfigFile', 'BundleDirectory', 'BundleReceipt', 'BundleVersionDirectory', 'BundleVersionFile', 'MachinePolicyFile', 'RuntimeDirectory', 'RuntimeFile', 'RuntimeSecretFile', 'AuthorizationDirectory', 'AuthorizationFile', 'LogDirectory', 'GatewayLogDirectory', 'ManagedIPCDirectory')]
        [string]$Kind,
        [Parameter(Mandatory)][string]$GatewayServiceSID
    )

    $directoryKinds = @(
        'InstallDirectory',
        'ServiceInstallDirectory',
        'SecureClientMarkerDirectory',
        'StateDirectory',
        'AdminDirectory',
        'ConfigDirectory',
        'BundleDirectory',
        'BundleVersionDirectory',
        'RuntimeDirectory',
        'AuthorizationDirectory',
        'LogDirectory',
        'GatewayLogDirectory',
        'ManagedIPCDirectory'
    )
    if ($IsDirectory -ne ($Kind -in $directoryKinds)) {
        throw "ACL kind $Kind does not match the managed path object type"
    }

    if ($Kind -eq 'RuntimeSecretFile') {
        # The correlation key is a persistent service secret, not an ordinary
        # writable runtime file. OWNER RIGHTS suppresses the file owner's
        # implicit WRITE_DAC while preserving READ_CONTROL; the exact gateway
        # service SID receives read-only data access. Setup can replace this
        # descriptor only through the no-follow, privilege-scoped native path
        # in Set-DefenseClawPathAcl.
        $security = [Security.AccessControl.FileSecurity]::new()
        $security.SetSecurityDescriptorSddlForm(
            ((
                'O:{0}G:BAD:P(A;;RC;;;{1})(A;;FA;;;SY)' +
                '(A;;FA;;;BA)(A;;FR;;;{0})'
            ) -f $GatewayServiceSID, $script:OwnerRightsSID),
            [Security.AccessControl.AccessControlSections]::All
        )
        return $security
    }

    $security = if ($IsDirectory) {
        [Security.AccessControl.DirectorySecurity]::new()
    }
    else {
        [Security.AccessControl.FileSecurity]::new()
    }
    $administrators = [Security.Principal.SecurityIdentifier]::new(
        $script:AdministratorsSID
    )
    $security.SetOwner($administrators)
    if ($Kind -eq 'SecureClientMarkerDirectory') {
        $security.SetOwner([Security.Principal.SecurityIdentifier]::new($script:SystemSID))
    }
    $security.SetGroup($administrators)
    # Start from a new descriptor and discard inheritance. AddAccessRule below
    # therefore defines the whole DACL; unlike icacls /grant:r, this cannot
    # retain an explicit ACE for a retired service SID or another principal.
    $security.SetAccessRuleProtection($true, $false)

    $entries = [Collections.Generic.List[object]]::new()
    $entries.Add([pscustomobject]@{
        sid = $script:SystemSID
        rights = [Security.AccessControl.FileSystemRights]::FullControl
    })
    $entries.Add([pscustomobject]@{
        sid = $script:AdministratorsSID
        rights = [Security.AccessControl.FileSystemRights]::FullControl
    })
    switch ($Kind) {
        'InstallDirectory' {
            $entries.Add([pscustomobject]@{
                sid = $script:UsersSID
                rights = [Security.AccessControl.FileSystemRights]::ReadAndExecute
            })
        }
        'InstallFile' {
            $entries.Add([pscustomobject]@{
                sid = $script:UsersSID
                rights = [Security.AccessControl.FileSystemRights]::ReadAndExecute
            })
        }
        'ServiceInstallDirectory' {
            $entries.Add([pscustomobject]@{
                sid = $script:UsersSID
                rights = [Security.AccessControl.FileSystemRights]::ReadAndExecute
            })
            $entries.Add([pscustomobject]@{
                sid = $GatewayServiceSID
                rights = [Security.AccessControl.FileSystemRights]::ReadAndExecute
            })
        }
        'SecureClientMarkerDirectory' {
            $entries.Add([pscustomobject]@{
                sid = $script:UsersSID
                rights = [Security.AccessControl.FileSystemRights]::ReadAndExecute
            })
        }
        'ServiceInstallFile' {
            $entries.Add([pscustomobject]@{
                sid = $script:UsersSID
                rights = [Security.AccessControl.FileSystemRights]::ReadAndExecute
            })
            $entries.Add([pscustomobject]@{
                sid = $GatewayServiceSID
                rights = [Security.AccessControl.FileSystemRights]::ReadAndExecute
            })
        }
        'StateDirectory' {
            $entries.Add([pscustomobject]@{
                sid = $GatewayServiceSID
                rights = [Security.AccessControl.FileSystemRights]::ReadAndExecute
            })
        }
        'ConfigDirectory' {
            # Traverse only; the service cannot open ConfigFile without it.
            $entries.Add([pscustomobject]@{
                sid = $GatewayServiceSID
                rights = [Security.AccessControl.FileSystemRights]::ReadAndExecute
            })
        }
        'BundleDirectory' {
            $entries.Add([pscustomobject]@{
                sid = $GatewayServiceSID
                rights = [Security.AccessControl.FileSystemRights]::ReadAndExecute
            })
            $entries.Add([pscustomobject]@{
                sid = $script:UsersSID
                rights = [Security.AccessControl.FileSystemRights]::ReadAndExecute
            })
        }
        'BundleReceipt' {
            $entries.Add([pscustomobject]@{
                sid = $GatewayServiceSID
                rights = [Security.AccessControl.FileSystemRights]::Read
            })
            $entries.Add([pscustomobject]@{
                sid = $script:UsersSID
                rights = [Security.AccessControl.FileSystemRights]::Read
            })
        }
        'BundleVersionDirectory' {
            $entries.Add([pscustomobject]@{
                sid = $GatewayServiceSID
                rights = [Security.AccessControl.FileSystemRights]::ReadAndExecute
            })
        }
        'BundleVersionFile' {
            $entries.Add([pscustomobject]@{
                sid = $GatewayServiceSID
                rights = [Security.AccessControl.FileSystemRights]::ReadAndExecute
            })
        }
        'ConfigFile' {
            $entries.Add([pscustomobject]@{
                sid = $GatewayServiceSID
                rights = [Security.AccessControl.FileSystemRights]::Read
            })
        }
        'MachinePolicyFile' {
            $entries.Add([pscustomobject]@{
                sid = $script:UsersSID
                rights = [Security.AccessControl.FileSystemRights]::Read
            })
        }
        'RuntimeDirectory' {
            $entries.Add([pscustomobject]@{
                sid = $GatewayServiceSID
                rights = [Security.AccessControl.FileSystemRights]::Modify
            })
        }
        'RuntimeFile' {
            $entries.Add([pscustomobject]@{
                sid = $GatewayServiceSID
                rights = [Security.AccessControl.FileSystemRights]::Modify
            })
        }
        'AuthorizationDirectory' {
            $entries.Add([pscustomobject]@{
                sid = $GatewayServiceSID
                rights = [Security.AccessControl.FileSystemRights]::ReadAndExecute
            })
        }
        'AuthorizationFile' {
            $entries.Add([pscustomobject]@{
                sid = $GatewayServiceSID
                rights = [Security.AccessControl.FileSystemRights]::Read
            })
        }
        'GatewayLogDirectory' {
            $entries.Add([pscustomobject]@{
                sid = $GatewayServiceSID
                rights = [Security.AccessControl.FileSystemRights]::Modify
            })
        }
        'ManagedIPCDirectory' {
            # Match the gateway's bind-time IPC baseline: only the exact
            # service SID may create/remove the socket, while authenticated
            # clients receive path traversal, child-name lookup, and the
            # metadata/security read rights AVC uses to validate a recreated
            # endpoint after a gateway restart.
            $entries.Add([pscustomobject]@{
                sid = $GatewayServiceSID
                rights = [Security.AccessControl.FileSystemRights]::FullControl
            })
            $entries.Add([pscustomobject]@{
                sid = $script:AuthenticatedUsersSID
                rights = [Security.AccessControl.FileSystemRights]::ReadAndExecute
            })
        }
    }

    foreach ($entry in $entries) {
        # The Users read grant on bundles must not flow to private children.
        $usersTraverseOnly = $Kind -eq 'BundleDirectory' -and
            [string]$entry.sid -eq $script:UsersSID
        $versionServiceReadOnly = $Kind -eq 'BundleVersionDirectory' -and
            [string]$entry.sid -eq $GatewayServiceSID
        $inheritanceFlags = if ($IsDirectory -and $Kind -ne 'ManagedIPCDirectory' -and
            -not $usersTraverseOnly -and -not $versionServiceReadOnly) {
            [Security.AccessControl.InheritanceFlags]::ObjectInherit -bor
                [Security.AccessControl.InheritanceFlags]::ContainerInherit
        }
        else {
            [Security.AccessControl.InheritanceFlags]::None
        }
        $identity = [Security.Principal.SecurityIdentifier]::new(
            [string]$entry.sid
        )
        $rule = [Security.AccessControl.FileSystemAccessRule]::new(
            $identity,
            [Security.AccessControl.FileSystemRights]$entry.rights,
            $inheritanceFlags,
            [Security.AccessControl.PropagationFlags]::None,
            [Security.AccessControl.AccessControlType]::Allow
        )
        [void]$security.AddAccessRule($rule)
    }
    return $security
}

function Test-DefenseClawExactRawDACL {
    param(
        [Parameter(Mandatory)]
        [Security.AccessControl.RawSecurityDescriptor]$Actual,
        [Parameter(Mandatory)]
        [Security.AccessControl.RawSecurityDescriptor]$Expected,
        [int]$IgnoredControlFlags = [int](
            [Security.AccessControl.ControlFlags]::DiscretionaryAclAutoInherited
        )
    )

    # NTFS may persist a protected DACL with the benign AutoInherited (AI)
    # control flag even when Set-Acl received an otherwise identical D:P
    # descriptor. Mask only that metadata bit, then require every other
    # descriptor control flag and the raw DACL bytes to match exactly. RawAcl
    # equality preserves ACE order, revision, type, flags, mask, SID, and
    # duplicates; it cannot hide an unrecognized or inherited ACE.
    $actualFlags = (
        [int]$Actual.ControlFlags -band (-bnot $IgnoredControlFlags)
    )
    $expectedFlags = (
        [int]$Expected.ControlFlags -band (-bnot $IgnoredControlFlags)
    )
    if ($actualFlags -ne $expectedFlags) {
        return $false
    }

    $actualDACL = $Actual.DiscretionaryAcl
    $expectedDACL = $Expected.DiscretionaryAcl
    if ($null -eq $actualDACL -or $null -eq $expectedDACL) {
        return $false
    }
    if ($actualDACL.BinaryLength -ne $expectedDACL.BinaryLength) {
        return $false
    }
    $actualBytes = [byte[]]::new($actualDACL.BinaryLength)
    $expectedBytes = [byte[]]::new($expectedDACL.BinaryLength)
    $actualDACL.GetBinaryForm($actualBytes, 0)
    $expectedDACL.GetBinaryForm($expectedBytes, 0)
    for ($index = 0; $index -lt $actualBytes.Length; $index++) {
        if ($actualBytes[$index] -ne $expectedBytes[$index]) {
            return $false
        }
    }
    return $true
}

# Judges a raw descriptor that differs from the canonical one by effective
# write authority: a trusted owner (SYSTEM, Administrators, TrustedInstaller or
# the canonical owner) and no principal holding write-like rights the canonical
# DACL does not give it. Returns one finding per problem; Severity Untrusted is
# real write authority, Rights is a right DefenseClaw depends on that is gone.
# Inherit-only CREATOR OWNER/GROUP entries, extra read entries, OWNER RIGHTS
# under a trusted owner, inheritance and ordering are not findings.
function Get-DefenseClawRawDescriptorFindings {
    param(
        [Parameter(Mandatory)][string]$Path,
        [Parameter(Mandatory)]
        [Security.AccessControl.RawSecurityDescriptor]$Actual,
        [Parameter(Mandatory)]
        [Security.AccessControl.RawSecurityDescriptor]$Expected
    )
    $findings = [Collections.Generic.List[object]]::new()
    $trustedSIDs = @(
        $script:SystemSID,
        $script:AdministratorsSID,
        $script:TrustedInstallerSID
    )
    $expectedOwnerSID = if ($null -eq $Expected.Owner) { '' } else { $Expected.Owner.Value }
    $ownerSID = if ($null -eq $Actual.Owner) { '' } else { $Actual.Owner.Value }
    $ownerTrusted = $ownerSID -in $trustedSIDs -or
        (-not [string]::IsNullOrWhiteSpace($ownerSID) -and $ownerSID -ceq $expectedOwnerSID)
    if (-not $ownerTrusted) {
        $findings.Add([pscustomobject]@{
            Severity = 'Untrusted'
            Reason   = "untrusted owner $ownerSID on managed path: $Path"
        })
    }
    $allowedBySID = @{}
    if ($null -ne $Expected.DiscretionaryAcl) {
        foreach ($ace in $Expected.DiscretionaryAcl) {
            if ($ace -isnot [Security.AccessControl.CommonAce] -or
                $ace.AceQualifier -ne [Security.AccessControl.AceQualifier]::AccessAllowed) {
                continue
            }
            $sid = $ace.SecurityIdentifier.Value
            $mask = [int64](ConvertTo-DefenseClawMappedFileRights -Rights $ace.AccessMask) -band 0xffffffffL
            $allowedBySID[$sid] = if ($allowedBySID.ContainsKey($sid)) {
                [int64]$allowedBySID[$sid] -bor $mask
            }
            else {
                $mask
            }
        }
    }
    if ($null -eq $Actual.DiscretionaryAcl) {
        $findings.Add([pscustomobject]@{
            Severity = 'Untrusted'
            Reason   = "managed path has an absent or null DACL: $Path"
        })
        return $findings.ToArray()
    }
    $grantedBySID = @{}
    foreach ($ace in $Actual.DiscretionaryAcl) {
        if ($ace -isnot [Security.AccessControl.CommonAce] -or
            $ace.AceQualifier -ne [Security.AccessControl.AceQualifier]::AccessAllowed) {
            continue
        }
        $sid = $ace.SecurityIdentifier.Value
        $mask = [int64](ConvertTo-DefenseClawMappedFileRights -Rights $ace.AccessMask) -band 0xffffffffL
        $inheritOnly = ([int]$ace.AceFlags -band [int][Security.AccessControl.AceFlags]::InheritOnly) -ne 0
        if ($inheritOnly -and $sid -in @('S-1-3-0', 'S-1-3-1')) {
            continue
        }
        if (-not $inheritOnly) {
            $grantedBySID[$sid] = if ($grantedBySID.ContainsKey($sid)) {
                [int64]$grantedBySID[$sid] -bor $mask
            }
            else {
                $mask
            }
        }
        if ($sid -in $trustedSIDs -or
            ($sid -eq $script:OwnerRightsSID -and $ownerTrusted)) {
            continue
        }
        $allowed = if ($allowedBySID.ContainsKey($sid)) { [int64]$allowedBySID[$sid] } else { [int64]0 }
        $extra = $mask -band ((-bnot $allowed) -band 0xffffffffL)
        if ($extra -ne 0 -and
            (Test-DefenseClawWriteLikeRights -Rights ([Enum]::ToObject([Security.AccessControl.FileSystemRights], [int]$extra)))) {
            $findings.Add([pscustomobject]@{
                Severity = 'Untrusted'
                Reason   = "untrusted principal $sid has write-like access to managed path: $Path"
            })
        }
    }
    foreach ($sid in @($script:SystemSID, $script:AdministratorsSID)) {
        if (-not $allowedBySID.ContainsKey($sid)) {
            continue
        }
        $required = [int64]$allowedBySID[$sid]
        $granted = if ($grantedBySID.ContainsKey($sid)) { [int64]$grantedBySID[$sid] } else { [int64]0 }
        if (($granted -band $required) -ne $required) {
            $findings.Add([pscustomobject]@{
                Severity = 'Rights'
                Reason   = "managed path is missing required rights for ${sid}: $Path"
            })
        }
    }
    return $findings.ToArray()
}

function Assert-DefenseClawCanonicalRawPathAcl {
    param(
        [Parameter(Mandatory)][string]$Path,
        [Parameter(Mandatory)]
        [Security.AccessControl.RawSecurityDescriptor]$Actual,
        [Parameter(Mandatory)][Security.AccessControl.FileSystemSecurity]$Expected,
        # When set, a descriptor that is not exactly canonical is re-stamped
        # once through the privileged native writer before it is judged. Only
        # stamping callers (Set-DefenseClawPathAcl right after its write) opt
        # in. Validation never mutates: drift-detection callers judge the
        # descriptor they were given.
        [switch]$AllowSelfHeal
    )
    $expectedDescriptor = [Security.AccessControl.RawSecurityDescriptor]::new(
        $Expected.GetSecurityDescriptorBinaryForm(),
        0
    )
    if (Test-DefenseClawCanonicalRawPathAcl -Actual $Actual -Expected $Expected) {
        return
    }
    $protectedFlag = [int](
        [Security.AccessControl.ControlFlags]::DiscretionaryAclProtected
    )
    $strict = Test-DefenseClawTrustStrictAncestors
    if ($strict -or (Test-DefenseClawStandaloneProfile)) {
        # Strict mode (DEFENSECLAW_MANAGED_TRUST_STRICT_ANCESTORS=1) keeps the
        # exact-equality contract and refuses on any drift. The standalone
        # profile keeps it too: a validation-only caller sees the drift as it
        # is, and a DACL that is still not protected or not exact after a
        # stamping caller's one privileged re-stamp is refused (rel-1-0-3
        # main-sync review finding 3).
        if ($AllowSelfHeal -and -not $strict) {
            try {
                $nativeSecurity = Initialize-DefenseClawNativeSecurity
                [void]$nativeSecurity::SetPathSecurityDescriptorPrivilegedNoFollow(
                    $Path,
                    $expectedDescriptor.GetSddlForm(
                        [Security.AccessControl.AccessControlSections]::All
                    ),
                    [bool]($Expected -is [Security.AccessControl.DirectorySecurity])
                )
                $Actual = [Security.AccessControl.RawSecurityDescriptor]::new(
                    $nativeSecurity::GetFileSecurityDescriptor($Path),
                    0
                )
            }
            catch {
                Write-DefenseClawAclSelfHealAdvisory `
                    -Path $Path `
                    -Reason "privileged canonical re-stamp did not hold: $($_.Exception.Message)"
            }
        }
        if (([int]$Actual.ControlFlags -band $protectedFlag) -eq 0) {
            throw "managed DACL is not protected after exact ACL replacement: $Path"
        }
        $ownerSID = if ($null -eq $Actual.Owner) { '' } else { $Actual.Owner.Value }
        $groupSID = if ($null -eq $Actual.Group) { '' } else { $Actual.Group.Value }
        $expectedOwnerSID = if ($null -eq $expectedDescriptor.Owner) { '' } else { $expectedDescriptor.Owner.Value }
        $expectedGroupSID = if ($null -eq $expectedDescriptor.Group) { '' } else { $expectedDescriptor.Group.Value }
        if ($ownerSID -cne $expectedOwnerSID -or
            $groupSID -cne $expectedGroupSID) {
            throw (
                'managed path owner/group do not match the exact canonical ' +
                "descriptor after ACL replacement: $Path"
            )
        }
        if (-not (Test-DefenseClawExactRawDACL `
            -Actual $Actual `
            -Expected $expectedDescriptor)) {
            throw "managed path does not have the exact canonical DACL: $Path"
        }
        return
    }
    if ($AllowSelfHeal) {
        # Secure Client: a filter driver, Set-Acl dropping the protected flag,
        # or a writer racing us can leave the descriptor off by an entry.
        # Re-stamp it once through the privileged no-follow writer and read it
        # back natively.
        try {
            $nativeSecurity = Initialize-DefenseClawNativeSecurity
            $restamped = $nativeSecurity::SetPathSecurityDescriptorPrivilegedNoFollow(
                $Path,
                $expectedDescriptor.GetSddlForm(
                    [Security.AccessControl.AccessControlSections]::All
                ),
                [bool]($Expected -is [Security.AccessControl.DirectorySecurity])
            )
            $Actual = [Security.AccessControl.RawSecurityDescriptor]::new(
                $nativeSecurity::GetFileSecurityDescriptor($Path),
                0
            )
            if ($null -ne $restamped -and
                (Test-DefenseClawCanonicalRawPathAcl -Actual $Actual -Expected $Expected)) {
                return
            }
        }
        catch {
            Write-DefenseClawAclSelfHealAdvisory `
                -Path $Path `
                -Reason "privileged canonical re-stamp did not hold: $($_.Exception.Message)"
        }
    }
    # Not byte-exact. Decide on effective write authority, never on ACE order,
    # duplicates, group, inheritance or extra read entries.
    $findings = @(Get-DefenseClawRawDescriptorFindings `
        -Path $Path `
        -Actual $Actual `
        -Expected $expectedDescriptor)
    $untrusted = @($findings | Microsoft.PowerShell.Core\Where-Object { $_.Severity -eq 'Untrusted' })
    if ($untrusted.Count -gt 0 -and -not $AllowSelfHeal) {
        throw [string]$untrusted[0].Reason
    }
    $reason = if ($findings.Count -gt 0) {
        'descriptor is not canonical and could not be re-stamped: ' + [string]$findings[0].Reason
    }
    else {
        'descriptor is not byte-identical to the canonical form but grants no untrusted write'
    }
    Write-DefenseClawResilienceEvent -Marker defenseclaw_accept -Fields @{
        path   = $Path
        reason = $reason
    }
}

function Test-DefenseClawCanonicalRawPathAcl {
    param(
        [Parameter(Mandatory)]
        [Security.AccessControl.RawSecurityDescriptor]$Actual,
        [Parameter(Mandatory)][Security.AccessControl.FileSystemSecurity]$Expected
    )
    $expectedDescriptor = [Security.AccessControl.RawSecurityDescriptor]::new(
        $Expected.GetSecurityDescriptorBinaryForm(),
        0
    )
    $protectedFlag = [int](
        [Security.AccessControl.ControlFlags]::DiscretionaryAclProtected
    )
    if (([int]$Actual.ControlFlags -band $protectedFlag) -eq 0) {
        return $false
    }
    if ($null -eq $Actual.Owner -or
        $null -eq $Actual.Group -or
        $null -eq $expectedDescriptor.Owner -or
        $null -eq $expectedDescriptor.Group -or
        $Actual.Owner.Value -cne $expectedDescriptor.Owner.Value -or
        $Actual.Group.Value -cne $expectedDescriptor.Group.Value) {
        return $false
    }
    return [bool](Test-DefenseClawExactRawDACL `
        -Actual $Actual `
        -Expected $expectedDescriptor)
}

function Test-DefenseClawPathGoneError {
    <#
        True only when the error, or an exception it wraps, is the Win32
        "file not found" or "path not found" error.
    #>
    param([Parameter(Mandatory)][Management.Automation.ErrorRecord]$ErrorRecord)
    for ($exception = $ErrorRecord.Exception; $null -ne $exception; $exception = $exception.InnerException) {
        if ($exception -is [ComponentModel.Win32Exception] -and
            [int]$exception.NativeErrorCode -in @(2, 3)) {
            return $true
        }
    }
    return $false
}

function Assert-DefenseClawCanonicalPathAcl {
    param(
        [Parameter(Mandatory)][string]$Path,
        [Parameter(Mandatory)][Security.AccessControl.FileSystemSecurity]$Expected,
        # Forwarded to Assert-DefenseClawCanonicalRawPathAcl. Only
        # Set-DefenseClawPathAcl's post-stamp verify opts in; validation-
        # only callers (install-like lifecycle manifest drift gate, etc.)
        # must leave it off so the drift is observed exactly.
        [switch]$AllowSelfHeal
    )
    Assert-DefenseClawNoReparsePath -Path $Path
    $nativeSecurity = Initialize-DefenseClawNativeSecurity
    try {
        $descriptorBytes = $nativeSecurity::GetFileSecurityDescriptor($Path)
    }
    catch {
        # A path a parallel uninstall step already deleted has no
        # descriptor left to judge, so outside the strict pin that one
        # case warns and returns. On standalone every other failure
        # refuses: a descriptor DefenseClaw cannot read - above all one
        # that denies READ_CONTROL, which a standard user who owns the
        # path can set - is drift it cannot see past, and treating it as
        # "no drift observed" would wave the path through. Secure Client
        # keeps its earlier bulldoze for every read failure (Secure Client
        # is out of scope for this fix).
        $readError = $_
        if (-not (Test-DefenseClawStandaloneProfile)) {
            if (Test-DefenseClawTrustStrictAncestors) {
                throw
            }
            Write-DefenseClawAclSelfHealAdvisory `
                -Path $Path `
                -Reason (
                    "native security descriptor read failed, continuing " +
                    "bulldoze (likely file deleted mid-uninstall or DACL " +
                    "denies admin read_control): " + $readError.Exception.Message
                )
            return
        }
        if ((Test-DefenseClawTrustStrictAncestors) -or
            -not (Test-DefenseClawPathGoneError -ErrorRecord $readError)) {
            throw
        }
        Write-DefenseClawAclSelfHealAdvisory `
            -Path $Path `
            -Reason (
                "native security descriptor read failed because the " +
                "path is gone, continuing: " + $readError.Exception.Message
            )
        return
    }
    $actualDescriptor = [Security.AccessControl.RawSecurityDescriptor]::new(
        $descriptorBytes,
        0
    )
    Assert-DefenseClawCanonicalRawPathAcl `
        -Path $Path `
        -Actual $actualDescriptor `
        -Expected $Expected `
        -AllowSelfHeal:$AllowSelfHeal
}

function Set-DefenseClawPathAcl {
    param(
        [Parameter(Mandatory)][string]$Path,
        [Parameter(Mandatory)]
        [ValidateSet('InstallDirectory', 'InstallFile', 'ServiceInstallDirectory', 'ServiceInstallFile', 'SecureClientMarkerDirectory', 'StateDirectory', 'AdminDirectory', 'AdminFile', 'ConfigDirectory', 'ConfigFile', 'BundleDirectory', 'BundleReceipt', 'BundleVersionDirectory', 'BundleVersionFile', 'MachinePolicyFile', 'RuntimeDirectory', 'RuntimeFile', 'RuntimeSecretFile', 'AuthorizationDirectory', 'AuthorizationFile', 'LogDirectory', 'GatewayLogDirectory', 'ManagedIPCDirectory')]
        [string]$Kind,
        [Parameter(Mandatory)][string]$GatewayServiceSID
    )
    Assert-DefenseClawNoReparsePath -Path $Path
    $isDirectory = [bool](
        Microsoft.PowerShell.Management\Get-Item `
            -LiteralPath $Path `
            -Force `
            -ErrorAction Stop
    ).PSIsContainer
    $security = New-DefenseClawCanonicalPathAcl `
        -IsDirectory $isDirectory `
        -Kind $Kind `
        -GatewayServiceSID $GatewayServiceSID
    $sddl = $security.GetSecurityDescriptorSddlForm(
        [Security.AccessControl.AccessControlSections]::All
    )
    if ($Kind -in @('RuntimeSecretFile', 'AdminFile') -and -not $isDirectory) {
        # Secret and admin files go through SetSecurityInfo on an
        # identity-pinned no-follow handle, binding owner, group and a
        # PROTECTED DACL in one call (Set-Acl derives the protected flag rather
        # than requesting it). The secret additionally keeps its fixed length.
        # When that handle cannot be opened because the drifted DACL removed
        # WRITE_DAC or the owner is another principal, the privileged writer
        # re-stamps the same descriptor under backup and restore privileges.
        $expectedSize = if ($Kind -eq 'RuntimeSecretFile') { [uint32]32 } else { [uint32]0 }
        $nativeSecurity = Initialize-DefenseClawNativeSecurity
        $before = $nativeSecurity::GetRegularFileSecuritySnapshotNoFollow(
            $Path,
            $expectedSize
        )
        try {
            $after = $nativeSecurity::SetRegularFileSecurityDescriptorNoFollow(
                $Path,
                $sddl,
                $expectedSize,
                [string]$before.Identity
            )
        }
        catch {
            $after = $nativeSecurity::SetPathSecurityDescriptorPrivilegedNoFollow(
                $Path,
                $sddl,
                $false
            )
        }
        if ([string]$after.Identity -cne [string]$before.Identity) {
            throw "managed $Kind identity changed during ACL replacement: $Path"
        }
        Assert-DefenseClawCanonicalRawPathAcl `
            -Path $Path `
            -Actual ([Security.AccessControl.RawSecurityDescriptor]::new(
                [byte[]]$after.SecurityDescriptor,
                0
            )) `
            -Expected $security `
            -AllowSelfHeal
        return
    }
    try {
        Microsoft.PowerShell.Security\Set-Acl `
            -LiteralPath $Path `
            -AclObject $security `
            -ErrorAction Stop
    }
    catch {
        # Path-based Set-Acl has no backup intent and enables no privilege, so
        # another administrator's owner, a TrustedInstaller owner it cannot
        # round-trip, or a DACL without WRITE_DAC for Administrators defeats
        # it. The privileged no-follow writer repairs exactly those.
        $nativeSecurity = Initialize-DefenseClawNativeSecurity
        [void]$nativeSecurity::SetPathSecurityDescriptorPrivilegedNoFollow(
            $Path,
            $sddl,
            $isDirectory
        )
    }
    if ($isDirectory) {
        # SetSecurityInfo with PROTECTED_DACL_SECURITY_INFORMATION makes the
        # inheritance boundary explicit when repairing a Go-created folder.
        # When the handle cannot get WRITE_DAC (another administrator's owner
        # or a drifted DACL), the privileged no-follow writer stamps the same
        # protected descriptor instead of failing the repair.
        $nativeSecurity = Initialize-DefenseClawNativeSecurity
        try {
            $before = $nativeSecurity::GetDirectorySecuritySnapshotNoFollow($Path)
            [void]$nativeSecurity::SetDirectoryDaclNoFollow(
                $Path,
                $security.GetSecurityDescriptorBinaryForm(),
                [string]$before.Identity
            )
        }
        catch {
            [void]$nativeSecurity::SetPathSecurityDescriptorPrivilegedNoFollow(
                $Path,
                $sddl,
                $true
            )
        }
    }
    # The verifier re-stamps once more through the privileged writer when the
    # descriptor is not byte-exact (Set-Acl can drop the protected flag), then
    # judges it: exactly on the standalone profile and under the strict pin,
    # by effective write authority on Secure Client.
    Assert-DefenseClawCanonicalPathAcl `
        -Path $Path `
        -Expected $security `
        -AllowSelfHeal
}

# AIFW-34262: Set-DefenseClawPathAcl stamps the canonical descriptor and then
# demands exact equality with it. For a path inside the shared Cisco Secure
# Client tree, AVC can re-apply its own ACLs in the window between those two
# steps, and losing that race is not an install failure. Retry the stamp; if AVC
# keeps winning, hand the verdict to the post-hardening Assert-DefenseClawPathAcl
# for that path, which re-stamps once more and then judges the rights that
# actually matter. Structural problems are not swallowed by that hand-off: the
# assertion runs the same Assert-DefenseClawNoReparsePath as this does.
#
# Under the strict pin the first lost race is fatal, as before.
function Set-DefenseClawSharedPathAcl {
    param(
        [Parameter(Mandatory)][string]$Path,
        [Parameter(Mandatory)]
        [ValidateSet('InstallDirectory', 'InstallFile', 'ServiceInstallDirectory', 'ServiceInstallFile', 'StateDirectory', 'AdminDirectory', 'AdminFile', 'ConfigDirectory', 'ConfigFile', 'MachinePolicyFile', 'RuntimeDirectory', 'RuntimeFile', 'RuntimeSecretFile', 'AuthorizationDirectory', 'AuthorizationFile', 'LogDirectory', 'GatewayLogDirectory', 'ManagedIPCDirectory')]
        [string]$Kind,
        [Parameter(Mandatory)][string]$GatewayServiceSID,
        [ValidateRange(1, 10)][int]$Attempts = 3
    )
    for ($attempt = 1; $attempt -le $Attempts; $attempt++) {
        try {
            Set-DefenseClawPathAcl `
                -Path $Path `
                -Kind $Kind `
                -GatewayServiceSID $GatewayServiceSID
            return
        }
        catch {
            if (Test-DefenseClawTrustStrictAncestors) {
                throw
            }
            Write-DefenseClawAclSelfHealAdvisory `
                -Path $Path `
                -Reason (
                    'canonical {0} ACL stamp attempt {1} of {2} did not hold: {3}' -f
                    $Kind, $attempt, $Attempts, $_.Exception.Message
                )
            if ($attempt -lt $Attempts) {
                # Retrying with no pause just loses the same race again: give the
                # writer we are contending with time to finish its pass.
                Microsoft.PowerShell.Utility\Start-Sleep -Milliseconds (250 * $attempt)
            }
        }
    }
}

function Set-DefenseClawBootstrapRootAcl {
    param(
        [Parameter(Mandatory)][string]$Path,
        [switch]$AllowUsersRead
    )
    Assert-DefenseClawNoReparsePath -Path $Path
    $kind = if ($AllowUsersRead) {
        'InstallDirectory'
    }
    else {
        'AdminDirectory'
    }
    Set-DefenseClawPathAcl `
        -Path $Path `
        -Kind $kind `
        -GatewayServiceSID $script:AdministratorsSID
}

function New-DefenseClawProtectedDirectory {
    param(
        [Parameter(Mandatory)][string]$Path,
        [switch]$AllowUsersRead,
        # Read for BUILTIN\Users on the directory itself, not inherited by
        # anything created beneath it.
        [switch]$UsersReadThisFolder,
        [string]$StagingMarkerSID
    )
    $parent = [IO.Path]::GetDirectoryName($Path)
    if (-not (Microsoft.PowerShell.Management\Test-Path -LiteralPath $parent -PathType Container)) {
        throw "protected directory parent must already exist: $parent"
    }
    Assert-DefenseClawTrustedAncestor -Path $parent

    $nativeSecurityType = Initialize-DefenseClawNativeSecurity
    $sddl = 'O:BAG:BAD:P'
    if (-not [string]::IsNullOrWhiteSpace($StagingMarkerSID)) {
        $marker = [Security.Principal.SecurityIdentifier]::new(
            $StagingMarkerSID
        )
        if ($marker.Value -cne $StagingMarkerSID) {
            throw 'managed-root staging marker SID is not canonical'
        }
        $sddl += "(D;;FA;;;$StagingMarkerSID)"
    }
    $sddl += '(A;OICI;FA;;;SY)(A;OICI;FA;;;BA)'
    if ($AllowUsersRead -and
        [string]::IsNullOrWhiteSpace($StagingMarkerSID)) {
        $sddl += '(A;OICI;0x1200a9;;;BU)'
    }
    elseif ($UsersReadThisFolder) {
        $sddl += '(A;;0x1200a9;;;BU)'
    }
    # CreateDirectoryW receives the protected descriptor in SECURITY_ATTRIBUTES,
    # so the object is never visible with an inherited permissive DACL. If
    # another principal wins the absent->create race, ERROR_ALREADY_EXISTS is
    # returned and the immediate strict validation rejects that object before
    # ownership or ACLs are changed.
    $created = $nativeSecurityType::CreateDirectorySecure($Path, $sddl)
    Assert-DefenseClawNoReparsePath -Path $Path
    Assert-DefenseClawPathAcl `
        -Path $Path `
        -AllowedWriterSIDs @($script:SystemSID, $script:AdministratorsSID, $script:TrustedInstallerSID) `
        -AllowUsersRead:($AllowUsersRead -and
            [string]::IsNullOrWhiteSpace($StagingMarkerSID))
    return [bool]$created
}

# The standalone ProgramData vendor directory (C:\ProgramData\Cisco) holds the
# hook runtime directory, and every standard user's hook reads the machine
# policy summary there only after checking the owner and DACL of each
# ancestor. On a device without other Cisco software standalone Setup creates
# the vendor directory, so it creates it with read for BUILTIN\Users on that
# directory alone; without it every hook fails closed with
# enterprise_machine_policy_summary_untrusted. Write stays with SYSTEM and
# Administrators. A vendor directory that already exists (Secure Client or
# other Cisco software) is only validated, never changed, and the Secure
# Client profile never takes this path.
function Test-DefenseClawStandaloneVendorDirectory {
    param([Parameter(Mandatory)][string]$Path)
    if (-not (Test-DefenseClawStandaloneProfile)) {
        return $false
    }
    $vendor = [IO.Path]::GetDirectoryName(
        [string](Get-DefenseClawProfileRoots -EnterpriseProfile Standalone).StateRoot
    )
    return [string]::Equals(
        [IO.Path]::GetFullPath($Path).TrimEnd('\'),
        [IO.Path]::GetFullPath($vendor).TrimEnd('\'),
        [StringComparison]::OrdinalIgnoreCase
    )
}

# Directories strictly between the required base and a managed root. The base
# is an OS directory and the root carries its own canonical DACL, so neither is
# returned.
function Get-DefenseClawManagedRootAncestors {
    param(
        [Parameter(Mandatory)][string]$Root,
        [Parameter(Mandatory)][string]$RequiredBase
    )
    $base = [IO.Path]::GetFullPath($RequiredBase).TrimEnd('\')
    $full = [IO.Path]::GetFullPath($Root).TrimEnd('\')
    if (-not $full.StartsWith($base + '\', [StringComparison]::OrdinalIgnoreCase)) {
        throw "managed root is outside its required ancestor base: $full"
    }
    $relative = $full.Substring($base.Length).TrimStart('\')
    $components = @($relative.Split('\') |
        Microsoft.PowerShell.Core\Where-Object { -not [string]::IsNullOrWhiteSpace($_) })
    $ancestors = [Collections.Generic.List[string]]::new()
    $current = $base
    for ($index = 0; $index -lt $components.Count - 1; $index++) {
        $current = Microsoft.PowerShell.Management\Join-Path $current $components[$index]
        [void]$ancestors.Add($current)
    }
    return @($ancestors)
}

# Execute to traverse the ancestor, read-control to read the descriptor the
# gateway's own ancestor trust check inspects.
$script:StateAncestorTraverseRights =
    [Security.AccessControl.FileSystemRights]::ReadAndExecute

# Clone and edit only the named explicit ACE. All other ACE bytes, including
# the administrator's BUILTIN Users entries, retain their original masks.
function Update-DefenseClawSharedRawDescriptor {
    param(
        [Parameter(Mandatory)][Security.AccessControl.RawSecurityDescriptor]$Descriptor,
        [Parameter(Mandatory)][string]$SID,
        [Parameter(Mandatory)][ValidateSet('Add', 'Replace', 'Remove', 'RemoveExact')][string]$Action,
        [int]$AccessMask = 0
    )
    $identity = [Security.Principal.SecurityIdentifier]::new($SID)
    if ($null -eq $Descriptor.DiscretionaryAcl) {
        throw 'shared directory has no DACL'
    }
    $bytes = [byte[]]::new($Descriptor.BinaryLength)
    $Descriptor.GetBinaryForm($bytes, 0)
    $updated = [Security.AccessControl.RawSecurityDescriptor]::new($bytes, 0)
    $matches = [Collections.Generic.List[int]]::new()
    for ($index = 0; $index -lt $updated.DiscretionaryAcl.Count; $index++) {
        $ace = $updated.DiscretionaryAcl[$index]
        if ($ace -isnot [Security.AccessControl.KnownAce] -or
            $null -eq $ace.SecurityIdentifier -or
            $ace.SecurityIdentifier.Value -cne $identity.Value -or
            ([int]$ace.AceFlags -band
                [int][Security.AccessControl.AceFlags]::Inherited) -ne 0) {
            continue
        }
        if ($Action -eq 'RemoveExact' -and
            ($ace -isnot [Security.AccessControl.CommonAce] -or
                $ace.AceQualifier -ne [Security.AccessControl.AceQualifier]::AccessAllowed -or
                $ace.AceFlags -ne [Security.AccessControl.AceFlags]::None -or
                [int]$ace.AccessMask -ne $AccessMask -or $ace.IsCallback -or $ace.OpaqueLength -ne 0)) {
            continue
        }
        $matches.Add($index)
    }
    if ($Action -eq 'RemoveExact' -and $matches.Count -gt 1) {
        throw 'the recorded shared directory ACE cannot be identified exactly'
    }
    if ($Action -eq 'Replace' -and $matches.Count -eq 1) {
        $existing = $updated.DiscretionaryAcl[$matches[0]]
        if ($existing -is [Security.AccessControl.CommonAce] -and
            $existing.AceQualifier -eq [Security.AccessControl.AceQualifier]::AccessAllowed -and
            $existing.AceFlags -eq [Security.AccessControl.AceFlags]::None -and
            [int]$existing.AccessMask -eq $AccessMask -and
            -not $existing.IsCallback -and $existing.OpaqueLength -eq 0) {
            return [pscustomobject]@{ Descriptor = $updated; Changed = $false }
        }
    }
    if ($Action -ne 'Add') {
        for ($index = $matches.Count - 1; $index -ge 0; $index--) {
            $updated.DiscretionaryAcl.RemoveAce($matches[$index])
        }
    }
    if ($Action -in @('Add', 'Replace')) {
        $ace = [Security.AccessControl.CommonAce]::new(
            [Security.AccessControl.AceFlags]::None,
            [Security.AccessControl.AceQualifier]::AccessAllowed,
            $AccessMask, $identity, $false, $null
        )
        $insert = $updated.DiscretionaryAcl.Count
        for ($index = 0; $index -lt $updated.DiscretionaryAcl.Count; $index++) {
            if (([int]$updated.DiscretionaryAcl[$index].AceFlags -band
                    [int][Security.AccessControl.AceFlags]::Inherited) -ne 0) {
                $insert = $index
                break
            }
        }
        $updated.DiscretionaryAcl.InsertAce($insert, $ace)
    }
    elseif ($matches.Count -eq 0) {
        return [pscustomobject]@{ Descriptor = $updated; Changed = $false }
    }
    return [pscustomobject]@{ Descriptor = $updated; Changed = $true }
}

# Shared vendor ancestors belong to other products too. FileSystemSecurity's
# AddAccessRule/Set-Acl projection can widen an unrelated BUILTIN Users mask.
# Edit through the pinned directory handle and compare every ACE on readback.
function Set-DefenseClawSharedDirectoryRawAce {
    param(
        [Parameter(Mandatory)][string]$Path,
        [Parameter(Mandatory)][string]$SID,
        [Parameter(Mandatory)][ValidateSet('Add', 'Replace', 'Remove', 'RemoveExact')][string]$Action,
        [int]$AccessMask = 0
    )
    $native = Initialize-DefenseClawNativeSecurity
    $before = $native::GetDirectorySecuritySnapshotNoFollow($Path)
    $actual = [Security.AccessControl.RawSecurityDescriptor]::new(
        [byte[]]$before.SecurityDescriptor, 0
    )
    $edit = Update-DefenseClawSharedRawDescriptor `
        -Descriptor $actual -SID $SID -Action $Action -AccessMask $AccessMask
    if (-not $edit.Changed) { return $false }
    $updated = [Security.AccessControl.RawSecurityDescriptor]$edit.Descriptor
    $expected = [byte[]]::new($updated.BinaryLength)
    $updated.GetBinaryForm($expected, 0)
    $after = $native::SetSharedDirectoryDaclNoFollow(
        $Path, $expected, [string]$before.Identity
    )
    $published = [Security.AccessControl.RawSecurityDescriptor]::new(
        [byte[]]$after.SecurityDescriptor, 0
    )
    $protectedFlag = [Security.AccessControl.ControlFlags]::DiscretionaryAclProtected
    if ([string]$after.Identity -cne [string]$before.Identity -or
        $published.Owner.Value -cne $actual.Owner.Value -or
        $published.Group.Value -cne $actual.Group.Value -or
        ($published.ControlFlags -band $protectedFlag) -ne ($actual.ControlFlags -band $protectedFlag) -or
        -not (Test-DefenseClawExactRawDACL -Actual $published -Expected $updated)) {
        throw "shared directory changed outside the requested ACE: $Path"
    }
    return $true
}

function Grant-DefenseClawStateAncestorTraverse {
    param(
        [Parameter(Mandatory)][string]$Path,
        [Parameter(Mandatory)][string]$GatewayServiceSID,
        # The StateRoot of the deployment scope the grant is for.
        [Parameter(Mandatory)][string]$Scope
    )
    Assert-DefenseClawNoReparsePath -Path $Path
    Assert-DefenseClawTrustedAncestor -Path $Path
    try {
        [void](Set-DefenseClawSharedDirectoryRawAce `
            -Path $Path -SID $GatewayServiceSID -Action Replace `
            -AccessMask ([int]$script:StateAncestorTraverseRights -bor 0x100000))
        Assert-DefenseClawStateAncestorTraverse `
            -Path $Path `
            -GatewayServiceSID $GatewayServiceSID
    }
    catch {
        # The gateway logs on as LocalSystem, which traverses these vendor
        # ancestors without the grant; it only matters to the legacy virtual
        # account. A platform installer re-ACLing the ancestor, or an owner
        # the raw write cannot get past, is recorded and accepted.
        if (Test-DefenseClawTrustStrictAncestors) {
            throw
        }
        Write-DefenseClawResilienceEvent -Marker defenseclaw_accept -Fields @{
            path   = $Path
            reason = "gateway traverse grant on a shared ancestor did not hold: $($_.Exception.Message)"
        }
    }
    # The standalone vendor directory also needs the standard users' check
    # entry (GAP-0578); never on the Secure Client profile.
    if (Test-DefenseClawStandaloneVendorDirectory -Path $Path) {
        Grant-DefenseClawStandaloneVendorUsersRead -Path $Path -Scope $Scope
    }
}

function Assert-DefenseClawStateAncestorTraverse {
    param(
        [Parameter(Mandatory)][string]$Path,
        [Parameter(Mandatory)][string]$GatewayServiceSID
    )
    # No untrusted principal may own the ancestor or hold rights that would let
    # it replace what sits underneath.
    Assert-DefenseClawTrustedAncestor -Path $Path
    $required = $script:StateAncestorTraverseRights
    $granted = [Security.AccessControl.FileSystemRights]0
    $acl = Microsoft.PowerShell.Security\Get-Acl -LiteralPath $Path
    foreach ($rule in $acl.Access) {
        if ($rule.AccessControlType -ne [Security.AccessControl.AccessControlType]::Allow -or
            (($rule.PropagationFlags -band [Security.AccessControl.PropagationFlags]::InheritOnly) -ne 0)) {
            continue
        }
        if ((ConvertTo-DefenseClawSID -Identity $rule.IdentityReference) -ne $GatewayServiceSID) {
            continue
        }
        if ($rule.InheritanceFlags -ne [Security.AccessControl.InheritanceFlags]::None) {
            throw (
                'gateway traverse grant on a shared managed ancestor must not ' +
                "be inheritable: $Path"
            )
        }
        $granted = $granted -bor $rule.FileSystemRights
    }
    if (($granted -band $required) -ne $required) {
        throw (
            "gateway service $GatewayServiceSID cannot traverse an ancestor of " +
            "its own state root: $Path"
        )
    }
}

# Drops the grant added by Grant-DefenseClawStateAncestorTraverse. Valid only
# after both services are deleted, when the SID is stale.
function Revoke-DefenseClawStateAncestorTraverse {
    param(
        [Parameter(Mandatory)][string]$Path,
        [Parameter(Mandatory)][string]$GatewayServiceSID
    )
    if (-not (Microsoft.PowerShell.Management\Test-Path `
            -LiteralPath $Path `
            -PathType Container)) {
        return
    }
    Assert-DefenseClawNoReparsePath -Path $Path
    Assert-DefenseClawTrustedAncestor -Path $Path
    try {
        [void](Set-DefenseClawSharedDirectoryRawAce `
            -Path $Path -SID $GatewayServiceSID -Action Remove)
    }
    catch {
        # A stale traverse entry for a deleted service SID grants nothing.
        if (Test-DefenseClawTrustStrictAncestors) {
            throw
        }
        Write-DefenseClawResilienceEvent -Marker defenseclaw_accept -Fields @{
            path   = $Path
            reason = "stale gateway traverse entry left on a shared ancestor: $($_.Exception.Message)"
        }
    }
}

# What a standard user's hook needs on the standalone vendor directory to
# check it as an ancestor of the machine policy summary: read-permissions,
# read-attributes and traverse (and synchronize), on that directory alone.
# It cannot list the directory or read anything below it (GAP-0578).
$script:VendorDirectoryUsersRights = [Security.AccessControl.FileSystemRights](0x1200a0)

# Which of those rights Setup added to the vendor directory's Users entry,
# recorded in the protected lifecycle directory. An uninstall gives back
# only those, so an entry an administrator had set (with any rights) stays
# as it was (GAP-0867, review loop round 2). The production deployment and
# every certification scope share the directory and this record, so it also
# names each scope (its StateRoot) that relies on those rights; they are
# given back only when no scope does (review loop round 3).
$script:VendorUsersReadGrantLeaf = 'vendor-users-read-grant.json'

# The SID of this computer's own account domain (its SAM), read once, or ''
# when it cannot be read.
function Get-DefenseClawAccountDomainSID {
    if ($null -eq $script:DefenseClawAccountDomainSID) {
        $value = ''
        try {
            $native = Initialize-DefenseClawNativeSecurity
            $bytes = $native::AccountDomainSid()
            if ($null -ne $bytes) {
                $value = [Security.Principal.SecurityIdentifier]::new([byte[]]$bytes, 0).Value
            }
        }
        catch {
            $value = ''
        }
        $script:DefenseClawAccountDomainSID = $value
    }
    return [string]$script:DefenseClawAccountDomainSID
}

# Whether SID is an account SID of this computer's own account domain.
function Test-DefenseClawAccountDomainSID {
    param([Parameter(Mandatory)][string]$SID)
    $domain = Get-DefenseClawAccountDomainSID
    return (
        -not [string]::IsNullOrEmpty($domain) -and
        $SID.StartsWith($domain + '-', [StringComparison]::OrdinalIgnoreCase) -and
        $SID.Substring($domain.Length + 1) -cmatch '^\d+$'
    )
}

# Whether a deny entry for SID can take access away from an enrolled user's
# token. LocalSystem, the service accounts, per-service SIDs, anonymous logon
# and app-container or capability SIDs never can. A built-in or well-known
# group can, and so can a domain's well-known group (Domain Users) and any
# group or alias the lookup finds. An account SID (local, domain or Entra ID)
# applies when it is an enrolled user (EnrolledSIDs: the account profiles on
# this computer); a user that is not, a deleted account or a computer does
# not, and neither does a SID of this computer's own accounts that no account
# has (a retired local account), so a stale local deny no longer stops
# install and repair (GAP-1142 review). Only this computer's own SAM answers
# "no account has it" alone. For a domain or Entra ID SID that answer can
# come from a domain controller that did not respond in time, or miss a
# real group an enrolled user's token holds, so that deny counts, as does a
# lookup that fails (GAP-1142 review, loop round 1).
function Test-DefenseClawUserTokenDenySID {
    param(
        [Parameter(Mandatory)][string]$SID,
        [string[]]$EnrolledSIDs = @()
    )
    if ($SID -in @('S-1-5-7', 'S-1-5-18', 'S-1-5-19', 'S-1-5-20') -or
        $SID.StartsWith('S-1-5-80-') -or $SID.StartsWith('S-1-15-')) {
        return $false
    }
    if ($EnrolledSIDs -contains $SID) {
        return $true
    }
    $domainAccount = $SID -cmatch '^S-1-5-21-\d+-\d+-\d+-(\d+)$'
    if ($domainAccount) {
        $rid = [int64]$Matches[1]
        if ($rid -ge 512 -and $rid -lt 1000) {
            return $true
        }
    }
    elseif (-not $SID.StartsWith('S-1-12-1-')) {
        return $true
    }
    $identifier = [Security.Principal.SecurityIdentifier]::new($SID)
    $bytes = [byte[]]::new($identifier.BinaryLength)
    $identifier.GetBinaryForm($bytes, 0)
    $native = Initialize-DefenseClawNativeSecurity
    $use = $native::LookupSidUse($bytes)
    if ($use -eq 0) {
        return -not ($domainAccount -and (Test-DefenseClawAccountDomainSID -SID $SID))
    }
    return ($use -lt 0 -or $use -in @(2, 4, 5))
}

# Whether every standard user can check the vendor directory, with any
# logon: an allow entry for Users, Authenticated Users or Everyone grants
# the rights, and no deny entry that applies to an enrolled user's token
# takes any away. INTERACTIVE is not in the token of a scheduled task or an
# SSH logon, so an allow for it alone does not count (GAP-1439); a deny for
# an enrolled user or for a group, a domain group included, does (GAP-1142),
# and so does one for a domain SID the lookup cannot map; a deny for an
# account that is not enrolled, or for a local account that no longer
# exists, does not.
function Test-DefenseClawStandaloneVendorUsersRead {
    param([Parameter(Mandatory)][string]$Path)
    $required = [int64]$script:VendorDirectoryUsersRights
    $everyUser = @($script:UsersSID, $script:AuthenticatedUsersSID, 'S-1-1-0')
    $granted = [int64]0
    $enrolled = $null
    $rules = (Microsoft.PowerShell.Security\Get-Acl -LiteralPath $Path).GetAccessRules(
        $true, $true, [Security.Principal.SecurityIdentifier])
    foreach ($rule in $rules) {
        if (($rule.PropagationFlags -band [Security.AccessControl.PropagationFlags]::InheritOnly) -ne 0) {
            continue
        }
        $sid = [string]$rule.IdentityReference.Value
        $rights = [int64]$rule.FileSystemRights -band 0xffffffffL
        if (($rights -band 0xb0000000L) -ne 0) {
            # GENERIC_ALL, GENERIC_READ or GENERIC_EXECUTE cover all three.
            $rights = $rights -bor $required
        }
        if ($rule.AccessControlType -eq [Security.AccessControl.AccessControlType]::Deny) {
            if (($rights -band $required) -eq 0) {
                continue
            }
            if ($null -eq $enrolled) {
                $enrolled = [string[]]@(Get-DefenseClawManagedUserRuntimeHomes | Microsoft.PowerShell.Core\ForEach-Object { [string]$_.sid })
            }
            if (Test-DefenseClawUserTokenDenySID -SID $sid -EnrolledSIDs $enrolled) {
                return $false
            }
            continue
        }
        if ($everyUser -notcontains $sid) {
            continue
        }
        $granted = $granted -bor $rights
    }
    return (($granted -band $required) -eq $required)
}

# The explicit Users allow entries on the vendor directory alone. Setup reads
# these masks to add only missing rights in a separate raw ACE.
function Get-DefenseClawVendorUsersThisFolderRules {
    param([Parameter(Mandatory)][Security.AccessControl.DirectorySecurity]$Security)
    return @($Security.GetAccessRules($true, $false, [Security.Principal.SecurityIdentifier]) |
            Microsoft.PowerShell.Core\Where-Object {
                [string]$_.IdentityReference.Value -ceq $script:UsersSID -and
                $_.AccessControlType -eq [Security.AccessControl.AccessControlType]::Allow -and
                $_.InheritanceFlags -eq [Security.AccessControl.InheritanceFlags]::None -and
                $_.PropagationFlags -eq [Security.AccessControl.PropagationFlags]::None
            })
}

function Get-DefenseClawVendorUsersReadGrantPath {
    return [IO.Path]::Combine(
        [string](Get-DefenseClawProfileRoots -EnterpriseProfile Standalone).LifecycleDirectory,
        $script:VendorUsersReadGrantLeaf
    )
}

# A deployment scope as the grant record names it: its full StateRoot.
function ConvertTo-DefenseClawVendorGrantScope {
    param([Parameter(Mandatory)][string]$Scope)
    return [IO.Path]::GetFullPath($Scope).TrimEnd('\')
}

# The grant record for Path: the rights Setup recorded adding to its Users
# entry and the scopes that rely on them, or $null when it recorded none for
# Path. A record that cannot be read counts as none, so nothing is taken
# away on its word. A record without scopes (written by a 1.0.4 development
# build) is the production deployment's.
function Get-DefenseClawVendorUsersReadGrantRecord {
    param([Parameter(Mandatory)][string]$Path)
    $recordPath = Get-DefenseClawVendorUsersReadGrantPath
    if (-not [IO.File]::Exists($recordPath)) {
        return $null
    }
    try {
        Assert-DefenseClawNoReparsePath -Path $recordPath
        $record = [IO.File]::ReadAllText($recordPath) |
            Microsoft.PowerShell.Utility\ConvertFrom-Json -ErrorAction Stop
        if ([string]$record.sid -cne $script:UsersSID -or
            -not [string]::Equals(
                [IO.Path]::GetFullPath([string]$record.path).TrimEnd('\'),
                [IO.Path]::GetFullPath($Path).TrimEnd('\'),
                [StringComparison]::OrdinalIgnoreCase
            )) {
            return $null
        }
        $added = [int64]$record.added_rights -band [int64]$script:VendorDirectoryUsersRights
        if ($added -eq 0) {
            return $null
        }
        $scopes = [Collections.Generic.List[string]]::new()
        $recorded = if ($null -ne $record.PSObject.Properties['scopes']) {
            @($record.scopes)
        }
        else {
            @([string](Get-DefenseClawProfileRoots -EnterpriseProfile Standalone).StateRoot)
        }
        foreach ($scope in $recorded) {
            if ([string]::IsNullOrWhiteSpace([string]$scope)) {
                continue
            }
            $scope = ConvertTo-DefenseClawVendorGrantScope -Scope ([string]$scope)
            if (-not ($scopes | Microsoft.PowerShell.Core\Where-Object { [string]::Equals($_, $scope, [StringComparison]::OrdinalIgnoreCase) })) {
                $scopes.Add($scope)
            }
        }
        return [pscustomobject]@{ AddedRights = $added; Scopes = [string[]]$scopes.ToArray() }
    }
    catch {
        Microsoft.PowerShell.Utility\Write-Warning "the vendor directory grant record is unreadable, so its Users entry is kept: $($_.Exception.Message)"
        return $null
    }
}

# The rights Setup recorded adding to Path's Users entry, or 0 when it
# recorded none for Path.
function Get-DefenseClawVendorUsersReadGrant {
    param([Parameter(Mandatory)][string]$Path)
    $record = Get-DefenseClawVendorUsersReadGrantRecord -Path $Path
    if ($null -eq $record) {
        return [int64]0
    }
    return [int64]$record.AddedRights
}

# The scopes the grant record for Path names, or none.
function Get-DefenseClawVendorUsersReadGrantScopes {
    param([Parameter(Mandatory)][string]$Path)
    $record = Get-DefenseClawVendorUsersReadGrantRecord -Path $Path
    if ($null -eq $record) {
        return [string[]]@()
    }
    return [string[]]$record.Scopes
}

function Set-DefenseClawVendorUsersReadGrant {
    param(
        [Parameter(Mandatory)][string]$Path,
        [Parameter(Mandatory)][int64]$AddedRights,
        [Parameter(Mandatory)][AllowEmptyCollection()][string[]]$Scopes
    )
    $recordPath = Get-DefenseClawVendorUsersReadGrantPath
    $directory = [IO.Path]::GetDirectoryName($recordPath)
    if (-not [IO.Directory]::Exists($directory)) {
        Initialize-DefenseClawManagedRoot `
            -Path $directory `
            -Label 'lifecycle lock directory' `
            -RequiredBase $script:ProgramData
    }
    $named = [Collections.Generic.List[string]]::new()
    foreach ($scope in $Scopes) {
        $scope = ConvertTo-DefenseClawVendorGrantScope -Scope $scope
        if (-not ($named | Microsoft.PowerShell.Core\Where-Object { [string]::Equals($_, $scope, [StringComparison]::OrdinalIgnoreCase) })) {
            $named.Add($scope)
        }
    }
    Write-DefenseClawProtectedTextAtomic `
        -Value ([ordered]@{
                schema_version = 2
                path = [IO.Path]::GetFullPath($Path).TrimEnd('\')
                sid = $script:UsersSID
                added_rights = $AddedRights
                scopes = [string[]]$named.ToArray()
            } | Microsoft.PowerShell.Utility\ConvertTo-Json -Depth 3) `
        -Path $recordPath `
        -RequiredRoot $directory
}

# Adds Scope to the scopes of Path's grant record, when there is one: a
# scope that finds the rights another scope's Setup added relies on them too.
function Register-DefenseClawVendorUsersReadGrantScope {
    param(
        [Parameter(Mandatory)][string]$Path,
        [Parameter(Mandatory)][string]$Scope,
        [AllowNull()][object]$Record
    )
    if ($null -eq $Record) {
        return
    }
    $scope = ConvertTo-DefenseClawVendorGrantScope -Scope $Scope
    if (@($Record.Scopes | Microsoft.PowerShell.Core\Where-Object { [string]::Equals($_, $scope, [StringComparison]::OrdinalIgnoreCase) }).Count -gt 0) {
        return
    }
    Set-DefenseClawVendorUsersReadGrant -Path $Path -AddedRights ([int64]$Record.AddedRights) -Scopes ([string[]]@(@($Record.Scopes) + $scope))
}

function Remove-DefenseClawVendorUsersReadGrant {
    $recordPath = Get-DefenseClawVendorUsersReadGrantPath
    if ([IO.File]::Exists($recordPath)) {
        [IO.File]::Delete($recordPath)
    }
}

# A vendor directory that already existed (another Cisco product created it
# with SYSTEM and Administrators only) left every enrolled user's hook
# failing closed with enterprise_machine_policy_summary_untrusted while
# Setup, verify and repair reported success (GAP-0578). Install and repair
# give Users these rights on that directory alone, not inherited; owner and
# every other entry are preserved. Nothing is added when users can already
# check the directory. Only the rights the directory's Users entry lacked
# are recorded as added, before the entry is written, so an uninstall never
# takes away rights an administrator had set (Revoke-DefenseClawStandaloneVendorUsersRead).
# Scope (the deployment's StateRoot) is recorded as relying on them, also
# when another scope's Setup added them.
function Grant-DefenseClawStandaloneVendorUsersRead {
    param(
        [Parameter(Mandatory)][string]$Path,
        [Parameter(Mandatory)][string]$Scope
    )
    $record = Get-DefenseClawVendorUsersReadGrantRecord -Path $Path
    if (Test-DefenseClawStandaloneVendorUsersRead -Path $Path) {
        Register-DefenseClawVendorUsersReadGrantScope -Path $Path -Scope $Scope -Record $record
        return
    }
    Assert-DefenseClawNoReparsePath -Path $Path
    Assert-DefenseClawTrustedAncestor -Path $Path
    if ($null -ne $record) {
        # A different installer may have reset the shared vendor DACL. Drop
        # only our exact recorded ACE if it remains, then calculate a fresh
        # separate ACE against the administrator's current Users grants.
        [void](Set-DefenseClawSharedDirectoryRawAce `
            -Path $Path -SID $script:UsersSID -Action RemoveExact `
            -AccessMask ([int]$record.AddedRights))
    }
    $security = Microsoft.PowerShell.Security\Get-Acl -LiteralPath $Path
    $present = [int64]0
    foreach ($rule in @(Get-DefenseClawVendorUsersThisFolderRules -Security $security)) {
        $present = $present -bor ([int64]$rule.FileSystemRights -band 0xffffffffL)
    }
    $added = [int64]$script:VendorDirectoryUsersRights -band (-bnot $present)
    if ($added -eq 0) {
        if (-not (Test-DefenseClawStandaloneVendorUsersRead -Path $Path)) {
            throw "the shared vendor directory still denies standard users the required read grant: $Path"
        }
        if ($null -ne $record) { Remove-DefenseClawVendorUsersReadGrant }
        return
    }
    $scopes = if ($null -ne $record) { @(@($record.Scopes) + $Scope) } else { @($Scope) }
    # Record before publication. If the raw ACL write is interrupted, the
    # next repair can retry and uninstall can still remove an applied ACE.
    Set-DefenseClawVendorUsersReadGrant -Path $Path -AddedRights $added -Scopes $scopes
    [void](Set-DefenseClawSharedDirectoryRawAce `
        -Path $Path -SID $script:UsersSID -Action Add -AccessMask ([int]$added))
    if (-not (Test-DefenseClawStandaloneVendorUsersRead -Path $Path)) {
        throw "the shared vendor directory still denies standard users the required read grant: $Path"
    }
}

# Gives back the rights Grant-DefenseClawStandaloneVendorUsersRead recorded
# adding, when the gateway of Scope gives back its own and no other scope
# relies on them. Production and certification scopes share the vendor
# directory: a certification rollback or uninstall used to read the
# production Setup's record and take its rights away, so production hooks
# failed the vendor directory check (review loop round 3). A scope whose
# StateRoot is gone (removed without an uninstall) no longer counts. The
# Users entry keeps every other right, so an entry an administrator had set
# (or one an earlier release added, which recorded nothing) stays as it
# was; it grants only the check of that one directory. When the last scope
# goes, the record goes too, whatever it said, so a purge leaves no
# lifecycle folder behind for it.
function Revoke-DefenseClawStandaloneVendorUsersRead {
    param(
        [Parameter(Mandatory)][string]$Path,
        [Parameter(Mandatory)][string]$Scope
    )
    $record = Get-DefenseClawVendorUsersReadGrantRecord -Path $Path
    $added = [int64]0
    if ($null -ne $record) {
        $scope = ConvertTo-DefenseClawVendorGrantScope -Scope $Scope
        $others = [string[]]@($record.Scopes | Microsoft.PowerShell.Core\Where-Object {
                -not [string]::Equals($_, $scope, [StringComparison]::OrdinalIgnoreCase) -and
                [IO.Directory]::Exists($_)
            })
        if ($others.Count -gt 0) {
            Set-DefenseClawVendorUsersReadGrant -Path $Path -AddedRights ([int64]$record.AddedRights) -Scopes $others
            return
        }
        $added = [int64]$record.AddedRights
    }
    if ($added -ne 0 -and
        (Microsoft.PowerShell.Management\Test-Path -LiteralPath $Path -PathType Container)) {
        Assert-DefenseClawNoReparsePath -Path $Path
        Assert-DefenseClawTrustedAncestor -Path $Path
        [void](Set-DefenseClawSharedDirectoryRawAce `
            -Path $Path -SID $script:UsersSID -Action RemoveExact -AccessMask ([int]$added))
    }
    Remove-DefenseClawVendorUsersReadGrant
}

function Initialize-DefenseClawManagedRoot {
    param(
        [Parameter(Mandatory)][string]$Path,
        [Parameter(Mandatory)][string]$Label,
        [Parameter(Mandatory)][string]$RequiredBase,
        [switch]$AllowUsersRead,
        [switch]$PassThruCreationResult,
        [string]$StagingMarkerSID,
        [switch]$DeferFinalAcl,
        # Keep an existing root's protected, administrator-controlled DACL
        # instead of rewriting it to the bootstrap DACL (see below).
        [switch]$KeepProtectedAcl
    )
    if ($DeferFinalAcl -and
        [string]::IsNullOrWhiteSpace($StagingMarkerSID)) {
        throw 'deferred managed-root ACL publication requires a staging marker SID'
    }
    $base = [IO.Path]::GetFullPath($RequiredBase).TrimEnd('\')
    $full = [IO.Path]::GetFullPath($Path).TrimEnd('\')
    Assert-DefenseClawTrustedAncestors -Path $full -RequiredBase $base
    $rootKind = if ($AllowUsersRead) {
        'InstallDirectory'
    }
    else {
        'AdminDirectory'
    }

    $current = $base
    $relative = $full.Substring($base.Length).TrimStart('\')
    $components = @($relative.Split('\') | Microsoft.PowerShell.Core\Where-Object { -not [string]::IsNullOrWhiteSpace($_) })
    $rootCreated = $false
    # The vendor folders above the root this call creates (C:\ProgramData\Cisco,
    # C:\Program Files\Cisco): recorded so a purge removes them once empty, and
    # only them (GAP-0091).
    $createdAncestors = [Collections.Generic.List[string]]::new()
    for ($index = 0; $index -lt $components.Count; $index++) {
        $current = Microsoft.PowerShell.Management\Join-Path $current $components[$index]
        $isLeaf = $index -eq $components.Count - 1
        if (-not (Microsoft.PowerShell.Management\Test-Path -LiteralPath $current)) {
            $createdThisComponent = New-DefenseClawProtectedDirectory `
                -Path $current `
                -AllowUsersRead:$AllowUsersRead `
                -UsersReadThisFolder:(Test-DefenseClawStandaloneVendorDirectory -Path $current) `
                -StagingMarkerSID $(if ($isLeaf) {
                    $StagingMarkerSID
                }
                else {
                    ''
                })
            if (-not $isLeaf -and $createdThisComponent) {
                $createdAncestors.Add($current)
            }
            if ($index -eq $components.Count - 1) {
                $rootCreated = [bool]$createdThisComponent
                if (-not $rootCreated -and $DeferFinalAcl) {
                    # Absence was already recorded in the protected receipt.
                    # A competing creator may be adopted only when it carries
                    # this transaction's unguessable exact staging descriptor;
                    # never canonicalize an unrelated race winner in place.
                    [void](Assert-DefenseClawManagedRootStagingAcl `
                        -Path $current `
                        -MarkerSID $StagingMarkerSID)
                    $rootCreated = $true
                }
            }
        }
        elseif (-not (Microsoft.PowerShell.Management\Test-Path -LiteralPath $current -PathType Container)) {
            throw "$Label ancestor is occupied by a non-directory: $current"
        }
        else {
            if ($isLeaf -and $DeferFinalAcl) {
                # Crash re-entry can find the exact marker-staged leaf before
                # its identity was copied into the receipt. The secret marker
                # makes that inode transaction-owned; any other pre-existing
                # leaf fails closed without an ownership or DACL rewrite.
                [void](Assert-DefenseClawManagedRootStagingAcl `
                    -Path $current `
                    -MarkerSID $StagingMarkerSID)
                $rootCreated = $true
            }
            else {
                Assert-DefenseClawTrustedAncestor -Path $current
            }
        }
    }
    $null = Add-DefenseClawStandaloneCreatedFolderRecord -Path $createdAncestors.ToArray()

    if ($rootCreated -and $DeferFinalAcl) {
        [void](Assert-DefenseClawManagedRootStagingAcl `
            -Path $Path `
            -MarkerSID $StagingMarkerSID)
        return [pscustomobject]@{
            created = $true
            state = 'staged'
        }
    }
    if (Microsoft.PowerShell.Management\Test-Path -LiteralPath $Path) {
        if (-not (Microsoft.PowerShell.Management\Test-Path -LiteralPath $Path -PathType Container)) {
            throw "$Label is occupied by a non-directory: $Path"
        }
        # The structural checks above (no reparse point anywhere in the chain,
        # a real directory on the managed volume) stay fatal. Permission
        # drift on the root itself - re-enabled inheritance bringing
        # CREATOR OWNER and ProgramData's Users create-child, an owner taken
        # by another administrator or a standard user who pre-created it, an
        # extra entry - is repaired: the canonical protected descriptor is
        # stamped with Administrators as owner before the root is judged.
        # Standalone: an empty folder an earlier removal left under Program
        # Files carries the default inherit-only CREATOR OWNER entry, which
        # grants nothing; refusing it failed /ensure with a raw S-1-3-0
        # (GAP-0915), so it is taken over like an administrator's folder.
        Assert-DefenseClawPathAcl `
            -Path $Path `
            -AllowedWriterSIDs @($script:SystemSID, $script:AdministratorsSID, $script:TrustedInstallerSID) `
            -AllowUsersRead:$AllowUsersRead `
            -AllowInheritance `
            -IgnoreCreatorTemplates:(Test-DefenseClawStandaloneProfile) `
            -SelfHealKind $rootKind `
            -SelfHealGatewayServiceSID $script:AdministratorsSID
    }
    else {
        throw "$Label secure creation did not produce the requested root: $Path"
    }
    # A live deployment's InstallRoot and StateRoot carry the gateway
    # service's read entry. Upgrade, Repair and Uninstall prepare them before
    # their transaction; rewriting them to the bootstrap DACL there removed
    # that entry, so an action that failed before its managed ACLs were
    # applied again left a running gateway that could not start again. With
    # -KeepProtectedAcl (standalone only) an existing protected DACL,
    # already proven administrator-controlled above, is kept; an inherited
    # one is replaced.
    # PowerShell names are case-insensitive: this must not reuse the
    # parameter's name.
    $existingAclKept = $false
    if ($KeepProtectedAcl -and -not $rootCreated) {
        $existingAclKept = [bool](
            Microsoft.PowerShell.Security\Get-Acl -LiteralPath $Path
        ).AreAccessRulesProtected
    }
    if (-not $existingAclKept) {
        Set-DefenseClawBootstrapRootAcl -Path $Path -AllowUsersRead:$AllowUsersRead
    }
    Assert-DefenseClawPathAcl `
        -Path $Path `
        -AllowedWriterSIDs @($script:SystemSID, $script:AdministratorsSID, $script:TrustedInstallerSID) `
        -AllowUsersRead:$AllowUsersRead `
        -SelfHealKind $rootKind `
        -SelfHealGatewayServiceSID $script:AdministratorsSID
    if ($PassThruCreationResult) {
        return [pscustomobject]@{
            created = [bool]$rootCreated
            state = 'canonical'
        }
    }
}

function Assert-DefenseClawManagedRootStagingAcl {
    param(
        [Parameter(Mandatory)][string]$Path,
        [Parameter(Mandatory)][string]$MarkerSID
    )
    $marker = [Security.Principal.SecurityIdentifier]::new($MarkerSID)
    if ($marker.Value -cne $MarkerSID) {
        throw 'managed-root staging marker SID is not canonical'
    }
    $expected = [Security.AccessControl.DirectorySecurity]::new()
    $expected.SetSecurityDescriptorSddlForm(
        "O:BAG:BAD:P(D;;FA;;;$MarkerSID)(A;OICI;FA;;;SY)(A;OICI;FA;;;BA)",
        [Security.AccessControl.AccessControlSections]::All
    )
    $nativeSecurity = Initialize-DefenseClawNativeSecurity
    $captured = $nativeSecurity::GetDirectorySecuritySnapshotNoFollowIfExists(
        $Path
    )
    if ($null -eq $captured) {
        throw 'managed-root staging directory is missing'
    }
    $actual = [Security.AccessControl.RawSecurityDescriptor]::new(
        [byte[]]$captured.SecurityDescriptor,
        0
    )
    # The explicit deny for this transaction's unguessable marker SID is the
    # proof that the transaction created the directory. It stays mandatory.
    # Beyond it, an entry a DLP or EDR filter adds to every new directory is
    # judged by write authority, not by exact equality.
    $markerProof = $false
    if ($null -ne $actual.DiscretionaryAcl) {
        foreach ($ace in $actual.DiscretionaryAcl) {
            if ($ace -is [Security.AccessControl.CommonAce] -and
                $ace.AceQualifier -eq [Security.AccessControl.AceQualifier]::AccessDenied -and
                -not $ace.IsInherited -and
                $ace.SecurityIdentifier.Value -ceq $MarkerSID) {
                $markerProof = $true
            }
        }
    }
    if (-not $markerProof) {
        throw "managed-root staging directory does not carry this transaction's marker: $Path"
    }
    Assert-DefenseClawCanonicalRawPathAcl `
        -Path $Path `
        -Actual $actual `
        -Expected $expected
    return $captured
}

function Complete-DefenseClawManagedRootStaging {
    param(
        [Parameter(Mandatory)][string]$Path,
        [Parameter(Mandatory)][string]$MarkerSID,
        [Parameter(Mandatory)][string]$ExpectedIdentity,
        [switch]$AllowUsersRead
    )
    $before = Assert-DefenseClawManagedRootStagingAcl `
        -Path $Path `
        -MarkerSID $MarkerSID
    if ([string]$before.Identity -cne $ExpectedIdentity) {
        throw 'managed-root staging identity changed before final publication'
    }
    Set-DefenseClawBootstrapRootAcl `
        -Path $Path `
        -AllowUsersRead:$AllowUsersRead
    $nativeSecurity = Initialize-DefenseClawNativeSecurity
    $after = $nativeSecurity::GetDirectorySecuritySnapshotNoFollowIfExists(
        $Path
    )
    if ($null -eq $after -or
        [string]$after.Identity -cne $ExpectedIdentity) {
        throw 'managed-root identity changed during final ACL publication'
    }
    return $after
}

function Initialize-DefenseClawTransactionManagedRoot {
    param(
        [Parameter(Mandatory)][hashtable]$Layout,
        [Parameter(Mandatory)][string]$GatewayServiceName,
        [Parameter(Mandatory)][string]$GuardianServiceName,
        [Parameter(Mandatory)]
        [ValidateSet('install_root', 'state_root')]
        [string]$Root,
        [Parameter(Mandatory)][string]$Path,
        [Parameter(Mandatory)][string]$Label,
        [Parameter(Mandatory)][string]$RequiredBase,
        [switch]$AllowUsersRead
    )
    $intent = Get-DefenseClawInstallRollbackIntent `
        -Layout $Layout `
        -GatewayServiceName $GatewayServiceName `
        -GuardianServiceName $GuardianServiceName `
        -Required
    $marker = [string]$intent."${Root}_marker_sid"
    $creation = Initialize-DefenseClawManagedRoot `
        -Path $Path `
        -Label $Label `
        -RequiredBase $RequiredBase `
        -AllowUsersRead:$AllowUsersRead `
        -PassThruCreationResult `
        -StagingMarkerSID $marker `
        -KeepProtectedAcl:(Test-DefenseClawStandaloneProfile) `
        -DeferFinalAcl:(-not [string]::IsNullOrWhiteSpace($marker))
    if (-not [bool]$creation.created) {
        [void](Set-DefenseClawInstallPreparationRootIdentity `
            -Layout $Layout `
            -GatewayServiceName $GatewayServiceName `
            -GuardianServiceName $GuardianServiceName `
            -Root $Root `
            -State existing)
        return $false
    }
    $intent = Set-DefenseClawInstallPreparationRootIdentity `
        -Layout $Layout `
        -GatewayServiceName $GatewayServiceName `
        -GuardianServiceName $GuardianServiceName `
        -Root $Root `
        -State staged
    $identity = [string]$intent."${Root}_identity"
    [void](Complete-DefenseClawManagedRootStaging `
        -Path $Path `
        -MarkerSID $marker `
        -ExpectedIdentity $identity `
        -AllowUsersRead:$AllowUsersRead)
    [void](Set-DefenseClawInstallPreparationRootIdentity `
        -Layout $Layout `
        -GatewayServiceName $GatewayServiceName `
        -GuardianServiceName $GuardianServiceName `
        -Root $Root `
        -State canonical)
    return $true
}

function Enter-DefenseClawLifecycleLock {
    param(
        [Parameter(Mandatory)][hashtable]$Layout,
        [int]$TimeoutSeconds = 30
    )
    $path = Assert-DefenseClawDescendant `
        -Path $Layout.LifecycleLockPath `
        -Root $Layout.LifecycleLockDirectory `
        -Label 'lifecycle lock file'
    if (-not (Microsoft.PowerShell.Management\Test-Path `
            -LiteralPath ([string]$Layout.LifecycleLockDirectory) `
            -PathType Container)) {
        # A purge that finished while this run started removes the lock and
        # its empty folder; create the folder again as every run does.
        Initialize-DefenseClawManagedRoot `
            -Path $Layout.LifecycleLockDirectory `
            -Label 'lifecycle lock directory' `
            -RequiredBase $script:ProgramData
    }
    if (-not (Microsoft.PowerShell.Management\Test-Path -LiteralPath $path)) {
        try {
            $created = [IO.File]::Open(
                $path,
                [IO.FileMode]::CreateNew,
                [IO.FileAccess]::ReadWrite,
                [IO.FileShare]::None
            )
            $created.Dispose()
            $security = [Security.AccessControl.FileSecurity]::new()
            $security.SetSecurityDescriptorSddlForm(
                'O:BAG:BAD:P(A;;FA;;;SY)(A;;FA;;;BA)',
                [Security.AccessControl.AccessControlSections]::All
            )
            Microsoft.PowerShell.Security\Set-Acl `
                -LiteralPath $path `
                -AclObject $security
        }
        catch [IO.IOException] {
            if (-not (Microsoft.PowerShell.Management\Test-Path `
                -LiteralPath $path `
                -PathType Leaf)) {
                throw
            }
        }
    }
    if (-not (Microsoft.PowerShell.Management\Test-Path -LiteralPath $path -PathType Leaf)) {
        throw "protected lifecycle lock is not a regular file: $path"
    }
    Assert-DefenseClawNoReparsePath -Path $path
    $item = Microsoft.PowerShell.Management\Get-Item -LiteralPath $path -Force
    if ([int64]$item.Length -ne 0) {
        throw "protected lifecycle lock has unexpected content: $path"
    }
    # A hardening or cleanup script, or a backup restore, can leave the lock
    # ReadOnly, Hidden or System; the ReadWrite open below would then fail with
    # access denied that no retry can fix. Clear them on the exact leaf.
    [void](Clear-DefenseClawRestrictiveFileAttributes -Path $path)
    # The lock holds no data, so repair runs before the verdict: an inherited,
    # re-owned or extra-entry descriptor (a crash between creation and the
    # first stamp, an icacls reset, a takeown) is re-stamped to the canonical
    # protected admin-file descriptor in place. The identity persists, which
    # keeps cross-run serialization intact.
    $adminRights = New-DefenseClawRequiredRights -Kind Admin
    Assert-DefenseClawPathAcl `
        -Path $path `
        -AllowedWriterSIDs @(
            $script:SystemSID,
            $script:AdministratorsSID,
            $script:TrustedInstallerSID
        ) `
        -AllowedReaderSIDs @(
            $script:SystemSID,
            $script:AdministratorsSID,
            $script:TrustedInstallerSID
        ) `
        -RequiredRights $adminRights `
        -RejectUntrustedRead `
        -SelfHealKind AdminFile `
        -SelfHealGatewayServiceSID $script:AdministratorsSID

    $deadline = [DateTime]::UtcNow.AddSeconds($TimeoutSeconds)
    Write-DefenseClawLifecyclePhase -Stage 'lifecycle lock wait'
    $attributeRetried = $false
    do {
        try {
            $lock = [IO.File]::Open(
                $path,
                [IO.FileMode]::Open,
                [IO.FileAccess]::ReadWrite,
                [IO.FileShare]::None
            )
            if ($lock.Length -ne 0) {
                $lock.Dispose()
                throw "protected lifecycle lock changed while opening: $path"
            }
            Write-DefenseClawLifecyclePhase -Stage 'lifecycle lock acquired'
            return $lock
        }
        catch [IO.FileNotFoundException], [IO.DirectoryNotFoundException] {
            # A purge held the lock with delete-on-close and removed it after
            # this run had checked it, so the open finds no file. Opening the
            # missing path again until the deadline reported a misleading
            # lock timeout; create and check a new protected lock instead
            # (GAP-1076).
            if ([DateTime]::UtcNow -ge $deadline) {
                throw "another DefenseClaw enterprise lifecycle mutation holds the protected file lock for more than $TimeoutSeconds seconds"
            }
            $remaining = [int][Math]::Ceiling(($deadline - [DateTime]::UtcNow).TotalSeconds)
            return Enter-DefenseClawLifecycleLock `
                -Layout $Layout `
                -TimeoutSeconds ([Math]::Max(1, $remaining))
        }
        catch [IO.IOException] {
            if ([DateTime]::UtcNow -ge $deadline) {
                throw "another DefenseClaw enterprise lifecycle mutation holds the protected file lock for more than $TimeoutSeconds seconds"
            }
            Microsoft.PowerShell.Utility\Start-Sleep -Milliseconds 100
        }
        catch [UnauthorizedAccessException] {
            # An attribute re-applied between the repair and the open. Clear
            # it once more; a second denial is not drift and is reported.
            if ($attributeRetried) {
                throw
            }
            $attributeRetried = $true
            [void](Clear-DefenseClawRestrictiveFileAttributes -Path $path)
        }
    } while ([DateTime]::UtcNow -lt $deadline)
    throw "another DefenseClaw enterprise lifecycle mutation holds the protected file lock for more than $TimeoutSeconds seconds"
}

# How long a standalone uninstall waits for bundle.lock (GAP-2438). Longer
# than the 30 s a bundle apply, an ensure TRUSTANCHORS= or a secret set that
# holds bundle.lock waits for lifecycle.lock, which the uninstall holds: such
# a run gives up (1618) and releases bundle.lock before this wait ends.
$script:DefenseClawBundleStoreLockWaitSeconds = 45

function Enter-DefenseClawBundleStoreLock {
    <#
        GAP-2438: a standalone uninstall removes StateRoot, which holds the
        policy bundle store and its bundle.lock. It takes bundle.lock after
        lifecycle.lock, before it changes anything, so no bundle apply,
        TRUSTANCHORS= ensure or secret set writes under StateRoot while it is
        removed. The lock is the byte-range lock the Go runs take
        (lockWindowsBundleStore). A held lock past the wait is the lifecycle
        busy refusal (1618) with nothing changed. No bundle.lock, nothing to
        wait for: $null. The handle allows delete, so Exit before StateRoot
        is removed (Complete-DefenseClawStatePurge).
    #>
    param(
        [Parameter(Mandatory)][hashtable]$Layout,
        [int]$TimeoutSeconds = $script:DefenseClawBundleStoreLockWaitSeconds
    )
    $path = Microsoft.PowerShell.Management\Join-Path ([string]$Layout.InstallStateDirectory) 'bundle.lock'
    $deadline = [DateTime]::UtcNow.AddSeconds($TimeoutSeconds)
    while ($true) {
        $stream = $null
        try {
            $item = Microsoft.PowerShell.Management\Get-Item -LiteralPath $path -Force -ErrorAction SilentlyContinue
            if ($null -eq $item) {
                return $null
            }
            if (($item.Attributes -band [IO.FileAttributes]::ReparsePoint) -ne 0 -or $item.PSIsContainer) {
                throw "the policy bundle lock is not a regular file: $path"
            }
            $stream = [IO.File]::Open(
                $path,
                [IO.FileMode]::Open,
                [IO.FileAccess]::ReadWrite,
                ([IO.FileShare]::ReadWrite -bor [IO.FileShare]::Delete)
            )
            $stream.Lock(0, 1)
            Write-DefenseClawLifecyclePhase -Stage 'bundle lock acquired'
            return $stream
        }
        catch [IO.FileNotFoundException], [IO.DirectoryNotFoundException] {
            if ($null -ne $stream) { $stream.Dispose() }
            return $null
        }
        catch [IO.IOException] {
            if ($null -ne $stream) { $stream.Dispose() }
            if ([DateTime]::UtcNow -ge $deadline) {
                throw (
                    'a DefenseClaw policy bundle apply, TRUSTANCHORS= ensure or secret set holds the protected file lock ' +
                    "$path for more than $TimeoutSeconds seconds; the uninstall changed nothing and can be run again"
                )
            }
            Microsoft.PowerShell.Utility\Start-Sleep -Milliseconds 250
        }
    }
}

function Exit-DefenseClawPurgeBundleLock {
    # Releases the bundle.lock an uninstall took (Enter-DefenseClawBundleStoreLock).
    if ($null -ne $script:DefenseClawPurgeBundleLock) {
        try { $script:DefenseClawPurgeBundleLock.Dispose() } catch { }
        $script:DefenseClawPurgeBundleLock = $null
    }
}

function Exit-DefenseClawLifecycleLock {
    param([Parameter(Mandatory)]$Lock)
    # The protected machine-wide lock identity intentionally persists across
    # deployments. Only the handle is released here; deleting/recreating the
    # predictable path would weaken cross-run serialization and reopen a
    # squatting race between consecutive lifecycle processes.
    $Lock.Dispose()
}

function Test-DefenseClawWriteLikeRights {
    param([Security.AccessControl.FileSystemRights]$Rights)
    $writeLike = [Security.AccessControl.FileSystemRights]::WriteData `
        -bor [Security.AccessControl.FileSystemRights]::AppendData `
        -bor [Security.AccessControl.FileSystemRights]::WriteExtendedAttributes `
        -bor [Security.AccessControl.FileSystemRights]::WriteAttributes `
        -bor [Security.AccessControl.FileSystemRights]::Delete `
        -bor [Security.AccessControl.FileSystemRights]::DeleteSubdirectoriesAndFiles `
        -bor [Security.AccessControl.FileSystemRights]::ChangePermissions `
        -bor [Security.AccessControl.FileSystemRights]::TakeOwnership
    $rightsValue = [uint64]([int64]$Rights -band 0xffffffffL)
    return (($Rights -band $writeLike) -ne 0 -or
        ($rightsValue -band [uint64]0x50000000) -ne 0)
}

function Test-DefenseClawReadLikeRights {
    param([Security.AccessControl.FileSystemRights]$Rights)
    $readLike = [Security.AccessControl.FileSystemRights]::ReadData `
        -bor [Security.AccessControl.FileSystemRights]::ReadExtendedAttributes `
        -bor [Security.AccessControl.FileSystemRights]::ReadAttributes `
        -bor [Security.AccessControl.FileSystemRights]::ReadPermissions `
        -bor [Security.AccessControl.FileSystemRights]::ExecuteFile
    return (($Rights -band $readLike) -ne 0)
}

# Expands the four generic access bits through the file object's generic
# mapping, so an entry a third-party tool stored as GENERIC_ALL is judged
# exactly like the FullControl it grants.
function ConvertTo-DefenseClawMappedFileRights {
    param([Parameter(Mandatory)]$Rights)
    $value = [int64]$Rights -band 0xffffffffL
    $mapped = $value -band 0x0fffffffL
    if (($value -band 0x10000000L) -ne 0) {
        $mapped = $mapped -bor 0x1f01ffL
    }
    if (($value -band 0x80000000L) -ne 0) {
        $mapped = $mapped -bor 0x120089L
    }
    if (($value -band 0x40000000L) -ne 0) {
        $mapped = $mapped -bor 0x120116L
    }
    if (($value -band 0x20000000L) -ne 0) {
        $mapped = $mapped -bor 0x1200a0L
    }
    # Enum.ToObject keeps bits the enum does not name (an ACE can carry
    # ACCESS_SYSTEM_SECURITY or MAXIMUM_ALLOWED); a PowerShell cast refuses them.
    return [Enum]::ToObject([Security.AccessControl.FileSystemRights], [int]$mapped)
}

# True when the rights only let a principal list, traverse, read, and add new
# children (ProgramData's inherited Users 0x116 entry). They cannot delete,
# rename, or re-ACL anything already in the directory.
function Test-DefenseClawCreateChildOnlyRights {
    param([Parameter(Mandatory)][Security.AccessControl.FileSystemRights]$Rights)
    $value = [int64]$Rights -band 0xffffffffL
    $outside = $value -band ((-bnot 0x1201bfL) -band 0xffffffffL)
    return ($outside -eq 0)
}

# Reads an object owner as a raw SID. NTAccount translation of an orphaned
# owner (deleted account, unreachable domain, retired service) returns $null on
# Windows PowerShell 5.1; the SID form never depends on translation.
function Get-DefenseClawAclOwnerSID {
    param([Parameter(Mandatory)]$Acl)
    try {
        $owner = $Acl.GetOwner([Security.Principal.SecurityIdentifier])
    }
    catch {
        $owner = $null
    }
    if ($null -eq $owner) {
        return ''
    }
    return [string]$owner.Value
}

# Principals whose deny entries also bind SYSTEM and Administrators.
$script:BroadPrincipalSIDs = @('S-1-1-0', 'S-1-5-11', 'S-1-5-32-545')

# Everyone, Authenticated Users, Users, Interactive, Guests and Anonymous.
$script:UnprivilegedWriterSIDs = @(
    'S-1-1-0', 'S-1-5-11', 'S-1-5-32-545', 'S-1-5-4', 'S-1-5-32-546', 'S-1-5-7'
)

# True for a writer any ordinary or anonymous session holds (including Domain
# Users and a null DACL). Write authority there on a LocalSystem service is a
# path to SYSTEM, so drift that leaves one behind after a repair stays fatal;
# only a named principal (a GPO or EDR account) is accepted as a boundary.
function Test-DefenseClawBroadUnprivilegedSid {
    param([Parameter(Mandatory)][AllowEmptyString()][string]$SID)
    if ([string]::Equals($SID, 'null DACL', [StringComparison]::OrdinalIgnoreCase)) {
        return $true
    }
    if ($SID -in $script:UnprivilegedWriterSIDs) {
        return $true
    }
    return $SID -match '^S-1-5-21-\d+-\d+-\d+-513$'
}

# Reads the DACL of $Path and returns every permission verdict against it, in
# the order they were historically thrown, so an empty result means compliant.
# Splitting the reading from the judging is what lets a caller repair the path
# and read it again before deciding anything (see Assert-DefenseClawPathAcl).
#
# Verdicts judge effective write authority for principals outside the trusted
# set, never exact descriptor equality. Each carries a Kind:
#   Access   - a foreign principal can write, create children, or read, or the
#              DACL inherits (Severity Write, CreateChild, Read, Inheritance).
#   Contract - a null DACL, a foreign or unreadable owner, or a deny entry
#              that removes a right DefenseClaw needs.
#   Rights   - a principal DefenseClaw depends on is missing rights it must
#              have. Severity Broad marks the ordinary Users or Authenticated
#              Users read, which is functional rather than a trust question.
#   Advisory - a harmless shape worth recording (a deny entry for an unrelated
#              principal). Never fatal.
# Inherit-only entries grant nothing on the object itself and are skipped,
# except a non-creator write entry that new children would inherit.
#
# Get-Acl failures are deliberately not verdicts: they propagate out of here so
# an unreadable security descriptor can never be downgraded to a warning.
function Get-DefenseClawPathAclVerdicts {
    param(
        [Parameter(Mandatory)][string]$Path,
        [Parameter(Mandatory)][string[]]$AllowedWriterSIDs,
        [string[]]$AllowedReaderSIDs = @(),
        [hashtable]$RequiredRights = @{},
        [Parameter(Mandatory)][string[]]$AllowedOwnerSIDs,
        [switch]$AllowUsersRead,
        [switch]$RejectUntrustedRead,
        [switch]$AllowInheritance,
        # Skip the inherit-only CREATOR OWNER and CREATOR GROUP templates.
        # They grant nothing on the folder itself, only to whoever creates a
        # child, which needs write access this check already limits.
        [switch]$IgnoreCreatorTemplates
    )
    $verdicts = [Collections.Generic.List[object]]::new()
    $acl = Microsoft.PowerShell.Security\Get-Acl -LiteralPath $Path
    $accessSDDL = $acl.GetSecurityDescriptorSddlForm(
        [Security.AccessControl.AccessControlSections]::Access
    )
    if ([string]::IsNullOrWhiteSpace($accessSDDL) -or
        -not $accessSDDL.StartsWith('D:', [StringComparison]::OrdinalIgnoreCase)) {
        # Nothing below can be evaluated without a DACL to evaluate it against.
        $verdicts.Add([pscustomobject]@{
            Kind     = 'Contract'
            Severity = 'Dacl'
            Reason   = "managed path has an absent or null DACL: $Path"
        })
        return $verdicts.ToArray()
    }
    $isDirectory = $acl -is [Security.AccessControl.DirectorySecurity]
    $standalone = Test-DefenseClawStandaloneProfile
    $ownerSID = Get-DefenseClawAclOwnerSID -Acl $acl
    $ownerTrusted = $ownerSID -in $AllowedOwnerSIDs
    if ([string]::IsNullOrWhiteSpace($ownerSID)) {
        $verdicts.Add([pscustomobject]@{
            Kind     = 'Contract'
            Severity = 'Owner'
            Reason   = "managed path has no readable owner: $Path"
        })
    }
    elseif (-not $ownerTrusted) {
        $verdicts.Add([pscustomobject]@{
            Kind     = 'Contract'
            Severity = 'Owner'
            Reason   = "untrusted owner $ownerSID on managed path: $Path"
        })
    }
    if (-not $AllowInheritance -and -not $acl.AreAccessRulesProtected) {
        $verdicts.Add([pscustomobject]@{
            Kind     = 'Access'
            Severity = 'Inheritance'
            Reason   = "managed DACL inherits from an ancestor: $Path"
        })
    }
    $grantedBySID = @{}
    $deniedBySID = @{}
    $rules = @($acl.GetAccessRules(
        $true,
        $true,
        [Security.Principal.SecurityIdentifier]
    ))
    foreach ($rule in $rules) {
        $sid = [string]$rule.IdentityReference.Value
        $rights = ConvertTo-DefenseClawMappedFileRights -Rights $rule.FileSystemRights
        $inheritOnly = (($rule.PropagationFlags -band
            [Security.AccessControl.PropagationFlags]::InheritOnly) -ne 0)
        $writer = $sid -in $AllowedWriterSIDs -or
            ($sid -eq $script:OwnerRightsSID -and $ownerTrusted)
        if ($rule.AccessControlType -eq [Security.AccessControl.AccessControlType]::Deny) {
            if (-not $inheritOnly) {
                $currentDenied = if ($deniedBySID.ContainsKey($sid)) {
                    [Security.AccessControl.FileSystemRights]$deniedBySID[$sid]
                }
                else {
                    [Security.AccessControl.FileSystemRights]0
                }
                $deniedBySID[$sid] = $currentDenied -bor $rights
            }
            continue
        }
        if ($inheritOnly) {
            # CREATOR OWNER and CREATOR GROUP only restate what a child's own
            # creator receives. Any other write-capable inheritable entry would
            # reach the next child created here. The standalone profile keeps
            # its stricter reading: the creator templates are skipped only with
            # -IgnoreCreatorTemplates (GAP-0915), an inheritable create-child
            # entry counts as write access, and under -RejectUntrustedRead an
            # inheritable read entry is refused as well.
            $creatorTemplate = $sid -in @('S-1-3-0', 'S-1-3-1')
            if ($standalone) {
                if ($creatorTemplate -and $IgnoreCreatorTemplates) {
                    continue
                }
                if ((Test-DefenseClawWriteLikeRights -Rights $rights) -and
                    $sid -notin $AllowedWriterSIDs) {
                    $verdicts.Add([pscustomobject]@{
                        Kind     = 'Access'
                        Severity = 'Write'
                        Reason   = "untrusted principal $sid has inheritable write-like access to managed path: $Path"
                    })
                }
                if ($RejectUntrustedRead -and
                    (Test-DefenseClawReadLikeRights -Rights $rights) -and
                    $sid -notin $AllowedReaderSIDs -and
                    -not ($AllowUsersRead -and $sid -eq $script:UsersSID)) {
                    $verdicts.Add([pscustomobject]@{
                        Kind     = 'Access'
                        Severity = 'Read'
                        Reason   = "untrusted principal $sid can read protected managed path: $Path"
                    })
                }
                continue
            }
            if ($creatorTemplate -or $writer -or
                -not (Test-DefenseClawWriteLikeRights -Rights $rights) -or
                (Test-DefenseClawCreateChildOnlyRights -Rights $rights)) {
                continue
            }
            $verdicts.Add([pscustomobject]@{
                Kind     = 'Access'
                Severity = 'Write'
                Reason   = "untrusted principal $sid has inheritable write-like access to managed path: $Path"
            })
            continue
        }
        $currentRights = if ($grantedBySID.ContainsKey($sid)) {
            [Security.AccessControl.FileSystemRights]$grantedBySID[$sid]
        }
        else {
            [Security.AccessControl.FileSystemRights]0
        }
        $grantedBySID[$sid] = $currentRights -bor $rights
        if ((Test-DefenseClawWriteLikeRights -Rights $rights) -and -not $writer) {
            if ($isDirectory -and -not $RejectUntrustedRead -and
                (Test-DefenseClawCreateChildOnlyRights -Rights $rights)) {
                $verdicts.Add([pscustomobject]@{
                    Kind     = 'Access'
                    Severity = 'CreateChild'
                    Reason   = "untrusted principal $sid can only add children to managed directory: $Path"
                })
            }
            else {
                $verdicts.Add([pscustomobject]@{
                    Kind     = 'Access'
                    Severity = 'Write'
                    Reason   = "untrusted principal $sid has write-like access to managed path: $Path"
                })
            }
        }
        if ($RejectUntrustedRead -and
            (Test-DefenseClawReadLikeRights -Rights $rights) -and
            $sid -notin $AllowedReaderSIDs -and
            -not ($sid -eq $script:OwnerRightsSID -and $ownerTrusted) -and
            -not ($AllowUsersRead -and $sid -eq $script:UsersSID)) {
            $verdicts.Add([pscustomobject]@{
                Kind     = 'Access'
                Severity = 'Read'
                Reason   = "untrusted principal $sid can read protected managed path: $Path"
            })
        }
    }
    foreach ($denied in $deniedBySID.GetEnumerator()) {
        $sid = [string]$denied.Key
        $deniedRights = [Security.AccessControl.FileSystemRights]$denied.Value
        $removesRequired = $false
        foreach ($entry in $RequiredRights.GetEnumerator()) {
            $requiredSID = [string]$entry.Key
            if ($sid -ne $requiredSID -and
                -not ($sid -in $script:BroadPrincipalSIDs -and
                    $requiredSID -in @($script:SystemSID, $script:AdministratorsSID))) {
                continue
            }
            if (($deniedRights -band [Security.AccessControl.FileSystemRights]$entry.Value) -ne 0) {
                $removesRequired = $true
            }
        }
        if ($removesRequired) {
            $verdicts.Add([pscustomobject]@{
                Kind     = 'Contract'
                Severity = 'Deny'
                Reason   = "managed path contains a deny ACE for $sid that removes required rights: $Path"
            })
        }
        elseif ($RequiredRights.Count -gt 0) {
            $verdicts.Add([pscustomobject]@{
                Kind     = 'Advisory'
                Severity = 'Deny'
                Reason   = "deny ACE for $sid removes no right DefenseClaw needs on managed path: $Path"
            })
        }
    }
    foreach ($entry in $RequiredRights.GetEnumerator()) {
        $sid = [string]$entry.Key
        $required = ConvertTo-DefenseClawMappedFileRights -Rights $entry.Value
        $actual = if ($grantedBySID.ContainsKey($sid)) {
            [Security.AccessControl.FileSystemRights]$grantedBySID[$sid]
        }
        else {
            [Security.AccessControl.FileSystemRights]0
        }
        if (($actual -band $required) -ne $required) {
            $severity = if ($sid -in @($script:UsersSID, $script:AuthenticatedUsersSID)) {
                'Broad'
            }
            else {
                'Required'
            }
            $verdicts.Add([pscustomobject]@{
                Kind     = 'Rights'
                Severity = $severity
                Reason   = "managed path is missing required rights for $sid (required=$required actual=$actual): $Path"
            })
        }
    }
    return $verdicts.ToArray()
}

# The Severity of a verdict, or '' for one that carries none.
function Get-DefenseClawPathAclVerdictSeverity {
    param([Parameter(Mandatory)]$Verdict)
    if ($null -ne $Verdict.PSObject.Properties['Severity']) {
        return [string]$Verdict.Severity
    }
    return ''
}

# The SID of the account this process runs as (Setup's own account).
function Get-DefenseClawCurrentProcessUserSID {
    return [string][Security.Principal.WindowsIdentity]::GetCurrent().User.Value
}

function Assert-DefenseClawPathAcl {
    param(
        [Parameter(Mandatory)][string]$Path,
        [Parameter(Mandatory)][string[]]$AllowedWriterSIDs,
        [string[]]$AllowedReaderSIDs = @(),
        [hashtable]$RequiredRights = @{},
        [string[]]$AllowedOwnerSIDs = @(
            $script:SystemSID,
            $script:AdministratorsSID,
            $script:TrustedInstallerSID
        ),
        [switch]$AllowUsersRead,
        [switch]$RejectUntrustedRead,
        [switch]$AllowInheritance,
        # Forwarded to Get-DefenseClawPathAclVerdicts (GAP-0915).
        [switch]$IgnoreCreatorTemplates,
        # AIFW-34262: for a directory DefenseClaw shares with the Cisco Secure
        # Client tree (the state root), a foreign principal appearing in the
        # DACL after we stamped the canonical one means AVC re-applied its own
        # ACLs, not that our install is broken. Report those verdicts and
        # continue instead of failing the transaction.
        [switch]$AdvisoryUntrustedAccess,
        # AIFW-34262 self-heal. When set, a broken canonical contract on this
        # path - null DACL, foreign owner, deny ACE, foreign writer, or missing
        # required rights - is repaired by re-stamping the canonical ACL for
        # this Kind and reading the path again, instead of failing the
        # transaction on the first reading. Every DefenseClaw-owned path passes
        # it: repair always runs before the verdict is judged.
        #
        # This is a repair, not a relaxation, so it also runs under the strict
        # pin - only the final downgrade to a warning is pin-gated.
        [ValidateSet('InstallDirectory', 'InstallFile', 'ServiceInstallDirectory', 'ServiceInstallFile', 'StateDirectory', 'AdminDirectory', 'AdminFile', 'ConfigDirectory', 'ConfigFile', 'MachinePolicyFile', 'RuntimeDirectory', 'RuntimeFile', 'RuntimeSecretFile', 'AuthorizationDirectory', 'AuthorizationFile', 'LogDirectory', 'GatewayLogDirectory', 'ManagedIPCDirectory')]
        [string]$SelfHealKind,
        [string]$SelfHealGatewayServiceSID,
        # For a vendor-owned path DefenseClaw manages but did not create (the
        # Codex machine-policy folder and requirements file): re-stamp only
        # for real write authority, a foreign owner or missing required
        # rights, never merely because the descriptor inherits, grants an
        # extra reader or lets Users add children.
        [switch]$HealOnlyUntrusted
    )
    # Only the Secure Client state root sits inside a tree AVC re-ACLs. The
    # standalone state root (%ProgramData%\Cisco\DefenseClaw) has no other
    # owner, so foreign access there is judged like any other managed path.
    $standalone = Test-DefenseClawStandaloneProfile
    $advisory = [bool]$AdvisoryUntrustedAccess -and
        -not (Test-DefenseClawTrustStrictAncestors) -and
        -not $standalone
    Assert-DefenseClawNoReparsePath -Path $Path
    $verdictArgs = @{
        Path                   = $Path
        AllowedWriterSIDs      = $AllowedWriterSIDs
        AllowedReaderSIDs      = $AllowedReaderSIDs
        RequiredRights         = $RequiredRights
        AllowedOwnerSIDs       = $AllowedOwnerSIDs
        AllowUsersRead         = [bool]$AllowUsersRead
        RejectUntrustedRead    = [bool]$RejectUntrustedRead
        AllowInheritance       = [bool]$AllowInheritance
        IgnoreCreatorTemplates = [bool]$IgnoreCreatorTemplates
    }
    $verdicts = @(Get-DefenseClawPathAclVerdicts @verdictArgs)
    $selfHealed = $false
    if (-not [string]::IsNullOrWhiteSpace($SelfHealKind)) {
        # Secure Client: every non-advisory verdict is repairable through the
        # canonical re-stamp: the descriptor built by
        # New-DefenseClawCanonicalPathAcl names only the trusted principals,
        # and Set-DefenseClawPathAcl writes it protected with the trusted
        # owner under backup and restore privileges, so foreign entries,
        # inheritance and a foreign owner are all replaced in one write.
        # Standalone keeps the rel-1-0-3 main-sync review finding 4 contract:
        # a re-stamp repairs Contract and Rights verdicts (and a deny entry)
        # only, so a foreign writer or a lost protected flag stays fatal.
        # A file whose owner is an untrusted account, or that has no DACL,
        # is not given a trusted descriptor back in place either: that owner
        # (or anyone) may have changed its bytes, so it stays fatal and is
        # restored from its approved source or refused and named (GAP-0603).
        # Setup's own account may own a file it just created: that owner is
        # still repaired.
        $repairableKinds = if ($standalone) {
            @('Contract', 'Rights', 'Advisory')
        }
        else {
            @('Contract', 'Rights', 'Access')
        }
        # A Contract verdict without a Severity (none is read from disk without
        # one) counts as untrusted on standalone too.
        $untrustedContract = @()
        if ($standalone) {
            $untrustedContract = @('Dacl', '')
            $currentOwner = Get-DefenseClawAclOwnerSID -Acl (Microsoft.PowerShell.Security\Get-Acl -LiteralPath $Path)
            if ([string]$currentOwner -cne [string](Get-DefenseClawCurrentProcessUserSID)) {
                $untrustedContract += 'Owner'
            }
        }
        $repairable = @(
            $verdicts |
                Microsoft.PowerShell.Core\Where-Object { $_.Kind -in $repairableKinds } |
                Microsoft.PowerShell.Core\Where-Object {
                    -not ($_.Kind -eq 'Contract' -and (Get-DefenseClawPathAclVerdictSeverity -Verdict $_) -in $untrustedContract)
                } |
                Microsoft.PowerShell.Core\Where-Object {
                    $standalone -or -not $HealOnlyUntrusted -or
                    -not (($_.Kind -eq 'Access' -and $_.Severity -in @('Read', 'Inheritance', 'CreateChild')) -or
                        ($_.Kind -eq 'Rights' -and $_.Severity -eq 'Broad'))
                }
        )
        if ($standalone -and $repairable.Count -gt 0) {
            # The re-stamp writes the owner and the whole DACL, and the
            # verdicts are read again after it. On standalone it therefore
            # runs only when every verdict is one it may repair: an untrusted
            # owner (whose implicit WRITE_DAC can add a deny entry or remove
            # SYSTEM's or the gateway's rights), an untrusted writer, a
            # missing DACL or a lost protected flag beside a repairable
            # verdict used to be re-stamped with it, and the second reading
            # found nothing left, so the file was trusted in place (GAP-0603
            # review M1). The path is refused and named instead.
            $unrepairable = @(
                $verdicts |
                    Microsoft.PowerShell.Core\Where-Object {
                        $_.Kind -notin $repairableKinds -or
                        ($_.Kind -eq 'Contract' -and (Get-DefenseClawPathAclVerdictSeverity -Verdict $_) -in $untrustedContract)
                    }
            )
            if ($unrepairable.Count -gt 0) {
                # The verdict comes last: the result names its account and
                # the icacls fix from it.
                throw ('refusing to re-stamp a managed path in place (DefenseClaw does not give a path another ' +
                    'account owns or could change a trusted access list back: remove that entry, or give the path ' +
                    'back to Administrators, and check it or restore it from its approved source, then run Setup ' +
                    "/ensure again): $([string]$unrepairable[0].Reason)")
            }
        }
        if ($repairable.Count -gt 0) {
            if ([string]::IsNullOrWhiteSpace($SelfHealGatewayServiceSID)) {
                throw "-SelfHealKind requires -SelfHealGatewayServiceSID: $Path"
            }
            $selfHealed = $true
            Write-DefenseClawAclSelfHealAdvisory `
                -Path $Path `
                -Reason (
                    're-stamping the canonical {0} ACL after: {1}' -f
                    $SelfHealKind, $repairable[0].Reason
                )
            Write-DefenseClawResilienceEvent -Marker defenseclaw_repair -Fields @{
                path   = $Path
                kind   = $SelfHealKind
                reason = [string]$repairable[0].Reason
            }
            try {
                Set-DefenseClawPathAcl `
                    -Path $Path `
                    -Kind $SelfHealKind `
                    -GatewayServiceSID $SelfHealGatewayServiceSID
            }
            catch {
                # AVC can win the race again while we re-stamp. Whether that
                # actually left us non-compliant is decided by the re-read
                # below, not by the failure to write.
                Write-DefenseClawAclSelfHealAdvisory `
                    -Path $Path `
                    -Reason "canonical ACL re-stamp did not hold: $($_.Exception.Message)"
            }
            $verdicts = @(Get-DefenseClawPathAclVerdicts @verdictArgs)
        }
    }
    # Under the strict pin the historical verdict table applies: only Read
    # access downgrades without a repair, and a Rights verdict never does.
    # Otherwise, on Secure Client, a verdict is fatal only when it is real
    # write authority for an untrusted principal (or a broken contract) that
    # nobody tried to repair: harmless shapes are accepted and logged, and
    # whatever survives a canonical re-stamp of a DefenseClaw-owned path is
    # accepted and logged so one drifted object never stops the lifecycle.
    # The standalone profile keeps the rel-1-0-3 table: nothing downgrades
    # without -AdvisoryUntrustedAccess, which it never gets.
    #
    # Log every downgraded verdict before throwing, so a fatal one does not cost
    # the surrounding context in a DART, and throw the FIRST fatal verdict in
    # reading order so the message a caller sees names the path and principal.
    $strict = Test-DefenseClawTrustStrictAncestors
    $fatal = $null
    foreach ($verdict in $verdicts) {
        $severity = if ($null -ne $verdict.PSObject.Properties['Severity']) {
            [string]$verdict.Severity
        }
        else {
            ''
        }
        $downgradable = switch ($verdict.Kind) {
            # Standalone: an Access verdict (a foreign SID on a managed path)
            # downgrades only when the caller passed -AdvisoryUntrustedAccess,
            # which the standalone profile never gets, and whatever survives a
            # re-stamp stays fatal (rel-1-0-3 main-sync review finding 4).
            'Access' {
                if ($standalone) {
                    $advisory
                }
                else {
                    $advisory -or $selfHealed -or
                    (-not $strict -and $severity -in @('Read', 'Inheritance', 'CreateChild'))
                }
            }
            'Contract' {
                if ($standalone) {
                    $advisory -and $selfHealed
                }
                else {
                    ($advisory -and $selfHealed) -or (-not $strict -and $selfHealed)
                }
            }
            'Rights' {
                -not $standalone -and -not $strict -and
                ($severity -eq 'Broad' -or $selfHealed)
            }
            # The strict pin keeps refusing any deny entry where rights are
            # required, as it always has; so does the standalone profile.
            'Advisory' { -not $standalone -and -not $strict }
            default { $false }
        }
        if (-not $downgradable) {
            if ($null -eq $fatal) {
                $fatal = [string]$verdict.Reason
            }
            continue
        }
        Write-DefenseClawResilienceEvent -Marker defenseclaw_accept -Fields @{
            path   = $Path
            reason = [string]$verdict.Reason
        }
    }
    if ($null -ne $fatal) {
        throw $fatal
    }
}

# Clears ReadOnly, Hidden and System on one exact regular file, never through a
# reparse point, and returns the attributes it found so a caller can restore
# them. These attributes make ReplaceFile and a ReadWrite open fail with access
# denied that has nothing to do with the ACL.
function Clear-DefenseClawRestrictiveFileAttributes {
    param([Parameter(Mandatory)][string]$Path)
    if (-not (Microsoft.PowerShell.Management\Test-Path -LiteralPath $Path -PathType Leaf)) {
        return $null
    }
    Assert-DefenseClawNoReparsePath -Path $Path
    $attributes = [IO.File]::GetAttributes($Path)
    if (($attributes -band [IO.FileAttributes]::Directory) -ne 0 -or
        (($attributes -band [IO.FileAttributes]::ReparsePoint) -ne 0 -and
            -not (Test-DefenseClawBenignFileReparseTag -Item (
                Microsoft.PowerShell.Management\Get-Item -LiteralPath $Path -Force
            )))) {
        throw "refusing to change attributes of a non-regular managed file: $Path"
    }
    $restrictive = [IO.FileAttributes]::ReadOnly -bor
        [IO.FileAttributes]::Hidden -bor
        [IO.FileAttributes]::System
    if (($attributes -band $restrictive) -ne 0) {
        [IO.File]::SetAttributes(
            $Path,
            [IO.FileAttributes]([int]$attributes -band (-bnot [int]$restrictive))
        )
        Write-DefenseClawResilienceEvent -Marker defenseclaw_repair -Fields @{
            path   = $Path
            reason = "cleared file attributes $($attributes -band $restrictive)"
        }
    }
    return $attributes
}

function New-DefenseClawDirectory {
    param([Parameter(Mandatory)][string]$Path)
    Assert-DefenseClawNoReparsePath -Path $Path -AllowMissingLeaf
    if (Microsoft.PowerShell.Management\Test-Path -LiteralPath $Path) {
        if (-not (Microsoft.PowerShell.Management\Test-Path -LiteralPath $Path -PathType Container)) {
            throw "managed directory path is occupied by a non-directory: $Path"
        }
        return
    }
    [void](Microsoft.PowerShell.Management\New-Item -ItemType Directory -Path $Path -Force)
    Assert-DefenseClawNoReparsePath -Path $Path
}

# Runs one file operation and retries it with a bounded backoff while another
# process holds the file (sharing or lock violation): an antivirus scan, a
# backup agent, or a service that is still releasing a binary. Access denied
# and not found are not transient and are thrown at once, unless the caller
# names more Win32 codes in -ExtraTransientCodes (ReplaceFile over a binary
# whose process is still exiting reports 5 or 1175 for a moment).
function Invoke-DefenseClawTransientFileRetry {
    param(
        [Parameter(Mandatory)][string]$Path,
        [Parameter(Mandatory)][scriptblock]$Action,
        [ValidateRange(1, 20)][int]$Attempts = 8,
        [int[]]$ExtraTransientCodes = @()
    )
    $transientCodes = @(@(32, 33) + @($ExtraTransientCodes))
    for ($attempt = 1; ; $attempt++) {
        try {
            return (& $Action)
        }
        catch [UnauthorizedAccessException] {
            if (5 -notin $transientCodes -or $attempt -ge $Attempts) {
                throw
            }
            Microsoft.PowerShell.Utility\Write-Verbose (
                'retrying a file operation on {0} denied while its holder exits (attempt {1} of {2})' -f
                $Path, $attempt, $Attempts
            )
            Microsoft.PowerShell.Utility\Start-Sleep -Milliseconds ([Math]::Min(2000, 150 * $attempt * $attempt))
        }
        catch [IO.IOException] {
            # A .NET method call arrives wrapped in MethodInvocationException;
            # the Win32 code is on the IOException inside it.
            $ioError = $_.Exception
            for ($depth = 0; $depth -lt 8 -and $null -ne $ioError -and
                $ioError -isnot [IO.IOException]; $depth++) {
                $ioError = $ioError.InnerException
            }
            if ($null -eq $ioError) {
                $ioError = $_.Exception
            }
            $code = [int]($ioError.HResult -band 0xffff)
            if ($code -notin $transientCodes -or $attempt -ge $Attempts) {
                throw
            }
            Microsoft.PowerShell.Utility\Write-Verbose (
                'retrying a file operation on {0} held by another process (attempt {1} of {2})' -f
                $Path, $attempt, $Attempts
            )
            Microsoft.PowerShell.Utility\Start-Sleep -Milliseconds ([Math]::Min(2000, 150 * $attempt * $attempt))
        }
    }
}

function Install-DefenseClawFileAtomic {
    param(
        [Parameter(Mandatory)][string]$Source,
        [Parameter(Mandatory)][string]$Destination,
        [string]$ExpectedSHA256,
        [switch]$SkipIfContentMatches
    )
    Assert-DefenseClawNoReparsePath -Path $Source
    Assert-DefenseClawNoReparsePath -Path $Destination -AllowMissingLeaf
    [void]@(Remove-DefenseClawStaleReplacementBackups -Destination $Destination)
    # GAP-0656 review M2 (the g582 trust class): standalone keeps only an
    # object Setup could have made. A file with a second name, a foreign
    # owner or writer, or a handle open for writing (every hook start then
    # fails with a sharing violation, and the agent runs the call unchecked)
    # is replaced by a fresh object whatever its bytes, and never re-stamped
    # in place. The check runs before the hashes: a writer handle refuses the
    # read Get-FileHash makes. The fresh object does not take over the old
    # object's access list. Secure Client is unchanged.
    $keepReplacementAccess = $false
    if ($SkipIfContentMatches -and [IO.File]::Exists($Destination) -and
        (Test-DefenseClawStandaloneProfile)) {
        $drift = Get-DefenseClawKeptFileDrift -Path $Destination
        if (-not [string]::IsNullOrEmpty($drift)) {
            Write-DefenseClawLifecyclePhase -Stage (
                "notice: $Destination is not kept: $drift; " +
                'replacing it with a fresh copy (GAP-0656)')
            $keepReplacementAccess = $true
            $SkipIfContentMatches = $false
        }
    }
    if ($SkipIfContentMatches -and [IO.File]::Exists($Destination)) {
        $sourceItem = Microsoft.PowerShell.Management\Get-Item `
            -LiteralPath $Source `
            -Force
        $destinationItem = Microsoft.PowerShell.Management\Get-Item `
            -LiteralPath $Destination `
            -Force
        if ([int64]$sourceItem.Length -eq [int64]$destinationItem.Length) {
            $sourceHash = (
                Microsoft.PowerShell.Utility\Get-FileHash `
                    -LiteralPath $Source `
                    -Algorithm SHA256
            ).Hash
            if (-not [string]::IsNullOrWhiteSpace($ExpectedSHA256) -and
                -not [string]::Equals(
                    $sourceHash,
                    $ExpectedSHA256,
                    [StringComparison]::OrdinalIgnoreCase
                )) {
                throw "source changed while checking managed artifact: $Source"
            }
            $destinationHash = (
                Microsoft.PowerShell.Utility\Get-FileHash `
                    -LiteralPath $Destination `
                    -Algorithm SHA256
            ).Hash
            if ([string]::Equals(
                $sourceHash,
                $destinationHash,
                [StringComparison]::OrdinalIgnoreCase
            )) {
                return
            }
        }
    }
    New-DefenseClawDirectory -Path ([IO.Path]::GetDirectoryName($Destination))
    $temporary = "$Destination.new.$([Guid]::NewGuid().ToString('N'))"
    $backup = ''
    try {
        Microsoft.PowerShell.Management\Copy-Item -LiteralPath $Source -Destination $temporary -Force
        Assert-DefenseClawNoReparsePath -Path $temporary
        $copiedHash = (
            Microsoft.PowerShell.Utility\Get-FileHash `
                -LiteralPath $temporary `
                -Algorithm SHA256
        ).Hash
        if (-not [string]::IsNullOrWhiteSpace($ExpectedSHA256)) {
            if (-not [string]::Equals(
                $copiedHash,
                $ExpectedSHA256,
                [StringComparison]::OrdinalIgnoreCase
            )) {
                throw "source changed while staging managed artifact: $Source"
            }
        }
        if ([IO.File]::Exists($Destination)) {
            # Standalone swaps the file in one step and keeps the prior file
            # as a second name, the backup (GAP-0240). Secure Client, and a
            # standalone volume that refuses that swap, use File.Replace
            # (Move-Item -Force does not reliably replace an existing file on
            # Windows PowerShell 5.1), which needs a non-empty backup path on
            # both .NET Framework and modern .NET. Either way the prior file
            # stays beside the protected destination until the replacement
            # hash is verified; then only that unique backup is retired.
            $backup = "$Destination.backup.$([Guid]::NewGuid().ToString('N'))"
            Assert-DefenseClawNoReparsePath -Path $backup -AllowMissingLeaf
            if (Microsoft.PowerShell.Management\Test-Path -LiteralPath $backup) {
                throw "atomic replacement backup path unexpectedly exists: $backup"
            }
            # ReplaceFile refuses a ReadOnly, Hidden or System destination
            # with access denied. Clear them on the exact no-follow leaf; the
            # new file carries its own attributes.
            [void](Clear-DefenseClawRestrictiveFileAttributes -Path $Destination)
            try {
                # GAP-0240: standalone swaps the file in one step, so an agent
                # starting the hook during Setup finds the old or the new
                # program, never none and never one held for writing.
                $swapped = $false
                if (Test-DefenseClawStandaloneProfile) {
                    $swapped = Invoke-DefenseClawLaunchableFileSwap `
                        -Temporary $temporary `
                        -Destination $Destination `
                        -Backup $backup `
                        -KeepReplacementAccess:$keepReplacementAccess
                }
                $replacementClock = [Diagnostics.Stopwatch]::StartNew()
                while (-not $swapped) {
                    try {
                        # ReplaceFile also answers 5 and 1175 while a scanner
                        # or a running image briefly holds the destination.
                        Invoke-DefenseClawTransientFileRetry `
                            -Path $Destination `
                            -ExtraTransientCodes @(5, 1175) `
                            -Action {
                                [IO.File]::Replace($temporary, $Destination, $backup, $true)
                            }
                        break
                    }
                    catch {
                        $failure = $_.Exception
                        while ($null -ne $failure.InnerException) { $failure = $failure.InnerException }
                        $transient = [int]$failure.HResult -in @(-2147024891, -2147024864, -2147024863, -2147023721)
                        if (-not (Test-DefenseClawStandaloneProfile) -or -not $transient -or
                            $replacementClock.Elapsed.TotalSeconds -ge 30 -or
                            -not [IO.File]::Exists($temporary) -or -not [IO.File]::Exists($Destination) -or
                            [IO.File]::Exists($backup)) {
                            throw
                        }
                        # Active hook readers briefly deny delete sharing.
                        # Retry the atomic operation only while both original
                        # names remain intact. Never rename the launcher away:
                        # agents can treat a missing hook as a non-blocking error.
                        Microsoft.PowerShell.Utility\Start-Sleep -Milliseconds 10
                    }
                }
            }
            catch {
                # GAP-0852: a program that holds the file open without delete
                # sharing (an antivirus scan, an editor) failed the upgrade
                # with a raw sharing violation. Name the file and the retry.
                $replaceFailure = $_.Exception
                while ($replaceFailure -is [Management.Automation.MethodInvocationException] -and
                    $null -ne $replaceFailure.InnerException) {
                    $replaceFailure = $replaceFailure.InnerException
                }
                if (-not (Test-DefenseClawStandaloneProfile) -or
                    -not ($replaceFailure -is [IO.IOException] -or
                        $replaceFailure -is [UnauthorizedAccessException])) {
                    throw
                }
                throw (
                    "another program holds $Destination open, so Setup could not replace it (" +
                    (ConvertTo-DefenseClawBoundedDiagnostic -Value $replaceFailure.Message -MaxLength 256) +
                    '). Close the program that has the file open (for example an antivirus scan or an editor), then ' +
                    (Format-DefenseClawRerunStep)
                )
            }
        }
        else {
            [IO.File]::Move($temporary, $Destination)
        }
        Assert-DefenseClawNoReparsePath -Path $Destination
        $installedHash = (
            Microsoft.PowerShell.Utility\Get-FileHash `
                -LiteralPath $Destination `
                -Algorithm SHA256
        ).Hash
        if (-not [string]::Equals(
            $installedHash,
            $copiedHash,
            [StringComparison]::OrdinalIgnoreCase
        )) {
            throw "atomic replacement verification failed: $Destination"
        }
        if (-not [string]::IsNullOrWhiteSpace($backup)) {
            Assert-DefenseClawNoReparsePath -Path $backup
            if (Test-DefenseClawStandaloneProfile) {
                [void](Remove-DefenseClawReplacementBackup -Path $backup)
            }
            else {
                try {
                    Microsoft.PowerShell.Management\Remove-Item `
                        -LiteralPath $backup `
                        -Force `
                        -ErrorAction Stop
                }
                catch {
                    # The replaced file is still a running image (an upgrade over
                    # a live deployment): it can be renamed but not deleted until
                    # its process exits. The new file is verified in place, so the
                    # old copy is queued for deletion at the next restart.
                    $deleteError = $_.Exception.Message
                    $scheduled = $false
                    try {
                        $nativeSecurity = Initialize-DefenseClawNativeSecurity
                        $scheduled = [bool]$nativeSecurity::ScheduleDeleteOnRestart($backup)
                    }
                    catch {
                        $scheduled = $false
                    }
                    $acceptReason = 'replaced file is still in use; queued for deletion at the next restart'
                    if (-not $scheduled) {
                        $acceptReason = 'replaced file is still in use and could not be queued for deletion; left beside the destination'
                    }
                    Write-DefenseClawResilienceEvent -Marker defenseclaw_accept -Fields @{
                        path   = $backup
                        reason = "${acceptReason}: $deleteError"
                    }
                }
            }
            $backup = ''
        }
    }
    finally {
        if (Microsoft.PowerShell.Management\Test-Path -LiteralPath $temporary) {
            Microsoft.PowerShell.Management\Remove-Item -LiteralPath $temporary -Force
        }
        # A replacement that failed after File.Replace leaves its backup. The
        # transaction snapshot restores the file, so the backup goes too,
        # unless it is the only copy left (the destination is missing).
        if ((Test-DefenseClawStandaloneProfile) -and
            -not [string]::IsNullOrWhiteSpace($backup) -and
            [IO.File]::Exists($Destination)) {
            try {
                [void](Remove-DefenseClawReplacementBackup -Path $backup)
            }
            catch {
                Microsoft.PowerShell.Utility\Write-Verbose "replacement backup stays: $backup"
            }
        }
    }
}

function Get-DefenseClawKeptFileDrift {
    <#
        GAP-0656 review M2 (the g582 trust class): Install-DefenseClawFileAtomic
        -SkipIfContentMatches keeps a standalone file that already has the
        replacement's bytes only when its object is one Setup could have made:
        exactly one name, an owner among SYSTEM, Administrators,
        TrustedInstaller and the account Setup runs as, every writer among
        SYSTEM, Administrators and TrustedInstaller (the account Setup runs
        as is an owner only, as in Assert-DefenseClawStandaloneContentTrusted;
        review L4), and no handle open for writing (an open for reading that shares only read and
        delete, as a program start opens the file, succeeds). Returns '' for
        such a file, otherwise what is wrong with it (NativeSecurity
        GetKeptFileDrift). A file that cannot be inspected counts as drifted:
        replacing a file is always safe, keeping a drifted one is not.
    #>
    param([Parameter(Mandatory)][string]$Path)
    $native = Initialize-DefenseClawNativeSecurity
    $writers = [string[]]@(
        $script:SystemSID,
        $script:AdministratorsSID,
        $script:TrustedInstallerSID
    )
    $owners = [string[]]@(
        $writers
        [string][Security.Principal.WindowsIdentity]::GetCurrent().User.Value
    )
    try {
        return [string]$native::GetKeptFileDrift($Path, $owners, $writers)
    }
    catch {
        $failure = $_.Exception
        while ($null -ne $failure.InnerException) {
            $failure = $failure.InnerException
        }
        $message = [string]$failure.Message
        if ($message.Length -gt 200) {
            $message = $message.Substring(0, 200)
        }
        return "it cannot be inspected ($message)"
    }
}

function Invoke-DefenseClawLaunchableFileSwap {
    <#
        GAP-0240: puts Temporary at Destination with the native
        SwapLaunchableFile: the access list of Destination, a Backup name
        linked to the old file, then one POSIX-semantics rename. An agent
        that starts Destination meanwhile starts the old program or the new
        one. File.Replace instead held the new file open for writing and had
        a moment with no file at the name, and a hook call that could not
        start ran its tool call with no DefenseClaw decision (4 of 12
        restart-required ensures on 1.0.7 b3547e66a9). Returns $true once
        the new file is in place. Returns $false, with nothing changed, when
        the volume or a filter driver refuses hard links or the POSIX rename;
        the caller then uses File.Replace as before, and the lifecycle log
        names the file and the refusal (GAP-0369: that host keeps the
        pre-1.0.7 window). A sharing or access refusal (an antivirus scan
        holding the file without delete sharing) is retried for 30 s and then
        thrown as an IOException. A backup link the swap could not remove is
        thrown as an InvalidOperationException, so the caller does not report
        it as a file another program holds open.
    #>
    param(
        [Parameter(Mandatory)][string]$Temporary,
        [Parameter(Mandatory)][string]$Destination,
        [Parameter(Mandatory)][string]$Backup,
        # GAP-0656 review M2: Destination's own object is not trusted; the
        # new file keeps the access list it was created with instead.
        [switch]$KeepReplacementAccess
    )
    $native = Initialize-DefenseClawNativeSecurity
    $clock = [Diagnostics.Stopwatch]::StartNew()
    while ($true) {
        $result = if ($KeepReplacementAccess) {
            [string]$native::SwapLaunchableFileKeepingAccess($Temporary, $Destination, $Backup)
        }
        else {
            [string]$native::SwapLaunchableFile($Temporary, $Destination, $Backup)
        }
        if ($result -ceq '') {
            return $true
        }
        if ($result.EndsWith(';backup-kept')) {
            throw [InvalidOperationException]::new("the replacement of $Destination failed ($result) and its backup name $Backup could not be removed; the next Setup run removes it")
        }
        $stage, $code = $result.Split(':', 2)
        $refused = ($result -ceq 'dacl:null') -or
            ($stage -ceq 'link' -and $code -in @('1', '17', '50', '1142')) -or
            ($stage -ceq 'rename' -and $code -in @('1', '50', '87'))
        if ($refused) {
            # "notice: " keeps the line in the lifecycle log wherever it
            # falls in the run (windowsEnterpriseNoticePhase).
            Write-DefenseClawLifecyclePhase -Stage (
                "notice: one-step swap refused for $Destination ($result); replacing it with File.Replace, " +
                'so an agent starting it in that moment can get an error (GAP-0369)')
            return $false
        }
        $transient = $code -in @('5', '32', '33')
        if (-not $transient -or $clock.Elapsed.TotalSeconds -ge 30) {
            $message = ([ComponentModel.Win32Exception]::new([int]$code)).Message
            throw [IO.IOException]::new("$message ($result)")
        }
        Microsoft.PowerShell.Utility\Start-Sleep -Milliseconds 10
    }
}

# Install-DefenseClawFileAtomic keeps the file it replaces as
# <Destination>.backup.<32 hex> until the new bytes are verified. Windows
# lets a running program's file be renamed but not deleted, so the backup of
# a defenseclaw-acp.exe that an editor's ACP thread still runs could not be
# removed, the upgrade failed with Access to the path is denied and rolled
# back, and the backup stayed in bin (GAP-0743), where the next uninstall
# refused it as unexpected content (GAP-0772). Standalone now deletes such a
# backup at the next restart instead, and every later replacement of the
# file and every uninstall removes what an earlier run left. Secure Client
# also queues an undeletable backup for the next restart and logs
# defenseclaw_accept.
function Test-DefenseClawReplacementBackupName {
    param(
        [Parameter(Mandatory)][string]$Name,
        [Parameter(Mandatory)][string]$Leaf
    )
    $prefix = $Leaf + '.backup.'
    if (-not $Name.StartsWith($prefix, [StringComparison]::OrdinalIgnoreCase)) {
        return $false
    }
    return ($Name.Substring($prefix.Length) -cmatch '^[0-9a-f]{32}$')
}

function Test-DefenseClawReplacementStagingName {
    # Install-DefenseClawFileAtomic copies the new file to
    # <leaf>.new.<32 hex> before it swaps it in; a run killed between the
    # copy and the swap leaves that copy (GAP-1902).
    param(
        [Parameter(Mandatory)][string]$Name,
        [Parameter(Mandatory)][string]$Leaf
    )
    $prefix = $Leaf + '.new.'
    if (-not $Name.StartsWith($prefix, [StringComparison]::OrdinalIgnoreCase)) {
        return $false
    }
    return ($Name.Substring($prefix.Length) -cmatch '^[0-9a-f]{32}$')
}

function Remove-DefenseClawReplacementBackup {
    # Returns $true once the backup is gone and $false when a running
    # program still uses it; Windows then deletes it at the next restart.
    param([Parameter(Mandatory)][string]$Path)
    Assert-DefenseClawNoReparsePath -Path $Path -AllowMissingLeaf
    if (-not [IO.File]::Exists($Path)) {
        return $true
    }
    try {
        [IO.File]::Delete($Path)
        return $true
    }
    catch [UnauthorizedAccessException], [IO.IOException] {
        Request-DefenseClawDeleteAtRestart -Path $Path
        return $false
    }
}

function Request-DefenseClawDeleteAtRestart {
    param([Parameter(Mandatory)][string]$Path)
    $nativeSecurityType = Initialize-DefenseClawNativeSecurity
    $nativeSecurityType::DeleteFileAtRestart($Path)
}

# GAP-1446: the hook guardian restores the hook binary through a temporary
# sibling, <hook>.restore-<16 hex> (copyWindowsManagedFile), and renames it
# into place. A guardian stopped between the write and the rename (a 1.0.3
# guardian that met the replacement hook of an upgrade's early publish) leaves
# that sibling in bin, and the next uninstall refused it as unexpected
# content. It is DefenseClaw's own residue: every replacement of the file and
# every uninstall removes it like a replacement backup. Only a plain file with
# exactly that name is removed; nothing reads or runs it.
function Test-DefenseClawGuardianRestoreTemporaryName {
    param(
        [Parameter(Mandatory)][string]$Name,
        [Parameter(Mandatory)][string]$Leaf
    )
    $prefix = $Leaf + '.restore-'
    if (-not $Name.StartsWith($prefix, [StringComparison]::OrdinalIgnoreCase)) {
        return $false
    }
    return ($Name.Substring($prefix.Length) -cmatch '^[0-9a-f]{16}$')
}

function Remove-DefenseClawStaleReplacementBackups {
    # Standalone: removes the replacement backups, staging copies and
    # guardian restore temporaries of Destination that an earlier run left,
    # and writes each one a running program still uses.
    param([Parameter(Mandatory)][string]$Destination)
    if (-not (Test-DefenseClawStandaloneProfile)) {
        return
    }
    $directory = [IO.Path]::GetDirectoryName($Destination)
    $leaf = [IO.Path]::GetFileName($Destination)
    if ([string]::IsNullOrWhiteSpace($leaf) -or -not [IO.Directory]::Exists($directory)) {
        return
    }
    foreach ($item in @(Microsoft.PowerShell.Management\Get-ChildItem `
            -LiteralPath $directory `
            -Force `
            -File `
            -Filter ($leaf + '.backup.*'))) {
        if (-not (Test-DefenseClawReplacementBackupName -Name ([string]$item.Name) -Leaf $leaf) -or
            ($item.Attributes -band [IO.FileAttributes]::ReparsePoint) -ne 0) {
            continue
        }
        if (-not (Remove-DefenseClawReplacementBackup -Path ([string]$item.FullName))) {
            [string]$item.FullName
        }
    }
    foreach ($item in @(Microsoft.PowerShell.Management\Get-ChildItem `
            -LiteralPath $directory `
            -Force `
            -File `
            -Filter ($leaf + '.new.*'))) {
        if (-not (Test-DefenseClawReplacementStagingName -Name ([string]$item.Name) -Leaf $leaf) -or
            ($item.Attributes -band [IO.FileAttributes]::ReparsePoint) -ne 0) {
            continue
        }
        if (-not (Remove-DefenseClawReplacementBackup -Path ([string]$item.FullName))) {
            [string]$item.FullName
        }
    }
    foreach ($item in @(Microsoft.PowerShell.Management\Get-ChildItem `
            -LiteralPath $directory `
            -Force `
            -File `
            -Filter ($leaf + '.restore-*'))) {
        if (-not (Test-DefenseClawGuardianRestoreTemporaryName -Name ([string]$item.Name) -Leaf $leaf) -or
            ($item.Attributes -band [IO.FileAttributes]::ReparsePoint) -ne 0) {
            continue
        }
        if (-not (Remove-DefenseClawReplacementBackup -Path ([string]$item.FullName))) {
            [string]$item.FullName
        }
    }
}

function Remove-DefenseClawStandaloneInstallTreeReplacementBackups {
    # Uninstall removes the replacement backups an earlier upgrade left
    # beside the installed files after checking for outside file holders.
    # One a running program still uses keeps the folder, so the uninstall
    # says which and what to do.
    param([Parameter(Mandatory)][hashtable]$Layout)
    if (-not (Test-DefenseClawStandaloneProfile)) {
        return
    }
    $kept = [Collections.Generic.List[string]]::new()
    $files = @(
        $Layout.BrokerPath,
        $Layout.GatewayPath,
        $Layout.ACPPath,
        $Layout.HookPath,
        $Layout.SensorHelperPath,
        $Layout.CLIPath,
        (Get-DefenseClawOptionalLayoutValue -Layout $Layout -Name CompilerPath),
        $Layout.InstallerPath,
        $Layout.ModulePath
    )
    $openCodePlugin = Get-DefenseClawStandaloneOpenCodePluginPaths -Layout $Layout
    if ($null -ne $openCodePlugin) {
        $files += [string]$openCodePlugin.PluginPath
        $files += [string]$openCodePlugin.LegacyPluginPath
    }
    foreach ($path in $files) {
        if ([string]::IsNullOrWhiteSpace([string]$path)) {
            continue
        }
        foreach ($left in @(Remove-DefenseClawStaleReplacementBackups -Destination ([IO.Path]::GetFullPath([string]$path)))) {
            $kept.Add([string]$left)
        }
    }
    if ($kept.Count -gt 0) {
        throw (
            'a program started before the last DefenseClaw upgrade still runs the earlier copy kept beside ' +
            'the installed file, so the install folder cannot be removed yet: ' + ($kept -join ', ') +
            '. Close the programs that use it (for example an editor thread that uses DefenseClaw ACP) or ' +
            'restart the computer, which deletes the copy, then run the uninstall again'
        )
    }
}

# How long the in-use check waits before it looks again, so a hook call that
# was running at the first look does not block the uninstall.
$script:InstallTreeUseRecheckMilliseconds = 2000

function Get-DefenseClawProcessImages {
    # Every process this token can see, with its executable, account and
    # parent process name where Windows reports them.
    $parents = @{}
    try {
        foreach ($entry in @(CimCmdlets\Get-CimInstance -ClassName Win32_Process -ErrorAction Stop)) {
            $parents[[int]$entry.ProcessId] = [int]$entry.ParentProcessId
        }
    }
    catch {
    }
    $processes = try {
        @(Microsoft.PowerShell.Management\Get-Process -IncludeUserName -ErrorAction Stop)
    }
    catch {
        @(Microsoft.PowerShell.Management\Get-Process -ErrorAction SilentlyContinue)
    }
    $names = @{}
    foreach ($process in $processes) {
        $names[[int]$process.Id] = [string]$process.ProcessName
    }
    foreach ($process in $processes) {
        $path = try { [string]$process.Path } catch { '' }
        $account = ''
        if ($null -ne $process.PSObject.Properties['UserName']) {
            $account = [string]$process.UserName
        }
        $parent = ''
        if ($parents.ContainsKey([int]$process.Id) -and $names.ContainsKey($parents[[int]$process.Id])) {
            $parent = [string]$names[$parents[[int]$process.Id]]
        }
        [pscustomobject]@{ Id = [int]$process.Id; Path = $path; UserName = $account; Parent = $parent }
    }
}

function Get-DefenseClawUninstallOwnProcessIds {
    <#
        The processes an uninstall in-use check does not count: this
        lifecycle, the installed CLI that asked for its own removal and the
        running DefenseClaw services, which the uninstall stops itself.
    #>
    param(
        [Parameter(Mandatory)][string]$GatewayServiceName,
        [Parameter(Mandatory)][string]$GuardianServiceName,
        [int]$SelfUninstallCallerPID
    )
    $excluded = [Collections.Generic.HashSet[int]]::new()
    [void]$excluded.Add([int]$PID)
    if ($SelfUninstallCallerPID -gt 0) {
        [void]$excluded.Add([int]$SelfUninstallCallerPID)
    }
    foreach ($name in @(Get-DefenseClawManagedServiceNames `
                -GatewayServiceName $GatewayServiceName `
                -GuardianServiceName $GuardianServiceName)) {
        try {
            if (Test-DefenseClawServiceExists -Name $name) {
                [void]$excluded.Add([int](Get-DefenseClawServiceProcessId -Name $name))
            }
        }
        catch {
        }
    }
    return , $excluded
}

function Format-DefenseClawProcessInUse {
    # "name (pid N, account A, started by P)": the Intune launcher reads the
    # pid of each program an uninstall_in_use refusal names.
    param(
        [Parameter(Mandatory)][string]$Name,
        [Parameter(Mandatory)][int]$Id,
        [string]$UserName,
        [string]$Parent
    )
    # A holder with no process id (GAP-0878) is named without one; the Intune
    # launcher then has no pid to wait for.
    if ($Id -le 0) {
        return $Name
    }
    $text = '{0} (pid {1}' -f $Name, $Id
    if (-not [string]::IsNullOrEmpty($UserName)) {
        $text += ', account ' + $UserName
    }
    if (-not [string]::IsNullOrEmpty($Parent)) {
        $text += ', started by ' + $Parent
    }
    return $text + ')'
}

# A purge deletes every file under StateRoot, and a handle another program
# opened without delete sharing (a SIEM forwarder or a log tail reading
# runtime\audit.db) makes that deletion fail. The data-file check asks about
# at most this many files, the audit database first, and names the file a
# holder has open by asking about at most the second number one at a time.
$script:StateFileInUseCheckLimit = 16384
$script:StateFileInUseNameLimit = 256
# GAP-0878: said about a holder this account cannot name (it has no process
# id): a SYSTEM process holds a SYSTEM-only file, and no tool of this account
# lists its handles by process.
$script:UnnamedFileHolderHint = 'it is probably running as SYSTEM, which this account cannot query; to find it, open Resource Monitor (resmon.exe), CPU tab, Associated Handles, and search for the file name'

function Test-DefenseClawUnnamedFileHolder {
    # GAP-0878: a holder of a file this account cannot query has no process
    # id, so the process and service exclusions below do not apply to it.
    param([Parameter(Mandatory)]$Holder)
    $property = $Holder.PSObject.Properties['Unnamed']
    return ($null -ne $property -and [bool]$property.Value)
}

function Get-DefenseClawFileHolderKey {
    # The process id and start time (a reused id is another program), or one
    # key for the holders with no process id.
    param([Parameter(Mandatory)]$Holder)
    if (Test-DefenseClawUnnamedFileHolder -Holder $Holder) {
        return 'unnamed'
    }
    return ('{0}/{1}' -f [int]$Holder.ProcessId, [int64]$Holder.StartFileTime)
}

function Get-DefenseClawStateRootFiles {
    <#
        The regular files under StateRoot that a purge deletes: the audit
        database and its SQLite companions first, then the rest of the tree
        without following links (the removal refuses those itself).
    #>
    param([Parameter(Mandatory)][hashtable]$Layout)
    $files = [Collections.Generic.List[string]]::new()
    $root = [IO.Path]::GetFullPath([string]$Layout.StateRoot).TrimEnd('\')
    if (-not [IO.Directory]::Exists($root)) {
        return , $files.ToArray()
    }
    $first = [Collections.Generic.HashSet[string]]::new([StringComparer]::OrdinalIgnoreCase)
    $audit = [IO.Path]::Combine([string]$Layout.RuntimeDirectory, 'audit.db')
    foreach ($suffix in @('', '-wal', '-shm', '-journal')) {
        $candidate = [IO.Path]::GetFullPath($audit + $suffix)
        if ([IO.File]::Exists($candidate)) {
            $files.Add($candidate)
            [void]$first.Add($candidate)
        }
    }
    $pending = [Collections.Generic.Stack[string]]::new()
    $pending.Push($root)
    while ($pending.Count -gt 0 -and $files.Count -lt $script:StateFileInUseCheckLimit) {
        $directory = $pending.Pop()
        $entries = @(try {
                [IO.DirectoryInfo]::new($directory).GetFileSystemInfos()
            }
            catch {
            })
        foreach ($entry in $entries) {
            if (($entry.Attributes -band [IO.FileAttributes]::ReparsePoint) -ne 0) {
                continue
            }
            if ($entry -is [IO.DirectoryInfo]) {
                $pending.Push([string]$entry.FullName)
                continue
            }
            if ($first.Contains([string]$entry.FullName)) {
                continue
            }
            $files.Add([string]$entry.FullName)
            if ($files.Count -ge $script:StateFileInUseCheckLimit) {
                break
            }
        }
    }
    return , $files.ToArray()
}

function Get-DefenseClawStateFileHolders {
    <#
        The programs Restart Manager reports with one of Paths open, keyed
        by process id and start time (a reused id is another program),
        without the processes in Excluded, the services in ServiceNames and
        programs run from the install folder, which the install-folder check
        names. Restart Manager itself failing returns no holder, so the
        deletion after the services stopped retries and names what still
        holds the file; with FailOnQueryError it refuses instead, for the
        preflight that must not let the purge start blind (GAP-0136).
    #>
    param(
        [Parameter(Mandatory)][hashtable]$Layout,
        [Parameter(Mandatory)][AllowEmptyCollection()][string[]]$Paths,
        [Parameter(Mandatory)]$Excluded,
        [AllowEmptyCollection()][string[]]$ServiceNames = @(),
        [switch]$FailOnQueryError
    )
    $holders = @{}
    if ($Paths.Count -eq 0) {
        return $holders
    }
    $native = Initialize-DefenseClawNativeSecurity
    $found = @(try {
            $native::GetFileHolders($Paths) | Microsoft.PowerShell.Core\Where-Object {
                (Test-DefenseClawUnnamedFileHolder -Holder $_) -or (
                    -not $Excluded.Contains([int]$_.ProcessId) -and
                    -not ($ServiceNames -contains [string]$_.ServiceName))
            }
        }
        catch {
            if ($FailOnQueryError) {
                throw (
                    'uninstall_in_use: Restart Manager could not list the programs that hold DefenseClaw data files (' +
                    $_.Exception.Message + '); nothing was changed; run the uninstall again'
                )
            }
            Microsoft.PowerShell.Utility\Write-Verbose "Restart Manager could not list the programs that hold DefenseClaw data files: $($_.Exception.Message)"
        })
    if ($found.Count -eq 0) {
        return $holders
    }
    $images = @{}
    foreach ($process in @(Get-DefenseClawProcessImages)) {
        $images[[int]$process.Id] = $process
    }
    $install = [IO.Path]::GetFullPath([string]$Layout.InstallRoot).TrimEnd('\') + '\'
    foreach ($holder in $found) {
        if (Test-DefenseClawUnnamedFileHolder -Holder $holder) {
            $holders['unnamed'] = [pscustomobject]@{
                Id = 0
                Name = [string]$holder.AppName
                UserName = ''
                Parent = ''
                File = ''
            }
            continue
        }
        $id = [int]$holder.ProcessId
        $process = $images[$id]
        # GAP-2265: a holder that is no longer running holds nothing. Under
        # agent load the installed hook's own short-lived processes, which
        # the install-folder rule below does not count, often exited between
        # the Restart Manager query and the process list, were reported
        # unnamed ("a program") or by their description and deferred every
        # upgrade with hook_in_use. The process list holds every running
        # process, a protected one (an antivirus scan) included; an empty
        # list (the query failed) keeps every holder.
        if ($null -eq $process -and $images.Count -gt 0) {
            continue
        }
        $image = ''
        $account = ''
        $parent = ''
        if ($null -ne $process) {
            $image = [string]$process.Path
            $account = [string]$process.UserName
            $parent = [string]$process.Parent
        }
        if (-not [string]::IsNullOrEmpty($image) -and
            ([IO.Path]::GetFullPath($image)).StartsWith($install, [StringComparison]::OrdinalIgnoreCase)) {
            continue
        }
        $name = if (-not [string]::IsNullOrEmpty($image)) {
            [IO.Path]::GetFileName($image)
        }
        elseif (-not [string]::IsNullOrWhiteSpace([string]$holder.AppName)) {
            [string]$holder.AppName
        }
        else {
            'a program'
        }
        $holders[('{0}/{1}' -f $id, [int64]$holder.StartFileTime)] = [pscustomobject]@{
            Id = $id
            Name = $name
            UserName = $account
            Parent = $parent
            File = ''
        }
    }
    return $holders
}

function Get-DefenseClawStateFileHolderText {
    <#
        Names each holder and the file it has open, relative to StateRoot,
        asking Restart Manager about Paths one at a time in their order (the
        audit database first) until each holder has a file or the bound is
        reached.
    #>
    param(
        [Parameter(Mandatory)][hashtable]$Layout,
        [Parameter(Mandatory)][hashtable]$Holders,
        [Parameter(Mandatory)][AllowEmptyCollection()][string[]]$Paths
    )
    $root = [IO.Path]::GetFullPath([string]$Layout.StateRoot).TrimEnd('\') + '\'
    $native = Initialize-DefenseClawNativeSecurity
    $unnamed = $Holders.Count
    $asked = 0
    foreach ($path in $Paths) {
        if ($unnamed -eq 0 -or $asked -ge $script:StateFileInUseNameLimit) {
            break
        }
        $asked++
        $found = @(try { $native::GetFileHolders([string[]]@($path)) } catch { })
        foreach ($holder in $found) {
            $key = Get-DefenseClawFileHolderKey -Holder $holder
            if ($Holders.ContainsKey($key) -and [string]::IsNullOrEmpty([string]$Holders[$key].File)) {
                $Holders[$key].File = if ($path.StartsWith($root, [StringComparison]::OrdinalIgnoreCase)) {
                    $path.Substring($root.Length)
                }
                else {
                    $path
                }
                $unnamed--
            }
        }
    }
    $named = @(foreach ($holder in @($Holders.Values | Microsoft.PowerShell.Utility\Sort-Object -Property Id)) {
            $text = Format-DefenseClawProcessInUse `
                -Name ([string]$holder.Name) `
                -Id ([int]$holder.Id) `
                -UserName ([string]$holder.UserName) `
                -Parent ([string]$holder.Parent)
            $hint = if ([int]$holder.Id -le 0) { ' (' + $script:UnnamedFileHolderHint + ')' } else { '' }
            if ([string]::IsNullOrEmpty([string]$holder.File)) {
                $text + ' has a file open' + $hint
            }
            else {
                $text + ' has ' + [string]$holder.File + ' open' + $hint
            }
        })
    return ($named -join '; ')
}

function Assert-DefenseClawStandaloneStateFilesNotInUse {
    <#
        Standalone purge refuses, before it changes anything, while a program
        other than the DefenseClaw services, this lifecycle and the
        self-uninstall caller has a file under StateRoot open: a read-only
        audit reader held runtime\audit.db, and the purge removed the
        binaries and the Claude Code hook wiring before it failed 1603 on
        that file, leaving the computer half removed (GAP-0136). A holder
        seen only once (an anti-virus scan or a detection script) does not
        block. A Restart Manager query that fails refuses too: the check did
        not run, and the purge must not start without it.
    #>
    param(
        [Parameter(Mandatory)][hashtable]$Layout,
        [Parameter(Mandatory)][string]$GatewayServiceName,
        [Parameter(Mandatory)][string]$GuardianServiceName,
        [int]$SelfUninstallCallerPID
    )
    if (-not (Test-DefenseClawStandaloneProfile)) {
        return
    }
    $paths = Get-DefenseClawStateRootFiles -Layout $Layout
    if ($paths.Count -eq 0) {
        return
    }
    $excluded = Get-DefenseClawUninstallOwnProcessIds `
        -GatewayServiceName $GatewayServiceName `
        -GuardianServiceName $GuardianServiceName `
        -SelfUninstallCallerPID $SelfUninstallCallerPID
    $services = @(Get-DefenseClawManagedServiceNames `
            -GatewayServiceName $GatewayServiceName `
            -GuardianServiceName $GuardianServiceName)
    $first = $null
    foreach ($pass in 1, 2) {
        $seen = Get-DefenseClawStateFileHolders `
            -Layout $Layout `
            -Paths $paths `
            -Excluded $excluded `
            -ServiceNames $services `
            -FailOnQueryError
        if ($null -eq $first) {
            $first = $seen
            if ($first.Count -eq 0) {
                return
            }
            Microsoft.PowerShell.Utility\Start-Sleep -Milliseconds $script:InstallTreeUseRecheckMilliseconds
            continue
        }
        $still = @{}
        foreach ($key in @($first.Keys)) {
            if ($seen.ContainsKey($key)) {
                $still[$key] = $seen[$key]
            }
        }
        if ($still.Count -eq 0) {
            return
        }
        $root = [IO.Path]::GetFullPath([string]$Layout.StateRoot).TrimEnd('\')
        throw (
            'uninstall_in_use: ' + (Get-DefenseClawStateFileHolderText -Layout $Layout -Holders $still -Paths $paths) +
            " in $root, which the purge deletes, so DefenseClaw cannot remove its data; nothing was changed. " +
            'Close it first: stop the program (for example a SIEM forwarder or a log tail that reads runtime\audit.db) ' +
            "or exclude $root from it; then run the uninstall again"
        )
    }
}

function Assert-DefenseClawStandaloneInstallTreeNotInUse {
    <#
        Standalone uninstall refuses, before it changes anything, while a
        program other than the DefenseClaw services and this lifecycle runs
        an executable from the install folder. An editor's DefenseClaw ACP
        thread runs defenseclaw-acp.exe: the uninstall removed all four
        services and then failed 1603 on that file, leaving the computer half
        removed (GAP-0942). A process seen only once (a hook call) does not
        block.
    #>
    param(
        [Parameter(Mandatory)][hashtable]$Layout,
        [Parameter(Mandatory)][string]$GatewayServiceName,
        [Parameter(Mandatory)][string]$GuardianServiceName,
        [int]$SelfUninstallCallerPID
    )
    if (-not (Test-DefenseClawStandaloneProfile)) {
        return
    }
    $bin = [IO.Path]::GetFullPath([string]$Layout.BinDirectory).TrimEnd('\') + '\'
    $excluded = Get-DefenseClawUninstallOwnProcessIds `
        -GatewayServiceName $GatewayServiceName `
        -GuardianServiceName $GuardianServiceName `
        -SelfUninstallCallerPID $SelfUninstallCallerPID
    $users = $null
    foreach ($pass in 1, 2) {
        $seen = @{}
        foreach ($process in @(Get-DefenseClawProcessImages)) {
            if ([string]::IsNullOrEmpty([string]$process.Path) -or
                $excluded.Contains([int]$process.Id) -or
                -not ([IO.Path]::GetFullPath([string]$process.Path)).StartsWith($bin, [StringComparison]::OrdinalIgnoreCase)) {
                continue
            }
            $seen[[int]$process.Id] = $process
        }
        if ($null -eq $users) {
            $users = $seen
            if ($users.Count -eq 0) {
                break
            }
            Microsoft.PowerShell.Utility\Start-Sleep -Milliseconds $script:InstallTreeUseRecheckMilliseconds
            continue
        }
        $still = @($users.Keys | Microsoft.PowerShell.Core\Where-Object { $seen.ContainsKey($_) } | Microsoft.PowerShell.Utility\Sort-Object)
        if ($still.Count -eq 0) {
            break
        }
        $named = @(foreach ($id in $still) {
                $process = $seen[$id]
                Format-DefenseClawProcessInUse `
                    -Name ([IO.Path]::GetFileName([string]$process.Path)) `
                    -Id $id `
                    -UserName ([string]$process.UserName) `
                    -Parent ([string]$process.Parent)
            })
        throw (
            'uninstall_in_use: ' + ($named -join '; ') + " runs from $bin, so DefenseClaw cannot remove its files; nothing was changed. " +
            'Close it first: for defenseclaw-acp.exe, end the editor thread that uses DefenseClaw ACP (the DefenseClaw agent in Zed or a JetBrains IDE) ' +
            'in that account, or sign the account out; then run the uninstall again'
        )
    }
    # A program outside InstallRoot may still hold an installed file open.
    # Query errors are refusals: proceeding blind used to tear down services
    # and hooks before Windows refused to retire the binary tree.
    $firstHolders = @(Get-DefenseClawInstallRootHolders `
        -InstallRoot $Layout.InstallRoot `
        -SelfUninstallCallerPID $SelfUninstallCallerPID `
        -ExcludedProcessIds $excluded `
        -FailOnQueryError `
        -IncludeProcessId)
    if ($firstHolders.Count -gt 0) {
        Microsoft.PowerShell.Utility\Start-Sleep -Milliseconds $script:InstallTreeUseRecheckMilliseconds
        $stillHolders = @(Get-DefenseClawInstallRootHolders `
            -InstallRoot $Layout.InstallRoot `
            -SelfUninstallCallerPID $SelfUninstallCallerPID `
            -ExcludedProcessIds $excluded `
            -FailOnQueryError `
            -IncludeProcessId)
        $firstIds = @{}
        foreach ($holder in $firstHolders) {
            $firstIds[[int]$holder.Id] = $true
        }
        $persistent = @($stillHolders | Microsoft.PowerShell.Core\Where-Object {
            $firstIds.ContainsKey([int]$_.Id)
        })
        if ($persistent.Count -gt 0) {
            throw (
                'uninstall_in_use: ' + (($persistent | Microsoft.PowerShell.Core\ForEach-Object {
                    [string]$_.Description
                }) -join '; ') +
                " holds a file in $($Layout.InstallRoot); nothing was changed. " +
                'Close the program and run the uninstall again'
            )
        }
    }
}

function Move-DefenseClawNonImageFileReplacing {
    param(
        [Parameter(Mandatory)][string]$Source,
        [Parameter(Mandatory)][string]$Destination
    )
    if (-not (Test-DefenseClawStandaloneProfile)) {
        Microsoft.PowerShell.Management\Move-Item -LiteralPath $Source -Destination $Destination -Force
        return
    }
    $native = Initialize-DefenseClawNativeSecurity
    $clock = [Diagnostics.Stopwatch]::StartNew()
    while ($true) {
        $result = [string]$native::RenameNonImageFile($Source, $Destination)
        if ($result -ceq '') {
            return
        }
        if ($result -ceq 'classic') {
            Microsoft.PowerShell.Utility\Write-Warning `
                -Message 'DefenseClaw: this volume refused POSIX file replacement; concurrent readers may need to retry' `
                -WarningAction Continue
            return
        }
        $stage, $code = $result.Split(':', 2)
        if ($code -notin @('5', '32', '33') -or $clock.Elapsed.TotalSeconds -ge 3) {
            throw [IO.IOException]::new("data file replacement failed ($result); the previous file remains at $Destination")
        }
        Microsoft.PowerShell.Utility\Start-Sleep -Milliseconds 1
    }
}

function Write-DefenseClawJsonAtomic {
    <#
        Publishes JSON through a sibling and an atomic replace. -Kind AdminFile
        stamps the sibling with the canonical owner and protected access list
        before the replace (the stamp the hook guardian enforces), so the
        published file is never visible with the creator's owner (SYSTEM) or a
        DACL inherited from its folder. A write that stamps after the replace
        leaves that window open, and a guardian pass inside it repairs the file
        and makes the next ensure report guardian_repaired_drift (GAP-0899).
    #>
    param(
        [Parameter(Mandatory)]$Value,
        [Parameter(Mandatory)][string]$Path,
        [ValidateSet('AdminFile')][string]$Kind
    )
    New-DefenseClawDirectory -Path ([IO.Path]::GetDirectoryName($Path))
    $temporary = "$Path.new.$([Guid]::NewGuid().ToString('N'))"
    try {
        $json = $Value | Microsoft.PowerShell.Utility\ConvertTo-Json -Depth 12
        # Windows PowerShell 5.1's -Encoding UTF8 emits a BOM, which Go's
        # encoding/json intentionally rejects. Use explicit BOM-less UTF-8 so
        # every PowerShell version publishes byte-identical JSON.
        [IO.File]::WriteAllText(
            $temporary,
            $json,
            [Text.UTF8Encoding]::new($false)
        )
        if (-not [string]::IsNullOrEmpty($Kind)) {
            Set-DefenseClawPathAcl `
                -Path $temporary `
                -Kind $Kind `
                -GatewayServiceSID $script:AdministratorsSID
        }
        # A ReadOnly, Hidden or System attribute on the file being replaced
        # makes the replacing move fail with access denied.
        [void](Clear-DefenseClawRestrictiveFileAttributes -Path $Path)
        Move-DefenseClawNonImageFileReplacing -Source $temporary -Destination $Path
    }
    finally {
        if (Microsoft.PowerShell.Management\Test-Path -LiteralPath $temporary) {
            Microsoft.PowerShell.Management\Remove-Item -LiteralPath $temporary -Force
        }
    }
}

function Test-DefenseClawServiceExists {
    param([Parameter(Mandatory)][string]$Name)
    Assert-DefenseClawServiceName -Name $Name
    $nativeSecurity = Initialize-DefenseClawNativeSecurity
    # OpenService distinguishes the only safe absence result (Win32 1060)
    # from access-denied, SCM failure, and malformed-query errors. Destructive
    # rollback callers therefore cannot reinterpret a failed query as absence.
    return [bool]$nativeSecurity::ServiceExistsChecked($Name)
}

function Assert-DefenseClawServicesAbsentChecked {
    param(
        [Parameter(Mandatory)][AllowEmptyCollection()][string[]]$Names,
        [Parameter(Mandatory)][string]$Operation
    )
    foreach ($name in $Names) {
        if (Test-DefenseClawServiceExists -Name $name) {
            throw "$Operation while service exists: $name"
        }
    }
}

function Get-DefenseClawServiceChecked {
    param([Parameter(Mandatory)][string]$Name)
    if (-not (Test-DefenseClawServiceExists -Name $Name)) {
        return $null
    }
    try {
        return Microsoft.PowerShell.Management\Get-Service `
            -Name $Name `
            -ErrorAction Stop
    }
    catch {
        # Disappearance between OpenService and ServiceController construction
        # is the only tolerated race. If the native checked query still sees
        # the service, propagate the PowerShell/SCM failure.
        if (-not (Test-DefenseClawServiceExists -Name $Name)) {
            return $null
        }
        throw
    }
}

function Write-DefenseClawLifecyclePhase {
    param([Parameter(Mandatory)][string]$Stage)
    if (Test-DefenseClawStandaloneProfile) {
        [Console]::Error.WriteLine("DC_LIFECYCLE_PHASE: $([DateTime]::UtcNow.ToString('o')) $Stage")
    }
}

function Stop-DefenseClawService {
    param([Parameter(Mandatory)][string]$Name)
    $service = Get-DefenseClawServiceChecked -Name $Name
    if ($null -eq $service) { return }
    if ($service.Status -eq
        [ServiceProcess.ServiceControllerStatus]::Stopped) {
        return
    }
    if (-not (Test-DefenseClawStandaloneProfile)) {
        try {
            Microsoft.PowerShell.Management\Stop-Service -Name $Name -ErrorAction Stop
            $service.WaitForStatus([ServiceProcess.ServiceControllerStatus]::Stopped, [TimeSpan]::FromSeconds(30))
        }
        catch {
            # Bulldoze posture: a service may be hung with mapped files, blocked
            # on I/O inside its stop handler, or the caller may lack
            # SeStopPrivilege for a renamed foreign service occupying our name.
            # Refusing to proceed here orphans the uninstall. SCM accepts the
            # subsequent `sc delete` even against a non-stopped service - the
            # row is marked for deletion and the service terminates whenever
            # it next calls the SCM control loop, or at the next reboot via
            # the pending-delete flag.
            if (Test-DefenseClawTrustStrictAncestors) {
                throw
            }
            Write-DefenseClawAclSelfHealAdvisory `
                -Path "service:$Name" `
                -Reason (
                    "Stop-Service failed or timed out, proceeding to delete " +
                    "anyway: $($_.Exception.Message)"
                )
        }
        return
    }
    # A hung or suspended service process never answers the stop request:
    # Stop-Service failed after the SCM's own timeout, ensure failed 1603 and
    # left the guardian and the enumerator stopped with the transaction
    # pending (GAP-0946). Stop-Service also waits for the request itself,
    # which Windows holds twice its 30-second transaction timeout while it
    # ends the unresponsive process on its own, so each hung service cost a
    # minute and the result never named it (GAP-1038). Standalone sends the
    # request through a sc.exe child it does not wait on, gives the service
    # the SCM's 30-second budget, then ends the service's own process and
    # continues; a process Windows ended because it did not answer the request
    # is named too. Every caller has disabled the service first, so its
    # failure actions cannot restart it.
    $budget = [TimeSpan]::FromSeconds($script:ServiceStopTimeoutSeconds)
    Write-DefenseClawLifecyclePhase -Stage "stop $Name request"
    $processId = Get-DefenseClawServiceProcessId -Name $Name
    $request = Start-DefenseClawServiceStopRequest -Name $Name
    try {
        Write-DefenseClawLifecyclePhase -Stage "stop $Name wait"
        if (Wait-DefenseClawServiceStopped -Service $service -Timeout $budget) {
            Write-DefenseClawLifecyclePhase -Stage "stop $Name complete"
            # A service that answered has already returned the request; one
            # whose request is still open after it stopped was ended by
            # Windows.
            if ($processId -ne 0 -and -not $request.WaitForExit(3000)) {
                $script:DefenseClawTerminatedServiceProcesses += "$Name (pid $processId)"
            }
            return
        }
        $running = @($service.DependentServices | Microsoft.PowerShell.Core\Where-Object {
                $_.Status -ne [ServiceProcess.ServiceControllerStatus]::Stopped
            })
        if ($running.Count -gt 0) {
            throw "service $Name failed during stop: $($running[0].ServiceName) still depends on it after $($script:ServiceStopTimeoutSeconds) seconds; stop the dependent service, then run $(Format-DefenseClawSetupAction -Action '/ensure') again"
        }
        Write-DefenseClawLifecyclePhase -Stage "stop $Name ending unresponsive process"
        Stop-DefenseClawUnresponsiveServiceProcess -Name $Name
        if (-not (Wait-DefenseClawServiceStopped -Service $service -Timeout $budget)) {
            throw "service $Name failed during stop: it stayed running for $($script:ServiceStopTimeoutSeconds) seconds after its process was ended; inspect the Windows service events, then run $(Format-DefenseClawSetupAction -Action '/ensure') again"
        }
        Write-DefenseClawLifecyclePhase -Stage "stop $Name complete after termination"
    }
    finally {
        if (-not $request.HasExited) {
            try {
                $request.Kill()
            }
            catch {
            }
            [void]$request.WaitForExit(5000)
        }
        $request.Dispose()
    }
}

# Sends a stop request for a DefenseClaw service through a sc.exe child and
# returns that process without waiting for it: the request stays open for as
# long as an unresponsive service does not answer it.
function Start-DefenseClawServiceStopRequest {
    param([Parameter(Mandatory)][string]$Name)
    Assert-DefenseClawServiceName -Name $Name
    $info = [Diagnostics.ProcessStartInfo]::new($script:ScExe, "stop $Name")
    $info.UseShellExecute = $false
    $info.CreateNoWindow = $true
    $info.RedirectStandardOutput = $true
    $info.RedirectStandardError = $true
    try {
        return [Diagnostics.Process]::Start($info)
    }
    catch {
        throw "service $Name failed during stop request: $($_.Exception.Message). Inspect the Windows service events, then run $(Format-DefenseClawSetupAction -Action '/ensure') again"
    }
}

# How long a standalone stop waits before it ends a service process that
# does not answer (the SCM's own stop budget).
$script:ServiceStopTimeoutSeconds = 30
# Standalone start bounds the SCM request and the running-state wait separately.
$script:ServiceStartRequestTimeoutSeconds = 30
$script:ServiceStartReadyTimeoutSeconds = 60

# Each service process a standalone lifecycle ended because it did not
# answer a stop, as "<service> (pid <n>)", for the result.
$script:DefenseClawTerminatedServiceProcesses = @()
$script:DefenseClawSkippedRuntimeFiles = @()

function Get-DefenseClawServiceProcessIdentity {
    <#
        GAP-1451: the id and start time of the running process of service
        Name, or $null when it has none (or it is this lifecycle's own
        process). The start time tells a later process that reuses the id
        apart; it is $null when it cannot be read.
    #>
    param([Parameter(Mandatory)][string]$Name)
    $processId = Get-DefenseClawServiceProcessId -Name $Name
    if ($processId -eq 0 -or $processId -eq [uint32]$PID) {
        return $null
    }
    $started = $null
    try {
        $process = [Diagnostics.Process]::GetProcessById([int]$processId)
        try {
            $started = $process.StartTime
        }
        catch {
            $started = $null
        }
        $process.Dispose()
    }
    catch {
        # It has already exited.
        return $null
    }
    return [pscustomobject]@{ Id = [int]$processId; StartTime = $started }
}

function Test-DefenseClawProcessIdentityRunning {
    param([Parameter(Mandatory)]$Identity)
    try {
        $process = [Diagnostics.Process]::GetProcessById([int]$Identity.Id)
    }
    catch {
        return $false
    }
    try {
        try {
            if ($process.HasExited) {
                return $false
            }
        }
        catch {
            # Unreadable exit state: the start time decides.
        }
        if ($null -eq $Identity.StartTime) {
            return $true
        }
        try {
            $started = $process.StartTime
        }
        catch {
            # Unreadable: count it as the same process.
            return $true
        }
        # A later process that reuses the id started later.
        return [Math]::Abs(($started - $Identity.StartTime).TotalSeconds) -lt 1
    }
    finally {
        $process.Dispose()
    }
}

function Wait-DefenseClawServiceProcessExit {
    <#
        GAP-1451: a Go service reports SERVICE_STOPPED before its process
        exits, and a 1.0.2 or 1.0.3 service whose work did not end within its
        own stop wait is still running then. Waits, up to TimeoutSeconds,
        until the process Identity names (taken before the stop) has exited,
        then ends it, and throws when it still runs. The caller has disabled
        and stopped the service, so ending its process does not change what
        the SCM does next.
    #>
    param(
        [Parameter(Mandatory)][string]$Name,
        [AllowNull()]$Identity,
        [int]$TimeoutSeconds = 10
    )
    if ($null -eq $Identity) {
        return
    }
    $deadline = [DateTime]::UtcNow.AddSeconds($TimeoutSeconds)
    while (Test-DefenseClawProcessIdentityRunning -Identity $Identity) {
        if ([DateTime]::UtcNow -ge $deadline) {
            Write-DefenseClawLifecyclePhase -Stage ("stop {0}: its process {1} still runs after the service stopped; ending it" -f $Name, $Identity.Id)
            try {
                Microsoft.PowerShell.Management\Stop-Process -Id ([int]$Identity.Id) -Force -ErrorAction Stop
            }
            catch {
                # It may have exited meanwhile; the check below decides.
            }
            $script:DefenseClawTerminatedServiceProcesses += "$Name (pid $($Identity.Id))"
            $ended = [DateTime]::UtcNow.AddSeconds(10)
            while (Test-DefenseClawProcessIdentityRunning -Identity $Identity) {
                if ([DateTime]::UtcNow -ge $ended) {
                    throw "service $Name failed during stop: its process $($Identity.Id) still runs after the service stopped and could not be ended; end process $($Identity.Id), then run $(Format-DefenseClawSetupAction -Action '/ensure') again"
                }
                Microsoft.PowerShell.Utility\Start-Sleep -Milliseconds 250
            }
            return
        }
        Microsoft.PowerShell.Utility\Start-Sleep -Milliseconds 250
    }
}

function Wait-DefenseClawServiceStopped {
    param(
        [Parameter(Mandatory)]$Service,
        [Parameter(Mandatory)][TimeSpan]$Timeout
    )
    $deadline = [DateTime]::UtcNow + $Timeout
    while ($true) {
        $Service.Refresh()
        if ($Service.Status -eq [ServiceProcess.ServiceControllerStatus]::Stopped) {
            return $true
        }
        if ([DateTime]::UtcNow -ge $deadline) {
            return $false
        }
        Microsoft.PowerShell.Utility\Start-Sleep -Milliseconds 250
    }
}

function Get-DefenseClawServiceProcessId {
    param([Parameter(Mandatory)][string]$Name)
    Assert-DefenseClawServiceName -Name $Name
    try {
        $lines = @(Invoke-DefenseClawNative -File $script:ScExe -Arguments @('queryex', $Name) -TimeoutSeconds 10 -Capture)
    }
    catch {
        throw "service $Name failed during SCM process lookup: $($_.Exception.Message). Inspect the Windows service events, then run $(Format-DefenseClawSetupAction -Action '/ensure') again"
    }
    $match = [regex]::Match(($lines -join "`n"), '(?m)^\s*PID\s*:\s*([0-9]+)\s*$')
    if (-not $match.Success) {
        return [uint32]0
    }
    return [uint32]$match.Groups[1].Value
}

function Stop-DefenseClawUnresponsiveServiceProcess {
    <#
        Ends the process of a DefenseClaw service that did not answer a stop
        request in time, only when it is the service's own executable (its
        ImagePath); anything else is refused with the process id and image so
        the administrator can end it. A process TerminateProcess ends while
        suspended or hung reports the service stopped to the SCM.
    #>
    param([Parameter(Mandatory)][string]$Name)
    $processId = Get-DefenseClawServiceProcessId -Name $Name
    if ($processId -eq 0) {
        return
    }
    if ($processId -eq [uint32]$PID) {
        throw "service $Name failed during stop: its process is this lifecycle's own process $processId; inspect the service configuration, then run $(Format-DefenseClawSetupAction -Action '/ensure') again"
    }
    $key = "HKLM:\SYSTEM\CurrentControlSet\Services\$Name"
    $imagePath = [string](Microsoft.PowerShell.Management\Get-ItemPropertyValue -LiteralPath $key -Name ImagePath -ErrorAction Stop)
    $expected = if ($imagePath.StartsWith('"')) {
        $imagePath.Substring(1, [Math]::Max(0, $imagePath.IndexOf('"', 1) - 1))
    }
    else {
        ($imagePath -split ' ', 2)[0]
    }
    $nativeSecurity = Initialize-DefenseClawNativeSecurity
    $image = [string]$nativeSecurity::GetProcessImagePath($processId)
    if ([string]::IsNullOrWhiteSpace($expected) -or
        -not [string]::Equals([IO.Path]::GetFullPath($image), [IO.Path]::GetFullPath($expected), [StringComparison]::OrdinalIgnoreCase)) {
        throw "service $Name did not stop within $($script:ServiceStopTimeoutSeconds) seconds, and its process $processId runs $image, not the service executable $expected; end process $processId, then run the command again"
    }
    Microsoft.PowerShell.Management\Stop-Process -Id ([int]$processId) -Force -ErrorAction Stop
    $script:DefenseClawTerminatedServiceProcesses += "$Name (pid $processId)"
}

function Start-DefenseClawService {
    param(
        [Parameter(Mandatory)][string]$Name,
        [string]$FailureLogPath
    )
    $service = Microsoft.PowerShell.Management\Get-Service -Name $Name -ErrorAction Stop
    if ($service.Status -ne [ServiceProcess.ServiceControllerStatus]::Running) {
        if (-not [string]::IsNullOrEmpty($FailureLogPath) -and (Test-DefenseClawStandaloneProfile)) {
            # Only what this start writes explains its failure.
            if ($null -eq $script:DefenseClawServiceLogOffsets) {
                $script:DefenseClawServiceLogOffsets = @{}
            }
            $script:DefenseClawServiceLogOffsets[$FailureLogPath] = Get-DefenseClawLogLength -LogPath $FailureLogPath
        }
        try {
            if (Test-DefenseClawStandaloneProfile) {
                Assert-DefenseClawServiceName -Name $Name
                $startResult = Invoke-DefenseClawProcess `
                    -File $script:ScExe `
                    -Arguments @('start', $Name) `
                    -TimeoutSeconds $script:ServiceStartRequestTimeoutSeconds
                if ([int]$startResult.exit_code -ne 0) {
                    $service.Refresh()
                    if ($service.Status -ne [ServiceProcess.ServiceControllerStatus]::Running) {
                        throw "SCM start request exited $($startResult.exit_code)"
                    }
                }
            }
            else {
                Microsoft.PowerShell.Management\Start-Service -Name $Name -ErrorAction Stop
            }
            $service.WaitForStatus(
                [ServiceProcess.ServiceControllerStatus]::Running,
                [TimeSpan]::FromSeconds($script:ServiceStartReadyTimeoutSeconds)
            )
        }
        catch {
            $original = $_
            $logged = Get-DefenseClawStandaloneServiceLoggedError -LogPath $FailureLogPath
            if (Test-DefenseClawStandaloneProfile) {
                $detail = ConvertTo-DefenseClawBoundedDiagnostic -Value $_.Exception.Message -MaxLength 512
                if (-not [string]::IsNullOrEmpty($logged)) {
                    $detail += " The service logged: $logged"
                }
                throw "service $Name failed during start or readiness check (SCM request: $($script:ServiceStartRequestTimeoutSeconds)s; running state: $($script:ServiceStartReadyTimeoutSeconds)s). Inspect the service events and log, then run $(Format-DefenseClawSetupAction -Action '/ensure') again. Details: $detail"
            }
            # Start-Service only says "Cannot start service X". Name SCM's exit
            # codes, and each dependency's, so a failed rollback or install says
            # why (for example the gateway's 1068 because the broker exited 1066).
            $message = $null
            try {
                $message = Get-DefenseClawServiceStartFailureMessage `
                    -Name $Name `
                    -Service $service `
                    -Cause $original.Exception.Message `
                    -StartError (Get-DefenseClawWin32ErrorCode -Exception $original.Exception)
            }
            catch {
                $message = $null
            }
            if ([string]::IsNullOrWhiteSpace($message)) {
                if ([string]::IsNullOrEmpty($logged)) {
                    throw $original
                }
                throw "$($original.Exception.Message) The service logged: $logged"
            }
            if (-not [string]::IsNullOrEmpty($logged)) {
                $message += " The service logged: $logged"
            }
            throw $message
        }
    }
}

# Log length before the lifecycle last started a service, by log path.
$script:DefenseClawServiceLogOffsets = @{}

function Get-DefenseClawLogLength {
    param([Parameter(Mandatory)][string]$LogPath)
    try {
        $item = Microsoft.PowerShell.Management\Get-Item -LiteralPath $LogPath -Force -ErrorAction Stop
        if ($item -is [IO.FileInfo]) {
            return [long]$item.Length
        }
    }
    catch {
    }
    return [long]0
}

function Get-DefenseClawStandaloneServiceLoggedError {
    <#
        The last "Error: " line a standalone service wrote to its log, or ''.
        A failed first install rolls the log back with the data folder, so
        the lifecycle error is the only place the administrator sees why
        the service stopped.
    #>
    param([AllowEmptyString()][string]$LogPath)
    if (-not (Test-DefenseClawStandaloneProfile) -or [string]::IsNullOrEmpty($LogPath)) {
        return ''
    }
    try {
        $item = Microsoft.PowerShell.Management\Get-Item -LiteralPath $LogPath -Force -ErrorAction Stop
        if ($item.PSIsContainer -or $item.LinkType) {
            return ''
        }
        $stream = [IO.File]::Open($LogPath, [IO.FileMode]::Open, [IO.FileAccess]::Read, [IO.FileShare]::ReadWrite -bor [IO.FileShare]::Delete)
        try {
            $since = [long]0
            if ($null -ne $script:DefenseClawServiceLogOffsets -and
                $script:DefenseClawServiceLogOffsets.ContainsKey($LogPath) -and
                [long]$script:DefenseClawServiceLogOffsets[$LogPath] -le $stream.Length) {
                $since = [long]$script:DefenseClawServiceLogOffsets[$LogPath]
            }
            $tail = [Math]::Min([long]65536, $stream.Length - $since)
            [void]$stream.Seek(-$tail, [IO.SeekOrigin]::End)
            $buffer = [byte[]]::new($tail)
            $read = $stream.Read($buffer, 0, $buffer.Length)
            $text = [Text.Encoding]::UTF8.GetString($buffer, 0, $read)
        }
        finally {
            $stream.Dispose()
        }
    }
    catch {
        return ''
    }
    $last = ''
    foreach ($line in ($text -split "`r?`n")) {
        $trimmed = $line.Trim()
        if ($trimmed.StartsWith('Error: ', [StringComparison]::Ordinal)) {
            $last = $trimmed.Substring(7).Trim()
        }
    }
    if ($last.Length -gt 600) {
        $last = $last.Substring(0, 600) + '...'
    }
    return $last
}

# The Win32 error StartService returned (for example 1068 when a dependency
# failed), from the first Win32Exception in the exception chain. sc.exe queryex
# can still show the service's previous exit code then, because it never ran.
function Get-DefenseClawWin32ErrorCode {
    param($Exception)
    $current = $Exception
    for ($depth = 0; $null -ne $current -and $depth -lt 8; $depth++) {
        if ($current -is [ComponentModel.Win32Exception]) {
            return [int64]$current.NativeErrorCode
        }
        $current = $current.InnerException
    }
    return $null
}

function Get-DefenseClawServiceStartFailureMessage {
    param(
        [Parameter(Mandatory)][string]$Name,
        $Service,
        [AllowEmptyString()][string]$Cause = '',
        $StartError = $null
    )
    $message = "service $Name failed to start: "
    if ($null -ne $StartError) {
        $description = ''
        try {
            $description = ([ComponentModel.Win32Exception]::new([int]$StartError)).Message
        }
        catch {
            $description = ''
        }
        $message += "START_ERROR=$StartError"
        if (-not [string]::IsNullOrWhiteSpace($description)) {
            $message += " ($description)"
        }
        $message += ' '
    }
    $message += (Get-DefenseClawServiceExitCodes -Name $Name -IncludeState)
    $dependencies = @()
    try {
        if ($null -ne $Service) {
            $dependencies = @($Service.ServicesDependedOn | Microsoft.PowerShell.Core\ForEach-Object {
                    [string]$_.ServiceName
                })
        }
    }
    catch {
        $dependencies = @()
    }
    foreach ($dependency in $dependencies) {
        if ([string]::IsNullOrWhiteSpace($dependency)) {
            continue
        }
        $message += " [dependency ${dependency}: " +
            (Get-DefenseClawServiceExitCodes -Name $dependency -IncludeState) + ']'
    }
    if (-not [string]::IsNullOrWhiteSpace($Cause)) {
        $message += " ($Cause)"
    }
    return $message
}

# Reads STATE, WIN32_EXIT_CODE and SERVICE_EXIT_CODE from sc.exe queryex. Only
# used to explain a failure, so it never throws.
function Get-DefenseClawServiceExitCodes {
    param(
        [Parameter(Mandatory)][string]$Name,
        [switch]$IncludeState
    )
    try {
        $output = Invoke-DefenseClawNative `
            -File $script:ScExe `
            -Arguments @('queryex', $Name) `
            -Capture
        $text = ($output | Microsoft.PowerShell.Utility\Out-String)
    }
    catch {
        return "exit codes unavailable (sc.exe queryex failed: $($_.Exception.Message))"
    }
    $state = 'unknown'
    if ($text -match 'STATE\s*:\s*\d+\s+(\S+)') {
        $state = $Matches[1]
    }
    $parts = @()
    if ($IncludeState) {
        $parts += "STATE=$state"
    }
    if ($text -match 'WIN32_EXIT_CODE\s*:\s*(\d+)') {
        $code = [int64]$Matches[1]
        $description = ''
        try {
            $description = ([ComponentModel.Win32Exception]::new([int]$code)).Message
        }
        catch {
            $description = ''
        }
        if ([string]::IsNullOrWhiteSpace($description)) {
            $parts += "WIN32_EXIT_CODE=$code"
        }
        else {
            $parts += "WIN32_EXIT_CODE=$code ($description)"
        }
    }
    else {
        $parts += 'WIN32_EXIT_CODE=unknown'
    }
    if ($text -match 'SERVICE_EXIT_CODE\s*:\s*(\d+)') {
        $parts += "SERVICE_EXIT_CODE=$($Matches[1])"
    }
    else {
        $parts += 'SERVICE_EXIT_CODE=unknown'
    }
    return ($parts -join ' ')
}

function Remove-DefenseClawService {
    param([Parameter(Mandatory)][string]$Name)
    if (-not (Test-DefenseClawServiceExists -Name $Name)) {
        return
    }
    Stop-DefenseClawService -Name $Name
    # Secure Client: a service already marked for deletion by an earlier
    # attempt is as good as deleted. Standalone and the strict pin keep the
    # failure, which names the pending-delete prerequisite.
    $deleteAccepted = Invoke-DefenseClawNative `
        -File $script:ScExe `
        -Arguments @('delete', $Name) `
        -TolerateServicePendingDelete:(-not (Test-DefenseClawTrustStrictAncestors) -and
            -not (Test-DefenseClawStandaloneProfile))
    if ($deleteAccepted -is [bool] -and -not $deleteAccepted) {
        # Already marked for deletion by an earlier attempt: nothing more
        # this action can do, and nothing left to wait for.
        return
    }
    $deadline = [DateTime]::UtcNow.AddSeconds(30)
    while ((Test-DefenseClawServiceExists -Name $Name) -and [DateTime]::UtcNow -lt $deadline) {
        Microsoft.PowerShell.Utility\Start-Sleep -Milliseconds 100
    }
    if (Test-DefenseClawServiceExists -Name $Name) {
        # Bulldoze posture: SCM has accepted the delete (sc delete above
        # succeeded or was silently swallowed), but the service row
        # persists because another process still holds a handle to it.
        # The row's pending-delete flag will complete at the next reboot;
        # any subsequent attempt to open the service with full access will
        # fail with ERROR_SERVICE_MARKED_FOR_DELETE. Refusing here orphans
        # the uninstall even though the delete request has already been
        # recorded.
        if (Test-DefenseClawTrustStrictAncestors) {
            throw "Windows service remains after deletion: $Name"
        }
        Write-DefenseClawAclSelfHealAdvisory `
            -Path "service:$Name" `
            -Reason (
                "service row persists after sc delete (handle held by " +
                "another process); SCM pending-delete flag completes at " +
                "next reboot"
            )
    }
}

function Get-DefenseClawServiceEnvironmentValues {
    param(
        [Parameter(Mandatory)][string]$Name,
        [Parameter(Mandatory)][string]$RuntimeDirectory,
        [Parameter(Mandatory)][string]$ConfigPath,
        [Parameter(Mandatory)][string]$AuthorizationDirectory,
        [Parameter(Mandatory)][string]$GatewayServiceName,
        [Parameter(Mandatory)][string]$LogPath,
        [string]$BrokerPipeName,
        [string]$BrokerServiceName,
        [string]$BrokerAuthKeyPath,
        [switch]$AgentApplicationControlAttested,
        [switch]$ClaudeEffectivePolicyVerified
    )
    $values = [Collections.Generic.List[string]]::new()
    foreach ($value in @(
        "DEFENSECLAW_HOME=$RuntimeDirectory",
        "DEFENSECLAW_CONFIG=$ConfigPath",
        'DEFENSECLAW_DEPLOYMENT_MODE=managed_enterprise',
        "DEFENSECLAW_HOOK_GUARDIAN_AUTH_DIR=$AuthorizationDirectory",
        "DEFENSECLAW_WINDOWS_SERVICE_NAME=$Name",
        "DEFENSECLAW_WINDOWS_GATEWAY_SERVICE_NAME=$GatewayServiceName",
        "DEFENSECLAW_WINDOWS_SERVICE_ACCOUNT=NT SERVICE\$GatewayServiceName",
        "DEFENSECLAW_WINDOWS_SERVICE_LOG=$LogPath"
    )) {
        $values.Add($value)
    }
    if (Test-DefenseClawStandaloneProfile) {
        # The profile pin rides next to the deployment-mode pin so neither a
        # config replacement nor a caller environment can move a standalone
        # service onto the Secure Client decision stack.
        $values.Add('DEFENSECLAW_ENTERPRISE_PROFILE=standalone')
    }
    $brokerValues = @($BrokerPipeName, $BrokerServiceName, $BrokerAuthKeyPath)
    $brokerValueCount = @($brokerValues | Microsoft.PowerShell.Core\Where-Object {
        -not [string]::IsNullOrWhiteSpace([string]$_)
    }).Count
    if ($brokerValueCount -ne 0 -and $brokerValueCount -ne 3) {
        throw 'credential broker service environment is partially configured'
    }
    if ($brokerValueCount -ne 0 -and -not (Test-DefenseClawBrokerEnabled)) {
        throw 'the standalone profile has no credential broker; broker service environment is not allowed'
    }
    if ($brokerValueCount -eq 3) {
        $values.Add("DEFENSECLAW_CMID_BROKER_PIPE=$BrokerPipeName")
        $values.Add("DEFENSECLAW_CMID_BROKER_SERVICE_NAME=$BrokerServiceName")
        $values.Add("DEFENSECLAW_CMID_BROKER_AUTH_KEY=$BrokerAuthKeyPath")
    }
    if ($AgentApplicationControlAttested) {
        $values.Add('DEFENSECLAW_WINDOWS_CODEX_APPROVED_CLIENT_ENFORCED=1')
        $values.Add('DEFENSECLAW_WINDOWS_APPROVED_AGENT_CLIENTS_ENFORCED=1')
    }
    if ($ClaudeEffectivePolicyVerified) {
        $values.Add('DEFENSECLAW_WINDOWS_CLAUDE_EFFECTIVE_POLICY_VERIFIED=1')
    }
    return [string[]]$values.ToArray()
}

function Set-DefenseClawServiceEnvironment {
    param(
        [Parameter(Mandatory)][string]$Name,
        [Parameter(Mandatory)][string]$RuntimeDirectory,
        [Parameter(Mandatory)][string]$ConfigPath,
        [Parameter(Mandatory)][string]$AuthorizationDirectory,
        [Parameter(Mandatory)][string]$GatewayServiceName,
        [Parameter(Mandatory)][string]$LogPath,
        [string]$BrokerPipeName,
        [string]$BrokerServiceName,
        [string]$BrokerAuthKeyPath,
        [switch]$AgentApplicationControlAttested,
        [switch]$ClaudeEffectivePolicyVerified
    )
    $serviceKey = "HKLM:\SYSTEM\CurrentControlSet\Services\$Name"
    if (-not (Microsoft.PowerShell.Management\Test-Path -LiteralPath $serviceKey)) {
        throw "service registry key is missing: $Name"
    }
    $values = [string[]]@(Get-DefenseClawServiceEnvironmentValues `
        -Name $Name `
        -RuntimeDirectory $RuntimeDirectory `
        -ConfigPath $ConfigPath `
        -AuthorizationDirectory $AuthorizationDirectory `
        -GatewayServiceName $GatewayServiceName `
        -LogPath $LogPath `
        -BrokerPipeName $BrokerPipeName `
        -BrokerServiceName $BrokerServiceName `
        -BrokerAuthKeyPath $BrokerAuthKeyPath `
        -AgentApplicationControlAttested:$AgentApplicationControlAttested `
        -ClaudeEffectivePolicyVerified:$ClaudeEffectivePolicyVerified)
    [void](Microsoft.PowerShell.Management\New-ItemProperty -LiteralPath $serviceKey -Name Environment -PropertyType MultiString -Value $values -Force)
}

