function Set-DefenseClawSensorHelperServiceEnvironment {
    param(
        [Parameter(Mandatory)][string]$Name,
        [Parameter(Mandatory)][string]$GatewayServiceName
    )
    Assert-DefenseClawServiceName -Name $Name
