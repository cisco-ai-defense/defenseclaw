function Set-DefenseClawEnterpriseProfile {
    param(
        [Parameter(Mandatory)]
        [ValidateSet('SecureClient', 'Standalone')]
        [string]$EnterpriseProfile
    )
    $script:DefenseClawEnterpriseProfile = $EnterpriseProfile
}

function Get-DefenseClawEnterpriseProfile {
    return [string]$script:DefenseClawEnterpriseProfile
}

function Test-DefenseClawStandaloneProfile {
    return [string]$script:DefenseClawEnterpriseProfile -ceq 'Standalone'
}

function Format-DefenseClawSetupAction {
    <#
        A hint that sends an administrator to Setup. Setup is not installed on
        a standalone computer (the MDM kit removes its staged copy), so a bare
        "Setup /ensure" is not a command there: the hint runs Setup from the
        folder that holds it and says where it comes from (cowork-1-0-8
        GAP-0095). Other profiles keep "Setup <action>" as it was.

        Several actions are alternatives: each is its own command, joined with
        "or" ("/install or /uninstall PURGE=1" is not one command). A
        placeholder is quoted, as the Go hints quote it: PowerShell reads an
        unquoted "<" as an error, and the quote keeps its spaces in one word.
    #>
    param([Parameter(Mandatory)][string[]]$Action)
    if (-not (Test-DefenseClawStandaloneProfile)) { return 'Setup ' + ($Action -join ' or ') }
    $commands = foreach ($item in $Action) {
        $arguments = [regex]::Replace([string]$item, '(\S*<[^>]*>\S*)', "'`$1'")
        "& '.\DefenseClawSetup-Enterprise-Standalone-x64.exe' $arguments"
    }
    return ($commands -join ' or ') + ' (Setup is not installed on this computer: use the copy in your MDM package or the release download)'
}

function Format-DefenseClawRepairAction {
    <#
        The repair an administrator runs: the installed CLI by its full path on
        a standalone computer (it is there; Setup is not), "Setup /repair"
        elsewhere.
    #>
    param([Parameter(Mandatory)][hashtable]$Layout)
    if (-not (Test-DefenseClawStandaloneProfile)) { return 'Setup /repair' }
    return Get-DefenseClawStandaloneBundleRepairCommand -Layout $Layout
}

function Format-DefenseClawRerunStep {
    <#
        The end of a hint that asks for the failed run again. Setup is not
        installed on a standalone computer, and the failed run may have been
        the installed CLI's, so the hint asks for "the same command"
        (cowork-1-0-8 GAP-0095). Other profiles keep "run Setup again" (or,
        with -SameSetupCommand, "run the same Setup command again") as it was.
    #>
    param([switch]$SameSetupCommand)
    if (Test-DefenseClawStandaloneProfile) { return 'run the same command again' }
    if ($SameSetupCommand) { return 'run the same Setup command again' }
    return 'run Setup again'
}

function Get-DefenseClawClaudeMinimumClientVersion {
    <#
        The Claude client floor recorded in application-control evidence,
        deployment metadata and status. Standalone uses the lowest Claude hook
        contract (a lower version has no contract to render a managed policy
        for; pinned to the Go table by a contract test). Secure Client keeps
        its historical value.
    #>
    if (Test-DefenseClawStandaloneProfile) {
        return '2.1.154'
    }
    return '2.1.152'
}

function Test-DefenseClawBrokerEnabled {
    # The CMID credential broker exists only to isolate Secure Client's
    # machine-credential provider. A standalone deployment has no provider,
    # so it has no broker service, key, pipe, or gateway dependency.
    return -not (Test-DefenseClawStandaloneProfile)
}

function Get-DefenseClawProfileRoots {
    <#
        The single source of the per-profile machine roots. Secure Client
        literals appear only here, in the CMID provider root, and in the
        certification scope grammar derived from here.
    #>
    param(
        [ValidateSet('SecureClient', 'Standalone')]
        [string]$EnterpriseProfile = $script:DefenseClawEnterpriseProfile
    )
    $vendor = if ($EnterpriseProfile -ceq 'Standalone') {
        'Cisco'
    }
    else {
        'Cisco\Cisco Secure Client'
    }
    return @{
        Profile = $EnterpriseProfile
        InstallRoot = [IO.Path]::Combine($script:ProgramFiles, "$vendor\DefenseClaw")
        StateRoot = [IO.Path]::Combine($script:ProgramData, "$vendor\DefenseClaw")
        CertificationInstallBase = [IO.Path]::Combine($script:ProgramFiles, "$vendor\DefenseClaw-Cert")
        CertificationStateBase = [IO.Path]::Combine($script:ProgramData, "$vendor\DefenseClaw-Cert")
        ManagedIPCDirectory = [IO.Path]::Combine($script:ProgramFiles, "$vendor\DefenseClaw\ipc")
        LifecycleDirectory = [IO.Path]::Combine($script:ProgramData, "$vendor\DefenseClaw-Lifecycle")
        BrokerEnabled = ($EnterpriseProfile -cne 'Standalone')
    }
}

function Get-DefenseClawOptionalLayoutValue {
    <#
        Reads a layout key that older or partial layouts (a hashtable or a
        PSCustomObject, including test fixtures) may not carry. Under
        Set-StrictMode a missing key throws on member access; absence is
        returned as the empty string, which every caller treats as its strict
        default (no AF_UNIX socket exemption, no expected manifest image). A
        present key is returned unchanged.
    #>
    param(
        [Parameter(Mandatory)][object]$Layout,
        [Parameter(Mandatory)][string]$Name
    )
    if ($Layout -is [Collections.IDictionary]) {
        if ($Layout.Contains($Name)) {
            return [string]$Layout[$Name]
        }
        return ''
    }
    $property = $Layout.PSObject.Properties[$Name]
    if ($null -eq $property) {
        return ''
    }
    return [string]$property.Value
}

function Test-DefenseClawTransactionBrokerTopology {
    <#
        True only when the legacy no-Broker transaction lanes can apply: the
        Secure Client profile, a layout that does not mark itself
        broker-less, and a layout that names its Broker service. The
        standalone profile never has a Broker, so its synthesized absent
        Broker row must never route recovery through those lanes.
    #>
    param([Parameter(Mandatory)][object]$Layout)
    if (-not (Test-DefenseClawBrokerEnabled) -or
        -not (Test-DefenseClawLayoutBrokerEnabled -Layout $Layout)) {
        return $false
    }
    return -not [string]::IsNullOrWhiteSpace(
        (Get-DefenseClawOptionalLayoutValue -Layout $Layout -Name BrokerServiceName)
    )
}

function Test-DefenseClawLayoutBrokerEnabled {
    param([Parameter(Mandatory)][object]$Layout)
    if ($Layout -is [Collections.IDictionary]) {
        return -not ($Layout.Contains('BrokerEnabled') -and -not [bool]$Layout['BrokerEnabled'])
    }
    $property = $Layout.PSObject.Properties['BrokerEnabled']
    return -not ($null -ne $property -and -not [bool]$property.Value)
}

function Resolve-DefenseClawProfileFromLifecycleDirectory {
    <#
        Maps a protected lifecycle receipt directory back to its profile so
        a detached finalizer, which has no caller-supplied profile, resolves
        the same layout the transaction that wrote the receipt used.
    #>
    param([Parameter(Mandatory)][string]$Directory)
    $full = [IO.Path]::GetFullPath($Directory).TrimEnd('\')
    foreach ($candidate in @('SecureClient', 'Standalone')) {
        $roots = Get-DefenseClawProfileRoots -EnterpriseProfile $candidate
        if ([string]::Equals(
                $full,
                [string]$roots.LifecycleDirectory,
                [StringComparison]::OrdinalIgnoreCase
            )) {
            return $candidate
        }
    }
    return ''
}

# Names the policy that stopped Add-Type from compiling. Only numeric codes and
# error IDs are read, never localized text: 1260 is AppLocker or Software
# Restriction Policies, 4551 is WDAC or Smart App Control, 225 is Defender or
# an ASR rule, ScriptContainedMaliciousContent is AMSI, and 112 or another
# IOException means the compiler's temporary directory is unusable.
function Get-DefenseClawAddTypeFailure {
    param(
        [Parameter(Mandatory)]$ErrorRecord,
        [string]$Check = 'powershell_add_type',
        # The blocked file; empty names the compiler Add-Type runs.
        [string]$Path = ''
    )
    $policy = ''
    $win32 = ''
    $ioFailure = $false
    $ids = @()
    if ($null -ne $ErrorRecord.PSObject.Properties['FullyQualifiedErrorId']) {
        $ids += [string]$ErrorRecord.FullyQualifiedErrorId
    }
    $exception = $ErrorRecord
    if ($null -ne $ErrorRecord.PSObject.Properties['Exception']) {
        $exception = $ErrorRecord.Exception
    }
    for ($depth = 0; $null -ne $exception -and $depth -lt 12; $depth++) {
        if ($null -ne $exception.PSObject.Properties['ErrorRecord'] -and
            $null -ne $exception.ErrorRecord) {
            $ids += [string]$exception.ErrorRecord.FullyQualifiedErrorId
        }
        $codes = @()
        if ($exception -is [ComponentModel.Win32Exception]) {
            $codes += [int64]$exception.NativeErrorCode
        }
        $codes += [int64]([int64]$exception.HResult -band 0xffffffffL)
        foreach ($code in $codes) {
            switch ($code) {
                1260 { $win32 = '1260'; $policy = 'applocker_or_srp' }
                2147943660 { $win32 = '1260'; $policy = 'applocker_or_srp' } # 0x800704EC
                4551 { $win32 = '4551'; $policy = 'wdac_or_smart_app_control' }
                2147946951 { $win32 = '4551'; $policy = 'wdac_or_smart_app_control' } # 0x800711C7
                225 { $win32 = '225'; $policy = 'defender_or_asr' }
                2147942625 { $win32 = '225'; $policy = 'defender_or_asr' } # 0x800700E1
                112 { if ($policy -eq '') { $win32 = '112'; $ioFailure = $true } }
                2147942512 { if ($policy -eq '') { $win32 = '112'; $ioFailure = $true } } # 0x80070070
            }
        }
        if ($exception -is [IO.IOException]) {
            $ioFailure = $true
        }
        $exception = $exception.InnerException
    }
    if ($policy -eq '' -and
        @($ids | Microsoft.PowerShell.Core\Where-Object {
                $_ -like '*ScriptContainedMaliciousContent*'
            }).Count -gt 0) {
        $policy = 'amsi'
    }
    if ($policy -eq '' -and $ioFailure) {
        $policy = 'compiler_temp_unusable'
    }
    if ($policy -eq '') {
        return $null
    }
    $compiler = $Path
    if ([string]::IsNullOrWhiteSpace($compiler)) {
        try {
            $compiler = [IO.Path]::Combine(
                [Runtime.InteropServices.RuntimeEnvironment]::GetRuntimeDirectory(),
                'csc.exe'
            )
        }
        catch {
            $compiler = 'csc.exe'
        }
    }
    $fields = @{
        check  = $Check
        path   = $compiler
        policy = $policy
        win32  = $win32
    }
    $logEvent = Get-DefenseClawPolicyBlockEvent -Policy $policy
    if (-not [string]::IsNullOrWhiteSpace($logEvent)) {
        $fields['event'] = $logEvent
    }
    return (Format-DefenseClawResilienceEvent `
        -Marker defenseclaw_prereq `
        -Fields $fields)
}

# Best effort: the most recent matching block in the last two minutes, named by
# log and event ID. Never throws and never decides the verdict.
function Get-DefenseClawPolicyBlockEvent {
    param([string]$Policy)
    $candidates = switch ($Policy) {
        'applocker_or_srp' {
            @(
                @('Microsoft-Windows-AppLocker/EXE and DLL', 8004),
                @('Application', 866)
            )
        }
        'wdac_or_smart_app_control' {
            @(, @('Microsoft-Windows-CodeIntegrity/Operational', 3077))
        }
        'defender_or_asr' {
            @(
                @('Microsoft-Windows-Windows Defender/Operational', 1121),
                @('Microsoft-Windows-Windows Defender/Operational', 1116)
            )
        }
        default { @() }
    }
    foreach ($candidate in @($candidates)) {
        try {
            $found = @(Microsoft.PowerShell.Diagnostics\Get-WinEvent `
                -FilterHashtable @{
                    LogName   = [string]$candidate[0]
                    Id        = [int]$candidate[1]
                    StartTime = [DateTime]::Now.AddMinutes(-2)
                } `
                -MaxEvents 1 `
                -ErrorAction Stop)
            if ($found.Count -gt 0) {
                return ('{0} {1}' -f $candidate[0], $candidate[1])
            }
        }
        catch {
        }
    }
    return ''
}

