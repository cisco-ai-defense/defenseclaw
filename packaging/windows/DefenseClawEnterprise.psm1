function Get-DefenseClawGuardianDiagnosticAccountLabel {
    # A Windows guardian row carries only the account's SID: name it as the
    # other Windows notices do, "DOMAIN\user (SID)", and keep the bare SID
    # when it does not resolve (GAP-2290). One lookup per SID per diagnostic.
    param(
        [Parameter(Mandatory)][string]$Sid,
        [Parameter(Mandatory)][hashtable]$Cache
    )
    if ($Cache.ContainsKey($Sid)) {
        return [string]$Cache[$Sid]
    }
    $label = $Sid
    try {
        $account = [Security.Principal.SecurityIdentifier]::new($Sid).Translate(
            [Security.Principal.NTAccount]).Value
        if (-not [string]::IsNullOrWhiteSpace($account)) {
            $label = "$account ($Sid)"
        }
    }
    catch {
        $label = $Sid
    }
    $Cache[$Sid] = $label
    return $label
}

function Get-DefenseClawGuardianVerificationFailureDiagnostic {
    param([Parameter(Mandatory)]$Probe)

    $report = $null
    foreach ($line in @($Probe.output)) {
        $text = ([string]$line).Trim()
        if (-not $text.StartsWith('{')) {
            continue
        }
        try {
            $candidate = $text |
                Microsoft.PowerShell.Utility\ConvertFrom-Json
            $okProperty = $candidate.PSObject.Properties['ok']
            if ($null -ne $okProperty -and
                $okProperty.Value -is [bool]) {
                $report = $candidate
                break
            }
        }
        catch {
            continue
        }
    }

    if ($null -eq $report) {
        $rawOutput = $Probe.output |
            Microsoft.PowerShell.Utility\Out-String
        return ConvertTo-DefenseClawBoundedDiagnostic -Value (
            "verifier exited $([int]$Probe.exit_code) without a valid " +
            "JSON report: $rawOutput"
        )
    }

    $issues = [Collections.Generic.List[string]]::new()
    $pendingCount = 0
    $accountLabels = @{}
    $resultsProperty = $report.PSObject.Properties['results']
    if ($null -ne $resultsProperty) {
        foreach ($row in @($resultsProperty.Value)) {
            if ($null -eq $row) {
                continue
            }
            $rowOK = $row.PSObject.Properties['ok']
            if ($null -ne $rowOK -and
                $rowOK.Value -is [bool] -and
                [bool]$rowOK.Value) {
                continue
            }
            # A deferred row of a signed-out account is pending, not a
            # failure: list it after the real causes (GAP-1940).
            $pendingProperty = $row.PSObject.Properties['pending']
            if ($null -ne $pendingProperty -and
                $pendingProperty.Value -is [bool] -and
                [bool]$pendingProperty.Value) {
                $pendingCount++
                continue
            }

            $connectorProperty = $row.PSObject.Properties['connector']
            $label = if ($null -ne $connectorProperty -and
                -not [string]::IsNullOrWhiteSpace(
                    [string]$connectorProperty.Value
                )) {
                [string]$connectorProperty.Value
            }
            else {
                'target'
            }
            foreach ($identityName in @('sid', 'user', 'user_home')) {
                $identityProperty = $row.PSObject.Properties[$identityName]
                if ($null -ne $identityProperty -and
                    -not [string]::IsNullOrWhiteSpace(
                        [string]$identityProperty.Value
                    )) {
                    $identity = [string]$identityProperty.Value
                    if ($identityName -eq 'sid') {
                        $identity = Get-DefenseClawGuardianDiagnosticAccountLabel `
                            -Sid $identity `
                            -Cache $accountLabels
                    }
                    $label += "@$identity"
                    break
                }
            }

            $errorProperty = $row.PSObject.Properties['error']
            $detail = if ($null -eq $rowOK -or
                $rowOK.Value -isnot [bool]) {
                'verifier result is missing boolean ok'
            }
            elseif ($null -ne $errorProperty -and
                -not [string]::IsNullOrWhiteSpace(
                    [string]$errorProperty.Value
                )) {
                [string]$errorProperty.Value
            }
            else {
                'verification failed without a target error'
            }
            $issues.Add("${label}: $detail")
        }
    }

    $authorizationProperty = $report.PSObject.Properties['authorization_error']
    if ($null -ne $authorizationProperty -and
        -not [string]::IsNullOrWhiteSpace(
            [string]$authorizationProperty.Value
        )) {
        $issues.Add(
            "protected authorization: $([string]$authorizationProperty.Value)"
        )
    }
    if ($issues.Count -eq 0) {
        $issues.Add(
            'verifier reported failure without a per-target diagnostic'
        )
    }
    if ($pendingCount -gt 0) {
        $issues.Add(
            "$pendingCount target(s) of signed-out accounts are pending " +
            'until those accounts sign in (not failures)'
        )
    }
    return ConvertTo-DefenseClawBoundedDiagnostic -Value ($issues -join '; ')
}

function Invoke-DefenseClawGuardianReadinessCommand {
    <#
        Runs the installed gateway's guardian proof. A gateway from before
        enterprise hooks readiness existed (1.0.2, which a recovery of an
        interrupted lifecycle can put back) refuses that verb as 'unknown
        flag: --manifest'; its own release proved readiness with verify, so
        that answer is taken instead of failing the recovered deployment
        (GAP-1886). Any other failure is the gateway's answer.
    #>
    param(
        [Parameter(Mandatory)][hashtable]$Layout,
        [Parameter(Mandatory)][string]$GatewayServiceName,
        [Parameter(Mandatory)][string]$Verb
    )
    $probe = Invoke-DefenseClawGatewayCommand `
        -Layout $Layout `
        -GatewayServiceName $GatewayServiceName `
        -Arguments @('enterprise', 'hooks', $Verb, '--manifest', $Layout.ManifestPath, '--json') `
        -Capture `
        -AllowFailure
    if ($Verb -ceq 'readiness' -and [int]$probe.exit_code -ne 0 -and
        (($probe.output | Microsoft.PowerShell.Utility\Out-String) -match 'unknown flag: --manifest|unknown command "readiness"')) {
        $probe = Invoke-DefenseClawGatewayCommand `
            -Layout $Layout `
            -GatewayServiceName $GatewayServiceName `
            -Arguments @('enterprise', 'hooks', 'verify', '--manifest', $Layout.ManifestPath, '--json') `
            -Capture `
            -AllowFailure
    }
    return $probe
}

function Get-DefenseClawGuardianReadinessProbe {
    param(
        [Parameter(Mandatory)][hashtable]$Layout,
        [Parameter(Mandatory)][string]$GatewayServiceName,
        [Parameter(Mandatory)][string]$GuardianServiceName,
        [switch]$LiveVerify,
        # As in Wait-DefenseClawFreshGuardianReconcile: a complete reconcile
        # whose only problem is failed targets is accepted (rollback restores it;
        # activation runs degraded). With -LiveVerify, only Guardian-failed targets.
        [switch]$AllowFailedTargets,
        [string[]]$AllowedFailedTargetSIDs
    )
    $service = Microsoft.PowerShell.Management\Get-Service -Name $GuardianServiceName -ErrorAction SilentlyContinue
    if ($null -eq $service -or
        $service.Status -ne [ServiceProcess.ServiceControllerStatus]::Running) {
        return [pscustomobject][ordered]@{
            ready = $false
            diagnostic = 'guardian service is not running'
        }
    }
    $verb = if ($LiveVerify) {
        if (Test-DefenseClawStandaloneProfile) { 'readiness' } else { 'verify' }
    }
    else { 'status' }
    $probe = Invoke-DefenseClawGuardianReadinessCommand `
        -Layout $Layout `
        -GatewayServiceName $GatewayServiceName `
        -Verb $verb
    $ready = [int]$probe.exit_code -eq 0
    if (-not $ready -and $AllowFailedTargets) {
        $report = Get-DefenseClawGuardianStatusReport `
            -Layout $Layout `
            -GatewayServiceName $GatewayServiceName
        if ((Test-DefenseClawGuardianReportCompletedWithFailedTargets -Report $report) -and
            (Test-DefenseClawGuardianFailedTargetsWithinSIDs `
                -Report $report -AllowedSIDs $AllowedFailedTargetSIDs)) {
            $accepted = -not $LiveVerify
            if ($LiveVerify) {
                # A live verify may fail only on the targets the Guardian
                # itself reported failed; a failure on a target it reported
                # healthy is real drift and is not excused.
                # The degraded reconcile also wrote an incomplete
                # authorization, which verify reports by count, and under it
                # verify reports a signed-out (pending) target as failed too.
                # Both are excused only within the Guardian's own failed and
                # pending targets from the same fresh status report.
                $guardianFailed = @(Get-DefenseClawGuardianFailedTargets -Report $report)
                $guardianPending = @(Get-DefenseClawGuardianPendingTargets -Report $report)
                $verifyKeys = Get-DefenseClawVerifyFailedTargetKeys `
                    -Probe $probe `
                    -GuardianFailedTargetCount $guardianFailed.Count `
                    -GuardianPendingTargetCount $guardianPending.Count
                if ($null -ne $verifyKeys) {
                    $guardianKeys = [Collections.Generic.HashSet[string]]::new(
                        [StringComparer]::Ordinal
                    )
                    foreach ($target in @($guardianFailed) + @($guardianPending)) {
                        [void]$guardianKeys.Add(('{0}|{1}' -f ([string]$target.connector).ToLowerInvariant(), ([string]$target.sid).ToUpperInvariant()))
                    }
                    $accepted = $true
                    foreach ($key in @($verifyKeys)) {
                        if (-not $guardianKeys.Contains([string]$key)) {
                            $accepted = $false
                            break
                        }
                    }
                }
            }
            if ($accepted) {
                Write-DefenseClawGuardianDegradedTargets -Report $report
                return [pscustomobject][ordered]@{
                    ready = $true
                    diagnostic = 'guardian completed a reconcile with failed targets; accepted as degraded'
                }
            }
        }
    }
    return [pscustomobject][ordered]@{
        ready = $ready
        diagnostic = if ($ready) {
            ''
        }
        else {
            Get-DefenseClawGuardianVerificationFailureDiagnostic `
                -Probe $probe
        }
    }
}

function Test-DefenseClawGuardianReady {
    param(
        [Parameter(Mandatory)][hashtable]$Layout,
        [Parameter(Mandatory)][string]$GatewayServiceName,
        [Parameter(Mandatory)][string]$GuardianServiceName,
        [switch]$LiveVerify,
        [switch]$AllowFailedTargets,
        [string[]]$AllowedFailedTargetSIDs
    )
    $readiness = Get-DefenseClawGuardianReadinessProbe `
        -Layout $Layout `
        -GatewayServiceName $GatewayServiceName `
        -GuardianServiceName $GuardianServiceName `
        -LiveVerify:$LiveVerify `
        -AllowFailedTargets:$AllowFailedTargets `
        -AllowedFailedTargetSIDs $AllowedFailedTargetSIDs
    return [bool]$readiness.ready
}

function Wait-DefenseClawEnterpriseReadiness {
    param(
        [Parameter(Mandatory)][hashtable]$Layout,
        [Parameter(Mandatory)][string]$GatewayServiceName,
        [Parameter(Mandatory)][string]$GuardianServiceName,
        [bool]$RequireBroker = $true,
        [bool]$RequireEnumerator = $true,
        [int]$TimeoutSeconds = 90,
        # Rollback, recovery and activation; see Get-DefenseClawGuardianReadinessProbe.
        [switch]$AllowFailedTargets,
        [string[]]$AllowedFailedTargetSIDs
    )
    $deadline = [DateTime]::UtcNow.AddSeconds($TimeoutSeconds)
    Write-DefenseClawLifecyclePhase -Stage 'enterprise readiness wait'
    $brokerReady = $false
    $gatewayReady = $false
    $guardianReady = $false
    $enumeratorReady = $false
    $enumeratorServiceName = Get-DefenseClawEnumeratorServiceName `
        -GuardianServiceName $GuardianServiceName
    do {
        if ((Test-DefenseClawLayoutBrokerEnabled -Layout $Layout)) {
            $broker = Microsoft.PowerShell.Management\Get-Service `
                -Name $Layout.BrokerServiceName `
                -ErrorAction SilentlyContinue
            $brokerReady = $null -ne $broker -and
                $broker.Status -eq [ServiceProcess.ServiceControllerStatus]::Running
        }
        else {
            # The standalone profile has no credential broker to wait for.
            $brokerReady = $true
        }
        $gatewayReady = (-not $RequireBroker -or $brokerReady) -and
            (Test-DefenseClawGatewayReady `
                -Layout $Layout `
                -GatewayServiceName $GatewayServiceName)
        if ($gatewayReady) {
            $guardianReady = Test-DefenseClawGuardianReady `
                -Layout $Layout `
                -GatewayServiceName $GatewayServiceName `
                -GuardianServiceName $GuardianServiceName `
                -AllowFailedTargets:$AllowFailedTargets `
                -AllowedFailedTargetSIDs $AllowedFailedTargetSIDs
        }
        $enumerator = Microsoft.PowerShell.Management\Get-Service `
            -Name $enumeratorServiceName `
            -ErrorAction SilentlyContinue
        $enumeratorReady = $null -ne $enumerator -and
            $enumerator.Status -eq [ServiceProcess.ServiceControllerStatus]::Running
        if ((-not $RequireBroker -or $brokerReady) -and
            $gatewayReady -and $guardianReady -and
            (-not $RequireEnumerator -or $enumeratorReady)) {
            Write-DefenseClawLifecyclePhase -Stage 'enterprise readiness complete'
            return
        }
        Microsoft.PowerShell.Utility\Start-Sleep -Milliseconds 500
    } while ([DateTime]::UtcNow -lt $deadline)
    $message = "enterprise readiness timed out: broker_required=$RequireBroker broker_ready=$brokerReady gateway_ready=$gatewayReady guardian_ready=$guardianReady enumerator_required=$RequireEnumerator enumerator_ready=$enumeratorReady"
    $gatewayLogPath = [string]$Layout['GatewayLogPath']
    if (-not $gatewayReady -and -not [string]::IsNullOrEmpty($gatewayLogPath) -and
        $null -ne $script:DefenseClawServiceLogOffsets -and
        $script:DefenseClawServiceLogOffsets.ContainsKey($gatewayLogPath)) {
        $logged = Get-DefenseClawStandaloneServiceLoggedError -LogPath $gatewayLogPath
        if (-not [string]::IsNullOrEmpty($logged)) {
            $message += "; the gateway logged: $logged"
        }
    }
    throw $message
}

function Get-DefenseClawOptionalPropertyValues {
    param(
        [Parameter(Mandatory)][object]$Properties,
        [Parameter(Mandatory)][string]$Name
    )
    $property = $Properties.PSObject.Properties[$Name]
    if ($null -eq $property) {
        return
    }
    return @($property.Value)
}

# True when two service ImagePath values name the same executable: quoting,
# case, short names and redundant segments differ, the file does not.
function Test-DefenseClawServiceImageSameFile {
    param(
        [Parameter(Mandatory)][AllowEmptyString()][string]$Actual,
        [Parameter(Mandatory)][string]$Expected
    )
    $split = {
        param([string]$Value)
        $text = $Value.Trim()
        if ($text.StartsWith('"')) {
            $end = $text.IndexOf('"', 1)
            if ($end -lt 1) {
                return $null
            }
            return @($text.Substring(1, $end - 1), $text.Substring($end + 1).Trim())
        }
        $space = $text.IndexOf(' ')
        if ($space -lt 0) {
            return @($text, '')
        }
        return @($text.Substring(0, $space), $text.Substring($space + 1).Trim())
    }
    $actualParts = & $split $Actual
    $expectedParts = & $split $Expected
    if ($null -eq $actualParts -or $null -eq $expectedParts -or
        -not [string]::Equals([string]$actualParts[1], [string]$expectedParts[1], [StringComparison]::Ordinal)) {
        return $false
    }
    try {
        $nativeSecurity = Initialize-DefenseClawNativeSecurity
        $actualIdentity = [string]$nativeSecurity::GetFileIdentity([string]$actualParts[0])
        $expectedIdentity = [string]$nativeSecurity::GetFileIdentity([string]$expectedParts[0])
        return (-not [string]::IsNullOrEmpty($actualIdentity) -and $actualIdentity -ceq $expectedIdentity)
    }
    catch {
        return $false
    }
}

# Resolves a service logon name to its SID, or '' when it does not resolve.
function ConvertTo-DefenseClawServiceAccountSID {
    param([Parameter(Mandatory)][AllowEmptyString()][string]$Account)
    switch -Regex ($Account.Trim()) {
        '^(?i)(LocalSystem|NT AUTHORITY\\SYSTEM|\.\\LocalSystem)$' { return $script:SystemSID }
        '^(?i)(NT AUTHORITY\\LocalService)$' { return 'S-1-5-19' }
        '^(?i)(NT AUTHORITY\\NetworkService)$' { return 'S-1-5-20' }
    }
    try {
        $sid = ConvertTo-DefenseClawSID -Identity $Account
        if ([string]$sid -like 'UNRESOLVED:*') {
            return ''
        }
        return [string]$sid
    }
    catch {
        return ''
    }
}

function Assert-DefenseClawServiceConfiguration {
    param(
        [Parameter(Mandatory)][string]$Name,
        [Parameter(Mandatory)][string]$ExpectedImage,
        [Parameter(Mandatory)][string[]]$ExpectedAccount,
        [Parameter(Mandatory)][string]$ExpectedDisplayName,
        [Parameter(Mandatory)][int]$ExpectedSidType,
        [Parameter(Mandatory)][string[]]$ExpectedPrivileges,
        [Parameter(Mandatory)][AllowEmptyCollection()][string[]]$ExpectedEnvironment,
        [string[]]$ExpectedDependencies = @(),
        [ValidateSet(2, 3, 4)]
        [int[]]$ExpectedStartMode = @(2)
    )
    if (-not (Test-DefenseClawServiceExists -Name $Name)) {
        throw "required Windows service is missing: $Name"
    }
    $key = "HKLM:\SYSTEM\CurrentControlSet\Services\$Name"
    $properties = Microsoft.PowerShell.Management\Get-ItemProperty -LiteralPath $key
    $strict = Test-DefenseClawTrustStrictAncestors
    # Cosmetic and recovery fields are repaired by Install, Upgrade, Repair
    # and Reconcile; here a difference is recorded, not fatal, outside the
    # strict pin. Identity (image, account, SID type, privileges) stays exact.
    $acceptDrift = {
        param([string]$Reason)
        if ($strict) {
            throw $Reason
        }
        Write-DefenseClawResilienceEvent -Marker defenseclaw_accept -Fields @{
            service = $Name
            reason  = $Reason
        }
    }
    if (-not [string]::Equals([string]$properties.ImagePath, $ExpectedImage, [StringComparison]::OrdinalIgnoreCase)) {
        if ($strict -or -not (Test-DefenseClawServiceImageSameFile `
                -Actual ([string]$properties.ImagePath) `
                -Expected $ExpectedImage)) {
            throw "service $Name ImagePath drift: $($properties.ImagePath)"
        }
        & $acceptDrift "service $Name ImagePath is spelled differently but names the same file: $($properties.ImagePath)"
    }
    $accountMatches = @(
        $ExpectedAccount |
            Microsoft.PowerShell.Core\Where-Object {
                [string]::Equals(
                    [string]$properties.ObjectName,
                    [string]$_,
                    [StringComparison]::OrdinalIgnoreCase
                )
            }
    )
    if ($accountMatches.Count -eq 0) {
        $actualAccountSID = ConvertTo-DefenseClawServiceAccountSID -Account ([string]$properties.ObjectName)
        $sidMatches = @(
            $ExpectedAccount |
                Microsoft.PowerShell.Core\Where-Object {
                    -not [string]::IsNullOrEmpty($actualAccountSID) -and
                    (ConvertTo-DefenseClawServiceAccountSID -Account ([string]$_)) -ceq $actualAccountSID
                }
        )
        if ($strict -or $sidMatches.Count -eq 0) {
            throw "service $Name account drift: $($properties.ObjectName)"
        }
        & $acceptDrift "service $Name account is spelled differently but is the same principal: $($properties.ObjectName)"
    }
    if (-not [string]::Equals([string]$properties.DisplayName, $ExpectedDisplayName, [StringComparison]::Ordinal)) {
        & $acceptDrift "service $Name display name drift: $($properties.DisplayName)"
    }
    if (-not [string]::Equals([string]$properties.Description, $script:ServiceDescription, [StringComparison]::Ordinal)) {
        & $acceptDrift "service $Name description drift: $($properties.Description)"
    }
    if ([int]$properties.Type -ne 0x10) {
        throw "service $Name is not a Win32 own-process service: Type=$($properties.Type)"
    }
    if ([int]$properties.Start -notin $ExpectedStartMode) {
        if (Test-DefenseClawStandaloneProfile) {
            $actualMode = ConvertTo-DefenseClawServiceStartModeName -StartMode ([int]$properties.Start)
            if ([string]::IsNullOrEmpty($actualMode)) { $actualMode = 'unknown' }
            $expectedModes = @($ExpectedStartMode | Microsoft.PowerShell.Core\ForEach-Object {
                ConvertTo-DefenseClawServiceStartModeName -StartMode $_
            })
            throw "service $Name startup mode drift: $actualMode, expected $($expectedModes -join ' or ')"
        }
        throw "service $Name startup mode drift: $($properties.Start), expected $($ExpectedStartMode -join ' or ')"
    }
    if ([int]$properties.ErrorControl -ne 1) {
        & $acceptDrift "service $Name ErrorControl drift: $($properties.ErrorControl)"
    }
    $delayedProperty = $properties.PSObject.Properties['DelayedAutoStart']
    if ($null -ne $delayedProperty -and [int]$delayedProperty.Value -ne 0) {
        & $acceptDrift "service $Name DelayedAutoStart drift: $($delayedProperty.Value)"
    }
    foreach ($dependencyProperty in @('DependOnGroup', 'Group')) {
        $dependency = $properties.PSObject.Properties[$dependencyProperty]
        if ($null -ne $dependency -and
            @($dependency.Value | Microsoft.PowerShell.Core\Where-Object { -not [string]::IsNullOrWhiteSpace([string]$_) }).Count -gt 0) {
            throw "service $Name has an unexpected $dependencyProperty dependency"
        }
    }
    $actualDependencies = @(
        Get-DefenseClawOptionalPropertyValues -Properties $properties -Name 'DependOnService' |
            Microsoft.PowerShell.Core\Where-Object {
                -not [string]::IsNullOrWhiteSpace([string]$_)
            } |
            Microsoft.PowerShell.Core\ForEach-Object { [string]$_ } |
            Microsoft.PowerShell.Utility\Sort-Object
    )
    $wantedDependencies = @($ExpectedDependencies | Microsoft.PowerShell.Utility\Sort-Object)
    if (($actualDependencies -join "`n") -cne ($wantedDependencies -join "`n")) {
        throw "service $Name dependency drift"
    }
    if ([int]$properties.ServiceSidType -ne $ExpectedSidType) {
        throw "service $Name ServiceSidType drift: $($properties.ServiceSidType), expected $ExpectedSidType"
    }
    $actualPrivileges = @($properties.RequiredPrivileges | Microsoft.PowerShell.Core\ForEach-Object { [string]$_ } | Microsoft.PowerShell.Utility\Sort-Object)
    $wantedPrivileges = @($ExpectedPrivileges | Microsoft.PowerShell.Utility\Sort-Object)
    if (($actualPrivileges -join "`n") -cne ($wantedPrivileges -join "`n")) {
        throw "service $Name required privileges drift: actual=$($actualPrivileges -join ',') expected=$($wantedPrivileges -join ',')"
    }
    $actualFailureActions = [byte[]]$properties.FailureActions
    $expectedFailureActions = Get-DefenseClawFailureActionsBytes
    if ($null -eq $actualFailureActions -or
        [BitConverter]::ToString($actualFailureActions) -cne
            [BitConverter]::ToString($expectedFailureActions)) {
        & $acceptDrift "service $Name failure recovery must repeat restart after 5s/15s/60s with daily reset"
    }
    $nonCrashProperty = $properties.PSObject.Properties['FailureActionsOnNonCrashFailures']
    if ($null -eq $nonCrashProperty -or [int]$nonCrashProperty.Value -ne 1) {
        & $acceptDrift "service $Name does not recover non-crash failures"
    }
    $actualEnvironment = @(
        Get-DefenseClawOptionalPropertyValues -Properties $properties -Name 'Environment' |
            Microsoft.PowerShell.Core\ForEach-Object { [string]$_ } |
            Microsoft.PowerShell.Utility\Sort-Object
    )
    $wantedEnvironment = @($ExpectedEnvironment | Microsoft.PowerShell.Utility\Sort-Object)
    if (($actualEnvironment -join "`n") -cne ($wantedEnvironment -join "`n")) {
        & $acceptDrift "service $Name environment pin drift"
    }
    Assert-DefenseClawServiceRegistryAcl -Name $Name -Repair
    Assert-DefenseClawServiceSecurityDescriptor -Name $Name
}

function Get-DefenseClawServiceDacl {
    param([Parameter(Mandatory)][string]$Name)
    # Read only the DACL natively: READ_CONTROL is all it needs, where sdshow
    # also asks for the SACL and prints localized text on failure. sdshow stays
    # as the fallback when the native helper cannot run.
    try {
        $nativeSecurity = Initialize-DefenseClawNativeSecurity
        $nativeDacl = ([string]$nativeSecurity::GetServiceDaclSddl($Name)).Trim()
        if ($nativeDacl.StartsWith('D:', [StringComparison]::OrdinalIgnoreCase)) {
            return $nativeDacl
        }
    }
    catch {
        Microsoft.PowerShell.Utility\Write-Verbose "native service DACL read failed for $Name, using sc.exe sdshow: $($_.Exception.Message)"
    }
    $sddlOutput = Invoke-DefenseClawNative -File $script:ScExe -Arguments @('sdshow', $Name) -Capture
    $sddlLine = $sddlOutput | Microsoft.PowerShell.Core\Where-Object { [string]$_ -like 'D:*' } | Microsoft.PowerShell.Utility\Select-Object -First 1
    if ($null -eq $sddlLine) {
        throw "service $Name has no readable SCM security descriptor"
    }
    $actualSDDL = ([string]$sddlLine).Trim()
    # sdshow returns the whole descriptor including the SCM-maintained audit
    # section. ServiceSDDL is a DACL, so only the DACL portion is comparable.
    $saclIndex = $actualSDDL.IndexOf('S:', [StringComparison]::OrdinalIgnoreCase)
    if ($saclIndex -ge 0) {
        return $actualSDDL.Substring(0, $saclIndex)
    }
    return $actualSDDL
}

# Returns the first principal outside SYSTEM and Administrators that the
# service DACL lets reconfigure, re-ACL, take or delete the service, or ''.
# -All returns every such principal instead.
function Get-DefenseClawServiceDaclUntrustedWriter {
    param(
        [Parameter(Mandatory)][string]$Dacl,
        [switch]$All
    )
    $descriptor = [Security.AccessControl.RawSecurityDescriptor]::new($Dacl)
    if ($null -eq $descriptor.DiscretionaryAcl) {
        if ($All) {
            return @('null DACL')
        }
        return 'null DACL'
    }
    $writers = [Collections.Generic.List[string]]::new()
    # SERVICE_CHANGE_CONFIG, DELETE, WRITE_DAC, WRITE_OWNER, GENERIC_WRITE and
    # GENERIC_ALL.
    $writeMask = 0x0002L -bor 0x10000L -bor 0x40000L -bor 0x80000L -bor 0x40000000L -bor 0x10000000L
    foreach ($ace in $descriptor.DiscretionaryAcl) {
        if ($ace -isnot [Security.AccessControl.CommonAce] -or
            $ace.AceQualifier -ne [Security.AccessControl.AceQualifier]::AccessAllowed) {
            continue
        }
        $sid = $ace.SecurityIdentifier.Value
        if ($sid -in @($script:SystemSID, $script:AdministratorsSID, $script:TrustedInstallerSID)) {
            continue
        }
        if ((([int64]$ace.AccessMask -band 0xffffffffL) -band $writeMask) -ne 0) {
            if (-not $All) {
                return $sid
            }
            if (-not $writers.Contains($sid)) {
                $writers.Add($sid)
            }
        }
    }
    if ($All) {
        # Each writer goes down the pipeline on its own, so @(...) around a
        # call sees every SID rather than one array-valued item.
        return $writers.ToArray()
    }
    return ''
}

# The installer owns the four services' SCM descriptors, so it re-applies the
# canonical one when an EDR, a GPO System Services template or an admin
# changed it, then judges by write authority rather than string equality. A
# descriptor it cannot read (one that denies Administrators query) is
# re-applied and recorded; one that still lets another principal reconfigure
# the service stays fatal and names that principal.
function Assert-DefenseClawServiceSecurityDescriptor {
    param([Parameter(Mandatory)][string]$Name)
    $strict = Test-DefenseClawTrustStrictAncestors
    $actualDACL = ''
    $readError = ''
    try {
        $actualDACL = Get-DefenseClawServiceDacl -Name $Name
    }
    catch {
        $readError = $_.Exception.Message
    }
    if ([string]::IsNullOrEmpty($readError) -and
        [string]::Equals($actualDACL, $script:ServiceSDDL, [StringComparison]::OrdinalIgnoreCase)) {
        return
    }
    if ($strict) {
        if (-not [string]::IsNullOrEmpty($readError)) {
            throw "service $Name has no readable SCM security descriptor"
        }
        throw "service $Name DACL drift: $actualDACL"
    }
    $before = if ([string]::IsNullOrEmpty($readError)) { $actualDACL } else { $readError }
    try {
        Invoke-DefenseClawNative -File $script:ScExe -Arguments @('sdset', $Name, $script:ServiceSDDL)
        $actualDACL = Get-DefenseClawServiceDacl -Name $Name
        $readError = ''
        Write-DefenseClawResilienceEvent -Marker defenseclaw_repair -Fields @{
            service = $Name
            reason  = "re-applied the canonical SCM descriptor after: $before"
        }
    }
    catch {
        Write-DefenseClawResilienceEvent -Marker defenseclaw_accept -Fields @{
            service = $Name
            reason  = "SCM descriptor could not be re-applied: $($_.Exception.Message)"
        }
    }
    if (-not [string]::IsNullOrEmpty($readError)) {
        Write-DefenseClawResilienceEvent -Marker defenseclaw_accept -Fields @{
            service = $Name
            reason  = "SCM descriptor is unreadable to Administrators: $readError"
        }
        return
    }
    if ([string]::Equals($actualDACL, $script:ServiceSDDL, [StringComparison]::OrdinalIgnoreCase)) {
        return
    }
    $writer = Get-DefenseClawServiceDaclUntrustedWriter -Dacl $actualDACL
    if (-not [string]::IsNullOrEmpty($writer)) {
        # An ordinary session that can change the service config can point
        # binPath anywhere and run it as SYSTEM: fatal even after a repair.
        # Assign first: the helper returns its writers as one array object,
        # which @(...) around the call would hand to foreach as a single item.
        $allWriters = Get-DefenseClawServiceDaclUntrustedWriter -Dacl $actualDACL -All
        foreach ($candidate in @($allWriters)) {
            if (Test-DefenseClawBroadUnprivilegedSid -SID $candidate) {
                throw "untrusted principal $candidate can reconfigure service $Name after the canonical descriptor was re-applied: $actualDACL"
            }
        }
        if (Test-DefenseClawStandaloneProfile) {
            throw "untrusted principal $writer can reconfigure service ${Name}: $actualDACL"
        }
        # Secure Client: the repair above was attempted and did not hold (an
        # EDR or a GPO System Services template re-stamps it). Drift that
        # leaves only a named principal is a boundary fact the installer
        # reports, not a reason to fail the Install; the strict pin threw
        # before the repair.
        Write-DefenseClawResilienceEvent -Marker defenseclaw_boundary -Fields @{
            service = $Name
            reason  = "untrusted principal $writer can reconfigure the service after the canonical descriptor was re-applied: $actualDACL"
        }
        return
    }
    Write-DefenseClawResilienceEvent -Marker defenseclaw_accept -Fields @{
        service = $Name
        reason  = "SCM descriptor differs from the canonical form but grants no untrusted write: $actualDACL"
    }
}

function Assert-DefenseClawManagedServiceConfigurations {
    param(
        [Parameter(Mandatory)][hashtable]$Layout,
        [Parameter(Mandatory)][string]$GatewayServiceName,
        [Parameter(Mandatory)][string]$GuardianServiceName,
        [switch]$PendingTransaction,
        [switch]$ServicingTransaction,
        [switch]$AnyStartMode,
        [string[]]$ExpectedGatewayAccount
    )
    if ($null -eq $ExpectedGatewayAccount -or $ExpectedGatewayAccount.Count -eq 0) {
        $ExpectedGatewayAccount = Get-DefenseClawAcceptedGatewayServiceAccounts `
            -GatewayServiceName $GatewayServiceName
    }
    if ($PendingTransaction -and $ServicingTransaction) {
        throw 'service configuration assertion cannot be both pending-live and servicing'
    }
    if ($AnyStartMode -and ($PendingTransaction -or $ServicingTransaction)) {
        throw 'service configuration assertion cannot accept any start mode inside a transaction'
    }
    # Boot policy is not part of the authorization contract; ImagePath, account,
    # SID type, privileges, environment, and the ACL surfaces are. Teardown
    # accepts any supported mode so a disabled or manually started deployment
    # stays removable.
    $expectedStartMode = if ($ServicingTransaction) {
        @(4)
    }
    elseif ($PendingTransaction) {
        @(3)
    }
    elseif ($AnyStartMode) {
        @(2, 3, 4)
    }
    else {
        @(2)
    }
    $gatewayEnvironment = [string[]]@(
        Get-DefenseClawServiceEnvironmentValues `
            -Name $GatewayServiceName `
            -RuntimeDirectory $Layout.RuntimeDirectory `
            -ConfigPath $Layout.ConfigPath `
            -AuthorizationDirectory $Layout.AuthorizationDirectory `
            -GatewayServiceName $GatewayServiceName `
            -LogPath $Layout.GatewayLogPath `
            -BrokerPipeName $Layout.BrokerPipeName `
            -BrokerServiceName $Layout.BrokerServiceName `
            -BrokerAuthKeyPath $Layout.BrokerAuthKeyPath `
            -AgentApplicationControlAttested:$Layout.AgentApplicationControlAttested `
            -ClaudeEffectivePolicyVerified:$Layout.ClaudeEffectivePolicyVerified
    )
    $guardianEnvironment = [string[]]@(
        Get-DefenseClawServiceEnvironmentValues `
            -Name $GuardianServiceName `
            -RuntimeDirectory $Layout.RuntimeDirectory `
            -ConfigPath $Layout.ConfigPath `
            -AuthorizationDirectory $Layout.AuthorizationDirectory `
            -GatewayServiceName $GatewayServiceName `
            -LogPath $Layout.GuardianLogPath `
            -AgentApplicationControlAttested:$Layout.AgentApplicationControlAttested `
            -ClaudeEffectivePolicyVerified:$Layout.ClaudeEffectivePolicyVerified
    )
    $brokerImage = if ((Test-DefenseClawLayoutBrokerEnabled -Layout $Layout)) {
        Get-DefenseClawCMIDBrokerImage `
            -Layout $Layout `
            -GatewayServiceName $GatewayServiceName
    }
    else {
        ''
    }
    $sensorHelperServiceName = Get-DefenseClawSensorHelperServiceName `
        -GatewayServiceName $GatewayServiceName
    $sensorHelperEnvironment = [string[]]@(
        Get-DefenseClawSensorHelperEnvironmentValues `
            -GatewayServiceName $GatewayServiceName
    )
    if ((Test-DefenseClawLayoutBrokerEnabled -Layout $Layout)) {
        Assert-DefenseClawServiceConfiguration `
            -Name $Layout.BrokerServiceName `
            -ExpectedImage $brokerImage `
            -ExpectedAccount 'LocalSystem' `
            -ExpectedDisplayName 'DefenseClaw Credential Broker' `
            -ExpectedSidType 1 `
            -ExpectedPrivileges @('SeChangeNotifyPrivilege') `
            -ExpectedEnvironment @() `
            -ExpectedStartMode $expectedStartMode
    }
    $gatewayExpectedDependencies = if ((Test-DefenseClawLayoutBrokerEnabled -Layout $Layout)) {
        @($Layout.BrokerServiceName, $sensorHelperServiceName)
    }
    else {
        @($sensorHelperServiceName)
    }
    Assert-DefenseClawServiceConfiguration `
        -Name $sensorHelperServiceName `
        -ExpectedImage (Get-DefenseClawSensorHelperImage -Layout $Layout -GatewayServiceName $GatewayServiceName) `
        -ExpectedAccount 'LocalSystem' `
        -ExpectedDisplayName 'DefenseClaw Sensor Helper' `
        -ExpectedSidType 1 `
        -ExpectedPrivileges @('SeChangeNotifyPrivilege') `
        -ExpectedEnvironment $sensorHelperEnvironment `
        -ExpectedStartMode $expectedStartMode
    Assert-DefenseClawServiceConfiguration `
        -Name $GatewayServiceName `
        -ExpectedImage ('"{0}"' -f $Layout.GatewayPath) `
        -ExpectedAccount $ExpectedGatewayAccount `
        -ExpectedDisplayName 'DefenseClaw Enterprise Gateway' `
        -ExpectedSidType 3 `
        -ExpectedPrivileges @('SeChangeNotifyPrivilege') `
        -ExpectedEnvironment $gatewayEnvironment `
        -ExpectedDependencies $gatewayExpectedDependencies `
        -ExpectedStartMode $expectedStartMode
    Assert-DefenseClawServiceConfiguration `
        -Name $GuardianServiceName `
        -ExpectedImage ('"{0}" enterprise hooks watch --manifest "{1}" --interval 1m' -f $Layout.GatewayPath, $Layout.ManifestPath) `
        -ExpectedAccount 'LocalSystem' `
        -ExpectedDisplayName 'DefenseClaw Enterprise Hook Guardian' `
        -ExpectedSidType 1 `
        -ExpectedPrivileges @(
            'SeTcbPrivilege',
            'SeImpersonatePrivilege',
            'SeChangeNotifyPrivilege',
            'SeBackupPrivilege',
            'SeRestorePrivilege'
        ) `
        -ExpectedEnvironment $guardianEnvironment `
        -ExpectedStartMode $expectedStartMode
    # Enumerator: third service. Same account model + privilege set
    # as the guardian (needs SeImpersonate + SeBackup + SeRestore for
    # per-user profile walks). Shares the guardian's log path — the
    # enumerator records its read-only profile audit there rather than
    # using a separate hook-enumerator.log, matching what LocalSystem can
    # chown without touching a third log-file ACL surface. ImagePath
    # differs from guardian's watch command: `enterprise windows
    # enumerate --manifest <path> --interval 5m`.
    $enumeratorServiceName = Get-DefenseClawEnumeratorServiceName -GuardianServiceName $GuardianServiceName
    $enumeratorEnvironment = [string[]]@(
        Get-DefenseClawServiceEnvironmentValues `
            -Name $enumeratorServiceName `
            -RuntimeDirectory $Layout.RuntimeDirectory `
            -ConfigPath $Layout.ConfigPath `
            -AuthorizationDirectory $Layout.AuthorizationDirectory `
            -GatewayServiceName $GatewayServiceName `
            -LogPath $Layout.GuardianLogPath `
            -AgentApplicationControlAttested:$Layout.AgentApplicationControlAttested `
            -ClaudeEffectivePolicyVerified:$Layout.ClaudeEffectivePolicyVerified
    )
    Assert-DefenseClawServiceConfiguration `
        -Name $enumeratorServiceName `
        -ExpectedImage ('"{0}" enterprise windows enumerate --manifest "{1}" --interval 5m' -f $Layout.GatewayPath, $Layout.ManifestPath) `
        -ExpectedAccount 'LocalSystem' `
        -ExpectedDisplayName 'DefenseClaw Enterprise Hook Enumerator' `
        -ExpectedSidType 1 `
        -ExpectedPrivileges @(
            'SeTcbPrivilege',
            'SeImpersonatePrivilege',
            'SeChangeNotifyPrivilege',
            'SeBackupPrivilege',
            'SeRestorePrivilege'
        ) `
        -ExpectedEnvironment $enumeratorEnvironment `
        -ExpectedStartMode $expectedStartMode
}

function New-DefenseClawRequiredRights {
    param(
        [Parameter(Mandatory)]
        [ValidateSet('Admin', 'Install', 'ServiceInstall', 'State', 'ConfigDirectory', 'Config', 'MachinePolicy', 'AuthorizationDirectory', 'AuthorizationFile', 'Runtime', 'RuntimeSecret', 'ManagedIPCDirectory')]
        [string]$Kind,
        [string]$GatewayServiceSID
    )
    $required = @{}
    $required[$script:SystemSID] = [Security.AccessControl.FileSystemRights]::FullControl
    $required[$script:AdministratorsSID] = [Security.AccessControl.FileSystemRights]::FullControl
    switch ($Kind) {
        'Install' {
            $required[$script:UsersSID] = [Security.AccessControl.FileSystemRights]::ReadAndExecute
        }
        'ServiceInstall' {
            $required[$script:UsersSID] = [Security.AccessControl.FileSystemRights]::ReadAndExecute
            $required[$GatewayServiceSID] = [Security.AccessControl.FileSystemRights]::ReadAndExecute
        }
        'State' {
            $required[$GatewayServiceSID] = [Security.AccessControl.FileSystemRights]::ReadAndExecute
        }
        'ConfigDirectory' {
            $required[$GatewayServiceSID] = [Security.AccessControl.FileSystemRights]::ReadAndExecute
        }
        'Config' {
            $required[$GatewayServiceSID] = [Security.AccessControl.FileSystemRights]::Read
        }
        'MachinePolicy' {
            $required[$script:UsersSID] = [Security.AccessControl.FileSystemRights]::Read
        }
        'AuthorizationDirectory' {
            $required[$GatewayServiceSID] = [Security.AccessControl.FileSystemRights]::ReadAndExecute
        }
        'AuthorizationFile' {
            $required[$GatewayServiceSID] = [Security.AccessControl.FileSystemRights]::Read
        }
        'Runtime' {
            $required[$GatewayServiceSID] = [Security.AccessControl.FileSystemRights]::Modify
        }
        'RuntimeSecret' {
            $required[$GatewayServiceSID] = [Security.AccessControl.FileSystemRights]::Read
        }
        'ManagedIPCDirectory' {
            $required[$GatewayServiceSID] = [Security.AccessControl.FileSystemRights]::FullControl
            $required[$script:AuthenticatedUsersSID] =
                [Security.AccessControl.FileSystemRights]::ReadAndExecute
        }
    }
    return $required
}

function Get-DefenseClawSignedOutUntrustedFolder {
    <#
        Standalone manifest adoption. Returns the DefenseClaw folder of a
        failed guardian row whose only recorded failure is that its account
        is signed out and that folder (<profile>\.defenseclaw or its hooks
        folder) does not carry the owner or permissions DefenseClaw set, or
        '' for any other row (#1105, GAP-0211). The guardian repairs such a
        target only in the account's own Windows session, at its next
        sign-in, so no lifecycle run can fix it, and refusing the run kept
        the whole computer on the older release. A connected account's row,
        a folder of another account or any other failure returns ''.
    #>
    param($Row)
    if ($null -eq $Row) {
        return ''
    }
    $value = {
        param([string]$Name)
        $property = $Row.PSObject.Properties[$Name]
        if ($null -eq $property) {
            return $null
        }
        return $property.Value
    }
    if ([bool](& $value 'ok') -or [bool](& $value 'pending') -or $null -ne (& $value 'result')) {
        return ''
    }
    $profileHome = ([string](& $value 'user_home')).Trim().Replace('/', '\').TrimEnd('\')
    if ([string]::IsNullOrWhiteSpace($profileHome)) {
        return ''
    }
    $found = $script:SignedOutUntrustedFolderPattern.Match(([string](& $value 'error')).Trim())
    if (-not $found.Success) {
        return ''
    }
    $folder = ''
    for ($index = 2; $index -lt $found.Groups.Count; $index++) {
        if ($found.Groups[$index].Success) {
            $folder = $found.Groups[$index].Value
            break
        }
    }
    $dataDir = $profileHome + '\.defenseclaw'
    $candidates = @($dataDir)
    if ($found.Groups[1].Value -ceq 'hook') {
        $candidates = @($dataDir + '\hooks')
    } elseif (-not $found.Groups[1].Success) {
        # The runtime generation check of a Codex or Copilot target reads both
        # folders (GAP-2516).
        $candidates += $dataDir + '\hooks'
    }
    $folder = $folder.Replace('/', '\').TrimEnd('\')
    foreach ($expected in $candidates) {
        if ([string]::Equals($folder, $expected, [StringComparison]::OrdinalIgnoreCase)) {
            return $expected
        }
    }
    return ''
}

# The guardian errors of a failed row whose account folder is a link
# (enterpriseHookAccountLinkFailure, enterpriseHookAccountForeignLinkFailure).
$script:AccountLinkGuardianErrors = @(
    'enterprise hooks: the account''s own DefenseClaw folder link is pending repair',
    'enterprise hooks: the account''s DefenseClaw folder is a link its account does not own; it was left untouched and the account is not protected until an administrator removes the link'
)

# The guardian never writes through a link, so a row whose machine vendor folder
# (Cursor, Codex, Claude Code or a per-user connector's) a link replaced fails
# its reconcile for as long as the link is there. An uninstall keeps that link
# and removes everything else (GAP-0773, GAP-0829), so such a row must not keep
# the adoption of a republished manifest refused. The pattern matches the three
# wordings of that refusal (the Codex machine-policy walk, the enterprise hooks
# chain walk and this module's own) and captures the path they name. The whole
# trimmed message must be one optional prefix and the refusal, as the account
# link errors above are compared whole: a second failure joined to it (a
# trailing '; rollback failed: ...', a newline from errors.Join, or a prefix that
# carries its own failure) is not explained by the link. The path holds no colon
# after its drive letter and no parenthesis, so a tail after it (": rollback
# failed: ...", " (access denied)") ends the match instead of becoming part of
# the path. A failure chained in front of the refusal with a colon ("disk full:
# reconcile failed: reparse point in path: ...") cannot be told apart from an
# error-wrap chain, and is accepted by design.
$script:GuardianMachineFolderLinkPattern = [regex]::new(
    '(?i)\A(?:[^;\r\n]*?:\s+)?reparse points? (?:are not allowed )?in (?:[a-z]+ )*path: (?<path>[a-z]:\\[^;:()\r\n]+?)\s*\z')

function Get-DefenseClawGuardianRowMachineFolderLink {
    <#
        Standalone manifest adoption. Returns the link that keeps a machine
        vendor folder (under ProgramData or Program Files, never DefenseClaw's
        own trees and never a user profile) when a failed guardian row's
        recorded failure is the refusal to write through that link and the
        link is still there, or '' for any other row: a stale failure, a
        path that is no link now, an account folder or any other failure keeps
        the adoption refused.
    #>
    param($Row)
    # Only an uninstall keeps a link, so only an uninstall explains the row. An
    # Upgrade, Repair, Reconcile or Ensure still refuses the link, and a failed
    # guardian row on it keeps the adoption refused.
    if ($null -eq $Row -or -not $script:DefenseClawVendorLinkExcuse) {
        return ''
    }
    $property = $Row.PSObject.Properties['error']
    $okProperty = $Row.PSObject.Properties['ok']
    if ($null -eq $property -or ($null -ne $okProperty -and [bool]$okProperty.Value)) {
        return ''
    }
    $found = $script:GuardianMachineFolderLinkPattern.Match(([string]$property.Value).Trim())
    if (-not $found.Success) {
        return ''
    }
    $path = $found.Groups['path'].Value.Replace('/', '\').TrimEnd('\')
    $roots = @($script:DefenseClawVendorFolderRoots | Microsoft.PowerShell.Core\Where-Object { -not [string]::IsNullOrWhiteSpace($_) })
    foreach ($root in $roots) {
        $prefix = $root.TrimEnd('\') + '\'
        if ($path.StartsWith($prefix, [StringComparison]::OrdinalIgnoreCase)) {
            $relative = $path.Substring($prefix.Length)
            $first = ($relative -split '\\')[0]
            if ($first -ieq 'Cisco') {
                return ''
            }
        }
    }
    try {
        Assert-DefenseClawNoReparsePath -Path $path -AllowMissingLeaf
    }
    catch {
        if ($_.Exception.Message -match '^reparse points are not allowed in managed path: (?<link>.+)$') {
            # The walk names the first link on the path, which can be above the
            # vendor root (ProgramData itself a link). Only a link strictly under a
            # vendor root is the kept vendor folder.
            $link = [string]$Matches['link']
            foreach ($root in $roots) {
                if ($link.Replace('/', '\').StartsWith($root.TrimEnd('\') + '\', [StringComparison]::OrdinalIgnoreCase)) {
                    return $link
                }
            }
        }
    }
    return ''
}

# The folders a machine vendor folder lives under: the trusted machine roots
# (never the process environment). A smoke points it at scratch paths.
$script:DefenseClawVendorFolderRoots = @($script:ProgramData, $script:ProgramFiles)

# True for the length of a standalone Uninstall only: the entry of
# Invoke-DefenseClawEnterpriseLifecycle sets it from the action and the profile,
# so Repair, Reconcile, Ensure, Upgrade and Secure Client leave it false. The
# adoption gate explains a guardian row that failed on a vendor-folder link
# only while it is true.
$script:DefenseClawVendorLinkExcuse = $false

function Get-DefenseClawStandaloneManifestAdoption {
    <#
        Standalone only. The hook enumerator service republishes targets.yaml
        whenever enrollment changes (a new user or agent, an agent update, a
        deferred row), after the last lifecycle transaction bound the
        deployment's managed-hook activation evidence to the manifest it
        activated. The guardian then reconciles the new manifest and records
        its SHA-256 in its protected activation record. When that record, the
        guardian state and the protected authorization describe one complete,
        failure-free reconcile of exactly the installed manifest, the drift is
        the enumerator's own publication that the guardian already activated,
        and the lifecycle may adopt it. Freshness is not required: a stopped
        guardian (a quiesced or recovering transaction) still proves what it
        last activated, and live readiness is probed separately. Anything else
        keeps failing closed. Secure Client deployments never adopt.
    #>
    param(
        [Parameter(Mandatory)][hashtable]$Layout,
        [Parameter(Mandatory)][string]$GatewayServiceName,
        [Parameter(Mandatory)]$Activation,
        [Parameter(Mandatory)][string]$InstalledManifestSHA256,
        [hashtable]$GatewaySource
    )
    $result = {
        param([bool]$Ok, [string]$Reason, [int64]$TargetCount, [string[]]$UntrustedFolders = @())
        return [pscustomobject][ordered]@{
            ok = $Ok
            reason = $Reason
            target_count = $TargetCount
            untrusted_folders = [string[]]@($UntrustedFolders)
        }
    }
    if (-not (Test-DefenseClawStandaloneProfile)) {
        return & $result $false '' -1
    }
    if ([string]$Activation.state -cne 'activated') {
        return & $result $false (
            'the deployment was never activated, so no guardian record can ' +
            'prove the republished manifest'
        ) -1
    }
    # The guardian activates a targets.yaml the enumerator republished within
    # seconds. A verify (an MDM detection run) that came in between failed on
    # that moment; while the file is that recent, give the guardian the time.
    $manifestChangedAt = (Microsoft.PowerShell.Management\Get-Item -LiteralPath $Layout.ManifestPath).LastWriteTimeUtc
    $catchUpDeadline = [DateTime]::UtcNow.AddSeconds($script:ManifestCatchUpWaitSeconds)
    while ($true) {
        $report = Get-DefenseClawGuardianStatusReport `
            -Layout $Layout `
            -GatewayServiceName $GatewayServiceName `
            -GatewaySource $GatewaySource
        $activatedSHA256 = ''
        if ($null -ne $report -and
            $null -ne $report.PSObject.Properties['activation'] -and
            $null -ne $report.activation -and
            $null -ne $report.activation.PSObject.Properties['manifest_sha256']) {
            $activatedSHA256 = [string]$report.activation.manifest_sha256
        }
        $now = [DateTime]::UtcNow
        if ($activatedSHA256 -ceq $InstalledManifestSHA256 -or
            $now -ge $catchUpDeadline -or
            ($now - $manifestChangedAt).TotalSeconds -ge $script:ManifestCatchUpWindowSeconds) {
            break
        }
        Microsoft.PowerShell.Utility\Start-Sleep -Milliseconds $script:ManifestCatchUpPollMilliseconds
    }
    $retry = 'wait for the guardian''s next pass (about a minute) and retry'
    $diagnostic = 'guardian status reported no records'
    if ($null -ne $report -and
        $null -ne $report.PSObject.Properties['errors']) {
        $issues = @($report.errors | Microsoft.PowerShell.Core\Where-Object {
            -not [string]::IsNullOrWhiteSpace([string]$_)
        })
        if ($issues.Count -gt 0) {
            $diagnostic = ConvertTo-DefenseClawBoundedDiagnostic -Value ($issues -join '; ')
        }
    }
    $records = @{}
    foreach ($name in @('activation', 'state', 'authorization')) {
        if ($null -eq $report -or
            $null -eq $report.PSObject.Properties[$name] -or
            $null -eq $report.$name) {
            return & $result $false (
                'the hook enumerator republished targets.yaml and the hook ' +
                "guardian has no protected $name record for it ($diagnostic); $retry"
            ) -1
        }
        $records[$name] = $report.$name
    }
    $field = {
        param($Record, [string]$Name)
        $property = $Record.PSObject.Properties[$Name]
        if ($null -eq $property) {
            return $null
        }
        return $property.Value
    }
    $count = {
        param($Record, [string]$Name)
        $value = & $field $Record $Name
        if ($null -eq $value) {
            # pending_count is omitted when zero.
            if ($Name -ceq 'pending_count') {
                return [int64]0
            }
            return [int64]-1
        }
        try {
            return [Convert]::ToInt64($value)
        }
        catch {
            return [int64]-1
        }
    }
    $stamp = {
        param($Record)
        $value = & $field $Record 'updated_at'
        if ($value -is [DateTime]) {
            return ([DateTime]$value).ToUniversalTime().ToString('o')
        }
        return [string]$value
    }
    $guardianManifestSHA256 = [string](& $field $records.activation 'manifest_sha256')
    if ($guardianManifestSHA256 -cne $InstalledManifestSHA256) {
        return & $result $false (
            'the hook enumerator republished targets.yaml and the hook guardian ' +
            "last activated $guardianManifestSHA256, not the installed " +
            "$InstalledManifestSHA256; $retry"
        ) -1
    }
    # The rows of a deleted account whose profile folder was removed fail
    # every reconcile until the enumerator drops them at its next pass. The
    # guardian status counts them when every failed row is one, and the
    # adoption accepts exactly those failures, as verify and status do.
    $excused = & $count $report 'removed_account_failures'
    if ($excused -lt 0) {
        $excused = [int64]0
    }
    # So do the rows an earlier release protected that wait for their
    # signed-out account's next sign-in, when the guardian repairs them
    # (GAP-0644): status reports them as pending, not protected.
    $awaitingSignIn = & $count $report 'awaiting_sign_in_failures'
    if ($awaitingSignIn -gt 0) {
        $excused += $awaitingSignIn
    }
    $accountLinks = [Math]::Max([int64](& $count $report 'account_link_failures'), [int64]0)
    $excused += $accountLinks
    # A signed-out account remains pending until it signs in; name those
    # accounts and the next step in the adoption result.
    $signedOut = [Collections.Generic.List[string]]::new()
    $otherFailure = $false
    # A signed-out account whose only failure is its DefenseClaw folder's
    # owner or permissions waits for its next sign-in too, when the guardian
    # repairs it: the adoption goes on and names the folder (#1105,
    # GAP-0211). The gateway counts none of these rows (its counts are all
    # or nothing), so the adoption counts them, and the waiting rows with
    # them, itself.
    $untrustedFolders = [Collections.Generic.List[string]]::new()
    $folderRows = [int64]0
    $waitingRows = [int64]0
    # A deleted account's row the guardian reports through the session wait
    # ('user home ... no longer exists') is a removed account, not a
    # signed-out one: repair said to remove its profile and run again, which
    # could never pass because the profile was already gone (GAP-1657).
    $removedRows = [int64]0
    $accountLinkRows = [int64]0
    $machineLinkRows = [int64]0
    foreach ($row in @(& $field $records.state 'results')) {
        if ($null -eq $row -or
            [bool](& $field $row 'ok') -or
            [bool](& $field $row 'pending')) {
            continue
        }
        if ([string](& $field $row 'error') -match 'no longer exists: the account was deleted or its profile folder removed') {
            $removedRows++
            continue
        }
        # The account's own folder link (GAP-0193) and a link another principal
        # owns (GAP-0585) leave only that account unprotected; the guardian
        # counts both in account_link_failures.
        if ($script:AccountLinkGuardianErrors -ccontains [string](& $field $row 'error') -and
            $accountLinks -gt 0) {
            $accountLinkRows++
            continue
        }
        # A machine vendor folder a link replaced (GAP-0773, GAP-0829): the
        # uninstall keeps the link, so the guardian's refusal to write through
        # it is explained and is not another failure.
        if (-not [string]::IsNullOrEmpty((Get-DefenseClawGuardianRowMachineFolderLink -Row $row))) {
            $machineLinkRows++
            continue
        }
        if (([string](& $field $row 'error')).Trim().StartsWith(
                'enterprise hooks: protected target waits for its account''s next sign-in',
                [StringComparison]::Ordinal)) {
            $waitingRows++
        }
        $untrustedFolder = Get-DefenseClawSignedOutUntrustedFolder -Row $row
        if ([string]::IsNullOrEmpty($untrustedFolder) -and
            [string](& $field $row 'error') -notmatch
            'exact active Windows session is unavailable|no active interactive session token matches') {
            $otherFailure = $true
            continue
        }
        $account = [string](& $field $row 'user')
        $sid = [string](& $field $row 'sid')
        if ([string]::IsNullOrWhiteSpace($account) -and -not [string]::IsNullOrWhiteSpace($sid)) {
            # The guardian's row may carry only the SID; name the account.
            try {
                $account = ([Security.Principal.SecurityIdentifier]::new($sid)).Translate(
                    [Security.Principal.NTAccount]).Value
            }
            catch {
                $account = ''
            }
        }
        if ([string]::IsNullOrWhiteSpace($account)) {
            $account = $sid
        }
        elseif (-not [string]::IsNullOrWhiteSpace($sid)) {
            $account = "$account ($sid)"
        }
        if (-not [string]::IsNullOrEmpty($untrustedFolder)) {
            $folderRows++
            $entry = "${account}: $untrustedFolder"
            if (-not $untrustedFolders.Contains($entry)) {
                $untrustedFolders.Add($entry)
            }
            continue
        }
        if (-not $signedOut.Contains($account)) {
            $signedOut.Add($account)
        }
    }
    if ($accountLinkRows -ne $accountLinks) {
        return & $result $false 'the guardian account-link count does not match its failed rows' -1
    }
    if ($removedRows -gt 0) {
        # The gateway may already count them in removed_account_failures.
        $gatewayRemoved = [Math]::Max([int64](& $count $report 'removed_account_failures'), [int64]0)
        if ($gatewayRemoved -lt $removedRows) {
            $excused += $removedRows - $gatewayRemoved
        }
        # Next to a row waiting for its account's next sign-in the gateway
        # counts neither kind (its counts are all or nothing), so the waiting
        # rows are counted here too: a removed profile and a signed-out
        # account kept repair failing (GAP-1657).
        if ($awaitingSignIn -le 0) {
            $excused += $waitingRows
        }
    }
    if ($folderRows -gt 0) {
        # Every failed row must be one of these, a waiting row or a removed
        # account's row; any other failure keeps the adoption refused.
        $excused = $folderRows + $waitingRows + $removedRows + $accountLinkRows
    }
    # The gateway counts none of the rows a machine-folder link explains, so they
    # are added here, beside whatever else the rows above excused.
    $excused += $machineLinkRows
    $nextStep = ''
    if ($signedOut.Count -gt 0 -and -not $otherFailure) {
        $nextStep = (
            'have each of these signed-out accounts sign in, or remove it with its profile, then run ' +
            'this command again: ' + ($signedOut -join ', ') + '. The guardian repairs their ' +
            'DefenseClaw hooks only in their own Windows session'
        )
    }
    $targetCount = & $count $records.activation 'target_count'
    $activationStamp = & $stamp $records.activation
    foreach ($name in @('activation', 'state', 'authorization')) {
        $record = $records[$name]
        $success = & $count $record 'success_count'
        $failure = & $count $record 'failure_count'
        $pending = & $count $record 'pending_count'
        $complete = if ($excused -gt 0) {
            $failure -eq $excused -and $success + $pending + $failure -eq $targetCount
        }
        else {
            [bool](& $field $record 'ok') -and $failure -eq 0 -and $success + $pending -eq $targetCount
        }
        if (-not $complete -or
            $success -lt 0 -or
            $pending -lt 0 -or
            (& $count $record 'target_count') -ne $targetCount -or
            [string]::IsNullOrWhiteSpace($activationStamp) -or
            (& $stamp $record) -cne $activationStamp) {
            $incomplete = (
                'the hook guardian has not completed one failure-free reconcile ' +
                "of the republished targets.yaml ($name record; $diagnostic)"
            )
            if (-not [string]::IsNullOrEmpty($nextStep)) {
                # Only the next step: the guardian's own counts would nest
                # more parentheses into the refusal sentence.
                return & $result $false $nextStep -1
            }
            return & $result $false "$incomplete; $retry" -1
        }
    }
    if ($targetCount -lt 0 -or $targetCount -gt 384) {
        return & $result $false 'guardian activation target count is outside its bound' -1
    }
    return & $result $true '' $targetCount ([string[]]@($untrustedFolders))
}

function Add-DefenseClawSignedOutUntrustedFolders {
    <#
        Keeps the folders an accepted manifest adoption went on without for
        the result (signed_out_untrusted_folders, the
        user_runtime_folder_untrusted warning; #1105, GAP-0211).
    #>
    param($Adoption)
    if ($null -eq $Adoption -or -not [bool]$Adoption.ok) {
        return
    }
    $kept = [Collections.Generic.List[string]]::new()
    foreach ($item in @($script:DefenseClawSignedOutUntrustedFolders)) {
        $kept.Add([string]$item)
    }
    foreach ($item in @($Adoption.untrusted_folders)) {
        $text = ConvertTo-DefenseClawBoundedDiagnostic -Value ([string]$item) -MaxLength 1024
        if ($text.Trim().Length -gt 0 -and -not $kept.Contains($text) -and $kept.Count -lt 256) {
            $kept.Add($text)
        }
    }
    $script:DefenseClawSignedOutUntrustedFolders = @($kept)
}

function Test-DefenseClawInstalledGatewayRecorded {
    <#
        True when the installed gateway exists, is no reparse point and has
        the SHA-256 the deployment metadata records for it. Metadata that
        records no gateway hash keeps the installed gateway. A Repair or
        Upgrade must not run a missing or replaced binary before the
        transaction that restores it (GAP-1417).
    #>
    param(
        [Parameter(Mandatory)][hashtable]$Layout,
        [Parameter(Mandatory)]$Metadata
    )
    $path = [string]$Layout.GatewayPath
    if ([string]::IsNullOrWhiteSpace($path) -or
        -not (Microsoft.PowerShell.Management\Test-Path -LiteralPath $path -PathType Leaf)) {
        return $false
    }
    try {
        Assert-DefenseClawNoReparsePath -Path $path
    }
    catch {
        return $false
    }
    $hashes = $Metadata.PSObject.Properties['hashes']
    if ($null -eq $hashes -or $null -eq $hashes.Value -or
        $null -eq $hashes.Value.PSObject.Properties['gateway']) {
        return $true
    }
    $actual = (
        Microsoft.PowerShell.Utility\Get-FileHash -LiteralPath $path -Algorithm SHA256
    ).Hash
    return [string]::Equals(
        $actual,
        [string]$hashes.Value.gateway,
        [StringComparison]::OrdinalIgnoreCase
    )
}

function Test-DefenseClawTombstoneTeardownArtifactsBindManifest {
    <#
        rel-1-0-6:GAP-0583. Whether every teardown artifact a committed
        uninstall already wrote (the schema-6 teardown journal and the
        managed-hook contract cleanup receipt) names the installed
        targets.yaml and the tombstone's deployment generation. Only then may
        the tombstone be rebound to that manifest: rebinding never makes an
        artifact of another manifest or another deployment match. An
        unreadable artifact keeps the tombstone as recorded, and the strict
        checks that follow give their refusal.
    #>
    param(
        [Parameter(Mandatory)][hashtable]$Layout,
        [Parameter(Mandatory)][string]$ManifestSHA256,
        [Parameter(Mandatory)][string]$DeploymentGenerationID
    )
    foreach ($path in @(
            [string]$Layout.ManagedHooksTeardownJournalPath,
            [string]$Layout.ManagedHookContractCleanupReceiptPath
        )) {
        if ([string]::IsNullOrWhiteSpace($path) -or
            -not (Test-DefenseClawPathPresentNoFollow -Path $path)) {
            continue
        }
        try {
            Assert-DefenseClawNoReparsePath -Path $path
            $artifact = Microsoft.PowerShell.Management\Get-Content `
                -LiteralPath $path `
                -Raw `
                -ErrorAction Stop |
                Microsoft.PowerShell.Utility\ConvertFrom-Json -ErrorAction Stop
        }
        catch {
            return $false
        }
        if ($null -eq $artifact -or
            [string]$artifact.manifest_sha256 -cne $ManifestSHA256 -or
            [string]$artifact.deployment_generation_id -cne $DeploymentGenerationID) {
            return $false
        }
    }
    return $true
}

function Sync-DefenseClawStandaloneUninstallTombstoneBinding {
    <#
        Standalone only (rel-1-0-6:GAP-0583). A committed uninstall, its
        retry, and the Install (Setup /ensure) that first finishes it, rebind
        the inactive tombstone's activation evidence to the installed
        targets.yaml when the guardian had adopted it: the enumerator pass
        after a deleted enrolled account can publish it between the
        uninstall's pre-commit check and its commit. The rule is the one
        Sync-DefenseClawStandaloneManagedHooksActivationBinding applies to an
        installed deployment (guardian adoption, the deployment generation
        and state kept), plus Test-DefenseClawTombstoneTeardownArtifactsBindManifest.
        When the drift cannot be proven it reports the reason and changes
        nothing; the strict binding checks that follow still refuse. Returns
        $true when it rebound: the caller reads the metadata again.
    #>
    param(
        [Parameter(Mandatory)][hashtable]$Layout,
        [Parameter(Mandatory)][string]$GatewayServiceName
    )
    if (-not (Test-DefenseClawStandaloneProfile)) {
        return $false
    }
    try {
        $rebound = Sync-DefenseClawStandaloneManagedHooksActivationBinding `
            -Layout $Layout `
            -GatewayServiceName $GatewayServiceName `
            -AllowUninstallTombstone
    }
    catch {
        Write-DefenseClawLifecyclePhase -Stage (
            'hook targets changed after the uninstall committed, and the guardian has not adopted them: ' +
            "the tombstone keeps its activation evidence ($($_.Exception.Message))"
        )
        return $false
    }
    if ($rebound) {
        Write-DefenseClawLifecyclePhase -Stage 'hook targets changed after the uninstall committed (an enrolled account was deleted or changed): the tombstone activation evidence was rebound to the targets.yaml the guardian adopted'
    }
    return [bool]$rebound
}

function Sync-DefenseClawStandaloneManagedHooksActivationBinding {
    <#
        Standalone only. Runs under the lifecycle lock, after any pending
        transaction was recovered and before Upgrade, Repair, Reconcile or
        Uninstall opens its own transaction; a fresh Install also runs it
        after commit and before journal retirement. When the enumerator has
        republished targets.yaml since the last transaction and the guardian
        has already activated it (Get-DefenseClawStandaloneManifestAdoption), rebind the
        committed activation evidence to that manifest, so every later exact
        binding check of the transaction sees one manifest generation. Only
        manifest_sha256 and target_count change; the state and the deployment
        generation stay as recorded. Returns $true when it rebound.
        GatewaySource is the authenticated replacement gateway of a Repair or
        Upgrade. Their transaction installs it, so it reads the guardian's
        records when the installed gateway is missing or is not the binary
        the deployment recorded (GAP-1417).
        AllowUninstallTombstone (rel-1-0-6:GAP-0583) also rebinds the
        inactive tombstone of a committed uninstall; see
        Sync-DefenseClawStandaloneUninstallTombstoneBinding.
    #>
    param(
        [Parameter(Mandatory)][hashtable]$Layout,
        [Parameter(Mandatory)][string]$GatewayServiceName,
        [hashtable]$GatewaySource,
        [switch]$AllowUninstallTombstone
    )
    if (-not (Test-DefenseClawStandaloneProfile)) {
        return $false
    }
    foreach ($path in @($Layout.PendingPath)) {
        if (Microsoft.PowerShell.Management\Test-Path -LiteralPath $path -PathType Leaf) {
            return $false
        }
    }
    if (-not (Test-DefenseClawDeploymentMetadataPresent -Path $Layout.MetadataPath) -or
        -not (Microsoft.PowerShell.Management\Test-Path -LiteralPath $Layout.ManifestPath -PathType Leaf)) {
        return $false
    }
    $metadata = Get-DefenseClawDeploymentMetadata -Layout $Layout -Required
    if (-not (Test-DefenseClawMetadataInstalled -Metadata $metadata) -and
        -not $AllowUninstallTombstone) {
        return $false
    }
    $activationProperty = $metadata.PSObject.Properties['managed_hooks_activation']
    if ($null -eq $activationProperty -or $null -eq $activationProperty.Value) {
        return $false
    }
    $activation = Assert-DefenseClawManagedHooksActivationRecord `
        -Record $activationProperty.Value
    Assert-DefenseClawNoReparsePath -Path $Layout.ManifestPath
    $installedManifestSHA256 = (
        Microsoft.PowerShell.Utility\Get-FileHash `
            -LiteralPath $Layout.ManifestPath `
            -Algorithm SHA256
    ).Hash.ToLowerInvariant()
    if ([string]$activation.manifest_sha256 -ceq $installedManifestSHA256) {
        return $false
    }
    if (-not (Test-DefenseClawMetadataInstalled -Metadata $metadata) -and
        -not (Test-DefenseClawTombstoneTeardownArtifactsBindManifest `
            -Layout $Layout `
            -ManifestSHA256 $installedManifestSHA256 `
            -DeploymentGenerationID ([string]$activation.deployment_generation_id))) {
        return $false
    }
    $probeGatewaySource = $null
    if ($null -ne $GatewaySource -and
        -not (Test-DefenseClawInstalledGatewayRecorded -Layout $Layout -Metadata $metadata)) {
        $probeGatewaySource = $GatewaySource
    }
    $adoption = Get-DefenseClawStandaloneManifestAdoption `
        -Layout $Layout `
        -GatewayServiceName $GatewayServiceName `
        -Activation $activation `
        -InstalledManifestSHA256 $installedManifestSHA256 `
        -GatewaySource $probeGatewaySource
    if (-not [bool]$adoption.ok) {
        throw (
            'deployment managed-hook activation evidence does not bind installed targets.yaml' +
            " ($([string]$adoption.reason))"
        )
    }
    Add-DefenseClawSignedOutUntrustedFolders -Adoption $adoption
    if ($PSVersionTable.PSVersion.Major -lt 7) {
        throw 'rebinding standalone managed-hook activation evidence requires PowerShell 7'
    }
    # Edit only the two binding fields of the exact committed JSON so every
    # other recorded value keeps its type and text.
    $raw = [IO.File]::ReadAllText($Layout.MetadataPath)
    $document = [System.Text.Json.Nodes.JsonNode]::Parse($raw)
    $record = $document['managed_hooks_activation']
    if ($null -eq $record) {
        throw 'deployment metadata lost its managed-hook activation record while rebinding'
    }
    $record['manifest_sha256'] =
        [System.Text.Json.Nodes.JsonValue]::Create([string]$installedManifestSHA256)
    $record['target_count'] =
        [System.Text.Json.Nodes.JsonValue]::Create([int64]$adoption.target_count)
    $options = [System.Text.Json.JsonSerializerOptions]::new()
    $options.WriteIndented = $true
    $options.Encoder = [System.Text.Encodings.Web.JavaScriptEncoder]::UnsafeRelaxedJsonEscaping
    $json = $document.ToJsonString($options)
    Write-DefenseClawDeploymentMetadataBytes `
        -Path $Layout.MetadataPath `
        -Bytes ([Text.UTF8Encoding]::new($false).GetBytes($json))
    Set-DefenseClawPathAcl `
        -Path $Layout.MetadataPath `
        -Kind AdminFile `
        -GatewayServiceSID $script:AdministratorsSID
    $rebound = Get-DefenseClawDeploymentMetadata -Layout $Layout -Required
    [void](Assert-DefenseClawManagedHooksActivationRecord `
        -Record $rebound.managed_hooks_activation `
        -ExpectedManifestSHA256 $installedManifestSHA256 `
        -ExpectedTargetCount ([int64]$adoption.target_count) `
        -ExpectedDeploymentGenerationID ([string]$activation.deployment_generation_id))
    if ([string]$rebound.managed_hooks_activation.state -cne [string]$activation.state) {
        throw 'rebinding changed the managed-hook activation state'
    }
    return $true
}

function Assert-DefenseClawInstalledArtifacts {
    <#
        Every payload file the deployment metadata records is present and
        matches its recorded hash. Verify and status share it.
    #>
    param(
        [Parameter(Mandatory)][hashtable]$Layout,
        [Parameter(Mandatory)]$Metadata,
        [string]$TransitionHookSHA256 = ''
    )
    if ($TransitionHookSHA256 -ne '' -and
        $TransitionHookSHA256 -cnotmatch '^[0-9a-f]{64}$') {
        throw 'servicing transition hook digest is invalid'
    }
    foreach ($property in $Metadata.hashes.PSObject.Properties) {
        # Must cover every key the hash writer emits.
        $path = switch ($property.Name) {
            'broker' { if ((Test-DefenseClawLayoutBrokerEnabled -Layout $Layout)) { $Layout.BrokerPath } else { $null } }
            'gateway' { $Layout.GatewayPath }
            'acp' { $Layout.ACPPath }
            'hook' { $Layout.HookPath }
            'sensor_helper' { $Layout.SensorHelperPath }
            'compiler' { Get-DefenseClawOptionalLayoutValue -Layout $Layout -Name CompilerPath }
            'cli' { $Layout.CLIPath }
            'installer' { $Layout.InstallerPath }
            'module' { $Layout.ModulePath }
            default { $null }
        }
        if ($null -eq $path -or -not (Microsoft.PowerShell.Management\Test-Path -LiteralPath $path -PathType Leaf)) {
            throw "installed artifact recorded in metadata is missing: $($property.Name)"
        }
        $actualHash = (Microsoft.PowerShell.Utility\Get-FileHash -LiteralPath $path -Algorithm SHA256).Hash.ToLowerInvariant()
        $expectedHash = if ($property.Name -ceq 'hook' -and
            $TransitionHookSHA256 -ne '') {
            $TransitionHookSHA256
        }
        else {
            ([string]$property.Value).ToLowerInvariant()
        }
        if ($actualHash -cne $expectedHash) {
            # Secure Client: code identity is advisory. Record the critical
            # finding with both hashes and keep the deployment running;
            # Install, Upgrade and Repair re-copy the artifact from the signed
            # payload. The standalone profile and the strict pin refuse.
            if ((Test-DefenseClawStandaloneProfile) -or
                (Test-DefenseClawTrustStrictAncestors)) {
                throw "installed artifact hash drift: $($property.Name)"
            }
            Write-DefenseClawResilienceEvent -Marker defenseclaw_boundary -Fields @{
                path     = [string]$path
                artifact = [string]$property.Name
                reason   = 'installed artifact differs from its recorded hash'
                pinned   = $expectedHash
                live     = $actualHash
            }
        }
    }
}

function Assert-DefenseClawEnterpriseDeployment {
    param(
        [Parameter(Mandatory)][hashtable]$Layout,
        [Parameter(Mandatory)][string]$GatewayServiceName,
        [Parameter(Mandatory)][string]$GuardianServiceName,
        [switch]$RequireReadiness,
        [switch]$PendingTransaction,
        [switch]$ServicingTransaction,
        [string]$TransitionHookSHA256 = '',
        # Restore-only: an authenticated servicing preimage that predates the
        # Broker or Enumerator. Ordinary callers keep the full service set.
        [switch]$AllowTransactionRecordedBrokerAbsence,
        [switch]$AllowTransactionRecordedEnumeratorAbsence,
        # Defaults to every supported gateway account; rollback narrows it to
        # the account recorded in the transaction preimage.
        [string[]]$ExpectedGatewayAccount,
        # Install/Upgrade activation: live readiness accepts a completed
        # reconcile whose only failures are user targets the Guardian itself
        # reported failed (see Get-DefenseClawGuardianReadinessProbe).
        [switch]$AcceptDegradedTargets,
        [string[]]$AllowedFailedTargetSIDs
    )
    if ($null -eq $ExpectedGatewayAccount -or $ExpectedGatewayAccount.Count -eq 0) {
        $ExpectedGatewayAccount = Get-DefenseClawAcceptedGatewayServiceAccounts `
            -GatewayServiceName $GatewayServiceName
    }
    if ($PendingTransaction -and $ServicingTransaction) {
        throw 'deployment assertion cannot be both pending-live and servicing'
    }
    if ($RequireReadiness -and $ServicingTransaction) {
        throw 'disabled servicing state cannot satisfy live readiness'
    }
    if ($TransitionHookSHA256 -ne '' -and
        (-not $ServicingTransaction -or -not (Test-DefenseClawStandaloneProfile))) {
        throw 'a transition hook is valid only for standalone transaction restoration'
    }
    if (($AllowTransactionRecordedBrokerAbsence -or
            $AllowTransactionRecordedEnumeratorAbsence) -and
        -not $ServicingTransaction) {
        throw 'managed service absence is valid only while restoring an authenticated servicing preimage'
    }
    $expectedServiceStartMode = if ($ServicingTransaction) {
        4
    }
    elseif ($PendingTransaction) {
        3
    }
    else {
        2
    }
    $metadata = Get-DefenseClawDeploymentMetadata -Layout $Layout -Required
    if (-not (Test-DefenseClawMetadataInstalled -Metadata $metadata)) {
        throw 'DefenseClaw enterprise deployment is recorded as uninstalled'
    }
    Assert-DefenseClawMetadataIdentity `
        -Metadata $metadata `
        -GatewayServiceName $GatewayServiceName `
        -GuardianServiceName $GuardianServiceName
    if (Test-DefenseClawStandaloneProfile) {
        # Verify also serves an installed-host ensure that would otherwise
        # return compliant without opening a transaction. Use the fresh-install
        # key validator here too; an extra reader must never pass that shortcut.
        [void](Get-DefenseClawRedactionKeySecuritySnapshot `
            -Layout $Layout `
            -GatewayServiceSID (Get-DefenseClawServiceSID -ServiceName $GatewayServiceName))
    }
    $managedHooksActivationProperty = $metadata.PSObject.Properties[
        'managed_hooks_activation'
    ]
    if ($null -eq $managedHooksActivationProperty -or
        $null -eq $managedHooksActivationProperty.Value) {
        throw 'deployment metadata is missing protected managed-hook activation evidence'
    }
    $managedHooksActivation =
        Assert-DefenseClawManagedHooksActivationRecord `
            -Record $managedHooksActivationProperty.Value
    $installedManifestSHA256 = (
        Microsoft.PowerShell.Utility\Get-FileHash `
            -LiteralPath $Layout.ManifestPath `
            -Algorithm SHA256
    ).Hash.ToLowerInvariant()
    if ([string]$managedHooksActivation.manifest_sha256 -cne
        $installedManifestSHA256) {
        # Standalone: accept a manifest the enumerator republished after the
        # last transaction once the guardian has activated it exactly.
        $adoption = Get-DefenseClawStandaloneManifestAdoption `
            -Layout $Layout `
            -GatewayServiceName $GatewayServiceName `
            -Activation $managedHooksActivation `
            -InstalledManifestSHA256 $installedManifestSHA256
        if ([bool]$adoption.ok) {
            Add-DefenseClawSignedOutUntrustedFolders -Adoption $adoption
        }
        elseif ((Test-DefenseClawStandaloneProfile) -or
            (Test-DefenseClawTrustStrictAncestors)) {
            $message = 'deployment managed-hook activation evidence does not bind installed targets.yaml'
            if (-not [string]::IsNullOrWhiteSpace([string]$adoption.reason)) {
                $message += " ($([string]$adoption.reason))"
            }
            throw $message
        }
        else {
            # Secure Client: the enumerator legitimately rewrites targets.yaml
            # as users and agents change; the activation pin is evidence, not
            # a gate.
            Write-DefenseClawResilienceEvent -Marker defenseclaw_accept -Fields @{
                path   = [string]$Layout.ManifestPath
                reason = 'managed-hook activation evidence pin differs from installed targets.yaml'
                pinned = [string]$managedHooksActivation.manifest_sha256
                live   = $installedManifestSHA256
            }
        }
    }
    if ($RequireReadiness -and
        [string]$managedHooksActivation.state -cne 'activated') {
        throw 'live readiness requires a protected activated managed-hook deployment state'
    }
    $recordedCodexParent = $metadata.PSObject.Properties['codex_machine_policy_parent']
    if ($null -eq $recordedCodexParent -or
        -not [string]::Equals(
            [IO.Path]::GetFullPath([string]$recordedCodexParent.Value).TrimEnd('\'),
            [IO.Path]::GetFullPath($Layout.CodexMachinePolicyDirectory).TrimEnd('\'),
            [StringComparison]::OrdinalIgnoreCase
    )) {
        throw 'deployment metadata does not pin the exact Codex machine-policy parent'
    }
    foreach ($pair in @(
        @('codex_machine_policy_path', $Layout.CodexMachinePolicyPath),
        @('codex_managed_hooks_directory', $Layout.CodexManagedHooksDirectory),
        @('codex_managed_hooks_state_path', $Layout.CodexManagedHooksStatePath),
        @('codex_requirements_ownership_path', $Layout.CodexRequirementsOwnershipPath),
        @('codex_requirements_acl_backup_path', $Layout.CodexRequirementsAclBackupPath),
        @('agent_application_control_attestation_path', $Layout.AgentApplicationControlAttestationPath)
    )) {
        $property = $metadata.PSObject.Properties[[string]$pair[0]]
        if ($null -eq $property -or
            [string]::IsNullOrWhiteSpace([string]$property.Value)) {
            throw "deployment metadata is missing $($pair[0])"
        }
        $recorded = [IO.Path]::GetFullPath([string]$property.Value).TrimEnd('\')
        $expected = [IO.Path]::GetFullPath([string]$pair[1]).TrimEnd('\')
        if (-not [string]::Equals(
            $recorded,
            $expected,
            [StringComparison]::OrdinalIgnoreCase
        )) {
            throw "deployment metadata $($pair[0]) does not pin the exact installed layout"
        }
    }
    $codexTargetProperty = $metadata.PSObject.Properties[
        'codex_target_enabled'
    ]
    $managedProperty = $metadata.PSObject.Properties[
        'codex_machine_policy_managed'
    ]
    if ($null -eq $codexTargetProperty -or
        $codexTargetProperty.Value -isnot [bool] -or
        $null -eq $managedProperty -or
        $managedProperty.Value -isnot [bool] -or
        [bool]$managedProperty.Value -ne [bool]$codexTargetProperty.Value) {
        throw 'deployment metadata Codex target and machine-policy ownership state disagree'
    }
    $codexTargetEnabled = [bool]$codexTargetProperty.Value
    $cursorTargetProperty = $metadata.PSObject.Properties[
        'cursor_target_enabled'
    ]
    # Schema-1 deployments created before native Cursor support do not carry
    # this field. Their only safe interpretation is Cursor disabled.
    if ($null -ne $cursorTargetProperty -and
        $cursorTargetProperty.Value -isnot [bool]) {
        throw 'deployment metadata has an invalid Cursor target result'
    }
    $cursorTargetEnabled = [bool](
        $null -ne $cursorTargetProperty -and
        [bool]$cursorTargetProperty.Value
    )
    if ($codexTargetEnabled) {
        if ([string]$metadata.codex_machine_policy_sha256 -cnotmatch
            '^[0-9a-f]{64}$') {
            throw 'deployment metadata contains an invalid Codex machine-policy SHA-256'
        }
    }
    elseif (-not [string]::IsNullOrEmpty(
        [string]$metadata.codex_machine_policy_sha256
    )) {
        throw 'Claude-only deployment metadata unexpectedly authenticates a DefenseClaw-managed Codex policy'
    }
    $applicationControlProperty = $metadata.PSObject.Properties[
        'agent_application_control_enforced'
    ]
    $coreCertificationProperty = $metadata.PSObject.Properties[
        'core_hardening_certification'
    ]
    if ($null -eq $applicationControlProperty -or
        $applicationControlProperty.Value -isnot [bool] -or
        $null -eq $coreCertificationProperty -or
        $coreCertificationProperty.Value -isnot [bool] -or
        [bool]$coreCertificationProperty.Value -ne
            [bool]$Layout.CoreHardeningCertification -or
        [string]$metadata.agent_application_control_prerequisite -cne
            $script:AgentApplicationControlPrerequisite) {
        throw 'deployment metadata does not attest the approved-agent application-control prerequisite'
    }
    $approvedClientProperty = $metadata.PSObject.Properties[
        'codex_approved_client_enforced'
    ]
    if ($null -eq $approvedClientProperty -or
        $approvedClientProperty.Value -isnot [bool] -or
        [bool]$approvedClientProperty.Value -ne
            [bool]$applicationControlProperty.Value) {
        throw 'deployment metadata does not attest approved Codex client application control'
    }
    $approvedAgentsProperty = $metadata.PSObject.Properties[
        'approved_agent_clients_enforced'
    ]
    if ($null -eq $approvedAgentsProperty -or
        $approvedAgentsProperty.Value -isnot [bool] -or
        [bool]$approvedAgentsProperty.Value -ne
            [bool]$applicationControlProperty.Value -or
        [string]$metadata.claude_minimum_client_version -cne
            (Get-DefenseClawClaudeMinimumClientVersion)) {
        throw "deployment metadata does not attest approved Claude clients at version $(Get-DefenseClawClaudeMinimumClientVersion) or newer"
    }
    $claudeTargetProperty = $metadata.PSObject.Properties[
        'claude_target_enabled'
    ]
    $claudeEffectiveProperty = $metadata.PSObject.Properties[
        'claude_effective_policy_verified'
    ]
    if ($null -eq $claudeTargetProperty -or
        $claudeTargetProperty.Value -isnot [bool] -or
        $null -eq $claudeEffectiveProperty -or
        $claudeEffectiveProperty.Value -isnot [bool]) {
        throw 'deployment metadata has an invalid Claude target or effective-policy result'
    }
    $securityCompleteProperty = $metadata.PSObject.Properties[
        'security_complete'
    ]
    $externalPrerequisitesProperty = $metadata.PSObject.Properties[
        'external_security_prerequisites_satisfied'
    ]
    $expectedSecurityComplete = [bool](
        ([bool]$claudeTargetProperty.Value -or
            $codexTargetEnabled -or
            $cursorTargetEnabled) -and
        (-not [bool]$claudeTargetProperty.Value -or
            [bool]$claudeEffectiveProperty.Value)
    )
    if ($null -eq $securityCompleteProperty -or
        $securityCompleteProperty.Value -isnot [bool] -or
        $null -eq $externalPrerequisitesProperty -or
        $externalPrerequisitesProperty.Value -isnot [bool] -or
        [bool]$externalPrerequisitesProperty.Value -ne
            $expectedSecurityComplete -or
        [bool]$securityCompleteProperty.Value -ne $expectedSecurityComplete -or
        ([bool]$securityCompleteProperty.Value -and
            [bool]$Layout.CoreHardeningCertification)) {
        throw 'deployment metadata has an invalid aggregate Windows enterprise security result'
    }
    $Layout.AgentApplicationControlAttested = [bool](
        $applicationControlProperty.Value
    )
    $Layout.ClaudeTargetEnabled = [bool]$claudeTargetProperty.Value
    $Layout.CodexTargetEnabled = $codexTargetEnabled
    $Layout.CursorTargetEnabled = $cursorTargetEnabled
    $recordedAttestationHash = [string]$metadata.agent_application_control_attestation_sha256
    if ([bool]$Layout.CoreHardeningCertification) {
        if ((Microsoft.PowerShell.Management\Test-Path `
                -LiteralPath $Layout.AgentApplicationControlAttestationPath) -or
            -not [string]::IsNullOrEmpty($recordedAttestationHash)) {
            throw 'core-hardening deployment retains false external application-control evidence'
        }
        $Layout.ClaudeEffectivePolicyVerified = [bool](
            $metadata.claude_effective_policy_verified
        )
    }
    else {
        $attestation = Get-DefenseClawAgentApplicationControlAttestation -Layout $Layout
        if ([bool]$attestation.agent_application_control_enforced -ne
            [bool]$metadata.agent_application_control_enforced) {
            throw 'protected application-control evidence disagrees with deployment metadata'
        }
        if ([bool]$attestation.claude_effective_policy_verified -ne
            [bool]$metadata.claude_effective_policy_verified) {
            throw 'protected Claude effective-policy evidence disagrees with deployment metadata'
        }
        $Layout.ClaudeEffectivePolicyVerified = [bool](
            $attestation.claude_effective_policy_verified
        )
        if (Test-DefenseClawStandaloneProfile) {
            $Layout['ClaudeEffectivePolicyStaleReason'] = [string](
                $attestation.claude_effective_policy_stale_reason
            )
        }
        if ($recordedAttestationHash -cnotmatch '^[0-9a-f]{64}$') {
            throw 'deployment metadata contains an invalid agent application-control attestation SHA-256'
        }
        $actualAttestationHash = (
            Microsoft.PowerShell.Utility\Get-FileHash `
                -LiteralPath $Layout.AgentApplicationControlAttestationPath `
                -Algorithm SHA256
        ).Hash.ToLowerInvariant()
        if ($actualAttestationHash -cne $recordedAttestationHash) {
            if (Test-DefenseClawTrustStrictAncestors) {
                throw 'agent application-control attestation hash drift'
            }
            Write-DefenseClawResilienceEvent -Marker defenseclaw_accept -Fields @{
                path   = [string]$Layout.AgentApplicationControlAttestationPath
                reason = 'agent application-control attestation differs from its recorded pin'
                pinned = $recordedAttestationHash
                live   = $actualAttestationHash
            }
        }
    }
    if ($codexTargetEnabled) {
        Assert-DefenseClawCodexMachinePolicyDirectory `
            -Path $Layout.CodexVendorDirectory
        Assert-DefenseClawCodexMachinePolicyDirectory `
            -Path $Layout.CodexMachinePolicyDirectory
        Assert-DefenseClawCodexMachinePolicyFile -Layout $Layout
        Assert-DefenseClawCodexManagedHooksStateFile -Layout $Layout
        [void](Get-DefenseClawCodexRequirementsAclBackup -Layout $Layout)
    }
    else {
        foreach ($ownedPath in @(
            $Layout.CodexRequirementsOwnershipPath,
            $Layout.CodexRequirementsAclBackupPath
        )) {
            if (Microsoft.PowerShell.Management\Test-Path `
                -LiteralPath $ownedPath) {
                throw "Claude-only deployment retains stale DefenseClaw Codex ownership state: $ownedPath"
            }
        }
    }
    $gatewaySID = Get-DefenseClawServiceSID -ServiceName $GatewayServiceName
    $adminWriters = @($script:SystemSID, $script:AdministratorsSID, $script:TrustedInstallerSID)
    $runtimeWriters = @($script:SystemSID, $script:AdministratorsSID, $script:TrustedInstallerSID, $gatewaySID)
    $adminReaders = $adminWriters
    $gatewayReaders = $runtimeWriters
    $adminRights = New-DefenseClawRequiredRights -Kind Admin
    $installRights = New-DefenseClawRequiredRights -Kind Install
    $serviceInstallRights = New-DefenseClawRequiredRights `
        -Kind ServiceInstall `
        -GatewayServiceSID $gatewaySID
    $stateRights = New-DefenseClawRequiredRights -Kind State -GatewayServiceSID $gatewaySID
    $configDirectoryRights = New-DefenseClawRequiredRights `
        -Kind ConfigDirectory `
        -GatewayServiceSID $gatewaySID
    $configRights = New-DefenseClawRequiredRights -Kind Config -GatewayServiceSID $gatewaySID
    $authorizationDirectoryRights = New-DefenseClawRequiredRights `
        -Kind AuthorizationDirectory `
        -GatewayServiceSID $gatewaySID
    $authorizationFileRights = New-DefenseClawRequiredRights `
        -Kind AuthorizationFile `
        -GatewayServiceSID $gatewaySID
    $runtimeRights = New-DefenseClawRequiredRights -Kind Runtime -GatewayServiceSID $gatewaySID
    $managedIPCDirectoryRights = New-DefenseClawRequiredRights `
        -Kind ManagedIPCDirectory `
        -GatewayServiceSID $gatewaySID

    # -SelfHealKind on every path below: an orphan NT SERVICE\<prior-service>
    # ACE from a prior unsigned certification run (uninstalled with a
    # different scoped service name) must self-heal via canonical re-stamp
    # instead of blocking Verify/post-install validation. Mirrors the
    # existing StateRoot self-heal below.
    foreach ($path in @($Layout.InstallRoot, $Layout.BinDirectory)) {
        Assert-DefenseClawPathAcl `
            -Path $path `
            -AllowedWriterSIDs $adminWriters `
            -RequiredRights $serviceInstallRights `
            -AllowUsersRead `
            -SelfHealKind InstallDirectory `
            -SelfHealGatewayServiceSID $gatewaySID
    }
    Assert-DefenseClawPathAcl `
        -Path $Layout.LibexecDirectory `
        -AllowedWriterSIDs $adminWriters `
        -RequiredRights $installRights `
        -AllowUsersRead `
        -SelfHealKind InstallDirectory `
        -SelfHealGatewayServiceSID $gatewaySID
    # A kept 1.0.2 Fleet compiler (GAP-0274) stays writable by admins only.
    foreach ($directory in @(
        (Get-DefenseClawOptionalLayoutValue -Layout $Layout -Name CompilerLibDirectory),
        (Get-DefenseClawOptionalLayoutValue -Layout $Layout -Name CompilerDirectory)
    )) {
        if (-not [string]::IsNullOrWhiteSpace([string]$directory) -and
            (Microsoft.PowerShell.Management\Test-Path -LiteralPath $directory -PathType Container)) {
            Assert-DefenseClawPathAcl `
                -Path $directory `
                -AllowedWriterSIDs $adminWriters `
                -RequiredRights $serviceInstallRights `
                -AllowUsersRead
        }
    }
    $compilerPath = Get-DefenseClawOptionalLayoutValue -Layout $Layout -Name CompilerPath
    if (-not [string]::IsNullOrWhiteSpace($compilerPath) -and
        (Microsoft.PowerShell.Management\Test-Path -LiteralPath $compilerPath -PathType Leaf)) {
        Assert-DefenseClawPathAcl `
            -Path $compilerPath `
            -AllowedWriterSIDs $adminWriters `
            -RequiredRights $serviceInstallRights `
            -AllowUsersRead
    }
    Assert-DefenseClawPathAcl `
        -Path $Layout.GatewayPath `
        -AllowedWriterSIDs $adminWriters `
        -RequiredRights $serviceInstallRights `
        -AllowUsersRead `
        -SelfHealKind ServiceInstallFile `
        -SelfHealGatewayServiceSID $gatewaySID
    $managedInstallFiles = [Collections.Generic.List[string]]::new()
    foreach ($path in @(
        $Layout.ACPPath,
        $Layout.HookPath,
        $Layout.SensorHelperPath,
        $Layout.InstallerPath,
        $Layout.ModulePath
    )) {
        $managedInstallFiles.Add([string]$path)
    }
    if (-not $AllowTransactionRecordedBrokerAbsence -or
        (Microsoft.PowerShell.Management\Test-Path `
            -LiteralPath $Layout.BrokerPath)) {
        $managedInstallFiles.Add([string]$Layout.BrokerPath)
    }
    foreach ($path in $managedInstallFiles) {
        if ([string]::IsNullOrWhiteSpace([string]$path)) {
            continue
        }
        Assert-DefenseClawPathAcl `
            -Path $path `
            -AllowedWriterSIDs $adminWriters `
            -RequiredRights $installRights `
            -AllowUsersRead `
            -SelfHealKind InstallFile `
            -SelfHealGatewayServiceSID $gatewaySID
    }
    if (Microsoft.PowerShell.Management\Test-Path -LiteralPath $Layout.CLIPath -PathType Leaf) {
        Assert-DefenseClawPathAcl `
            -Path $Layout.CLIPath `
            -AllowedWriterSIDs $adminWriters `
            -RequiredRights $installRights `
            -AllowUsersRead `
            -SelfHealKind InstallFile `
            -SelfHealGatewayServiceSID $gatewaySID
    }
    $adminOnlyPaths = [Collections.Generic.List[string]]::new()
    foreach ($path in @(
        $Layout.BrokerLogDirectory,
        $Layout.GuardianDirectory,
        $Layout.InstallStateDirectory,
        $Layout.ManifestPath,
        $Layout.LogDirectory,
        $Layout.GuardianLogDirectory,
        $Layout.MetadataPath
    )) {
        if ([string]::IsNullOrWhiteSpace([string]$path)) {
            continue
        }
        if ($AllowTransactionRecordedBrokerAbsence -and
            [string]::Equals(
                [string]$path,
                [string]$Layout.BrokerLogDirectory,
                [StringComparison]::OrdinalIgnoreCase
            ) -and
            -not (Microsoft.PowerShell.Management\Test-Path `
                -LiteralPath $Layout.BrokerLogDirectory)) {
            continue
        }
        $adminOnlyPaths.Add([string]$path)
    }
    if (Microsoft.PowerShell.Management\Test-Path `
        -LiteralPath $Layout.AgentApplicationControlAttestationPath `
        -PathType Leaf) {
        $adminOnlyPaths.Add(
            [string]$Layout.AgentApplicationControlAttestationPath
        )
    }
    if ($codexTargetEnabled) {
        $adminOnlyPaths.Add([string]$Layout.CodexRequirementsOwnershipPath)
        $adminOnlyPaths.Add([string]$Layout.CodexRequirementsAclBackupPath)
    }
    foreach ($path in $adminOnlyPaths) {
        $kind = if (Microsoft.PowerShell.Management\Test-Path `
                    -LiteralPath $path `
                    -PathType Container) {
            'AdminDirectory'
        } else {
            'AdminFile'
        }
        Assert-DefenseClawPathAcl `
            -Path $path `
            -AllowedWriterSIDs $adminWriters `
            -AllowedReaderSIDs $adminReaders `
            -RequiredRights $adminRights `
            -RejectUntrustedRead `
            -SelfHealKind $kind `
            -SelfHealGatewayServiceSID $gatewaySID
    }
    foreach ($journalPath in @(
        $Layout.ManagedHooksLifecycleJournalPath,
        $Layout.ManagedHooksTeardownJournalPath
    )) {
        if (Microsoft.PowerShell.Management\Test-Path `
            -LiteralPath $journalPath `
            -PathType Leaf) {
            Assert-DefenseClawPathAcl `
                -Path $journalPath `
                -AllowedWriterSIDs $adminWriters `
                -AllowedReaderSIDs $adminReaders `
                -RequiredRights $adminRights `
                -RejectUntrustedRead `
                -SelfHealKind AdminFile `
                -SelfHealGatewayServiceSID $gatewaySID
        }
    }
    foreach ($ancestor in @($Layout.StateRootAncestors)) {
        Assert-DefenseClawNoReparsePath -Path ([string]$ancestor)
        try {
            Assert-DefenseClawStateAncestorTraverse `
                -Path $ancestor `
                -GatewayServiceSID $gatewaySID
        }
        catch {
            if (Test-DefenseClawTrustStrictAncestors) {
                throw
            }
            Write-DefenseClawResilienceEvent -Marker defenseclaw_accept -Fields @{
                path   = [string]$ancestor
                reason = "gateway traverse grant is not present on a shared ancestor: $($_.Exception.Message)"
            }
        }
        if ((Test-DefenseClawStandaloneVendorDirectory -Path $ancestor) -and
            -not (Test-DefenseClawStandaloneVendorUsersRead -Path $ancestor)) {
            throw (
                "standard users cannot read the permissions of $ancestor, so every enrolled user's hook fails closed " +
                '(enterprise_machine_policy_summary_untrusted). Run ' + (Format-DefenseClawRepairAction -Layout $Layout) + ', which grants BUILTIN\Users ' +
                "read-permissions and traverse on that folder alone, or run icacls `"$ancestor`" /grant *S-1-5-32-545:(S,RC,RA,X). " +
                'A deny entry on that folder for a group, a domain account or an enrolled user takes that access away too, ' +
                'and repair keeps it: remove that entry'
            )
        }
    }
    # -SelfHealKind: parallels the StateRoot check below. An orphan
    # NT SERVICE\<prior-service> ACE on the IPC directory (from a prior
    # unsigned certification run that was uninstalled) is re-stamped out
    # instead of blocking Verify/post-install validation.
    Assert-DefenseClawPathAcl `
        -Path $Layout.ManagedIPCDirectory `
        -AllowedWriterSIDs $runtimeWriters `
        -AllowedReaderSIDs @(
            $script:SystemSID,
            $script:AdministratorsSID,
            $script:TrustedInstallerSID,
            $gatewaySID,
            $script:AuthenticatedUsersSID
        ) `
        -RequiredRights $managedIPCDirectoryRights `
        -RejectUntrustedRead `
        -SelfHealKind ManagedIPCDirectory `
        -SelfHealGatewayServiceSID $gatewaySID
    # The state root is the one managed directory that lives directly inside the
    # shared Cisco Secure Client data tree, so AVC can re-ACL it after we stamp
    # the canonical DACL. Foreign access there is reported, not fatal
    # (AIFW-34262); the required SYSTEM/Administrators/gateway rights below
    # still have to be present.
    # -SelfHealKind: if AVC replaced our canonical descriptor rather than merely
    # adding an ACE to it, re-stamp it and read again before judging anything.
    # $stateRights below still has to be satisfied after that repair.
    Assert-DefenseClawPathAcl `
        -Path $Layout.StateRoot `
        -AllowedWriterSIDs $adminWriters `
        -AllowedReaderSIDs $gatewayReaders `
        -RequiredRights $stateRights `
        -RejectUntrustedRead `
        -AdvisoryUntrustedAccess `
        -SelfHealKind StateDirectory `
        -SelfHealGatewayServiceSID $gatewaySID
    Assert-DefenseClawPathAcl `
        -Path $Layout.ConfigDirectory `
        -AllowedWriterSIDs $adminWriters `
        -AllowedReaderSIDs $gatewayReaders `
        -RequiredRights $configDirectoryRights `
        -RejectUntrustedRead `
        -SelfHealKind ConfigDirectory `
        -SelfHealGatewayServiceSID $gatewaySID
    foreach ($entry in @(
        @($Layout.StateRoot, 'StateDirectory'),
        @($Layout.ConfigDirectory, 'ConfigDirectory')
    )) {
        $expected = New-DefenseClawCanonicalPathAcl `
            -IsDirectory $true `
            -Kind ([string]$entry[1]) `
            -GatewayServiceSID $gatewaySID
        Assert-DefenseClawCanonicalPathAcl -Path ([string]$entry[0]) -Expected $expected
    }
    Invoke-DefenseClawBundleAclContract -Layout $Layout -GatewayServiceSID $gatewaySID
    Assert-DefenseClawPathAcl `
        -Path $Layout.ConfigPath `
        -AllowedWriterSIDs $adminWriters `
        -AllowedReaderSIDs $gatewayReaders `
        -RequiredRights $configRights `
        -RejectUntrustedRead `
        -SelfHealKind ConfigFile `
        -SelfHealGatewayServiceSID $gatewaySID
    Assert-DefenseClawPathAcl `
        -Path $Layout.AuthorizationDirectory `
        -AllowedWriterSIDs $adminWriters `
        -AllowedReaderSIDs $gatewayReaders `
        -RequiredRights $authorizationDirectoryRights `
        -RejectUntrustedRead `
        -SelfHealKind AuthorizationDirectory `
        -SelfHealGatewayServiceSID $gatewaySID
    if ((Test-DefenseClawLayoutBrokerEnabled -Layout $Layout) -and
        (-not $AllowTransactionRecordedBrokerAbsence -or
            (Microsoft.PowerShell.Management\Test-Path `
                -LiteralPath $Layout.BrokerStateDirectory))) {
        Assert-DefenseClawPathAcl `
            -Path $Layout.BrokerStateDirectory `
            -AllowedWriterSIDs $adminWriters `
            -AllowedReaderSIDs $gatewayReaders `
            -RequiredRights $authorizationDirectoryRights `
            -RejectUntrustedRead `
            -SelfHealKind AuthorizationDirectory `
            -SelfHealGatewayServiceSID $gatewaySID
    }
    foreach ($authorizationFile in @(
        $Layout.AuthorizationLedgerPath,
        (Microsoft.PowerShell.Management\Join-Path `
            $Layout.AuthorizationDirectory `
            'activation.json')
    )) {
        if (Microsoft.PowerShell.Management\Test-Path `
                -LiteralPath $authorizationFile `
                -PathType Leaf) {
            Assert-DefenseClawPathAcl `
                -Path $authorizationFile `
                -AllowedWriterSIDs $adminWriters `
                -AllowedReaderSIDs $gatewayReaders `
                -RequiredRights $authorizationFileRights `
                -RejectUntrustedRead `
                -SelfHealKind AuthorizationFile `
                -SelfHealGatewayServiceSID $gatewaySID
        }
    }
    foreach ($path in @($Layout.RuntimeDirectory, $Layout.GatewayLogDirectory)) {
        $runtimeKind = if ([string]::Equals(
                [string]$path,
                [string]$Layout.GatewayLogDirectory,
                [StringComparison]::OrdinalIgnoreCase
            )) {
            'GatewayLogDirectory'
        } else {
            'RuntimeDirectory'
        }
        Assert-DefenseClawPathAcl `
            -Path $path `
            -AllowedWriterSIDs $runtimeWriters `
            -AllowedReaderSIDs $gatewayReaders `
            -RequiredRights $runtimeRights `
            -RejectUntrustedRead `
            -SelfHealKind $runtimeKind `
            -SelfHealGatewayServiceSID $gatewaySID
    }
    if (Microsoft.PowerShell.Management\Test-Path -LiteralPath $Layout.GatewayLogPath -PathType Leaf) {
        Assert-DefenseClawPathAcl `
            -Path $Layout.GatewayLogPath `
            -AllowedWriterSIDs $runtimeWriters `
            -AllowedReaderSIDs $gatewayReaders `
            -RequiredRights $runtimeRights `
            -RejectUntrustedRead `
            -SelfHealKind RuntimeFile `
            -SelfHealGatewayServiceSID $gatewaySID
    }
    if (Microsoft.PowerShell.Management\Test-Path -LiteralPath $Layout.GuardianLogPath -PathType Leaf) {
        Assert-DefenseClawPathAcl `
            -Path $Layout.GuardianLogPath `
            -AllowedWriterSIDs $adminWriters `
            -AllowedReaderSIDs $adminReaders `
            -RequiredRights $adminRights `
            -RejectUntrustedRead `
            -SelfHealKind AdminFile `
            -SelfHealGatewayServiceSID $gatewaySID
    }
    foreach ($lockFile in @(Get-DefenseClawLazyLockFiles -Layout $Layout)) {
        if (-not (Microsoft.PowerShell.Management\Test-Path -LiteralPath $lockFile.Path -PathType Leaf)) {
            continue
        }
        if ($lockFile.Kind -ceq 'ConfigFile') {
            $lockWriters = $adminWriters
            $lockRights = $configRights
        }
        else {
            $lockWriters = $runtimeWriters
            $lockRights = $runtimeRights
        }
        Assert-DefenseClawPathAcl `
            -Path $lockFile.Path `
            -AllowedWriterSIDs $lockWriters `
            -AllowedReaderSIDs $gatewayReaders `
            -RequiredRights $lockRights `
            -RejectUntrustedRead `
            -SelfHealKind $lockFile.Kind `
            -SelfHealGatewayServiceSID $gatewaySID
    }

    $requiredHashes = [Collections.Generic.List[string]]::new()
    foreach ($requiredHash in @('gateway', 'acp', 'hook', 'sensor_helper', 'installer', 'module')) {
        $requiredHashes.Add($requiredHash)
    }
    if ((Test-DefenseClawLayoutBrokerEnabled -Layout $Layout)) {
        if (-not $AllowTransactionRecordedBrokerAbsence) {
            $requiredHashes.Insert(0, 'broker')
        }
        elseif ((Microsoft.PowerShell.Management\Test-Path `
                    -LiteralPath $Layout.BrokerPath) -and
            $null -eq $metadata.hashes.PSObject.Properties['broker']) {
            throw 'restored legacy deployment contains an unrecorded Broker artifact'
        }
    }
    foreach ($requiredHash in $requiredHashes) {
        if ($null -eq $metadata.hashes.PSObject.Properties[$requiredHash]) {
            throw "deployment metadata is missing required artifact hash: $requiredHash"
        }
    }
    if ((Microsoft.PowerShell.Management\Test-Path -LiteralPath $Layout.CLIPath -PathType Leaf) -and
        $null -eq $metadata.hashes.PSObject.Properties['cli']) {
        throw 'deployment metadata is missing the installed CLI artifact hash'
    }
    Assert-DefenseClawInstalledArtifacts `
        -Layout $Layout `
        -Metadata $metadata `
        -TransitionHookSHA256 $TransitionHookSHA256

    $gatewayEnvironment = [Collections.Generic.List[string]]::new()
    foreach ($value in @(
        "DEFENSECLAW_HOME=$($Layout.RuntimeDirectory)",
        "DEFENSECLAW_CONFIG=$($Layout.ConfigPath)",
        'DEFENSECLAW_DEPLOYMENT_MODE=managed_enterprise',
        "DEFENSECLAW_HOOK_GUARDIAN_AUTH_DIR=$($Layout.AuthorizationDirectory)",
        "DEFENSECLAW_WINDOWS_SERVICE_NAME=$GatewayServiceName",
        "DEFENSECLAW_WINDOWS_GATEWAY_SERVICE_NAME=$GatewayServiceName",
        "DEFENSECLAW_WINDOWS_SERVICE_ACCOUNT=NT SERVICE\$GatewayServiceName",
        "DEFENSECLAW_WINDOWS_SERVICE_LOG=$($Layout.GatewayLogPath)"
    )) {
        $gatewayEnvironment.Add($value)
    }
    if (-not (Test-DefenseClawLayoutBrokerEnabled -Layout $Layout)) {
        # Same order the writer uses: base pins, the profile pin, then the
        # attestation flags; the standalone profile has no broker entries.
        $gatewayEnvironment.Add('DEFENSECLAW_ENTERPRISE_PROFILE=standalone')
    }
    elseif (-not $AllowTransactionRecordedBrokerAbsence) {
        # A restored pre-Broker servicing preimage carries no Broker
        # connection material; every other Secure Client state does.
        foreach ($value in @(
            "DEFENSECLAW_CMID_BROKER_PIPE=$($Layout.BrokerPipeName)",
            "DEFENSECLAW_CMID_BROKER_SERVICE_NAME=$($Layout.BrokerServiceName)",
            "DEFENSECLAW_CMID_BROKER_AUTH_KEY=$($Layout.BrokerAuthKeyPath)"
        )) {
            $gatewayEnvironment.Add($value)
        }
    }
    $guardianEnvironment = [string[]]@(
        "DEFENSECLAW_HOME=$($Layout.RuntimeDirectory)",
        "DEFENSECLAW_CONFIG=$($Layout.ConfigPath)",
        'DEFENSECLAW_DEPLOYMENT_MODE=managed_enterprise',
        "DEFENSECLAW_HOOK_GUARDIAN_AUTH_DIR=$($Layout.AuthorizationDirectory)",
        "DEFENSECLAW_WINDOWS_SERVICE_NAME=$GuardianServiceName",
        "DEFENSECLAW_WINDOWS_GATEWAY_SERVICE_NAME=$GatewayServiceName",
        "DEFENSECLAW_WINDOWS_SERVICE_ACCOUNT=NT SERVICE\$GatewayServiceName",
        "DEFENSECLAW_WINDOWS_SERVICE_LOG=$($Layout.GuardianLogPath)"
    )
    if (-not (Test-DefenseClawLayoutBrokerEnabled -Layout $Layout)) {
        $guardianEnvironment = [string[]]@(
            $guardianEnvironment + 'DEFENSECLAW_ENTERPRISE_PROFILE=standalone'
        )
    }
    if ([bool]$Layout.AgentApplicationControlAttested) {
        $gatewayEnvironment.Add(
            'DEFENSECLAW_WINDOWS_CODEX_APPROVED_CLIENT_ENFORCED=1'
        )
        $gatewayEnvironment.Add(
            'DEFENSECLAW_WINDOWS_APPROVED_AGENT_CLIENTS_ENFORCED=1'
        )
        $guardianEnvironment = [string[]]@(
            $guardianEnvironment + @(
                'DEFENSECLAW_WINDOWS_CODEX_APPROVED_CLIENT_ENFORCED=1',
                'DEFENSECLAW_WINDOWS_APPROVED_AGENT_CLIENTS_ENFORCED=1'
            )
        )
    }
    if ([bool]$Layout.ClaudeEffectivePolicyVerified) {
        $gatewayEnvironment.Add(
            'DEFENSECLAW_WINDOWS_CLAUDE_EFFECTIVE_POLICY_VERIFIED=1'
        )
        $guardianEnvironment = [string[]]@(
            $guardianEnvironment +
                'DEFENSECLAW_WINDOWS_CLAUDE_EFFECTIVE_POLICY_VERIFIED=1'
        )
    }
    $sensorHelperServiceName = Get-DefenseClawSensorHelperServiceName `
        -GatewayServiceName $GatewayServiceName
    $sensorHelperEnvironment = [string[]]@(
        Get-DefenseClawSensorHelperEnvironmentValues `
            -GatewayServiceName $GatewayServiceName
    )
    # The enumerator is a
    # third managed SCM service. Its expected env vars mirror the
    # guardian's (DEFENSECLAW_WINDOWS_SERVICE_NAME differs; everything
    # else including the shared GuardianLogPath is identical), and
    # its expected start mode + running state get validated here so
    # -RequireReadiness catches the case where the enumerator got
    # left disabled during activation.
    $enumeratorServiceName = Get-DefenseClawEnumeratorServiceName -GuardianServiceName $GuardianServiceName
    $enumeratorEnvironment = [string[]]@(
        "DEFENSECLAW_HOME=$($Layout.RuntimeDirectory)",
        "DEFENSECLAW_CONFIG=$($Layout.ConfigPath)",
        'DEFENSECLAW_DEPLOYMENT_MODE=managed_enterprise',
        "DEFENSECLAW_HOOK_GUARDIAN_AUTH_DIR=$($Layout.AuthorizationDirectory)",
        "DEFENSECLAW_WINDOWS_SERVICE_NAME=$enumeratorServiceName",
        "DEFENSECLAW_WINDOWS_GATEWAY_SERVICE_NAME=$GatewayServiceName",
        "DEFENSECLAW_WINDOWS_SERVICE_ACCOUNT=NT SERVICE\$GatewayServiceName",
        "DEFENSECLAW_WINDOWS_SERVICE_LOG=$($Layout.GuardianLogPath)"
    )
    if (-not (Test-DefenseClawLayoutBrokerEnabled -Layout $Layout)) {
        $enumeratorEnvironment = [string[]]@(
            $enumeratorEnvironment + 'DEFENSECLAW_ENTERPRISE_PROFILE=standalone'
        )
    }
    if ([bool]$Layout.AgentApplicationControlAttested) {
        $enumeratorEnvironment = [string[]]@(
            $enumeratorEnvironment + @(
                'DEFENSECLAW_WINDOWS_CODEX_APPROVED_CLIENT_ENFORCED=1',
                'DEFENSECLAW_WINDOWS_APPROVED_AGENT_CLIENTS_ENFORCED=1'
            )
        )
    }
    if ([bool]$Layout.ClaudeEffectivePolicyVerified) {
        $enumeratorEnvironment = [string[]]@(
            $enumeratorEnvironment +
                'DEFENSECLAW_WINDOWS_CLAUDE_EFFECTIVE_POLICY_VERIFIED=1'
        )
    }
    if ((Test-DefenseClawLayoutBrokerEnabled -Layout $Layout)) {
        if ($AllowTransactionRecordedBrokerAbsence) {
            if (Test-DefenseClawServiceExists -Name $Layout.BrokerServiceName) {
                throw 'authenticated servicing preimage requires Broker to remain absent'
            }
        }
        else {
            Assert-DefenseClawServiceConfiguration `
                -Name $Layout.BrokerServiceName `
                -ExpectedImage (Get-DefenseClawCMIDBrokerImage -Layout $Layout -GatewayServiceName $GatewayServiceName) `
                -ExpectedAccount 'LocalSystem' `
                -ExpectedDisplayName 'DefenseClaw Credential Broker' `
                -ExpectedSidType 1 `
                -ExpectedPrivileges @('SeChangeNotifyPrivilege') `
                -ExpectedEnvironment @() `
                -ExpectedStartMode $expectedServiceStartMode
        }
    }
    $gatewayDependencies = if ((Test-DefenseClawLayoutBrokerEnabled -Layout $Layout) -and
        -not $AllowTransactionRecordedBrokerAbsence) {
        @($Layout.BrokerServiceName, $sensorHelperServiceName)
    }
    else {
        @($sensorHelperServiceName)
    }
    Assert-DefenseClawServiceConfiguration `
        -Name $sensorHelperServiceName `
        -ExpectedImage (Get-DefenseClawSensorHelperImage -Layout $Layout -GatewayServiceName $GatewayServiceName) `
        -ExpectedAccount 'LocalSystem' `
        -ExpectedDisplayName 'DefenseClaw Sensor Helper' `
        -ExpectedSidType 1 `
        -ExpectedPrivileges @('SeChangeNotifyPrivilege') `
        -ExpectedEnvironment $sensorHelperEnvironment `
        -ExpectedStartMode $expectedServiceStartMode
    Assert-DefenseClawServiceConfiguration `
        -Name $GatewayServiceName `
        -ExpectedImage ('"{0}"' -f $Layout.GatewayPath) `
        -ExpectedAccount $ExpectedGatewayAccount `
        -ExpectedDisplayName 'DefenseClaw Enterprise Gateway' `
        -ExpectedSidType 3 `
        -ExpectedPrivileges @('SeChangeNotifyPrivilege') `
        -ExpectedEnvironment ([string[]]$gatewayEnvironment.ToArray()) `
        -ExpectedDependencies $gatewayDependencies `
        -ExpectedStartMode $expectedServiceStartMode
    Assert-DefenseClawServiceConfiguration `
        -Name $GuardianServiceName `
        -ExpectedImage ('"{0}" enterprise hooks watch --manifest "{1}" --interval 1m' -f $Layout.GatewayPath, $Layout.ManifestPath) `
        -ExpectedAccount 'LocalSystem' `
        -ExpectedDisplayName 'DefenseClaw Enterprise Hook Guardian' `
        -ExpectedSidType 1 `
        -ExpectedPrivileges @(
            'SeTcbPrivilege',
            'SeImpersonatePrivilege',
            'SeChangeNotifyPrivilege',
            'SeBackupPrivilege',
            'SeRestorePrivilege'
        ) `
        -ExpectedEnvironment $guardianEnvironment `
        -ExpectedStartMode $expectedServiceStartMode
    if ($AllowTransactionRecordedEnumeratorAbsence) {
        if (Test-DefenseClawServiceExists -Name $enumeratorServiceName) {
            throw 'authenticated servicing preimage requires Enumerator to remain absent'
        }
    }
    else {
        Assert-DefenseClawServiceConfiguration `
            -Name $enumeratorServiceName `
            -ExpectedImage ('"{0}" enterprise windows enumerate --manifest "{1}" --interval 5m' -f $Layout.GatewayPath, $Layout.ManifestPath) `
            -ExpectedAccount 'LocalSystem' `
            -ExpectedDisplayName 'DefenseClaw Enterprise Hook Enumerator' `
            -ExpectedSidType 1 `
            -ExpectedPrivileges @(
                'SeTcbPrivilege',
                'SeImpersonatePrivilege',
                'SeChangeNotifyPrivilege',
                'SeBackupPrivilege',
                'SeRestorePrivilege'
            ) `
            -ExpectedEnvironment $enumeratorEnvironment `
            -ExpectedStartMode $expectedServiceStartMode
    }
    Assert-DefenseClawInstalledConfig -Layout $Layout -GatewayServiceName $GatewayServiceName
    [void](Invoke-DefenseClawCodexRequirementsCommand `
        -Layout $Layout `
        -GatewayServiceName $GatewayServiceName `
        -Action $(if ($codexTargetEnabled) { 'verify' } else { 'inspect' }))

    if ($RequireReadiness) {
        if ((Test-DefenseClawLayoutBrokerEnabled -Layout $Layout)) {
            $brokerService = Microsoft.PowerShell.Management\Get-Service `
                -Name $Layout.BrokerServiceName `
                -ErrorAction SilentlyContinue
            if ($null -eq $brokerService -or
                $brokerService.Status -ne [ServiceProcess.ServiceControllerStatus]::Running) {
                throw 'credential broker SCM process is not running'
            }
        }
        $sensorHelperService = Microsoft.PowerShell.Management\Get-Service `
            -Name $Layout.SensorHelperServiceName `
            -ErrorAction SilentlyContinue
        if ($null -eq $sensorHelperService -or
            $sensorHelperService.Status -ne [ServiceProcess.ServiceControllerStatus]::Running) {
            throw 'sensor helper SCM process is not running'
        }
        # A stopped gateway or guardian is named as such, like the other
        # services: the readiness messages below assume its process runs.
        $gatewayService = Microsoft.PowerShell.Management\Get-Service `
            -Name $GatewayServiceName `
            -ErrorAction SilentlyContinue
        if ($null -eq $gatewayService -or
            $gatewayService.Status -ne [ServiceProcess.ServiceControllerStatus]::Running) {
            throw 'gateway SCM process is not running'
        }
        if (-not (Test-DefenseClawGatewayReady -Layout $Layout -GatewayServiceName $GatewayServiceName)) {
            throw 'gateway SCM process is running but authenticated health is not ready'
        }
        $guardianService = Microsoft.PowerShell.Management\Get-Service `
            -Name $GuardianServiceName `
            -ErrorAction SilentlyContinue
        if ($null -eq $guardianService -or
            $guardianService.Status -ne [ServiceProcess.ServiceControllerStatus]::Running) {
            throw 'guardian SCM process is not running'
        }
        $guardianReadiness = Get-DefenseClawGuardianReadinessProbe `
            -Layout $Layout `
            -GatewayServiceName $GatewayServiceName `
            -GuardianServiceName $GuardianServiceName `
            -LiveVerify `
            -AllowFailedTargets:$AcceptDegradedTargets `
            -AllowedFailedTargetSIDs $AllowedFailedTargetSIDs
        if (-not [bool]$guardianReadiness.ready) {
            throw (
                'guardian SCM process is running but protected target ' +
                'coverage is not verified: ' +
                [string]$guardianReadiness.diagnostic
            )
        }
        # Readiness check for the enumerator SCM
        # process. Uses the same lightweight "service is running"
        # probe as Test-DefenseClawGatewayReady rather than a
        # deeper liveness call — the enumerator has no readiness
        # RPC of its own; its per-cycle stderr goes to the
        # guardian's log surface and the sidecar's
        # SidecarHealth.Enumerator field
        # carries the per-cycle state. A missing-or-stopped SCM
        # process here is caught; a hung enumerator loop is a
        # follow-up to add a health probe for.
        $enumeratorService = Microsoft.PowerShell.Management\Get-Service `
            -Name $enumeratorServiceName `
            -ErrorAction SilentlyContinue
        if ($null -eq $enumeratorService -or
            $enumeratorService.Status -ne
                [ServiceProcess.ServiceControllerStatus]::Running) {
            throw 'enumerator SCM process is not running; targets.yaml will not refresh for new user profiles'
        }
    }
}

function Get-DefenseClawArtifactPath {
    param(
        [Parameter(Mandatory)][hashtable]$Layout,
        [Parameter(Mandatory)][string]$Name
    )
    $path = switch ($Name) {
        'broker' { $Layout.BrokerPath }
        'gateway' { $Layout.GatewayPath }
        'acp' { $Layout.ACPPath }
        'hook' { $Layout.HookPath }
        'sensor_helper' { $Layout.SensorHelperPath }
        'compiler' { Get-DefenseClawOptionalLayoutValue -Layout $Layout -Name CompilerPath }
        'cli' { $Layout.CLIPath }
        'installer' { $Layout.InstallerPath }
        'module' { $Layout.ModulePath }
        'config' { $Layout.ConfigPath }
        'manifest' { $Layout.ManifestPath }
        default { throw "unknown managed artifact: $Name" }
    }
    return $path
}

function Assert-DefenseClawRecordedArtifactHashes {
    param(
        [Parameter(Mandatory)]$Metadata,
        [Parameter(Mandatory)][hashtable]$Layout,
        [string[]]$ReplacedArtifacts = @(),
        # Names the caller in drift errors. Every lifecycle action shares this
        # gate, and the only way out is an Upgrade that replaces the artifact.
        [string]$Action = 'this action',
        # A retry of a committed uninstall whose managed-hook teardown is
        # already finalized: the InstallRoot removal of the earlier run may
        # have retired some artifacts, and nothing installed runs any more.
        # An absent artifact is admitted; a present one is still hashed
        # (GAP-1375).
        [switch]$AllowRetiredArtifacts
    )
    # A standalone deployment has no CMID broker, so it records no broker
    # hash; the same list as Assert-DefenseClawEnterpriseDeployment applies.
    $requiredArtifacts = if ((Test-DefenseClawLayoutBrokerEnabled -Layout $Layout)) {
        @('broker', 'gateway', 'acp', 'hook', 'sensor_helper', 'installer', 'module')
    }
    else {
        @('gateway', 'acp', 'hook', 'sensor_helper', 'installer', 'module')
    }
    # Every gap below refuses the lifecycle action (rel-1-0-3: the retired
    # Fleet compiler and the upgrade and uninstall hash gates); main's #1068
    # warn-and-continue posture is not taken. The one exception is hash drift
    # of a present artifact on Secure Client, which is recorded and continues.
    foreach ($required in $requiredArtifacts) {
        if ($required -notin $ReplacedArtifacts -and
            $null -eq $Metadata.hashes.PSObject.Properties[$required]) {
            throw "deployment metadata is missing required artifact hash: $required"
        }
    }
    if ((Microsoft.PowerShell.Management\Test-Path -LiteralPath $Layout.CLIPath -PathType Leaf) -and
        'cli' -notin $ReplacedArtifacts -and
        $null -eq $Metadata.hashes.PSObject.Properties['cli']) {
        throw 'deployment metadata does not authenticate the installed CLI'
    }
    foreach ($property in $Metadata.hashes.PSObject.Properties) {
        if ($property.Name -in $ReplacedArtifacts) {
            continue
        }
        $path = Get-DefenseClawArtifactPath -Layout $Layout -Name $property.Name
        if (-not (Microsoft.PowerShell.Management\Test-Path -LiteralPath $path -PathType Leaf)) {
            if ($AllowRetiredArtifacts -and
                -not (Microsoft.PowerShell.Management\Test-Path -LiteralPath $path)) {
                continue
            }
            throw "recorded managed artifact is missing before lifecycle mutation: $($property.Name)"
        }
        Assert-DefenseClawNoReparsePath -Path $path
        $actual = (Microsoft.PowerShell.Utility\Get-FileHash -LiteralPath $path -Algorithm SHA256).Hash
        if (-not [string]::Equals(
            $actual,
            [string]$property.Value,
            [StringComparison]::OrdinalIgnoreCase
        )) {
            # Secure Client records hash drift and continues; the commit
            # re-records the hash (26.8.4). The standalone profile and the
            # strict pin keep refusing it.
            if ((Test-DefenseClawStandaloneProfile) -or
                (Test-DefenseClawTrustStrictAncestors)) {
                throw (
                    "$Action refuses unrecorded artifact hash drift: $($property.Name) " +
                    "at $path does not match deployment metadata; run Upgrade with " +
                    "the replacement for $($property.Name) to re-record it"
                )
            }
            Write-DefenseClawResilienceEvent -Marker defenseclaw_boundary -Fields @{
                path     = [string]$path
                artifact = [string]$property.Name
                reason   = "$Action found artifact hash drift; continuing, re-recorded on commit"
                pinned   = ([string]$property.Value).ToLowerInvariant()
                live     = ([string]$actual).ToLowerInvariant()
            }
        }
    }
}

function Add-DefenseClawNativeCleanupSource {
    <#
        Admits the uninstall-only native exact-scope cleanup executable (the
        running defenseclaw.exe or Setup) by the payload trust in force when
        it is called, and records it as the native_cleanup source.
    #>
    param(
        [Parameter(Mandatory)][hashtable]$Sources,
        [string]$NativeCleanupBinary,
        [switch]$AllowUnsigned
    )
    if ([string]::IsNullOrWhiteSpace($NativeCleanupBinary)) {
        return
    }
    $Sources['native_cleanup'] = Get-DefenseClawSourceDescriptor `
        -Path $NativeCleanupBinary `
        -Label 'native exact-scope cleanup executable' `
        -Authenticode `
        -AllowUnsigned:$AllowUnsigned
}

function Get-DefenseClawLifecycleSources {
    param(
        [Parameter(Mandatory)][string]$Action,
        [string]$BrokerBinary,
        [string]$ProviderLibrary,
        [string]$GatewayBinary,
        [string]$ACPBinary,
        [string]$HookBinary,
        [string]$SensorHelperBinary,
        [string]$PolicyCompiler,
        [string]$CLIBinary,
        [string]$NativeCleanupBinary,
        [string]$Config,
        [string]$Manifest,
        [string]$InstallerSource,
        [string]$ModuleSource,
        [switch]$AllowUnsigned,
        # Deferred Install still authenticates protected placeholder config
        # and manifest inputs, but Fleet activation waits for Repair.
        [switch]$DeferredConfig
    )
    $sources = @{}
    Add-DefenseClawNativeCleanupSource `
        -Sources $sources `
        -NativeCleanupBinary $NativeCleanupBinary `
        -AllowUnsigned:$AllowUnsigned
    if ($Action -eq 'Uninstall' -and (Test-DefenseClawStandaloneProfile)) {
        # Setup ships this gateway beside its installer even for Uninstall.
        # Authenticate it before entering the lifecycle so a stale committed
        # journal can use the same current GC as Upgrade and Repair.
        $retireGateway = Get-DefenseClawSetupGatewayCandidatePath `
            -GatewayBinary $GatewayBinary `
            -InstallerSource $InstallerSource
        if (-not [string]::IsNullOrWhiteSpace($retireGateway)) {
            $sources['gateway'] = Get-DefenseClawSourceDescriptor `
                -Path $retireGateway `
                -Label 'gateway executable' `
                -Authenticode `
                -AllowUnsigned:$AllowUnsigned
        }
    }
    if ($Action -notin @('Install', 'Upgrade', 'Repair')) {
        return $sources
    }
    if ([string]::IsNullOrWhiteSpace($InstallerSource) -or
        [string]::IsNullOrWhiteSpace($ModuleSource)) {
        throw "$Action requires the installer and adjacent module source paths"
    }
    $brokerEnabled = Test-DefenseClawBrokerEnabled
    if (-not $brokerEnabled -and
        (-not [string]::IsNullOrWhiteSpace($BrokerBinary) -or
            -not [string]::IsNullOrWhiteSpace($ProviderLibrary))) {
        throw 'the standalone profile has no credential broker; omit -BrokerBinary and -ProviderLibrary'
    }
    if ($brokerEnabled -and -not [string]::IsNullOrWhiteSpace($PolicyCompiler)) {
        throw '-PolicyCompiler applies only to the standalone profile'
    }
    if ($Action -eq 'Install') {
        $required = @()
        if ($brokerEnabled) {
            # -ProviderLibrary is deliberately absent from this list. Cloud
            # Management installs last in a full XDR deployment, so
            # cmidapi.dll need not exist for Install to succeed; the broker
            # discovers it at runtime. A supplied path is still validated
            # below.
            $required += @(
                @('BrokerBinary', $BrokerBinary)
            )
        }
        $required += @(
            @('GatewayBinary', $GatewayBinary),
            @('ACPBinary', $ACPBinary),
            @('HookBinary', $HookBinary),
            @('SensorHelperBinary', $SensorHelperBinary)
        )
        # Deferred Install supplies authenticated placeholder config and
        # manifest sources; their Fleet content is inspected at Repair.
        if (-not $DeferredConfig) {
            $required += @(
                @('Config', $Config),
                @('Manifest', $Manifest)
            )
        }
        foreach ($req in $required) {
            if ([string]::IsNullOrWhiteSpace([string]$req[1])) {
                throw "Install requires -$($req[0])"
            }
        }
    }
    if ($Action -eq 'Upgrade' -and -not $brokerEnabled -and
        ([string]::IsNullOrWhiteSpace($GatewayBinary) -or
        [string]::IsNullOrWhiteSpace($ACPBinary) -or
        [string]::IsNullOrWhiteSpace($HookBinary) -or
        [string]::IsNullOrWhiteSpace($SensorHelperBinary))) {
        throw 'Upgrade requires -GatewayBinary, -ACPBinary, -HookBinary, and -SensorHelperBinary'
    }
    if ($Action -eq 'Upgrade' -and $brokerEnabled -and
        ([string]::IsNullOrWhiteSpace($BrokerBinary) -or
        [string]::IsNullOrWhiteSpace($GatewayBinary) -or
        [string]::IsNullOrWhiteSpace($ACPBinary) -or
        [string]::IsNullOrWhiteSpace($HookBinary) -or
        [string]::IsNullOrWhiteSpace($SensorHelperBinary))) {
        throw 'Upgrade requires -BrokerBinary, -GatewayBinary, -ACPBinary, -HookBinary, and -SensorHelperBinary'
    }

    foreach ($entry in @(
        @('broker', $BrokerBinary, 'credential broker executable', $true),
        @('provider_library', $ProviderLibrary, 'managed credential provider library', $true),
        @('gateway', $GatewayBinary, 'gateway executable', $true),
        @('acp', $ACPBinary, 'ACP guard executable', $true),
        @('hook', $HookBinary, 'hook executable', $true),
        @('sensor_helper', $SensorHelperBinary, 'privileged sensor helper executable', $true),
        @('cli', $CLIBinary, 'CLI executable', $true),
        @('config', $Config, 'managed config', $false),
        @('manifest', $Manifest, 'guardian manifest', $false),
        @('installer', $InstallerSource, 'enterprise installer', $true),
        @('module', $ModuleSource, 'enterprise installer module', $true)
    )) {
        if ([string]::IsNullOrWhiteSpace([string]$entry[1])) {
            continue
        }
        $name = [string]$entry[0]
        try {
            $sources[$name] = Get-DefenseClawSourceDescriptor `
                -Path ([string]$entry[1]) `
                -Label ([string]$entry[2]) `
                -Authenticode:([bool]$entry[3]) `
                -AllowUnsigned:$AllowUnsigned
        }
        catch {
            # provider_library is deliberately optional at install time
            # ONLY for the specific case of the discovered path having
            # disappeared between Setup-EXE preflight discovery and this
            # validator (a CM upgrade race). The broker rediscovers the
            # library at runtime via the deferred-provider pattern
            # (see cmd/defenseclaw-cmid-broker/main_windows.go), so a
            # missing file here is safe to defer. Any OTHER failure
            # (Authenticode signature invalid, path not on a trusted
            # NTFS volume, DACL untrusted, etc.) must still fail install
            # - a tampered cmidapi.dll is a security event, not a
            # deferral trigger.
            if ($name -eq 'provider_library' -and
                $_.Exception.Message -match '^required path is missing: ') {
                Microsoft.PowerShell.Utility\Write-Warning (
                    'managed credential provider library at {0} is absent at preflight; deferring to broker-time discovery' `
                        -f ([string]$entry[1])
                )
                continue
            }
            # Outside the strict pin, any other finding on the provider
            # library is also deferred: the broker repeats the same trust
            # checks every time it loads the library and refuses or reports
            # it there, so an installer-time finding must not block Install.
            if ($name -eq 'provider_library' -and
                -not (Test-DefenseClawTrustStrictAncestors)) {
                Write-DefenseClawResilienceEvent -Marker defenseclaw_boundary -Fields @{
                    path   = [string]$entry[1]
                    reason = "managed credential provider library deferred to broker-time discovery: $($_.Exception.Message)"
                }
                continue
            }
            throw
        }
    }
    return $sources
}

function Get-DefenseClawApprovedPolicyPath {
    param(
        [Parameter(Mandatory)][hashtable]$Layout,
        [Parameter(Mandatory)][ValidateSet('config', 'manifest')][string]$Name
    )
    $leaf = if ($Name -ceq 'config') { 'approved-config.yaml' } else { 'approved-targets.yaml' }
    return [IO.Path]::Combine([string]$Layout.InstallStateDirectory, $leaf)
}

function Get-DefenseClawApprovedPolicyHash {
    param(
        [Parameter(Mandatory)]$Metadata,
        [Parameter(Mandatory)][ValidateSet('config', 'manifest')][string]$Name
    )
    $record = $Metadata.PSObject.Properties['approved_policy_sources']
    if ($null -eq $record) { return '' }
    if ($record.Value -isnot [Management.Automation.PSCustomObject]) {
        throw 'deployment metadata has an invalid approved policy source record'
    }
    foreach ($property in $record.Value.PSObject.Properties) {
        if ($property.Name -notin @('config', 'manifest') -or
            [string]$property.Value -cnotmatch '^[0-9a-f]{64}$') {
            throw 'deployment metadata has an invalid approved policy source digest'
        }
    }
    $entry = $record.Value.PSObject.Properties[$Name]
    if ($null -eq $entry) { return '' }
    return [string]$entry.Value
}

function Get-DefenseClawStandaloneEnsureCommand {
    param([Parameter(Mandatory)][hashtable]$Layout)
    $cli = [string]$Layout['CLIPath']
    return "& '$($cli.Replace("'", "''"))' enterprise windows ensure --profile standalone"
}

function Get-DefenseClawStandaloneBundleRepairCommand {
    param([Parameter(Mandatory)][hashtable]$Layout)
    $cli = [string]$Layout['CLIPath']
    return "& '$($cli.Replace("'", "''"))' enterprise windows repair --profile standalone --json"
}

function Get-DefenseClawApprovedPolicySource {
    param(
        [Parameter(Mandatory)][hashtable]$Layout,
        [Parameter(Mandatory)]$Metadata,
        [Parameter(Mandatory)][ValidateSet('config', 'manifest')][string]$Name
    )
    $bundleRepair = Get-DefenseClawStandaloneBundleRepairCommand -Layout $Layout
    $inputName = if ($Name -ceq 'config') { 'CONFIG' } else { 'MANIFEST' }
    $nextStep = "run $(Format-DefenseClawSetupAction -Action ('/ensure ' + $inputName + '=<approved absolute path>')), or $bundleRepair on a signed-bundle deployment"
    $expected = Get-DefenseClawApprovedPolicyHash -Metadata $Metadata -Name $Name
    if ([string]::IsNullOrEmpty($expected)) {
        throw "Repair has no recorded approved $Name source; $nextStep"
    }
    $path = Get-DefenseClawApprovedPolicyPath -Layout $Layout -Name $Name
    if (-not (Microsoft.PowerShell.Management\Test-Path -LiteralPath $path -PathType Leaf)) {
        throw "Repair cannot read the recorded approved $Name source; $nextStep"
    }
    Assert-DefenseClawPathAcl `
        -Path $path `
        -AllowedWriterSIDs @($script:SystemSID, $script:AdministratorsSID, $script:TrustedInstallerSID) `
        -AllowedReaderSIDs @($script:SystemSID, $script:AdministratorsSID, $script:TrustedInstallerSID) `
        -RejectUntrustedRead `
        -AllowInheritance `
        -IgnoreCreatorTemplates
    $source = Get-DefenseClawSourceDescriptor -Path $path -Label "approved $Name source"
    if ([string]$source.sha256 -ne $expected) {
        throw "Repair found a changed approved $Name source; $nextStep"
    }
    return $source
}

function Get-DefenseClawRecordedConfigGeneration {
    <#
        config.generation.json as the lifecycle and the gateway wrote it, or
        $null without the file. hand_edit says the record names bytes that no
        config writer wrote (an edit in a text editor, kept by the hook
        guardian or the gateway under a "hand-edit:" actor): managed startup
        refuses those bytes, so they are never an approved generation.
    #>
    param([Parameter(Mandatory)][hashtable]$Layout)
    $generationPath = [IO.Path]::Combine([string]$Layout.ConfigDirectory, 'config.generation.json')
    if (-not (Microsoft.PowerShell.Management\Test-Path -LiteralPath $generationPath -PathType Leaf)) {
        return $null
    }
    Assert-DefenseClawPathAcl -Path $generationPath `
        -AllowedWriterSIDs @($script:SystemSID, $script:AdministratorsSID, $script:TrustedInstallerSID) `
        -AllowInheritance -IgnoreCreatorTemplates
    $generation = Microsoft.PowerShell.Management\Get-Content `
        -LiteralPath $generationPath -Raw |
        Microsoft.PowerShell.Utility\ConvertFrom-Json
    $activeHash = [string]$generation.config_sha256
    if ($activeHash -cnotmatch '^[0-9a-f]{64}$') {
        throw ('Repair cannot read the recorded config generation; run ' + (Format-DefenseClawSetupAction -Action '/ensure CONFIG=<approved absolute config path>'))
    }
    $actorProperty = $generation.PSObject.Properties['actor']
    $actor = if ($null -eq $actorProperty) { '' } else { [string]$actorProperty.Value }
    $generationProperty = $generation.PSObject.Properties['generation']
    $previousProperty = $generation.PSObject.Properties['previous_config_sha256']
    $previousHash = if ($null -eq $previousProperty) { '' } else { ([string]$previousProperty.Value -replace '^sha256:', '').ToLowerInvariant() }
    return [pscustomobject]@{
        hash          = $activeHash
        previous_hash = $previousHash
        actor         = $actor
        hand_edit     = [bool]($actor -clike 'hand-edit:*')
        generation    = if ($null -eq $generationProperty) { $null } else { ConvertTo-DefenseClawConfigGenerationNumber -Value $generationProperty.Value }
    }
}

function ConvertTo-DefenseClawConfigGenerationNumber {
    <#
        A config generation counter as an unsigned integer, or $null when the
        value is not a plain non-negative integer.
    #>
    param($Value)
    $number = [uint64]0
    if ($null -ne $Value -and [uint64]::TryParse([string]$Value, [Globalization.NumberStyles]::None,
            [Globalization.CultureInfo]::InvariantCulture, [ref]$number)) {
        return $number
    }
    return $null
}

function Get-DefenseClawRecordedConfigGenerationHash {
    param([Parameter(Mandatory)][hashtable]$Layout)
    $generation = Get-DefenseClawRecordedConfigGeneration -Layout $Layout
    if ($null -eq $generation) { return '' }
    return [string]$generation.hash
}

function Test-DefenseClawSignedBundleStoreHoldsVersions {
    <#
        Whether this deployment ever stored a signed policy bundle (the
        etc\bundles folder). A bundle-managed config is repaired by the
        installed CLI, and Setup's own approved copy is not proof of its
        current bytes.
    #>
    param([Parameter(Mandatory)][hashtable]$Layout)
    $directory = [IO.Path]::Combine([string]$Layout.ConfigDirectory, 'bundles')
    if (-not (Microsoft.PowerShell.Management\Test-Path -LiteralPath $directory)) {
        return $false
    }
    Assert-DefenseClawNoReparsePath -Path $directory
    return (@(Microsoft.PowerShell.Management\Get-ChildItem -LiteralPath $directory -Force).Count -gt 0)
}

function Get-DefenseClawHandEditApprovedConfigSource {
    <#
        The recorded approved config source that replaces a config.yaml whose
        generation record is a hand edit, or $null when the record is not a
        hand edit (GAP-0743). A hand edit leaves no lifecycle-recorded
        predecessor to compare the approved copy with, so the copy is current
        only while the deployment has never stored a signed bundle; a
        bundle-managed deployment is refused with the installed CLI's repair
        command. A missing or changed approved copy is refused by
        Get-DefenseClawApprovedPolicySource. Nothing is changed here.
    #>
    param(
        [Parameter(Mandatory)][hashtable]$Layout,
        [Parameter(Mandatory)]$Metadata
    )
    $generation = Get-DefenseClawRecordedConfigGeneration -Layout $Layout
    if ($null -eq $generation -or -not [bool]$generation.hand_edit) { return $null }
    if (Test-DefenseClawSignedBundleStoreHoldsVersions -Layout $Layout) {
        throw ('Repair cannot prove that the recorded approved config source is current; ' +
            'run ' + (Get-DefenseClawStandaloneBundleRepairCommand -Layout $Layout) + ' ' +
            'on a signed-bundle deployment, or ' + (Format-DefenseClawSetupAction -Action '/ensure CONFIG=<approved absolute config path>') + ' otherwise')
    }
    $approved = Get-DefenseClawApprovedPolicySource -Layout $Layout -Metadata $Metadata -Name config
    Assert-DefenseClawApprovedConfigProven -Layout $Layout -Approved $approved -Generation $generation
    return $approved
}

function Assert-DefenseClawApprovedConfigProven {
    <#
        Whether a lifecycle run of this release proved the approved config
        copy current, for a config.yaml the generation record calls a hand
        edit (GAP-0779). The hand edit record names no lifecycle predecessor,
        and a digest that matches the copy proves only that the copy is intact:
        a build that applied a config in place left the copy at an older
        config. approved-config.current.json, written by the Go lifecycle next
        to the copy, names the copy digest and the config generation that
        recorded the config as applied. The copy is current only when the hand
        edit directly follows that generation and replaced that config (the
        record names the digest it replaced); a config recorded after the
        proof (by a build that does not write the proof) leaves a larger gap,
        and one written after the record was lost replaced another digest.
        This is the one place that restores the copy over a hand edit, so
        Setup Repair, a direct run of install-enterprise.ps1 and the rollback
        all stop here, before anything is changed. Nothing is changed here.
    #>
    param(
        [Parameter(Mandatory)][hashtable]$Layout,
        [Parameter(Mandatory)]$Approved,
        [Parameter(Mandatory)]$Generation
    )
    $refusal = 'Repair cannot prove that the recorded approved config source is the config the last lifecycle run applied; run ' +
        (Format-DefenseClawSetupAction -Action '/ensure CONFIG=<approved absolute config path>') +
        ' with the approved config, then repair again (nothing was changed)'
    $proofPath = [IO.Path]::Combine([string]$Layout.InstallStateDirectory, 'approved-config.current.json')
    if (-not (Microsoft.PowerShell.Management\Test-Path -LiteralPath $proofPath -PathType Leaf)) {
        throw $refusal
    }
    Assert-DefenseClawNoReparsePath -Path $proofPath
    Assert-DefenseClawPathAcl `
        -Path $proofPath `
        -AllowedWriterSIDs @($script:SystemSID, $script:AdministratorsSID, $script:TrustedInstallerSID) `
        -AllowedReaderSIDs @($script:SystemSID, $script:AdministratorsSID, $script:TrustedInstallerSID) `
        -RejectUntrustedRead `
        -AllowInheritance `
        -IgnoreCreatorTemplates
    $proof = $null
    try {
        $proof = Microsoft.PowerShell.Management\Get-Content -LiteralPath $proofPath -Raw |
            Microsoft.PowerShell.Utility\ConvertFrom-Json
    }
    catch {
        throw $refusal
    }
    if ($proof -isnot [Management.Automation.PSCustomObject]) { throw $refusal }
    $digestProperty = $proof.PSObject.Properties['config_sha256']
    $generationProperty = $proof.PSObject.Properties['generation']
    if ($null -eq $digestProperty -or $null -eq $generationProperty -or
        [string]$digestProperty.Value -cne ([string]$Approved.sha256).ToLowerInvariant()) {
        throw $refusal
    }
    $proven = ConvertTo-DefenseClawConfigGenerationNumber -Value $generationProperty.Value
    if ($null -eq $proven -or $null -eq $Generation.generation -or
        $Generation.generation -le $proven -or ($Generation.generation - $proven) -ne 1) {
        throw $refusal
    }
    # The number alone is not a link: a generation record that was lost starts
    # its counter over, so a later config written after the reset can carry
    # the number that follows the proof. The hand edit must also have replaced
    # the config the proof covers (previous_config_sha256).
    if ([string]$Generation.previous_hash -cne [string]$digestProperty.Value) {
        throw $refusal
    }
}

function Restore-DefenseClawApprovedConfigOverHandEdit {
    <#
        Standalone rollback, best effort (GAP-0743). A rollback puts
        config.yaml back as the transaction found it. When that is a hand edit,
        managed startup refuses it: the restored gateway stays down and every
        later recovery fails the same way. The approved generation is what ran
        before the edit, so the recorded approved source takes its place and
        the caller records it as the lifecycle generation. Anything that cannot
        be proven leaves the restored bytes as they are.
    #>
    param(
        [Parameter(Mandatory)][hashtable]$Layout,
        [Parameter(Mandatory)][string]$GatewayServiceName
    )
    try {
        $metadata = Get-DefenseClawDeploymentMetadata -Layout $Layout
        if ($null -eq $metadata) { return }
        $approved = Get-DefenseClawHandEditApprovedConfigSource -Layout $Layout -Metadata $metadata
        if ($null -eq $approved) { return }
        Assert-DefenseClawNoReparsePath -Path $Layout.ConfigPath -AllowMissingLeaf
        Install-DefenseClawSourceDescriptor -Source $approved -Destination $Layout.ConfigPath
        Set-DefenseClawPathAcl -Path $Layout.ConfigPath -Kind ConfigFile `
            -GatewayServiceSID (Get-DefenseClawServiceSID -ServiceName $GatewayServiceName)
        Write-DefenseClawResilienceEvent -Marker defenseclaw_accept -Fields @{
            path   = [string]$Layout.ConfigPath
            reason = 'rollback restored the recorded approved config in place of a hand-edited preimage that managed startup refuses'
        }
    }
    catch {
        Write-DefenseClawResilienceEvent -Marker defenseclaw_accept -Fields @{
            path   = [string]$Layout.ConfigPath
            reason = ('rollback kept the restored config: ' +
                (ConvertTo-DefenseClawBoundedDiagnostic -Value $_.Exception.Message -MaxLength 512))
        }
    }
}

function Get-DefenseClawRepairRollbackApprovedConfigSource {
    param(
        [Parameter(Mandatory)][hashtable]$Layout,
        [Parameter(Mandatory)]$Metadata
    )
    $generation = Get-DefenseClawRecordedConfigGeneration -Layout $Layout
    if ($null -eq $generation) { return $null }
    if ([bool]$generation.hand_edit) {
        # The installed bytes are a hand edit, so the record cannot vouch for
        # them; Repair and its rollback both put the approved copy back
        # (GAP-0743), and that is what the candidate must validate.
        return (Get-DefenseClawHandEditApprovedConfigSource -Layout $Layout -Metadata $Metadata)
    }
    $activeHash = [string]$generation.hash
    Assert-DefenseClawNoReparsePath -Path $Layout.ConfigPath -AllowMissingLeaf
    if (Microsoft.PowerShell.Management\Test-Path -LiteralPath $Layout.ConfigPath -PathType Leaf) {
        $installedHash = (
            Microsoft.PowerShell.Utility\Get-FileHash -LiteralPath $Layout.ConfigPath -Algorithm SHA256
        ).Hash.ToLowerInvariant()
        if ($installedHash -ceq $activeHash) { return $null }
    }
    $approved = Get-DefenseClawApprovedPolicySource -Layout $Layout -Metadata $Metadata -Name config
    if (([string]$approved.sha256).ToLowerInvariant() -cne $activeHash) {
        throw ('Repair cannot prove that the recorded approved config source is current; ' +
            'run ' + (Get-DefenseClawStandaloneBundleRepairCommand -Layout $Layout) + ' ' +
            'on a signed-bundle deployment, or ' + (Format-DefenseClawSetupAction -Action '/ensure CONFIG=<approved absolute config path>') + ' otherwise')
    }
    return $approved
}

function Invoke-DefenseClawRepairApprovedPolicyRecovery {
    param(
        [Parameter(Mandatory)][hashtable]$Layout,
        [Parameter(Mandatory)][hashtable]$Sources,
        [Parameter(Mandatory)]$Metadata,
        [Parameter(Mandatory)][string]$GatewayServiceName,
        # Receives the sha256 of the approved config this recovery left
        # installed over a hand-edit generation record (GAP-0743); the config
        # step then records those bytes as the lifecycle generation.
        [hashtable]$ApprovedConfig = @{}
    )
    $adminWriters = @($script:SystemSID, $script:AdministratorsSID, $script:TrustedInstallerSID)
    foreach ($name in @('config', 'manifest')) {
        if ($Sources.ContainsKey($name)) { continue }
        $destination = Get-DefenseClawArtifactPath -Layout $Layout -Name $name
        $directory = [IO.Path]::GetDirectoryName([string]$destination)
        $parentPaths = @($Layout.StateRoot, $directory)
        foreach ($parent in $parentPaths) {
            Assert-DefenseClawPathAcl -Path ([string]$parent) `
                -AllowedWriterSIDs $adminWriters -AllowInheritance -IgnoreCreatorTemplates
        }
        if ($name -ceq 'config') {
            # A hand edit is recorded in config.generation.json for exactly the
            # bytes now installed, so installed == recorded proves nothing: the
            # gateway refuses to start on them. The approved copy replaces
            # them before the gateway is started or any readiness is awaited.
            $handEditApproved = Get-DefenseClawHandEditApprovedConfigSource `
                -Layout $Layout -Metadata $Metadata
            if ($null -ne $handEditApproved) {
                $approvedHash = ([string]$handEditApproved.sha256).ToLowerInvariant()
                $installedHash = ''
                if (Microsoft.PowerShell.Management\Test-Path -LiteralPath $destination -PathType Leaf) {
                    try {
                        Assert-DefenseClawPathAcl -Path $destination `
                            -AllowedWriterSIDs $adminWriters -AllowInheritance -IgnoreCreatorTemplates
                        $installedHash = (
                            Microsoft.PowerShell.Utility\Get-FileHash -LiteralPath $destination -Algorithm SHA256
                        ).Hash.ToLowerInvariant()
                    }
                    catch {
                        $installedHash = ''
                    }
                }
                if ($installedHash -cne $approvedHash) {
                    Install-DefenseClawSourceDescriptor -Source $handEditApproved -Destination $destination
                    Set-DefenseClawPathAcl -Path $destination -Kind ConfigFile `
                        -GatewayServiceSID (Get-DefenseClawServiceSID -ServiceName $GatewayServiceName)
                }
                $ApprovedConfig['config'] = $approvedHash
                continue
            }
        }
        $needsRewrite = -not (Microsoft.PowerShell.Management\Test-Path `
            -LiteralPath $destination -PathType Leaf)
        if (-not $needsRewrite) {
            try {
                Assert-DefenseClawPathAcl -Path $destination `
                    -AllowedWriterSIDs $adminWriters -AllowInheritance -IgnoreCreatorTemplates
            }
            catch {
                $needsRewrite = $true
            }
        }
        $activeHash = ''
        if ($name -ceq 'config') {
            $activeHash = Get-DefenseClawRecordedConfigGenerationHash -Layout $Layout
        }
        else {
            $activeHash = [string]$Metadata.managed_hooks_activation.manifest_sha256
        }
        if (-not $needsRewrite -and -not [string]::IsNullOrEmpty($activeHash)) {
            $installedHash = (
                Microsoft.PowerShell.Utility\Get-FileHash -LiteralPath $destination -Algorithm SHA256
            ).Hash.ToLowerInvariant()
            if ($installedHash -ne $activeHash) {
                if ($name -ceq 'config') {
                    $needsRewrite = $true
                }
                else {
                    $adoption = Get-DefenseClawStandaloneManifestAdoption `
                        -Layout $Layout -GatewayServiceName $GatewayServiceName `
                        -Activation $Metadata.managed_hooks_activation `
                        -InstalledManifestSHA256 $installedHash
                    $needsRewrite = -not [bool]$adoption.ok
                }
            }
        }
        if (-not $needsRewrite) { continue }
        $approved = Get-DefenseClawApprovedPolicySource `
            -Layout $Layout -Metadata $Metadata -Name $name
        if ([string]::IsNullOrEmpty($activeHash) -or
            [string]$approved.sha256 -ne $activeHash) {
            $inputName = if ($name -ceq 'config') { 'CONFIG' } else { 'MANIFEST' }
            throw ("Repair cannot prove that the recorded approved $name source is current; " +
                "run $(Format-DefenseClawSetupAction -Action ('/ensure ' + $inputName + '=<approved absolute path>')), or " +
                (Get-DefenseClawStandaloneBundleRepairCommand -Layout $Layout) +
                ' on a signed-bundle deployment')
        }
        Install-DefenseClawSourceDescriptor -Source $approved -Destination $destination
        $kind = if ($name -ceq 'config') { 'ConfigFile' } else { 'AdminFile' }
        Set-DefenseClawPathAcl -Path $destination -Kind $kind `
            -GatewayServiceSID (Get-DefenseClawServiceSID -ServiceName $GatewayServiceName)
        if ($name -ceq 'config') {
            # The hook guardian may record these approved bytes as a hand edit
            # before the config step runs; the step records them as the
            # lifecycle generation because Repair named them approved.
            $ApprovedConfig['config'] = ([string]$approved.sha256).ToLowerInvariant()
        }
    }
}

function Publish-DefenseClawApprovedPolicySources {
    param(
        [Parameter(Mandatory)][hashtable]$Layout,
        [Parameter(Mandatory)][hashtable]$Sources,
        $PriorMetadata
    )
    $record = @{}
    if ($null -ne $PriorMetadata) {
        foreach ($name in @('config', 'manifest')) {
            $priorHash = Get-DefenseClawApprovedPolicyHash -Metadata $PriorMetadata -Name $name
            if (-not [string]::IsNullOrEmpty($priorHash)) { $record[$name] = $priorHash }
        }
    }
    foreach ($name in @('config', 'manifest')) {
        if (-not $Sources.ContainsKey($name)) { continue }
        $installed = Get-DefenseClawArtifactPath -Layout $Layout -Name $name
        $copy = Get-DefenseClawApprovedPolicyPath -Layout $Layout -Name $name
        $digest = (
            Microsoft.PowerShell.Utility\Get-FileHash -LiteralPath $installed -Algorithm SHA256
        ).Hash.ToLowerInvariant()
        Install-DefenseClawFileAtomic -Source $installed -Destination $copy -ExpectedSHA256 $digest
        Set-DefenseClawPathAcl -Path $copy -Kind AdminFile `
            -GatewayServiceSID $script:AdministratorsSID
        $record[$name] = $digest
    }
    return $record
}

function Assert-DefenseClawLifecycleSourcesCurrent {
    param([Parameter(Mandatory)][hashtable]$Sources)
    foreach ($name in @(
        $Sources.Keys | Microsoft.PowerShell.Utility\Sort-Object
    )) {
        [void](Assert-DefenseClawSourceDescriptorCurrent `
            -Source $Sources[[string]$name])
    }
}

function Get-DefenseClawServiceState {
    param([Parameter(Mandatory)][string]$Name)
    $service = Microsoft.PowerShell.Management\Get-Service -Name $Name -ErrorAction SilentlyContinue
    if ($null -eq $service) {
        return 'absent'
    }
    return $service.Status.ToString().ToLowerInvariant()
}

function ConvertTo-DefenseClawServiceStartModeName {
    param([Parameter(Mandatory)][int]$StartMode)
    switch ($StartMode) {
        2 { return 'auto' }
        3 { return 'manual' }
        4 { return 'disabled' }
    }
    return ''
}

function Get-DefenseClawServiceStartModeName {
    param([Parameter(Mandatory)][string]$Name)
    try {
        return ConvertTo-DefenseClawServiceStartModeName -StartMode (Get-DefenseClawServiceStartMode -Name $Name)
    }
    catch {
        return ''
    }
}

function ConvertTo-DefenseClawBoundedDiagnostic {
    param(
        [AllowNull()]$Value,
        [ValidateRange(64, 4096)][int]$MaxLength = 2048
    )
    $text = (($Value | Microsoft.PowerShell.Utility\Out-String).Trim())
    if ([string]::IsNullOrWhiteSpace($text)) {
        return 'unavailable'
    }
    $text = $text -replace '[\x00-\x1f\x7f]+', ' '
    $text = $text -replace '(?i)\bBearer\s+[A-Za-z0-9._~+/=-]+', 'Bearer <redacted>'
    $text = $text -replace '(?i)(?<![A-Za-z0-9_])["'']?(password|passwd|secret|token|access[_-]?token|refresh[_-]?token|client[_-]?secret|api[_-]?key)\b["'']?\s*[:=]\s*(?:"[^"]*"|''[^'']*''|[^,;\s}\]]+)', '$1=<redacted>'
    $text = $text.Trim()
    if ($text.Length -gt $MaxLength) {
        return $text.Substring(0, $MaxLength - 3) + '...'
    }
    return $text
}

function Assert-DefenseClawGatewayServiceAccess {
    <#
        The access the gateway service needs at start to the folders verify
        checks for it: its config folder and file, and its runtime folder.
    #>
    param(
        [Parameter(Mandatory)][hashtable]$Layout,
        [Parameter(Mandatory)][string]$GatewayServiceName
    )
    $gatewaySID = Get-DefenseClawServiceSID -ServiceName $GatewayServiceName
    $adminWriters = @($script:SystemSID, $script:AdministratorsSID, $script:TrustedInstallerSID)
    $gatewayReaders = @($script:SystemSID, $script:AdministratorsSID, $script:TrustedInstallerSID, $gatewaySID)
    foreach ($check in @(
        @($Layout.ConfigDirectory, 'ConfigDirectory', $adminWriters),
        @($Layout.ConfigPath, 'Config', $adminWriters),
        @($Layout.RuntimeDirectory, 'Runtime', $gatewayReaders)
    )) {
        Assert-DefenseClawPathAcl `
            -Path ([string]$check[0]) `
            -AllowedWriterSIDs $check[2] `
            -AllowedReaderSIDs $gatewayReaders `
            -RequiredRights (New-DefenseClawRequiredRights -Kind ([string]$check[1]) -GatewayServiceSID $gatewaySID) `
            -RejectUntrustedRead
    }
}

function Get-DefenseClawGuardianStatusReport {
    param(
        [Parameter(Mandatory)][hashtable]$Layout,
        [Parameter(Mandatory)][string]$GatewayServiceName,
        # The authenticated replacement gateway a Repair or Upgrade staged,
        # used when the installed one cannot run (GAP-1417).
        [hashtable]$GatewaySource,
        # A caller with its own deadline bounds the status command by it
        # (rel-1-0-2:GAP-0535).
        [ValidateRange(1, 1800)][int]$TimeoutSeconds = 300
    )
    try {
        $probe = Invoke-DefenseClawGatewayCommand `
            -Layout $Layout `
            -GatewayServiceName $GatewayServiceName `
            -GatewaySource $GatewaySource `
            -Arguments @('enterprise', 'hooks', 'status', '--manifest', $Layout.ManifestPath, '--json') `
            -Capture `
            -AllowFailure `
            -TimeoutSeconds $TimeoutSeconds
        foreach ($line in @($probe.output)) {
            $text = ([string]$line).Trim()
            if (-not $text.StartsWith('{')) {
                continue
            }
            try {
                return $text | Microsoft.PowerShell.Utility\ConvertFrom-Json
            }
            catch {
                continue
            }
        }
    }
    catch {
        return [pscustomobject][ordered]@{
            ok = $false
            errors = @(
                "guardian status command failed: $(ConvertTo-DefenseClawBoundedDiagnostic -Value $_.Exception.Message)"
            )
        }
    }
    return [pscustomobject][ordered]@{
        ok = $false
        errors = @(
            "guardian status command exited $($probe.exit_code) without a valid JSON report: $(ConvertTo-DefenseClawBoundedDiagnostic -Value $probe.output)"
        )
    }
}

function Get-DefenseClawLifecycleStatus {
    param(
        [Parameter(Mandatory)][string]$Action,
        [Parameter(Mandatory)][hashtable]$Layout,
        [Parameter(Mandatory)][string]$GatewayServiceName,
        [Parameter(Mandatory)][string]$GuardianServiceName,
        # The result of an activation that accepted a completed reconcile
        # with failed user targets: those targets are logged as
        # defenseclaw_degraded instead of failing the result.
        [switch]$AcceptDegradedTargets,
        [string[]]$AllowedFailedTargetSIDs
    )
    $errors = [Collections.Generic.List[string]]::new()
    $metadata = $null
    try {
        $metadata = Get-DefenseClawDeploymentMetadata -Layout $Layout
        if ($null -ne $metadata) {
            Assert-DefenseClawMetadataIdentity `
                -Metadata $metadata `
                -GatewayServiceName $GatewayServiceName `
                -GuardianServiceName $GuardianServiceName
        }
    }
    catch {
        $errors.Add($_.Exception.Message)
    }
    $installed = $null -ne $metadata -and (Test-DefenseClawMetadataInstalled -Metadata $metadata)
    $pending = Microsoft.PowerShell.Management\Test-Path -LiteralPath $Layout.PendingPath -PathType Leaf
    $gatewayState = Get-DefenseClawServiceState -Name $GatewayServiceName
    $brokerEnabled = (Test-DefenseClawLayoutBrokerEnabled -Layout $Layout)
    $brokerState = if ($brokerEnabled) {
        Get-DefenseClawServiceState -Name $Layout.BrokerServiceName
    }
    else {
        'not_applicable'
    }
    $guardianState = Get-DefenseClawServiceState -Name $GuardianServiceName
    $enumeratorServiceName = Get-DefenseClawEnumeratorServiceName `
        -GuardianServiceName $GuardianServiceName
    $enumeratorState = Get-DefenseClawServiceState -Name $enumeratorServiceName
    $deferredConfigPending = [bool](
        $installed -and
        $null -ne $metadata.PSObject.Properties['deferred_config_pending'] -and
        [bool]$metadata.deferred_config_pending
    )
    $gatewayReady = $false
    $guardianReady = $false
    $codexRequirementsReady = $false
    $codexRequirementsDisposition = $null
    # Like Claude and Cursor, fall back to the protected deployment record
    # when the live Codex requirements command fails; the failure itself is
    # reported through errors and codex_requirements_ready.
    $codexTargetEnabled = [bool]$Layout.CodexTargetEnabled
    $cursorTargetEnabled = [bool]$Layout.CursorTargetEnabled
    $claudeTargetEnabled = [bool]$Layout.ClaudeTargetEnabled
    $claudeEffectivePolicyVerified = [bool](
        $Layout.ClaudeEffectivePolicyVerified
    )
    # Standalone evidence recorded for another Claude policy identity is
    # reported as unverified with its reason instead of failing status.
    $claudeEffectivePolicyStaleReason = ''
    if (Test-DefenseClawStandaloneProfile) {
        $claudeEffectivePolicyStaleReason = [string](
            $Layout['ClaudeEffectivePolicyStaleReason']
        )
        if (-not [string]::IsNullOrEmpty($claudeEffectivePolicyStaleReason)) {
            $claudeEffectivePolicyVerified = $false
        }
    }
    $generation = $null
    if ($installed -and -not $pending) {
        try {
            $gatewayReady = Test-DefenseClawGatewayReady `
                -Layout $Layout `
                -GatewayServiceName $GatewayServiceName
        }
        catch {
            $errors.Add($_.Exception.Message)
        }
        try {
            $guardianReady = Test-DefenseClawGuardianReady `
                -Layout $Layout `
                -GatewayServiceName $GatewayServiceName `
                -GuardianServiceName $GuardianServiceName `
                -AllowFailedTargets:$AcceptDegradedTargets `
                -AllowedFailedTargetSIDs $AllowedFailedTargetSIDs
            $guardianReport = Get-DefenseClawGuardianStatusReport `
                -Layout $Layout `
                -GatewayServiceName $GatewayServiceName
            $generation = Get-DefenseClawGuardianGeneration -Report $guardianReport
            $guardianDegraded = [bool](
                $AcceptDegradedTargets -and
                (Test-DefenseClawGuardianReportCompletedWithFailedTargets -Report $guardianReport) -and
                (Test-DefenseClawGuardianFailedTargetsWithinSIDs `
                    -Report $guardianReport -AllowedSIDs $AllowedFailedTargetSIDs)
            )
            if ($guardianDegraded) {
                Write-DefenseClawGuardianDegradedTargets -Report $guardianReport
            }
            elseif ($null -ne $guardianReport -and
                $null -ne $guardianReport.PSObject.Properties['errors']) {
                foreach ($issue in @($guardianReport.PSObject.Properties['errors'].Value)) {
                    if (-not [string]::IsNullOrWhiteSpace([string]$issue)) {
                        $errors.Add(
                            "guardian status: $(ConvertTo-DefenseClawBoundedDiagnostic -Value $issue)"
                        )
                    }
                }
            }
        }
        catch {
            $errors.Add($_.Exception.Message)
        }
        if (Test-DefenseClawAdministrator) {
            try {
                $codexReport = Invoke-DefenseClawCodexRequirementsCommand `
                    -Layout $Layout `
                    -GatewayServiceName $GatewayServiceName `
                    -Action $(if ([bool]$Layout.CodexTargetEnabled) {
                        'verify'
                    } else {
                        'inspect'
                    })
                $codexRequirementsReady = [bool]$codexReport.ok
                $codexRequirementsDisposition = [string]$codexReport.disposition
                $codexTargetEnabled = [bool]$codexReport.codex_target_enabled
                $cursorTargetEnabled = [bool]$codexReport.cursor_target_enabled
                $claudeTargetEnabled = [bool]$codexReport.claude_target_enabled
                $claudeEffectivePolicyVerified = [bool](
                    $codexReport.claude_effective_policy_verified
                )
                if (-not [string]::IsNullOrEmpty($claudeEffectivePolicyStaleReason)) {
                    $claudeEffectivePolicyVerified = $false
                }
            }
            catch {
                $errors.Add($_.Exception.Message)
            }
        }
        else {
            $errors.Add(
                'Codex machine requirements verification requires an elevated administrator token'
            )
        }
    }
    if ((Test-DefenseClawStandaloneProfile) -and $installed -and -not $pending -and
        (Test-DefenseClawAdministrator)) {
        # Status said ok while verify failed on the gateway service's access
        # to runtime and etc, and the gateway could not start (GAP-0920).
        try {
            Assert-DefenseClawGatewayServiceAccess `
                -Layout $Layout `
                -GatewayServiceName $GatewayServiceName
        }
        catch {
            $errors.Add($_.Exception.Message)
        }
        # Status said ok while verify failed on a missing payload file such
        # as a quarantined bin\defenseclaw.exe (GAP-0665).
        try {
            Assert-DefenseClawInstalledArtifacts -Layout $Layout -Metadata $metadata
        }
        catch {
            $errors.Add($_.Exception.Message)
        }
    }
    $brokerHealthyInstalled = (-not $brokerEnabled) -or $brokerState -eq 'running'
    $brokerHealthyAbsent = (-not $brokerEnabled) -or $brokerState -eq 'absent'
    $healthy = if ($installed) {
        $gatewayState -eq 'running' -and
            $brokerHealthyInstalled -and
            $guardianState -eq 'running' -and
            $enumeratorState -eq 'running' -and
            $gatewayReady -and
            $guardianReady -and
            $codexRequirementsReady -and
            -not $deferredConfigPending -and
            -not $pending -and
            $errors.Count -eq 0
    }
    else {
        $gatewayState -eq 'absent' -and
            $brokerHealthyAbsent -and
            $guardianState -eq 'absent' -and
            $enumeratorState -eq 'absent' -and
            -not $pending -and
            $errors.Count -eq 0
    }
    # Cursor uses the same protected Guardian/runtime readiness lane but does
    # not require Codex machine policy or application-control proof.
    $externalSecuritySatisfied = [bool](
        $installed -and
        ($claudeTargetEnabled -or $codexTargetEnabled -or $cursorTargetEnabled) -and
        (-not $claudeTargetEnabled -or
            $claudeEffectivePolicyVerified)
    )
    $status = [ordered]@{
        schema_version = 1
        ok = [bool]$healthy
        action = $Action.ToLowerInvariant()
        installed = [bool]$installed
        core_hardening_certification = [bool]$Layout.CoreHardeningCertification
        core_hardening_complete = [bool]($installed -and $healthy)
        external_security_prerequisites_satisfied = [bool]$externalSecuritySatisfied
        install_root = $Layout.InstallRoot
        state_root = $Layout.StateRoot
        transaction_pending = [bool]$pending
        deferred_config_pending = $deferredConfigPending
        gateway_service = $GatewayServiceName
        broker_service = $Layout.BrokerServiceName
        guardian_service = $GuardianServiceName
        enumerator_service = $enumeratorServiceName
        gateway_service_state = $gatewayState
        broker_service_state = $brokerState
        guardian_service_state = $guardianState
        enumerator_service_state = $enumeratorState
        gateway_ready = [bool]$gatewayReady
        guardian_ready = [bool]$guardianReady
        codex_machine_requirements_ready = [bool]$codexRequirementsReady
        codex_machine_requirements_disposition = $codexRequirementsDisposition
        codex_machine_policy_path = $Layout.CodexMachinePolicyPath
        codex_managed_hooks_state_path = $Layout.CodexManagedHooksStatePath
        agent_application_control_enforced = [bool]$Layout.AgentApplicationControlAttested
        agent_application_control_prerequisite = $script:AgentApplicationControlPrerequisite
        codex_approved_client_enforced = [bool]$Layout.AgentApplicationControlAttested
        codex_target_enabled = [bool]$codexTargetEnabled
        cursor_target_enabled = [bool]$cursorTargetEnabled
        claude_target_enabled = [bool]$claudeTargetEnabled
        claude_approved_client_enforced = [bool]$Layout.AgentApplicationControlAttested
        claude_minimum_client_version = (Get-DefenseClawClaudeMinimumClientVersion)
        approved_agent_clients_enforced = [bool]$Layout.AgentApplicationControlAttested
        claude_effective_policy_verified = [bool]$claudeEffectivePolicyVerified
        security_complete = [bool](
            $healthy -and
            $externalSecuritySatisfied
        )
        guardian_generation = $generation
        errors = @($errors)
    }
    if (-not $brokerEnabled) {
        # Standalone status also reports the services Secure Client status
        # historically omitted, plus the deployment's recorded version and
        # payload trust, so MDM detection reads one document.
        $sensorHelperName = Get-DefenseClawSensorHelperServiceName `
            -GatewayServiceName $GatewayServiceName
        $enumeratorName = Get-DefenseClawEnumeratorServiceName `
            -GuardianServiceName $GuardianServiceName
        $status['profile'] = 'standalone'
        $status['sensor_helper_service'] = $sensorHelperName
        $status['sensor_helper_service_state'] = Get-DefenseClawServiceState -Name $sensorHelperName
        $status['enumerator_service'] = $enumeratorName
        $status['enumerator_service_state'] = Get-DefenseClawServiceState -Name $enumeratorName
        $startModes = [ordered]@{}
        foreach ($name in @($GatewayServiceName, $GuardianServiceName, $enumeratorName, $sensorHelperName)) {
            $mode = Get-DefenseClawServiceStartModeName -Name $name
            if (-not [string]::IsNullOrEmpty($mode)) {
                $startModes[$name] = $mode
            }
        }
        $status['service_start_modes'] = [pscustomobject]$startModes
        # The standalone helper derives this log from the fixed layout (the
        # Service Control Manager discards service stderr).
        $status['sensor_helper_log_path'] = [IO.Path]::Combine(
            [string]$Layout.LogDirectory,
            'sensor-helper',
            'sensor-helper.log'
        )
        $recordedVersion = ''
        $recordedTrust = ''
        if ($null -ne $metadata) {
            $versionProperty = $metadata.PSObject.Properties['product_version']
            if ($null -ne $versionProperty) {
                $recordedVersion = [string]$versionProperty.Value
            }
            $trustProperty = $metadata.PSObject.Properties['trust_mode']
            if ($null -ne $trustProperty) {
                $recordedTrust = [string]$trustProperty.Value
            }
        }
        $status['installed_version'] = $recordedVersion
        $status['trust_mode'] = $recordedTrust
        if (@($script:DefenseClawQuarantinedRoots).Count -gt 0) {
            $status['quarantined_paths'] = @($script:DefenseClawQuarantinedRoots)
        }
        if (@($script:DefenseClawSquattedRootNotes).Count -gt 0) {
            $status['squatted_root_notes'] = [string[]]@($script:DefenseClawSquattedRootNotes)
        }
        if (@($script:DefenseClawTerminatedServiceProcesses).Count -gt 0) {
            $status['terminated_service_processes'] = [string[]]@($script:DefenseClawTerminatedServiceProcesses)
        }
        if (@($script:DefenseClawSkippedRuntimeFiles).Count -gt 0) {
            $status['skipped_runtime_files'] = [string[]]@($script:DefenseClawSkippedRuntimeFiles)
        }
        # Which gateway this run's pending-transaction recovery ran, and why.
        $recoveryRuns = @(Get-DefenseClawRecoveryGatewayRunRecords)
        if ($recoveryRuns.Count -gt 0) {
            $status['recovery_gateway_runs'] = $recoveryRuns
        }
        if ($null -ne $script:DefenseClawRecoveryGatewayRefusal) {
            $status['recovery_gateway_refusal'] = [pscustomobject](
                $script:DefenseClawRecoveryGatewayRefusal
            )
        }
        if (-not [string]::IsNullOrEmpty($script:DefenseClawStaleLifecycleJournalRemoved)) {
            $status['stale_lifecycle_journal_removed'] =
                $script:DefenseClawStaleLifecycleJournalRemoved
        }
        if (-not [string]::IsNullOrEmpty($script:DefenseClawStaleTeardownJournalRemoved)) {
            $status['stale_teardown_journal_removed'] =
                $script:DefenseClawStaleTeardownJournalRemoved
        }
        if ($script:DefenseClawCursorAdapterRestored) {
            $status['cursor_adapter_restored'] = $true
        }
        # What a recovered failed first install's rollback left.
        if (@($script:DefenseClawRollbackLeftovers).Count -gt 0) {
            $status['rollback_leftovers'] = [string[]]@(
                $script:DefenseClawRollbackLeftovers
            )
        }
        if (@($script:DefenseClawUserNativeOTLPCaptureSkipped).Count -gt 0) {
            $status['user_native_otlp_capture_skipped'] = [string[]]@(
                $script:DefenseClawUserNativeOTLPCaptureSkipped
            )
        }
        # The accounts whose untrusted DefenseClaw folder a retire skipped.
        if (@($script:DefenseClawRetireSkipped).Count -gt 0) {
            $status['lifecycle_retire_skipped'] = [string[]]@(
                $script:DefenseClawRetireSkipped
            )
        }
        # The signed-out accounts whose untrusted DefenseClaw folder a
        # manifest adoption went on without (GAP-0211).
        if (@($script:DefenseClawSignedOutUntrustedFolders).Count -gt 0) {
            $status['signed_out_untrusted_folders'] = [string[]]@(
                $script:DefenseClawSignedOutUntrustedFolders
            )
        }
        # What the collect of a compliant ensure removed, or why it could
        # not run (GAP-0211).
        if ([int]$script:DefenseClawRuntimeGenerationsCollected -gt 0) {
            $status['lifecycle_generations_collected'] = [int]$script:DefenseClawRuntimeGenerationsCollected
        }
        if (-not [string]::IsNullOrEmpty($script:DefenseClawRuntimeGenerationCollectError)) {
            $status['lifecycle_collect_error'] = $script:DefenseClawRuntimeGenerationCollectError
        }
        $status['claude_effective_policy_stale_reason'] = $(
            if ([string]::IsNullOrEmpty($claudeEffectivePolicyStaleReason)) {
                $null
            }
            else {
                $claudeEffectivePolicyStaleReason
            }
        )
    }
    return [pscustomobject]$status
}

function Test-DefenseClawGuardianCoverageReport {
    param(
        $Report,
        [AllowEmptyString()][string]$PriorReconcileID,
        [AllowEmptyString()][string]$PriorGeneration,
        [AllowEmptyString()][string]$PriorStateIdentity,
        [AllowEmptyString()][string]$CurrentStateIdentity,
        [AllowEmptyString()][string]$ExpectedManifestSHA256,
        [Parameter(Mandatory)][DateTime]$StartedAfter,
        [switch]$AllowFailedTargets,
        [string[]]$AllowedFailedTargetSIDs
    )
    $reject = {
        param([string]$Reason)
        return [pscustomobject][ordered]@{
            ok = $false
            generation = $null
            reconcile_id = $null
            reason = $Reason
        }
    }
    # A digest-bound activation still has to prove its exact activation
    # identity below; only the report's ok=false is excused.
    $degradedAccepted = $AllowFailedTargets -and
        (Test-DefenseClawGuardianReportCompletedWithFailedTargets -Report $Report) -and
        (Test-DefenseClawGuardianFailedTargetsWithinSIDs `
            -Report $Report -AllowedSIDs $AllowedFailedTargetSIDs)
    if (-not $degradedAccepted -and
        ($null -eq $Report -or
        $null -eq $Report.PSObject.Properties['ok'] -or
        -not [bool]$Report.ok)) {
        $issues = [Collections.Generic.List[string]]::new()
        if ($null -ne $Report -and
            $null -ne $Report.PSObject.Properties['errors']) {
            foreach ($issue in @($Report.PSObject.Properties['errors'].Value)) {
                if (-not [string]::IsNullOrWhiteSpace([string]$issue)) {
                    $issues.Add([string]$issue)
                }
            }
        }
        if ($issues.Count -eq 0) {
            $issues.Add('guardian status reported ok=false without an error')
        }
        return & $reject ($issues -join '; ')
    }
    $generation = Get-DefenseClawGuardianGeneration -Report $Report
    if ([string]::IsNullOrWhiteSpace([string]$generation)) {
        return & $reject 'guardian status has no generation timestamp'
    }
    try {
        $generationTime = [DateTime]::Parse(
            [string]$generation,
            [Globalization.CultureInfo]::InvariantCulture,
            [Globalization.DateTimeStyles]::RoundtripKind
        ).ToUniversalTime()
    }
    catch {
        return & $reject "guardian generation '$generation' is invalid"
    }
    if ($generationTime -lt $StartedAfter.ToUniversalTime()) {
        return & $reject "guardian generation '$generation' predates activation"
    }
    $reconcileID = $null
    if ([string]::IsNullOrWhiteSpace($ExpectedManifestSHA256)) {
        # Rollback may have restored the prior strict v1 binary. Its fresh,
        # healthy status is sufficient only for this no-digest recovery lane;
        # normal Install/Repair/Upgrade activation always supplies a digest.
        if (-not [string]::IsNullOrWhiteSpace($PriorGeneration) -and
            [string]$generation -ceq $PriorGeneration) {
            return & $reject "legacy guardian generation '$generation' is not fresh"
        }
        if ([string]::IsNullOrWhiteSpace($CurrentStateIdentity) -or
            (-not [string]::IsNullOrWhiteSpace($PriorStateIdentity) -and
                $CurrentStateIdentity -ceq $PriorStateIdentity)) {
            return & $reject 'legacy guardian state inode is not fresh'
        }
    }
    else {
        if ($null -eq $Report.PSObject.Properties['activation'] -or
            $null -eq $Report.activation) {
            return & $reject 'guardian status is missing protected activation coverage'
        }
        $activation = $Report.activation
        foreach ($name in @(
            'version',
            'updated_at',
            'reconcile_id',
            'manifest_sha256'
        )) {
            if ($null -eq $activation.PSObject.Properties[$name]) {
                return & $reject "guardian activation is missing $name"
            }
        }
        try {
            if ([Convert]::ToInt64($activation.version) -ne 1) {
                return & $reject 'guardian activation has an unsupported version'
            }
        }
        catch {
            return & $reject 'guardian activation has an invalid version'
        }
        $reconcileID = [string]$activation.reconcile_id
        $manifestSHA256 = [string]$activation.manifest_sha256
        if ($reconcileID -cnotmatch '^[0-9a-f]{32}$' -or
            $manifestSHA256 -cnotmatch '^[0-9a-f]{64}$') {
            return & $reject 'guardian activation has an invalid reconcile identity'
        }
        if (-not [string]::IsNullOrWhiteSpace($PriorReconcileID) -and
            $reconcileID -ceq $PriorReconcileID) {
            return & $reject "guardian reconcile ID '$reconcileID' is not fresh"
        }
        $activationGeneration = if ($activation.updated_at -is [DateTime]) {
            ConvertTo-DefenseClawGuardianTimestamp `
                -Value ([DateTime]$activation.updated_at)
        }
        else {
            [string]$activation.updated_at
        }
        if ($activationGeneration -cne [string]$generation) {
            return & $reject 'guardian activation does not identify the reported generation'
        }
        if ($manifestSHA256 -cne $ExpectedManifestSHA256) {
            return & $reject (
                "guardian manifest SHA-256 '$manifestSHA256' does not match " +
                "expected '$ExpectedManifestSHA256'"
            )
        }
    }
    return [pscustomobject][ordered]@{
        ok = $true
        generation = [string]$generation
        reconcile_id = $reconcileID
        reason = ''
    }
}

# GAP-0401: the first reconcile of a standalone guardian reads every signed-in
# target and can outlast the usual coverage wait on a busy device. Past that
# wait Setup keeps waiting, in steps and up to the hard limit, only while the
# guardian process it started is still the service process and its startup
# record shows that reconcile running and moving.
$script:GuardianFirstReconcileTimeoutSeconds = 600
$script:GuardianFirstReconcileStallSeconds = 180
$script:GuardianFirstReconcileCheckSeconds = 5

function Get-DefenseClawGuardianStartupProgress {
    <#
        The startup record of the standalone LocalSystem guardian
        (<RuntimeDirectory>\hook_guardian_startup.json): how far the first
        reconcile of guardian process ProcessId, started after StartedAfter,
        has come. $null when there is no such record (Secure Client, a release
        that does not write it, another process, or a record that cannot be
        read): the coverage wait then keeps its usual limit.
    #>
    param(
        [Parameter(Mandatory)][hashtable]$Layout,
        [Parameter(Mandatory)][uint32]$ProcessId,
        [Parameter(Mandatory)][DateTime]$StartedAfter
    )
    if ($ProcessId -eq 0 -or -not (Test-DefenseClawStandaloneProfile)) {
        return $null
    }
    try {
        $path = Microsoft.PowerShell.Management\Join-Path `
            $Layout.RuntimeDirectory `
            'hook_guardian_startup.json'
        if (-not (Microsoft.PowerShell.Management\Test-Path -LiteralPath $path -PathType Leaf)) {
            return $null
        }
        [void](Assert-DefenseClawDescendant `
            -Path $path `
            -Root $Layout.StateRoot `
            -Label 'hook guardian startup record')
        Assert-DefenseClawNoReparsePath -Path $path
        $item = Microsoft.PowerShell.Management\Get-Item -LiteralPath $path -Force
        if ($item.Length -gt 4096) {
            return $null
        }
        $record = [IO.File]::ReadAllText($path) |
            Microsoft.PowerShell.Utility\ConvertFrom-Json
        foreach ($name in @(
                'version', 'pid', 'state', 'started_at', 'updated_at',
                'targets_done', 'targets_total'
            )) {
            if ($null -eq $record.PSObject.Properties[$name]) {
                return $null
            }
        }
        if ([int64]$record.version -ne 1 -or
            [int64]$record.pid -ne [int64]$ProcessId -or
            @('reconciling', 'finished') -cnotcontains [string]$record.state) {
            return $null
        }
        $times = @(foreach ($value in @($record.started_at, $record.updated_at)) {
                # PowerShell 7 may materialize ISO JSON strings as DateTime.
                if ($value -is [DateTime]) {
                    ([DateTime]$value).ToUniversalTime()
                }
                else {
                    [DateTime]::Parse(
                        [string]$value,
                        [Globalization.CultureInfo]::InvariantCulture,
                        [Globalization.DateTimeStyles]::RoundtripKind
                    ).ToUniversalTime()
                }
            })
        if ($times[0] -lt $StartedAfter.ToUniversalTime()) {
            return $null
        }
        return [pscustomobject][ordered]@{
            state = [string]$record.state
            started_at = $times[0]
            updated_at = $times[1]
            targets_done = [int64]$record.targets_done
            targets_total = [int64]$record.targets_total
        }
    }
    catch {
        return $null
    }
}

# True when the report's state is a complete reconcile in which some targets
# failed: every enrolled target has exactly one row and the counts add up. A
# rollback restores the deployment that was there before, so a guardian that
# was degraded before the transaction may be degraded after it. Anything else
# that makes the report not ok (no state, an incomplete or inconsistent
# reconcile) is still rejected.
function Test-DefenseClawGuardianReportCompletedWithFailedTargets {
    param($Report)
    if ($null -eq $Report -or $null -eq $Report.PSObject.Properties['state'] -or
        $null -eq $Report.state) {
        return $false
    }
    $state = $Report.state
    foreach ($name in @('target_count', 'success_count', 'failure_count', 'results')) {
        if ($null -eq $state.PSObject.Properties[$name]) {
            return $false
        }
    }
    try {
        $pending = 0
        if ($null -ne $state.PSObject.Properties['pending_count'] -and $null -ne $state.pending_count) {
            $pending = [Convert]::ToInt64($state.pending_count)
        }
        $targets = [Convert]::ToInt64($state.target_count)
        $successes = [Convert]::ToInt64($state.success_count)
        $failures = [Convert]::ToInt64($state.failure_count)
    }
    catch {
        return $false
    }
    if (-not ($failures -gt 0 -and
            $successes -ge 0 -and $pending -ge 0 -and
            $successes + $failures + $pending -eq $targets -and
            @($state.results).Count -eq $targets)) {
        return $false
    }
    return (Test-DefenseClawGuardianReportErrorsAttributable `
        -Report $Report `
        -Successes $successes `
        -Pending $pending `
        -Targets $targets)
}

# Degraded coverage is accepted only when every status error comes from the
# failed targets themselves: one "last guardian reconcile failed for
# <connector>@<sid>" line per failed row, and the reconcile, authorization and
# activation "is incomplete" lines carrying exactly the state's counts. Any
# other error (a missing or unreadable authorization or activation, an
# untrusted manifest, an unreadable state) rejects the report.
function Test-DefenseClawGuardianReportErrorsAttributable {
    param(
        [Parameter(Mandatory)]$Report,
        [Parameter(Mandatory)][long]$Successes,
        [Parameter(Mandatory)][long]$Pending,
        [Parameter(Mandatory)][long]$Targets
    )
    $failedLabels = @{}
    foreach ($row in @($Report.state.results)) {
        if ($null -eq $row) {
            continue
        }
        $okProperty = $row.PSObject.Properties['ok']
        $pendingProperty = $row.PSObject.Properties['pending']
        $rowOk = $null -ne $okProperty -and $okProperty.Value -is [bool] -and [bool]$okProperty.Value
        $rowPending = $null -ne $pendingProperty -and $pendingProperty.Value -is [bool] -and [bool]$pendingProperty.Value
        if ($rowOk -or $rowPending) {
            continue
        }
        $connector = ''
        $sid = ''
        if ($null -ne $row.PSObject.Properties['connector']) { $connector = ([string]$row.connector).Trim() }
        if ($null -ne $row.PSObject.Properties['sid']) { $sid = [string]$row.sid }
        if ([string]::IsNullOrEmpty($sid)) {
            return $false
        }
        $failedLabels["$connector@$sid"] = $true
    }
    $errorsProperty = $Report.PSObject.Properties['errors']
    if ($null -eq $errorsProperty -or $null -eq $errorsProperty.Value) {
        return $true
    }
    $countsPattern = '^(?:last guardian reconcile|protected guardian authorization|protected guardian activation) is incomplete \((\d+) succeeded, (\d+) pending, (\d+) total\)$'
    foreach ($entry in @($errorsProperty.Value)) {
        $text = ([string]$entry).Trim()
        $failed = [regex]::Match($text, '^last guardian reconcile failed for (\S+): ')
        if ($failed.Success) {
            if (-not $failedLabels.ContainsKey($failed.Groups[1].Value)) {
                return $false
            }
            continue
        }
        $counts = [regex]::Match($text, $countsPattern)
        if ($counts.Success -and
            [long]$counts.Groups[1].Value -eq $Successes -and
            [long]$counts.Groups[2].Value -eq $Pending -and
            [long]$counts.Groups[3].Value -eq $Targets) {
            continue
        }
        return $false
    }
    return $true
}

# The pending (signed-out) target rows of a Guardian status report, each as
# connector and sid. Empty when the report has no reconcile state.
function Get-DefenseClawGuardianPendingTargets {
    param($Report)
    $pending = [Collections.Generic.List[object]]::new()
    if ($null -eq $Report -or $null -eq $Report.PSObject.Properties['state'] -or
        $null -eq $Report.state -or
        $null -eq $Report.state.PSObject.Properties['results']) {
        return @()
    }
    foreach ($row in @($Report.state.results)) {
        if ($null -eq $row) {
            continue
        }
        $pendingProperty = $row.PSObject.Properties['pending']
        if ($null -eq $pendingProperty -or $pendingProperty.Value -isnot [bool] -or -not [bool]$pendingProperty.Value) {
            continue
        }
        $values = @{}
        foreach ($name in @('connector', 'sid')) {
            $property = $row.PSObject.Properties[$name]
            if ($null -eq $property) {
                $values[$name] = ''
            }
            else {
                $values[$name] = [string]$property.Value
            }
        }
        $pending.Add([pscustomobject]$values)
    }
    return @($pending.ToArray())
}

# The failed (not pending) target rows of a Guardian status report, each as
# connector, sid and error. Empty when the report has no reconcile state.
function Get-DefenseClawGuardianFailedTargets {
    param($Report)
    $failed = [Collections.Generic.List[object]]::new()
    if ($null -eq $Report -or $null -eq $Report.PSObject.Properties['state'] -or
        $null -eq $Report.state -or
        $null -eq $Report.state.PSObject.Properties['results']) {
        return @()
    }
    foreach ($row in @($Report.state.results)) {
        if ($null -eq $row) {
            continue
        }
        $okProperty = $row.PSObject.Properties['ok']
        if ($null -ne $okProperty -and $okProperty.Value -is [bool] -and [bool]$okProperty.Value) {
            continue
        }
        $pendingProperty = $row.PSObject.Properties['pending']
        if ($null -ne $pendingProperty -and $pendingProperty.Value -is [bool] -and [bool]$pendingProperty.Value) {
            continue
        }
        $values = @{}
        foreach ($name in @('connector', 'sid', 'error')) {
            $property = $row.PSObject.Properties[$name]
            if ($null -eq $property) {
                $values[$name] = ''
            }
            else {
                $values[$name] = [string]$property.Value
            }
        }
        $failed.Add([pscustomobject]$values)
    }
    return @($failed.ToArray())
}

# An activation that skipped account roots may accept Guardian failures only
# for those accounts. An empty list preserves the existing Secure Client and
# rollback behavior, where any completed per-target failure is reported as
# degraded. The caller must first validate the report as complete.
function Test-DefenseClawGuardianFailedTargetsWithinSIDs {
    param(
        [Parameter(Mandatory)]$Report,
        [string[]]$AllowedSIDs
    )
    if ($null -eq $AllowedSIDs -or $AllowedSIDs.Count -eq 0) {
        return $true
    }
    $allowed = [Collections.Generic.HashSet[string]]::new(
        [StringComparer]::OrdinalIgnoreCase
    )
    foreach ($sid in $AllowedSIDs) {
        if ([string]::IsNullOrWhiteSpace($sid)) {
            return $false
        }
        [void]$allowed.Add($sid)
    }
    foreach ($target in @(Get-DefenseClawGuardianFailedTargets -Report $Report)) {
        if (-not $allowed.Contains([string]$target.sid)) {
            return $false
        }
    }
    return $true
}

function Get-DefenseClawAllowedFailedTargetSIDs {
    param([Parameter(Mandatory)]$Plan)
    if (-not (Test-DefenseClawStandaloneProfile)) {
        return , [string[]]@()
    }
    return , [string[]]@(
        Get-DefenseClawTargetRuntimeSkippedProfiles -Plan $Plan |
            Microsoft.PowerShell.Core\ForEach-Object { [string]$_.sid }
    )
}

# Install and Upgrade succeed when the Guardian completed a fresh reconcile in
# which some user targets failed: the deployment is live and every other user
# is protected. Each failed target is recorded once as defenseclaw_degraded.
function Write-DefenseClawGuardianDegradedTargets {
    param($Report)
    foreach ($target in @(Get-DefenseClawGuardianFailedTargets -Report $Report)) {
        $reason = [string]$target.error
        if ([string]::IsNullOrWhiteSpace($reason)) {
            $reason = 'target failed without an error'
        }
        Write-DefenseClawResilienceEvent -Marker defenseclaw_degraded -Fields @{
            subsystem = 'guardian'
            connector = [string]$target.connector
            sid       = [string]$target.sid
            reason    = "user target failed in a completed reconcile; the deployment is live for every other target: $(ConvertTo-DefenseClawBoundedDiagnostic -Value $reason)"
        }
    }
}

# The connector|SID keys of the failing rows of an `enterprise hooks verify`
# report, or $null when the report is missing, unparsable, or fails for a
# reason that is not a per-target row. The one authorization error tolerated
# is the incomplete-authorization verdict a degraded reconcile leaves, and
# only when the Guardian reported at least one failed target and the
# verdict's failure count (total - succeeded - pending) is at most the
# Guardian's failed plus pending targets: verify counts a signed-out target
# as pending only while the authorization is complete, so a degraded
# authorization reports it as a failure. Any other or compound authorization
# error is $null.
function Get-DefenseClawVerifyFailedTargetKeys {
    param(
        [Parameter(Mandatory)]$Probe,
        [int]$GuardianFailedTargetCount = 0,
        [int]$GuardianPendingTargetCount = 0
    )
    $report = $null
    foreach ($line in @($Probe.output)) {
        $text = ([string]$line).Trim()
        if (-not $text.StartsWith('{')) {
            continue
        }
        try {
            $candidate = $text | Microsoft.PowerShell.Utility\ConvertFrom-Json
            $okProperty = $candidate.PSObject.Properties['ok']
            if ($null -ne $okProperty -and $okProperty.Value -is [bool]) {
                $report = $candidate
                break
            }
        }
        catch {
            continue
        }
    }
    if ($null -eq $report) {
        return $null
    }
    $authorizationAccepted = $false
    $authorizationProperty = $report.PSObject.Properties['authorization_error']
    if ($null -ne $authorizationProperty -and
        -not [string]::IsNullOrWhiteSpace([string]$authorizationProperty.Value)) {
        $incomplete = [regex]::Match(
            [string]$authorizationProperty.Value,
            '\Aprotected hook guardian authorization is incomplete \((\d+) succeeded, (\d+) pending, (\d+) total\)\z'
        )
        if ($GuardianFailedTargetCount -le 0 -or -not $incomplete.Success) {
            return $null
        }
        $authorizationFailures = [int64]$incomplete.Groups[3].Value -
            [int64]$incomplete.Groups[1].Value -
            [int64]$incomplete.Groups[2].Value
        if ($authorizationFailures -lt 0 -or $GuardianPendingTargetCount -lt 0 -or
            $authorizationFailures -gt ($GuardianFailedTargetCount + $GuardianPendingTargetCount)) {
            return $null
        }
        $authorizationAccepted = $true
    }
    $resultsProperty = $report.PSObject.Properties['results']
    if ($null -eq $resultsProperty) {
        return $null
    }
    $keys = [Collections.Generic.List[string]]::new()
    foreach ($row in @($resultsProperty.Value)) {
        if ($null -eq $row) {
            continue
        }
        $rowOK = $row.PSObject.Properties['ok']
        if ($null -ne $rowOK -and $rowOK.Value -is [bool] -and [bool]$rowOK.Value) {
            continue
        }
        $connectorProperty = $row.PSObject.Properties['connector']
        $sidProperty = $row.PSObject.Properties['sid']
        if ($null -eq $connectorProperty -or $null -eq $sidProperty) {
            return $null
        }
        $keys.Add(('{0}|{1}' -f ([string]$connectorProperty.Value).ToLowerInvariant(), ([string]$sidProperty.Value).ToUpperInvariant()))
    }
    # A failed report with neither a failing row nor the tolerated
    # authorization verdict is not a per-target failure.
    if ($keys.Count -eq 0 -and -not $authorizationAccepted) {
        return $null
    }
    return , $keys.ToArray()
}

function Wait-DefenseClawFreshGuardianReconcile {
    param(
        [Parameter(Mandatory)][hashtable]$Layout,
        [Parameter(Mandatory)][string]$GatewayServiceName,
        [Parameter(Mandatory)][string]$GuardianServiceName,
        [string]$ExpectedManifestSHA256,
        [int]$TimeoutSeconds = 90,
        # A fresh, complete reconcile with failed targets: in rollback and
        # recovery it is the deployment being restored; in Install and
        # Upgrade activation the deployment is live and degraded (each
        # failed target is logged). A reconcile that never completes, or a
        # status that is not fresh, still fails.
        [switch]$AllowFailedTargets,
        [string[]]$AllowedFailedTargetSIDs
    )
    if (-not [string]::IsNullOrWhiteSpace($ExpectedManifestSHA256) -and
        $ExpectedManifestSHA256 -cnotmatch '^[0-9a-f]{64}$') {
        throw 'expected Guardian manifest SHA-256 is invalid'
    }
    $priorReport = Get-DefenseClawGuardianStatusReport `
        -Layout $Layout `
        -GatewayServiceName $GatewayServiceName `
        -TimeoutSeconds ([Math]::Max(30, [Math]::Min(300, $TimeoutSeconds + 30)))
    $priorReconcileID = [string](Get-DefenseClawGuardianReconcileID `
        -Report $priorReport)
    $priorGeneration = [string](Get-DefenseClawGuardianGeneration `
        -Report $priorReport)
    $priorStateIdentity = [string](Get-DefenseClawGuardianStateIdentity `
        -Layout $Layout)
    $startedAfter = [DateTime]::UtcNow.AddSeconds(-1)
    Stop-DefenseClawService -Name $GuardianServiceName
    Start-DefenseClawService -Name $GuardianServiceName

    $begin = [DateTime]::UtcNow
    $guardianProcess = {
        try {
            return [uint32](Get-DefenseClawServiceProcessId -Name $GuardianServiceName)
        }
        catch {
            return [uint32]0
        }
    }
    $guardianProcessId = [uint32]0
    if (Test-DefenseClawStandaloneProfile) {
        $guardianProcessId = & $guardianProcess
    }
    $deadline = $begin.AddSeconds($TimeoutSeconds)
    $limit = $begin.AddSeconds([Math]::Max(
            $TimeoutSeconds,
            $script:GuardianFirstReconcileTimeoutSeconds
        ))
    $extended = $false
    $finishedRead = $false
    $progress = $null
    $guardianGone = ''
    $lastStatus = 'guardian status report unavailable'
    # Standalone: each status probe is a gateway process (about 0.4 s), and
    # one every 0.25 s was about 230 processes in the 92 s budget (GAP-0044).
    # The guardian publishes a reconcile by replacing its state file, so the
    # loop reads that file's identity in process every 0.25 s and runs the
    # status command when it changed, or 2 s after the last one. Secure
    # Client keeps probing every pass.
    $probeOnChange = Test-DefenseClawStandaloneProfile
    $probedAt = [DateTime]::MinValue
    $probedStateIdentity = $null
    while ($true) {
        if ($probeOnChange) {
            $now = [DateTime]::UtcNow
            if ($now -lt $deadline -and ($now - $probedAt).TotalMilliseconds -lt 2000) {
                # A read that fails here is left to the probe's own read.
                $unchanged = $false
                try {
                    $unchanged = [string](Get-DefenseClawGuardianStateIdentity -Layout $Layout) -ceq $probedStateIdentity
                }
                catch {
                    $unchanged = $false
                }
                if ($unchanged) {
                    Microsoft.PowerShell.Utility\Start-Sleep -Milliseconds 250
                    continue
                }
            }
        }
        # One status command may not outlast the hard limit by more than
        # its own 30 s floor: with the command's 300 s default the 600 s
        # limit was not a bound (rel-1-0-2:GAP-0535).
        $probeTimeout = [int][Math]::Ceiling(($limit - [DateTime]::UtcNow).TotalSeconds) + 30
        $probeTimeout = [Math]::Max(30, [Math]::Min(300, $probeTimeout))
        $report = Get-DefenseClawGuardianStatusReport `
            -Layout $Layout `
            -GatewayServiceName $GatewayServiceName `
            -TimeoutSeconds $probeTimeout
        $currentStateIdentity = [string](
            Get-DefenseClawGuardianStateIdentity -Layout $Layout
        )
        $probedAt = [DateTime]::UtcNow
        $probedStateIdentity = $currentStateIdentity
        $coverage = Test-DefenseClawGuardianCoverageReport `
            -Report $report `
            -PriorReconcileID $priorReconcileID `
            -PriorGeneration $priorGeneration `
            -PriorStateIdentity $priorStateIdentity `
            -CurrentStateIdentity $currentStateIdentity `
            -ExpectedManifestSHA256 $ExpectedManifestSHA256 `
            -StartedAfter $startedAfter `
            -AllowFailedTargets:$AllowFailedTargets `
            -AllowedFailedTargetSIDs $AllowedFailedTargetSIDs
        if ([bool]$coverage.ok) {
            if ($AllowFailedTargets) {
                Write-DefenseClawGuardianDegradedTargets -Report $report
            }
            return [string]$coverage.generation
        }
        $lastStatus = ConvertTo-DefenseClawBoundedDiagnostic `
            -Value $coverage.reason
        $now = [DateTime]::UtcNow
        if ($now -ge $deadline) {
            if ($guardianProcessId -eq 0 -or $now -ge $limit) {
                break
            }
            $current = & $guardianProcess
            if ($current -ne $guardianProcessId) {
                $guardianGone = if ($current -eq 0) {
                    'is no longer running'
                }
                else {
                    "was replaced by process $current"
                }
                break
            }
            # A record the guardian is replacing right now cannot be read;
            # the last one read stands until the stall limit.
            $read = Get-DefenseClawGuardianStartupProgress `
                -Layout $Layout `
                -ProcessId $guardianProcessId `
                -StartedAfter $startedAfter
            if ($null -ne $read) {
                $progress = $read
            }
            if ($null -eq $progress) {
                break
            }
            if ($progress.state -cne 'reconciling') {
                # The first reconcile finished after the status above was
                # read: read the records it published once more.
                if ($finishedRead) {
                    break
                }
                $finishedRead = $true
                $deadline = $now.AddSeconds(2)
                $probedAt = [DateTime]::MinValue
                Microsoft.PowerShell.Utility\Start-Sleep -Milliseconds 250
                continue
            }
            if (($now - $progress.updated_at).TotalSeconds -gt $script:GuardianFirstReconcileStallSeconds) {
                break
            }
            $extended = $true
            $deadline = $now.AddSeconds($script:GuardianFirstReconcileCheckSeconds)
            if ($deadline -gt $limit) {
                $deadline = $limit
            }
        }
        Microsoft.PowerShell.Utility\Start-Sleep -Milliseconds 250
    }
    $waited = [int][Math]::Round(([DateTime]::UtcNow - $begin).TotalSeconds)
    $guardianLog = "the guardian log is $([string]$Layout.GuardianLogPath)"
    if (-not [string]::IsNullOrEmpty($guardianGone)) {
        throw "LocalSystem guardian did not publish fresh required coverage: the hook guardian process $guardianProcessId $guardianGone during its first reconcile ($waited s after Setup started it); $guardianLog; last_status=$lastStatus"
    }
    if ($null -ne $progress -and $progress.state -ceq 'reconciling') {
        $quiet = [int][Math]::Round(([DateTime]::UtcNow - $progress.updated_at).TotalSeconds)
        throw "LocalSystem guardian did not publish fresh required coverage: the hook guardian's first reconcile is still running after $waited s ($($progress.targets_done) of $($progress.targets_total) targets done, last progress $quiet s ago); $guardianLog; last_status=$lastStatus"
    }
    if ($extended -or $guardianProcessId -ne 0) {
        throw "LocalSystem guardian restarted but did not publish fresh required coverage within $([Math]::Max($TimeoutSeconds, $waited)) seconds; $guardianLog; last_status=$lastStatus"
    }
    throw "LocalSystem guardian restarted but did not publish fresh required coverage within $TimeoutSeconds seconds; last_status=$lastStatus"
}

function Get-DefenseClawStandaloneIPCSocketLeaves {
    <#
        The exact AF_UNIX socket files a standalone deployment may leave in
        its managed IPC directory under InstallRoot: the sensor helper's
        acquisition socket and, if a GUI build ever bound it, the UI IPC
        socket. Windows backs AF_UNIX socket files with a reparse point, so
        these are the only reparse points a standalone install tree may
        contain. Secure Client returns nothing here and keeps its own
        allow-list.
    #>
    param([Parameter(Mandatory)][hashtable]$Layout)
    if (-not (Test-DefenseClawStandaloneProfile)) {
        return @()
    }
    $directory = [IO.Path]::GetFullPath([string]$Layout.ManagedIPCDirectory).TrimEnd('\')
    return @(
        [IO.Path]::GetFullPath((Microsoft.PowerShell.Management\Join-Path $directory 'sensor-helper.sock')),
        [IO.Path]::GetFullPath((Microsoft.PowerShell.Management\Join-Path $directory 'defenseclaw_ipc.sock'))
    )
}

function Get-DefenseClawSecureClientSensorHelperSocketLeaves {
    <#
        The sensor helper's AF_UNIX acquisition socket in a Secure Client
        deployment's managed IPC directory under InstallRoot. A layout that
        carries the sensor helper binds it there; Windows backs the socket
        file with a reparse point, so it is the only reparse point besides the
        gateway's IPC socket a Secure Client install tree may contain.
        Standalone (Get-DefenseClawStandaloneIPCSocketLeaves) and a layout
        without the sensor helper return nothing.
    #>
    param([Parameter(Mandatory)][hashtable]$Layout)
    if ((Test-DefenseClawStandaloneProfile) -or
        [string]::IsNullOrWhiteSpace([string](Get-DefenseClawOptionalLayoutValue -Layout $Layout -Name SensorHelperPath)) -or
        [string]::IsNullOrWhiteSpace([string](Get-DefenseClawOptionalLayoutValue -Layout $Layout -Name ManagedIPCDirectory))) {
        return @()
    }
    $directory = [IO.Path]::GetFullPath([string]$Layout.ManagedIPCDirectory).TrimEnd('\')
    return @(
        [IO.Path]::GetFullPath((Microsoft.PowerShell.Management\Join-Path $directory 'sensor-helper.sock'))
    )
}

function Get-DefenseClawStandaloneOpenCodePluginPaths {
    <#
        The managed OpenCode plugin a standalone deployment carries at
        <InstallRoot>\share\opencode\index.js (enterprisepolicy
        OpenCodeManagedPluginPath) and its two directories. The guardian
        writes it from the payload binaries before it publishes OpenCode's
        managed config. Secure Client returns nothing and keeps its own
        allow-list.
    #>
    param([Parameter(Mandatory)][hashtable]$Layout)
    if (-not (Test-DefenseClawStandaloneProfile)) {
        return $null
    }
    $share = [IO.Path]::GetFullPath(
        [IO.Path]::Combine([string]$Layout.InstallRoot, 'share')
    ).TrimEnd('\')
    $directory = [IO.Path]::Combine($share, 'opencode')
    return @{
        ShareDirectory = $share
        PluginDirectory = $directory
        PluginPath = [IO.Path]::Combine($directory, 'index.js')
        # Retained for upgrades from the v1-only bridge throughout 1.x.
        LegacyPluginPath = [IO.Path]::Combine($directory, 'defenseclaw.js')
    }
}

function Remove-DefenseClawStandaloneOpenCodeManagedPlugin {
    <#
        Standalone uninstall: after every DefenseClaw service is removed,
        delete the managed OpenCode plugin and its share directories (the
        guardian's teardown normally removed them already), so the
        install-tree removal below sees only bin and libexec. A link, a
        non-file plugin or anything else in those directories aborts the
        uninstall. Secure Client is unchanged.
    #>
    param([Parameter(Mandatory)][hashtable]$Layout)
    $paths = Get-DefenseClawStandaloneOpenCodePluginPaths -Layout $Layout
    if ($null -eq $paths) {
        return
    }
    $plugin = [string]$paths.PluginPath
    $legacy = [string]$paths.LegacyPluginPath
    # Every check runs before anything is deleted, so a refusal removes
    # nothing.
    $expected = @(
        @([string]$paths.PluginDirectory, $plugin),
        @([string]$paths.ShareDirectory, [string]$paths.PluginDirectory)
    )
    foreach ($pair in $expected) {
        $directory = [string]$pair[0]
        if (-not (Microsoft.PowerShell.Management\Test-Path -LiteralPath $directory)) {
            continue
        }
        $item = Microsoft.PowerShell.Management\Get-Item -LiteralPath $directory -Force
        if (-not $item.PSIsContainer -or
            ($item.Attributes -band [IO.FileAttributes]::ReparsePoint) -ne 0) {
            throw "refusing to remove managed OpenCode path that is not a plain directory: $directory"
        }
        foreach ($child in @(Microsoft.PowerShell.Management\Get-ChildItem -LiteralPath $directory -Force)) {
            $full = [IO.Path]::GetFullPath([string]$child.FullName)
            $isPlugin = [string]::Equals($full, $plugin, [StringComparison]::OrdinalIgnoreCase) -or
                [string]::Equals($full, $legacy, [StringComparison]::OrdinalIgnoreCase)
            $isExpectedPlugin = $isPlugin -and [string]::Equals($directory, [string]$paths.PluginDirectory, [StringComparison]::OrdinalIgnoreCase)
            if (-not $isExpectedPlugin -and -not [string]::Equals($full, [string]$pair[1], [StringComparison]::OrdinalIgnoreCase)) {
                throw "refusing to remove unexpected managed OpenCode content: $full"
            }
            $plain = ($child.Attributes -band [IO.FileAttributes]::ReparsePoint) -eq 0
            if ($isPlugin -and
                ($child.PSIsContainer -or -not $plain)) {
                throw "refusing to remove managed OpenCode plugin that is not a plain file: $full"
            }
            if (-not $plain) {
                throw "refusing to remove managed OpenCode path that is not a plain directory: $full"
            }
        }
    }
    foreach ($file in @($plugin, $legacy)) {
        if ([IO.File]::Exists($file)) { [IO.File]::Delete($file) }
    }
    foreach ($directory in @([string]$paths.PluginDirectory, [string]$paths.ShareDirectory)) {
        if (Microsoft.PowerShell.Management\Test-Path -LiteralPath $directory) {
            [IO.Directory]::Delete($directory, $false)
        }
    }
}

function Test-DefenseClawStandaloneIPCSocketLeaf {
    <#
        True only for an allowed standalone socket leaf that is a plain
        AF_UNIX reparse file: never a directory, never a symbolic link,
        junction or mount point (those resolve a LinkTarget).
    #>
    param(
        [Parameter(Mandatory)][object]$Item,
        [Parameter(Mandatory)][AllowEmptyCollection()][string[]]$Leaves
    )
    if ($Item.PSIsContainer) {
        return $false
    }
    $full = [IO.Path]::GetFullPath([string]$Item.FullName)
    $allowed = $false
    foreach ($leaf in $Leaves) {
        if ([string]::Equals($full, $leaf, [StringComparison]::OrdinalIgnoreCase)) {
            $allowed = $true
        }
    }
    if (-not $allowed) {
        return $false
    }
    if (($Item.Attributes -band [IO.FileAttributes]::ReparsePoint) -eq 0) {
        return $true
    }
    # A link resolves a target; an AF_UNIX socket file does not. PowerShell 7
    # reports it as LinkTarget. Windows PowerShell 5.1, which Setup runs, has
    # no LinkTarget and reports Target and LinkType instead, so reading only
    # LinkTarget refused every live socket there.
    $inspected = $false
    foreach ($name in @('LinkTarget', 'Target', 'LinkType')) {
        $property = $Item.PSObject.Properties[$name]
        if ($null -eq $property) {
            continue
        }
        try {
            $value = $property.Value
        }
        catch {
            return $false
        }
        if (-not [string]::IsNullOrEmpty((@($value) -join ''))) {
            return $false
        }
        $inspected = $true
    }
    return $inspected
}

function Remove-DefenseClawStandaloneManagedIPCDirectory {
    <#
        Standalone uninstall: after every DefenseClaw service is removed,
        delete the managed IPC directory under InstallRoot and the stale
        socket files the gateway and sensor helper left in it, so the
        install-tree removal below sees only bin and libexec. Anything else
        in the directory aborts the uninstall. Secure Client is unchanged.
    #>
    param([Parameter(Mandatory)][hashtable]$Layout)
    if (-not (Test-DefenseClawStandaloneProfile)) {
        return
    }
    $directory = [IO.Path]::GetFullPath([string]$Layout.ManagedIPCDirectory).TrimEnd('\')
    if (-not (Microsoft.PowerShell.Management\Test-Path -LiteralPath $directory)) {
        return
    }
    $item = Microsoft.PowerShell.Management\Get-Item -LiteralPath $directory -Force
    if (-not $item.PSIsContainer -or
        ($item.Attributes -band [IO.FileAttributes]::ReparsePoint) -ne 0) {
        throw "refusing to remove managed IPC path that is not a plain directory: $directory"
    }
    $leaves = @(Get-DefenseClawStandaloneIPCSocketLeaves -Layout $Layout)
    foreach ($child in @(Microsoft.PowerShell.Management\Get-ChildItem -LiteralPath $directory -Force)) {
        if (-not (Test-DefenseClawStandaloneIPCSocketLeaf -Item $child -Leaves $leaves)) {
            throw "refusing to remove unexpected managed IPC content: $($child.FullName)"
        }
    }
    foreach ($child in @(Microsoft.PowerShell.Management\Get-ChildItem -LiteralPath $directory -Force)) {
        [IO.File]::Delete([string]$child.FullName)
    }
    [IO.Directory]::Delete($directory, $false)
}

function Get-DefenseClawEmptyRetiredCompilerDirectories {
    <#
        GAP-0270: a 1.0.2 standalone install created InstallRoot\lib\defenseclaw
        for the Fleet policy compiler, which this release no longer installs.
        Returns those two retired directories that exist as plain directories
        and hold nothing (lib may hold only an empty lib\defenseclaw), deepest
        first. A directory with any other content, or a reparse point, is not
        returned, so the callers keep refusing it.
    #>
    param([Parameter(Mandatory)][string]$InstallRoot)
    $lib = [IO.Path]::GetFullPath([IO.Path]::Combine($InstallRoot, 'lib')).TrimEnd('\')
    $empty = [Collections.Generic.List[string]]::new()
    foreach ($directory in @([IO.Path]::Combine($lib, 'defenseclaw'), $lib)) {
        $item = Microsoft.PowerShell.Management\Get-Item -LiteralPath $directory -Force -ErrorAction SilentlyContinue
        if ($null -eq $item -or -not $item.PSIsContainer -or
            ($item.Attributes -band [IO.FileAttributes]::ReparsePoint) -ne 0) {
            continue
        }
        $content = @(
            Microsoft.PowerShell.Management\Get-ChildItem -LiteralPath $directory -Force |
                Microsoft.PowerShell.Core\Where-Object {
                    [IO.Path]::GetFullPath([string]$_.FullName).TrimEnd('\') -notin $empty
                }
        )
        if ($content.Count -eq 0) {
            $empty.Add($directory)
        }
    }
    return $empty.ToArray()
}

function Get-DefenseClawRecordedStandaloneCompilerPath {
    <#
        GAP-0274: Setup carries no Fleet policy compiler, so a Fleet-enabled
        1.0.2 standalone host keeps the compiler it installed, unchanged.
        Returns that compiler's full path when it is a plain file whose SHA-256
        matches the hash the protected deployment metadata records for it, and
        '' when there is no compiler file or no record (callers then refuse or
        retire it as before). A compiler whose bytes differ from its record is
        refused here, before anything changes.
    #>
    param([Parameter(Mandatory)][hashtable]$Layout)
    if (-not (Test-DefenseClawStandaloneProfile)) {
        return ''
    }
    $compilerPath = [IO.Path]::GetFullPath(
        [IO.Path]::Combine($Layout.InstallRoot, 'lib', 'defenseclaw', 'policy_compiler.py')
    )
    Assert-DefenseClawNoReparsePath -Path $compilerPath -AllowMissingLeaf
    if (-not (Microsoft.PowerShell.Management\Test-Path -LiteralPath $compilerPath -PathType Leaf)) {
        return ''
    }
    $Metadata = $null
    if (-not [string]::IsNullOrWhiteSpace((Get-DefenseClawOptionalLayoutValue -Layout $Layout -Name MetadataPath))) {
        $Metadata = Get-DefenseClawDeploymentMetadata -Layout $Layout
    }
    $recorded = ''
    if ($null -ne $Metadata -and
        $null -ne $Metadata.PSObject.Properties['hashes'] -and
        $null -ne $Metadata.hashes) {
        $property = $Metadata.hashes.PSObject.Properties['compiler']
        if ($null -ne $property) {
            $recorded = ([string]$property.Value).Trim()
        }
    }
    if ([string]::IsNullOrWhiteSpace($recorded)) {
        return ''
    }
    $actual = (Microsoft.PowerShell.Utility\Get-FileHash -LiteralPath $compilerPath -Algorithm SHA256).Hash
    if (-not [string]::Equals($actual, $recorded, [StringComparison]::OrdinalIgnoreCase)) {
        throw (
            "the installed Fleet policy compiler does not match the hash deployment metadata records for it: $compilerPath. " +
            'DefenseClaw keeps a recorded compiler only while it is unchanged; nothing was changed'
        )
    }
    return $compilerPath
}

function Remove-DefenseClawRetiredStandaloneCompiler {
    <#
        Fleet-off Install, Upgrade and Repair remove the Fleet compiler an
        older standalone install left, then lib\defenseclaw and lib once they
        are empty, so a later uninstall finds no leftover tree (GAP-0270). A
        directory with any other content stays for the uninstall to refuse.
    #>
    param([Parameter(Mandatory)][hashtable]$Layout)
    $compilerPath = [IO.Path]::Combine($Layout.InstallRoot, 'lib', 'defenseclaw', 'policy_compiler.py')
    Assert-DefenseClawNoReparsePath -Path $compilerPath -AllowMissingLeaf
    if (Microsoft.PowerShell.Management\Test-Path -LiteralPath $compilerPath -PathType Leaf) {
        [IO.File]::Delete($compilerPath)
    }
    foreach ($directory in @(Get-DefenseClawEmptyRetiredCompilerDirectories -InstallRoot $Layout.InstallRoot)) {
        [IO.Directory]::Delete($directory, $false)
    }
}

function Remove-DefenseClawSecureClientSensorHelperSocket {
    <#
        Secure Client uninstall: after the sensor helper service is removed,
        delete the stale socket file it left in the managed IPC directory, so
        the install-tree removal below sees only the gateway's IPC socket. A
        file at that path that is not a plain AF_UNIX socket (a link, a
        junction or a directory) aborts the uninstall. The directory itself
        and everything else in it stay for the tree removal.
    #>
    param([Parameter(Mandatory)][hashtable]$Layout)
    $leaves = @(Get-DefenseClawSecureClientSensorHelperSocketLeaves -Layout $Layout)
    foreach ($leaf in $leaves) {
        $item = Microsoft.PowerShell.Management\Get-Item -LiteralPath $leaf -Force -ErrorAction SilentlyContinue
        if ($null -eq $item) {
            continue
        }
        if (-not (Test-DefenseClawStandaloneIPCSocketLeaf -Item $item -Leaves $leaves)) {
            throw "refusing to remove unexpected managed IPC content: $leaf"
        }
        [IO.File]::Delete($leaf)
    }
}

function Assert-DefenseClawManagedInstallTree {
    param([Parameter(Mandatory)][hashtable]$Layout)
    # ManagedIPCDirectory and ManagedIPCSocketPath live under InstallRoot
    # (path parity with internal/ipc/paths_windows.go).
    # The gateway creates <InstallRoot>\ipc\ on service start and binds
    # the AF_UNIX socket <InstallRoot>\ipc\defenseclaw_ipc.sock inside it;
    # the graceful stop removes the socket file but not the directory, so
    # uninstall MUST accept both in its inventory or the tree walk trips
    # on the empty ipc\ dir before rename/removal can proceed.
    $managedIPCSocketPath = (Get-DefenseClawOptionalLayoutValue -Layout $Layout -Name ManagedIPCSocketPath)
    $refuseUnexpected = (Test-DefenseClawTrustStrictAncestors) -or
        (Test-DefenseClawStandaloneProfile)
    $retiredLibRoot = [IO.Path]::GetFullPath([IO.Path]::Combine($Layout.InstallRoot, 'lib')).TrimEnd('\')
    $retiredLibDirectories = @($retiredLibRoot, [IO.Path]::Combine($retiredLibRoot, 'defenseclaw'))
    $allowedDirectories = @(
        $Layout.BinDirectory,
        $Layout.LibexecDirectory,
        $Layout.ManagedIPCDirectory
    )
    if (Test-DefenseClawLayoutBrokerEnabled -Layout $Layout) {
        $allowedDirectories += (Microsoft.PowerShell.Management\Join-Path `
            $Layout.InstallRoot 'secure-client.install')
    }
    # Standalone keeps its managed IPC directory (sensor helper socket)
    # under InstallRoot; only that directory and its exact socket leaves are
    # added. Secure Client also carries the empty install-marker directory.
    $standaloneIPCLeaves = @(Get-DefenseClawStandaloneIPCSocketLeaves -Layout $Layout)
    if ($standaloneIPCLeaves.Count -gt 0) {
        $allowedDirectories += [IO.Path]::GetFullPath([string]$Layout.ManagedIPCDirectory).TrimEnd('\')
    }
    # The empty lib tree a 1.0.2 standalone install left for the retired
    # Fleet compiler (GAP-0270). Anything inside it is still refused.
    if (Test-DefenseClawStandaloneProfile) {
        $allowedDirectories += @(Get-DefenseClawEmptyRetiredCompilerDirectories -InstallRoot $Layout.InstallRoot)
    }
    # A Secure Client layout with the sensor helper also admits its exact
    # socket leaf; every other reparse point is still refused below.
    $sensorHelperSocketLeaves = @(Get-DefenseClawSecureClientSensorHelperSocketLeaves -Layout $Layout)
    $allowedFiles = @(
        $Layout.BrokerPath,
        $Layout.GatewayPath,
        $Layout.ACPPath,
        $Layout.HookPath,
        $Layout.SensorHelperPath,
        $Layout.CLIPath,
        $Layout.InstallerPath,
        $Layout.ModulePath,
        $managedIPCSocketPath
    )
    # Standalone also carries the managed OpenCode plugin under share\opencode.
    $openCodePlugin = Get-DefenseClawStandaloneOpenCodePluginPaths -Layout $Layout
    if ($null -ne $openCodePlugin) {
        $allowedDirectories += [string]$openCodePlugin.ShareDirectory
        $allowedDirectories += [string]$openCodePlugin.PluginDirectory
        $allowedFiles += [string]$openCodePlugin.PluginPath
        $allowedFiles += [string]$openCodePlugin.LegacyPluginPath
    }
    # A Fleet-enabled 1.0.2 host keeps its compiler (GAP-0274). Only the
    # recorded, unchanged compiler and its two directories are accepted; an
    # unrecorded compiler stays refused and a changed one throws.
    $recordedCompiler = Get-DefenseClawRecordedStandaloneCompilerPath -Layout $Layout
    if (-not [string]::IsNullOrEmpty($recordedCompiler)) {
        $allowedFiles += $recordedCompiler
        $allowedDirectories += [IO.Path]::GetDirectoryName($recordedCompiler)
        $allowedDirectories += [IO.Path]::GetDirectoryName([IO.Path]::GetDirectoryName($recordedCompiler))
    }
    $expectedIPCSocket = ''
    if (-not [string]::IsNullOrWhiteSpace($managedIPCSocketPath)) {
        $expectedIPCSocket = [IO.Path]::GetFullPath($managedIPCSocketPath)
    }
    foreach ($item in Microsoft.PowerShell.Management\Get-ChildItem -LiteralPath $Layout.InstallRoot -Recurse -Force) {
        if ($standaloneIPCLeaves.Count -gt 0 -and
            (Test-DefenseClawStandaloneIPCSocketLeaf -Item $item -Leaves $standaloneIPCLeaves)) {
            continue
        }
        if ($sensorHelperSocketLeaves.Count -gt 0 -and
            (Test-DefenseClawStandaloneIPCSocketLeaf -Item $item -Leaves $sensorHelperSocketLeaves)) {
            continue
        }
        $full = [IO.Path]::GetFullPath($item.FullName)
        $isReparse = (
            ($item.Attributes -band [IO.FileAttributes]::ReparsePoint) -ne 0
        )
        # Windows backs AF_UNIX socket files with an NTFS reparse point
        # (IO_REPARSE_TAG_AF_UNIX 0x80000023). A stale socket left after
        # an unclean guardian stop surfaces with the ReparsePoint
        # attribute, so exempt exactly one leaf file at the AVC-contract
        # socket path from the reparse-point veto. Every other reparse
        # point still aborts: an attacker who plants a junction anywhere
        # else inside the managed tree pre-uninstall is still refused.
        if ($isReparse -and
            (
                $item.PSIsContainer -or
                $expectedIPCSocket -eq '' -or
                -not [string]::Equals(
                    $full,
                    $expectedIPCSocket,
                    [StringComparison]::OrdinalIgnoreCase
                )
            ) -and
            -not (Test-DefenseClawBenignFileReparseTag -Item $item)) {
            throw "refusing to remove managed install tree containing a reparse point: $($item.FullName)"
        }
        # The retired lib tree (the 1.0.2 Fleet compiler's lib\defenseclaw)
        # keeps its refusal on every profile, Secure Client included
        # (rel-1-0-3 GAP-0270, GAP-0274): an unexpected item there is never
        # bulldozed with the tree.
        $inRetiredLib = [string]::Equals($full.TrimEnd('\'), $retiredLibRoot, [StringComparison]::OrdinalIgnoreCase) -or
            $full.StartsWith($retiredLibRoot + '\', [StringComparison]::OrdinalIgnoreCase)
        if ($item.PSIsContainer) {
            if ($full -notin $allowedDirectories) {
                # Bulldoze posture: unexpected directories inside InstallRoot
                # are the signature of a crashloop that left behind temp dirs,
                # or an external agent writing diagnostic output. Reparse-point
                # vetos above still catch the symlink-escape case. A
                # non-reparse unexpected dir inside the safe-root scope will
                # be eaten by the subsequent Remove-Item -Recurse step.
                # The standalone profile keeps its refusal (GAP-1190): an
                # item DefenseClaw did not install there stops the uninstall
                # before anything changes.
                if ($refuseUnexpected -or $inRetiredLib) {
                    # lib and lib\defenseclaw are directories 1.0.2 installed.
                    # When one still holds something, the walk goes on to that
                    # content, so the refusal names the item DefenseClaw did
                    # not install instead of lib (rel-1-0-3 GAP-0283).
                    if ($full.TrimEnd('\') -in $retiredLibDirectories -and
                        @(Microsoft.PowerShell.Management\Get-ChildItem -LiteralPath $full -Force).Count -gt 0) {
                        continue
                    }
                    throw "refusing to remove unexpected directory from managed install root: $full"
                }
                Write-DefenseClawAclSelfHealAdvisory `
                    -Path $full `
                    -Reason 'unexpected directory in managed install root (continuing bulldoze; will be removed with the tree)'
                continue
            }
        }
        elseif ($full -notin $allowedFiles) {
            if ($refuseUnexpected -or $inRetiredLib) {
                throw "refusing to remove unexpected file from managed install root: $full"
            }
            Write-DefenseClawAclSelfHealAdvisory `
                -Path $full `
                -Reason 'unexpected file in managed install root (continuing bulldoze; will be removed with the tree)'
            continue
        }
    }
}

function Assert-DefenseClawStandaloneUninstallInstallTree {
    <#
        Standalone uninstall's install-tree check. A file or folder that
        DefenseClaw did not install under InstallRoot (for example an
        administrator's renamed copy of a DefenseClaw program) still stops the
        uninstall before it changes anything; the refusal now says so and how
        to go on (GAP-1190). FORCE=1 is not offered: its state-absent removal
        refuses an item whose security descriptor DefenseClaw did not set,
        after it has stopped the services. Secure Client keeps the plain check.
    #>
    param([Parameter(Mandatory)][hashtable]$Layout)
    try {
        Assert-DefenseClawManagedInstallTree -Layout $Layout
    }
    catch {
        $message = [string]$_.Exception.Message
        if ($message -notlike 'refusing to remove unexpected * from managed install root: *') {
            throw
        }
        $installRoot = [IO.Path]::GetFullPath([string]$Layout.InstallRoot).TrimEnd('\')
        throw (
            $message + '. The uninstall stopped before it changed anything. DefenseClaw did not install that ' +
            'item: move it out of ' + $installRoot + ', then run the uninstall again'
        )
    }
}

function Get-DefenseClawUninstallStateLinkRefusal {
    param(
        [Parameter(Mandatory)]$Item,
        [string]$Reason = ''
    )
    $path = [string]$Item.FullName
    $removal = if ($Item.PSIsContainer) {
        'remove only the link with: cmd /c rmdir "' + $path + '"'
    }
    else {
        'remove only the link with: cmd /c del /a "' + $path + '"'
    }
    $why = if ([string]::IsNullOrWhiteSpace($Reason)) { '' } else { " ($Reason)" }
    return (
        "state_invalid: managed state contains a reparse point: $path. The uninstall stopped before it changed the " +
        "deployment, which is still installed. DefenseClaw does not follow links in its state folder and could not " +
        "remove this one as a link${why}: " + $removal + ' (the folder it points to is not changed), then run the ' +
        'uninstall again'
    )
}

function Remove-DefenseClawUninstallStateTreeLinks {
    <#
        The uninstall reads, re-ACLs and (with purge) deletes everything under
        StateRoot and never follows a link out of it (GAP-0145). After the
        refusal checks and before it changes the state tree, it removes each
        junction or symbolic link below StateRoot (for example one an
        administrator left at secrets) as a link: the folder or file it points
        to keeps its content and permissions (mgmt-agent-api GAP-1317). The
        walk never enters a link. A link at StateRoot itself, or one Windows
        does not let Setup remove, stops the uninstall while the deployment is
        still installed and names the link and how to remove only the link.
        StateRoot holds no AF_UNIX socket (those live under InstallRoot), so
        no reparse point is kept.
    #>
    param([Parameter(Mandatory)][hashtable]$Layout)
    $stateRoot = [IO.Path]::GetFullPath([string]$Layout.StateRoot).TrimEnd('\')
    if (-not (Microsoft.PowerShell.Management\Test-Path -LiteralPath $stateRoot)) {
        return
    }
    $root = Microsoft.PowerShell.Management\Get-Item -LiteralPath $stateRoot -Force
    if (($root.Attributes -band [IO.FileAttributes]::ReparsePoint) -ne 0) {
        throw (Get-DefenseClawUninstallStateLinkRefusal -Item $root)
    }
    $links = [Collections.Generic.List[object]]::new()
    $pending = [Collections.Generic.Stack[string]]::new()
    $pending.Push($stateRoot)
    while ($pending.Count -gt 0) {
        $directory = $pending.Pop()
        foreach ($item in Microsoft.PowerShell.Management\Get-ChildItem -LiteralPath $directory -Force) {
            if (($item.Attributes -band [IO.FileAttributes]::ReparsePoint) -ne 0) {
                $links.Add($item)
            }
            elseif ($item.PSIsContainer) {
                $pending.Push([string]$item.FullName)
            }
        }
    }
    foreach ($link in $links) {
        $path = [string]$link.FullName
        try {
            if ($link.PSIsContainer) {
                # Non-recursive: RemoveDirectory deletes the junction or
                # directory link itself and never enters it.
                [IO.Directory]::Delete($path, $false)
            }
            else {
                [IO.File]::Delete($path)
            }
        }
        catch {
            throw (Get-DefenseClawUninstallStateLinkRefusal -Item $link -Reason $_.Exception.Message)
        }
        if ($null -ne (Microsoft.PowerShell.Management\Get-Item -LiteralPath $path -Force -ErrorAction SilentlyContinue)) {
            throw (Get-DefenseClawUninstallStateLinkRefusal -Item $link -Reason 'it is still there')
        }
        Microsoft.PowerShell.Utility\Write-Warning -Message (
            "the uninstall removed the link $path from the DefenseClaw state folder; " +
            'the folder or file it pointed to was not changed'
        )
    }
}

function Assert-DefenseClawManagedTreeNoReparse {
    # -AllowAFUnixSocketAt is the exact-path exemption for the managed
    # IPC AF_UNIX socket file. Windows backs AF_UNIX socket files with
    # an NTFS reparse point (IO_REPARSE_TAG_AF_UNIX 0x80000023), so a
    # stale socket left after an unclean guardian stop surfaces with
    # the ReparsePoint attribute. Callers walking a tree that MAY
    # contain that socket (InstallRoot pre-rename, retired sibling
    # post-rename) supply the expected full path; every other reparse
    # point still aborts. Callers walking trees that never contain the
    # socket (StateRoot, transaction envelopes, lifecycle receipts)
    # leave the parameter empty and get the strict pre-existing
    # behavior - no reparse point tolerated anywhere.
    param(
        [Parameter(Mandatory)][string]$Root,
        [string]$AllowAFUnixSocketAt = ''
    )
    Assert-DefenseClawNoReparsePath -Path $Root
    $exemptSocket = ''
    if (-not [string]::IsNullOrWhiteSpace($AllowAFUnixSocketAt)) {
        $exemptSocket = [IO.Path]::GetFullPath(
            $AllowAFUnixSocketAt
        ).TrimEnd('\')
    }
    foreach ($item in Microsoft.PowerShell.Management\Get-ChildItem -LiteralPath $Root -Recurse -Force) {
        if (($item.Attributes -band [IO.FileAttributes]::ReparsePoint) -ne 0) {
            if (-not $item.PSIsContainer -and
                $exemptSocket -ne '' -and
                [string]::Equals(
                    [IO.Path]::GetFullPath($item.FullName).TrimEnd('\'),
                    $exemptSocket,
                    [StringComparison]::OrdinalIgnoreCase
                )) {
                continue
            }
            # A regular file whose tag redirects nothing (compression,
            # deduplication, a cloud placeholder) is accepted and logged.
            if (Test-DefenseClawBenignFileReparseTag -Item $item) {
                continue
            }
            throw "managed tree contains a reparse point: $($item.FullName)"
        }
    }
}

function Test-DefenseClawStaleIPCSocketItem {
    <#
        True for the stale AF_UNIX socket an unclean gateway stop leaves at
        exactly SocketPath: a non-container reparse point that
        Assert-DefenseClawManagedTreeNoReparse already exempted. The
        per-item retirement ACL passes skip it, because Set- and
        Assert-DefenseClawPathAcl refuse every reparse point; the tree
        removal deletes it with the rest of the tree.
    #>
    param(
        [Parameter(Mandatory)]$Item,
        [string]$SocketPath = ''
    )
    if ([string]::IsNullOrWhiteSpace($SocketPath) -or $Item.PSIsContainer -or
        ($Item.Attributes -band [IO.FileAttributes]::ReparsePoint) -eq 0) {
        return $false
    }
    return [string]::Equals(
        [IO.Path]::GetFullPath([string]$Item.FullName).TrimEnd('\'),
        [IO.Path]::GetFullPath($SocketPath).TrimEnd('\'),
        [StringComparison]::OrdinalIgnoreCase
    )
}

function Get-DefenseClawExactItemPath {
    <#
        The path that names an enumerated file or folder exactly. Win32 path
        normalization drops a trailing dot from every name and a trailing
        space from the last one, so the ordinary path of a skill folder the
        guardian quarantined under its exact name 'tdot.' named a folder
        that does not exist, and Setup /uninstall stopped with "managed path
        is missing" (GAP-1145). The extended-length form (\\?\) is not
        normalized. Every other path is returned unchanged.
    #>
    param([Parameter(Mandatory)][string]$Path)
    if ($Path.StartsWith('\\?\')) {
        return $Path
    }
    foreach ($segment in $Path.Split('\')) {
        if ($segment -cne '.' -and $segment -cne '..' -and
            ($segment.EndsWith('.') -or $segment.EndsWith(' '))) {
            return '\\?\' + $Path
        }
    }
    return $Path
}

# The standalone credential store, <StateRoot>\secrets, is written by
# `defenseclaw-gateway enterprise secret set`. The gateway's credential reader
# walks every ancestor of a credential and reads its owner and DACL, so the
# directory grants the gateway service SID READ_CONTROL, SYNCHRONIZE,
# FILE_READ_ATTRIBUTES and FILE_TRAVERSE on itself only (no list, create or
# write right), and each credential file grants it read access, except the
# account join tenant secrets, which only LocalSystem and Administrators
# read. These are the exact descriptors internal/cli/enterprise_secret_windows.go
# writes (enterprise-standalone-secrets-acl-smoke.ps1 compares them, and
# internal/managed TestTheInstallerKeepsTheAccountJoinSecretsFromTheGateway
# pins the names).
function Get-DefenseClawStandaloneSecretsDirectorySddl {
    param([Parameter(Mandatory)][string]$GatewayServiceSID)
    return (
        'O:BAG:SYD:P(A;OICI;FA;;;SY)(A;OICI;FA;;;BA)(A;;0x1200a0;;;{0})' -f
            $GatewayServiceSID
    )
}

function Get-DefenseClawStandaloneSecretFileSddl {
    param(
        [Parameter(Mandatory)][string]$GatewayServiceSID,
        [string]$Name = ''
    )
    # The tenant secrets of the account join key are read only by SYSTEM
    # and elevated administrators, never by the gateway
    # (managed.GatewayReadsCredential, windowsSecretFileSDDLFor).
    if ($Name -ceq 'account-join-key' -or $Name -ceq 'account-join-key-next') {
        return 'O:BAG:SYD:P(A;;FA;;;SY)(A;;FA;;;BA)'
    }
    return (
        'O:BAG:SYD:P(A;;FA;;;SY)(A;;FA;;;BA)(A;;FR;;;{0})' -f
            $GatewayServiceSID
    )
}

function Set-DefenseClawStandaloneSecretSddl {
    param(
        [Parameter(Mandatory)][string]$Path,
        [Parameter(Mandatory)][bool]$IsDirectory,
        [Parameter(Mandatory)][string]$Sddl
    )
    Assert-DefenseClawNoReparsePath -Path $Path
    $security = if ($IsDirectory) {
        [Security.AccessControl.DirectorySecurity]::new()
    }
    else {
        [Security.AccessControl.FileSecurity]::new()
    }
    $security.SetSecurityDescriptorSddlForm(
        $Sddl,
        [Security.AccessControl.AccessControlSections]::All
    )
    Microsoft.PowerShell.Security\Set-Acl `
        -LiteralPath $Path `
        -AclObject $security `
        -ErrorAction Stop
    Assert-DefenseClawCanonicalPathAcl -Path $Path -Expected $security
}

# A non-purge uninstall resets every retained item to administrator-only ACLs
# (Set-DefenseClawPreservedStateAcls), which removes the gateway's entries from
# the credential store. Install, upgrade and reconcile call this before the
# gateway starts so a reinstalled gateway can read its AI Defense credential
# again without another `enterprise secret set`. Only the directory and the
# entries named like credentials (managed.ValidCredentialName) are touched;
# temporary files and anything else keep their descriptors, and a reparse
# point anywhere in the store is refused.
function Set-DefenseClawStandaloneSecretsAcls {
    param(
        [Parameter(Mandatory)][hashtable]$Layout,
        [Parameter(Mandatory)][string]$GatewayServiceSID
    )
    if (-not (Test-DefenseClawStandaloneProfile)) {
        return
    }
    $secrets = Microsoft.PowerShell.Management\Join-Path `
        $Layout.StateRoot `
        'secrets'
    if (-not (Microsoft.PowerShell.Management\Test-Path -LiteralPath $secrets)) {
        return
    }
    Assert-DefenseClawNoReparsePath -Path $secrets
    if (-not (Microsoft.PowerShell.Management\Test-Path `
            -LiteralPath $secrets `
            -PathType Container)) {
        throw "standalone credential store is occupied by a non-directory: $secrets"
    }
    $items = @(Microsoft.PowerShell.Management\Get-ChildItem `
        -LiteralPath $secrets `
        -Force)
    foreach ($item in $items) {
        if (($item.Attributes -band [IO.FileAttributes]::ReparsePoint) -ne 0) {
            throw "refusing credential ACL repair through reparse point: $($item.FullName)"
        }
    }
    Set-DefenseClawStandaloneSecretSddl `
        -Path $secrets `
        -IsDirectory $true `
        -Sddl (Get-DefenseClawStandaloneSecretsDirectorySddl `
            -GatewayServiceSID $GatewayServiceSID)
    foreach ($item in $items) {
        if ($item.PSIsContainer -or
            $item.Name -cnotmatch '^[a-z0-9][a-z0-9-]{0,62}\z') {
            continue
        }
        Set-DefenseClawStandaloneSecretSddl `
            -Path $item.FullName `
            -IsDirectory $false `
            -Sddl (Get-DefenseClawStandaloneSecretFileSddl `
                -GatewayServiceSID $GatewayServiceSID `
                -Name $item.Name)
    }
}

function Set-DefenseClawPreservedStateAcls {
    param(
        [Parameter(Mandatory)][hashtable]$Layout,
        [Parameter(Mandatory)][string]$GatewayServiceSID,
        [switch]$Purge
    )
    # A purge does not retain the state children. Reading and restamping every
    # descendant here can fail the service-removal transaction on an unrelated
    # denied log/cache ACL before bounded post-commit deletion even starts.
    # Keep the root and the newly written tombstone protected as authority.
    $items = if ($Purge) {
        @()
    }
    else {
        @(Microsoft.PowerShell.Management\Get-ChildItem -LiteralPath $Layout.StateRoot -Recurse -Force)
    }
    # Shared with the Cisco Secure Client tree, so tolerate a lost stamp race
    # here the same way the install hardening does (AIFW-34262). Preserving
    # state across an uninstall must not abort because AVC re-ACLed the root.
    Set-DefenseClawSharedPathAcl `
        -Path $Layout.StateRoot `
        -Kind AdminDirectory `
        -GatewayServiceSID $GatewayServiceSID
    # Set-DefenseClawSharedPathAcl swallows a lost stamp race, so nothing above
    # proves the retained state root ended up administrator-only. Verify it the
    # same way the install hardening does: foreign access AVC re-applied is an
    # advisory, a lost canonical descriptor is re-stamped once and re-read, and
    # only SYSTEM/Administrators still missing FullControl after that repair is
    # fatal. Retained state that a standard user can rewrite would be inherited
    # verbatim by the next install.
    Assert-DefenseClawPathAcl `
        -Path $Layout.StateRoot `
        -AllowedWriterSIDs @(
            $script:SystemSID,
            $script:AdministratorsSID,
            $script:TrustedInstallerSID
        ) `
        -AllowedReaderSIDs @(
            $script:SystemSID,
            $script:AdministratorsSID,
            $script:TrustedInstallerSID
        ) `
        -RequiredRights (New-DefenseClawRequiredRights -Kind Admin) `
        -RejectUntrustedRead `
        -AdvisoryUntrustedAccess `
        -SelfHealKind AdminDirectory `
        -SelfHealGatewayServiceSID $GatewayServiceSID
    if ($Purge) {
        Set-DefenseClawPathAcl `
            -Path $Layout.MetadataPath `
            -Kind AdminFile `
            -GatewayServiceSID $script:AdministratorsSID
        return
    }
    foreach ($item in $items) {
        if (($item.Attributes -band [IO.FileAttributes]::ReparsePoint) -ne 0) {
            throw "refusing preserved-state ACL rewrite through reparse point: $($item.FullName)"
        }
        $kind = if ($item.PSIsContainer) { 'AdminDirectory' } else { 'AdminFile' }
        Set-DefenseClawPathAcl `
            -Path (Get-DefenseClawExactItemPath -Path $item.FullName) `
            -Kind $kind `
            -GatewayServiceSID $GatewayServiceSID
    }
}

function Restore-DefenseClawRetainedStateAclsFromTransaction {
    param(
        [Parameter(Mandatory)]$Snapshot,
        [Parameter(Mandatory)][hashtable]$Layout
    )
    $stateRootCreatedProperty = $Snapshot.PSObject.Properties[
        'state_root_created'
    ]
    $stateRootIdentityProperty = $Snapshot.PSObject.Properties[
        'state_root_identity'
    ]
    if ($null -eq $stateRootCreatedProperty -and
        $null -eq $stateRootIdentityProperty) {
        # Transactions from before managed-root claims never ran the early
        # fresh-Install SID/ACL binding and retain their historical recovery.
        return
    }
    if ($null -eq $stateRootCreatedProperty -or
        $stateRootCreatedProperty.Value -isnot [bool] -or
        $null -eq $stateRootIdentityProperty -or
        [string]$stateRootIdentityProperty.Value -cnotmatch
            '^[0-9a-f]{8}:[0-9a-f]{16}$') {
        throw 'pending transaction has invalid retained StateRoot baseline state'
    }
    $recordedStateRoot = [IO.Path]::GetFullPath(
        [string]$Snapshot.state_root
    ).TrimEnd('\')
    $expectedStateRoot = [IO.Path]::GetFullPath(
        [string]$Layout.StateRoot
    ).TrimEnd('\')
    if (-not [string]::Equals(
            $recordedStateRoot,
            $expectedStateRoot,
            [StringComparison]::OrdinalIgnoreCase
        )) {
        throw 'pending transaction retained StateRoot does not match this scope'
    }

    $gatewayServiceRows = @(
        $Snapshot.services |
            Microsoft.PowerShell.Core\Where-Object {
                [string]::Equals(
                    [string]$_.name,
                    [string]$Snapshot.gateway_service,
                    [StringComparison]::OrdinalIgnoreCase
                )
            }
    )
    if ($gatewayServiceRows.Count -ne 1 -or
        $null -eq $gatewayServiceRows[0].PSObject.Properties['existed'] -or
        $gatewayServiceRows[0].existed -isnot [bool]) {
        throw 'pending transaction has invalid retained-state gateway preimage'
    }
    $priorGatewayExisted = [bool]$gatewayServiceRows[0].existed
    $priorDeploymentProperty = $Snapshot.PSObject.Properties[
        'prior_deployment_active'
    ]
    $priorDeploymentActive = if ($null -eq $priorDeploymentProperty) {
        # Compatibility for snapshots written before the explicit deployment
        # marker; a surviving gateway was their only active-state evidence.
        $priorGatewayExisted
    }
    elseif ($priorDeploymentProperty.Value -isnot [bool]) {
        throw 'pending transaction has invalid prior deployment state'
    }
    else {
        [bool]$priorDeploymentProperty.Value
    }
    if ($priorGatewayExisted -and -not $priorDeploymentActive) {
        throw 'pending transaction has a gateway service without an active deployment'
    }
    if ($priorDeploymentActive -or
        [bool]$stateRootCreatedProperty.Value) {
        return
    }

    # Only an inactive retained root with an absent gateway preimage reaches
    # this branch. Prove that rollback removed the complete managed service set
    # before removing the deleted gateway SID from the retained tree.
    # The snapshot does not record the sensor helper, and the uninstall that
    # retained this root deleted it, so an owned helper here is the one this
    # Install registered. Rollback deletes the other services it created but
    # not this one; left in place, the check below refused, the retained ACLs
    # were never restored (deployment.json kept the installing admin's group)
    # and every later Setup command failed until a purge.
    $sensorHelperName = Get-DefenseClawSensorHelperServiceName `
        -GatewayServiceName ([string]$Snapshot.gateway_service)
    if (Test-DefenseClawServiceExists -Name $sensorHelperName) {
        Assert-DefenseClawStandaloneSensorHelperOwned `
            -Name $sensorHelperName `
            -Layout $Layout
        Remove-DefenseClawService -Name $sensorHelperName
    }
    $managedServiceNames = @(Get-DefenseClawManagedServiceNames `
        -GatewayServiceName ([string]$Snapshot.gateway_service) `
        -GuardianServiceName ([string]$Snapshot.guardian_service))
    Assert-DefenseClawServicesAbsentChecked `
        -Names $managedServiceNames `
        -Operation 'refusing retained-state ACL rollback'
    $nativeSecurity = Initialize-DefenseClawNativeSecurity
    $before = $nativeSecurity::GetDirectorySecuritySnapshotNoFollowIfExists(
        [string]$Layout.StateRoot
    )
    if ($null -eq $before -or
        [string]$before.Identity -cne
            [string]$stateRootIdentityProperty.Value) {
        throw 'retained StateRoot identity changed before ACL rollback'
    }
    $gatewaySID = Get-DefenseClawServiceSIDForRecovery `
        -ServiceName ([string]$Snapshot.gateway_service)
    Assert-DefenseClawServicesAbsentChecked `
        -Names $managedServiceNames `
        -Operation 'refusing retained-state ACL rollback after SID resolution'
    Set-DefenseClawPreservedStateAcls `
        -Layout $Layout `
        -GatewayServiceSID $gatewaySID
    $after = $nativeSecurity::GetDirectorySecuritySnapshotNoFollowIfExists(
        [string]$Layout.StateRoot
    )
    if ($null -eq $after -or
        [string]$after.Identity -cne [string]$before.Identity) {
        throw 'retained StateRoot identity changed during ACL rollback'
    }
    $expected = New-DefenseClawCanonicalPathAcl `
        -IsDirectory $true `
        -Kind AdminDirectory `
        -GatewayServiceSID $script:AdministratorsSID
    # StateRoot is shared with the platform installer, which can re-ACL it
    # right after the stamp. Re-stamp once more with privilege and judge by
    # write authority; the identity checks above stay exact.
    Assert-DefenseClawCanonicalRawPathAcl `
        -Path ([string]$Layout.StateRoot) `
        -Actual ([Security.AccessControl.RawSecurityDescriptor]::new(
            [byte[]]$after.SecurityDescriptor,
            0
        )) `
        -Expected $expected `
        -AllowSelfHeal
}

function Test-DefenseClawManagedTreeRetryRoot {
    param(
        [Parameter(Mandatory)][string]$Path,
        [Parameter(Mandatory)][string]$ExpectedIdentity,
        [Parameter(Mandatory)][byte[]]$ExpectedSecurityDescriptor
    )
    $nativeSecurity = Initialize-DefenseClawNativeSecurity
    $current = $nativeSecurity::GetDirectorySecuritySnapshotNoFollowIfExists($Path)
    if ($null -eq $current) {
        return $false
    }
    if ([string]$current.Identity -cne $ExpectedIdentity) {
        throw 'transaction-created InstallRoot identity changed during rollback deletion'
    }
    if ([Convert]::ToBase64String([byte[]]$current.SecurityDescriptor) -cne
        [Convert]::ToBase64String($ExpectedSecurityDescriptor)) {
        throw 'transaction-created InstallRoot security descriptor changed during rollback deletion'
    }
    Assert-DefenseClawManagedTreeNoReparse -Root $Path
    return $true
}

function Remove-DefenseClawManagedTree {
    param(
        [Parameter(Mandatory)][string]$Path,
        [Parameter(Mandatory)][string]$RequiredBase,
        [Parameter(Mandatory)][string]$Label,
        # Pass-through to Assert-DefenseClawManagedTreeNoReparse. Callers
        # tearing down the install tree (canonical or retired sibling)
        # specify the AF_UNIX socket's exact full path so a stale
        # socket-reparse-point does not trip the pre-remove reparse
        # veto. Callers on other trees leave it empty for strict mode.
        [string]$AllowAFUnixSocketAt = '',
        [int]$RetryHeldFileMilliseconds = 0,
        [string]$ExpectedRootIdentity = '',
        [byte[]]$ExpectedRootSecurityDescriptor
    )
    if ($RetryHeldFileMilliseconds -lt 0 -or
        $RetryHeldFileMilliseconds -gt 60000) {
        throw 'rollback InstallRoot holder retry must be between 0 and 60000 milliseconds'
    }
    if ($RetryHeldFileMilliseconds -gt 0 -and
        ($Label -cne 'InstallRoot' -or
            -not (Test-DefenseClawStandaloneProfile) -or
            $ExpectedRootIdentity -cnotmatch '^[0-9a-f]{8}:[0-9a-f]{16}$' -or
            $null -eq $ExpectedRootSecurityDescriptor -or
            $ExpectedRootSecurityDescriptor.Length -eq 0)) {
        throw 'rollback InstallRoot holder retry requires the standalone profile and a recorded root identity and descriptor'
    }
    $safe = Assert-DefenseClawSafeRoot -Path $Path -Label $Label -RequiredBase $RequiredBase
    if (-not (Microsoft.PowerShell.Management\Test-Path -LiteralPath $safe)) {
        return
    }
    if ($RetryHeldFileMilliseconds -gt 0 -and
        -not (Test-DefenseClawManagedTreeRetryRoot `
            -Path $safe `
            -ExpectedIdentity $ExpectedRootIdentity `
            -ExpectedSecurityDescriptor $ExpectedRootSecurityDescriptor)) {
        return
    }
    Assert-DefenseClawManagedTreeNoReparse `
        -Root $safe `
        -AllowAFUnixSocketAt $AllowAFUnixSocketAt
    # A tree that holds a name normalization changes (GAP-1145) is removed
    # through its extended-length path, which keeps every name exact.
    $target = $safe
    foreach ($item in @(Microsoft.PowerShell.Management\Get-ChildItem -LiteralPath $safe -Recurse -Force)) {
        if ((Get-DefenseClawExactItemPath -Path $item.FullName) -cne [string]$item.FullName) {
            $target = '\\?\' + $safe
            break
        }
    }
    # Bulldoze posture: Remove-Item can lose to a transient handle (AV scan,
    # Defender real-time, indexer, a slow service stop handler) even after
    # the pre-remove checks pass. Retry with short backoff so a 1-3 second
    # handle release lets the delete complete; after that, we're almost
    # certainly dealing with a hung process that strict mode won't help
    # unblock. Fall through to a warning so uninstall can finish; the next
    # install's canonical ACL + file re-creation sweeps anything that
    # survived.
    $strict = Test-DefenseClawTrustStrictAncestors
    $lastError = $null
    for ($attempt = 1; $attempt -le 5; $attempt++) {
        try {
            Microsoft.PowerShell.Management\Remove-Item `
                -LiteralPath $target `
                -Recurse `
                -Force `
                -ErrorAction Stop
            return
        }
        catch {
            $lastError = $_
            if ($attempt -lt 5) {
                Microsoft.PowerShell.Utility\Start-Sleep -Milliseconds (500 * $attempt)
            }
        }
    }
    if ($RetryHeldFileMilliseconds -gt 0 -and
        (Microsoft.PowerShell.Management\Test-Path -LiteralPath $safe)) {
        # An executing hook answers AccessDenied even to SYSTEM. Extend the
        # window only after Restart Manager proves a real holder; a deny ACE
        # or an unqueryable root keeps the ordinary refusal. The protected
        # rollback intent remains until the root is actually absent.
        # Restart Manager can lag a fresh handle (a CI runner did not list a
        # holder that still blocked the delete, GAP-1844): ask it a few times
        # before the delete counts as not held.
        $holders = @()
        for ($query = 1; $query -le 4 -and $holders.Count -eq 0; $query++) {
            if ($query -gt 1) {
                Microsoft.PowerShell.Utility\Start-Sleep -Milliseconds 750
                # Each added delete re-checks the recorded root first, as
                # the held-file loop below does (GAP-1988).
                if (-not (Test-DefenseClawManagedTreeRetryRoot `
                    -Path $safe `
                    -ExpectedIdentity $ExpectedRootIdentity `
                    -ExpectedSecurityDescriptor $ExpectedRootSecurityDescriptor)) {
                    return
                }
                try {
                    Microsoft.PowerShell.Management\Remove-Item `
                        -LiteralPath $target `
                        -Recurse `
                        -Force `
                        -ErrorAction Stop
                    return
                }
                catch {
                    $lastError = $_
                }
            }
            $holders = @(Get-DefenseClawInstallRootHolders `
                -InstallRoot $safe `
                -FailOnQueryError)
        }
        if ($holders.Count -gt 0) {
            $clock = [Diagnostics.Stopwatch]::StartNew()
            while ($clock.ElapsedMilliseconds -lt $RetryHeldFileMilliseconds) {
                Microsoft.PowerShell.Utility\Start-Sleep -Milliseconds 500
                if (-not (Test-DefenseClawManagedTreeRetryRoot `
                    -Path $safe `
                    -ExpectedIdentity $ExpectedRootIdentity `
                    -ExpectedSecurityDescriptor $ExpectedRootSecurityDescriptor)) {
                    return
                }
                try {
                    Microsoft.PowerShell.Management\Remove-Item `
                        -LiteralPath $target `
                        -Recurse `
                        -Force `
                        -ErrorAction Stop
                    return
                }
                catch {
                    $lastError = $_
                }
            }
        }
    }
    if ($null -ne $lastError -and
        (Microsoft.PowerShell.Management\Test-Path -LiteralPath $safe)) {
        # Last resort, after the attempts above and the rollback holder wait:
        # the rollback retry window checks the recorded root identity and
        # descriptor before every delete, and the privileged pass does too
        # (GAP-0890 review S6). It runs here so a root that the wait would have
        # returned on is never reached.
        if ($RetryHeldFileMilliseconds -gt 0 -and
            -not (Test-DefenseClawManagedTreeRetryRoot `
                -Path $safe `
                -ExpectedIdentity $ExpectedRootIdentity `
                -ExpectedSecurityDescriptor $ExpectedRootSecurityDescriptor)) {
            return
        }
        if (Remove-DefenseClawStateTreePrivileged -Root $safe -Target $target -Label $Label -ErrorRecord $lastError) {
            return
        }
    }
    if ((Microsoft.PowerShell.Management\Test-Path -LiteralPath $safe)) {
        if ($strict) {
            throw $lastError
        }
        Write-DefenseClawAclSelfHealAdvisory `
            -Path $safe `
            -Reason (
                "Remove-Item retries exhausted (handle held or filesystem " +
                "contention): $($lastError.Exception.Message). Continuing " +
                "bulldoze - residual tree will be cleaned at next uninstall " +
                "or by the install reconcile's canonical re-stamp."
            )
    }
}

function Get-DefenseClawFileIdentity {
    param([Parameter(Mandatory)][string]$Path)
    $full = Resolve-DefenseClawFullPath -Path $Path -MustExist -Leaf
    Assert-DefenseClawNoReparsePath -Path $full
    $nativeSecurityType = Initialize-DefenseClawNativeSecurity
    return ([string]$nativeSecurityType::GetFileIdentity($full)).ToLowerInvariant()
}

function Get-DefenseClawSelfUninstallCallerIdentity {
    param(
        [Parameter(Mandatory)][hashtable]$Layout,
        [Parameter(Mandatory)][int]$CallerPID
    )
    if ($CallerPID -le 0) {
        throw '-SelfUninstallCallerPID must be a positive process identifier'
    }
    $expectedImage = Resolve-DefenseClawFullPath `
        -Path $Layout.CLIPath `
        -MustExist `
        -Leaf
    Assert-DefenseClawNoReparsePath -Path $expectedImage
    $nativeSecurityType = Initialize-DefenseClawNativeSecurity
    try {
        $actualImage = [IO.Path]::GetFullPath(
            [string]$nativeSecurityType::GetProcessImagePath(
                [uint32]$CallerPID
            )
        ).TrimEnd('\')
        $creationFileTime = [int64](
            $nativeSecurityType::GetProcessCreationFileTime(
                [uint32]$CallerPID
            )
        )
    }
    catch {
        throw (
            'cannot authenticate the installed CLI self-uninstall caller ' +
            "$CallerPID`: $($_.Exception.Message)"
        )
    }
    if (-not [string]::Equals(
            $actualImage,
            $expectedImage,
            [StringComparison]::OrdinalIgnoreCase
        )) {
        throw (
            '-SelfUninstallCallerPID does not identify the exact installed ' +
            "DefenseClaw CLI: $actualImage"
        )
    }
    if ($creationFileTime -le 0) {
        throw 'installed CLI self-uninstall caller has an invalid process creation FILETIME'
    }
    return [ordered]@{
        pid = [int64]$CallerPID
        creation_filetime = $creationFileTime
        image_path = $expectedImage
        file_identity = Get-DefenseClawFileIdentity -Path $expectedImage
        sha256 = (
            Microsoft.PowerShell.Utility\Get-FileHash `
                -LiteralPath $expectedImage `
                -Algorithm SHA256
        ).Hash.ToLowerInvariant()
    }
}

function Assert-DefenseClawSelfUninstallRetiredRoot {
    param(
        [Parameter(Mandatory)][hashtable]$Layout,
        [Parameter(Mandatory)][string]$Path,
        [switch]$AllowMissing
    )
    $canonical = [IO.Path]::GetFullPath($Layout.InstallRoot).TrimEnd('\')
    $full = [IO.Path]::GetFullPath($Path).TrimEnd('\')
    $canonicalParent = [IO.Path]::GetDirectoryName($canonical)
    if (-not [string]::Equals(
            [IO.Path]::GetDirectoryName($full),
            $canonicalParent,
            [StringComparison]::OrdinalIgnoreCase
        )) {
        throw "self-uninstall retired root is not an exact same-parent sibling: $full"
    }
    $expectedPattern = '^' +
        [Text.RegularExpressions.Regex]::Escape(
            [IO.Path]::GetFileName($canonical)
        ) +
        '\.retired-[0-9a-f]{32}$'
    if ([IO.Path]::GetFileName($full) -cnotmatch $expectedPattern) {
        throw "self-uninstall retired root has invalid 128-bit sibling grammar: $full"
    }
    if (-not [string]::Equals(
            [IO.Path]::GetPathRoot($canonical),
            [IO.Path]::GetPathRoot($full),
            [StringComparison]::OrdinalIgnoreCase
        )) {
        throw "self-uninstall retired root is not on the InstallRoot volume: $full"
    }
    [void](Assert-DefenseClawSafeRoot `
        -Path $full `
        -Label 'self-uninstall retired InstallRoot' `
        -RequiredBase $script:ProgramFiles)
    if (Microsoft.PowerShell.Management\Test-Path -LiteralPath $full) {
        if (-not (Microsoft.PowerShell.Management\Test-Path `
                -LiteralPath $full `
                -PathType Container)) {
            throw "self-uninstall retired root is not a directory: $full"
        }
        Assert-DefenseClawNoReparsePath -Path $full
    }
    elseif (-not $AllowMissing) {
        throw "self-uninstall retired root is missing: $full"
    }
    return $full
}

function New-DefenseClawSelfUninstallRetiredRoot {
    param([Parameter(Mandatory)][hashtable]$Layout)
    for ($attempt = 0; $attempt -lt 16; $attempt++) {
        $candidate = (
            [IO.Path]::GetFullPath($Layout.InstallRoot).TrimEnd('\') +
            '.retired-' +
            [Guid]::NewGuid().ToString('N')
        )
        [void](Assert-DefenseClawSelfUninstallRetiredRoot `
            -Layout $Layout `
            -Path $candidate `
            -AllowMissing)
        if (-not (Microsoft.PowerShell.Management\Test-Path `
                -LiteralPath $candidate)) {
            return $candidate
        }
    }
    throw 'cannot allocate a nonexisting 128-bit self-uninstall retirement sibling'
}

function Get-DefenseClawRetiredInstallTreeAllowlist {
    param(
        [Parameter(Mandatory)][hashtable]$Layout,
        [Parameter(Mandatory)][string]$RetiredRoot
    )
    $directories = @(
        (Microsoft.PowerShell.Management\Join-Path $RetiredRoot 'bin'),
        (Microsoft.PowerShell.Management\Join-Path $RetiredRoot 'agents'),
        (Microsoft.PowerShell.Management\Join-Path $RetiredRoot 'libexec'),
        # <RetiredRoot>\ipc\ is the renamed-sibling counterpart of the
        # managed IPC directory <InstallRoot>\ipc\. When the CLI self-
        # uninstalls it renames InstallRoot to the RetiredRoot sibling
        # for delayed teardown by an out-of-tree helper, and the ipc
        # directory rides along. Accept it here or the retired-tree
        # verifier trips on the identical empty-container shape that
        # the canonical validator was tripping on pre-fix.
        (Microsoft.PowerShell.Management\Join-Path $RetiredRoot 'ipc')
    )
    if (Test-DefenseClawLayoutBrokerEnabled -Layout $Layout) {
        $directories += (Microsoft.PowerShell.Management\Join-Path `
            $RetiredRoot 'secure-client.install')
    }
    # Both profiles' payloads install the ACP bridge and the sensor helper
    # under bin. Without them a committed uninstall could never retire its
    # InstallRoot ("committed InstallRoot contains unexpected content:
    # ...\bin\defenseclaw-acp.exe"), and every retry failed the same way.
    $files = @(
        (Microsoft.PowerShell.Management\Join-Path $RetiredRoot 'bin\defenseclaw-acp.exe'),
        (Microsoft.PowerShell.Management\Join-Path $RetiredRoot 'bin\defenseclaw-cmid-broker.exe'),
        (Microsoft.PowerShell.Management\Join-Path $RetiredRoot 'bin\defenseclaw-gateway.exe'),
        (Microsoft.PowerShell.Management\Join-Path $RetiredRoot 'bin\defenseclaw-hook.exe'),
        (Microsoft.PowerShell.Management\Join-Path $RetiredRoot 'bin\defenseclaw-sensor-helper.exe'),
        (Microsoft.PowerShell.Management\Join-Path $RetiredRoot 'bin\defenseclaw.exe'),
        (Microsoft.PowerShell.Management\Join-Path $RetiredRoot 'agents\codex.exe'),
        (Microsoft.PowerShell.Management\Join-Path $RetiredRoot 'libexec\install-enterprise.ps1'),
        (Microsoft.PowerShell.Management\Join-Path $RetiredRoot 'libexec\DefenseClawEnterprise.psm1'),
        # Retired counterpart of the AF_UNIX socket file. Absent after a
        # graceful guardian stop; if a stale socket survived an unclean
        # stop and rode along on the rename, this allowlist entry is
        # what keeps the retired-tree verifier from rejecting it.
        (Microsoft.PowerShell.Management\Join-Path $RetiredRoot 'ipc\defenseclaw_ipc.sock')
    )
    if (Test-DefenseClawStandaloneProfile) {
        $directories += @(
            (Microsoft.PowerShell.Management\Join-Path $RetiredRoot 'lib'),
            (Microsoft.PowerShell.Management\Join-Path $RetiredRoot 'lib\defenseclaw')
        )
        $files += (Microsoft.PowerShell.Management\Join-Path $RetiredRoot 'lib\defenseclaw\policy_compiler.py')
    }
    return @{
        directories = @(
            $directories |
                Microsoft.PowerShell.Core\ForEach-Object {
                    [IO.Path]::GetFullPath($_).TrimEnd('\')
                }
        )
        files = @(
            $files |
                Microsoft.PowerShell.Core\ForEach-Object {
                    [IO.Path]::GetFullPath($_).TrimEnd('\')
                }
        )
    }
}

function Assert-DefenseClawRetiredInstallTree {
    param(
        [Parameter(Mandatory)][hashtable]$Layout,
        [Parameter(Mandatory)][string]$RetiredRoot,
        [switch]$SkipAclValidation
    )
    $retired = Assert-DefenseClawSelfUninstallRetiredRoot `
        -Layout $Layout `
        -Path $RetiredRoot
    $allowlist = Get-DefenseClawRetiredInstallTreeAllowlist `
        -Layout $Layout `
        -RetiredRoot $retired
    $retiredIPCSocket = Microsoft.PowerShell.Management\Join-Path `
        $retired `
        'ipc\defenseclaw_ipc.sock'
    Assert-DefenseClawManagedTreeNoReparse `
        -Root $retired `
        -AllowAFUnixSocketAt $retiredIPCSocket
    $objects = @(
        Microsoft.PowerShell.Management\Get-Item `
            -LiteralPath $retired `
            -Force
    ) + @(
        Microsoft.PowerShell.Management\Get-ChildItem `
            -LiteralPath $retired `
            -Recurse `
            -Force
    )
    foreach ($item in $objects) {
        $full = [IO.Path]::GetFullPath($item.FullName).TrimEnd('\')
        if (-not [string]::Equals(
                $full,
                $retired,
                [StringComparison]::OrdinalIgnoreCase
            )) {
            if ($item.PSIsContainer) {
                if ($full -notin $allowlist.directories) {
                    # Bulldoze posture: the retired tree is on its way to
                    # deletion anyway. An unexpected directory (left behind
                    # by a crashloop or by an external agent writing into
                    # our tree before the self-uninstall rename) is still
                    # inside the safe-root scope so the delete step will
                    # eat it. Warn and continue.
                    if (Test-DefenseClawTrustStrictAncestors) {
                        throw "self-uninstall retired tree contains unexpected directory: $full"
                    }
                    Write-DefenseClawAclSelfHealAdvisory `
                        -Path $full `
                        -Reason 'retired tree contains unexpected directory (continuing bulldoze; will be removed with the tree)'
                    continue
                }
            }
            elseif ($full -notin $allowlist.files) {
                if (Test-DefenseClawTrustStrictAncestors) {
                    throw "self-uninstall retired tree contains unexpected file: $full"
                }
                Write-DefenseClawAclSelfHealAdvisory `
                    -Path $full `
                    -Reason 'retired tree contains unexpected file (continuing bulldoze; will be removed with the tree)'
                continue
            }
        }
        if (-not $SkipAclValidation -and
            -not (Test-DefenseClawStaleIPCSocketItem -Item $item -SocketPath $retiredIPCSocket)) {
            Assert-DefenseClawPathAcl `
                -Path $full `
                -AllowedWriterSIDs @(
                    $script:SystemSID,
                    $script:AdministratorsSID,
                    $script:TrustedInstallerSID
                ) `
                -AllowedReaderSIDs @(
                    $script:SystemSID,
                    $script:AdministratorsSID,
                    $script:TrustedInstallerSID
                ) `
                -RequiredRights (New-DefenseClawRequiredRights -Kind Admin) `
                -AllowInheritance `
                -RejectUntrustedRead
        }
    }
}

function Set-DefenseClawRetiredInstallTreeAcls {
    param(
        [Parameter(Mandatory)][hashtable]$Layout,
        [Parameter(Mandatory)][string]$RetiredRoot
    )
    $retired = Assert-DefenseClawSelfUninstallRetiredRoot `
        -Layout $Layout `
        -Path $RetiredRoot
    # Remove traversal at the root before enumerating descendants. Otherwise a
    # standard user watching the sibling rename could race this enumeration
    # and open a new executable handle from the retired tree.
    Set-DefenseClawPathAcl `
        -Path $retired `
        -Kind AdminDirectory `
        -GatewayServiceSID $script:AdministratorsSID
    $items = @(
        Microsoft.PowerShell.Management\Get-ChildItem `
            -LiteralPath $retired `
            -Recurse `
            -Force
    )
    $retiredIPCSocket = Microsoft.PowerShell.Management\Join-Path `
        $retired `
        'ipc\defenseclaw_ipc.sock'
    foreach ($item in $items) {
        if (Test-DefenseClawStaleIPCSocketItem -Item $item -SocketPath $retiredIPCSocket) {
            continue
        }
        $kind = if ($item.PSIsContainer) { 'AdminDirectory' } else { 'AdminFile' }
        Set-DefenseClawPathAcl `
            -Path $item.FullName `
            -Kind $kind `
            -GatewayServiceSID $script:AdministratorsSID
    }
    Assert-DefenseClawRetiredInstallTree `
        -Layout $Layout `
        -RetiredRoot $retired
}

function Set-DefenseClawInstallTreeRetirementAcls {
    param(
        [Parameter(Mandatory)][hashtable]$Layout,
        [switch]$Committed
    )
    if (-not $Committed) {
        Assert-DefenseClawManagedInstallTree -Layout $Layout
    }
    else {
        # A retry can start after an interrupted ACL sweep, so its entries
        # may already have Admin ACLs. The committed caller authenticates
        # the tombstone and artifact hashes before reaching this sweep.
        Assert-DefenseClawManagedTreeNoReparse `
            -Root $Layout.InstallRoot `
            -AllowAFUnixSocketAt (Get-DefenseClawOptionalLayoutValue -Layout $Layout -Name ManagedIPCSocketPath)
    }
    # Strip Users RX from the canonical root before its random sibling name is
    # observable. Existing mapped CLI code continues to run; no standard user
    # can traverse the tree to create a new post-retirement locker.
    Set-DefenseClawPathAcl `
        -Path $Layout.InstallRoot `
        -Kind AdminDirectory `
        -GatewayServiceSID $script:AdministratorsSID
    $items = @(
        Microsoft.PowerShell.Management\Get-ChildItem `
            -LiteralPath $Layout.InstallRoot `
            -Recurse `
            -Force
    )
    foreach ($item in $items) {
        if (Test-DefenseClawStaleIPCSocketItem -Item $item -SocketPath (Get-DefenseClawOptionalLayoutValue -Layout $Layout -Name ManagedIPCSocketPath)) {
            continue
        }
        $kind = if ($item.PSIsContainer) { 'AdminDirectory' } else { 'AdminFile' }
        Set-DefenseClawPathAcl `
            -Path $item.FullName `
            -Kind $kind `
            -GatewayServiceSID $script:AdministratorsSID
    }
}

function Assert-DefenseClawInstallTreeRetirementState {
    param(
        [Parameter(Mandatory)][hashtable]$Layout,
        [switch]$NativeSealed,
        [switch]$AllowUnretiredAcls
    )
    if (-not (Microsoft.PowerShell.Management\Test-Path `
            -LiteralPath $Layout.InstallRoot `
            -PathType Container)) {
        throw 'committed managed-hook finalization requires the canonical InstallRoot'
    }
    $root = [IO.Path]::GetFullPath($Layout.InstallRoot).TrimEnd('\')
    $allowlist = Get-DefenseClawRetiredInstallTreeAllowlist `
        -Layout $Layout `
        -RetiredRoot $root
    if ($AllowUnretiredAcls -and (Test-DefenseClawStandaloneProfile)) {
        # The pre-finalization check runs after commit but before managed-hook
        # teardown. Admit only the exact current and supported V1 OpenCode
        # artifacts still installed at that boundary; the later check and
        # retired-tree cleanup require both to be gone.
        $plugin = Get-DefenseClawStandaloneOpenCodePluginPaths -Layout $Layout
        $allowlist.directories += @([string]$plugin.ShareDirectory, [string]$plugin.PluginDirectory)
        $allowlist.files += @([string]$plugin.PluginPath, [string]$plugin.LegacyPluginPath)
    }
    Assert-DefenseClawManagedTreeNoReparse `
        -Root $root `
        -AllowAFUnixSocketAt (Get-DefenseClawOptionalLayoutValue -Layout $Layout -Name ManagedIPCSocketPath)
    $objects = @(
        Microsoft.PowerShell.Management\Get-Item `
            -LiteralPath $root `
            -Force
    ) + @(
        Microsoft.PowerShell.Management\Get-ChildItem `
            -LiteralPath $root `
            -Recurse `
            -Force
    )
    foreach ($item in $objects) {
        $full = [IO.Path]::GetFullPath($item.FullName).TrimEnd('\')
        if (-not [string]::Equals(
                $full,
                $root,
                [StringComparison]::OrdinalIgnoreCase
            )) {
            if (($item.PSIsContainer -and $full -notin $allowlist.directories) -or
                (-not $item.PSIsContainer -and $full -notin $allowlist.files)) {
                # Install-DefenseClawFileAtomic leaves <file>.backup.<guid N>
                # when the replaced image was still running and its delete
                # could not even be queued. It is a regular file that the
                # whole-tree delete below removes, so it must not stop
                # finalization; the strict pin keeps the exact inventory.
                # Standalone removes such backups before this check and
                # reports one that a running program still holds.
                $backupMatch = [regex]::Match(
                    $full,
                    '\A(.+)\.backup\.[0-9a-f]{32}\z'
                )
                if ($item.PSIsContainer -or
                    -not $backupMatch.Success -or
                    $backupMatch.Groups[1].Value -notin $allowlist.files -or
                    ($item.Attributes -band [IO.FileAttributes]::ReparsePoint) -ne 0 -or
                    (Test-DefenseClawTrustStrictAncestors) -or
                    (Test-DefenseClawStandaloneProfile)) {
                    throw "committed InstallRoot contains unexpected content: $full"
                }
                Write-DefenseClawResilienceEvent -Marker defenseclaw_accept -Fields @{
                    path   = $full
                    reason = 'leftover atomic-replacement backup in InstallRoot; removed with the tree'
                }
            }
        }
        if (Test-DefenseClawStaleIPCSocketItem -Item $item -SocketPath (Get-DefenseClawOptionalLayoutValue -Layout $Layout -Name ManagedIPCSocketPath)) {
            continue
        }
        if ($AllowUnretiredAcls) {
            continue
        }
        Assert-DefenseClawPathAcl `
            -Path $full `
            -AllowedWriterSIDs @(
                $script:SystemSID,
                $script:AdministratorsSID,
                $script:TrustedInstallerSID
            ) `
            -AllowedReaderSIDs @(
                $script:SystemSID,
                $script:AdministratorsSID,
                $script:TrustedInstallerSID
            ) `
            -RequiredRights (New-DefenseClawRequiredRights -Kind Admin) `
            -AllowInheritance `
            -RejectUntrustedRead
    }
}

function Complete-DefenseClawCommittedManagedHooksFinalization {
    param(
        [Parameter(Mandatory)][hashtable]$Layout,
        [Parameter(Mandatory)][string]$GatewayServiceName,
        [Parameter(Mandatory)][string]$GuardianServiceName,
        [switch]$Purge,
        [switch]$NativeSealed
    )
    if (Microsoft.PowerShell.Management\Test-Path `
        -LiteralPath $Layout.PendingPath) {
        throw 'managed-hook finalization requires a committed transaction'
    }
    $metadata = Get-DefenseClawDeploymentMetadata -Layout $Layout -Required
    Assert-DefenseClawMetadataIdentity `
        -Metadata $metadata `
        -GatewayServiceName $GatewayServiceName `
        -GuardianServiceName $GuardianServiceName
    if (Test-DefenseClawMetadataInstalled -Metadata $metadata) {
        throw 'managed-hook finalization requires an uninstall tombstone'
    }
    if (Sync-DefenseClawStandaloneUninstallTombstoneBinding `
            -Layout $Layout `
            -GatewayServiceName $GatewayServiceName) {
        $metadata = Get-DefenseClawDeploymentMetadata -Layout $Layout -Required
    }
    # The finalize removes the enrolled accounts' per-user data and binaries
    # when the uninstall asked for it. A recovery or retry replays the request
    # the tombstone recorded, whether or not it asked again (an explicit purge
    # of this run still counts), so the tombstone outlives that removal.
    $purgeUserState = [bool]$script:DefenseClawUninstallPurgeUserState
    if (Test-DefenseClawStandaloneProfile) {
        $purgeUserState = (
            $purgeUserState -or
            (Get-DefenseClawTombstonePurgeUserStateRequested -Metadata $metadata)
        )
    }
    foreach ($name in @(
        Get-DefenseClawManagedServiceNames `
            -GatewayServiceName $GatewayServiceName `
            -GuardianServiceName $GuardianServiceName
    )) {
        if (Test-DefenseClawServiceExists -Name $name) {
            throw "managed-hook finalization refused while service exists: $name"
        }
    }
    $teardownPhase = ''
    # A standalone retry after a finalized teardown runs no installed binary
    # (no Go finalizer: not a purge, or its contract receipt is finalized),
    # so artifacts the earlier InstallRoot removal retired do not refuse it
    # (GAP-1375).
    $retiredRetry = $false
    if ((Test-DefenseClawStandaloneProfile) -and
        (Microsoft.PowerShell.Management\Test-Path `
            -LiteralPath $Layout.ManagedHooksTeardownJournalPath `
            -PathType Leaf) -and
        (Get-DefenseClawManagedHooksTeardownJournalPhase `
            -Layout $Layout `
            -Metadata $metadata `
            -GatewayServiceName $GatewayServiceName `
            -AllowLegacyInactive) -ceq 'finalized') {
        $retiredRetry = (
            -not $Purge -or
            [string](Get-DefenseClawManagedHookContractCleanupReceipt `
                -Layout $Layout `
                -GatewayServiceName $GatewayServiceName `
                -GuardianServiceName $GuardianServiceName `
                -Metadata $metadata `
                -Required).phase -ceq 'finalized'
        )
    }
    if (Test-DefenseClawStandaloneProfile) {
        Assert-DefenseClawRecordedArtifactHashes `
            -Metadata $metadata `
            -Layout $Layout `
            -Action 'Committed Uninstall finalization' `
            -AllowRetiredArtifacts:$retiredRetry
        Assert-DefenseClawInstallTreeRetirementState `
            -Layout $Layout `
            -AllowUnretiredAcls
        # During pending.json the hook registrations and their executable
        # remain in place. A killed Setup process tree, CLI uninstall or
        # reboot therefore leaves a hook that denies while the gateway is
        # stopped. Removal begins only after the uninstall tombstone commits.
        if (Microsoft.PowerShell.Management\Test-Path `
                -LiteralPath $Layout.ManagedHooksTeardownJournalPath `
                -PathType Leaf) {
            $teardownPhase = Get-DefenseClawManagedHooksTeardownJournalPhase `
                -Layout $Layout `
                -Metadata $metadata `
                -GatewayServiceName $GatewayServiceName `
                -AllowLegacyInactive
        }
        # An older deployment's helper prepared the removal, and removed the
        # Codex requirements, before the commit (GAP-1443): its journal is
        # prepared here and only the finalize is left to it. It cannot
        # prepare against the tombstone, so a missing preparation is
        # reported, not attempted.
        $committedPrepare = $false
        if ($teardownPhase -cne 'finalized') {
            $committedPrepare = Test-DefenseClawManagedHooksCommittedTeardownSupported `
                -Layout $Layout `
                -GatewayServiceName $GatewayServiceName
        }
        if ($teardownPhase -cne 'prepared' -and
            $teardownPhase -cne 'finalized') {
            if ($committedPrepare) {
                [void](Invoke-DefenseClawManagedHooksTeardownCommand `
                    -Layout $Layout `
                    -GatewayServiceName $GatewayServiceName `
                    -GuardianServiceName $GuardianServiceName `
                    -Action prepare)
                [void](Invoke-DefenseClawManagedHooksTeardownCommand `
                    -Layout $Layout `
                    -GatewayServiceName $GatewayServiceName `
                    -GuardianServiceName $GuardianServiceName `
                    -Action verify)
            }
            elseif ($teardownPhase -ceq '' -or $teardownPhase -ceq 'rolled_back') {
                # GAP-1443, GAP-1447: an earlier 1.0.4 Setup committed this
                # tombstone over an older deployment and then handed the hook
                # removal to that deployment's helper, which refuses a
                # tombstone. No removal started (no journal) or it was rolled
                # back, so every hook is still registered as installed.
                Invoke-DefenseClawLegacyHelperTombstoneHookTeardown `
                    -Layout $Layout `
                    -GatewayServiceName $GatewayServiceName `
                    -GuardianServiceName $GuardianServiceName
            }
            else {
                throw (
                    'the installed DefenseClaw cannot remove its managed hooks after an uninstall committed, ' +
                    "and this uninstall did not prepare their removal before its commit (teardown phase '$teardownPhase')"
                )
            }
            $teardownPhase = 'prepared'
        }
        if ($teardownPhase -ceq 'prepared') {
            if ($committedPrepare -and [bool]$Layout.CodexTargetEnabled) {
                $codexRemoval = Invoke-DefenseClawCodexRequirementsCommand `
                    -Layout $Layout `
                    -GatewayServiceName $GatewayServiceName `
                    -Action remove `
                    -Teardown
                Complete-DefenseClawCodexRequirementsRemoval `
                    -Layout $Layout `
                    -GatewayServiceName $GatewayServiceName `
                    -Report $codexRemoval `
                    -Teardown
            }
            Remove-DefenseClawStandaloneOpenCodeManagedPlugin -Layout $Layout
            Set-DefenseClawInstallTreeRetirementAcls -Layout $Layout -Committed
        }
    }
    Assert-DefenseClawInstallTreeRetirementState `
        -Layout $Layout `
        -NativeSealed:$NativeSealed
    Assert-DefenseClawRecordedArtifactHashes `
        -Metadata $metadata `
        -Layout $Layout `
        -Action 'Committed Uninstall finalization' `
        -AllowRetiredArtifacts:$retiredRetry
    # A crash can occur after the native finalizer durably changes the
    # authenticated journal to finalized, but before self-uninstall retires
    # the InstallRoot. Re-entering the native finalizer is unnecessary and
    # may fail because SCM has already removed the gateway virtual account.
    # Authenticate both journal and cleanup receipt before treating that
    # completed phase as the retry boundary. Purge still needs the native
    # contract-lock action unless its receipt was finalized as well.
    if ([string]::IsNullOrEmpty($teardownPhase)) {
        $teardownPhase = Get-DefenseClawManagedHooksTeardownJournalPhase `
            -Layout $Layout `
            -Metadata $metadata `
            -GatewayServiceName $GatewayServiceName `
            -AllowLegacyInactive
    }
    $contractReceipt = Get-DefenseClawManagedHookContractCleanupReceipt `
        -Layout $Layout `
        -GatewayServiceName $GatewayServiceName `
        -GuardianServiceName $GuardianServiceName `
        -Metadata $metadata `
        -Required
    if ($teardownPhase -ceq 'finalized' -and
        (-not $Purge -or
            [string]$contractReceipt.phase -ceq 'finalized')) {
        return
    }
    if ($teardownPhase -cne 'prepared' -and
        $teardownPhase -cne 'finalized') {
        throw "managed-hook finalization requires a prepared or finalized journal: $teardownPhase"
    }
    $callerPurgeUserState = $script:DefenseClawUninstallPurgeUserState
    $script:DefenseClawUninstallPurgeUserState = $purgeUserState
    try {
        return Invoke-DefenseClawManagedHooksTeardownCommand `
            -Layout $Layout `
            -GatewayServiceName $GatewayServiceName `
            -GuardianServiceName $GuardianServiceName `
            -Action finalize `
            -PurgeContractLocks:$Purge
    }
    finally {
        $script:DefenseClawUninstallPurgeUserState = $callerPurgeUserState
    }
}

function Write-DefenseClawProtectedTextAtomic {
    param(
        [Parameter(Mandatory)][string]$Value,
        [Parameter(Mandatory)][string]$Path,
        [Parameter(Mandatory)][string]$RequiredRoot
    )
    $destination = Assert-DefenseClawDescendant `
        -Path $Path `
        -Root $RequiredRoot `
        -Label 'protected text file'
    Assert-DefenseClawNoReparsePath -Path $destination -AllowMissingLeaf
    $temporary = "$destination.new.$([Guid]::NewGuid().ToString('N'))"
    try {
        [IO.File]::WriteAllText(
            $temporary,
            $Value,
            [Text.UTF8Encoding]::new($false)
        )
        Set-DefenseClawPathAcl `
            -Path $temporary `
            -Kind AdminFile `
            -GatewayServiceSID $script:AdministratorsSID
        Move-DefenseClawNonImageFileReplacing -Source $temporary -Destination $destination
        Set-DefenseClawPathAcl `
            -Path $destination `
            -Kind AdminFile `
            -GatewayServiceSID $script:AdministratorsSID
    }
    finally {
        if (Microsoft.PowerShell.Management\Test-Path -LiteralPath $temporary) {
            Microsoft.PowerShell.Management\Remove-Item `
                -LiteralPath $temporary `
                -Force
        }
    }
}

function Write-DefenseClawStatePurgeIntentAtomic {
    param(
        [Parameter(Mandatory)][string]$Value,
        [Parameter(Mandatory)][hashtable]$Layout
    )
    $destination = Assert-DefenseClawDescendant `
        -Path $Layout.PurgeIntentPath `
        -Root $Layout.LifecycleLockDirectory `
        -Label 'state purge intent'
    Assert-DefenseClawNoReparsePath -Path $destination -AllowMissingLeaf
    $temporary = "$destination.new.$([Guid]::NewGuid().ToString('N'))"
    try {
        [IO.File]::WriteAllText(
            $temporary,
            $Value,
            [Text.UTF8Encoding]::new($false)
        )
        Set-DefenseClawPathAcl `
            -Path $temporary `
            -Kind AdminFile `
            -GatewayServiceSID $script:AdministratorsSID
        if ([IO.File]::Exists($destination)) {
            # FileSystemProvider's Move-Item -Force deletes the destination
            # before moving the staged file on Windows. File.Replace keeps the
            # prior or next authenticated phase continuously visible.
            #
            # File.Replace requires a non-empty backup path on both .NET
            # Framework and modern .NET; passing $null throws
            # "The path is not of a legal form." Stage a unique
            # same-directory backup, run Replace, then retire the backup
            # after the swap completes. This mirrors the atomic-replace
            # pattern in the sibling helper above (~line 3851).
            $backup = "$destination.backup.$([Guid]::NewGuid().ToString('N'))"
            Assert-DefenseClawNoReparsePath -Path $backup -AllowMissingLeaf
            if (Microsoft.PowerShell.Management\Test-Path -LiteralPath $backup) {
                throw "state purge intent backup path unexpectedly exists: $backup"
            }
            try {
                [IO.File]::Replace($temporary, $destination, $backup, $true)
            }
            finally {
                if (Microsoft.PowerShell.Management\Test-Path -LiteralPath $backup) {
                    if ([IO.File]::Exists($destination)) {
                        # Either phase is now continuously visible at the
                        # canonical path; the backup is redundant.
                        Microsoft.PowerShell.Management\Remove-Item `
                            -LiteralPath $backup `
                            -Force
                    }
                    else {
                        # ReplaceFile can fail after moving the destination
                        # aside (ERROR_UNABLE_TO_MOVE_REPLACEMENT_2). The
                        # backup then holds the prior purge intent, the only
                        # recovery authority outside StateRoot: put it back
                        # at the canonical path, and keep it if that fails.
                        try {
                            [IO.File]::Move($backup, $destination)
                        }
                        catch {
                            Microsoft.PowerShell.Utility\Write-Warning `
                                -Message "state purge intent preimage kept at $backup"
                        }
                    }
                }
            }
        }
        else {
            # File.Move is no-replace for the first publication.
            [IO.File]::Move($temporary, $destination)
        }
        Set-DefenseClawPathAcl `
            -Path $destination `
            -Kind AdminFile `
            -GatewayServiceSID $script:AdministratorsSID
    }
    finally {
        if (Microsoft.PowerShell.Management\Test-Path -LiteralPath $temporary) {
            Microsoft.PowerShell.Management\Remove-Item `
                -LiteralPath $temporary `
                -Force
        }
    }
}

function Get-DefenseClawSelfUninstallReceipt {
    param(
        [Parameter(Mandatory)][hashtable]$Layout,
        [Parameter(Mandatory)][string]$GatewayServiceName,
        [Parameter(Mandatory)][string]$GuardianServiceName,
        [switch]$Required
    )
    $path = Assert-DefenseClawDescendant `
        -Path $Layout.SelfUninstallReceiptPath `
        -Root $Layout.LifecycleLockDirectory `
        -Label 'self-uninstall receipt'
    if (-not (Microsoft.PowerShell.Management\Test-Path `
            -LiteralPath $path `
            -PathType Leaf)) {
        if ($Required) {
            throw 'authenticated DefenseClaw self-uninstall receipt is missing'
        }
        return $null
    }
    Assert-DefenseClawNoReparsePath -Path $path
    $item = Microsoft.PowerShell.Management\Get-Item `
        -LiteralPath $path `
        -Force
    if ([int64]$item.Length -gt 65536) {
        throw 'self-uninstall receipt exceeds the 65536-byte limit'
    }
    Assert-DefenseClawPathAcl `
        -Path $path `
        -AllowedWriterSIDs @(
            $script:SystemSID,
            $script:AdministratorsSID,
            $script:TrustedInstallerSID
        ) `
        -AllowedReaderSIDs @(
            $script:SystemSID,
            $script:AdministratorsSID,
            $script:TrustedInstallerSID
        ) `
        -RequiredRights (New-DefenseClawRequiredRights -Kind Admin) `
        -RejectUntrustedRead `
        -SelfHealKind AdminFile `
        -SelfHealGatewayServiceSID $script:AdministratorsSID
    try {
        $receipt = Microsoft.PowerShell.Management\Get-Content `
            -LiteralPath $path `
            -Raw | Microsoft.PowerShell.Utility\ConvertFrom-Json
    }
    catch {
        throw "cannot parse authenticated self-uninstall receipt: $($_.Exception.Message)"
    }
    $schema = $receipt.PSObject.Properties['schema_version']
    $purgeRequested = $receipt.PSObject.Properties['purge_requested']
    $coreCertification = $receipt.PSObject.Properties[
        'core_hardening_certification'
    ]
    $callerPID = $receipt.PSObject.Properties['caller_pid']
    $callerCreation = $receipt.PSObject.Properties[
        'caller_creation_filetime'
    ]
    if ($null -eq $schema -or
        $schema.Value -is [bool] -or
        [Convert]::ToInt64($schema.Value) -ne 1 -or
        [string]$receipt.phase -notin @(
            'prepared_install_retirement',
            'committed_install_retirement'
        ) -or
        [string]$receipt.scope_sha256 -cne
            [string]$Layout.PurgeScopeSHA256 -or
        $null -eq $purgeRequested -or
        $purgeRequested.Value -isnot [bool] -or
        $null -eq $coreCertification -or
        $coreCertification.Value -isnot [bool] -or
        $null -eq $callerPID -or
        $callerPID.Value -is [bool] -or
        [Convert]::ToInt64($callerPID.Value) -le 0 -or
        $null -eq $callerCreation -or
        $callerCreation.Value -is [bool] -or
        [Convert]::ToInt64($callerCreation.Value) -le 0) {
        throw 'authenticated self-uninstall receipt has an invalid schema, phase, or typed binding'
    }
    foreach ($binding in @(
        @('install_root', $Layout.InstallRoot),
        @('state_root', $Layout.StateRoot),
        @('pending_path', $Layout.PendingPath),
        @(
            'helper_environment_root',
            $Layout.SelfUninstallEnvironmentRoot
        )
    )) {
        $property = $receipt.PSObject.Properties[[string]$binding[0]]
        if ($null -eq $property -or
            -not [string]::Equals(
                [IO.Path]::GetFullPath([string]$property.Value).TrimEnd('\'),
                [IO.Path]::GetFullPath([string]$binding[1]).TrimEnd('\'),
                [StringComparison]::OrdinalIgnoreCase
            )) {
            throw "authenticated self-uninstall receipt does not match $($binding[0])"
        }
    }
    foreach ($binding in @(
        @('gateway_service', $GatewayServiceName),
        @('guardian_service', $GuardianServiceName)
    )) {
        $property = $receipt.PSObject.Properties[[string]$binding[0]]
        if ($null -eq $property -or
            [string]$property.Value -cne [string]$binding[1]) {
            throw "authenticated self-uninstall receipt does not match $($binding[0])"
        }
    }
    $retiredProperty = $receipt.PSObject.Properties['retired_install_root']
    if ($null -eq $retiredProperty) {
        throw 'authenticated self-uninstall receipt is missing its retired root'
    }
    [void](Assert-DefenseClawSelfUninstallRetiredRoot `
        -Layout $Layout `
        -Path ([string]$retiredProperty.Value) `
        -AllowMissing)
    foreach ($hashName in @(
        'tombstone_sha256',
        'pending_sha256',
        'caller_sha256',
        'retired_installer_sha256',
        'retired_module_sha256'
    )) {
        $property = $receipt.PSObject.Properties[$hashName]
        if ($null -eq $property -or
            [string]$property.Value -cnotmatch '^[0-9a-f]{64}$') {
            throw "authenticated self-uninstall receipt has invalid $hashName"
        }
    }
    $helperHash = $receipt.PSObject.Properties['helper_sha256']
    if ($null -eq $helperHash -or
        ([string]$receipt.phase -ceq 'committed_install_retirement' -and
            [string]$helperHash.Value -cnotmatch '^[0-9a-f]{64}$') -or
        ([string]$receipt.phase -ceq 'prepared_install_retirement' -and
            -not [string]::IsNullOrWhiteSpace([string]$helperHash.Value) -and
            [string]$helperHash.Value -cnotmatch '^[0-9a-f]{64}$')) {
        throw 'authenticated self-uninstall receipt has invalid helper hash'
    }
    $fileIdentity = $receipt.PSObject.Properties['caller_file_identity']
    if ($null -eq $fileIdentity -or
        [string]$fileIdentity.Value -cnotmatch
            '^[0-9a-f]{8}:[0-9a-f]{16}$') {
        throw 'authenticated self-uninstall receipt has invalid caller file identity'
    }
    $callerImage = $receipt.PSObject.Properties['caller_image_path']
    if ($null -eq $callerImage -or
        -not [string]::Equals(
            [IO.Path]::GetFullPath([string]$callerImage.Value).TrimEnd('\'),
            [IO.Path]::GetFullPath($Layout.CLIPath).TrimEnd('\'),
            [StringComparison]::OrdinalIgnoreCase
        )) {
        throw 'authenticated self-uninstall receipt has invalid caller image path'
    }
    $certificationProperty = $receipt.PSObject.Properties[
        'certification_codex_home'
    ]
    if ($null -eq $certificationProperty) {
        throw 'authenticated self-uninstall receipt is missing certification scope'
    }
    $receiptCertificationHome = Resolve-DefenseClawCertificationCodexHome `
        -Path ([string]$certificationProperty.Value) `
        -GatewayServiceName $GatewayServiceName `
        -GuardianServiceName $GuardianServiceName
    if ([bool]$coreCertification.Value -and
        [string]::IsNullOrWhiteSpace($receiptCertificationHome)) {
        throw 'authenticated self-uninstall receipt enables core certification outside its exact scope'
    }
    if ([string]::IsNullOrWhiteSpace(
            [string]$Layout.CertificationCodexHome
        )) {
        $Layout.CertificationCodexHome = $receiptCertificationHome
    }
    elseif (-not [string]::Equals(
            [string]$Layout.CertificationCodexHome,
            $receiptCertificationHome,
            [StringComparison]::OrdinalIgnoreCase
        )) {
        throw 'authenticated self-uninstall receipt certification CODEX_HOME does not match the requested scope'
    }
    if ([bool]$Layout.CoreHardeningCertification -and
        -not [bool]$coreCertification.Value) {
        throw 'authenticated self-uninstall receipt does not match requested core-certification mode'
    }
    $Layout.CoreHardeningCertification = [bool]$coreCertification.Value
    return $receipt
}

function Publish-DefenseClawSelfUninstallReceipt {
    param(
        [Parameter(Mandatory)][hashtable]$Layout,
        [Parameter(Mandatory)][string]$GatewayServiceName,
        [Parameter(Mandatory)][string]$GuardianServiceName,
        [Parameter(Mandatory)]$CallerIdentity,
        [switch]$Purge
    )
    if (-not (Microsoft.PowerShell.Management\Test-Path `
            -LiteralPath $Layout.PendingPath `
            -PathType Leaf)) {
        throw 'self-uninstall receipt publication requires a pending lifecycle transaction'
    }
    foreach ($name in @(Get-DefenseClawManagedServiceNames -GatewayServiceName $GatewayServiceName -GuardianServiceName $GuardianServiceName)) {
        if (Test-DefenseClawServiceExists -Name $name) {
            throw "self-uninstall receipt publication refused while service exists: $name"
        }
    }
    if (-not (Microsoft.PowerShell.Management\Test-Path `
            -LiteralPath $Layout.InstallRoot `
            -PathType Container)) {
        throw 'self-uninstall receipt publication requires the canonical InstallRoot'
    }
    if (Microsoft.PowerShell.Management\Test-Path `
        -LiteralPath $Layout.SelfUninstallReceiptPath) {
        throw 'an authenticated self-uninstall receipt already exists'
    }
    $metadata = Get-DefenseClawDeploymentMetadata -Layout $Layout -Required
    Assert-DefenseClawMetadataIdentity `
        -Metadata $metadata `
        -GatewayServiceName $GatewayServiceName `
        -GuardianServiceName $GuardianServiceName
    if (Test-DefenseClawMetadataInstalled -Metadata $metadata) {
        throw 'self-uninstall receipt publication requires a committed uninstall tombstone'
    }
    foreach ($path in @($Layout.CLIPath, $Layout.InstallerPath, $Layout.ModulePath)) {
        if (-not (Microsoft.PowerShell.Management\Test-Path `
                -LiteralPath $path `
                -PathType Leaf)) {
            throw "self-uninstall receipt publication is missing managed artifact: $path"
        }
        Assert-DefenseClawNoReparsePath -Path $path
    }
    $retiredRoot = New-DefenseClawSelfUninstallRetiredRoot -Layout $Layout
    $receipt = [ordered]@{
        schema_version = 1
        phase = 'prepared_install_retirement'
        scope_sha256 = [string]$Layout.PurgeScopeSHA256
        install_root = $Layout.InstallRoot
        retired_install_root = $retiredRoot
        state_root = $Layout.StateRoot
        pending_path = $Layout.PendingPath
        helper_environment_root = $Layout.SelfUninstallEnvironmentRoot
        gateway_service = $GatewayServiceName
        guardian_service = $GuardianServiceName
        certification_codex_home = [string]$Layout.CertificationCodexHome
        core_hardening_certification = [bool]$Layout.CoreHardeningCertification
        purge_requested = [bool]$Purge
        tombstone_sha256 = (
            Microsoft.PowerShell.Utility\Get-FileHash `
                -LiteralPath $Layout.MetadataPath `
                -Algorithm SHA256
        ).Hash.ToLowerInvariant()
        pending_sha256 = (
            Microsoft.PowerShell.Utility\Get-FileHash `
                -LiteralPath $Layout.PendingPath `
                -Algorithm SHA256
        ).Hash.ToLowerInvariant()
        caller_pid = [int64]$CallerIdentity.pid
        caller_creation_filetime = [int64]$CallerIdentity.creation_filetime
        caller_image_path = [string]$CallerIdentity.image_path
        caller_file_identity = [string]$CallerIdentity.file_identity
        caller_sha256 = [string]$CallerIdentity.sha256
        retired_installer_sha256 = (
            Microsoft.PowerShell.Utility\Get-FileHash `
                -LiteralPath $Layout.InstallerPath `
                -Algorithm SHA256
        ).Hash.ToLowerInvariant()
        retired_module_sha256 = (
            Microsoft.PowerShell.Utility\Get-FileHash `
                -LiteralPath $Layout.ModulePath `
                -Algorithm SHA256
        ).Hash.ToLowerInvariant()
        helper_sha256 = ''
        created_at = [DateTime]::UtcNow.ToString('o')
        committed_at = ''
    }
    Write-DefenseClawJsonAtomic `
        -Value $receipt `
        -Path $Layout.SelfUninstallReceiptPath
    Set-DefenseClawPathAcl `
        -Path $Layout.SelfUninstallReceiptPath `
        -Kind AdminFile `
        -GatewayServiceSID $script:AdministratorsSID
    return Get-DefenseClawSelfUninstallReceipt `
        -Layout $Layout `
        -GatewayServiceName $GatewayServiceName `
        -GuardianServiceName $GuardianServiceName `
        -Required
}

function Initialize-DefenseClawSelfUninstallEnvironment {
    param([Parameter(Mandatory)][hashtable]$Layout)
    $environmentRoot = Assert-DefenseClawDescendant `
        -Path $Layout.SelfUninstallEnvironmentRoot `
        -Root $Layout.LifecycleLockDirectory `
        -Label 'self-uninstall helper environment root'
    Initialize-DefenseClawManagedRoot `
        -Path $environmentRoot `
        -Label 'self-uninstall helper environment root' `
        -RequiredBase $Layout.LifecycleLockDirectory
    Assert-DefenseClawPathAcl `
        -Path $environmentRoot `
        -AllowedWriterSIDs @(
            $script:SystemSID,
            $script:AdministratorsSID,
            $script:TrustedInstallerSID
        ) `
        -AllowedReaderSIDs @(
            $script:SystemSID,
            $script:AdministratorsSID,
            $script:TrustedInstallerSID
        ) `
        -RequiredRights (New-DefenseClawRequiredRights -Kind Admin) `
        -RejectUntrustedRead
    return $environmentRoot
}

function Assert-DefenseClawSelfUninstallEnvironment {
    param([Parameter(Mandatory)][hashtable]$Layout)
    $environmentRoot = Assert-DefenseClawDescendant `
        -Path $Layout.SelfUninstallEnvironmentRoot `
        -Root $Layout.LifecycleLockDirectory `
        -Label 'self-uninstall helper environment root'
    if (-not (Microsoft.PowerShell.Management\Test-Path `
            -LiteralPath $environmentRoot `
            -PathType Container)) {
        throw 'self-uninstall helper environment root is not a directory'
    }
    Assert-DefenseClawManagedTreeNoReparse -Root $environmentRoot
    $objects = @(
        Microsoft.PowerShell.Management\Get-Item `
            -LiteralPath $environmentRoot `
            -Force
    ) + @(
        Microsoft.PowerShell.Management\Get-ChildItem `
            -LiteralPath $environmentRoot `
            -Recurse `
            -Force
    )
    foreach ($item in $objects) {
        Assert-DefenseClawPathAcl `
            -Path $item.FullName `
            -AllowedWriterSIDs @(
                $script:SystemSID,
                $script:AdministratorsSID,
                $script:TrustedInstallerSID
            ) `
            -AllowedReaderSIDs @(
                $script:SystemSID,
                $script:AdministratorsSID,
                $script:TrustedInstallerSID
            ) `
            -RequiredRights (New-DefenseClawRequiredRights -Kind Admin) `
            -AllowInheritance `
            -RejectUntrustedRead
    }
    return $environmentRoot
}

function Remove-DefenseClawSelfUninstallEnvironment {
    param([Parameter(Mandatory)][hashtable]$Layout)
    $environmentRoot = Assert-DefenseClawDescendant `
        -Path $Layout.SelfUninstallEnvironmentRoot `
        -Root $Layout.LifecycleLockDirectory `
        -Label 'self-uninstall helper environment root'
    if (-not (Microsoft.PowerShell.Management\Test-Path `
            -LiteralPath $environmentRoot)) {
        return
    }
    [void](Assert-DefenseClawSelfUninstallEnvironment -Layout $Layout)
    Remove-DefenseClawManagedTree `
        -Path $environmentRoot `
        -RequiredBase $Layout.LifecycleLockDirectory `
        -Label 'self-uninstall helper environment root'
    if (Microsoft.PowerShell.Management\Test-Path `
        -LiteralPath $environmentRoot) {
        throw 'self-uninstall helper environment root survived cleanup'
    }
}

function Get-DefenseClawSelfUninstallHelperContent {
    # -DeferredRetirement: the finalizer of an uninstall whose InstallRoot
    # retirement was deferred (Start-DefenseClawDeferredSelfUninstallRetirement)
    # runs the same module from InstallRoot until it retires it. Without it
    # the content is the one earlier releases wrote.
    param(
        [Parameter(Mandatory)][hashtable]$Layout,
        [Parameter(Mandatory)]$Receipt,
        [switch]$DeferredRetirement
    )
    $retiredModulePath = Microsoft.PowerShell.Management\Join-Path `
        ([string]$Receipt.retired_install_root) `
        'libexec\DefenseClawEnterprise.psm1'
    $receiptLiteral = ([string]$Layout.SelfUninstallReceiptPath).Replace(
        "'",
        "''"
    )
    $moduleLiteral = ([string]$retiredModulePath).Replace("'", "''")
    $moduleHashLiteral = ([string]$Receipt.retired_module_sha256).Replace(
        "'",
        "''"
    )
    $moduleSelection = ''
    if ($DeferredRetirement) {
        $canonicalModuleLiteral = (
            [string](Microsoft.PowerShell.Management\Join-Path `
                ([string]$Receipt.install_root) `
                'libexec\DefenseClawEnterprise.psm1')
        ).Replace("'", "''")
        $moduleSelection = "; if (-not [IO.File]::Exists(`$modulePath)) { `$modulePath = '$canonicalModuleLiteral' }"
    }
    # This is an expandable here-string: a backtick before a newline is an
    # escape here, not a line continuation, so every generated command must
    # stay on one line.
    return @"
# Copyright 2026 Cisco Systems, Inc. and its affiliates
# SPDX-License-Identifier: Apache-2.0
#Requires -Version 5.1
Microsoft.PowerShell.Core\Set-StrictMode -Version Latest
`$ErrorActionPreference = 'Stop'
try {
    `$receiptPath = '$receiptLiteral'
    `$modulePath = '$moduleLiteral'$moduleSelection
    `$expectedModuleHash = '$moduleHashLiteral'
    if (-not [IO.File]::Exists(`$modulePath)) {
        throw "retired self-uninstall module is missing: `$modulePath"
    }
    `$moduleItem = Microsoft.PowerShell.Management\Get-Item -LiteralPath `$modulePath -Force
    if ((`$moduleItem.Attributes -band [IO.FileAttributes]::ReparsePoint) -ne 0) {
        throw "retired self-uninstall module is a reparse point: `$modulePath"
    }
    `$actualModuleHash = (
        Microsoft.PowerShell.Utility\Get-FileHash -LiteralPath `$modulePath -Algorithm SHA256
    ).Hash.ToLowerInvariant()
    if (`$actualModuleHash -cne `$expectedModuleHash) {
        throw 'retired self-uninstall module hash does not match its protected receipt'
    }
    Microsoft.PowerShell.Core\Import-Module -Name `$modulePath -Force -ErrorAction Stop
    `$module = Microsoft.PowerShell.Core\Get-Module DefenseClawEnterprise
    if (`$null -eq `$module) {
        throw 'retired DefenseClaw enterprise module did not import'
    }
    & `$module {
        param(`$ProtectedReceiptPath)
        Complete-DefenseClawSelfUninstallRetirement -ReceiptPath `$ProtectedReceiptPath -WaitForCallerExit
    } `$receiptPath
}
catch {
    [Console]::Error.WriteLine(
        "DefenseClaw self-uninstall finalizer retained recovery state: {0}",
        `$_.Exception.Message
    )
    exit 1
}
"@
}

function Assert-DefenseClawSelfUninstallHelper {
    param(
        [Parameter(Mandatory)][hashtable]$Layout,
        [Parameter(Mandatory)]$Receipt
    )
    $helperPath = Assert-DefenseClawDescendant `
        -Path $Layout.SelfUninstallHelperPath `
        -Root $Layout.LifecycleLockDirectory `
        -Label 'self-uninstall finalizer'
    if (-not (Microsoft.PowerShell.Management\Test-Path `
            -LiteralPath $helperPath `
            -PathType Leaf)) {
        throw 'protected self-uninstall finalizer is missing'
    }
    Assert-DefenseClawNoReparsePath -Path $helperPath
    Assert-DefenseClawPathAcl `
        -Path $helperPath `
        -AllowedWriterSIDs @(
            $script:SystemSID,
            $script:AdministratorsSID,
            $script:TrustedInstallerSID
        ) `
        -AllowedReaderSIDs @(
            $script:SystemSID,
            $script:AdministratorsSID,
            $script:TrustedInstallerSID
        ) `
        -RequiredRights (New-DefenseClawRequiredRights -Kind Admin) `
        -RejectUntrustedRead
    $actualHash = (
        Microsoft.PowerShell.Utility\Get-FileHash `
            -LiteralPath $helperPath `
            -Algorithm SHA256
    ).Hash.ToLowerInvariant()
    if ($actualHash -cne [string]$Receipt.helper_sha256) {
        throw 'protected self-uninstall finalizer hash does not match its receipt'
    }
    return $helperPath
}

function Get-DefenseClawTextSHA256 {
    param([Parameter(Mandatory)][AllowEmptyString()][string]$Value)
    $algorithm = [Security.Cryptography.SHA256]::Create()
    try {
        return (
            [BitConverter]::ToString(
                $algorithm.ComputeHash([Text.UTF8Encoding]::new($false).GetBytes($Value))
            ).Replace('-', '').ToLowerInvariant()
        )
    }
    finally {
        $algorithm.Dispose()
    }
}

function Ensure-DefenseClawSelfUninstallHelper {
    param(
        [Parameter(Mandatory)][hashtable]$Layout,
        [Parameter(Mandatory)]$Receipt,
        [switch]$DeferredRetirement
    )
    [void](Initialize-DefenseClawSelfUninstallEnvironment `
        -Layout $Layout)
    $content = Get-DefenseClawSelfUninstallHelperContent `
        -Layout $Layout `
        -Receipt $Receipt `
        -DeferredRetirement:$DeferredRetirement
    $expectedHash = Get-DefenseClawTextSHA256 -Value $content
    if (Microsoft.PowerShell.Management\Test-Path `
        -LiteralPath $Layout.SelfUninstallHelperPath) {
        # An existing finalizer keeps the content it was written with: the
        # usual one, or the one of a deferred InstallRoot retirement (or the
        # usual one, when this run defers). A receipt with no hash is one
        # whose run stopped after it wrote the finalizer and before it
        # recorded the hash (Set-DefenseClawSelfUninstallReceiptHelper); the
        # finalizer's own bytes then say which of the two exact variants of
        # this receipt it is, and that hash is recorded (GAP-0149 review,
        # loop round 2). Anything else is refused.
        $otherHash = Get-DefenseClawTextSHA256 -Value (
            Get-DefenseClawSelfUninstallHelperContent `
                -Layout $Layout `
                -Receipt $Receipt `
                -DeferredRetirement:(-not $DeferredRetirement)
        )
        if ([string]::IsNullOrWhiteSpace([string]$Receipt.helper_sha256)) {
            Assert-DefenseClawNoReparsePath -Path $Layout.SelfUninstallHelperPath
            $Receipt.helper_sha256 = (
                Microsoft.PowerShell.Utility\Get-FileHash `
                    -LiteralPath $Layout.SelfUninstallHelperPath `
                    -Algorithm SHA256
            ).Hash.ToLowerInvariant()
        }
        if (@($expectedHash, $otherHash) -cnotcontains [string]$Receipt.helper_sha256) {
            throw 'existing self-uninstall finalizer belongs to different protected receipt content'
        }
        return Assert-DefenseClawSelfUninstallHelper `
            -Layout $Layout `
            -Receipt $Receipt
    }
    Write-DefenseClawProtectedTextAtomic `
        -Value $content `
        -Path $Layout.SelfUninstallHelperPath `
        -RequiredRoot $Layout.LifecycleLockDirectory
    $Receipt.helper_sha256 = $expectedHash
    return $Layout.SelfUninstallHelperPath
}

function Set-DefenseClawSelfUninstallReceiptCaller {
    # Binds a prepared self-uninstall receipt to the installed CLI that
    # retries it once the caller that prepared it has exited. Only the
    # process identity changes: the image is the same installed CLI file
    # the receipt recorded.
    param(
        [Parameter(Mandatory)][hashtable]$Layout,
        [Parameter(Mandatory)][string]$GatewayServiceName,
        [Parameter(Mandatory)][string]$GuardianServiceName,
        [Parameter(Mandatory)]$Receipt,
        [Parameter(Mandatory)][int]$CallerPID
    )
    if ([string]$Receipt.phase -cne 'prepared_install_retirement') {
        throw 'only a prepared self-uninstall receipt can take a new caller'
    }
    $identity = Get-DefenseClawSelfUninstallCallerIdentity `
        -Layout $Layout `
        -CallerPID $CallerPID
    if ([string]$identity.file_identity -cne [string]$Receipt.caller_file_identity -or
        [string]$identity.sha256 -cne [string]$Receipt.caller_sha256) {
        throw 'the retrying CLI is not the installed CLI the self-uninstall receipt recorded'
    }
    $Receipt.caller_pid = [int64]$identity.pid
    $Receipt.caller_creation_filetime = [int64]$identity.creation_filetime
    Write-DefenseClawJsonAtomic `
        -Value $Receipt `
        -Path $Layout.SelfUninstallReceiptPath
    Set-DefenseClawPathAcl `
        -Path $Layout.SelfUninstallReceiptPath `
        -Kind AdminFile `
        -GatewayServiceSID $script:AdministratorsSID
    return Get-DefenseClawSelfUninstallReceipt `
        -Layout $Layout `
        -GatewayServiceName $GatewayServiceName `
        -GuardianServiceName $GuardianServiceName `
        -Required
}

function Set-DefenseClawSelfUninstallReceiptCommitted {
    param(
        [Parameter(Mandatory)][hashtable]$Layout,
        [Parameter(Mandatory)][string]$GatewayServiceName,
        [Parameter(Mandatory)][string]$GuardianServiceName
    )
    $receipt = Get-DefenseClawSelfUninstallReceipt `
        -Layout $Layout `
        -GatewayServiceName $GatewayServiceName `
        -GuardianServiceName $GuardianServiceName `
        -Required
    if (Microsoft.PowerShell.Management\Test-Path `
        -LiteralPath $Layout.PendingPath) {
        throw 'self-uninstall retirement cannot commit while transaction evidence remains'
    }
    if (Microsoft.PowerShell.Management\Test-Path `
        -LiteralPath $Layout.ManagedHooksTeardownJournalPath) {
        throw 'self-uninstall retirement cannot commit before teardown-journal retirement'
    }
    foreach ($name in @(Get-DefenseClawManagedServiceNames -GatewayServiceName $GatewayServiceName -GuardianServiceName $GuardianServiceName)) {
        if (Test-DefenseClawServiceExists -Name $name) {
            throw "self-uninstall retirement cannot commit while service exists: $name"
        }
    }
    if (Microsoft.PowerShell.Management\Test-Path `
        -LiteralPath $Layout.InstallRoot) {
        throw 'self-uninstall retirement cannot commit while canonical InstallRoot exists'
    }
    Assert-DefenseClawRetiredInstallTree `
        -Layout $Layout `
        -RetiredRoot ([string]$receipt.retired_install_root)
    if (-not (Microsoft.PowerShell.Management\Test-Path `
            -LiteralPath $Layout.MetadataPath `
            -PathType Leaf)) {
        throw 'self-uninstall retirement cannot commit without its uninstall tombstone'
    }
    $metadata = Get-DefenseClawDeploymentMetadata -Layout $Layout -Required
    Assert-DefenseClawMetadataIdentity `
        -Metadata $metadata `
        -GatewayServiceName $GatewayServiceName `
        -GuardianServiceName $GuardianServiceName
    if (Test-DefenseClawMetadataInstalled -Metadata $metadata) {
        throw 'self-uninstall retirement cannot commit against installed metadata'
    }
    $actualTombstoneHash = (
        Microsoft.PowerShell.Utility\Get-FileHash `
            -LiteralPath $Layout.MetadataPath `
            -Algorithm SHA256
    ).Hash.ToLowerInvariant()
    if ($actualTombstoneHash -cne [string]$receipt.tombstone_sha256) {
        throw 'self-uninstall tombstone changed after retirement preparation'
    }
    $retiredCLI = Microsoft.PowerShell.Management\Join-Path `
        ([string]$receipt.retired_install_root) `
        'bin\defenseclaw.exe'
    if ([string]$receipt.phase -ceq 'prepared_install_retirement' -and
        -not (Microsoft.PowerShell.Management\Test-Path `
            -LiteralPath $retiredCLI `
            -PathType Leaf)) {
        throw 'prepared self-uninstall retired CLI is missing'
    }
    if ([string]$receipt.phase -ceq 'prepared_install_retirement') {
        foreach ($artifact in @(
            @(
                'installer',
                (
                    Microsoft.PowerShell.Management\Join-Path `
                        ([string]$receipt.retired_install_root) `
                        'libexec\install-enterprise.ps1'
                ),
                [string]$receipt.retired_installer_sha256
            ),
            @(
                'module',
                (
                    Microsoft.PowerShell.Management\Join-Path `
                        ([string]$receipt.retired_install_root) `
                        'libexec\DefenseClawEnterprise.psm1'
                ),
                [string]$receipt.retired_module_sha256
            )
        )) {
            if (-not (Microsoft.PowerShell.Management\Test-Path `
                    -LiteralPath ([string]$artifact[1]) `
                    -PathType Leaf)) {
                throw "prepared self-uninstall retired $($artifact[0]) is missing"
            }
            $artifactHash = (
                Microsoft.PowerShell.Utility\Get-FileHash `
                    -LiteralPath ([string]$artifact[1]) `
                    -Algorithm SHA256
            ).Hash.ToLowerInvariant()
            if ($artifactHash -cne [string]$artifact[2]) {
                throw "prepared self-uninstall retired $($artifact[0]) hash changed"
            }
        }
    }
    if (Microsoft.PowerShell.Management\Test-Path `
        -LiteralPath $retiredCLI `
        -PathType Leaf) {
        if ((Get-DefenseClawFileIdentity -Path $retiredCLI) -cne
                [string]$receipt.caller_file_identity -or
            (
                Microsoft.PowerShell.Utility\Get-FileHash `
                    -LiteralPath $retiredCLI `
                    -Algorithm SHA256
            ).Hash.ToLowerInvariant() -cne [string]$receipt.caller_sha256) {
            throw 'retired CLI file identity or hash changed after atomic rename'
        }
    }
    if ([string]$receipt.phase -ceq 'committed_install_retirement') {
        [void](Ensure-DefenseClawSelfUninstallHelper `
            -Layout $Layout `
            -Receipt $receipt)
        return Get-DefenseClawSelfUninstallReceipt `
            -Layout $Layout `
            -GatewayServiceName $GatewayServiceName `
            -GuardianServiceName $GuardianServiceName `
            -Required
    }
    [void](Ensure-DefenseClawSelfUninstallHelper `
        -Layout $Layout `
        -Receipt $receipt)
    $receipt.phase = 'committed_install_retirement'
    $receipt.committed_at = [DateTime]::UtcNow.ToString('o')
    Write-DefenseClawJsonAtomic `
        -Value $receipt `
        -Path $Layout.SelfUninstallReceiptPath
    Set-DefenseClawPathAcl `
        -Path $Layout.SelfUninstallReceiptPath `
        -Kind AdminFile `
        -GatewayServiceSID $script:AdministratorsSID
    return Get-DefenseClawSelfUninstallReceipt `
        -Layout $Layout `
        -GatewayServiceName $GatewayServiceName `
        -GuardianServiceName $GuardianServiceName `
        -Required
}

function Test-DefenseClawSelfUninstallCallerRunning {
    param(
        [Parameter(Mandatory)][hashtable]$Layout,
        [Parameter(Mandatory)]$Receipt
    )
    $nativeSecurityType = Initialize-DefenseClawNativeSecurity
    try {
        $creationFileTime = [int64](
            $nativeSecurityType::GetProcessCreationFileTime(
                [uint32][int64]$Receipt.caller_pid
            )
        )
        $imagePath = [IO.Path]::GetFullPath(
            [string]$nativeSecurityType::GetProcessImagePath(
                [uint32][int64]$Receipt.caller_pid
            )
        ).TrimEnd('\')
    }
    catch {
        return $false
    }
    if ($creationFileTime -ne [int64]$Receipt.caller_creation_filetime) {
        return $false
    }
    $retiredImage = Microsoft.PowerShell.Management\Join-Path `
        ([string]$Receipt.retired_install_root) `
        'bin\defenseclaw.exe'
    return (
        [string]::Equals(
            $imagePath,
            [IO.Path]::GetFullPath($Layout.CLIPath).TrimEnd('\'),
            [StringComparison]::OrdinalIgnoreCase
        ) -or
        [string]::Equals(
            $imagePath,
            [IO.Path]::GetFullPath($retiredImage).TrimEnd('\'),
            [StringComparison]::OrdinalIgnoreCase
        )
    )
}

function Start-DefenseClawSelfUninstallHelper {
    param(
        [Parameter(Mandatory)][hashtable]$Layout,
        [Parameter(Mandatory)]$Receipt
    )
    $environmentRoot =
        Initialize-DefenseClawSelfUninstallEnvironment `
            -Layout $Layout
    $helperPath = Assert-DefenseClawSelfUninstallHelper `
        -Layout $Layout `
        -Receipt $Receipt
    $powerShell = [IO.Path]::Combine(
        $script:System32,
        'WindowsPowerShell\v1.0\powershell.exe'
    )
    $engineDirectory = [IO.Path]::Combine($script:System32, 'WindowsPowerShell\v1.0')
    if (Test-DefenseClawStandaloneProfile) {
        # The standalone lifecycle runs only on PowerShell 7; its finalizer
        # uses the same engine the CLI resolved and validated.
        $engineDirectory = [IO.Path]::GetFullPath($PSHOME).TrimEnd('\')
        $powerShell = [IO.Path]::Combine($engineDirectory, 'pwsh.exe')
    }
    $powerShell = Resolve-DefenseClawFullPath `
        -Path $powerShell `
        -MustExist `
        -Leaf
    Assert-DefenseClawNoReparsePath -Path $powerShell
    if ($helperPath.Contains('"') -or
        [Text.RegularExpressions.Regex]::IsMatch(
            $helperPath,
            '[\x00-\x1f]'
        )) {
        throw 'protected self-uninstall finalizer path contains unsafe command-line characters'
    }
    $arguments = (
        '-NoLogo -NoProfile -NonInteractive -ExecutionPolicy Bypass ' +
        '-File "' + $helperPath + '"'
    )
    $homeDrive = [IO.Path]::GetPathRoot(
        $environmentRoot
    ).TrimEnd('\')
    $homePath = $environmentRoot.Substring($homeDrive.Length)
    if ([string]::IsNullOrWhiteSpace($homeDrive) -or
        -not $homePath.StartsWith(
            '\',
            [StringComparison]::Ordinal
        )) {
        throw 'protected helper environment root does not have a local drive home path'
    }
    $environment = [Collections.Generic.List[string]]::new()
    foreach ($pair in @(
        @('SystemRoot', $script:WindowsDirectory),
        @('windir', $script:WindowsDirectory),
        @('ProgramFiles', $script:ProgramFiles),
        @('ProgramData', $script:ProgramData),
        @('TEMP', $environmentRoot),
        @('TMP', $environmentRoot),
        @('LOCALAPPDATA', $environmentRoot),
        @('APPDATA', $environmentRoot),
        @('USERPROFILE', $environmentRoot),
        @('HOME', $environmentRoot),
        @('HOMEDRIVE', $homeDrive),
        @('HOMEPATH', $homePath),
        @('PSModuleAnalysisCachePath', 'NUL'),
        @('PATH', (
            @(
                $script:System32,
                $script:WindowsDirectory,
                ([IO.Path]::Combine($script:System32, 'Wbem')),
                $engineDirectory
            ) -join [IO.Path]::PathSeparator
        )),
        @('PSModulePath', (
            [IO.Path]::Combine(
                $engineDirectory,
                'Modules'
            )
        ))
    )) {
        $environment.Add(
            ([string]$pair[0]) + '=' + ([string]$pair[1])
        )
    }
    # ProcessStartInfo on Windows PowerShell 5.1 sets bInheritHandles=true
    # whenever streams are redirected and can leak unrelated inheritable
    # caller pipes. The installed CLI would then wait for capture EOF while
    # this helper waits for that CLI to exit. Native CreateProcessW launches
    # the fixed System32 engine with bInheritHandles=false, no standard-handle
    # startup fields, CREATE_NO_WINDOW, an explicit clean Unicode environment,
    # and a fixed trusted working directory.
    $nativeSecurityType = Initialize-DefenseClawNativeSecurity
    return [int64]$nativeSecurityType::StartDetachedProcess(
        $powerShell,
        ('"' + $powerShell + '" ' + $arguments),
        $script:System32,
        [string[]]$environment.ToArray()
    )
}

function Remove-DefenseClawEmptyRetiredInstallDirectory {
    param([Parameter(Mandatory)][string]$Path)
    if (-not (Microsoft.PowerShell.Management\Test-Path `
            -LiteralPath $Path `
            -PathType Container)) {
        return
    }
    Assert-DefenseClawNoReparsePath -Path $Path
    # Never recurse: a non-recursive Remove-Item of a directory with children
    # prompts, which a -NonInteractive engine reports only as "Read and Prompt
    # functionality is not available". Name the survivor instead and keep it.
    $child = Microsoft.PowerShell.Management\Get-ChildItem `
        -LiteralPath $Path `
        -Force |
        Microsoft.PowerShell.Utility\Select-Object -First 1
    if ($null -ne $child) {
        throw "receipt-bound retired InstallRoot directory is not empty: $($child.FullName)"
    }
    Microsoft.PowerShell.Management\Remove-Item `
        -LiteralPath $Path `
        -Force
}

function Remove-DefenseClawRetiredInstallTree {
    param(
        [Parameter(Mandatory)][hashtable]$Layout,
        [Parameter(Mandatory)]$Receipt
    )
    $retired = [string]$Receipt.retired_install_root
    if (-not (Microsoft.PowerShell.Management\Test-Path `
            -LiteralPath $retired)) {
        return
    }
    Assert-DefenseClawRetiredInstallTree `
        -Layout $Layout `
        -RetiredRoot $retired
    $allowlist = Get-DefenseClawRetiredInstallTreeAllowlist `
        -Layout $Layout `
        -RetiredRoot $retired
    $modulePath = Microsoft.PowerShell.Management\Join-Path `
        $retired `
        'libexec\DefenseClawEnterprise.psm1'
    # AF_UNIX socket: skip the per-file no-reparse gate below (the socket
    # is an IO_REPARSE_TAG_AF_UNIX reparse point by design) and delete it
    # separately at the end alongside its ipc\ container.
    $retiredIPCSocket = Microsoft.PowerShell.Management\Join-Path `
        $retired `
        'ipc\defenseclaw_ipc.sock'
    foreach ($path in @(
        $allowlist.files |
            Microsoft.PowerShell.Core\Where-Object {
                -not [string]::Equals(
                    [string]$_,
                    $modulePath,
                    [StringComparison]::OrdinalIgnoreCase
                ) -and
                -not [string]::Equals(
                    [string]$_,
                    (
                        [IO.Path]::GetFullPath($retiredIPCSocket).TrimEnd('\')
                    ),
                    [StringComparison]::OrdinalIgnoreCase
                )
            }
    )) {
        if (Microsoft.PowerShell.Management\Test-Path `
            -LiteralPath $path `
            -PathType Leaf) {
            Assert-DefenseClawNoReparsePath -Path $path
            Microsoft.PowerShell.Management\Remove-Item `
                -LiteralPath $path `
                -Force
        }
    }
    if (Microsoft.PowerShell.Management\Test-Path `
        -LiteralPath $retiredIPCSocket `
        -PathType Leaf) {
        # Remove-Item -Force deletes the reparse point itself (no target
        # follow) which is exactly the right primitive for AF_UNIX
        # sockets - the "target" is the socket, there is nothing else
        # behind it.
        Microsoft.PowerShell.Management\Remove-Item `
            -LiteralPath $retiredIPCSocket `
            -Force
    }
    if (Microsoft.PowerShell.Management\Test-Path `
        -LiteralPath $modulePath `
        -PathType Leaf) {
        $moduleHash = (
            Microsoft.PowerShell.Utility\Get-FileHash `
                -LiteralPath $modulePath `
                -Algorithm SHA256
        ).Hash.ToLowerInvariant()
        if ($moduleHash -cne [string]$Receipt.retired_module_sha256) {
            throw 'retired module changed before receipt-authorized final deletion'
        }
        Microsoft.PowerShell.Management\Remove-Item `
            -LiteralPath $modulePath `
            -Force
    }
    # Every allowlisted directory, deepest first (a child path is longer than
    # its parent), then the root. Listing them by hand missed the standalone
    # compiler's lib\defenseclaw and lib (GAP-0046): the root removal then
    # prompted, the receipt survived, and every later recovery, including a
    # published older Setup's, failed with lifecycle_error 1603.
    foreach ($directory in @(
        $allowlist.directories |
            Microsoft.PowerShell.Utility\Sort-Object `
                -Property Length `
                -Descending
    )) {
        Remove-DefenseClawEmptyRetiredInstallDirectory -Path $directory
    }
    Remove-DefenseClawEmptyRetiredInstallDirectory -Path $retired
    if (Microsoft.PowerShell.Management\Test-Path -LiteralPath $retired) {
        throw 'receipt-bound retired InstallRoot survived final cleanup'
    }
}

function Remove-DefenseClawSelfUninstallEvidence {
    param(
        [Parameter(Mandatory)][hashtable]$Layout,
        [Parameter(Mandatory)]$Receipt
    )
    # HOME/TEMP/module-analysis state is isolated to this receipt-bound,
    # Admin-only root. Retire it before the launcher and receipt, after every
    # tree object and ACL has been revalidated.
    Remove-DefenseClawSelfUninstallEnvironment -Layout $Layout
    if (Microsoft.PowerShell.Management\Test-Path `
        -LiteralPath $Layout.SelfUninstallHelperPath) {
        if (-not [string]::IsNullOrWhiteSpace(
                [string]$Receipt.helper_sha256
            )) {
            [void](Assert-DefenseClawSelfUninstallHelper `
                -Layout $Layout `
                -Receipt $Receipt)
        }
        else {
            Assert-DefenseClawNoReparsePath `
                -Path $Layout.SelfUninstallHelperPath
            Assert-DefenseClawPathAcl `
                -Path $Layout.SelfUninstallHelperPath `
                -AllowedWriterSIDs @(
                    $script:SystemSID,
                    $script:AdministratorsSID,
                    $script:TrustedInstallerSID
                ) `
                -AllowedReaderSIDs @(
                    $script:SystemSID,
                    $script:AdministratorsSID,
                    $script:TrustedInstallerSID
                ) `
                -RequiredRights (New-DefenseClawRequiredRights -Kind Admin) `
                -RejectUntrustedRead
        }
        Microsoft.PowerShell.Management\Remove-Item `
            -LiteralPath $Layout.SelfUninstallHelperPath `
            -Force
    }
    # The authenticated receipt is always the final object retired. Any crash
    # before this point therefore leaves exact authority for a bounded retry.
    if (Microsoft.PowerShell.Management\Test-Path `
        -LiteralPath $Layout.SelfUninstallReceiptPath) {
        Microsoft.PowerShell.Management\Remove-Item `
            -LiteralPath $Layout.SelfUninstallReceiptPath `
            -Force
    }
    if (Microsoft.PowerShell.Management\Test-Path `
        -LiteralPath $Layout.SelfUninstallReceiptPath) {
        throw 'authenticated self-uninstall receipt survived final cleanup'
    }
}

function Wait-DefenseClawSelfUninstallCallerExit {
    param(
        [Parameter(Mandatory)][hashtable]$Layout,
        [Parameter(Mandatory)]$Receipt,
        [int]$TimeoutSeconds = 300
    )
    if (-not (Test-DefenseClawSelfUninstallCallerRunning `
            -Layout $Layout `
            -Receipt $Receipt)) {
        return
    }
    $process = Microsoft.PowerShell.Management\Get-Process `
        -Id ([int][int64]$Receipt.caller_pid) `
        -ErrorAction Stop
    try {
        if (-not $process.WaitForExit($TimeoutSeconds * 1000)) {
            throw (
                'installed CLI did not exit within the bounded ' +
                "$TimeoutSeconds-second self-uninstall cleanup wait"
            )
        }
    }
    finally {
        $process.Dispose()
    }
    if (Test-DefenseClawSelfUninstallCallerRunning `
        -Layout $Layout `
        -Receipt $Receipt) {
        throw 'installed CLI identity still matches after bounded exit wait'
    }
}

function Assert-DefenseClawSelfUninstallCommittedState {
    param(
        [Parameter(Mandatory)][hashtable]$Layout,
        [Parameter(Mandatory)][string]$GatewayServiceName,
        [Parameter(Mandatory)][string]$GuardianServiceName,
        [Parameter(Mandatory)]$Receipt,
        [switch]$AllowPurgedState
    )
    if (Microsoft.PowerShell.Management\Test-Path `
        -LiteralPath $Layout.PendingPath) {
        throw 'committed self-uninstall recovery found pending transaction evidence'
    }
    foreach ($name in @(Get-DefenseClawManagedServiceNames -GatewayServiceName $GatewayServiceName -GuardianServiceName $GuardianServiceName)) {
        if (Test-DefenseClawServiceExists -Name $name) {
            throw "committed self-uninstall recovery found live service: $name"
        }
    }
    if (Microsoft.PowerShell.Management\Test-Path `
        -LiteralPath $Layout.InstallRoot) {
        throw 'committed self-uninstall recovery found canonical InstallRoot'
    }
    if (Microsoft.PowerShell.Management\Test-Path `
        -LiteralPath $Layout.MetadataPath `
        -PathType Leaf) {
        $metadata = Get-DefenseClawDeploymentMetadata -Layout $Layout -Required
        Assert-DefenseClawMetadataIdentity `
            -Metadata $metadata `
            -GatewayServiceName $GatewayServiceName `
            -GuardianServiceName $GuardianServiceName
        if (Test-DefenseClawMetadataInstalled -Metadata $metadata) {
            throw 'committed self-uninstall recovery found installed metadata'
        }
        $actualTombstoneHash = (
            Microsoft.PowerShell.Utility\Get-FileHash `
                -LiteralPath $Layout.MetadataPath `
                -Algorithm SHA256
        ).Hash.ToLowerInvariant()
        if ($actualTombstoneHash -cne [string]$Receipt.tombstone_sha256) {
            throw 'committed self-uninstall recovery found changed tombstone'
        }
    }
    elseif (-not $AllowPurgedState -or
        -not [bool]$Receipt.purge_requested -or
        (Microsoft.PowerShell.Management\Test-Path `
            -LiteralPath $Layout.StateRoot)) {
        throw 'committed self-uninstall recovery is missing its authenticated tombstone'
    }
}

function Move-DefenseClawRetiredInstallTreeBack {
    param(
        [Parameter(Mandatory)][hashtable]$Layout,
        [Parameter(Mandatory)]$Receipt
    )
    $retired = [string]$Receipt.retired_install_root
    Assert-DefenseClawRetiredInstallTree `
        -Layout $Layout `
        -RetiredRoot $retired `
        -SkipAclValidation
    if (Microsoft.PowerShell.Management\Test-Path `
        -LiteralPath $Layout.InstallRoot) {
        throw 'cannot restore retired InstallRoot because canonical root already exists'
    }
    [IO.Directory]::Move($retired, $Layout.InstallRoot)
    Assert-DefenseClawNoReparsePath -Path $Layout.InstallRoot
}

function Add-DefenseClawSelfUninstallResult {
    param(
        [Parameter(Mandatory)]$Result,
        [Parameter(Mandatory)][hashtable]$Layout,
        [Parameter(Mandatory)]$Receipt,
        [bool]$CleanupPending
    )
    foreach ($entry in @(
        @('cached_enterprise_clients_require_reload', $true),
        @('self_uninstall_cleanup_pending', [bool]$CleanupPending),
        @('canonical_install_root_absent', [bool](
            -not (Microsoft.PowerShell.Management\Test-Path `
                -LiteralPath $Layout.InstallRoot)
        )),
        @('self_uninstall_receipt_path', [string]$Layout.SelfUninstallReceiptPath),
        @('self_uninstall_helper_path', [string]$Layout.SelfUninstallHelperPath),
        @(
            'self_uninstall_environment_root',
            [string]$Layout.SelfUninstallEnvironmentRoot
        ),
        @('retired_install_root', [string]$Receipt.retired_install_root)
    )) {
        $Result |
            Microsoft.PowerShell.Utility\Add-Member `
                -MemberType NoteProperty `
                -Name ([string]$entry[0]) `
                -Value $entry[1] `
                -Force
    }
    return $Result
}

function Add-DefenseClawUserRegistrationCleanupResult {
    # A standalone finalize removes DefenseClaw's own registrations from users'
    # agent configurations, as each user, and reports the users it could not
    # reach (signed out, or an uninstall not run as LocalSystem). The uninstall
    # result carries that report so the administrator sees what stays. Secure
    # Client results are unchanged.
    param(
        [Parameter(Mandatory)]$Result,
        [Parameter(Mandatory)][hashtable]$Layout,
        [AllowNull()]$Finalization
    )
    if ((Test-DefenseClawLayoutBrokerEnabled -Layout $Layout)) {
        return $Result
    }
    $report = $null
    foreach ($candidate in @($Finalization)) {
        if ($null -ne $candidate -and
            $null -ne $candidate.PSObject.Properties['action']) {
            $report = $candidate
        }
    }
    $removed = [int64]0
    $lists = [ordered]@{
        user_registrations_pending = [string[]]@()
        user_registrations_failed = [string[]]@()
    }
    if ($null -ne $report) {
        $property = $report.PSObject.Properties['user_registrations_removed']
        if ($null -ne $property -and
            $property.Value -isnot [bool] -and
            $property.Value -is [ValueType]) {
            $removed = [Math]::Max(
                [int64]0,
                [Math]::Min([int64]100000, [int64]$property.Value)
            )
        }
        foreach ($name in @($lists.Keys)) {
            $property = $report.PSObject.Properties[$name]
            if ($null -eq $property -or $null -eq $property.Value) {
                continue
            }
            $lists[$name] = [string[]]@(
                @($property.Value) |
                    Microsoft.PowerShell.Utility\Select-Object -First 4096 |
                    Microsoft.PowerShell.Core\ForEach-Object {
                        ConvertTo-DefenseClawBoundedDiagnostic `
                            -Value ([string]$_) `
                            -MaxLength 1024
                    }
            )
        }
    }
    $Result |
        Microsoft.PowerShell.Utility\Add-Member `
            -MemberType NoteProperty `
            -Name user_registrations_removed `
            -Value $removed `
            -Force
    foreach ($name in @($lists.Keys)) {
        $Result |
            Microsoft.PowerShell.Utility\Add-Member `
                -MemberType NoteProperty `
                -Name $name `
                -Value $lists[$name] `
                -Force
    }
    # The standalone finalize names each enrolled account's per-user folder
    # that stays (with purge, each one it could not remove and why) and,
    # with purge, each account whose per-user data and binaries it removed;
    # each user settings file it edited (#1290) and each hook command a
    # user's Claude Code settings keep that still names a DefenseClaw
    # launcher (#1286).
    foreach ($name in @(
            'user_state_remaining',
            'user_state_purged',
            'user_settings_edited',
            'user_settings_hooks_left'
        )) {
        $state = $null
        if ($null -ne $report) {
            $state = $report.PSObject.Properties[$name]
        }
        if ($null -eq $state -or $null -eq $state.Value) {
            continue
        }
        $Result |
            Microsoft.PowerShell.Utility\Add-Member `
                -MemberType NoteProperty `
                -Name $name `
                -Value ([string[]]@(
                    @($state.Value) |
                        Microsoft.PowerShell.Utility\Select-Object -First 4096 |
                        Microsoft.PowerShell.Core\ForEach-Object {
                            ConvertTo-DefenseClawBoundedDiagnostic `
                                -Value ([string]$_) `
                                -MaxLength 1024
                        }
                )) `
                -Force
    }
    # A machine folder the finalize kept, such as the LocalSystem Claude Code
    # settings cleanup folder while it holds an unfinished cleanup, joins
    # machine_state_remaining (sidecar-r107:GAP-0007).
    $machine = $null
    if ($null -ne $report) {
        $machine = $report.PSObject.Properties['machine_state_remaining']
    }
    if ($null -ne $machine -and $null -ne $machine.Value) {
        $existing = $Result.PSObject.Properties['machine_state_remaining']
        $Result |
            Microsoft.PowerShell.Utility\Add-Member `
                -MemberType NoteProperty `
                -Name machine_state_remaining `
                -Value ([string[]]@(
                    @(if ($null -ne $existing -and $null -ne $existing.Value) { @($existing.Value) }) +
                    @(@($machine.Value) |
                        Microsoft.PowerShell.Utility\Select-Object -First 4096 |
                        Microsoft.PowerShell.Core\ForEach-Object {
                            ConvertTo-DefenseClawBoundedDiagnostic `
                                -Value ([string]$_) `
                                -MaxLength 1024
                        })
                )) `
                -Force
    }
    return $Result
}

function Add-DefenseClawUninstallContractResult {
    param([Parameter(Mandatory)]$Result)
    $Result |
        Microsoft.PowerShell.Utility\Add-Member `
            -MemberType NoteProperty `
            -Name cached_enterprise_clients_require_reload `
            -Value $true `
            -Force
    return $Result
}

function Invoke-DefenseClawSelfUninstallRecovery {
    param(
        [Parameter(Mandatory)][string]$Action,
        [Parameter(Mandatory)][hashtable]$Layout,
        [Parameter(Mandatory)][string]$GatewayServiceName,
        [Parameter(Mandatory)][string]$GuardianServiceName,
        [switch]$Purge,
        [int]$SelfUninstallCallerPID
    )
    $receipt = Get-DefenseClawSelfUninstallReceipt `
        -Layout $Layout `
        -GatewayServiceName $GatewayServiceName `
        -GuardianServiceName $GuardianServiceName
    if ($null -eq $receipt) {
        return [pscustomobject]@{
            handled = $false
            result = $null
        }
    }
    $reboundCaller = $false
    $finalization = $null
    $canonicalExists = Microsoft.PowerShell.Management\Test-Path `
        -LiteralPath $Layout.InstallRoot `
        -PathType Container
    $retiredExists = Microsoft.PowerShell.Management\Test-Path `
        -LiteralPath ([string]$receipt.retired_install_root) `
        -PathType Container
    if ($canonicalExists -and $retiredExists) {
        throw 'self-uninstall recovery found both canonical and retired InstallRoot'
    }
    $pendingExists = Microsoft.PowerShell.Management\Test-Path `
        -LiteralPath $Layout.PendingPath `
        -PathType Leaf
    if ([string]$receipt.phase -ceq 'prepared_install_retirement' -and
        $pendingExists) {
        if ($retiredExists) {
            Move-DefenseClawRetiredInstallTreeBack `
                -Layout $Layout `
                -Receipt $receipt
        }
        elseif ($canonicalExists) {
            Assert-DefenseClawManagedInstallTree -Layout $Layout
        }
        # If neither tree exists, the authenticated transaction snapshot still
        # owns exact file restoration. Retire only the independent rename
        # evidence, then let generic pending recovery recreate its allowlist.
        Remove-DefenseClawSelfUninstallEvidence `
            -Layout $Layout `
            -Receipt $receipt
        return [pscustomobject]@{
            handled = $false
            result = $null
        }
    }
    if ([string]$receipt.phase -ceq 'prepared_install_retirement') {
        if ($canonicalExists) {
            if ($retiredExists) {
                throw 'prepared self-uninstall recovery found both canonical and retired InstallRoot'
            }
            $metadata = Get-DefenseClawDeploymentMetadata `
                -Layout $Layout `
                -Required
            Assert-DefenseClawMetadataIdentity `
                -Metadata $metadata `
                -GatewayServiceName $GatewayServiceName `
                -GuardianServiceName $GuardianServiceName
            if (Test-DefenseClawMetadataInstalled -Metadata $metadata) {
                throw 'prepared self-uninstall recovery found installed metadata after transaction commit'
            }
            $actualTombstoneHash = (
                Microsoft.PowerShell.Utility\Get-FileHash `
                    -LiteralPath $Layout.MetadataPath `
                    -Algorithm SHA256
            ).Hash.ToLowerInvariant()
            if ($actualTombstoneHash -cne [string]$receipt.tombstone_sha256) {
                throw 'prepared self-uninstall recovery found changed tombstone'
            }
            # A standalone retry by the installed CLI after the first caller
            # exited (its rename of InstallRoot failed, GAP-1684) now runs
            # from InstallRoot itself. Bind the receipt to it so the detached
            # finalizer waits for it instead of deleting its running image.
            if ($SelfUninstallCallerPID -gt 0 -and
                $Action -eq 'Uninstall' -and
                (Test-DefenseClawStandaloneProfile) -and
                -not (Test-DefenseClawSelfUninstallCallerRunning `
                    -Layout $Layout `
                    -Receipt $receipt)) {
                $receipt = Set-DefenseClawSelfUninstallReceiptCaller `
                    -Layout $Layout `
                    -GatewayServiceName $GatewayServiceName `
                    -GuardianServiceName $GuardianServiceName `
                    -Receipt $receipt `
                    -CallerPID $SelfUninstallCallerPID
                $reboundCaller = $true
            }
            $finalization = Complete-DefenseClawCommittedManagedHooksFinalization `
                -Layout $Layout `
                -GatewayServiceName $GatewayServiceName `
                -GuardianServiceName $GuardianServiceName `
                -Purge:([bool]$receipt.purge_requested)
            $retiredRoot = [string]$receipt.retired_install_root
            Move-DefenseClawInstallRootForRetirement -Source $Layout.InstallRoot -Destination $retiredRoot
            if ((Microsoft.PowerShell.Management\Test-Path `
                    -LiteralPath $Layout.InstallRoot) -or
                -not (Microsoft.PowerShell.Management\Test-Path `
                    -LiteralPath $retiredRoot `
                    -PathType Container)) {
                throw 'self-uninstall recovery could not retire canonical InstallRoot'
            }
            Set-DefenseClawRetiredInstallTreeAcls `
                -Layout $Layout `
                -RetiredRoot $retiredRoot
            $canonicalExists = $false
            $retiredExists = $true
        }
        Assert-DefenseClawSelfUninstallCommittedState `
            -Layout $Layout `
            -GatewayServiceName $GatewayServiceName `
            -GuardianServiceName $GuardianServiceName `
            -Receipt $receipt
        if ($retiredExists) {
            [void](Remove-DefenseClawCommittedManagedHooksTeardownJournal `
                -Layout $Layout `
                -GatewayServiceName $GatewayServiceName `
                -GuardianServiceName $GuardianServiceName)
            $receipt = Set-DefenseClawSelfUninstallReceiptCommitted `
                -Layout $Layout `
                -GatewayServiceName $GatewayServiceName `
                -GuardianServiceName $GuardianServiceName
        }
        else {
            Remove-DefenseClawSelfUninstallEvidence `
                -Layout $Layout `
                -Receipt $receipt
            return [pscustomobject]@{
                handled = $false
                result = $null
            }
        }
    }
    Assert-DefenseClawSelfUninstallCommittedState `
        -Layout $Layout `
        -GatewayServiceName $GatewayServiceName `
        -GuardianServiceName $GuardianServiceName `
        -Receipt $receipt `
        -AllowPurgedState
    if ($retiredExists) {
        if (Test-DefenseClawSelfUninstallCallerRunning `
            -Layout $Layout `
            -Receipt $receipt) {
            [void](Ensure-DefenseClawSelfUninstallHelper `
                -Layout $Layout `
                -Receipt $receipt)
            [void](Start-DefenseClawSelfUninstallHelper `
                -Layout $Layout `
                -Receipt $receipt)
            if ($Action -ne 'Uninstall') {
                throw (
                    'an authenticated self-uninstall cleanup is waiting for ' +
                    "the installed CLI to exit; retry $Action after it exits"
                )
            }
            if ($reboundCaller) {
                # The retry finishes what the first run left: the committed
                # cleanup, and for standalone the machine-state purge.
                $result = Invoke-DefenseClawCommittedUninstallCleanup `
                    -Layout $Layout `
                    -GatewayServiceName $GatewayServiceName `
                    -GuardianServiceName $GuardianServiceName `
                    -Purge:$Purge
                if ($null -ne $finalization) {
                    $result = Add-DefenseClawUserRegistrationCleanupResult `
                        -Result $result `
                        -Layout $Layout `
                        -Finalization $finalization
                }
            }
            else {
                $result = Get-DefenseClawLifecycleStatus `
                    -Action 'Uninstall' `
                    -Layout $Layout `
                    -GatewayServiceName $GatewayServiceName `
                    -GuardianServiceName $GuardianServiceName
            }
            if ([bool]$receipt.purge_requested -and
                -not (Microsoft.PowerShell.Management\Test-Path `
                    -LiteralPath $Layout.StateRoot)) {
                $result |
                    Microsoft.PowerShell.Utility\Add-Member `
                        -MemberType NoteProperty `
                        -Name purged `
                        -Value $true `
                        -Force
            }
            $result = Add-DefenseClawSelfUninstallResult `
                -Result $result `
                -Layout $Layout `
                -Receipt $receipt `
                -CleanupPending:$true
            return [pscustomobject]@{
                handled = $true
                result = $result
            }
        }
        Remove-DefenseClawRetiredInstallTree `
            -Layout $Layout `
            -Receipt $receipt
    }
    Remove-DefenseClawSelfUninstallEvidence `
        -Layout $Layout `
        -Receipt $receipt
    # Only an Uninstall reports the finished purge as its result. Any other
    # action continues on the now-empty host: an Install that returned the
    # purge result here reported ok with nothing installed (GAP-1079).
    if ($Action -eq 'Uninstall' -and
        [bool]$receipt.purge_requested -and
        -not (Microsoft.PowerShell.Management\Test-Path `
            -LiteralPath $Layout.StateRoot)) {
        $result = Get-DefenseClawLifecycleStatus `
            -Action 'Uninstall' `
            -Layout $Layout `
            -GatewayServiceName $GatewayServiceName `
            -GuardianServiceName $GuardianServiceName
        $result |
            Microsoft.PowerShell.Utility\Add-Member `
                -MemberType NoteProperty `
                -Name purged `
                -Value $true `
                -Force
        $result = Add-DefenseClawUninstallContractResult -Result $result
        return [pscustomobject]@{
            handled = $true
            result = $result
        }
    }
    return [pscustomobject]@{
        handled = $false
        result = $null
    }
}

# Writes the finalizer of a prepared receipt and records its hash in the
# receipt, so the finalizer can start before the InstallRoot retirement it
# finishes.
function Set-DefenseClawSelfUninstallReceiptHelper {
    param(
        [Parameter(Mandatory)][hashtable]$Layout,
        [Parameter(Mandatory)][string]$GatewayServiceName,
        [Parameter(Mandatory)][string]$GuardianServiceName
    )
    $receipt = Get-DefenseClawSelfUninstallReceipt `
        -Layout $Layout `
        -GatewayServiceName $GatewayServiceName `
        -GuardianServiceName $GuardianServiceName `
        -Required
    if ([string]$receipt.phase -cne 'prepared_install_retirement') {
        throw 'only a prepared self-uninstall receipt can defer its InstallRoot retirement'
    }
    [void](Ensure-DefenseClawSelfUninstallHelper `
        -Layout $Layout `
        -Receipt $receipt `
        -DeferredRetirement)
    Write-DefenseClawJsonAtomic `
        -Value $receipt `
        -Path $Layout.SelfUninstallReceiptPath
    Set-DefenseClawPathAcl `
        -Path $Layout.SelfUninstallReceiptPath `
        -Kind AdminFile `
        -GatewayServiceSID $script:AdministratorsSID
    return Get-DefenseClawSelfUninstallReceipt `
        -Layout $Layout `
        -GatewayServiceName $GatewayServiceName `
        -GuardianServiceName $GuardianServiceName `
        -Required
}

# The committed uninstall whose InstallRoot a program still held after the
# commit (Invoke-DefenseClawCommittedInstallRootRetirement). The services and
# hooks are gone and the tombstone is written; what is left is the retirement
# of InstallRoot and the committed cleanup (with purge when it was
# requested). The receipt stays prepared and the teardown journal stays (its
# finalized phase tells the retirement the hooks are already removed), and
# the detached finalizer is started: once the CLI exits it retires
# InstallRoot when the program lets go, runs that cleanup, and removes the
# retired tree. A finalizer that runs out of time leaves the receipt, and
# the next Uninstall finishes the same work. The result is a retryable
# uninstall_in_use failure, never ok: InstallRoot (and with purge the
# purge) is still there when the CLI exits, and nothing it can wait for
# confirms that the finalizer finishes them. An ok result let an
# exit-code-driven manager stop retrying (W2B-G-win review, loop round 2).
function Start-DefenseClawDeferredSelfUninstallRetirement {
    param(
        [Parameter(Mandatory)][hashtable]$Layout,
        [Parameter(Mandatory)][string]$GatewayServiceName,
        [Parameter(Mandatory)][string]$GuardianServiceName,
        [AllowNull()]$Finalization,
        [Parameter(Mandatory)][string]$Reason
    )
    try {
        $receipt = Set-DefenseClawSelfUninstallReceiptHelper `
            -Layout $Layout `
            -GatewayServiceName $GatewayServiceName `
            -GuardianServiceName $GuardianServiceName
        [void](Start-DefenseClawSelfUninstallHelper `
            -Layout $Layout `
            -Receipt $receipt)
    }
    catch {
        throw (
            'Uninstall committed, but a program still holds a file in InstallRoot and the detached cleanup ' +
            "could not start; protected recovery state was retained, retry Uninstall: $($_.Exception.Message)"
        )
    }
    $result = Get-DefenseClawLifecycleStatus `
        -Action 'Uninstall' `
        -Layout $Layout `
        -GatewayServiceName $GatewayServiceName `
        -GuardianServiceName $GuardianServiceName
    $result = Add-DefenseClawUserRegistrationCleanupResult `
        -Result $result `
        -Layout $Layout `
        -Finalization $Finalization
    $result |
        Microsoft.PowerShell.Utility\Add-Member `
            -MemberType NoteProperty `
            -Name install_root_retirement_deferred `
            -Value (ConvertTo-DefenseClawBoundedDiagnostic -Value (
                "a program holds a file in $($Layout.InstallRoot) ($Reason); the detached cleanup " +
                'removes it, and finishes the uninstall cleanup, once that program closes it'
            )) `
            -Force
    $purge = [bool]$receipt.purge_requested
    $finish = if ($purge) { 'the uninstall cleanup and the purge' } else { 'the uninstall cleanup' }
    $rerun = if ($purge) { 'run the uninstall with PURGE=1 again' } else { 'run the uninstall again' }
    $inUse = ConvertTo-DefenseClawBoundedDiagnostic -Value (
        "uninstall_in_use: a program holds a file in $($Layout.InstallRoot) ($Reason), so the uninstall " +
        'could not remove that folder. DefenseClaw is already uninstalled (its services and hooks are removed); ' +
        "a cleanup that starts when this command exits removes the folder and finishes $finish once that " +
        "program closes the file. Close the program, then $rerun to confirm that it finished"
    )
    $errorsProperty = $result.PSObject.Properties['errors']
    $errors = [Collections.Generic.List[string]]::new()
    if ($null -ne $errorsProperty) {
        foreach ($message in @($errorsProperty.Value)) {
            if (-not [string]::IsNullOrWhiteSpace([string]$message)) {
                $errors.Add([string]$message)
            }
        }
    }
    $errors.Add($inUse)
    $result |
        Microsoft.PowerShell.Utility\Add-Member `
            -MemberType NoteProperty `
            -Name ok `
            -Value $false `
            -Force
    $result |
        Microsoft.PowerShell.Utility\Add-Member `
            -MemberType NoteProperty `
            -Name errors `
            -Value ([string[]]$errors.ToArray()) `
            -Force
    return Add-DefenseClawSelfUninstallResult `
        -Result $result `
        -Layout $Layout `
        -Receipt $receipt `
        -CleanupPending:$true
}

# What a deferred retirement checks before it renames InstallRoot: the
# uninstall committed (no pending transaction, no service, the receipt's own
# tombstone).
function Assert-DefenseClawDeferredRetirementState {
    param(
        [Parameter(Mandatory)][hashtable]$Layout,
        [Parameter(Mandatory)]$Receipt
    )
    if (Microsoft.PowerShell.Management\Test-Path -LiteralPath $Layout.PendingPath) {
        throw 'deferred self-uninstall retirement found pending transaction evidence'
    }
    foreach ($name in @(Get-DefenseClawManagedServiceNames `
            -GatewayServiceName ([string]$Receipt.gateway_service) `
            -GuardianServiceName ([string]$Receipt.guardian_service))) {
        if (Test-DefenseClawServiceExists -Name $name) {
            throw "deferred self-uninstall retirement found live service: $name"
        }
    }
    $metadata = Get-DefenseClawDeploymentMetadata -Layout $Layout -Required
    [void](Assert-DefenseClawMetadataIdentity `
        -Metadata $metadata `
        -GatewayServiceName ([string]$Receipt.gateway_service) `
        -GuardianServiceName ([string]$Receipt.guardian_service))
    if (Test-DefenseClawMetadataInstalled -Metadata $metadata) {
        throw 'deferred self-uninstall retirement found installed metadata'
    }
    $tombstoneHash = (
        Microsoft.PowerShell.Utility\Get-FileHash `
            -LiteralPath $Layout.MetadataPath `
            -Algorithm SHA256
    ).Hash.ToLowerInvariant()
    if ($tombstoneHash -cne [string]$Receipt.tombstone_sha256) {
        throw 'deferred self-uninstall retirement found a changed tombstone'
    }
}

# What the committed uninstall does after it renamed InstallRoot aside, in
# its order, for a deferred retirement: protect the retired tree, retire the
# teardown journal, commit the receipt, then the committed cleanup.
function Complete-DefenseClawRetiredSelfUninstallCommit {
    param(
        [Parameter(Mandatory)][hashtable]$Layout,
        [Parameter(Mandatory)]$Receipt
    )
    $gatewayServiceName = [string]$Receipt.gateway_service
    $guardianServiceName = [string]$Receipt.guardian_service
    [void](Set-DefenseClawRetiredInstallTreeAcls `
        -Layout $Layout `
        -RetiredRoot ([string]$Receipt.retired_install_root))
    [void](Remove-DefenseClawCommittedManagedHooksTeardownJournal `
        -Layout $Layout `
        -GatewayServiceName $gatewayServiceName `
        -GuardianServiceName $guardianServiceName)
    [void](Set-DefenseClawSelfUninstallReceiptCommitted `
        -Layout $Layout `
        -GatewayServiceName $gatewayServiceName `
        -GuardianServiceName $guardianServiceName)
    [void](Invoke-DefenseClawCommittedUninstallCleanup `
        -Layout $Layout `
        -GatewayServiceName $gatewayServiceName `
        -GuardianServiceName $guardianServiceName `
        -Purge:([bool]$Receipt.purge_requested))
}

# The deferred half of a self-uninstall (Start-DefenseClawDeferredSelfUninstallRetirement),
# run by its finalizer once the CLI exited. Under the lifecycle lock it
# renames InstallRoot aside once, and on a holder waits outside the lock and
# tries again until Deadline. It returns 'retired' when InstallRoot is
# retired and the committed cleanup ran (the retired tree is removed next),
# 'not_deferred' when another run retired it first, and 'finished' when
# another run finished the whole receipt.
function Complete-DefenseClawDeferredSelfUninstallRetirement {
    param(
        [Parameter(Mandatory)][hashtable]$Layout,
        [Parameter(Mandatory)]$Receipt,
        [Parameter(Mandatory)][DateTime]$Deadline,
        [ValidateRange(50, 60000)][int]$RetryIntervalMilliseconds = 1000
    )
    $gatewayServiceName = [string]$Receipt.gateway_service
    $guardianServiceName = [string]$Receipt.guardian_service
    while ($true) {
        $inUse = $null
        $lock = Enter-DefenseClawLifecycleLock -Layout $Layout
        try {
            $current = Get-DefenseClawSelfUninstallReceipt `
                -Layout $Layout `
                -GatewayServiceName $gatewayServiceName `
                -GuardianServiceName $guardianServiceName
            if ($null -eq $current) {
                return 'finished'
            }
            if ([string]$current.phase -cne 'prepared_install_retirement' -or
                -not (Microsoft.PowerShell.Management\Test-Path `
                    -LiteralPath $Layout.InstallRoot `
                    -PathType Container)) {
                return 'not_deferred'
            }
            if (Test-DefenseClawSelfUninstallCallerRunning `
                -Layout $Layout `
                -Receipt $current) {
                throw 'self-uninstall finalizer refuses the deferred InstallRoot retirement while exact caller identity is running'
            }
            [void](Assert-DefenseClawDeferredRetirementState -Layout $Layout -Receipt $current)
            # The hooks were removed before the commit; this returns at once
            # on the finalized journal, after it checked the InstallRoot tree
            # and the recorded artifacts.
            [void](Complete-DefenseClawCommittedManagedHooksFinalization `
                -Layout $Layout `
                -GatewayServiceName $gatewayServiceName `
                -GuardianServiceName $guardianServiceName `
                -Purge:([bool]$current.purge_requested))
            $retiredRoot = [string]$current.retired_install_root
            if (Microsoft.PowerShell.Management\Test-Path -LiteralPath $retiredRoot) {
                throw 'deferred self-uninstall retirement found both canonical and retired InstallRoot'
            }
            Assert-DefenseClawInstallRootNameReserved -InstallRoot $Layout.InstallRoot
            try {
                [IO.Directory]::Move($Layout.InstallRoot, $retiredRoot)
            }
            catch {
                if (-not (Test-DefenseClawInstallRootInUseException -Exception $_.Exception)) {
                    throw
                }
                $inUse = $_
            }
            if ($null -ne $inUse) {
                # A deny entry set since the deferral does not end when the
                # holder exits: stop now, not at the deadline.
                $denial = Get-DefenseClawInstallRootRenameDenial -Source $Layout.InstallRoot -Destination $retiredRoot
                if (-not [string]::IsNullOrEmpty($denial)) {
                    throw (
                        "the deferred self-uninstall retirement stopped: Windows refused to rename InstallRoot " +
                        "($($inUse.Exception.Message)) and $denial; remove that deny entry, then run the uninstall again"
                    )
                }
            }
            if ($null -eq $inUse) {
                if ((Microsoft.PowerShell.Management\Test-Path -LiteralPath $Layout.InstallRoot) -or
                    -not (Microsoft.PowerShell.Management\Test-Path -LiteralPath $retiredRoot -PathType Container)) {
                    throw 'deferred self-uninstall InstallRoot retirement did not complete exactly'
                }
                [void](Complete-DefenseClawRetiredSelfUninstallCommit -Layout $Layout -Receipt $current)
                return 'retired'
            }
        }
        finally {
            [void](Exit-DefenseClawLifecycleLock -Lock $lock)
        }
        if ([DateTime]::UtcNow -ge $Deadline) {
            throw (
                'a program still holds a file in InstallRoot, so the deferred self-uninstall retirement ' +
                "stopped; the next Uninstall finishes it: $($inUse.Exception.Message)"
            )
        }
        Microsoft.PowerShell.Utility\Start-Sleep -Milliseconds $RetryIntervalMilliseconds
    }
}

# Whether a self-uninstall finalizer drops the lifecycle lock as it exits:
# only once its receipt is gone, and when it ran a standalone purge itself
# (a deferred retirement) or no deployment is left. A CLI uninstall runs
# its purge in the CLI's own run, which keeps the lock because the CLI's
# running image still holds InstallRoot; the finalizer removes that last
# root, so the lock goes then, as after every standalone uninstall that
# leaves no deployment (GAP-1897).
function Test-DefenseClawSelfUninstallFinalizerDropsLifecycleLock {
    param([Parameter(Mandatory)][hashtable]$Layout)
    if (Microsoft.PowerShell.Management\Test-Path -LiteralPath ([string]$Layout.SelfUninstallReceiptPath)) {
        return $false
    }
    return ([bool]$script:DefenseClawRemoveLifecycleLockOnExit -or
        (Test-DefenseClawStandaloneUninstallLeftNothing -Action 'Uninstall' -Layout $Layout))
}

function Complete-DefenseClawSelfUninstallRetirement {
    param(
        [Parameter(Mandatory)][string]$ReceiptPath,
        [switch]$WaitForCallerExit,
        [ValidateRange(1, 900)]
        [int]$CleanupTimeoutSeconds = 300
    )
    Assert-DefenseClawAdministrator
    $fullReceiptPath = Assert-DefenseClawCanonicalVolumePath `
        -Path $ReceiptPath `
        -Label 'self-uninstall finalizer receipt'
    # The receipt's own protected directory names the profile whose
    # transaction wrote it; a detached finalizer has no other authority.
    $receiptProfile = Resolve-DefenseClawProfileFromLifecycleDirectory `
        -Directory ([IO.Path]::GetDirectoryName($fullReceiptPath))
    if ([string]::IsNullOrWhiteSpace($receiptProfile)) {
        throw 'self-uninstall finalizer receipt path is outside the exact protected lifecycle namespace'
    }
    Set-DefenseClawEnterpriseProfile -EnterpriseProfile $receiptProfile
    $expectedLifecycleDirectory = [string](Get-DefenseClawProfileRoots).LifecycleDirectory
    if (-not [string]::Equals(
            [IO.Path]::GetDirectoryName($fullReceiptPath),
            $expectedLifecycleDirectory,
            [StringComparison]::OrdinalIgnoreCase
        ) -or
        [IO.Path]::GetFileName($fullReceiptPath) -cnotmatch
            '^self-uninstall-[0-9a-f]{64}\.json$') {
        throw 'self-uninstall finalizer receipt path is outside the exact protected lifecycle namespace'
    }
    Assert-DefenseClawNoReparsePath -Path $fullReceiptPath
    [void](Assert-DefenseClawCanonicalVolumePath `
        -Path $fullReceiptPath `
        -Label 'self-uninstall finalizer receipt')
    $bootstrapReceipt = Microsoft.PowerShell.Management\Get-Content `
        -LiteralPath $fullReceiptPath `
        -Raw | Microsoft.PowerShell.Utility\ConvertFrom-Json
    $layout = Get-DefenseClawLayout `
        -InstallRoot ([string]$bootstrapReceipt.install_root) `
        -StateRoot ([string]$bootstrapReceipt.state_root) `
        -GatewayServiceName ([string]$bootstrapReceipt.gateway_service) `
        -GuardianServiceName ([string]$bootstrapReceipt.guardian_service)
    if (-not [string]::Equals(
            $fullReceiptPath,
            [string]$layout.SelfUninstallReceiptPath,
            [StringComparison]::OrdinalIgnoreCase
        )) {
        throw 'self-uninstall finalizer receipt path does not match its authenticated scope'
    }
    $receipt = Get-DefenseClawSelfUninstallReceipt `
        -Layout $layout `
        -GatewayServiceName ([string]$bootstrapReceipt.gateway_service) `
        -GuardianServiceName ([string]$bootstrapReceipt.guardian_service) `
        -Required
    $loadedModulePath = [IO.Path]::GetFullPath(
        [string]$MyInvocation.MyCommand.Module.Path
    ).TrimEnd('\')
    $expectedModulePath = [IO.Path]::GetFullPath(
        (
            Microsoft.PowerShell.Management\Join-Path `
                ([string]$receipt.retired_install_root) `
                'libexec\DefenseClawEnterprise.psm1'
        )
    ).TrimEnd('\')
    # The finalizer of a deferred InstallRoot retirement runs the same module
    # (the receipt's hash) from InstallRoot until it retires it.
    $canonicalModulePath = [IO.Path]::GetFullPath(
        (
            Microsoft.PowerShell.Management\Join-Path `
                ([string]$receipt.install_root) `
                'libexec\DefenseClawEnterprise.psm1'
        )
    ).TrimEnd('\')
    $deferredRetirement = (
        [string]$receipt.phase -ceq 'prepared_install_retirement' -and
        [string]::Equals(
            $loadedModulePath,
            $canonicalModulePath,
            [StringComparison]::OrdinalIgnoreCase
        )
    )
    if ((-not $deferredRetirement -and
            -not [string]::Equals(
                $loadedModulePath,
                $expectedModulePath,
                [StringComparison]::OrdinalIgnoreCase
            )) -or
        (
            Microsoft.PowerShell.Utility\Get-FileHash `
                -LiteralPath $loadedModulePath `
                -Algorithm SHA256
        ).Hash.ToLowerInvariant() -cne
            [string]$receipt.retired_module_sha256) {
        throw 'self-uninstall finalizer is not running the exact receipt-bound retired module'
    }
    if ($WaitForCallerExit) {
        Wait-DefenseClawSelfUninstallCallerExit `
            -Layout $layout `
            -Receipt $receipt
    }
    $cleanupDeadline = [DateTime]::UtcNow.AddSeconds(
        $CleanupTimeoutSeconds
    )
    if ($deferredRetirement -and
        (Complete-DefenseClawDeferredSelfUninstallRetirement `
            -Layout $layout `
            -Receipt $receipt `
            -Deadline $cleanupDeadline) -ceq 'finished') {
        return
    }
    $retryDelayMilliseconds = 200
    while ($true) {
        $cleanupFailure = $null
        $lock = Enter-DefenseClawLifecycleLock -Layout $layout
        try {
            Assert-DefenseClawLayoutVolumeIdentity `
                -Layout $layout `
                -GatewayServiceName ([string]$receipt.gateway_service) `
                -GuardianServiceName ([string]$receipt.guardian_service)
            $receipt = Get-DefenseClawSelfUninstallReceipt `
                -Layout $layout `
                -GatewayServiceName ([string]$receipt.gateway_service) `
                -GuardianServiceName ([string]$receipt.guardian_service) `
                -Required
            if (Test-DefenseClawSelfUninstallCallerRunning `
                -Layout $layout `
                -Receipt $receipt) {
                throw 'self-uninstall finalizer refuses cleanup while exact caller identity is running'
            }
            if ([string]$receipt.phase -ceq
                'prepared_install_retirement') {
                $receipt = Set-DefenseClawSelfUninstallReceiptCommitted `
                    -Layout $layout `
                    -GatewayServiceName ([string]$receipt.gateway_service) `
                    -GuardianServiceName ([string]$receipt.guardian_service)
            }
            Assert-DefenseClawSelfUninstallCommittedState `
                -Layout $layout `
                -GatewayServiceName ([string]$receipt.gateway_service) `
                -GuardianServiceName ([string]$receipt.guardian_service) `
                -Receipt $receipt `
                -AllowPurgedState
            try {
                if (Microsoft.PowerShell.Management\Test-Path `
                    -LiteralPath (
                        [string]$receipt.retired_install_root
                    )) {
                    Remove-DefenseClawRetiredInstallTree `
                        -Layout $layout `
                        -Receipt $receipt
                }
                Remove-DefenseClawSelfUninstallEvidence `
                    -Layout $layout `
                    -Receipt $receipt
                return
            }
            catch {
                $cleanupFailure = $_
                # A sharing violation may leave a valid strict subset of the
                # retired allowlist. Re-authenticate every surviving object
                # while holding the lifecycle lock before allowing a retry.
                # Unexpected content, reparse points, ACL drift, changed
                # receipts, or changed lifecycle state therefore fail closed
                # immediately instead of being treated as transient.
                if (-not (Microsoft.PowerShell.Management\Test-Path `
                        -LiteralPath $layout.SelfUninstallReceiptPath `
                        -PathType Leaf)) {
                    $retiredStillExists =
                        Microsoft.PowerShell.Management\Test-Path `
                            -LiteralPath (
                                [string]$receipt.retired_install_root
                            )
                    $helperStillExists =
                        Microsoft.PowerShell.Management\Test-Path `
                            -LiteralPath $layout.SelfUninstallHelperPath
                    $environmentStillExists =
                        Microsoft.PowerShell.Management\Test-Path `
                            -LiteralPath (
                                $layout.SelfUninstallEnvironmentRoot
                            )
                    if (-not $retiredStillExists -and
                        -not $helperStillExists -and
                        -not $environmentStillExists) {
                        return
                    }
                    throw (
                        'self-uninstall cleanup lost its authenticated ' +
                        'receipt before all authorized objects were retired'
                    )
                }
                $receipt = Get-DefenseClawSelfUninstallReceipt `
                    -Layout $layout `
                    -GatewayServiceName ([string]$receipt.gateway_service) `
                    -GuardianServiceName (
                        [string]$receipt.guardian_service
                    ) `
                    -Required
                Assert-DefenseClawSelfUninstallCommittedState `
                    -Layout $layout `
                    -GatewayServiceName ([string]$receipt.gateway_service) `
                    -GuardianServiceName (
                        [string]$receipt.guardian_service
                    ) `
                    -Receipt $receipt `
                    -AllowPurgedState
                if (Test-DefenseClawSelfUninstallCallerRunning `
                    -Layout $layout `
                    -Receipt $receipt) {
                    throw (
                        'self-uninstall caller identity reappeared during ' +
                        'bounded final cleanup'
                    )
                }
                if (Microsoft.PowerShell.Management\Test-Path `
                    -LiteralPath (
                        [string]$receipt.retired_install_root
                    )) {
                    Assert-DefenseClawRetiredInstallTree `
                        -Layout $layout `
                        -RetiredRoot (
                            [string]$receipt.retired_install_root
                        )
                }
                if (Microsoft.PowerShell.Management\Test-Path `
                    -LiteralPath $layout.SelfUninstallHelperPath) {
                    [void](Assert-DefenseClawSelfUninstallHelper `
                        -Layout $layout `
                        -Receipt $receipt)
                }
                if (Microsoft.PowerShell.Management\Test-Path `
                    -LiteralPath $layout.SelfUninstallEnvironmentRoot) {
                    [void](Assert-DefenseClawSelfUninstallEnvironment `
                        -Layout $layout)
                }
            }
        }
        finally {
            Exit-DefenseClawLifecycleLock -Lock $lock
            if (Test-DefenseClawSelfUninstallFinalizerDropsLifecycleLock -Layout $layout) {
                $script:DefenseClawRemoveLifecycleLockOnExit = $false
                # Last: the folders this deployment created, now empty
                # (GAP-0091), C:\Program Files\Cisco once the retired root
                # is gone among them. No result follows this finalizer, so a
                # folder that stays is named in the lifecycle log.
                $script:DefenseClawCreatedFolderLogToLifecycleLog = $true
                try {
                    Remove-DefenseClawStandaloneCreatedFolders -Path @(
                        Remove-DefenseClawStandaloneLifecycleLockLeftover -Layout $layout)
                }
                finally {
                    $script:DefenseClawCreatedFolderLogToLifecycleLog = $false
                }
            }
        }
        if ($null -eq $cleanupFailure) {
            return
        }
        if ([DateTime]::UtcNow -ge $cleanupDeadline) {
            throw (
                'self-uninstall cleanup exceeded its bounded ' +
                "$CleanupTimeoutSeconds-second retry window: " +
                $cleanupFailure.Exception.Message
            )
        }
        # Never hold the lifecycle lock while waiting for a pre-existing
        # standard-user file handle or antivirus scanner to release the tree.
        Microsoft.PowerShell.Utility\Start-Sleep `
            -Milliseconds $retryDelayMilliseconds
        $retryDelayMilliseconds = [Math]::Min(
            $retryDelayMilliseconds * 2,
            2000
        )
    }
}

function Get-DefenseClawManagedHookContractCleanupReceipt {
    param(
        [Parameter(Mandatory)][hashtable]$Layout,
        [Parameter(Mandatory)][string]$GatewayServiceName,
        [Parameter(Mandatory)][string]$GuardianServiceName,
        $Metadata,
        [switch]$Required
    )
    $path = Assert-DefenseClawDescendant `
        -Path $Layout.ManagedHookContractCleanupReceiptPath `
        -Root $Layout.LifecycleLockDirectory `
        -Label 'managed hook contract cleanup receipt'
    if (-not (Microsoft.PowerShell.Management\Test-Path `
            -LiteralPath $path `
            -PathType Leaf)) {
        if ($Required) {
            throw 'protected managed hook contract cleanup receipt is missing'
        }
        return $null
    }
    $receipt = Get-DefenseClawTargetRuntimeExchangeValue `
        -Path $path `
        -TransactionDirectory $Layout.LifecycleLockDirectory
    $schema = $receipt.PSObject.Properties['schema_version']
    $claimsProperty = $receipt.PSObject.Properties['claims']
    if ($null -eq $schema -or $schema.Value -is [bool] -or
        [Convert]::ToInt64($schema.Value) -ne 1 -or
        [string]$receipt.phase -cnotin @('prepared', 'finalized') -or
        [string]$receipt.identity_sha256 -cnotmatch '^sha256:[0-9a-f]{64}$' -or
        [string]$receipt.scope_sha256 -cne [string]$Layout.PurgeScopeSHA256 -or
        [string]$receipt.manifest_sha256 -cnotmatch '^[0-9a-f]{64}$' -or
        [string]$receipt.manifest_fingerprint -cnotmatch '^sha256:[0-9a-f]{64}$' -or
        [string]$receipt.deployment_generation_id -cnotmatch '^[0-9a-f]{32}$' -or
        -not [string]::Equals(
            [string]$receipt.gateway_service_name,
            $GatewayServiceName,
            [StringComparison]::OrdinalIgnoreCase
        ) -or
        $null -eq $claimsProperty -or
        $null -eq $claimsProperty.Value -or
        $claimsProperty.Value -isnot [Array] -or
        @($claimsProperty.Value).Count -gt 384) {
        throw 'protected managed hook contract cleanup receipt has an invalid schema or scope binding'
    }
    $seen = @{}
    foreach ($claim in @($claimsProperty.Value)) {
        $entryPresent = $claim.PSObject.Properties['entry_present']
        $superseded = $claim.PSObject.Properties['superseded']
        $started = $claim.PSObject.Properties['application_started']
        $completed = $claim.PSObject.Properties['completed']
        if ($null -eq $entryPresent -or $entryPresent.Value -isnot [bool] -or
            ($null -ne $superseded -and $superseded.Value -isnot [bool]) -or
            ($null -ne $started -and $started.Value -isnot [bool]) -or
            ($null -ne $completed -and $completed.Value -isnot [bool]) -or
            [string]$claim.connector -cnotin @('claudecode', 'codex', 'cursor') -or
            [string]$claim.sid -cnotmatch '^S-\d-\d+(?:-\d+)+$' -or
            [string]::IsNullOrWhiteSpace([string]$claim.data_dir) -or
            -not [string]::Equals(
                [string]$claim.gateway_service_name,
                $GatewayServiceName,
                [StringComparison]::OrdinalIgnoreCase
            ) -or
            ([bool]$entryPresent.Value -and
                [string]$claim.entry_sha256 -cnotmatch '^sha256:[0-9a-f]{64}$') -or
            (-not [bool]$entryPresent.Value -and
                -not [string]::IsNullOrEmpty([string]$claim.entry_sha256)) -or
            (-not [bool]$entryPresent.Value -and
                $null -ne $started -and [bool]$started.Value) -or
            ($null -ne $superseded -and [bool]$superseded.Value -and
                ([bool]$entryPresent.Value -or
                    ($null -ne $started -and [bool]$started.Value)))) {
            throw 'protected managed hook contract cleanup receipt contains an invalid claim'
        }
        $key = ([string]$claim.connector + [char]0 +
            ([string]$claim.sid).ToUpperInvariant())
        if ($seen.ContainsKey($key)) {
            throw 'protected managed hook contract cleanup receipt contains a duplicate claim'
        }
        $seen[$key] = $true
    }
    if ([string]$receipt.phase -ceq 'finalized') {
        foreach ($claim in @($claimsProperty.Value)) {
            $completed = $claim.PSObject.Properties['completed']
            if ($null -eq $completed -or -not [bool]$completed.Value) {
                throw 'finalized managed hook contract cleanup receipt contains an incomplete claim'
            }
        }
    }
    if ($null -ne $Metadata) {
        Assert-DefenseClawMetadataIdentity `
            -Metadata $Metadata `
            -GatewayServiceName $GatewayServiceName `
            -GuardianServiceName $GuardianServiceName
        $activationProperty = $Metadata.PSObject.Properties[
            'managed_hooks_activation'
        ]
        if ($null -eq $activationProperty -or
            $null -eq $activationProperty.Value) {
            throw 'contract cleanup receipt requires protected activation evidence'
        }
        $activation = Assert-DefenseClawManagedHooksActivationRecord `
            -Record $activationProperty.Value
        # Claims exist only for the contract-lock connectors (claudecode,
        # codex, cursor); per-user plugin connectors of the standalone profile
        # publish no contract lock and are skipped by native capture, which
        # binds every claim to its exact teardown target. The activation
        # count is therefore an upper bound here, not an exact count.
        if ([string]$receipt.manifest_sha256 -cne
                [string]$activation.manifest_sha256 -or
            [string]$receipt.deployment_generation_id -cne
                [string]$activation.deployment_generation_id -or
            @($claimsProperty.Value).Count -gt [int]$activation.target_count) {
            throw 'contract cleanup receipt does not match the inactive deployment tombstone'
        }
    }
    return $receipt
}

function Test-DefenseClawContractCleanupReceiptOfRemovedDeployment {
    <#
        Whether a managed-hook contract cleanup receipt is a prepared receipt
        of a deployment that no longer exists: its deployment generation is
        not the one the protected deployment metadata records. A
        retained-state Install applies its predecessor's receipt before that
        deployment is created, so no lifecycle can use such a receipt. A
        forced or state-absent purge used to leave one in the lifecycle
        folder, and every later uninstall of every new deployment then failed
        "does not match the authenticated retired scope", with a rollback that
        failed "does not match the inactive deployment tombstone" (GAP-0029).
        False when the metadata records no activation: the caller's binding
        check then refuses as before.
    #>
    param(
        [Parameter(Mandatory)]$Receipt,
        [Parameter(Mandatory)]$Metadata
    )
    $activationProperty = $Metadata.PSObject.Properties['managed_hooks_activation']
    if ($null -eq $activationProperty -or $null -eq $activationProperty.Value) {
        return $false
    }
    $activation = Assert-DefenseClawManagedHooksActivationRecord `
        -Record $activationProperty.Value
    return ([string]$Receipt.phase -ceq 'prepared' -and
        [string]$Receipt.deployment_generation_id -cne
            [string]$activation.deployment_generation_id)
}

function Remove-DefenseClawStandaloneOrphanedContractCleanupReceipt {
    <#
        Standalone purge. With StateRoot gone and no state-purge intent
        pending, no lifecycle can authenticate the managed-hook contract
        cleanup receipt or its report in the lifecycle folder: the deployment
        metadata it binds to went with StateRoot. Setup /uninstall FORCE=1
        moves StateRoot aside and so left a prepared receipt there, and every
        later uninstall of a new deployment failed on it (GAP-0029). The purge
        removes both files, never through a link, and returns "path: reason"
        for each one it had to keep.
    #>
    param([Parameter(Mandatory)][hashtable]$Layout)
    if ((Test-DefenseClawPathPresentNoFollow -Path ([string]$Layout.StateRoot)) -or
        (Test-DefenseClawPathPresentNoFollow -Path ([string]$Layout.PurgeIntentPath))) {
        return [string[]]@()
    }
    $kept = [Collections.Generic.List[string]]::new()
    foreach ($candidate in @(
            [string]$Layout.ManagedHookContractCleanupReceiptPath,
            [string]$Layout.ManagedHookContractCleanupReportPath
        )) {
        if ([string]::IsNullOrWhiteSpace($candidate) -or
            -not (Test-DefenseClawPathPresentNoFollow -Path $candidate)) {
            continue
        }
        try {
            $path = Assert-DefenseClawDescendant `
                -Path $candidate `
                -Root ([string]$Layout.LifecycleLockDirectory) `
                -Label 'managed hook contract cleanup receipt'
            Assert-DefenseClawNoReparsePath -Path $path
            if (-not (Microsoft.PowerShell.Management\Test-Path -LiteralPath $path -PathType Leaf)) {
                throw 'it is not a file'
            }
            Microsoft.PowerShell.Management\Remove-Item -LiteralPath $path -Force -ErrorAction Stop
        }
        catch {
            $kept.Add($candidate + ': ' + (ConvertTo-DefenseClawBoundedDiagnostic -Value $_.Exception.Message -MaxLength 256))
        }
    }
    return [string[]]$kept.ToArray()
}

function Remove-DefenseClawManagedHookContractCleanupReceipt {
    param(
        [Parameter(Mandatory)][hashtable]$Layout,
        [Parameter(Mandatory)][string]$GatewayServiceName,
        [Parameter(Mandatory)][string]$GuardianServiceName,
        $Metadata,
        [switch]$AllowPrepared
    )
    $receipt = Get-DefenseClawManagedHookContractCleanupReceipt `
        -Layout $Layout `
        -GatewayServiceName $GatewayServiceName `
        -GuardianServiceName $GuardianServiceName `
        -Metadata $Metadata
    if ($null -eq $receipt) { return $false }
    if (-not $AllowPrepared -and [string]$receipt.phase -cne 'finalized') {
        throw 'refusing to retire an incomplete managed hook contract cleanup receipt'
    }
    Microsoft.PowerShell.Management\Remove-Item `
        -LiteralPath $Layout.ManagedHookContractCleanupReceiptPath `
        -Force
    if (Microsoft.PowerShell.Management\Test-Path `
        -LiteralPath $Layout.ManagedHookContractCleanupReceiptPath) {
        throw 'managed hook contract cleanup receipt survived retirement'
    }
    return $true
}

function Invoke-DefenseClawManagedHookContractCleanup {
    param(
        [Parameter(Mandatory)][hashtable]$Layout,
        [Parameter(Mandatory)][hashtable]$Source,
        [Parameter(Mandatory)][string]$GatewayServiceName,
        [Parameter(Mandatory)][string]$GuardianServiceName,
        [Parameter(Mandatory)]$Metadata
    )
    $receipt = Get-DefenseClawManagedHookContractCleanupReceipt `
        -Layout $Layout `
        -GatewayServiceName $GatewayServiceName `
        -GuardianServiceName $GuardianServiceName `
        -Metadata $Metadata `
        -Required
    if ([string]$receipt.phase -ceq 'finalized') {
        if (Microsoft.PowerShell.Management\Test-Path `
                -LiteralPath $Layout.ManagedHookContractCleanupReportPath) {
            # The finalized receipt is the authoritative durable result. A
            # crash may truncate this disposable report after receipt commit,
            # so authenticate its exact path/type/ACL but do not require its
            # JSON to remain parseable before retirement.
            $staleReportPath = Assert-DefenseClawDescendant `
                -Path $Layout.ManagedHookContractCleanupReportPath `
                -Root $Layout.LifecycleLockDirectory `
                -Label 'managed hook contract cleanup report'
            $nativeSecurity = Initialize-DefenseClawNativeSecurity
            $staleReportSecurity =
                $nativeSecurity::GetRegularFileSecuritySnapshotNoFollowIfExists(
                    $staleReportPath
                )
            if ($null -eq $staleReportSecurity) {
                throw 'stale managed hook contract cleanup report is not a regular no-follow file'
            }
            $expectedReportAcl = New-DefenseClawCanonicalPathAcl `
                -IsDirectory:$false `
                -Kind AdminFile `
                -GatewayServiceSID $script:AdministratorsSID
            Assert-DefenseClawCanonicalRawPathAcl `
                -Path $staleReportPath `
                -Actual ([Security.AccessControl.RawSecurityDescriptor]::new(
                    [byte[]]$staleReportSecurity.SecurityDescriptor,
                    0
                )) `
                -Expected $expectedReportAcl
            Microsoft.PowerShell.Management\Remove-Item `
                -LiteralPath $staleReportPath `
                -Force
        }
        return $receipt
    }
    [void](Assert-DefenseClawSourceDescriptorCurrent -Source $Source)
    [void](New-DefenseClawTargetRuntimeExchangeFile `
        -Path $Layout.ManagedHookContractCleanupReportPath `
        -TransactionDirectory $Layout.LifecycleLockDirectory)
    $probe = Invoke-DefenseClawProcess `
        -File ([string]$Source.path) `
        -Arguments @(
            'enterprise', 'windows', 'managed-hook-contract-cleanup',
            '--receipt', [string]$Layout.ManagedHookContractCleanupReceiptPath,
            '--output', [string]$Layout.ManagedHookContractCleanupReportPath,
            '--scope-sha256', [string]$Layout.PurgeScopeSHA256,
            '--manifest-sha256', [string]$receipt.manifest_sha256,
            '--deployment-generation-id',
                [string]$receipt.deployment_generation_id,
            '--gateway-service-name', $GatewayServiceName
        )
    $report = Get-DefenseClawTargetRuntimeExchangeValue `
        -Path $Layout.ManagedHookContractCleanupReportPath `
        -TransactionDirectory $Layout.LifecycleLockDirectory
    $ok = $report.PSObject.Properties['ok']
    if ([int]$probe.exit_code -ne 0 -or $null -eq $ok -or
        $ok.Value -isnot [bool] -or -not [bool]$ok.Value -or
        [int64]$report.schema_version -ne 1 -or
        [string]$report.scope_sha256 -cne [string]$Layout.PurgeScopeSHA256 -or
        [string]$report.phase -cne 'finalized' -or
        [int64]$report.target_count -ne @($receipt.claims).Count -or
        [int64]$report.removed_count -lt 0 -or
        [int64]$report.already_absent_count -lt 0 -or
        [int64]$report.superseded_count -lt 0 -or
        ([int64]$report.removed_count +
            [int64]$report.already_absent_count +
            [int64]$report.superseded_count) -ne
                [int64]$report.target_count) {
        $detail = ConvertTo-DefenseClawBoundedDiagnostic -Value @(
            [string]$report.error,
            $probe.output
        )
        throw "native managed hook contract cleanup failed: $detail"
    }
    $finalized = Get-DefenseClawManagedHookContractCleanupReceipt `
        -Layout $Layout `
        -GatewayServiceName $GatewayServiceName `
        -GuardianServiceName $GuardianServiceName `
        -Metadata $Metadata `
        -Required
    if ([string]$finalized.phase -cne 'finalized') {
        throw 'native managed hook contract cleanup did not finalize its protected receipt'
    }
    Microsoft.PowerShell.Management\Remove-Item `
        -LiteralPath $Layout.ManagedHookContractCleanupReportPath `
        -Force
    return $finalized
}

function Get-DefenseClawStatePurgeIntent {
    param(
        [Parameter(Mandatory)][hashtable]$Layout,
        [Parameter(Mandatory)][string]$GatewayServiceName,
        [Parameter(Mandatory)][string]$GuardianServiceName,
        [switch]$Required
    )
    $path = Assert-DefenseClawDescendant `
        -Path $Layout.PurgeIntentPath `
        -Root $Layout.LifecycleLockDirectory `
        -Label 'state purge intent'
    if (-not (Microsoft.PowerShell.Management\Test-Path `
            -LiteralPath $path `
            -PathType Leaf)) {
        if ($Required) {
            throw 'authenticated DefenseClaw state-purge intent is missing'
        }
        return $null
    }
    Assert-DefenseClawNoReparsePath -Path $path
    $item = Microsoft.PowerShell.Management\Get-Item `
        -LiteralPath $path `
        -Force
    if ([int64]$item.Length -gt 65536) {
        throw 'state-purge intent exceeds the 65536-byte limit'
    }
    Assert-DefenseClawPathAcl `
        -Path $path `
        -AllowedWriterSIDs @(
            $script:SystemSID,
            $script:AdministratorsSID,
            $script:TrustedInstallerSID
        ) `
        -AllowedReaderSIDs @(
            $script:SystemSID,
            $script:AdministratorsSID,
            $script:TrustedInstallerSID
        ) `
        -RequiredRights (New-DefenseClawRequiredRights -Kind Admin) `
        -RejectUntrustedRead `
        -SelfHealKind AdminFile `
        -SelfHealGatewayServiceSID $script:AdministratorsSID
    try {
        $intent = Microsoft.PowerShell.Management\Get-Content `
            -LiteralPath $path `
            -Raw | Microsoft.PowerShell.Utility\ConvertFrom-Json
    }
    catch {
        throw "cannot parse authenticated state-purge intent: $($_.Exception.Message)"
    }
    $schema = $intent.PSObject.Properties['schema_version']
    $schemaVersion = if ($null -eq $schema -or $schema.Value -is [bool]) {
        0
    }
    else {
        [Convert]::ToInt64($schema.Value)
    }
    $phaseValue = [string]$intent.phase
    $validPhase = ($schemaVersion -eq 1 -and
            $phaseValue -ceq 'committed_state_purge') -or
        ($schemaVersion -eq 2 -and (
            $phaseValue -ceq 'contract_locks_pending' -or
            $phaseValue -ceq 'contract_locks_finalized' -or
            $phaseValue -ceq 'state_root_removed'
        ))
    if ($schemaVersion -notin @(1, 2) -or -not $validPhase -or
        [string]$intent.scope_sha256 -cne
            [string]$Layout.PurgeScopeSHA256 -or
        [string]$intent.tombstone_sha256 -cnotmatch '^[0-9a-f]{64}$') {
        throw 'authenticated state-purge intent has invalid schema, phase, scope, or tombstone hash'
    }
    if ($schemaVersion -eq 2 -and
        [string]$intent.contract_cleanup_identity_sha256 -cnotmatch
            '^sha256:[0-9a-f]{64}$') {
        throw 'authenticated state-purge intent has an invalid contract-cleanup receipt binding'
    }
    $stateRootIdentityProperty = $intent.PSObject.Properties[
        'state_root_identity'
    ]
    if ($null -ne $stateRootIdentityProperty -and
        ($schemaVersion -ne 2 -or
            [string]$stateRootIdentityProperty.Value -cnotmatch
                '^[a-f0-9]{8}:[a-f0-9]{16}$')) {
        throw 'authenticated state-purge intent has an invalid StateRoot identity'
    }
    foreach ($binding in @(
        @('install_root', $Layout.InstallRoot),
        @('state_root', $Layout.StateRoot),
        @('gateway_service', $GatewayServiceName),
        @('guardian_service', $GuardianServiceName)
    )) {
        $property = $intent.PSObject.Properties[[string]$binding[0]]
        if ($null -eq $property -or
            -not [string]::Equals(
                [string]$property.Value,
                [string]$binding[1],
                [StringComparison]::OrdinalIgnoreCase
            )) {
            throw "authenticated state-purge intent does not match $($binding[0])"
        }
    }
    $certificationProperty = $intent.PSObject.Properties[
        'certification_codex_home'
    ]
    $coreCertificationProperty = $intent.PSObject.Properties[
        'core_hardening_certification'
    ]
    if ($null -eq $certificationProperty -or
        $null -eq $coreCertificationProperty -or
        $coreCertificationProperty.Value -isnot [bool]) {
        throw 'authenticated state-purge intent has invalid certification bindings'
    }
    $intentCertificationCodexHome =
        Resolve-DefenseClawCertificationCodexHome `
            -Path ([string]$certificationProperty.Value) `
            -GatewayServiceName $GatewayServiceName `
            -GuardianServiceName $GuardianServiceName
    if ([bool]$coreCertificationProperty.Value -and
        [string]::IsNullOrWhiteSpace($intentCertificationCodexHome)) {
        throw 'authenticated state-purge intent enables core certification outside its exact scope'
    }
    if ([string]::IsNullOrWhiteSpace(
            [string]$Layout.CertificationCodexHome
        )) {
        $Layout.CertificationCodexHome = $intentCertificationCodexHome
    }
    elseif (-not [string]::Equals(
            [string]$Layout.CertificationCodexHome,
            $intentCertificationCodexHome,
            [StringComparison]::OrdinalIgnoreCase
        )) {
        throw 'authenticated state-purge intent certification CODEX_HOME does not match the requested scope'
    }
    if ([bool]$Layout.CoreHardeningCertification -and
        -not [bool]$coreCertificationProperty.Value) {
        throw 'authenticated state-purge intent does not match requested core-certification mode'
    }
    $Layout.CoreHardeningCertification = [bool](
        $coreCertificationProperty.Value
    )
    return $intent
}

function Remove-DefenseClawCommittedEmptyInstallRoot {
    param([Parameter(Mandatory)][hashtable]$Layout)
    if (-not (Microsoft.PowerShell.Management\Test-Path `
            -LiteralPath $Layout.InstallRoot)) {
        return
    }
    Assert-DefenseClawManagedTreeNoReparse `
        -Root $Layout.InstallRoot `
        -AllowAFUnixSocketAt (Get-DefenseClawOptionalLayoutValue -Layout $Layout -Name ManagedIPCSocketPath)
    $allowed = @(
        [IO.Path]::GetFullPath($Layout.BinDirectory).TrimEnd('\'),
        [IO.Path]::GetFullPath($Layout.LibexecDirectory).TrimEnd('\'),
        # Guardian-stop leaves the empty <InstallRoot>\ipc\ container
        # behind after removing defenseclaw_ipc.sock. The post-service-
        # teardown cleanup must accept it as a known-empty directory or
        # this validator trips before Remove-DefenseClawManagedTree ever
        # runs.
        [IO.Path]::GetFullPath($Layout.ManagedIPCDirectory).TrimEnd('\')
    )
    if (Test-DefenseClawLayoutBrokerEnabled -Layout $Layout) {
        $allowed += [IO.Path]::GetFullPath(
            (Microsoft.PowerShell.Management\Join-Path `
                $Layout.InstallRoot 'secure-client.install')
        ).TrimEnd('\')
    }
    if (Test-DefenseClawStandaloneProfile) {
        $allowed += @(Get-DefenseClawEmptyRetiredCompilerDirectories -InstallRoot $Layout.InstallRoot)
    }
    # A layout without the socket key tolerates no leaf file at all.
    $managedIPCSocketPath = Get-DefenseClawOptionalLayoutValue `
        -Layout $Layout `
        -Name ManagedIPCSocketPath
    $expectedSocket = if ([string]::IsNullOrWhiteSpace($managedIPCSocketPath)) {
        ''
    }
    else {
        [IO.Path]::GetFullPath($managedIPCSocketPath).TrimEnd('\')
    }
    foreach ($item in Microsoft.PowerShell.Management\Get-ChildItem `
        -LiteralPath $Layout.InstallRoot `
        -Recurse `
        -Force) {
        $full = [IO.Path]::GetFullPath($item.FullName).TrimEnd('\')
        # The AF_UNIX socket file at the AVC-contract path is the ONLY
        # non-directory leaf tolerated here - an unclean guardian stop
        # can leave it behind, and pre-remove cleanup must not fail
        # closed on that residue.
        if ($item.PSIsContainer) {
            if ($full -notin $allowed) {
                throw "committed uninstall left unexpected InstallRoot content: $full"
            }
        }
        elseif (-not [string]::Equals(
                $full,
                $expectedSocket,
                [StringComparison]::OrdinalIgnoreCase
            )) {
            throw "committed uninstall left unexpected InstallRoot content: $full"
        }
    }
    Remove-DefenseClawManagedTree `
        -Path $Layout.InstallRoot `
        -RequiredBase $script:ProgramFiles `
        -Label 'InstallRoot' `
        -AllowAFUnixSocketAt (Get-DefenseClawOptionalLayoutValue -Layout $Layout -Name ManagedIPCSocketPath)
}

function Publish-DefenseClawStatePurgeIntent {
    param(
        [Parameter(Mandatory)][hashtable]$Layout,
        [Parameter(Mandatory)][string]$GatewayServiceName,
        [Parameter(Mandatory)][string]$GuardianServiceName
    )
    if (Microsoft.PowerShell.Management\Test-Path -LiteralPath $Layout.PendingPath) {
        throw 'refusing state-purge intent publication while a lifecycle transaction is pending'
    }
    foreach ($name in @(Get-DefenseClawManagedServiceNames -GatewayServiceName $GatewayServiceName -GuardianServiceName $GuardianServiceName)) {
        if (Test-DefenseClawServiceExists -Name $name) {
            throw "refusing state-purge intent publication while service exists: $name"
        }
    }
    if (Microsoft.PowerShell.Management\Test-Path -LiteralPath $Layout.InstallRoot) {
        throw 'refusing state-purge intent publication while InstallRoot exists'
    }
    if (Microsoft.PowerShell.Management\Test-Path `
        -LiteralPath $Layout.ManagedHooksTeardownJournalPath) {
        throw 'refusing state-purge intent publication before teardown-journal retirement'
    }
    $metadata = Get-DefenseClawDeploymentMetadata -Layout $Layout -Required
    Assert-DefenseClawMetadataIdentity `
        -Metadata $metadata `
        -GatewayServiceName $GatewayServiceName `
        -GuardianServiceName $GuardianServiceName
    if (Test-DefenseClawMetadataInstalled -Metadata $metadata) {
        throw 'refusing state-purge intent publication before committed uninstall tombstone'
    }
    $cleanupReceipt = Get-DefenseClawManagedHookContractCleanupReceipt `
        -Layout $Layout `
        -GatewayServiceName $GatewayServiceName `
        -GuardianServiceName $GuardianServiceName `
        -Metadata $metadata
    if ($null -eq $cleanupReceipt) {
        throw (
            'the retired deployment predates scope-bound connector cleanup ' +
            'authority; refusing Purge because targets.yaml alone cannot ' +
            'prove that a current same-connector entry belongs to this scope'
        )
    }
    $tombstoneHash = (
        Microsoft.PowerShell.Utility\Get-FileHash `
            -LiteralPath $Layout.MetadataPath `
            -Algorithm SHA256
    ).Hash.ToLowerInvariant()
    $existing = Get-DefenseClawStatePurgeIntent `
        -Layout $Layout `
        -GatewayServiceName $GatewayServiceName `
        -GuardianServiceName $GuardianServiceName
    if ($null -ne $existing) {
        if ([string]$existing.tombstone_sha256 -cne $tombstoneHash) {
            throw 'existing state-purge intent belongs to a different uninstall tombstone'
        }
        return $existing
    }
    $recordedStateRootIdentity = $metadata.PSObject.Properties[
        'state_root_identity'
    ]
    $stateRootIdentity = if ($null -ne $recordedStateRootIdentity) {
        # A fresh native uninstall captured this inode in its authenticated
        # transaction, before any cleanup. The root's DACL may deny an
        # ordinary security snapshot on post-commit retry; native deletion
        # will pin and compare the inode under backup/restore privilege.
        [string]$recordedStateRootIdentity.Value
    }
    else {
        $nativeSecurity = Initialize-DefenseClawNativeSecurity
        $stateRootSnapshot =
            $nativeSecurity::GetDirectorySecuritySnapshotNoFollowIfExists(
                [string]$Layout.StateRoot
            )
        if ($null -eq $stateRootSnapshot) {
            throw 'cannot publish state-purge intent without the exact StateRoot inode'
        }
        ([string]$stateRootSnapshot.Identity).ToLowerInvariant()
    }
    if ($stateRootIdentity -cnotmatch '^[a-f0-9]{8}:[a-f0-9]{16}$') {
        throw 'cannot publish state-purge intent with an invalid StateRoot identity'
    }
    $phase = if ([string]$cleanupReceipt.phase -ceq 'finalized') {
        'contract_locks_finalized'
    }
    else {
        'contract_locks_pending'
    }
    $intent = [ordered]@{
        schema_version = 2
        phase = $phase
        scope_sha256 = [string]$Layout.PurgeScopeSHA256
        install_root = $Layout.InstallRoot
        state_root = $Layout.StateRoot
        gateway_service = $GatewayServiceName
        guardian_service = $GuardianServiceName
        certification_codex_home = [string]$Layout.CertificationCodexHome
        core_hardening_certification = [bool]$Layout.CoreHardeningCertification
        state_root_identity = $stateRootIdentity
        tombstone_sha256 = $tombstoneHash
        # Pin the receipt's immutable native-validated identity, not its
        # mutable file hash. Native cleanup durably advances per-claim crash
        # barriers in this receipt, so the full file must change while the
        # purge intent remains recoverable.
        contract_cleanup_identity_sha256 =
            [string]$cleanupReceipt.identity_sha256
        created_at = [DateTime]::UtcNow.ToString('o')
        updated_at = [DateTime]::UtcNow.ToString('o')
    }
    Write-DefenseClawStatePurgeIntentAtomic `
        -Value ($intent |
            Microsoft.PowerShell.Utility\ConvertTo-Json -Depth 16) `
        -Layout $Layout
    return Get-DefenseClawStatePurgeIntent `
        -Layout $Layout `
        -GatewayServiceName $GatewayServiceName `
        -GuardianServiceName $GuardianServiceName `
        -Required
}

# How long a standalone purge retries deleting StateRoot while a file in it
# is in use (an anti-virus scan of the audit database), and how often.
$script:StateRootRemovalRetryMilliseconds = 15000
$script:StateRootRemovalRetryIntervalMilliseconds = 500

# How long the retirement of InstallRoot retries a rename that a running
# program refuses (a hook process an agent started from bin, an anti-virus
# scan), and how often.
$script:InstallRootRetirementRetryMilliseconds = 60000
$script:InstallRootRetirementRetryIntervalMilliseconds = 250

# Whether a failed rename of InstallRoot failed because a program holds a
# file in it: 0x80070005 access denied (a running image or an open file
# inside the folder), 0x80070020 or 0x80070021.
function Test-DefenseClawInstallRootInUseException {
    param([AllowNull()][Exception]$Exception)
    while ($null -ne $Exception) {
        if ([int]$Exception.HResult -in @(-2147024891, -2147024864, -2147024863)) {
            return $true
        }
        $Exception = $Exception.InnerException
    }
    return $false
}

# Retiring InstallRoot renames it aside, which frees its name in the parent
# folder. An account that can create an entry there (a folder, a junction or
# a file) could take that name while it is free; then nothing can put
# InstallRoot back, and a recovery finds both trees and stops (GAP-0149
# review, loop round 2). Returns why another account could, or '' when only
# SYSTEM, Administrators and TrustedInstaller can: the folder's owner, and
# every allow entry that applies to the
# folder itself and grants a create, delete or permission right. A deny
# entry is never counted as taking such a right away.
$script:InstallRootParentChangeRights = [int64](
    [int64][Security.AccessControl.FileSystemRights]::CreateFiles -bor
    [int64][Security.AccessControl.FileSystemRights]::CreateDirectories -bor
    [int64][Security.AccessControl.FileSystemRights]::DeleteSubdirectoriesAndFiles -bor
    [int64][Security.AccessControl.FileSystemRights]::Delete -bor
    [int64][Security.AccessControl.FileSystemRights]::ChangePermissions -bor
    [int64][Security.AccessControl.FileSystemRights]::TakeOwnership -bor
    0x50000000L
)

function Get-DefenseClawUntrustedFolderCreator {
    param([Parameter(Mandatory)][string]$Path)
    $trusted = @(
        $script:SystemSID,
        $script:AdministratorsSID,
        $script:TrustedInstallerSID
    )
    $acl = Microsoft.PowerShell.Security\Get-Acl -LiteralPath $Path
    $accessSDDL = $acl.GetSecurityDescriptorSddlForm(
        [Security.AccessControl.AccessControlSections]::Access
    )
    if ([string]::IsNullOrWhiteSpace($accessSDDL) -or
        -not $accessSDDL.StartsWith('D:', [StringComparison]::OrdinalIgnoreCase) -or
        $accessSDDL.IndexOf('NO_ACCESS_CONTROL', [StringComparison]::OrdinalIgnoreCase) -ge 0) {
        return 'it has no access list, so every account has full access to it'
    }
    $owner = [string]$acl.GetOwner([Security.Principal.SecurityIdentifier]).Value
    if ($trusted -notcontains $owner) {
        return "its owner $owner can change its access list"
    }
    foreach ($rule in $acl.GetAccessRules($true, $true, [Security.Principal.SecurityIdentifier])) {
        if ($rule.AccessControlType -ne [Security.AccessControl.AccessControlType]::Allow -or
            (($rule.PropagationFlags -band [Security.AccessControl.PropagationFlags]::InheritOnly) -ne 0)) {
            continue
        }
        $sid = [string]$rule.IdentityReference.Value
        # CREATOR OWNER applies only to what is created below the folder,
        # and OWNER RIGHTS is its owner, checked above.
        if ($trusted -contains $sid -or $sid -in @('S-1-3-0', 'S-1-3-4')) {
            continue
        }
        $rights = [int64]$rule.FileSystemRights -band 0xffffffffL
        if (($rights -band $script:InstallRootParentChangeRights) -ne 0) {
            return ('{0} holds rights 0x{1:x} on it' -f $sid, $rights)
        }
    }
    return ''
}

function Assert-DefenseClawInstallRootNameReserved {
    param([Parameter(Mandatory)][string]$InstallRoot)
    $parent = [IO.Path]::GetDirectoryName(
        [IO.Path]::GetFullPath($InstallRoot).TrimEnd('\')
    )
    if ([string]::IsNullOrWhiteSpace($parent)) {
        throw "InstallRoot has no parent folder: $InstallRoot"
    }
    Assert-DefenseClawNoReparsePath -Path $parent
    $reason = Get-DefenseClawUntrustedFolderCreator -Path $parent
    if (-not [string]::IsNullOrEmpty($reason)) {
        throw (
            "InstallRoot is not renamed aside: an account that is not an administrator could take its name in $parent " +
            "while it is free ($reason). Remove that access, so that only SYSTEM, Administrators and TrustedInstaller " +
            "can create entries in $parent, and run the uninstall again"
        )
    }
}

function Move-DefenseClawInstallRootForRetirement {
    <#
        Renames InstallRoot aside for the self-uninstall finalizer. Windows
        refuses to rename a folder while a program runs from it or holds a
        file in it open; an agent that keeps starting the managed hook from
        bin\ made the committed uninstall fail 1603 with "Access to the path
        is denied" (GAP-0149). Each hook process lives for a moment, so the
        rename is retried for a bounded time; only a holder that outlasts it
        still fails, with the existing retry guidance. A parent folder that
        another account can create entries in is refused first
        (Assert-DefenseClawInstallRootNameReserved).
    #>
    param(
        [Parameter(Mandatory)][string]$Source,
        [Parameter(Mandatory)][string]$Destination
    )
    Assert-DefenseClawInstallRootNameReserved -InstallRoot $Source
    $clock = [Diagnostics.Stopwatch]::StartNew()
    while ($true) {
        try {
            [IO.Directory]::Move($Source, $Destination)
            return
        }
        catch {
            $inUse = Test-DefenseClawInstallRootInUseException -Exception $_.Exception
            if (-not $inUse -or
                $clock.ElapsedMilliseconds -ge $script:InstallRootRetirementRetryMilliseconds) {
                throw
            }
        }
        Microsoft.PowerShell.Utility\Start-Sleep -Milliseconds $script:InstallRootRetirementRetryIntervalMilliseconds
    }
}

# The programs that hold InstallRoot now: a process that runs an image
# from it, or one Restart Manager reports with a file in it open. This
# lifecycle and the installed CLI that asked for its own removal do not
# count: the CLI's own image does not keep the folder from being renamed
# (the uninstall moved its working folder out of InstallRoot first), and
# the finalizer waits for it to exit anyway, nor do the processes in
# ExcludedProcessIds (the running services an uninstall stops itself). A
# precommit caller asks Restart Manager to fail closed on a query error;
# otherwise Restart Manager failing finds no holder. Each holder is one
# string, "name (pid N, ...)".
function Get-DefenseClawInstallRootHolders {
    param(
        [Parameter(Mandatory)][string]$InstallRoot,
        [int]$SelfUninstallCallerPID,
        [AllowNull()][int[]]$ExcludedProcessIds,
        [switch]$FailOnQueryError,
        [switch]$IncludeProcessId
    )
    $root = [IO.Path]::GetFullPath($InstallRoot).TrimEnd('\') + '\'
    $excluded = [Collections.Generic.HashSet[int]]::new()
    [void]$excluded.Add([int]$PID)
    if ($SelfUninstallCallerPID -gt 0) {
        [void]$excluded.Add([int]$SelfUninstallCallerPID)
    }
    if ($null -ne $ExcludedProcessIds) {
        foreach ($id in $ExcludedProcessIds) {
            [void]$excluded.Add([int]$id)
        }
    }
    $named = [ordered]@{}
    $images = @{}
    foreach ($process in @(Get-DefenseClawProcessImages)) {
        $id = [int]$process.Id
        $images[$id] = $process
        $path = [string]$process.Path
        if ([string]::IsNullOrEmpty($path) -or $excluded.Contains($id) -or
            -not $path.StartsWith($root, [StringComparison]::OrdinalIgnoreCase)) {
            continue
        }
        $named[[string]$id] = Format-DefenseClawProcessInUse `
            -Name ([IO.Path]::GetFileName($path)) `
            -Id $id `
            -UserName ([string]$process.UserName) `
            -Parent ([string]$process.Parent)
    }
    $files = [Collections.Generic.List[string]]::new()
    $pending = [Collections.Generic.Stack[string]]::new()
    if ([IO.Directory]::Exists($InstallRoot)) {
        $pending.Push([IO.Path]::GetFullPath($InstallRoot))
    }
    while ($pending.Count -gt 0 -and $files.Count -lt $script:StateFileInUseCheckLimit) {
        $entries = @(try {
                [IO.DirectoryInfo]::new($pending.Pop()).GetFileSystemInfos()
            }
            catch {
                if ($FailOnQueryError) {
                    throw (
                        'uninstall_in_use: could not enumerate DefenseClaw install files (' +
                        $_.Exception.Message + '); nothing was changed; run the uninstall again'
                    )
                }
            })
        foreach ($entry in $entries) {
            if (($entry.Attributes -band [IO.FileAttributes]::ReparsePoint) -ne 0) {
                continue
            }
            if ($entry -is [IO.DirectoryInfo]) {
                $pending.Push([string]$entry.FullName)
            }
            elseif ($files.Count -lt $script:StateFileInUseCheckLimit) {
                $files.Add([string]$entry.FullName)
            }
        }
    }
    if ($FailOnQueryError -and $pending.Count -gt 0) {
        throw (
            'uninstall_in_use: the DefenseClaw install tree exceeds the bounded holder check; ' +
            'nothing was changed; run the uninstall again after checking the install tree'
        )
    }
    if ($files.Count -gt 0) {
        $found = @(try {
                $native = Initialize-DefenseClawNativeSecurity
                $native::GetFileHolders($files.ToArray())
            }
            catch {
                if ($FailOnQueryError) {
                    throw (
                        'uninstall_in_use: Restart Manager could not list the programs that hold DefenseClaw install files (' +
                        $_.Exception.Message + '); nothing was changed; run the uninstall again'
                    )
                }
                Microsoft.PowerShell.Utility\Write-Verbose "Restart Manager could not list the programs that hold files in ${root}: $($_.Exception.Message)"
            })
        foreach ($holder in $found) {
            if (Test-DefenseClawUnnamedFileHolder -Holder $holder) {
                $named['unnamed'] = Format-DefenseClawProcessInUse `
                    -Name ([string]$holder.AppName + ' (' + $script:UnnamedFileHolderHint + ')') `
                    -Id 0
                continue
            }
            $id = [int]$holder.ProcessId
            if ($excluded.Contains($id) -or $named.Contains([string]$id)) {
                continue
            }
            $process = $images[$id]
            $name = [string]$holder.AppName
            if ($null -ne $process -and -not [string]::IsNullOrEmpty([string]$process.Path)) {
                $name = [IO.Path]::GetFileName([string]$process.Path)
            }
            if ([string]::IsNullOrEmpty($name)) {
                $name = 'a program'
            }
            $named[[string]$id] = Format-DefenseClawProcessInUse `
                -Name $name `
                -Id $id `
                -UserName $(if ($null -ne $process) { [string]$process.UserName } else { '' }) `
                -Parent $(if ($null -ne $process) { [string]$process.Parent } else { '' })
        }
    }
    if ($IncludeProcessId) {
        return @($named.GetEnumerator() | Microsoft.PowerShell.Core\ForEach-Object {
            [pscustomobject]@{
                Id = $(if ($_.Key -ceq 'unnamed') { 0 } else { [int]$_.Key })
                Description = [string]$_.Value
            }
        })
    }
    return [string[]]@($named.Values)
}

# Standalone uninstall refuses, before it changes anything, while a program
# other than this lifecycle, the self-uninstall caller and the DefenseClaw
# services holds a file in InstallRoot: a process that held
# bin\defenseclaw-hook.exe open without delete sharing past the retirement
# retry made the committed uninstall fail with the services and hooks
# already gone (GAP-0625). It waits that retry window and refuses only a
# holder seen at every look, so a hook call (a new pid each time) or a short
# scan does not. The services and hooks stay in place while it waits. A
# holder Restart Manager does not report still meets the committed
# retirement.
function Assert-DefenseClawStandaloneInstallRootNotHeld {
    param(
        [Parameter(Mandatory)][hashtable]$Layout,
        [Parameter(Mandatory)][string]$GatewayServiceName,
        [Parameter(Mandatory)][string]$GuardianServiceName,
        [int]$SelfUninstallCallerPID
    )
    if (-not (Test-DefenseClawStandaloneProfile)) {
        return
    }
    $own = Get-DefenseClawUninstallOwnProcessIds `
        -GatewayServiceName $GatewayServiceName `
        -GuardianServiceName $GuardianServiceName `
        -SelfUninstallCallerPID $SelfUninstallCallerPID
    $services = [int[]]@($own)
    $clock = [Diagnostics.Stopwatch]::StartNew()
    $still = $null
    while ($true) {
        $seen = @(Get-DefenseClawInstallRootHolders `
                -InstallRoot $Layout.InstallRoot `
                -SelfUninstallCallerPID $SelfUninstallCallerPID `
                -ExcludedProcessIds $services)
        if ($null -ne $still) {
            $seen = @($still | Microsoft.PowerShell.Core\Where-Object { $seen -contains $_ })
        }
        $still = $seen
        if ($still.Count -eq 0) {
            return
        }
        if ($clock.ElapsedMilliseconds -ge $script:InstallRootRetirementRetryMilliseconds) {
            break
        }
        Microsoft.PowerShell.Utility\Start-Sleep -Milliseconds $script:InstallTreeUseRecheckMilliseconds
    }
    $root = [IO.Path]::GetFullPath([string]$Layout.InstallRoot).TrimEnd('\')
    $seconds = [int][Math]::Ceiling($script:InstallRootRetirementRetryMilliseconds / 1000)
    throw (
        'uninstall_in_use: ' + ($still -join '; ') + " held a file in $root for $seconds seconds, so DefenseClaw " +
        'cannot remove that folder; nothing was changed. ' +
        'Close the program, then run the uninstall again'
    )
}

# Why this account may not rename InstallRoot aside whichever program
# exits, or '' when it may. The rename needs DELETE on InstallRoot (or
# delete-child on its parent) and the right to create a folder in the parent
# the retired root goes to. Each is checked by opening the folder for that
# right with every sharing mode allowed, so a program that holds a file in
# InstallRoot does not change the answer. A sharing violation (a window
# whose current folder is InstallRoot) ends when that program does, so it is
# not a missing right. A check that cannot run is a reason too: an access
# denied that is not proven transient is never deferred (W4 review, loop
# round 2).
function Get-DefenseClawInstallRootRenameDenial {
    param(
        [Parameter(Mandatory)][string]$Source,
        [Parameter(Mandatory)][string]$Destination
    )
    $parent = [IO.Path]::GetDirectoryName([IO.Path]::GetFullPath($Destination).TrimEnd('\'))
    $checks = @(
        @{ Path = $Source; Access = [uint32]0x00010000; What = "rename $Source" },
        @{ Path = $parent; Access = [uint32]0x00000004; What = "create a folder in $parent" }
    )
    try {
        $native = Initialize-DefenseClawNativeSecurity
        foreach ($check in $checks) {
            $code = [int]$native::GetDirectoryOpenError([string]$check.Path, [uint32]$check.Access)
            if ($code -notin @(0, 32, 33)) {
                return ('this account may not {0} ({1})' -f $check.What, [ComponentModel.Win32Exception]::new($code).Message.TrimEnd('.'))
            }
        }
    }
    catch {
        return "the rights to rename it could not be checked ($($_.Exception.Message))"
    }
    return ''
}

# Renames InstallRoot aside after the uninstall committed. A program can
# hold a file in InstallRoot past the retry window (an antivirus scan, an
# administrator's window); that failed the committed uninstall with 1603 and
# the services already removed. Such a holder defers the retirement to the
# detached finalizer (Start-DefenseClawDeferredSelfUninstallRetirement),
# which finishes it once the program lets go (GAP-0149 review, loop round
# 1). Only a holder found now defers: access denied is also what an access
# list on InstallRoot or its parent answers, and no program exit ends that,
# so a refusal with no holder fails the uninstall (W4 review, loop round 1).
# A holder defers only a rename this account has the rights for: a deny entry
# fails the uninstall even while a program holds a file (W4 review, loop
# round 2). Returns '' when InstallRoot was retired, or the holders and the error when
# the retirement is deferred; any other failure is thrown.
function Invoke-DefenseClawCommittedInstallRootRetirement {
    param(
        [Parameter(Mandatory)][string]$Source,
        [Parameter(Mandatory)][string]$Destination,
        [int]$SelfUninstallCallerPID
    )
    try {
        Move-DefenseClawInstallRootForRetirement -Source $Source -Destination $Destination
    }
    catch {
        $failure = $_
        if (-not (Test-DefenseClawInstallRootInUseException -Exception $failure.Exception) -or
            -not [IO.Directory]::Exists($Source) -or
            [IO.Directory]::Exists($Destination)) {
            throw
        }
        $denial = Get-DefenseClawInstallRootRenameDenial -Source $Source -Destination $Destination
        if (-not [string]::IsNullOrEmpty($denial)) {
            throw (
                "Windows refused to rename $Source aside ($($failure.Exception.Message)) and $denial, " +
                'so the refusal does not end when a program exits. Remove the deny entry on that folder (or make its ' +
                'file system writable), then run the uninstall again'
            )
        }
        $holders = @(Get-DefenseClawInstallRootHolders -InstallRoot $Source -SelfUninstallCallerPID $SelfUninstallCallerPID)
        if ($holders.Count -eq 0) {
            throw (
                "Windows refused to rename $Source aside ($($failure.Exception.Message)) and no program holds a file in it, " +
                'so the refusal does not end when a program exits. Check that administrators can rename that folder and ' +
                'create folders in its parent (no deny entry, no read-only file system) and that no window or prompt has ' +
                'it as its current folder, then run the uninstall again'
            )
        }
        return ('{0}: {1}' -f ($holders -join '; '), $failure.Exception.Message)
    }
    if ([IO.Directory]::Exists($Source) -or -not [IO.Directory]::Exists($Destination)) {
        throw 'atomic self-uninstall InstallRoot retirement did not complete exactly'
    }
    return ''
}

function Test-DefenseClawFileInUseError {
    # Whether a failed deletion failed because another program has the file
    # or a directory open: a sharing or lock violation, or a directory that
    # a delete-pending file keeps from being empty.
    param([Parameter(Mandatory)][Management.Automation.ErrorRecord]$ErrorRecord)
    $exception = $ErrorRecord.Exception
    if ($exception -is [Management.Automation.ActionPreferenceStopException] -and
        $null -ne $exception.ErrorRecord) {
        $exception = $exception.ErrorRecord.Exception
    }
    while ($null -ne $exception) {
        # 0x80070020, 0x80070021, 0x80070091
        if ([int]$exception.HResult -in @(-2147024864, -2147024863, -2147024751)) {
            return $true
        }
        $exception = $exception.InnerException
    }
    return $false
}

function Test-DefenseClawAccessDeniedError {
    # Whether a failed deletion failed because the account has no right on the
    # file: access denied (0x80070005), not a sharing violation.
    param([Parameter(Mandatory)][Management.Automation.ErrorRecord]$ErrorRecord)
    $exception = $ErrorRecord.Exception
    if ($exception -is [Management.Automation.ActionPreferenceStopException] -and
        $null -ne $exception.ErrorRecord) {
        $exception = $exception.ErrorRecord.Exception
    }
    while ($null -ne $exception) {
        if ($exception -is [UnauthorizedAccessException] -or [int]$exception.HResult -eq -2147024891) {
            return $true
        }
        $exception = $exception.InnerException
    }
    return $false
}

function Remove-DefenseClawStateTreePrivileged {
    <#
        GAP-0890: the plain deletion of DefenseClaw's own tree got access
        denied for a file that only SYSTEM may open (hook-guardian\
        opencode-service-ports.json), because an Administrator's backup and
        restore privileges are disabled in its token. This deletes the tree
        once more through the native no-follow privileged delete, which
        enables backup and restore for the call only on a thread-bound
        duplicate of the token (the process token is never changed),
        deletes a link as the link and never enters it, and rewrites no
        access list. It acts only for the standalone profile, only after an
        access-denied failure, and only on the exact StateRoot or InstallRoot
        of the standalone profile; any other path, label or profile returns
        $false and changes nothing. Every deleted path is logged as a
        defenseclaw_repair event. Returns $true when Root is gone.
    #>
    param(
        [Parameter(Mandatory)][string]$Root,
        [Parameter(Mandatory)][string]$Target,
        [Parameter(Mandatory)][string]$Label,
        [Parameter(Mandatory)][Management.Automation.ErrorRecord]$ErrorRecord
    )
    if (-not (Test-DefenseClawStandaloneProfile)) {
        return $false
    }
    if ($Label -cne 'StateRoot' -and $Label -cne 'InstallRoot') {
        return $false
    }
    if (-not (Test-DefenseClawAccessDeniedError -ErrorRecord $ErrorRecord)) {
        return $false
    }
    $roots = Get-DefenseClawProfileRoots -EnterpriseProfile Standalone
    $own = [IO.Path]::GetFullPath([string]$(if ($Label -ceq 'StateRoot') { $roots.StateRoot } else { $roots.InstallRoot })).TrimEnd('\')
    $full = [IO.Path]::GetFullPath($Root).TrimEnd('\')
    if (-not [string]::Equals($full, $own, [StringComparison]::OrdinalIgnoreCase)) {
        return $false
    }
    # The path handed to the native call must be the root just checked, or its
    # extended-length form (a tree with names Win32 normalizes is removed that
    # way); nothing else is deleted (GAP-0890 review S3).
    $targetPlain = if ($Target.StartsWith('\\?\', [StringComparison]::Ordinal)) { $Target.Substring(4) } else { $Target }
    if (-not [string]::Equals([IO.Path]::GetFullPath($targetPlain).TrimEnd('\'), $full, [StringComparison]::OrdinalIgnoreCase)) {
        return $false
    }
    $deleted = [Collections.Generic.List[string]]::new()
    $failures = @()
    $logMissing = $false
    try {
        $native = Initialize-DefenseClawNativeSecurity
        $failures = @($native::DeleteTreePrivileged($Target, $deleted))
    }
    catch {
        Microsoft.PowerShell.Utility\Write-Verbose "privileged deletion of $full failed: $($_.Exception.Message)"
    }
    foreach ($entry in $deleted) {
        Write-DefenseClawResilienceEvent -Marker defenseclaw_repair -Fields @{
            path   = [string]$entry
            reason = "deleted after access denied, with backup and restore privileges enabled for this call only: $($ErrorRecord.Exception.Message)"
        }
        # The warning stream is not kept by the CLI or Setup; the lifecycle
        # log is, so each privileged deletion is named there too.
        Write-DefenseClawLifecycleLogDiagnostic -Message (
            'defenseclaw_repair path=' + [string]$entry +
            ': deleted after access denied, with backup and restore privileges enabled for this call only')
        if (-not $script:LifecycleLogDiagnosticWritten) {
            $logMissing = $true
        }
    }
    if ($logMissing) {
        # The lifecycle log folder is missing or not writable: the
        # defenseclaw_repair warnings above are the record, said once.
        Microsoft.PowerShell.Utility\Write-Warning -Message (
            'defenseclaw_repair: the lifecycle log could not be written, so the ' +
            "$($deleted.Count) privileged deletion(s) under $full are named only in the defenseclaw_repair warnings")
    }
    foreach ($failure in $failures) {
        Microsoft.PowerShell.Utility\Write-Verbose "privileged deletion left: $failure"
    }
    return (-not (Microsoft.PowerShell.Management\Test-Path -LiteralPath $full))
}

function Remove-DefenseClawPurgedStateRoot {
    <#
        Deletes StateRoot after the services stopped. Standalone retries a
        deletion that fails because a file is in use for a bounded time,
        then refuses with uninstall_in_use naming the program that holds it
        (GAP-0136). The purge intent stays, so running the uninstall with
        PURGE=1 again finishes the deletion; the Intune launcher does that
        once the named program exits.
    #>
    param([Parameter(Mandatory)][hashtable]$Layout)
    $clock = [Diagnostics.Stopwatch]::StartNew()
    $failure = $null
    while ($null -eq $failure) {
        try {
            Remove-DefenseClawManagedTree `
                -Path $Layout.StateRoot `
                -RequiredBase $script:ProgramData `
                -Label 'StateRoot'
            return
        }
        catch {
            if (-not (Test-DefenseClawStandaloneProfile) -or
                -not (Test-DefenseClawFileInUseError -ErrorRecord $_)) {
                throw
            }
            if ($clock.ElapsedMilliseconds -ge $script:StateRootRemovalRetryMilliseconds) {
                $failure = $_
                continue
            }
        }
        Microsoft.PowerShell.Utility\Start-Sleep -Milliseconds $script:StateRootRemovalRetryIntervalMilliseconds
    }
    $root = [IO.Path]::GetFullPath([string]$Layout.StateRoot).TrimEnd('\')
    $paths = Get-DefenseClawStateRootFiles -Layout $Layout
    $excluded = [Collections.Generic.HashSet[int]]::new()
    [void]$excluded.Add([int]$PID)
    $holders = Get-DefenseClawStateFileHolders -Layout $Layout -Paths $paths -Excluded $excluded
    $who = if ($holders.Count -gt 0) {
        Get-DefenseClawStateFileHolderText -Layout $Layout -Holders $holders -Paths $paths
    }
    else {
        'another program has a file open (' +
            (ConvertTo-DefenseClawBoundedDiagnostic -Value $failure.Exception.Message -MaxLength 512) + ')'
    }
    $seconds = [int][Math]::Ceiling($script:StateRootRemovalRetryMilliseconds / 1000)
    throw (
        'uninstall_in_use: ' + $who + " in $root, so the purge could not delete that folder within $seconds seconds. " +
        'DefenseClaw is already uninstalled and only this data folder is left. Close the program (for example a SIEM ' +
        'forwarder or a log tail that reads runtime\audit.db), then run the uninstall with PURGE=1 again to finish'
    )
}

function Complete-DefenseClawStatePurge {
    param(
        [Parameter(Mandatory)][hashtable]$Layout,
        [Parameter(Mandatory)][string]$GatewayServiceName,
        [Parameter(Mandatory)][string]$GuardianServiceName,
        [string]$GatewayServiceSID,
        [hashtable]$NativeCleanupSource
    )
    $intent = Get-DefenseClawStatePurgeIntent `
        -Layout $Layout `
        -GatewayServiceName $GatewayServiceName `
        -GuardianServiceName $GuardianServiceName `
        -Required
    foreach ($name in @(Get-DefenseClawManagedServiceNames -GatewayServiceName $GatewayServiceName -GuardianServiceName $GuardianServiceName)) {
        if (Test-DefenseClawServiceExists -Name $name) {
            throw "refusing authenticated state purge while service exists: $name"
        }
    }
    if (Microsoft.PowerShell.Management\Test-Path -LiteralPath $Layout.InstallRoot) {
        throw 'refusing authenticated state purge after InstallRoot reappeared'
    }
    if (Microsoft.PowerShell.Management\Test-Path `
        -LiteralPath $Layout.PendingPath) {
        throw 'refusing authenticated state purge while transaction evidence remains'
    }
    $intentSchema = [Convert]::ToInt64($intent.schema_version)
    # A protected schema-1 intent was published by the prior lifecycle only
    # after managed-hook teardown, service/IPC cleanup, InstallRoot deletion,
    # and teardown-journal retirement had completed. It carries no authority
    # to mutate per-user contract locks, but it remains sufficient to finish
    # the one operation it already authorized: bounded removal of this exact
    # StateRoot after revalidating the tombstone and absent service/install
    # preconditions above. Rejecting it solely because StateRoot still exists
    # makes the intended crash-before-delete recovery point unrecoverable.
    $metadata = $null
    if (Microsoft.PowerShell.Management\Test-Path `
        -LiteralPath $Layout.MetadataPath `
        -PathType Leaf) {
        $metadata = Get-DefenseClawDeploymentMetadata -Layout $Layout -Required
        Assert-DefenseClawMetadataIdentity `
            -Metadata $metadata `
            -GatewayServiceName $GatewayServiceName `
            -GuardianServiceName $GuardianServiceName
        if (Test-DefenseClawMetadataInstalled -Metadata $metadata) {
            throw 'state-purge intent is stale because deployment is installed'
        }
        $actualHash = (
            Microsoft.PowerShell.Utility\Get-FileHash `
                -LiteralPath $Layout.MetadataPath `
                -Algorithm SHA256
        ).Hash.ToLowerInvariant()
        if ([string]$intent.tombstone_sha256 -cne $actualHash) {
            # Tombstone-SHA drift between intent publication and the current
            # deployment.json bytes is NOT a candidate for bulldoze: an
            # actively tampered purge intent (attacker-written SHA) is
            # indistinguishable from a legitimate drift and the authenticated
            # purge path must stay fail-closed to prevent an unauthorized
            # state purge. Operators can retry uninstall from a clean intent
            # (the pending transaction's state-purge intent is re-published
            # by the next lifecycle invocation).
            throw 'state-purge tombstone changed after intent publication'
        }
    }
    if ($intentSchema -eq 2 -and
        [string]$intent.phase -ceq 'contract_locks_pending') {
        if ($null -eq $metadata) {
            throw 'pending contract cleanup lost its authenticated deployment tombstone'
        }
        $receipt = Get-DefenseClawManagedHookContractCleanupReceipt `
            -Layout $Layout `
            -GatewayServiceName $GatewayServiceName `
            -GuardianServiceName $GuardianServiceName `
            -Metadata $metadata `
            -Required
        if ([string]$receipt.identity_sha256 -cne
            [string]$intent.contract_cleanup_identity_sha256) {
            throw 'managed hook contract cleanup receipt identity changed after purge intent publication'
        }
        if ($null -eq $NativeCleanupSource) {
            throw 'delayed purge requires the authenticated native cleanup executable'
        }
        [void](Invoke-DefenseClawManagedHookContractCleanup `
            -Layout $Layout `
            -Source $NativeCleanupSource `
            -GatewayServiceName $GatewayServiceName `
            -GuardianServiceName $GuardianServiceName `
            -Metadata $metadata)
        $intent.phase = 'contract_locks_finalized'
        $intent.updated_at = [DateTime]::UtcNow.ToString('o')
        Write-DefenseClawStatePurgeIntentAtomic `
            -Value ($intent |
                Microsoft.PowerShell.Utility\ConvertTo-Json -Depth 16) `
            -Layout $Layout
        $intent = Get-DefenseClawStatePurgeIntent `
            -Layout $Layout `
            -GatewayServiceName $GatewayServiceName `
            -GuardianServiceName $GuardianServiceName `
            -Required
    }
    if ($intentSchema -eq 2 -and
        [string]$intent.phase -ceq 'contract_locks_finalized') {
        $receipt = Get-DefenseClawManagedHookContractCleanupReceipt `
            -Layout $Layout `
            -GatewayServiceName $GatewayServiceName `
            -GuardianServiceName $GuardianServiceName `
            -Metadata $metadata `
            -Required
        if ([string]$receipt.phase -cne 'finalized') {
            throw 'state purge refused before connector contract cleanup finalized'
        }
        if ([string]$receipt.identity_sha256 -cne
            [string]$intent.contract_cleanup_identity_sha256) {
            throw 'finalized contract cleanup receipt identity changed before state purge'
        }
    }
    [void](Revoke-DefenseClawManagedIPCServiceAccess `
        -Layout $Layout `
        -GatewayServiceName $GatewayServiceName `
        -GatewayServiceSID $GatewayServiceSID)
    foreach ($name in @(Get-DefenseClawManagedServiceNames -GatewayServiceName $GatewayServiceName -GuardianServiceName $GuardianServiceName)) {
        if (Test-DefenseClawServiceExists -Name $name) {
            throw "refusing authenticated state purge because service reappeared: $name"
        }
    }
    if ($intentSchema -eq 2 -and
        [string]$intent.phase -ceq 'contract_locks_pending') {
        throw 'refusing StateRoot removal while connector contract cleanup is pending'
    }
    # The bundle.lock handle would keep its folder from being removed; every
    # bundle run waits for lifecycle.lock, which this run still holds.
    Exit-DefenseClawPurgeBundleLock
    $stateRootIdentityProperty = $intent.PSObject.Properties[
        'state_root_identity'
    ]
    $nativeCleanupAvailable = $null -ne $NativeCleanupSource -and
        (Microsoft.PowerShell.Management\Test-Path `
            -LiteralPath ([string]$NativeCleanupSource.path) `
            -PathType Leaf)
    if ($nativeCleanupAvailable -and
        $null -ne $stateRootIdentityProperty) {
        # The protected purge intent binds the exact pre-delete StateRoot
        # inode. The signed native helper holds exclusive, no-follow handles
        # and uses backup/restore privileges to remove ACL-denied descendants.
        # It also proves absence on crash re-entry, which Test-Path cannot do
        # reliably when a directory DACL denies the caller.
        [void](Assert-DefenseClawSourceDescriptorCurrent `
            -Source $NativeCleanupSource)
        $cleanupGatewaySID = if (-not [string]::IsNullOrWhiteSpace(
                $GatewayServiceSID
            )) {
            $GatewayServiceSID
        }
        else {
            Get-DefenseClawServiceSIDForRecovery `
                -ServiceName $GatewayServiceName
        }
        $request = [ordered]@{
            schema_version = 1
            mode = 'uninstall_state_purge'
            root = [IO.Path]::GetFullPath(
                [string]$Layout.StateRoot
            ).TrimEnd('\')
            expected_identity = [string]$stateRootIdentityProperty.Value
            gateway_service_sid = $cleanupGatewaySID
            validate_only = $false
        }
        if (Test-DefenseClawStandaloneProfile) {
            # The native boundary accepts only the named profile's exact
            # layouts; Secure Client requests keep their original shape.
            $request['profile'] = 'standalone'
        }
        $requestPath = Microsoft.PowerShell.Management\Join-Path `
            $Layout.LifecycleLockDirectory `
            "state-root-cleanup-$($Layout.PurgeScopeSHA256)-request.json"
        $reportPath = Microsoft.PowerShell.Management\Join-Path `
            $Layout.LifecycleLockDirectory `
            "state-root-cleanup-$($Layout.PurgeScopeSHA256)-report.json"
        [void](Invoke-DefenseClawNamespaceRootCleanup `
            -Source $NativeCleanupSource `
            -Request $request `
            -RequestPath $requestPath `
            -ReportPath $reportPath `
            -ExchangeDirectory $Layout.LifecycleLockDirectory `
            -ExpectedRootPresent $true `
            -AllowAbsentRoot)
        foreach ($exchangePath in @($requestPath, $reportPath)) {
            if (Microsoft.PowerShell.Management\Test-Path `
                    -LiteralPath $exchangePath `
                    -PathType Leaf) {
                Microsoft.PowerShell.Management\Remove-Item `
                    -LiteralPath $exchangePath `
                    -Force `
                    -ErrorAction Stop
            }
        }
    }
    elseif (Microsoft.PowerShell.Management\Test-Path `
            -LiteralPath $Layout.StateRoot) {
        # Legacy receipts and direct module callers without an authenticated
        # external native helper retain the original strict deletion path.
        Remove-DefenseClawPurgedStateRoot -Layout $Layout
    }
    if (Microsoft.PowerShell.Management\Test-Path -LiteralPath $Layout.StateRoot) {
        # Bulldoze posture: both the native-cleanup path and the Remove-Item
        # fallback above may fail to drain StateRoot if a handle is still
        # held (gateway service process didn't fully release, AV scan
        # racing). The install reconcile path has its own canonical ACL +
        # file re-creation self-heal (Set-DefenseClawPathAcl, re-read by
        # Assert-DefenseClawPathAcl); the next uninstall or install will mop
        # up what survived here. Refusing at this point strands the whole
        # lifecycle.
        if (Test-DefenseClawTrustStrictAncestors) {
            throw 'StateRoot survived authenticated purge'
        }
        Write-DefenseClawAclSelfHealAdvisory `
            -Path $Layout.StateRoot `
            -Reason 'StateRoot survived authenticated purge (handle contention); continuing bulldoze - next lifecycle self-heals'
    }
    if ($intentSchema -eq 2 -and
        [string]$intent.phase -cne 'state_root_removed') {
        $intent.phase = 'state_root_removed'
        $intent.updated_at = [DateTime]::UtcNow.ToString('o')
        Write-DefenseClawStatePurgeIntentAtomic `
            -Value ($intent |
                Microsoft.PowerShell.Utility\ConvertTo-Json -Depth 16) `
            -Layout $Layout
    }
    if ($intentSchema -eq 2) {
        [void](Remove-DefenseClawManagedHookContractCleanupReceipt `
            -Layout $Layout `
            -GatewayServiceName $GatewayServiceName `
            -GuardianServiceName $GuardianServiceName)
    }
    Microsoft.PowerShell.Management\Remove-Item `
        -LiteralPath $Layout.PurgeIntentPath `
        -Force
    if (Microsoft.PowerShell.Management\Test-Path `
        -LiteralPath $Layout.PurgeIntentPath) {
        throw 'state-purge intent survived completed purge'
    }
    $result = Get-DefenseClawLifecycleStatus `
        -Action 'Uninstall' `
        -Layout $Layout `
        -GatewayServiceName $GatewayServiceName `
        -GuardianServiceName $GuardianServiceName
    $result |
        Microsoft.PowerShell.Utility\Add-Member `
            -MemberType NoteProperty `
            -Name purged `
            -Value $true
    return $result
}

function Invoke-DefenseClawCommittedUserStatePurge {
    <#
        Runs "teardown-managed-hooks purge-user-state" with Setup's
        authenticated gateway: over a committed standalone uninstall
        tombstone whose hook teardown finalized, it removes each enrolled
        account's per-user data and binaries as the finalize of a purge does,
        and returns the same report (user_state_purged, user_state_remaining)
        for the uninstall result (GAP-2094, GAP-0867).
    #>
    param(
        [Parameter(Mandatory)][hashtable]$Layout,
        [Parameter(Mandatory)][string]$GatewayServiceName,
        [Parameter(Mandatory)][hashtable]$GatewaySource
    )
    $probe = Invoke-DefenseClawGatewayCommand `
        -Layout $Layout `
        -GatewayServiceName $GatewayServiceName `
        -GatewaySource $GatewaySource `
        -Arguments @(
            'enterprise',
            'windows',
            'teardown-managed-hooks',
            'purge-user-state',
            '--json'
        ) `
        -Capture `
        -AllowFailure
    $reports = [Collections.Generic.List[object]]::new()
    foreach ($line in @($probe.output)) {
        $text = ([string]$line).Trim()
        if (-not $text.StartsWith('{', [StringComparison]::Ordinal)) {
            continue
        }
        try {
            $reports.Add(($text | Microsoft.PowerShell.Utility\ConvertFrom-Json))
        }
        catch {
            throw "the per-user purge emitted malformed JSON: $text"
        }
    }
    if ($reports.Count -ne 1) {
        throw "the per-user purge emitted $($reports.Count) JSON reports; expected exactly one"
    }
    $report = $reports[0]
    if ([int]$report.schema_version -ne 4 -or
        [string]$report.action -cne 'purge-user-state') {
        throw 'the per-user purge returned an unsupported report'
    }
    $reportOK = $report.PSObject.Properties['ok']
    if ([int]$probe.exit_code -ne 0 -or
        $null -eq $reportOK -or
        $reportOK.Value -isnot [bool] -or
        -not [bool]$reportOK.Value) {
        $detail = if (-not [string]::IsNullOrWhiteSpace([string]$report.error)) {
            [string]$report.error
        }
        else {
            $probe.output
        }
        throw "the per-user purge failed: $(ConvertTo-DefenseClawBoundedDiagnostic -Value $detail)"
    }
    $manifestPath = [IO.Path]::GetFullPath([string]$report.manifest_path).TrimEnd('\')
    if (-not [string]::Equals(
            $manifestPath,
            [IO.Path]::GetFullPath([string]$Layout.ManifestPath).TrimEnd('\'),
            [StringComparison]::OrdinalIgnoreCase)) {
        throw "the per-user purge read a manifest outside the exact protected layout: $manifestPath"
    }
    return $report
}

function Invoke-DefenseClawTombstoneUserStatePurge {
    <#
        Over a committed standalone uninstall tombstone whose hook teardown
        already finalized (a plain uninstall interrupted after its finalize,
        or one whose InstallRoot is gone), only the finalize ever removed
        each enrolled account's per-user data and binaries, and it no longer
        runs. When this uninstall asks for that removal (PURGE=1), or the
        tombstone recorded it, Setup's gateway removes them by the finalize's
        rules, before the machine-state purge removes the target manifest
        they are read from (GAP-2094, GAP-0867). Returns the helper report,
        or $null when there is nothing to do here.
    #>
    param(
        [Parameter(Mandatory)][hashtable]$Layout,
        [Parameter(Mandatory)]$Metadata,
        [Parameter(Mandatory)][string]$GatewayServiceName,
        [hashtable]$GatewaySource
    )
    if ($null -eq $GatewaySource -or
        -not (Test-DefenseClawStandaloneProfile) -or
        (Test-DefenseClawMetadataInstalled -Metadata $Metadata) -or
        -not ([bool]$script:DefenseClawUninstallPurgeUserState -or
            (Get-DefenseClawTombstonePurgeUserStateRequested -Metadata $Metadata)) -or
        -not (Microsoft.PowerShell.Management\Test-Path `
            -LiteralPath $Layout.ManifestPath `
            -PathType Leaf)) {
        return $null
    }
    if (Microsoft.PowerShell.Management\Test-Path `
            -LiteralPath $Layout.ManagedHooksTeardownJournalPath `
            -PathType Leaf) {
        # An unfinished teardown is the finalize's own work.
        $phase = Get-DefenseClawManagedHooksTeardownJournalPhase `
            -Layout $Layout `
            -Metadata $Metadata `
            -GatewayServiceName $GatewayServiceName `
            -AllowLegacyInactive
        if ($phase -cne 'finalized') {
            return $null
        }
    }
    Write-DefenseClawLifecyclePhase -Stage 'per-user purge after a finalized uninstall teardown'
    $callerPurgeUserState = $script:DefenseClawUninstallPurgeUserState
    $script:DefenseClawUninstallPurgeUserState = $true
    try {
        return Invoke-DefenseClawCommittedUserStatePurge `
            -Layout $Layout `
            -GatewayServiceName $GatewayServiceName `
            -GatewaySource $GatewaySource
    }
    finally {
        $script:DefenseClawUninstallPurgeUserState = $callerPurgeUserState
    }
}

function Invoke-DefenseClawCommittedUninstallCleanup {
    param(
        [Parameter(Mandatory)][hashtable]$Layout,
        [Parameter(Mandatory)][string]$GatewayServiceName,
        [Parameter(Mandatory)][string]$GuardianServiceName,
        [switch]$Purge,
        # The deleting caller supplies its captured SID. Crash-resumed cleanup
        # recomputes it from the authenticated service name and requires an
        # exact match whenever both forms are available.
        [string]$GatewayServiceSID,
        [hashtable]$NativeCleanupSource,
        # Setup's own authenticated gateway, for the per-user purge an
        # uninstall with purge asks for after the finalize already ran.
        [hashtable]$UserStatePurgeSource
    )
    $metadata = Get-DefenseClawDeploymentMetadata -Layout $Layout -Required
    Assert-DefenseClawMetadataIdentity `
        -Metadata $metadata `
        -GatewayServiceName $GatewayServiceName `
        -GuardianServiceName $GuardianServiceName
    if (Test-DefenseClawMetadataInstalled -Metadata $metadata) {
        throw 'committed-uninstall cleanup requires an uninstall tombstone'
    }
    if (Microsoft.PowerShell.Management\Test-Path -LiteralPath $Layout.PendingPath) {
        throw 'committed-uninstall cleanup requires transaction retirement'
    }
    foreach ($name in @(Get-DefenseClawManagedServiceNames -GatewayServiceName $GatewayServiceName -GuardianServiceName $GuardianServiceName)) {
        if (Test-DefenseClawServiceExists -Name $name) {
            throw "committed-uninstall cleanup refused while service exists: $name"
        }
    }
    $cleanupGatewaySID = Resolve-DefenseClawRetiredGatewayServiceSID `
        -GatewayServiceName $GatewayServiceName `
        -GatewayServiceSID $GatewayServiceSID
    $finalization = $null
    $installRootIdentityProperty = $metadata.PSObject.Properties[
        'install_root_identity'
    ]
    $nativeInstallCleanup = (
        $null -ne $installRootIdentityProperty -and
        -not (Test-DefenseClawStandaloneProfile)
    )
    $teardownJournalPresent = Microsoft.PowerShell.Management\Test-Path `
        -LiteralPath $Layout.ManagedHooksTeardownJournalPath `
        -PathType Leaf
    if ($nativeInstallCleanup -and -not $teardownJournalPresent) {
        # Do not mistake an ACL-denied InstallRoot for an absent one after a
        # crash. A tombstone with no teardown journal is complete only when
        # the no-follow root probe proves that the old inode is gone.
        $nativeSecurity = Initialize-DefenseClawNativeSecurity
        $unretiredRoot =
            $nativeSecurity::GetDirectorySecuritySnapshotNoFollowIfExists(
                [string]$Layout.InstallRoot
            )
        if ($null -ne $unretiredRoot) {
            throw 'committed uninstall has InstallRoot but no teardown journal'
        }
    }
    $installRootNeedsCleanup = if ($nativeInstallCleanup) {
        $teardownJournalPresent
    }
    else {
        Microsoft.PowerShell.Management\Test-Path `
            -LiteralPath $Layout.InstallRoot `
            -PathType Container
    }
    if ($installRootNeedsCleanup) {
        if ($nativeInstallCleanup -and
            -not (Test-DefenseClawExternalInstallCleanupSource `
                -Layout $Layout `
                -Source $NativeCleanupSource)) {
            throw (
                'this committed uninstall requires its authenticated external ' +
                'cleanup executable; retry from DefenseClaw Setup'
            )
        }
        if (Test-DefenseClawStandaloneProfile) {
            # The committed process may have died before it began hook
            # removal. The tombstone and absent pending record authorize
            # resuming the same post-commit preparation here.
            $finalization = Complete-DefenseClawCommittedManagedHooksFinalization `
                -Layout $Layout `
                -GatewayServiceName $GatewayServiceName `
                -GuardianServiceName $GuardianServiceName `
                -Purge:$Purge
        }
        else {
            $teardownPhase = Get-DefenseClawManagedHooksTeardownJournalPhase `
                -Layout $Layout `
                -Metadata $metadata `
                -GatewayServiceName $GatewayServiceName `
                -AllowLegacyInactive
        }
        if (-not (Test-DefenseClawStandaloneProfile) -and
            $teardownPhase -ceq 'prepared') {
            if ($nativeInstallCleanup) {
                [void](Invoke-DefenseClawUninstallInstallRootNativeCleanup `
                    -Layout $Layout `
                    -Source $NativeCleanupSource `
                    -ExpectedIdentity ([string]$installRootIdentityProperty.Value) `
                    -GatewayServiceSID $cleanupGatewaySID `
                    -Operation seal_only)
            }
            $finalization = Complete-DefenseClawCommittedManagedHooksFinalization `
                -Layout $Layout `
                -GatewayServiceName $GatewayServiceName `
                -GuardianServiceName $GuardianServiceName `
                -Purge:$Purge `
                -NativeSealed:$nativeInstallCleanup
        }
        elseif (-not (Test-DefenseClawStandaloneProfile) -and
            $teardownPhase -ceq 'finalized') {
            if (-not $nativeInstallCleanup) {
                # The legacy remover needs a bounded Admin-only remainder.
                Assert-DefenseClawInstallTreeRetirementState -Layout $Layout
            }
        }
        elseif (-not (Test-DefenseClawStandaloneProfile)) {
            throw "committed uninstall has non-finalizable teardown phase: $teardownPhase"
        }
        if ($nativeInstallCleanup) {
            [void](Invoke-DefenseClawUninstallInstallRootNativeCleanup `
                -Layout $Layout `
                -Source $NativeCleanupSource `
                -ExpectedIdentity ([string]$installRootIdentityProperty.Value) `
                -GatewayServiceSID $cleanupGatewaySID `
                -Operation delete)
        }
        else {
            Remove-DefenseClawManagedTree `
                -Path $Layout.InstallRoot `
                -RequiredBase $script:ProgramFiles `
                -Label 'InstallRoot' `
                -AllowAFUnixSocketAt (Get-DefenseClawOptionalLayoutValue -Layout $Layout -Name ManagedIPCSocketPath)
        }
    }
    # A purge over a tombstone whose hook teardown already finalized ran no
    # finalize here; Setup's gateway removes the per-user state the
    # finalize would have (GAP-2094, GAP-0867).
    if ($Purge -and $null -eq $finalization) {
        $finalization = Invoke-DefenseClawTombstoneUserStatePurge `
            -Layout $Layout `
            -Metadata $metadata `
            -GatewayServiceName $GatewayServiceName `
            -GatewaySource $UserStatePurgeSource
    }
    [void](Remove-DefenseClawCommittedManagedHooksTeardownJournal `
        -Layout $Layout `
        -GatewayServiceName $GatewayServiceName `
        -GuardianServiceName $GuardianServiceName)
    Remove-DefenseClawCommittedManagedHooksSerializationLocks -Layout $Layout
    $machineStateRemaining = [string[]]@()
    if ($Purge -and (Test-DefenseClawStandaloneProfile)) {
        $machineStateRemaining = [string[]]@(
            @(Remove-DefenseClawRuntimeSelectorState -HookPath ([string]$Layout.HookPath) -Directories @(
                    [IO.Path]::Combine($script:ProgramFiles, 'ClaudeCode', 'managed-settings.d'),
                    [string]$Layout.CodexMachinePolicyDirectory,
                    [IO.Path]::Combine($script:ProgramData, 'Cursor')
                ))
        )
    }
    foreach ($ancestor in @($Layout.StateRootAncestors)) {
        Revoke-DefenseClawStateAncestorTraverse `
            -Path $ancestor `
            -GatewayServiceSID $cleanupGatewaySID
        if (Test-DefenseClawStandaloneVendorDirectory -Path $ancestor) {
            Revoke-DefenseClawStandaloneVendorUsersRead -Path $ancestor -Scope ([string]$Layout.StateRoot)
        }
    }
    if ($Purge) {
        [void](Publish-DefenseClawStatePurgeIntent `
            -Layout $Layout `
            -GatewayServiceName $GatewayServiceName `
            -GuardianServiceName $GuardianServiceName)
        $result = Complete-DefenseClawStatePurge `
            -Layout $Layout `
            -GatewayServiceName $GatewayServiceName `
            -GuardianServiceName $GuardianServiceName `
            -GatewayServiceSID $cleanupGatewaySID `
            -NativeCleanupSource $NativeCleanupSource
        $result |
            Microsoft.PowerShell.Utility\Add-Member `
                -MemberType NoteProperty `
                -Name cached_enterprise_clients_require_reload `
                -Value $true `
                -Force
        if ($null -ne $finalization) {
            $result = Add-DefenseClawUserRegistrationCleanupResult `
                -Result $result `
                -Layout $Layout `
                -Finalization $finalization
        }
        if (Test-DefenseClawStandaloneProfile) {
            # What a purge could not remove outside StateRoot, and what the
            # finalize kept, for the uninstall result's warnings.
            $finalizeKept = $result.PSObject.Properties['machine_state_remaining']
            $machineStateRemaining = [string[]]@(
                @($machineStateRemaining) +
                @(if ($null -ne $finalizeKept -and $null -ne $finalizeKept.Value) { @($finalizeKept.Value) }) +
                @(Remove-DefenseClawStaleRunDirectories -ProgramData $script:ProgramData -WindowsTemp ([IO.Path]::Combine($script:WindowsDirectory, 'Temp'))) +
                @(Remove-DefenseClawStandaloneOrphanedHookMachineState -Layout $Layout) +
                @(Remove-DefenseClawStandaloneHookRuntimeLeftovers)
            )
            $script:DefenseClawRemoveLifecycleLockOnExit = $true
            $result |
                Microsoft.PowerShell.Utility\Add-Member `
                    -MemberType NoteProperty `
                    -Name machine_state_remaining `
                    -Value $machineStateRemaining `
                    -Force
        }
        return $result
    }
    [void](Revoke-DefenseClawManagedIPCServiceAccess `
        -Layout $Layout `
        -GatewayServiceName $GatewayServiceName `
        -GatewayServiceSID $cleanupGatewaySID)
    $result = Get-DefenseClawLifecycleStatus `
        -Action 'Uninstall' `
        -Layout $Layout `
        -GatewayServiceName $GatewayServiceName `
        -GuardianServiceName $GuardianServiceName
    $result |
        Microsoft.PowerShell.Utility\Add-Member `
            -MemberType NoteProperty `
            -Name cached_enterprise_clients_require_reload `
            -Value $true `
            -Force
    if ($null -ne $finalization) {
        $result = Add-DefenseClawUserRegistrationCleanupResult `
            -Result $result `
            -Layout $Layout `
            -Finalization $finalization
    }
    return $result
}

function Assert-DefenseClawExactScopeServiceSecurity {
    param([Parameter(Mandatory)][string]$Name)
    if (-not (Test-DefenseClawServiceExists -Name $Name)) {
        return
    }
    # Secure Client teardown of a service this scope is about to delete: the
    # registry key and Security subkey are re-stamped first, and drift that
    # survives the repair is recorded and accepted. Standalone and the strict
    # pin keep the fatal check.
    $strict = (Test-DefenseClawTrustStrictAncestors) -or (Test-DefenseClawStandaloneProfile)
    if ($strict) {
        Assert-DefenseClawServiceRegistryAcl -Name $Name
    }
    else {
        try {
            Assert-DefenseClawServiceRegistryAcl -Name $Name -Repair
        }
        catch {
            Write-DefenseClawResilienceEvent -Marker defenseclaw_accept -Fields @{
                service = $Name
                reason  = "service registry drift remains after repair; continuing the removal: $($_.Exception.Message)"
            }
        }
    }
    # Native DACL-only read with the sc.exe sdshow fallback. A descriptor
    # that denies Administrators READ_CONTROL is not a reason to keep a
    # service this action is removing.
    try {
        $actualDACL = Get-DefenseClawServiceDacl -Name $Name
    }
    catch {
        if ($strict) {
            throw
        }
        Write-DefenseClawResilienceEvent -Marker defenseclaw_boundary -Fields @{
            service = $Name
            reason  = "SCM descriptor is unreadable to Administrators; continuing the removal: $($_.Exception.Message)"
        }
        return
    }
    if (-not [string]::Equals(
            $actualDACL,
            $script:ServiceSDDL,
            [StringComparison]::OrdinalIgnoreCase
        )) {
        # Bulldoze posture: SCM DACL drift on a service we're about to
        # delete is harmless. Common causes: GPO push, AV engine stamping
        # its own ACE, admin-run sc sdset. We're deleting the service
        # next; a pre-delete DACL assertion adds no safety.
        if (Test-DefenseClawTrustStrictAncestors) {
            throw "service $Name DACL drift: $actualDACL"
        }
        Write-DefenseClawAclSelfHealAdvisory `
            -Path "service:$Name" `
            -Reason "SCM DACL drift during uninstall (continuing bulldoze): $actualDACL"
    }
}

function Assert-DefenseClawExactScopeService {
    param(
        [Parameter(Mandatory)][hashtable]$Layout,
        [Parameter(Mandatory)][string]$GatewayServiceName,
        [Parameter(Mandatory)][string]$GuardianServiceName,
        [Parameter(Mandatory)]
        [ValidateSet('Gateway', 'Broker', 'SensorHelper', 'Guardian', 'Enumerator')]
        [string]$Role
    )
    $name = switch ($Role) {
        'Gateway' { $GatewayServiceName }
        'Broker' { [string]$Layout.BrokerServiceName }
        'SensorHelper' { [string]$Layout.SensorHelperServiceName }
        'Guardian' { $GuardianServiceName }
        'Enumerator' {
            Get-DefenseClawEnumeratorServiceName `
                -GuardianServiceName $GuardianServiceName
        }
    }
    if (-not (Test-DefenseClawServiceExists -Name $name)) {
        return
    }
    switch ($Role) {
        'Gateway' {
            Assert-DefenseClawOwnedServiceOrAbsent `
                -Name $name `
                -ExpectedGatewayPath $Layout.GatewayPath
        }
        'SensorHelper' {
            Assert-DefenseClawOwnedServiceOrAbsent `
                -Name $name `
                -ExpectedGatewayPath $Layout.SensorHelperPath `
                -ExpectedSensorHelperImage (Get-DefenseClawSensorHelperImage `
                    -Layout $Layout `
                    -GatewayServiceName $GatewayServiceName) `
                -SensorHelper
        }
        'Guardian' {
            Assert-DefenseClawOwnedServiceOrAbsent `
                -Name $name `
                -ExpectedGatewayPath $Layout.GatewayPath `
                -ExpectedManifestPath $Layout.ManifestPath `
                -Guardian
        }
        'Enumerator' {
            Assert-DefenseClawOwnedServiceOrAbsent `
                -Name $name `
                -ExpectedGatewayPath $Layout.GatewayPath `
                -ExpectedManifestPath $Layout.ManifestPath `
                -Enumerator
        }
        'Broker' {
            Assert-DefenseClawCMIDBrokerServiceOrAbsent `
                -Name $name `
                -ExpectedImage ('"{0}"' -f $Layout.BrokerPath) `
                -AllowArgumentUpgrade
            $serviceKey = "HKLM:\SYSTEM\CurrentControlSet\Services\$name"
            $image = [string](
                Microsoft.PowerShell.Management\Get-ItemPropertyValue `
                    -LiteralPath $serviceKey `
                    -Name ImagePath
            )
            # The --cmid-library pin is optional: a deployment installed
            # before Cloud Management (the full XDR order) registers the
            # broker without it and discovers the library at runtime.
            # Uninstall must recognise both shapes as canonical, otherwise
            # it would refuse to remove its own service.
            $expectedPrefix = (
                '"{0}" service --service-name {1} --gateway-service-name {2} ' +
                '--pipe-name {3} --auth-key "{4}"'
            ) -f `
                $Layout.BrokerPath, $name, $GatewayServiceName,
                $Layout.BrokerPipeName, $Layout.BrokerAuthKeyPath
            $expectedSuffix = ' --log "{0}"' -f $Layout.BrokerLogPath
            if (-not $image.StartsWith(
                    $expectedPrefix,
                    [StringComparison]::OrdinalIgnoreCase
                ) -or
                -not $image.EndsWith(
                    $expectedSuffix,
                    [StringComparison]::OrdinalIgnoreCase
                ) -or
                $image.Length -lt
                    ($expectedPrefix.Length + $expectedSuffix.Length)) {
                throw "refusing to remove credential broker service $name with a noncanonical ImagePath"
            }
            $pinnedLibraryArgument = $image.Substring(
                $expectedPrefix.Length,
                $image.Length - $expectedPrefix.Length -
                    $expectedSuffix.Length
            )
            if ($pinnedLibraryArgument.Length -gt 0) {
                $libraryPrefix = ' --cmid-library "'
                if (-not $pinnedLibraryArgument.StartsWith(
                        $libraryPrefix,
                        [StringComparison]::Ordinal
                    ) -or
                    -not $pinnedLibraryArgument.EndsWith(
                        '"',
                        [StringComparison]::Ordinal
                    ) -or
                    $pinnedLibraryArgument.Length -le
                        ($libraryPrefix.Length + 1)) {
                    throw "refusing to remove credential broker service $name with a noncanonical ImagePath"
                }
                $library = $pinnedLibraryArgument.Substring(
                    $libraryPrefix.Length,
                    $pinnedLibraryArgument.Length - $libraryPrefix.Length - 1
                )
                if ($library.IndexOf('"', [StringComparison]::Ordinal) -ge 0 -or
                    -not [string]::Equals(
                        [IO.Path]::GetFileName($library),
                        'cmidapi.dll',
                        [StringComparison]::OrdinalIgnoreCase
                    )) {
                    throw "refusing to remove credential broker service $name with a noncanonical provider path"
                }
                $providerRoot = [IO.Path]::Combine(
                    $script:ProgramFiles,
                    'Cisco',
                    'Cisco Secure Client',
                    'CM'
                )
                $canonicalLibrary = Assert-DefenseClawDescendant `
                    -Path $library `
                    -Root $providerRoot `
                    -Label 'credential broker service provider library'
                if (-not [string]::Equals(
                        $canonicalLibrary,
                        $library,
                        [StringComparison]::OrdinalIgnoreCase
                    )) {
                    throw "refusing to remove credential broker service $name with a noncanonical provider path"
                }
            }
        }
    }
    Assert-DefenseClawExactScopeServiceSecurity -Name $name
}

function Assert-DefenseClawNamespaceRootCleanupReport {
    param(
        [Parameter(Mandatory)]$Report,
        [Parameter(Mandatory)][string]$ExpectedRoot,
        [AllowEmptyString()][string]$ExpectedIdentity,
        [Parameter(Mandatory)][bool]$ValidateOnly,
        [Parameter(Mandatory)][bool]$ExpectedRootPresent,
        [switch]$AllowAbsentRoot,
        [switch]$ExpectSealOnly
    )
    $fields = @(
        'schema_version',
        'ok',
        'root',
        'expected_identity',
        'removed',
        'entries_removed',
        'error'
    )
    foreach ($property in @($Report.PSObject.Properties)) {
        if ([string]$property.Name -notin $fields) {
            throw 'exact-root cleanup report contains an unexpected property'
        }
    }
    foreach ($field in $fields) {
        if ($null -eq $Report.PSObject.Properties[$field]) {
            throw "exact-root cleanup report is missing $field"
        }
    }
    if (($Report.schema_version -isnot [int32] -and
            $Report.schema_version -isnot [int64]) -or
        [int64]$Report.schema_version -ne 1) {
        throw 'exact-root cleanup report has an unsupported schema version'
    }
    foreach ($field in @('ok', 'removed')) {
        if ($Report.$field -isnot [bool]) {
            throw "exact-root cleanup report has a non-Boolean $field"
        }
    }
    foreach ($field in @('root', 'expected_identity', 'error')) {
        if ($Report.$field -isnot [string]) {
            throw "exact-root cleanup report has a non-string $field"
        }
    }
    if (($Report.entries_removed -isnot [int32] -and
            $Report.entries_removed -isnot [int64]) -or
        [int64]$Report.entries_removed -lt 0) {
        throw 'exact-root cleanup report has an invalid entries_removed count'
    }
    if (-not [string]::Equals(
            [IO.Path]::GetFullPath([string]$Report.root).TrimEnd('\'),
            [IO.Path]::GetFullPath($ExpectedRoot).TrimEnd('\'),
            [StringComparison]::OrdinalIgnoreCase
        ) -or
        [string]$Report.expected_identity -cne $ExpectedIdentity) {
        throw 'exact-root cleanup report is not bound to the requested root identity'
    }
    if ($ValidateOnly -and
        ([bool]$Report.removed -or [int64]$Report.entries_removed -ne 0)) {
        throw 'exact-root validate-only report claims filesystem mutation'
    }
    if (-not $ValidateOnly -and [bool]$Report.ok) {
        if ($ExpectSealOnly) {
            if ([bool]$Report.removed -or
                [int64]$Report.entries_removed -ne 0) {
                throw 'exact-root seal report claims filesystem removal'
            }
        }
        elseif ($AllowAbsentRoot) {
            if (([bool]$Report.removed -and
                    [int64]$Report.entries_removed -lt 1) -or
                (-not [bool]$Report.removed -and
                    [int64]$Report.entries_removed -ne 0)) {
                throw 'exact-root cleanup report has an inconsistent idempotent removal result'
            }
        }
        elseif ([bool]$Report.removed -ne $ExpectedRootPresent) {
            throw 'exact-root cleanup report has an inconsistent removal result'
        }
    }
    if ([bool]$Report.ok -and
        -not [string]::IsNullOrWhiteSpace([string]$Report.error)) {
        throw 'successful exact-root cleanup report contains an error'
    }
    if (-not [bool]$Report.ok -and
        [string]::IsNullOrWhiteSpace([string]$Report.error)) {
        throw 'failed exact-root cleanup report omits its error'
    }
    return $Report
}

function Invoke-DefenseClawNamespaceRootCleanup {
    param(
        [Parameter(Mandatory)][hashtable]$Source,
        [Parameter(Mandatory)][Collections.IDictionary]$Request,
        [Parameter(Mandatory)][string]$RequestPath,
        [Parameter(Mandatory)][string]$ReportPath,
        [Parameter(Mandatory)][string]$ExchangeDirectory,
        [Parameter(Mandatory)][bool]$ExpectedRootPresent,
        [switch]$AllowAbsentRoot,
        [switch]$ExpectSealOnly
    )
    Write-DefenseClawProtectedTextAtomic `
        -Value ($Request |
            Microsoft.PowerShell.Utility\ConvertTo-Json -Depth 8 -Compress) `
        -Path $RequestPath `
        -RequiredRoot $ExchangeDirectory
    [void](New-DefenseClawTargetRuntimeExchangeFile `
        -Path $ReportPath `
        -TransactionDirectory $ExchangeDirectory)
    [void](Assert-DefenseClawSourceDescriptorCurrent -Source $Source)
    $probe = Invoke-DefenseClawProcess `
        -File ([string]$Source.path) `
        -Arguments @(
            'enterprise', 'windows', 'namespace-root-cleanup',
            '--request', $RequestPath,
            '--output', $ReportPath
        )
    $report = $null
    try {
        $report = Assert-DefenseClawNamespaceRootCleanupReport `
            -Report (Get-DefenseClawTargetRuntimeExchangeValue `
                -Path $ReportPath `
                -TransactionDirectory $ExchangeDirectory) `
            -ExpectedRoot ([string]$Request.root) `
            -ExpectedIdentity ([string]$Request.expected_identity) `
            -ValidateOnly ([bool]$Request.validate_only) `
            -ExpectedRootPresent $ExpectedRootPresent `
            -AllowAbsentRoot:$AllowAbsentRoot `
            -ExpectSealOnly:$ExpectSealOnly
    }
    catch {
        if ([int]$probe.exit_code -eq 0) {
            throw
        }
        $detail = ConvertTo-DefenseClawBoundedDiagnostic -Value $probe.output
        throw (
            "native exact-root cleanup failed with exit $($probe.exit_code): " +
            "$detail; protected report validation failed: $($_.Exception.Message)"
        )
    }
    if ([int]$probe.exit_code -ne 0 -or -not [bool]$report.ok) {
        $detail = ConvertTo-DefenseClawBoundedDiagnostic -Value @(
            [string]$report.error,
            $probe.output
        )
        throw (
            "native exact-root cleanup failed with exit $($probe.exit_code): " +
            $detail +
            (Get-DefenseClawNamespaceRootCleanupHolderText `
                -Root ([string]$Request.root) `
                -Failure ([string]$report.error))
        )
    }
    return $report
}

function Get-DefenseClawNamespaceRootCleanupHolderText {
    <#
        When the native exact-root cleanup refused a file another program
        kept open, the programs that hold files in Root now, as
        "; programs that hold files in <Root> now: ...". The printed next
        step of a failed FORCE=1 uninstall says to end or close each program
        the error names (GAP-0848); the native error names only the file.
        When none is found any more, it says so: the program has closed the
        file, and the same command can run again. '' for any other refusal.
    #>
    param(
        [Parameter(Mandatory)][string]$Root,
        [AllowEmptyString()][string]$Failure
    )
    if (-not $Failure.Contains('is held open by another program')) {
        return ''
    }
    $holders = @(try {
            Get-DefenseClawInstallRootHolders -InstallRoot $Root
        }
        catch {
            Microsoft.PowerShell.Utility\Write-Verbose "could not list the programs that hold files in ${Root}: $($_.Exception.Message)"
        })
    if ($holders.Count -eq 0) {
        return "; no program holds a file in $Root now, so the one that held it has closed it"
    }
    return '; programs that hold files in ' + $Root + ' now: ' +
        (ConvertTo-DefenseClawBoundedDiagnostic -Value ($holders -join '; ') -MaxLength 1024)
}

function Test-DefenseClawExternalInstallCleanupSource {
    param(
        [Parameter(Mandatory)][hashtable]$Layout,
        [hashtable]$Source
    )
    if ($null -eq $Source) {
        return $false
    }
    [void](Assert-DefenseClawSourceDescriptorCurrent -Source $Source)
    $sourcePath = [IO.Path]::GetFullPath([string]$Source.path).TrimEnd('\')
    $installRoot = [IO.Path]::GetFullPath(
        [string]$Layout.InstallRoot
    ).TrimEnd('\')
    return -not (
        [string]::Equals(
            $sourcePath,
            $installRoot,
            [StringComparison]::OrdinalIgnoreCase
        ) -or
        $sourcePath.StartsWith(
            $installRoot + '\',
            [StringComparison]::OrdinalIgnoreCase
        )
    )
}

function Invoke-DefenseClawUninstallInstallRootNativeCleanup {
    param(
        [Parameter(Mandatory)][hashtable]$Layout,
        [Parameter(Mandatory)][hashtable]$Source,
        [Parameter(Mandatory)][string]$ExpectedIdentity,
        [Parameter(Mandatory)][string]$GatewayServiceSID,
        [Parameter(Mandatory)]
        [ValidateSet('seal_only', 'delete')]
        [string]$Operation
    )
    if (-not (Test-DefenseClawExternalInstallCleanupSource `
            -Layout $Layout `
            -Source $Source)) {
        throw 'native uninstall InstallRoot cleanup requires an external executable'
    }
    if ($ExpectedIdentity -cnotmatch '^[a-f0-9]{8}:[a-f0-9]{16}$') {
        throw 'native uninstall InstallRoot cleanup requires the recorded root identity'
    }
    $request = [ordered]@{
        schema_version = 1
        mode = 'uninstall_install_purge'
        operation = $Operation
        root = [IO.Path]::GetFullPath(
            [string]$Layout.InstallRoot
        ).TrimEnd('\')
        expected_identity = $ExpectedIdentity
        gateway_service_sid = $GatewayServiceSID
        validate_only = $false
    }
    if (Test-DefenseClawStandaloneProfile) {
        $request['profile'] = 'standalone'
    }
    $requestPath = Microsoft.PowerShell.Management\Join-Path `
        $Layout.LifecycleLockDirectory `
        "install-root-cleanup-$($Layout.PurgeScopeSHA256)-request.json"
    $reportPath = Microsoft.PowerShell.Management\Join-Path `
        $Layout.LifecycleLockDirectory `
        "install-root-cleanup-$($Layout.PurgeScopeSHA256)-report.json"
    $report = Invoke-DefenseClawNamespaceRootCleanup `
        -Source $Source `
        -Request $request `
        -RequestPath $requestPath `
        -ReportPath $reportPath `
        -ExchangeDirectory $Layout.LifecycleLockDirectory `
        -ExpectedRootPresent:($Operation -eq 'delete') `
        -ExpectSealOnly:($Operation -eq 'seal_only') `
        -AllowAbsentRoot:($Operation -eq 'delete')
    foreach ($exchangePath in @($requestPath, $reportPath)) {
        if (Microsoft.PowerShell.Management\Test-Path `
                -LiteralPath $exchangePath `
                -PathType Leaf) {
            Microsoft.PowerShell.Management\Remove-Item `
                -LiteralPath $exchangePath `
                -Force `
                -ErrorAction Stop
        }
    }
    return $report
}

# State-absent purge has no authenticated deployment record from which to
# infer user or shared-connector ownership. It may therefore retire only this
# invocation's exact four SCM identities, their exact IPC grant, and one
# canonical install-root inode whose full tree is validated by the native
# no-follow cleanup primitive.
# A standalone uninstall that finds no recorded state (an administrator
# deleted C:\ProgramData\Cisco\DefenseClaw) cannot attribute anything per
# account, but the hook runtime folder beside StateRoot is DefenseClaw's own
# and only administrators can write it. It stayed, with its connector
# folders and the public policy summary (GAP-0533). This removes the
# folder. The Claude Code drop-ins and the runtime selector state go through
# Add-DefenseClawStandalonePurgeMachineLeftovers, which the caller runs next
# and which keeps a file that names another hook. It writes "path: reason"
# for what stays.
function Remove-DefenseClawUnattributedStandaloneHookRuntime {
    param([Parameter(Mandatory)][hashtable]$Layout)
    $hookRuntime = [IO.Path]::Combine(
        [IO.Path]::GetDirectoryName([IO.Path]::GetFullPath([string]$Layout.StateRoot).TrimEnd('\')),
        'DefenseClaw-HookRuntime'
    )
    if (Microsoft.PowerShell.Management\Test-Path -LiteralPath $hookRuntime) {
        try {
            Assert-DefenseClawPathAcl -Path $hookRuntime -AllowedWriterSIDs @($script:SystemSID, $script:AdministratorsSID, $script:TrustedInstallerSID) -AllowUsersRead -AllowInheritance
            Remove-DefenseClawManagedTree -Path $hookRuntime -RequiredBase $script:ProgramData -Label 'hook runtime'
        }
        catch {
            "${hookRuntime}: " + (ConvertTo-DefenseClawBoundedDiagnostic -Value $_.Exception.Message -MaxLength 512)
        }
    }
}

# The per-account folders a purge without recorded state leaves: it cannot
# tell DefenseClaw's files from the account's own there, so it names each
# account's %USERPROFILE%\.defenseclaw instead ("account (SID): path:
# reason") for an administrator to remove (GAP-0533).
function Get-DefenseClawUnattributedUserStateFolders {
    $profileList = 'HKLM:\SOFTWARE\Microsoft\Windows NT\CurrentVersion\ProfileList'
    foreach ($key in @(Microsoft.PowerShell.Management\Get-ChildItem -LiteralPath $profileList -ErrorAction SilentlyContinue)) {
        $sid = [string]$key.PSChildName
        if ($sid -cnotmatch '^S-1-(5-21|12-1)-[0-9-]+$') {
            continue
        }
        $profile = [Environment]::ExpandEnvironmentVariables(
            [string](Microsoft.PowerShell.Management\Get-ItemPropertyValue -LiteralPath $key.PSPath -Name ProfileImagePath -ErrorAction SilentlyContinue)
        )
        if ([string]::IsNullOrWhiteSpace($profile)) {
            continue
        }
        $folder = [IO.Path]::Combine($profile, '.defenseclaw')
        if (-not (Microsoft.PowerShell.Management\Test-Path -LiteralPath $folder -PathType Container)) {
            continue
        }
        $account = $sid
        try {
            $account = [Security.Principal.SecurityIdentifier]::new($sid).Translate([Security.Principal.NTAccount]).Value
        }
        catch {
            $account = $sid
        }
        "$account ($sid): ${folder}: the recorded deployment state was missing, so the uninstall could not tell DefenseClaw's files there from the account's own"
    }
}

function Invoke-DefenseClawExactScopeRecoveryPurge {
    param(
        [Parameter(Mandatory)][hashtable]$Layout,
        [Parameter(Mandatory)][hashtable]$Sources,
        [Parameter(Mandatory)][string]$GatewayServiceName,
        [Parameter(Mandatory)][string]$GuardianServiceName,
        [switch]$UntrustedStateRoot,
        [string]$UntrustedEvidenceReason
    )
    if (-not $Sources.ContainsKey('native_cleanup')) {
        throw 'exact-scope purge requires the authenticated native cleanup executable'
    }
    $nativeCleanup = [hashtable]$Sources['native_cleanup']
    [void](Assert-DefenseClawSourceDescriptorCurrent -Source $nativeCleanup)
    $cleanupSourcePath = [IO.Path]::GetFullPath(
        [string]$nativeCleanup.path
    ).TrimEnd('\')
    $installRootPath = [IO.Path]::GetFullPath(
        [string]$Layout.InstallRoot
    ).TrimEnd('\')
    if ([string]::Equals(
            $cleanupSourcePath,
            $installRootPath,
            [StringComparison]::OrdinalIgnoreCase
        ) -or
        $cleanupSourcePath.StartsWith(
            $installRootPath + '\',
            [StringComparison]::OrdinalIgnoreCase
        )) {
        throw (
            'exact-scope purge cannot run its cleanup executable from inside ' +
            'InstallRoot; rerun Uninstall -Purge from external Setup or a ' +
            'protected staged CLI'
        )
    }

    $managedServiceNames = @(Get-DefenseClawManagedServiceNames `
        -GatewayServiceName $GatewayServiceName `
        -GuardianServiceName $GuardianServiceName)
    $expectedServiceNames = @(
        $GatewayServiceName,
        [string]$Layout.BrokerServiceName,
        [string]$Layout.SensorHelperServiceName,
        $GuardianServiceName,
        (Get-DefenseClawEnumeratorServiceName `
            -GuardianServiceName $GuardianServiceName)
    )
    # Role -> exact service name. The standalone profile has no broker row.
    $roleServiceNames = @{
        Gateway = [string]$expectedServiceNames[0]
        Broker = [string]$expectedServiceNames[1]
        SensorHelper = [string]$expectedServiceNames[2]
        Guardian = [string]$expectedServiceNames[3]
        Enumerator = [string]$expectedServiceNames[4]
    }
    if ((Test-DefenseClawLayoutBrokerEnabled -Layout $Layout)) {
        $purgeRoles = @('Gateway', 'Broker', 'SensorHelper', 'Guardian', 'Enumerator')
        $teardownRoles = @('Enumerator', 'Guardian', 'Gateway', 'SensorHelper', 'Broker')
        if ($managedServiceNames.Count -ne 5 -or
            ($managedServiceNames -join "`n") -cne
                ($expectedServiceNames -join "`n")) {
            throw 'exact-scope purge did not resolve exactly five managed services'
        }
    }
    else {
        $purgeRoles = @('Gateway', 'SensorHelper', 'Guardian', 'Enumerator')
        $teardownRoles = @('Enumerator', 'Guardian', 'Gateway', 'SensorHelper')
        $standaloneExpected = @($purgeRoles | Microsoft.PowerShell.Core\ForEach-Object {
            [string]$roleServiceNames[$_]
        })
        if ($managedServiceNames.Count -ne 4 -or
            ($managedServiceNames -join "`n") -cne
                ($standaloneExpected -join "`n")) {
            throw 'exact-scope purge did not resolve exactly four standalone managed services'
        }
    }
    # Keep the primary service identity checks visibly inside this destructive
    # boundary; the role helper repeats them immediately before each delete.
    Assert-DefenseClawOwnedServiceOrAbsent `
        -Name $GatewayServiceName `
        -ExpectedGatewayPath $Layout.GatewayPath
    Assert-DefenseClawOwnedServiceOrAbsent `
        -Name $GuardianServiceName `
        -ExpectedGatewayPath $Layout.GatewayPath `
        -ExpectedManifestPath $Layout.ManifestPath `
        -Guardian
    foreach ($role in $purgeRoles) {
        Assert-DefenseClawExactScopeService `
            -Layout $Layout `
            -GatewayServiceName $GatewayServiceName `
            -GuardianServiceName $GuardianServiceName `
            -Role $role
    }

    $gatewaySID = Get-DefenseClawServiceSIDForRecovery `
        -ServiceName $GatewayServiceName
    $nativeSecurity = Initialize-DefenseClawNativeSecurity
    $rootBefore = $nativeSecurity::GetDirectorySecuritySnapshotNoFollowIfExists(
        [string]$Layout.InstallRoot
    )
    $rootPresent = $null -ne $rootBefore
    $rootIdentity = if ($rootPresent) {
        ([string]$rootBefore.Identity).ToLowerInvariant()
    }
    else {
        ''
    }
    if ($rootPresent -and
        $rootIdentity -cnotmatch '^[a-f0-9]{8}:[a-f0-9]{16}$') {
        throw 'exact-scope install root has an invalid native identity'
    }
    $request = [ordered]@{
        schema_version = 1
        root = [IO.Path]::GetFullPath(
            [string]$Layout.InstallRoot
        ).TrimEnd('\')
        expected_identity = $rootIdentity
        gateway_service_sid = $gatewaySID
        validate_only = $true
    }
    if (Test-DefenseClawStandaloneProfile) {
        # The native boundary accepts only the named profile's exact layouts;
        # Secure Client requests keep their original shape.
        $request['profile'] = 'standalone'
    }
    $requestPath = Microsoft.PowerShell.Management\Join-Path `
        $Layout.LifecycleLockDirectory `
        "namespace-root-cleanup-$($Layout.PurgeScopeSHA256)-request.json"
    $reportPath = Microsoft.PowerShell.Management\Join-Path `
        $Layout.LifecycleLockDirectory `
        "namespace-root-cleanup-$($Layout.PurgeScopeSHA256)-report.json"

    # Quiesce every surviving exact service while retaining its authenticated
    # SCM row as recovery authority. Quiescence releases mapped binaries so
    # the native helper can prove exclusive destructive access to every inode;
    # no IPC grant, service row, registry key, or file is removed yet.
    foreach ($role in $teardownRoles) {
        $name = [string]$roleServiceNames[$role]
        if (-not (Test-DefenseClawServiceExists -Name $name)) {
            continue
        }
        Assert-DefenseClawExactScopeService `
            -Layout $Layout `
            -GatewayServiceName $GatewayServiceName `
            -GuardianServiceName $GuardianServiceName `
            -Role $role
        Set-DefenseClawServiceStartMode `
            -Name $name `
            -StartMode 4
        Stop-DefenseClawService -Name $name
        Assert-DefenseClawExactScopeService `
            -Layout $Layout `
            -GatewayServiceName $GatewayServiceName `
            -GuardianServiceName $GuardianServiceName `
            -Role $role
    }

    # Standalone keeps its managed IPC directory (gateway and sensor helper
    # sockets) and the managed OpenCode plugin under InstallRoot with
    # descriptors the native exact-root validator does not adopt, so a
    # state-absent purge refused the root ("foreign descriptor" on ...\ipc,
    # GAP-0250). With every service stopped they hold at most stale socket
    # leaves and the plugin: remove them as the regular uninstall does. Both
    # refuse unexpected content before deleting anything; Ensure recreates
    # them. Secure Client is unchanged: both return at once there.
    Remove-DefenseClawStandaloneManagedIPCDirectory -Layout $Layout
    Remove-DefenseClawSecureClientSensorHelperSocket -Layout $Layout
    Remove-DefenseClawStandaloneOpenCodeManagedPlugin -Layout $Layout

    # With exact services stopped, prove the whole root is canonical and that
    # every inode can be opened with the same no-sharing destructive access
    # required by the removal pass. Failure leaves all SCM rows available for
    # an authenticated retry and does not revoke IPC or mutate the filesystem
    # (beyond the standalone IPC directory and plugin above).
    [void](Invoke-DefenseClawNamespaceRootCleanup `
        -Source $nativeCleanup `
        -Request $request `
        -RequestPath $requestPath `
        -ReportPath $reportPath `
        -ExchangeDirectory $Layout.LifecycleLockDirectory `
        -ExpectedRootPresent $rootPresent)

    # Retire the exact shared-IPC writer while SCM still authenticates the
    # captured gateway SID. If IPC or root cleanup fails, every surviving row
    # remains stopped and disabled for an authenticated retry.
    $gatewayServicePresent = Test-DefenseClawServiceExists `
        -Name $GatewayServiceName
    if ($gatewayServicePresent) {
        Assert-DefenseClawExactScopeService `
            -Layout $Layout `
            -GatewayServiceName $GatewayServiceName `
            -GuardianServiceName $GuardianServiceName `
            -Role Gateway
        [void](Revoke-DefenseClawManagedIPCServiceAccess `
            -Layout $Layout `
            -GatewayServiceName $GatewayServiceName `
            -GatewayServiceSID $gatewaySID `
            -TransactionCreatedServicePresent)
    }
    else {
        [void](Revoke-DefenseClawManagedIPCServiceAccess `
            -Layout $Layout `
            -GatewayServiceName $GatewayServiceName `
            -GatewayServiceSID $gatewaySID)
    }

    $request.validate_only = $false
    [void](Invoke-DefenseClawNamespaceRootCleanup `
        -Source $nativeCleanup `
        -Request $request `
        -RequestPath $requestPath `
        -ReportPath $reportPath `
        -ExchangeDirectory $Layout.LifecycleLockDirectory `
        -ExpectedRootPresent $rootPresent)

    # Root retirement succeeded. Reauthenticate each remaining exact SCM row
    # immediately before deleting it; similarly named or drifted rows remain
    # untouched and fail the recovery closed.
    foreach ($role in $teardownRoles) {
        Assert-DefenseClawExactScopeService `
            -Layout $Layout `
            -GatewayServiceName $GatewayServiceName `
            -GuardianServiceName $GuardianServiceName `
            -Role $role
        $name = [string]$roleServiceNames[$role]
        Remove-DefenseClawService -Name $name
    }
    foreach ($path in @($requestPath, $reportPath)) {
        if (Microsoft.PowerShell.Management\Test-Path `
                -LiteralPath $path `
                -PathType Leaf) {
            Microsoft.PowerShell.Management\Remove-Item `
                -LiteralPath $path `
                -Force
        }
    }

    if ($UntrustedStateRoot) {
        # No authenticated install-time StateRoot identity survives a normal
        # install outside deployment.json. The exact-scope cleanup above has
        # retired every service identity we could prove and the canonical
        # InstallRoot inode. We do NOT touch StateRoot here because we
        # cannot attribute user runtime, hook contract, or shared connector
        # state back to this scope.
        #
        # Product posture (bulldoze): return ok:true so the AVC MSI treats
        # the uninstall as complete and does not block subsequent install
        # or upgrade attempts. The next install's reconcile branch bulldozes
        # through any StateRoot residue via Set-DefenseClawPathAcl's canonical
        # re-stamp, which strips an orphan per-service SID; on standalone a
        # write grant the re-stamp cannot remove still refuses that install
        # (GAP-0010).
        # Operators who need strict refuse-on-drift reporting can set
        # DEFENSECLAW_MANAGED_TRUST_STRICT_ANCESTORS=1 to restore the
        # pre-bulldoze ok:false posture.
        $reason = ConvertTo-DefenseClawBoundedDiagnostic -Value @(
            $UntrustedEvidenceReason
        )
        $incomplete = (
            'DefenseClaw exact-scope cleanup retired or confirmed absent ' +
            'services and InstallRoot; StateRoot and unattributed ' +
            'user/connector state were preserved because deployment ' +
            "evidence is untrusted ($reason). The next install's canonical " +
            'ACL re-stamp will reset any residual DACL drift.'
        )
        if (Test-DefenseClawTrustStrictAncestors) {
            return [pscustomobject]@{
                schema_version = 1
                ok = $false
                action = 'uninstall'
                installed = $false
                purged = $false
                exact_scope_recovery = $true
                partial_cleanup = $true
                state_root_cleanup_skipped = $true
                unattributed_user_state_preserved = $true
                cached_enterprise_clients_require_reload = $true
                error = $incomplete
                errors = @($incomplete)
                warnings = @($incomplete)
            }
        }
        Microsoft.PowerShell.Utility\Write-Warning -Message (
            '{0}: {1}' -f $script:AclSelfHealMarker, $incomplete
        )
        return [pscustomobject]@{
            schema_version = 1
            ok = $true
            action = 'uninstall'
            installed = $false
            purged = $true
            exact_scope_recovery = $true
            partial_cleanup = $true
            state_root_cleanup_skipped = $true
            unattributed_user_state_preserved = $true
            cached_enterprise_clients_require_reload = $true
            errors = @()
            warnings = @($incomplete)
        }
    }
    $result = [pscustomobject]@{
        schema_version = 1
        ok = $true
        action = 'uninstall'
        installed = $false
        purged = $true
        exact_scope_recovery = $true
        unattributed_user_state_preserved = $true
        cached_enterprise_clients_require_reload = $true
        errors = @()
    }
    if (Test-DefenseClawStandaloneProfile) {
        $result | Microsoft.PowerShell.Utility\Add-Member -MemberType NoteProperty -Name machine_state_remaining -Value ([string[]]@(
                @(Remove-DefenseClawUnattributedStandaloneHookRuntime -Layout $Layout) +
                @(Remove-DefenseClawStaleRunDirectories -ProgramData $script:ProgramData -WindowsTemp ([IO.Path]::Combine($script:WindowsDirectory, 'Temp')))
            ))
        if ([bool]$script:DefenseClawUninstallPurgeUserState) {
            $result | Microsoft.PowerShell.Utility\Add-Member -MemberType NoteProperty -Name user_state_remaining -Value ([string[]]@(
                    Get-DefenseClawUnattributedUserStateFolders))
        }
    }
    return $result
}

$script:DefenseClawUnfinishedTransactionDirectory = 'unfinished transaction directory'

function Get-DefenseClawUnfinishedLifecycleEvidence {
    <#
        Names every protected lifecycle record that is present, in a fixed
        order: each one is a step only the full recovery of a later run
        replays. A metadata-free purge refuses while one remains, and so does
        Setup's timeout recovery before it reports a settled deployment.
    #>
    param([Parameter(Mandatory)][hashtable]$Layout)
    $nativeSecurity = Initialize-DefenseClawNativeSecurity
    $found = [Collections.Generic.List[string]]::new()
    foreach ($evidence in @(
        @('pending transaction', [string]$Layout.PendingPath),
        @('managed-hook lifecycle journal',
            [string]$Layout.ManagedHooksLifecycleJournalPath),
        @('managed-hook teardown journal',
            [string]$Layout.ManagedHooksTeardownJournalPath),
        @('state-purge intent', [string]$Layout.PurgeIntentPath),
        @('self-uninstall receipt', [string]$Layout.SelfUninstallReceiptPath),
        @('install-rollback intent', [string]$Layout.InstallRollbackIntentPath),
        @('connector cleanup receipt',
            [string]$Layout.ManagedHookContractCleanupReceiptPath)
    )) {
        if ($null -ne
            $nativeSecurity::GetRegularFileSecuritySnapshotNoFollowIfExists(
                [string]$evidence[1]
            )) {
            $found.Add([string]$evidence[0])
        }
    }
    $transactionDirectory =
        $nativeSecurity::GetDirectorySecuritySnapshotNoFollowIfExists(
            [string]$Layout.TransactionsDirectory
        )
    if ($null -ne $transactionDirectory -and
        @(Microsoft.PowerShell.Management\Get-ChildItem `
            -LiteralPath $Layout.TransactionsDirectory `
            -Force -ErrorAction Stop |
            Microsoft.PowerShell.Utility\Select-Object -First 1).Count -gt 0) {
        $found.Add($script:DefenseClawUnfinishedTransactionDirectory)
    }
    return $found.ToArray()
}

function Get-DefenseClawTombstonePurgeRequested {
    <#
        The uninstall mode an authenticated standalone tombstone recorded at
        its commit. Recovery replays exactly this mode. Tombstones written
        before 1.0.4 record none and replay as the state-keeping uninstall,
        so recovery never deletes state nobody asked to purge; an explicit
        Uninstall -Purge still purges them. Keep the missing-field case while
        1.0.0-1.0.3 tombstones can be upgraded.
    #>
    param([Parameter(Mandatory)]$Metadata)
    $property = $Metadata.PSObject.Properties['uninstall_purge_requested']
    if ($null -eq $property) {
        return $false
    }
    if ($property.Value -isnot [bool]) {
        throw 'uninstall tombstone has an invalid recorded purge mode'
    }
    return [bool]$property.Value
}

function Get-DefenseClawTombstonePurgeUserStateRequested {
    <#
        Whether the uninstall an authenticated standalone tombstone recorded
        also removes each enrolled account's per-user data and binaries
        (Setup /uninstall PURGE=1). The managed-hook finalize does that
        removal, so its replay by a recovery or a retry that did not ask for
        it still does it. Tombstones written before 1.0.4 record none and
        replay without it; keep the missing-field case while 1.0.0-1.0.3
        tombstones can be upgraded. A malformed mode, or a per-user purge
        without the uninstall purge it is part of, is refused.
    #>
    param([Parameter(Mandatory)]$Metadata)
    $property = $Metadata.PSObject.Properties['uninstall_purge_user_state_requested']
    if ($null -eq $property) {
        return $false
    }
    if ($property.Value -isnot [bool]) {
        throw 'uninstall tombstone has an invalid recorded per-user purge mode'
    }
    if ([bool]$property.Value -and
        -not (Get-DefenseClawTombstonePurgeRequested -Metadata $Metadata)) {
        throw 'uninstall tombstone records a per-user purge without its uninstall purge'
    }
    return [bool]$property.Value
}

function Test-DefenseClawCommittedUninstallUnsettled {
    <#
        Whether a committed standalone uninstall still has postcommit work:
        its recorded purge has not removed the tombstone (the tombstone goes
        with StateRoot), or InstallRoot or the managed-hook teardown journal
        remains. A settled state-keeping uninstall keeps its tombstone for
        good and is not replayed. A malformed recorded mode is refused before
        any cleanup. Setup's recovery watcher decides the same way
        (standaloneCommittedUninstallUnsettled).
    #>
    param(
        [Parameter(Mandatory)][hashtable]$Layout,
        [Parameter(Mandatory)]$Metadata
    )
    if ((Get-DefenseClawTombstonePurgeUserStateRequested -Metadata $Metadata) -or
        (Get-DefenseClawTombstonePurgeRequested -Metadata $Metadata)) {
        return $true
    }
    return [bool](
        (Test-DefenseClawPathPresentNoFollow -Path ([string]$Layout.InstallRoot)) -or
        (Test-DefenseClawPathPresentNoFollow `
            -Path ([string]$Layout.ManagedHooksTeardownJournalPath))
    )
}

function Invoke-DefenseClawTimeoutRecovery {
    <#
        Setup's one bounded recovery after it stopped a lifecycle child at
        TIMEOUTSECONDS (GAP-0501). The interrupted request is gone, so it
        replays pending.json and independently completes an unsettled
        authenticated committed uninstall in the mode its tombstone recorded.
        It runs no new install. A recovery is settled only after postcommit
        hook cleanup and every remaining lifecycle record have been checked.
    #>
    param(
        [Parameter(Mandatory)][hashtable]$Layout,
        [Parameter(Mandatory)][string]$GatewayServiceName,
        [Parameter(Mandatory)][string]$GuardianServiceName
    )
    if (Microsoft.PowerShell.Management\Test-Path -LiteralPath $Layout.PendingPath -PathType Leaf) {
        [void](Recover-DefenseClawPendingTransaction `
            -Layout $Layout `
            -GatewayServiceName $GatewayServiceName `
            -GuardianServiceName $GuardianServiceName)
    }
    $keptStateTombstone = $null
    if ((Test-DefenseClawStandaloneProfile) -and
        -not (Microsoft.PowerShell.Management\Test-Path `
            -LiteralPath $Layout.PendingPath `
            -PathType Leaf)) {
        $metadata = Get-DefenseClawDeploymentMetadata -Layout $Layout
        if ($null -ne $metadata) {
            Assert-DefenseClawMetadataIdentity `
                -Metadata $metadata `
                -GatewayServiceName $GatewayServiceName `
                -GuardianServiceName $GuardianServiceName
            if (-not (Test-DefenseClawMetadataInstalled -Metadata $metadata)) {
                $recordedPurge = Get-DefenseClawTombstonePurgeRequested `
                    -Metadata $metadata
                if (Test-DefenseClawCommittedUninstallUnsettled `
                        -Layout $Layout `
                        -Metadata $metadata) {
                    # The absent pending record is the commit point. The
                    # tombstone, installed artifact hashes, service absence
                    # and teardown journal are rechecked by this idempotent
                    # cleanup before any hook registration is removed. It
                    # purges only when the uninstall asked for it.
                    [void](Invoke-DefenseClawCommittedUninstallCleanup `
                        -Layout $Layout `
                        -GatewayServiceName $GatewayServiceName `
                        -GuardianServiceName $GuardianServiceName `
                        -Purge:$recordedPurge)
                }
                if (-not $recordedPurge) {
                    $keptStateTombstone = $metadata
                }
            }
        }
    }
    $status = Get-DefenseClawLifecycleStatus `
        -Action Recover `
        -Layout $Layout `
        -GatewayServiceName $GatewayServiceName `
        -GuardianServiceName $GuardianServiceName
    if ([bool]$status.transaction_pending) {
        throw 'the lifecycle recovery is still pending; the protected journal was kept'
    }
    $unfinished = @(Get-DefenseClawUnfinishedLifecycleEvidence -Layout $Layout)
    if ($null -ne $keptStateTombstone -and
        $unfinished -ccontains 'connector cleanup receipt') {
        # A state-keeping uninstall keeps its connector cleanup receipt for
        # the retained-state Install or a later purge. Bound to this
        # tombstone it is the settled record of that uninstall, not work.
        [void](Get-DefenseClawManagedHookContractCleanupReceipt `
            -Layout $Layout `
            -GatewayServiceName $GatewayServiceName `
            -GuardianServiceName $GuardianServiceName `
            -Metadata $keptStateTombstone `
            -Required)
        $unfinished = @($unfinished |
            Microsoft.PowerShell.Core\Where-Object {
                $_ -cne 'connector cleanup receipt'
            })
    }
    if ($unfinished.Count -gt 0) {
        throw (
            'Setup recovery did not settle the deployment: these lifecycle ' +
            'records remain for the full recovery of an ensure run as ' +
            'LocalSystem: ' +
            ($unfinished -join ', ')
        )
    }
    return $status
}

function Test-DefenseClawUninstallUsesUntrustedMetadataPurge {
    <#
        Whether an uninstall whose deployment evidence is untrusted takes the
        metadata-free exact-scope purge. p0-round:GAP-1365: a first install
        killed before it wrote deployment.json leaves StateRoot with its
        pending transaction and no record. That purge refuses to bypass the
        transaction, so the first Setup /uninstall FORCE=1 ended 1603 and
        only a retry finished. A forced uninstall reads nothing of the
        transaction: when the record is missing from an existing admin-only
        StateRoot (-MetadataMissing, set only there) it goes on as the
        forced uninstall, which the retry did. Every other untrusted case,
        a present record that fails its owner, ACL, reparse, link or content
        check included, keeps the metadata-free purge with FORCE as without
        (p0-round:GAP-1585), and nothing changes without FORCE.
    #>
    param(
        [string]$Reason,
        [bool]$MetadataMissing,
        [switch]$Force
    )
    if ([string]::IsNullOrWhiteSpace($Reason)) {
        return $false
    }
    if ($Force -and $MetadataMissing) {
        return $false
    }
    return $true
}

function Test-DefenseClawForcedUninstallStateRootAdminOnly {
    <#
        p0-round:GAP-1585, GAP-1586: whether ProgramData and the StateRoot
        ancestors cannot replace StateRoot, and StateRoot and its install
        folder when it exists are plain folders (no reparse point) that only
        SYSTEM, Administrators and TrustedInstaller own or can write, as the
        uninstall ACL recovery requires of them. A record missing from a
        StateRoot someone else could write may have been deleted through
        that weakened ACL; then the forced route is not taken.
    #>
    param([Parameter(Mandatory)][hashtable]$Layout)
    $admins = @(
        $script:SystemSID,
        $script:AdministratorsSID,
        $script:TrustedInstallerSID
    )
    try {
        # The ancestors first: a user-owned or user-replaceable vendor
        # folder could have swapped StateRoot (p0-round:GAP-1586).
        Assert-DefenseClawStateRootAncestorsAdminOnly -Layout $Layout
        $nativeSecurity = Initialize-DefenseClawNativeSecurity
        foreach ($candidate in @(
                [string]$Layout.StateRoot,
                [string]$Layout.InstallStateDirectory
            )) {
            if ([string]::IsNullOrWhiteSpace($candidate)) {
                continue
            }
            # Test-Path can misreport an ACL-denied folder as absent; the
            # no-follow snapshot cannot.
            if ($candidate -ne [string]$Layout.StateRoot -and
                $null -eq $nativeSecurity::GetDirectorySecuritySnapshotNoFollowIfExists($candidate)) {
                continue
            }
            Assert-DefenseClawNoReparsePath -Path $candidate
            $verdicts = @(Get-DefenseClawPathAclVerdicts `
                -Path $candidate `
                -AllowedWriterSIDs $admins `
                -RequiredRights (New-DefenseClawRequiredRights -Kind Admin) `
                -AllowedOwnerSIDs $admins `
                -AllowInheritance)
            $unsafe = @($verdicts |
                Microsoft.PowerShell.Core\Where-Object { $_.Kind -ne 'Rights' })
            if ($unsafe.Count -gt 0) {
                return $false
            }
        }
        return $true
    }
    catch {
        return $false
    }
}

function Invoke-DefenseClawUntrustedMetadataRecoveryPurge {
    param(
        [Parameter(Mandatory)][hashtable]$Layout,
        [Parameter(Mandatory)][hashtable]$Sources,
        [Parameter(Mandatory)][string]$GatewayServiceName,
        [Parameter(Mandatory)][string]$GuardianServiceName,
        [Parameter(Mandatory)][string]$Reason
    )
    # A live transaction or external receipt may own the next uninstall
    # action. Do not bypass its replay by running the metadata-free sweep.
    foreach ($evidence in @(Get-DefenseClawUnfinishedLifecycleEvidence -Layout $Layout)) {
        if ($evidence -ceq $script:DefenseClawUnfinishedTransactionDirectory) {
            throw (
                'untrusted deployment evidence has an unfinished transaction ' +
                'directory; exact-scope fallback did not modify the deployment'
            )
        }
        throw (
            'untrusted deployment evidence requires authenticated ' +
            "recovery of the existing $evidence; exact-scope " +
            'fallback did not modify the deployment'
        )
    }
    try {
        return Invoke-DefenseClawExactScopeRecoveryPurge `
            -Layout $Layout `
            -Sources $Sources `
            -GatewayServiceName $GatewayServiceName `
            -GuardianServiceName $GuardianServiceName `
            -UntrustedStateRoot `
            -UntrustedEvidenceReason $Reason
    }
    catch {
        throw (
            'metadata-free exact-scope purge did not finish; verified ' +
            'services may now be stopped or disabled; StateRoot was not ' +
            'touched. Retry with external Setup after resolving the ' +
            "reported blocker: $($_.Exception.Message)"
        )
    }
}

function Invoke-DefenseClawPreLayoutRecovery {
    param(
        [Parameter(Mandatory)][string]$Action,
        [Parameter(Mandatory)][hashtable]$Layout,
        [hashtable]$Sources = @{},
        [Parameter(Mandatory)][string]$GatewayServiceName,
        [Parameter(Mandatory)][string]$GuardianServiceName,
        [switch]$Purge,
        [string]$RequestedCertificationCodexHome,
        [switch]$RequestedCoreHardeningCertification,
        [int]$SelfUninstallCallerPID
    )
    $nativeCleanupSource = if ($Sources.ContainsKey('native_cleanup')) {
        [hashtable]$Sources['native_cleanup']
    }
    elseif ($Action -eq 'Install' -and $Sources.ContainsKey('gateway')) {
        # Retained-state reinstall runs before the incoming gateway is copied
        # into InstallRoot. Its authenticated source descriptor can execute
        # the same hidden cleanup command without depending on the retired
        # installation or the uninstall-only NativeCleanupBinary argument.
        [hashtable]$Sources['gateway']
    }
    else {
        $null
    }
    # A self-uninstall receipt can be the final surviving authority after both
    # canonical InstallRoot retirement and StateRoot purge. Recover it before
    # purge receipts, tombstones, or any fresh canonical directory creation.
    $selfUninstallRecovery = Invoke-DefenseClawSelfUninstallRecovery `
        -Action $Action `
        -Layout $Layout `
        -GatewayServiceName $GatewayServiceName `
        -GuardianServiceName $GuardianServiceName `
        -Purge:$Purge `
        -SelfUninstallCallerPID $SelfUninstallCallerPID
    if ([bool]$selfUninstallRecovery.handled) {
        return $selfUninstallRecovery
    }
    $installRollbackIntent = Get-DefenseClawInstallRollbackIntent `
        -Layout $Layout `
        -GatewayServiceName $GatewayServiceName `
        -GuardianServiceName $GuardianServiceName
    # Older Setup builds could publish a fresh-install preparation receipt
    # before rejecting a deferred Install over an active deployment. It owns
    # no state. Authenticate and retire only that exact unclaimed receipt so
    # Repair and Ensure can recover without purging the enforcing install.
    if ($null -ne $installRollbackIntent -and
        [string]$installRollbackIntent.phase -ceq 'preparing_layout' -and
        [string]::IsNullOrWhiteSpace([string]$installRollbackIntent.snapshot_path)) {
        $activeMetadata = Get-DefenseClawDeploymentMetadata -Layout $Layout
        if ($null -ne $activeMetadata -and
            (Test-DefenseClawMetadataInstalled -Metadata $activeMetadata)) {
            Remove-DefenseClawUnclaimedInstallPreparationIntent `
                -Layout $Layout `
                -GatewayServiceName $GatewayServiceName `
                -GuardianServiceName $GuardianServiceName
            $installRollbackIntent = $null
        }
    }
    if ($null -ne $installRollbackIntent) {
        if ([string]$installRollbackIntent.phase -ceq 'committed') {
            Complete-DefenseClawCommittedInstallIntent `
                -Layout $Layout `
                -GatewayServiceName $GatewayServiceName `
                -GuardianServiceName $GuardianServiceName
            $installRollbackIntent = $null
        }
        elseif ([string]$installRollbackIntent.phase -ceq
            'preparing_layout' -and
            -not [string]::IsNullOrWhiteSpace(
                [string]$installRollbackIntent.snapshot_path
            )) {
            $intentNativeSecurity = Initialize-DefenseClawNativeSecurity
            $stateRoot =
                $intentNativeSecurity::GetDirectorySecuritySnapshotNoFollowIfExists(
                    [string]$Layout.StateRoot
                )
            if ($null -eq $stateRoot -or
                $null -eq
                    $intentNativeSecurity::GetRegularFileSecuritySnapshotNoFollowIfExists(
                        [string]$Layout.PendingPath
                    )) {
                throw (
                    'bound install preparation lost its protected pending ' +
                    'transaction; recovery evidence was retained'
                )
            }
            $recovered = Recover-DefenseClawPendingTransaction `
                -Layout $Layout `
                -GatewayServiceName $GatewayServiceName `
                -GuardianServiceName $GuardianServiceName
            if (-not [bool]$recovered.recovered) {
                throw 'bound install preparation transaction was not recovered'
            }
            $installRollbackIntent = $null
            if ($Action -eq 'Uninstall' -and $Purge) {
                $result = Get-DefenseClawLifecycleStatus `
                    -Action 'Uninstall' `
                    -Layout $Layout `
                    -GatewayServiceName $GatewayServiceName `
                    -GuardianServiceName $GuardianServiceName
                $result |
                    Microsoft.PowerShell.Utility\Add-Member `
                        -MemberType NoteProperty `
                        -Name purged `
                        -Value $true `
                        -Force
                $result = Add-DefenseClawStandalonePurgeMachineLeftovers -Layout $Layout -Result $result
                return [pscustomobject]@{
                    handled = $true
                    result = (Add-DefenseClawUninstallContractResult `
                        -Result $result)
                }
            }
            if ($Action -ne 'Install') {
                throw "$Action recovered a failed initial install; run Install to create a deployment"
            }
        }
    }
    if ($null -ne $installRollbackIntent) {
        if ($Action -notin @('Install', 'Uninstall') -or
            ($Action -eq 'Uninstall' -and -not $Purge)) {
            throw (
                'an authenticated fresh-install rollback is pending; run a ' +
                'fresh Install or Uninstall -Purge for this exact scope'
            )
        }
        Complete-DefenseClawInstallRollbackIntent `
            -Layout $Layout `
            -GatewayServiceName $GatewayServiceName `
            -GuardianServiceName $GuardianServiceName
        $installRollbackIntent = $null
        if ($Action -eq 'Uninstall') {
            $result = Get-DefenseClawLifecycleStatus `
                -Action 'Uninstall' `
                -Layout $Layout `
                -GatewayServiceName $GatewayServiceName `
                -GuardianServiceName $GuardianServiceName
            $result |
                Microsoft.PowerShell.Utility\Add-Member `
                    -MemberType NoteProperty `
                    -Name purged `
                    -Value $true `
                    -Force
            $result = Add-DefenseClawStandalonePurgeMachineLeftovers -Layout $Layout -Result $result
            $result = Add-DefenseClawUninstallContractResult -Result $result
            return [pscustomobject]@{
                handled = $true
                result = $result
            }
        }
    }
    if ($null -eq $installRollbackIntent) {
        # Repair and Upgrade transactions predate and intentionally do not
        # publish fresh-install root authority. Recover their authenticated
        # pending record before a later Install publishes a new preparation
        # receipt; otherwise the unrelated new receipt can be consumed by the
        # old rollback or collide with services restored from its preimage.
        $pendingNativeSecurity = Initialize-DefenseClawNativeSecurity
        $pendingStateRoot =
            $pendingNativeSecurity::GetDirectorySecuritySnapshotNoFollowIfExists(
                [string]$Layout.StateRoot
            )
        if ($null -ne $pendingStateRoot) {
            $pendingBeforeLayout =
                $pendingNativeSecurity::GetRegularFileSecuritySnapshotNoFollowIfExists(
                    [string]$Layout.PendingPath
                )
            if ($null -ne $pendingBeforeLayout) {
                $pendingRecovery = Recover-DefenseClawPendingTransaction `
                    -Layout $Layout `
                    -GatewayServiceName $GatewayServiceName `
                    -GuardianServiceName $GuardianServiceName `
                    -AllowDeferredActivation:($Action -in @('Upgrade', 'Repair', 'Uninstall'))
                if (-not [bool]$pendingRecovery.recovered) {
                    throw 'authenticated pending transaction was not recovered before layout preparation'
                }
                Assert-DefenseClawRecoveryActivatedForAction `
                    -Recovery $pendingRecovery `
                    -Action $Action
                if (Test-DefenseClawRecoveryRestoredOtherRelease `
                        -Layout $Layout `
                        -Recovery $pendingRecovery `
                        -Action $Action `
                        -Sources $Sources) {
                    return [pscustomobject]@{
                        handled = $true
                        result = (Get-DefenseClawRecoveryRestoredOtherReleaseResult `
                            -Layout $Layout `
                            -Action $Action `
                            -GatewayServiceName $GatewayServiceName `
                            -GuardianServiceName $GuardianServiceName)
                    }
                }
                if ([bool]$pendingRecovery.fresh_install_rollback) {
                    if ($Action -eq 'Uninstall' -and $Purge) {
                        $result = Get-DefenseClawLifecycleStatus `
                            -Action 'Uninstall' `
                            -Layout $Layout `
                            -GatewayServiceName $GatewayServiceName `
                            -GuardianServiceName $GuardianServiceName
                        $result |
                            Microsoft.PowerShell.Utility\Add-Member `
                                -MemberType NoteProperty `
                                -Name purged `
                                -Value $true `
                                -Force
                        return [pscustomobject]@{
                            handled = $true
                            result = (Add-DefenseClawUninstallContractResult `
                                -Result $result)
                        }
                    }
                    if ($Action -ne 'Install') {
                        throw "$Action recovered a failed initial install; run Install to create a deployment"
                    }
                }
            }
        }
    }
    if (Microsoft.PowerShell.Management\Test-Path `
            -LiteralPath $Layout.PurgeIntentPath) {
        if ($Action -eq 'Uninstall' -and $Purge) {
            # A plain uninstall interrupted after it published its
            # machine-state purge still keeps every enrolled account's
            # per-user state; PURGE=1 removes it first (GAP-2094).
            $userStatePurge = $null
            if ((Test-DefenseClawStandaloneProfile) -and
                (Microsoft.PowerShell.Management\Test-Path `
                    -LiteralPath $Layout.MetadataPath `
                    -PathType Leaf) -and
                -not (Microsoft.PowerShell.Management\Test-Path `
                    -LiteralPath $Layout.PendingPath)) {
                $intentMetadata = Get-DefenseClawDeploymentMetadata `
                    -Layout $Layout `
                    -Required
                Assert-DefenseClawMetadataIdentity `
                    -Metadata $intentMetadata `
                    -GatewayServiceName $GatewayServiceName `
                    -GuardianServiceName $GuardianServiceName
                $userStatePurge = Invoke-DefenseClawTombstoneUserStatePurge `
                    -Layout $Layout `
                    -Metadata $intentMetadata `
                    -GatewayServiceName $GatewayServiceName `
                    -GatewaySource $(if ($Sources.ContainsKey('gateway')) {
                        [hashtable]$Sources['gateway']
                    }
                    else {
                        $nativeCleanupSource
                    })
            }
            $result = Complete-DefenseClawStatePurge `
                -Layout $Layout `
                -GatewayServiceName $GatewayServiceName `
                -GuardianServiceName $GuardianServiceName `
                -NativeCleanupSource $nativeCleanupSource
            if ($null -ne $userStatePurge) {
                $result = Add-DefenseClawUserRegistrationCleanupResult `
                    -Result $result `
                    -Layout $Layout `
                    -Finalization $userStatePurge
            }
            $result = Add-DefenseClawUninstallContractResult -Result $result
            return [pscustomobject]@{
                handled = $true
                result = $result
            }
        }
        if ($Action -eq 'Install') {
            [void](Complete-DefenseClawStatePurge `
                -Layout $Layout `
                -GatewayServiceName $GatewayServiceName `
                -GuardianServiceName $GuardianServiceName `
                -NativeCleanupSource $nativeCleanupSource)
            # Receipt recovery adopts the old deployment mode only to
            # authenticate cleanup. A new Install is governed solely by this
            # invocation's explicit certification switches.
            $Layout.CertificationCodexHome =
                [string]$RequestedCertificationCodexHome
            $Layout.CoreHardeningCertification =
                [bool]$RequestedCoreHardeningCertification
        }
        else {
            throw (
                'an authenticated state-purge intent is pending; ' +
                'run Uninstall -Purge or perform a fresh Install'
            )
        }
    }

    if ($Action -eq 'Install' -and
        (Microsoft.PowerShell.Management\Test-Path `
            -LiteralPath $Layout.StateRoot `
            -PathType Container) -and
        (Microsoft.PowerShell.Management\Test-Path `
            -LiteralPath $Layout.MetadataPath `
            -PathType Leaf) -and
        -not (Microsoft.PowerShell.Management\Test-Path `
            -LiteralPath $Layout.PendingPath)) {
        $committedMetadata = Get-DefenseClawDeploymentMetadata `
            -Layout $Layout `
            -Required
        Assert-DefenseClawMetadataIdentity `
            -Metadata $committedMetadata `
            -GatewayServiceName $GatewayServiceName `
            -GuardianServiceName $GuardianServiceName
        if (-not (Test-DefenseClawMetadataInstalled `
                -Metadata $committedMetadata)) {
            # Finish the authenticated old uninstall before fresh-install root
            # creation. This is essential for schema-4 prepared journals: the
            # retained, hash-verified old gateway is still present here and is
            # the only helper authorized to finalize its own journal. Cleanup
            # leaves the inactive metadata tombstone as the exact StateRoot
            # preimage that the new Install adopts transactionally later.
            if (Sync-DefenseClawStandaloneUninstallTombstoneBinding `
                    -Layout $Layout `
                    -GatewayServiceName $GatewayServiceName) {
                $committedMetadata = Get-DefenseClawDeploymentMetadata `
                    -Layout $Layout `
                    -Required
            }
            $retiredContractReceipt =
                Get-DefenseClawManagedHookContractCleanupReceipt `
                    -Layout $Layout `
                    -GatewayServiceName $GatewayServiceName `
                    -GuardianServiceName $GuardianServiceName `
                    -Metadata $committedMetadata
            if ($null -eq $retiredContractReceipt -and
                (Test-DefenseClawStandaloneProfile) -and
                (Microsoft.PowerShell.Management\Test-Path `
                    -LiteralPath $Layout.InstallRoot `
                    -PathType Container)) {
                # GAP-1443, GAP-1447: the tombstone's hook removal never ran
                # (an earlier 1.0.4 Setup committed it over an older
                # deployment), so its helper never published the receipt.
                # Finishing that uninstall first removes those hooks with the
                # helper that installed them and publishes the receipt.
                [void](Invoke-DefenseClawCommittedUninstallCleanup `
                    -Layout $Layout `
                    -GatewayServiceName $GatewayServiceName `
                    -GuardianServiceName $GuardianServiceName `
                    -NativeCleanupSource $nativeCleanupSource)
                $retiredContractReceipt =
                    Get-DefenseClawManagedHookContractCleanupReceipt `
                        -Layout $Layout `
                        -GatewayServiceName $GatewayServiceName `
                        -GuardianServiceName $GuardianServiceName `
                        -Metadata $committedMetadata
            }
            if ($null -eq $retiredContractReceipt) {
                throw (
                    'the retained deployment predates scope-bound connector ' +
                    'cleanup authority; refusing Install because carrying ' +
                    'unattributed same-connector state into the new deployment is unsafe'
                )
            }
            else {
                if ($null -eq $nativeCleanupSource) {
                    throw (
                        'retained-state Install requires the authenticated ' +
                        'native cleanup executable to retire old connector claims'
                    )
                }
                [void](Invoke-DefenseClawManagedHookContractCleanup `
                    -Layout $Layout `
                    -Source $nativeCleanupSource `
                    -GatewayServiceName $GatewayServiceName `
                    -GuardianServiceName $GuardianServiceName `
                    -Metadata $committedMetadata)
                # Keep the finalized receipt through the retained-state
                # install. A later purge can still authenticate completion if
                # this Install crashes; the next teardown atomically replaces
                # it only after capturing that deployment's claims.
            }
            [void](Invoke-DefenseClawCommittedUninstallCleanup `
                -Layout $Layout `
                -GatewayServiceName $GatewayServiceName `
                -GuardianServiceName $GuardianServiceName `
                -NativeCleanupSource $nativeCleanupSource)
        }
    }

    if ($Action -eq 'Uninstall') {
        $preLayoutNativeSecurity = Initialize-DefenseClawNativeSecurity
        $preLayoutStateRoot =
            $preLayoutNativeSecurity::GetDirectorySecuritySnapshotNoFollowIfExists(
                [string]$Layout.StateRoot
            )
        if ($null -eq $preLayoutStateRoot) {
            # Without authenticated StateRoot metadata, no user runtime or
            # shared connector state can be attributed to this scope. Purge
            # is therefore restricted to the exact four service identities,
            # their exact shared-IPC grant, and this scope's one canonical,
            # identity-pinned InstallRoot.
            if ($Purge) {
                $sweepResult = Invoke-DefenseClawExactScopeRecoveryPurge `
                    -Layout $Layout `
                    -Sources $Sources `
                    -GatewayServiceName $GatewayServiceName `
                    -GuardianServiceName $GuardianServiceName
                $sweepResult = Add-DefenseClawStandalonePurgeMachineLeftovers -Layout $Layout -Result $sweepResult
                return [pscustomobject]@{
                    handled = $true
                    result = $sweepResult
                }
            }
            throw (
                'Uninstall requires either an existing managed StateRoot ' +
                'or -Purge for exact-scope recovery'
            )
        }
        if ((Microsoft.PowerShell.Management\Test-Path `
                -LiteralPath $Layout.MetadataPath `
                -PathType Leaf) -and
            -not (Microsoft.PowerShell.Management\Test-Path `
                -LiteralPath $Layout.PendingPath)) {
            $committedMetadata = Get-DefenseClawDeploymentMetadata `
                -Layout $Layout `
                -Required
            Assert-DefenseClawMetadataIdentity `
                -Metadata $committedMetadata `
                -GatewayServiceName $GatewayServiceName `
                -GuardianServiceName $GuardianServiceName
            if (-not (Test-DefenseClawMetadataInstalled `
                    -Metadata $committedMetadata)) {
                $userStatePurgeSource = if ($Sources.ContainsKey('gateway')) {
                    [hashtable]$Sources['gateway']
                }
                else {
                    $nativeCleanupSource
                }
                $result = Invoke-DefenseClawCommittedUninstallCleanup `
                    -Layout $Layout `
                    -GatewayServiceName $GatewayServiceName `
                    -GuardianServiceName $GuardianServiceName `
                    -Purge:$Purge `
                    -NativeCleanupSource $nativeCleanupSource `
                    -UserStatePurgeSource $userStatePurgeSource
                return [pscustomobject]@{
                    handled = $true
                    result = $result
                }
            }
        }
    }
    return [pscustomobject]@{
        handled = $false
        result = $null
    }
}

function Test-DefenseClawPreLayoutRecoveryPending {
    <#
        Whether a record an interrupted lifecycle left is present that
        Invoke-DefenseClawPreLayoutRecovery recovers before the lifecycle
        reads the deployment record: a pending transaction, a state-purge
        intent, a self-uninstall receipt or an install-rollback intent. Their
        recovery can change the record (a first install interrupted after it
        wrote the installed record but before it cleared pending.json rolls
        back to no deployment), so a refusal read from the record waits for
        that recovery and checks after it (S2 review, loop round 2).
    #>
    param([Parameter(Mandatory)][hashtable]$Layout)
    foreach ($name in @('PendingPath', 'PurgeIntentPath', 'SelfUninstallReceiptPath', 'InstallRollbackIntentPath')) {
        $path = [string]$Layout[$name]
        if (-not [string]::IsNullOrWhiteSpace($path) -and
            (Microsoft.PowerShell.Management\Test-Path -LiteralPath $path -PathType Leaf)) {
            return $true
        }
    }
    return $false
}

function Assert-DefenseClawDeferredInstallIsFresh {
    param(
        [Parameter(Mandatory)][hashtable]$Layout
    )
    $metadata = Get-DefenseClawDeploymentMetadata -Layout $Layout
    if ($null -ne $metadata -and
        (Test-DefenseClawMetadataInstalled -Metadata $metadata)) {
        throw (
            'invalid_arguments: deferred Install without Config and Manifest ' +
            'requires an empty deployment; use Repair or Ensure for the ' +
            'installed deployment (nothing was changed)'
        )
    }
}

function Get-DefenseClawTargetRuntimePreparationMode {
    param(
        [Parameter(Mandatory)]
        [ValidateSet('Install', 'Upgrade', 'Repair')]
        [string]$Action,
        [Parameter(Mandatory)][bool]$ManifestPresent,
        [switch]$PrepareDeferredActivation
    )
    if (-not $ManifestPresent) {
        throw (
            "$Action requires an authenticated installed targets.yaml " +
            'before target runtime preparation'
        )
    }
    if ($Action -eq 'Install') { return 'prepare' }
    if ($PrepareDeferredActivation) {
        if ($Action -ne 'Repair') {
            throw 'deferred configuration activation requires Repair'
        }
        return 'prepare'
    }
    return 'validate'
}

function Invoke-DefenseClawInstallLikeLifecycle {
    param(
        [Parameter(Mandatory)][string]$Action,
        [Parameter(Mandatory)][hashtable]$Layout,
        [Parameter(Mandatory)][hashtable]$Sources,
        [string]$CoworkPackagePath,
        [string]$CoworkSignaturePath,
        [switch]$StandaloneFleetStateKnown,
        [switch]$StandaloneFleetEnabled,
        [Parameter(Mandatory)][string]$GatewayServiceName,
        [Parameter(Mandatory)][string]$GuardianServiceName,
        [switch]$RefreshApplicationControlAttestation,
        [switch]$RefreshClaudeEffectivePolicyAttestation,
        [switch]$InstallRootCreatedForTransaction,
        [switch]$StateRootCreatedForTransaction,
        [switch]$DeferredConfig,
        [switch]$NoStart
    )
    # Secure Client activates degraded when the Guardian's fresh reconcile
    # completed with failed user targets; standalone requires all of them.
    $acceptDegradedTargets = -not (Test-DefenseClawStandaloneProfile)
    $metadata = Get-DefenseClawDeploymentMetadata -Layout $Layout
    $priorDeferredConfigPending = [bool](
        $null -ne $metadata -and
        $null -ne $metadata.PSObject.Properties['deferred_config_pending'] -and
        [bool]$metadata.deferred_config_pending
    )
    if ($DeferredConfig -and $Action -ne 'Install') {
        throw '-DeferredConfig is valid only with Install'
    }
    if ($DeferredConfig -and
        (-not $Sources.ContainsKey('config') -or
            -not $Sources.ContainsKey('manifest'))) {
        throw 'deferred Install requires protected placeholder config and manifest inputs'
    }
    if ($priorDeferredConfigPending) {
        if ($Action -ne 'Repair') {
            throw 'deferred configuration must be completed with Repair before Upgrade'
        }
        if (-not $Sources.ContainsKey('config') -or
            -not $Sources.ContainsKey('manifest')) {
            throw 'deferred configuration Repair requires both -Config and -Manifest'
        }
        if ($NoStart) {
            throw 'deferred configuration Repair must activate services and cannot use -NoStart'
        }
    }
    if ($Sources.ContainsKey('provider_library')) {
        $Layout.ProviderLibraryPath = [string]$Sources['provider_library'].path
    }
    # An absent provider library is a supported state, not a failure: in a
    # full XDR installation Cloud Management is installed after DefenseClaw,
    # so cmidapi.dll appears later. The broker service is registered without
    # --cmid-library and discovers the library at runtime, which enables the
    # CMID lane with no further administrator action. A later Repair or
    # Upgrade run pins the path once it exists.
    if ((Test-DefenseClawLayoutBrokerEnabled -Layout $Layout)) {
        Assert-DefenseClawCMIDBrokerServiceOrAbsent `
            -Name $Layout.BrokerServiceName `
            -ExpectedImage (Get-DefenseClawCMIDBrokerImage `
                -Layout $Layout `
                -GatewayServiceName $GatewayServiceName) `
            -AllowArgumentUpgrade
    }
    elseif (-not [string]::IsNullOrWhiteSpace([string]$Layout.ProviderLibraryPath)) {
        throw 'the standalone profile has no credential provider library'
    }
    if ($null -ne $metadata) {
        Assert-DefenseClawMetadataIdentity `
            -Metadata $metadata `
            -GatewayServiceName $GatewayServiceName `
            -GuardianServiceName $GuardianServiceName
    }
    if (Test-DefenseClawStandaloneProfile) {
        # Before any record is consumed or any service stops: Repair re-stamps
        # these paths, and every action re-stamps the credential store, which
        # must never re-trust content another account could change (GAP-0590).
        # A fresh install or a reinstall over an uninstall's tombstone is
        # judged too: missing paths are skipped, and the state a non-purge
        # uninstall kept is adopted by this install (GAP-0590 review M3).
        # Install writes config.yaml and targets.yaml new from the supplied
        # approved sources; Repair restores them from Setup's approved copies
        # below (GAP-0568) and judges them after that.
        $writtenFresh = @()
        if ($Action -eq 'Repair') {
            $writtenFresh = @('ConfigPath', 'ManifestPath')
        }
        elseif ($Action -eq 'Install') {
            if ($Sources.ContainsKey('config')) { $writtenFresh += 'ConfigPath' }
            if ($Sources.ContainsKey('manifest')) { $writtenFresh += 'ManifestPath' }
        }
        Assert-DefenseClawStandaloneContentTrusted `
            -Layout $Layout `
            -GatewayServiceName $GatewayServiceName `
            -Except $writtenFresh
    }
    # Idempotent-Install contract: AVC's Windows installer runs -Action Install
    # unconditionally after its own preinstall has removed the machine-wide
    # state. Refusing on an active deployment aborted a legitimate reinstall
    # on hosts where metadata survived (see the AVC 5.1.21.3862 DART for the
    # macOS twin). Reconciling in place instead lets the downstream $replaced
    # artifact-hash rewrites, Assert-DefenseClawRecordedArtifactHashes, and
    # priorCodexTargetEnabled preflight authenticate the existing deployment
    # exactly the way Upgrade does; the only difference from Upgrade is that
    # this run still respects Install's argument surface (-Config, -Manifest).
    $reconcileInstall = $false
    if ($Action -eq 'Install') {
        if ($null -ne $metadata -and (Test-DefenseClawMetadataInstalled -Metadata $metadata)) {
            # -DeferredConfig against an active deployment is unsafe under the
            # reconcile-Install lane. The deferred flow stages placeholder
            # config.yaml + targets.yaml, sets deferred_config_pending=$true,
            # and skips service restart (see line ~22850 where -NoStart is OR'd
            # with -DeferredConfig). Applied on top of an active deployment
            # that reconcile-Install already stopped for atomic swap, the run
            # completes with services stopped and placeholder policy - the
            # endpoint is left broken with no automatic recovery. Refuse the
            # combination and direct callers to Repair, which is the supported
            # in-place policy-update surface. This is a uniform contract on
            # every managed endpoint (not per-device handling): the same
            # -Action Install -DeferredConfig invocation is refused everywhere
            # a prior active deployment exists.
            if ($DeferredConfig) {
                throw (
                    'refusing -DeferredConfig against an active DefenseClaw ' +
                    'enterprise deployment; use -Action Repair to update ' +
                    'policy in place, or -Action Uninstall -Purge before a ' +
                    'deferred-config Install'
                )
            }
            Microsoft.PowerShell.Utility\Write-Warning -Message (
                'DefenseClaw enterprise install: reconciling existing installation ' +
                'in place (idempotent Install)'
            )
            $reconcileInstall = $true
            Remove-DefenseClawUnclaimedInstallPreparationIntent `
                -Layout $Layout `
                -GatewayServiceName $GatewayServiceName `
                -GuardianServiceName $GuardianServiceName
        }
        elseif ($null -ne $metadata) {
            # A process can die after committed uninstall transaction cleanup
            # but before its protected prepared journal is retired. The trusted
            # uninstall tombstone authorizes exact cleanup before a direct
            # reinstall opens any transaction or mutates services/hooks.
            # This tombstone lane is orthogonal to the reconcile-Install case
            # above; both must not fire from the same run.
            [void](Remove-DefenseClawCommittedManagedHooksTeardownJournal `
                -Layout $Layout `
                -GatewayServiceName $GatewayServiceName `
                -GuardianServiceName $GuardianServiceName)
        }
    }
    elseif ($null -eq $metadata -or -not (Test-DefenseClawMetadataInstalled -Metadata $metadata)) {
        throw "$Action requires an installed DefenseClaw enterprise deployment"
    }

    Assert-DefenseClawOwnedServiceOrAbsent `
        -Name $GatewayServiceName `
        -ExpectedGatewayPath $Layout.GatewayPath
    Assert-DefenseClawOwnedServiceOrAbsent `
        -Name $GuardianServiceName `
        -ExpectedGatewayPath $Layout.GatewayPath `
        -ExpectedManifestPath $Layout.ManifestPath `
        -Guardian
    if ($null -ne $metadata -and (Test-DefenseClawMetadataInstalled -Metadata $metadata)) {
        $replaced = @($Sources.Keys | Microsoft.PowerShell.Core\Where-Object {
            $_ -in @(
                'gateway',
                'acp',
                'broker',
                'hook',
                'sensor_helper',
                'compiler',
                'cli',
                'installer',
                'module'
            )
        })
        Assert-DefenseClawRecordedArtifactHashes `
            -Metadata $metadata `
            -Layout $Layout `
            -ReplacedArtifacts $replaced `
            -Action $Action
    }
    $repairApprovedConfig = @{}
    if ($Action -eq 'Repair' -and (Test-DefenseClawStandaloneProfile)) {
        Invoke-DefenseClawRepairApprovedPolicyRecovery `
            -Layout $Layout `
            -Sources $Sources `
            -Metadata $metadata `
            -GatewayServiceName $GatewayServiceName `
            -ApprovedConfig $repairApprovedConfig
        # config.yaml and targets.yaml now hold the approved bytes, or are
        # judged as they are (GAP-0590 review M3).
        Assert-DefenseClawStandaloneContentTrusted -Layout $Layout -GatewayServiceName $GatewayServiceName
    }

    $priorCodexTargetEnabled = $false
    if ($null -ne $metadata -and
        (Test-DefenseClawMetadataInstalled -Metadata $metadata)) {
        $priorCodexTargetProperty = $metadata.PSObject.Properties[
            'codex_target_enabled'
        ]
        if ($null -eq $priorCodexTargetProperty) {
            # Legacy enterprise metadata predates target applicability. Include
            # the shared state for safe migration rather than risk an
            # unsnapshotted preimage.
            $priorCodexTargetEnabled = $true
        }
        elseif ($priorCodexTargetProperty.Value -isnot [bool]) {
            throw 'deployment metadata contains an invalid Codex target result'
        }
        else {
            $priorCodexTargetEnabled = [bool]$priorCodexTargetProperty.Value
        }
    }
    if ($priorCodexTargetEnabled) {
        # Authenticate pre-existing shared machine files before the lifecycle
        # snapshot reads them or any managed service/artifact is changed.
        Assert-DefenseClawCodexMachinePolicyFilePreflight -Layout $Layout
        Assert-DefenseClawCodexManagedHooksStateFilePreflight -Layout $Layout
    }
    $priorDeploymentActive = [bool](
        $null -ne $metadata -and
        (Test-DefenseClawMetadataInstalled -Metadata $metadata)
    )
    $priorManagedHooksActivation = $null
    $legacyClassifiedActivationState = ''
    if ($priorDeploymentActive) {
        $activationProperty = $metadata.PSObject.Properties[
            'managed_hooks_activation'
        ]
        if ($null -ne $activationProperty) {
            $priorManagedHooksActivation =
                Assert-DefenseClawManagedHooksActivationRecord `
                    -Record $activationProperty.Value
        }
        elseif (-not $Sources.ContainsKey('gateway')) {
            throw (
                "$Action requires an authenticated replacement gateway to " +
                'migrate legacy managed-hook activation evidence'
            )
        }
    }
    $recoverCommittedManagedHooksLifecycle = $false
    if (Microsoft.PowerShell.Management\Test-Path `
        -LiteralPath $Layout.ManagedHooksLifecycleJournalPath) {
        if ($Action -eq 'Install') {
            # Reinstall retains its existing committed-tombstone lane. The
            # installed helper and inactive metadata still authenticate this
            # exact journal before any new transaction is opened.
            [void](Invoke-DefenseClawManagedHooksLifecycleSnapshotCommand `
                -Layout $Layout `
                -GatewayServiceName $GatewayServiceName `
                -Action retire)
        }
        else {
            $journalCompatibility =
                Get-DefenseClawManagedHooksLifecycleJournalCompatibilityState `
                    -Layout $Layout
            if ($journalCompatibility -ceq 'current') {
                # A current journal is owned by the installed schema-4 helper.
                # Retire it before opening a new transaction; sending it down
                # the schema-3 adoption lane would reject a valid receipt.
                Invoke-DefenseClawCommittedManagedHooksLifecycleRetire `
                    -Layout $Layout `
                    -GatewayServiceName $GatewayServiceName `
                    -GatewaySource $Sources['gateway']
                if (Microsoft.PowerShell.Management\Test-Path `
                        -LiteralPath `
                            $Layout.ManagedHooksLifecycleJournalPath) {
                    throw 'current managed-hook lifecycle journal survived direct retirement'
                }
            }
            elseif ($journalCompatibility -ceq 'legacy_captured') {
                if (-not $Sources.ContainsKey('gateway')) {
                    throw (
                        "$Action found a committed managed-hook lifecycle " +
                        'journal that requires an authenticated replacement ' +
                        'gateway'
                    )
                }
                # The old helper may contain the defect that left this
                # schema-3 journal. The transaction publishes its exact
                # identity/hash preimage with pending.json. A crash before the
                # replacement helper and adoption binding exist can therefore
                # restore the old deployment without invoking that defective
                # helper; retry then re-enters this bounded migration lane.
                $recoverCommittedManagedHooksLifecycle = $true
            }
            else {
                throw 'managed-hook lifecycle journal compatibility state is invalid'
            }
        }
    }
    elseif ($priorDeploymentActive -and
        (Test-DefenseClawStandaloneProfile) -and
        $Sources.ContainsKey('gateway')) {
        Assert-DefenseClawStagedRuntimeBundleClassification `
            -Layout $Layout `
            -GatewayServiceName $GatewayServiceName `
            -GatewaySource $Sources['gateway'] `
            -Action $Action
    }
    $earlyHookSource = $null
    if ($Sources.ContainsKey('hook')) {
        $earlyHookSource = $Sources['hook']
    }
    $coworkSourcePlan = $null
    if (Test-DefenseClawStandaloneProfile) {
        $coworkConfigSource = if ($Sources.ContainsKey('config')) {
            [string]$Sources['config'].path
        } else { [string]$Layout.ConfigPath }
        $coworkSourcePlan = Get-DefenseClawCoworkPlan -Layout $Layout `
            -GatewayServiceName $GatewayServiceName -GatewaySource $Sources['gateway'] `
            -ConfigPath $coworkConfigSource `
            -CoworkPackagePath $CoworkPackagePath -CoworkSignaturePath $CoworkSignaturePath `
            -BeforeAclRepair
    }
    $snapshot = New-DefenseClawTransaction `
        -Layout $Layout `
        -GatewayServiceName $GatewayServiceName `
        -GuardianServiceName $GuardianServiceName `
        -PriorDeploymentActive:$priorDeploymentActive `
        -EarlyHookSource $earlyHookSource `
        -CoworkRequested:($null -ne $coworkSourcePlan -and [bool]$coworkSourcePlan.enabled) `
        -IncludeCodexMachineState:$priorCodexTargetEnabled `
        -RecoverLegacyManagedHooksLifecycleJournal:$recoverCommittedManagedHooksLifecycle `
        -InstallRootCreatedForTransaction:$InstallRootCreatedForTransaction `
        -StateRootCreatedForTransaction:$StateRootCreatedForTransaction
    $transactionRecord = Microsoft.PowerShell.Management\Get-Content `
        -LiteralPath $snapshot `
        -Raw | Microsoft.PowerShell.Utility\ConvertFrom-Json
    $lifecycleTransactionID = [string]$transactionRecord.id
    if ($lifecycleTransactionID -cnotmatch '^[0-9a-f]{32}$') {
        throw 'lifecycle transaction has an invalid managed-hook generation identity'
    }
    [void](Set-DefenseClawInstallPreparationTransactionBinding `
        -Layout $Layout `
        -GatewayServiceName $GatewayServiceName `
        -GuardianServiceName $GuardianServiceName `
        -SnapshotPath $snapshot)
    $committedLifecycleRecovery = $null
    try {
        # Inside the rollback scope: a failed pins write rolls this
        # transaction back in the same run (g649 review F5).
        Write-DefenseClawTransactionLifecyclePins `
            -SnapshotPath $snapshot `
            -Sources $Sources
        if ($Action -eq 'Install' -and $null -ne $metadata -and
            -not $reconcileInstall) {
            # The inactive uninstall tombstone remains the authority for
            # exact-scope adoption until New-DefenseClawTransaction has
            # durably copied it. Retire it only inside that transaction so
            # the hidden requirements helper sees fresh-install state. A
            # failed reinstall restores the exact tombstone preimage; a
            # successful reinstall publishes new active metadata below.
            #
            # Skipped for reconcile-Install (metadata is active, not a
            # tombstone). Remove-DefenseClawInactiveDeploymentMetadataForInstall
            # otherwise refuses to adopt active metadata and aborts the run.
            Remove-DefenseClawInactiveDeploymentMetadataForInstall `
                -Layout $Layout `
                -Metadata $metadata `
                -SnapshotPath $snapshot
        }
        Stop-DefenseClawService -Name $GuardianServiceName
        Stop-DefenseClawService -Name $GatewayServiceName
        Stop-DefenseClawService -Name $Layout.SensorHelperServiceName
        if ((Test-DefenseClawLayoutBrokerEnabled -Layout $Layout)) {
            Stop-DefenseClawService -Name $Layout.BrokerServiceName
        }
        if ($Action -eq 'Upgrade' -and $priorDeploymentActive -and
            (Test-DefenseClawStandaloneProfile) -and
            ([string]$metadata.product_version) -match '^1\.0\.6(?:$|[+-])' -and
            (Test-DefenseClawUpgradeOwnerRightsRestoreNeeded `
                -Layout $Layout `
                -GatewayServiceName $GatewayServiceName)) {
            # An owner write can remove OWNER RIGHTS from a signed-out
            # account's hook lock and generation files. Restore only the
            # exact GAP-0303 shape while the guardian is stopped, before
            # the replacement guardian verifies that account. Its older
            # hooks remain registered until its next sign-in (GAP-0513).
            Invoke-DefenseClawManagedUserStateOwnerRightsRestore `
                -Layout $Layout `
                -GatewayServiceName $GatewayServiceName `
                -UpgradeOnly
        }
        if ($Action -eq 'Repair' -and (Test-DefenseClawStandaloneProfile)) {
            # The snapshot is durable and services are stopped. Heal managed
            # runtime, bundle and credential ACL drift before any helper or
            # strict config check reads those paths; the final stamp below
            # also covers files Repair writes later in this transaction.
            # The Codex machine policy is stamped only after its ACL
            # preimage is captured (Initialize-DefenseClawCodexRequirementsAclBackup).
            Set-DefenseClawManagedAcls `
                -Layout $Layout `
                -GatewayServiceName $GatewayServiceName `
                -SkipCodexMachineState
            Set-DefenseClawStandaloneSecretsAcls `
                -Layout $Layout `
                -GatewayServiceSID (Get-DefenseClawServiceSID -ServiceName $GatewayServiceName)
        }
        # Upgrade/Repair must capture the old machine-policy identity before a
        # replacement config or manifest changes its endpoint/target set. New
        # gateway/hook bytes are staged first so even an upgrade from a release
        # without the snapshot command can open the protected journal.
        $deferredPolicySources = if ($Action -eq 'Install') {
            @()
        }
        else {
            @('config', 'manifest')
        }
        foreach ($name in @(Get-DefenseClawStagingOrder -Names @($Sources.Keys) |
                Microsoft.PowerShell.Core\Where-Object {
                    $_ -notin $deferredPolicySources -and $_ -ne 'provider_library'
                })) {
            $destination = Get-DefenseClawArtifactPath -Layout $Layout -Name $name
            # A release binary whose installed bytes are the source's is
            # kept: a config-only ensure on the installed release copied
            # and rescanned about 530 MB of identical binaries while the
            # services were stopped (cowork-1-0-8 GAP-0044). A changed one is
            # replaced as before; the snapshot above is unchanged.
            Install-DefenseClawSourceDescriptor `
                -Source $Sources[$name] `
                -Destination $destination `
                -SkipIfContentMatches
            $publishedManifestReplacement = [bool](
                $name -ceq 'manifest' -and
                (Test-DefenseClawSourceDescriptorPublishesReplacement `
                    -Source $Sources[$name] `
                    -Destination $destination)
            )
            if ($publishedManifestReplacement) {
                # A published copy can inherit the elevated caller's descriptor
                # or retain replacement-file metadata. Apply the exact
                # AdminFile contract immediately after the authenticated atomic
                # copy and before target-runtime validation reads the manifest.
                Set-DefenseClawPathAcl `
                    -Path $destination `
                    -Kind AdminFile `
                    -GatewayServiceSID $script:AdministratorsSID
            }
        }
        if ($StandaloneFleetStateKnown -and -not $StandaloneFleetEnabled) {
            Remove-DefenseClawRetiredStandaloneCompiler -Layout $Layout
        }
        foreach ($requiredPath in @(
            $Layout.GatewayPath,
            $Layout.BrokerPath,
            $Layout.ACPPath,
            $Layout.HookPath,
            $Layout.SensorHelperPath,
            $Layout.ConfigPath,
            $Layout.ManifestPath,
            $Layout.InstallerPath,
            $Layout.ModulePath
        )) {
            # Standalone layouts carry no broker binary.
            if ([string]::IsNullOrWhiteSpace([string]$requiredPath)) {
                continue
            }
            if (-not (Microsoft.PowerShell.Management\Test-Path -LiteralPath $requiredPath -PathType Leaf)) {
                throw "required managed artifact is missing after $Action staging: $requiredPath"
            }
        }
        if ($recoverCommittedManagedHooksLifecycle) {
            $committedLifecycleRecovery =
                Publish-DefenseClawManagedHooksLifecycleRecoveryBinding `
                -Layout $Layout `
                -GatewayServiceName $GatewayServiceName `
                -SnapshotPath $snapshot `
                -GatewaySource $Sources['gateway']
        }
        if ($priorDeploymentActive -and
            $null -eq $priorManagedHooksActivation) {
            if ($null -ne $committedLifecycleRecovery) {
                $legacyClassifiedActivationState = [string](
                    $committedLifecycleRecovery.legacy_activation_state
                )
            }
            else {
                # A legacy deployment can be validly never activated without
                # having left a stale lifecycle journal. Classify its exact old
                # connector/selector state with the authenticated replacement
                # helper before the deferred manifest/config mutation.
                $legacyClassifiedActivationState =
                    Get-DefenseClawManagedHooksLegacyActivationClassification `
                        -Layout $Layout `
                        -GatewayServiceName $GatewayServiceName `
                        -TransactionID $lifecycleTransactionID
            }
        }
        if ($Action -ne 'Install') {
            [void](Invoke-DefenseClawManagedHooksLifecycleSnapshotCommand `
                -Layout $Layout `
                -GatewayServiceName $GatewayServiceName `
                -Action capture)
        }
        foreach ($name in @($deferredPolicySources | Microsoft.PowerShell.Core\Where-Object {
            $Sources.ContainsKey($_)
        })) {
            $destination = Get-DefenseClawArtifactPath -Layout $Layout -Name $name
            Install-DefenseClawSourceDescriptor `
                -Source $Sources[$name] `
                -Destination $destination
            $publishedManifestReplacement = [bool](
                $name -ceq 'manifest' -and
                (Test-DefenseClawSourceDescriptorPublishesReplacement `
                    -Source $Sources[$name] `
                    -Destination $destination)
            )
            if ($publishedManifestReplacement) {
                # Upgrade/Repair authenticate the old manifest in the captured
                # preimage, then replace it. Secure that authenticated
                # replacement before validation; an unreplaced installed
                # manifest remains validation-only and ACL drift still fails.
                Set-DefenseClawPathAcl `
                    -Path $destination `
                    -Kind AdminFile `
                    -GatewayServiceSID $script:AdministratorsSID
            }
        }
        # Upgrade and Repair may reuse the installed config and manifest when
        # no replacement source was supplied. Install always supplies both;
        # the public entry point rejects the legacy deferred source shape.
        $requiredArtifacts = @(
            @{Path = $Layout.BrokerPath;    SourceKey = $null},
            @{Path = $Layout.GatewayPath;   SourceKey = $null},
            @{Path = $Layout.ACPPath;       SourceKey = $null},
            @{Path = $Layout.HookPath;      SourceKey = $null},
            @{Path = $Layout.SensorHelperPath; SourceKey = $null},
            @{Path = $Layout.ConfigPath;    SourceKey = 'config'},
            @{Path = $Layout.ManifestPath;  SourceKey = 'manifest'},
            @{Path = $Layout.InstallerPath; SourceKey = $null},
            @{Path = $Layout.ModulePath;    SourceKey = $null}
        )
        foreach ($entry in $requiredArtifacts) {
            $requiredPath = $entry.Path
            $skippable = ($null -ne $entry.SourceKey) -and
                (-not $Sources.ContainsKey($entry.SourceKey))
            if ($skippable -or [string]::IsNullOrWhiteSpace([string]$requiredPath)) {
                continue
            }
            if (-not (Microsoft.PowerShell.Management\Test-Path `
                -LiteralPath $requiredPath `
                -PathType Leaf)) {
                throw "required managed artifact is missing after $Action policy staging: $requiredPath"
            }
        }
        if ($Action -eq 'Install' -and -not $priorDeploymentActive) {
            # Before any target runtime is prepared or the Guardian can
            # start, clear runtime selectors an earlier purge or interrupted
            # uninstall left with nothing that could authorize them.
            [void](Invoke-DefenseClawOrphanedSelectorPrune `
                -Layout $Layout `
                -GatewayServiceName $GatewayServiceName `
                -TransactionID $lifecycleTransactionID `
                -SnapshotPath $snapshot)
        }
        $targetRuntimeManifestPresent = [bool](
            Microsoft.PowerShell.Management\Test-Path `
                -LiteralPath $Layout.ManifestPath `
                -PathType Leaf
        )
        $targetRuntimePreparationMode =
            Get-DefenseClawTargetRuntimePreparationMode `
                -Action $Action `
                -ManifestPresent $targetRuntimeManifestPresent `
                -PrepareDeferredActivation:$priorDeferredConfigPending
        if ($Action -eq 'Install') {
            # New-DefenseClawTransaction has durably recorded every managed
            # service as absent and the install-preparation receipt is bound
            # to that exact snapshot. Register the transaction-owned services
            # disabled and bind the live gateway SID before Enumerator or any
            # target-runtime helper loads the managed configuration. Rollback
            # removes these services and revokes their exact shared-IPC ACE.
            # A reconcile-Install retired its unclaimed receipt above, so it
            # reconfigures the existing services without binding a SID.
            Set-DefenseClawManagedServicesForTransaction `
                -Layout $Layout `
                -GatewayServiceName $GatewayServiceName `
                -GuardianServiceName $GuardianServiceName `
                -BindInstallPreparationSID:(-not $reconcileInstall)
        }
        # Freeze the profile-derived target set while Enumerator and Guardian
        # are stopped. The protected target-runtime plan below then hashes the
        # exact manifest generation Guardian must prove before activation.
        # A deferred first stage deliberately retains its empty placeholder:
        # discovering users here would mutate their profiles before real policy
        # exists. The authenticated completion Repair performs this refresh.
        if (-not $DeferredConfig) {
            Invoke-DefenseClawEnumeratorRefresh `
                -Layout $Layout `
                -GatewayServiceName $GatewayServiceName
        }
        # Resolve and publish every target root before SCM activation or any
        # gateway/guardian process can write user state. Only a fresh Install
        # may create an absent root; Upgrade/Repair authenticate every
        # canonical baseline and reject any absent enabled target before
        # services become startable. For Install, the helper's plan is
        # journaled before staging; exact created identities are journaled
        # before final publication, and canonical final state is journaled
        # before services become startable.
        $targetRuntimePlan = Invoke-DefenseClawTargetRuntimePreparation `
            -SnapshotPath $snapshot `
            -Layout $Layout `
            -GatewayServiceName $GatewayServiceName `
            -GuardianServiceName $GuardianServiceName `
            -ValidationOnly:($targetRuntimePreparationMode -ceq 'validate') `
            -AllowSkipBusyProfiles:(
                $Action -eq 'Install' -and -not $reconcileInstall -and
                $targetRuntimePreparationMode -ceq 'prepare'
            )
        $allowedFailedTargetSIDs = [string[]](
            Get-DefenseClawAllowedFailedTargetSIDs -Plan $targetRuntimePlan
        )
        if ((Test-DefenseClawStandaloneProfile) -and
            $allowedFailedTargetSIDs.Count -gt 0) {
            $acceptDegradedTargets = $true
        }
        $expectedGuardianManifestSHA256 = [string]$targetRuntimePlan.manifest_sha256
        if ($expectedGuardianManifestSHA256 -cnotmatch '^[0-9a-f]{64}$') {
            throw 'target runtime plan did not bind an exact manifest SHA-256'
        }
        if (Test-DefenseClawStandaloneProfile) {
            Add-DefenseClawUserNativeOTLPTransactionSnapshot `
                -SnapshotPath $snapshot `
                -Layout $Layout `
                -Plan $targetRuntimePlan
        }
        if ($Action -eq 'Install') {
            # The service/SID boundary was established before enumeration.
            # Capture the managed-hook lifecycle only after target-runtime
            # planning/finalization has durably published its rollback claims.
            [void](Invoke-DefenseClawManagedHooksLifecycleSnapshotCommand `
                -Layout $Layout `
                -GatewayServiceName $GatewayServiceName `
                -Action capture)
        }

        $attestationNeedsRefresh = [bool]$RefreshApplicationControlAttestation
        $attestationExists = Microsoft.PowerShell.Management\Test-Path `
            -LiteralPath $Layout.AgentApplicationControlAttestationPath `
            -PathType Leaf
        if ([bool]$Layout.CoreHardeningCertification -and $attestationExists) {
            $staleAttestation =
                Get-DefenseClawAgentApplicationControlAttestation -Layout $Layout
            if ([bool]$staleAttestation.agent_application_control_enforced) {
                throw 'core-hardening migration refuses to discard genuine application-control attestation evidence'
            }
            Microsoft.PowerShell.Management\Remove-Item `
                -LiteralPath $Layout.AgentApplicationControlAttestationPath `
                -Force
            $attestationExists = $false
        }
        elseif (-not $attestationNeedsRefresh -and $attestationExists) {
            [void](Get-DefenseClawAgentApplicationControlAttestation -Layout $Layout)
        }
        if ($Action -ne 'Install') {
            # Upgrade/Repair deliberately capture the previous hook identity
            # before reconfiguring the existing service pair.
            Set-DefenseClawManagedServicesForTransaction `
                -Layout $Layout `
                -GatewayServiceName $GatewayServiceName `
                -GuardianServiceName $GuardianServiceName
        }
        $targetReport = Invoke-DefenseClawCodexRequirementsCommand `
            -Layout $Layout `
            -GatewayServiceName $GatewayServiceName `
            -Action inspect
        if ([bool]$Layout.CoreHardeningCertification -and
            ([bool]$Layout.CodexTargetEnabled -or
                [bool]$Layout.CursorTargetEnabled)) {
            throw (
                'Core-hardening certification is Claude-only and refuses ' +
                'enabled Codex or Cursor targets in the protected manifest'
            )
        }
        if ($Sources.ContainsKey('manifest') -and
            -not $RefreshClaudeEffectivePolicyAttestation -and
            [bool]$Layout.ClaudeEffectivePolicyVerified) {
            # Approved-client evidence is bound to exact manifest bytes. A
            # replacement manifest must be exercised again before the external
            # prerequisite can be re-attested.
            $Layout.ClaudeEffectivePolicyVerified = $false
            $attestationNeedsRefresh = $true
            $targetReport = Invoke-DefenseClawCodexRequirementsCommand `
                -Layout $Layout `
                -GatewayServiceName $GatewayServiceName `
                -Action inspect
        }
        if ((Test-DefenseClawStandaloneProfile) -and
            -not $RefreshClaudeEffectivePolicyAttestation -and
            [bool]$Layout.ClaudeEffectivePolicyVerified -and
            -not [string]::IsNullOrEmpty(
                [string]$Layout['ClaudeEffectivePolicyStaleReason'])) {
            # Standalone evidence recorded for another Claude policy identity
            # is retired as unverified, never re-bound to the current one.
            $Layout.ClaudeEffectivePolicyVerified = $false
            $Layout['ClaudeEffectivePolicyStaleReason'] = ''
            $attestationNeedsRefresh = $true
        }
        if ($RefreshClaudeEffectivePolicyAttestation -and
            -not [bool]$Layout.ClaudeTargetEnabled) {
            throw '-AttestClaudeEffectivePolicy requires at least one enabled Claude target in the protected manifest'
        }
        if (-not [bool]$Layout.ClaudeTargetEnabled -and
            [bool]$Layout.ClaudeEffectivePolicyVerified) {
            $Layout.ClaudeEffectivePolicyVerified = $false
            $attestationNeedsRefresh = $true
        }
        if (-not [bool]$Layout.CoreHardeningCertification -and
            ($attestationNeedsRefresh -or -not $attestationExists)) {
            Write-DefenseClawAgentApplicationControlAttestation -Layout $Layout
            Set-DefenseClawManagedCoreAcls `
                -Layout $Layout `
                -GatewayServiceName $GatewayServiceName
        }
        Set-DefenseClawServiceEnvironment `
            -Name $GatewayServiceName `
            -RuntimeDirectory $Layout.RuntimeDirectory `
            -ConfigPath $Layout.ConfigPath `
            -AuthorizationDirectory $Layout.AuthorizationDirectory `
            -GatewayServiceName $GatewayServiceName `
            -LogPath $Layout.GatewayLogPath `
            -BrokerPipeName $Layout.BrokerPipeName `
            -BrokerServiceName $Layout.BrokerServiceName `
            -BrokerAuthKeyPath $Layout.BrokerAuthKeyPath `
            -AgentApplicationControlAttested:$Layout.AgentApplicationControlAttested `
            -ClaudeEffectivePolicyVerified:$Layout.ClaudeEffectivePolicyVerified
        Set-DefenseClawServiceEnvironment `
            -Name $GuardianServiceName `
            -RuntimeDirectory $Layout.RuntimeDirectory `
            -ConfigPath $Layout.ConfigPath `
            -AuthorizationDirectory $Layout.AuthorizationDirectory `
            -GatewayServiceName $GatewayServiceName `
            -LogPath $Layout.GuardianLogPath `
            -AgentApplicationControlAttested:$Layout.AgentApplicationControlAttested `
            -ClaudeEffectivePolicyVerified:$Layout.ClaudeEffectivePolicyVerified
        Set-DefenseClawStandaloneEnumeratorEnvironment `
            -Layout $Layout `
            -GatewayServiceName $GatewayServiceName `
            -GuardianServiceName $GuardianServiceName
        if ([bool]$Layout.CodexTargetEnabled) {
            if (-not $priorCodexTargetEnabled) {
                Add-DefenseClawCodexTransactionSnapshot `
                    -SnapshotPath $snapshot `
                    -Layout $Layout `
                    -GatewayServiceName $GatewayServiceName `
                    -GuardianServiceName $GuardianServiceName
            }
            Initialize-DefenseClawCodexMachinePolicyParent `
                -Layout $Layout `
                -SnapshotPath $snapshot
            Assert-DefenseClawCodexMachinePolicyFilePreflight -Layout $Layout
            Assert-DefenseClawCodexManagedHooksStateFilePreflight -Layout $Layout
            Initialize-DefenseClawCodexRequirementsAclBackup `
                -Layout $Layout `
                -ExistingMetadata $metadata
            Set-DefenseClawManagedAcls `
                -Layout $Layout `
                -GatewayServiceName $GatewayServiceName
            [void](Invoke-DefenseClawCodexRequirementsCommand `
                -Layout $Layout `
                -GatewayServiceName $GatewayServiceName `
                -Action reconcile)
            Set-DefenseClawManagedAcls `
                -Layout $Layout `
                -GatewayServiceName $GatewayServiceName
            Assert-DefenseClawCodexMachinePolicyFile -Layout $Layout
            Assert-DefenseClawCodexManagedHooksStateFile -Layout $Layout
        }
        elseif ($priorCodexTargetEnabled) {
            $codexRemoval = Invoke-DefenseClawCodexRequirementsCommand `
                -Layout $Layout `
                -GatewayServiceName $GatewayServiceName `
                -Action reconcile
            Complete-DefenseClawCodexRequirementsRemoval `
                -Layout $Layout `
                -GatewayServiceName $GatewayServiceName `
                -Report $codexRemoval
        }
        # Secure Client keeps its validate-only config check (issue #1092).
        # The approved source this run installed as config.yaml (CONFIG=):
        # the sha256 its source descriptor recorded, '' without one (GAP-0646).
        $approvedConfigSHA256 = ''
        if ($Sources.ContainsKey('config') -and $Sources['config'] -is [System.Collections.IDictionary]) {
            $approvedConfigSHA256 = ([string]$Sources['config']['sha256']).ToLowerInvariant()
        }
        elseif ($repairApprovedConfig.ContainsKey('config')) {
            $approvedConfigSHA256 = [string]$repairApprovedConfig['config']
        }
        if ($approvedConfigSHA256 -cnotmatch '^[0-9a-f]{64}$') {
            $approvedConfigSHA256 = ''
        }
        Assert-DefenseClawInstalledConfig -Layout $Layout -GatewayServiceName $GatewayServiceName `
            -RecordLifecycle:(-not (Test-DefenseClawLayoutBrokerEnabled -Layout $Layout)) `
            -ApprovedConfigSHA256 $approvedConfigSHA256
        if (Test-DefenseClawStandaloneProfile) {
            Invoke-DefenseClawCoworkDelivery -Layout $Layout `
                -GatewayServiceName $GatewayServiceName -SnapshotPath $snapshot `
                -CoworkPackagePath $CoworkPackagePath -CoworkSignaturePath $CoworkSignaturePath
        }

        $deploymentGenerationID = $lifecycleTransactionID
        $managedHooksActivationState = if ($Action -eq 'Install') {
            'never_activated'
        }
        elseif ($null -ne $priorManagedHooksActivation) {
            [string]$priorManagedHooksActivation.state
        }
        elseif ($null -ne $committedLifecycleRecovery) {
            [string]$committedLifecycleRecovery.legacy_activation_state
        }
        elseif (-not [string]::IsNullOrWhiteSpace(
                $legacyClassifiedActivationState
            )) {
            $legacyClassifiedActivationState
        }
        else {
            throw (
                'legacy deployment has no unambiguous protected managed-hook ' +
                'activation evidence'
            )
        }
        if ($NoStart) {
            $classifiedState =
                Get-DefenseClawManagedHooksLegacyActivationClassification `
                    -Layout $Layout `
                    -GatewayServiceName $GatewayServiceName `
                    -TransactionID $deploymentGenerationID
            if ($managedHooksActivationState -ceq 'activated' -and
                $classifiedState -cne 'activated') {
                throw 'no-start servicing cannot reset an activated deployment to never-activated'
            }
            if ($null -ne $committedLifecycleRecovery -and
                $classifiedState -cne
                    [string]$committedLifecycleRecovery.legacy_activation_state) {
                throw 'stale-journal recovery and current activation evidence disagree'
            }
            if (-not [string]::IsNullOrWhiteSpace(
                    $legacyClassifiedActivationState
                ) -and
                $classifiedState -cne $legacyClassifiedActivationState) {
                throw 'legacy activation preimage and current no-start state disagree'
            }
            $managedHooksActivationState = $classifiedState
        }
        $managedHooksActivation =
            New-DefenseClawManagedHooksActivationRecord `
                -State $managedHooksActivationState `
                -DeploymentGenerationID $deploymentGenerationID `
                -ManifestSHA256 $expectedGuardianManifestSHA256 `
                -TargetCount ([Convert]::ToInt64(
                    $targetRuntimePlan.target_count
                ))
        $approvedPolicySources = @{}
        if (Test-DefenseClawStandaloneProfile) {
            $approvedPolicySources = Publish-DefenseClawApprovedPolicySources `
                -Layout $Layout -Sources $Sources -PriorMetadata $metadata
        }
        $newMetadata = New-DefenseClawDeploymentMetadata `
            -Layout $Layout `
            -GatewayServiceName $GatewayServiceName `
            -GuardianServiceName $GuardianServiceName `
            -DeferredConfigPending:([bool](
                $DeferredConfig -or $priorDeferredConfigPending
            )) `
            -ManagedHooksActivation $managedHooksActivation `
            -ApprovedPolicySources $approvedPolicySources
        Write-DefenseClawJsonAtomic -Value $newMetadata -Path $Layout.MetadataPath -Kind AdminFile
        Set-DefenseClawManagedAcls -Layout $Layout -GatewayServiceName $GatewayServiceName
        Set-DefenseClawStandaloneSecretsAcls `
            -Layout $Layout `
            -GatewayServiceSID (Get-DefenseClawServiceSID -ServiceName $GatewayServiceName)

        # Validate the complete static deployment while both services remain
        # disabled. This is the only state that also blocks a restart already
        # queued by SCM failure actions.
        Assert-DefenseClawEnterpriseDeployment `
            -Layout $Layout `
            -GatewayServiceName $GatewayServiceName `
            -GuardianServiceName $GuardianServiceName `
            -ServicingTransaction
        if (-not $NoStart) {
            $activationSnapshot =
                Microsoft.PowerShell.Management\Get-Content `
                    -LiteralPath $snapshot `
                    -Raw | Microsoft.PowerShell.Utility\ConvertFrom-Json
            $priorServiceStates = Get-DefenseClawTransactionServiceStates `
                -Services $activationSnapshot.services `
                -GatewayServiceName $GatewayServiceName `
                -GuardianServiceName $GuardianServiceName
            $hadPreexistingService = @(
                $priorServiceStates.Values |
                    Microsoft.PowerShell.Core\Where-Object {
                        [bool]$_.existed
                    }
            ).Count -gt 0
            $quiescenceProperty =
                $activationSnapshot.PSObject.Properties[
                    'services_disabled_and_stopped_at'
                ]
            if ($null -eq $quiescenceProperty) {
                throw 'transaction snapshot is missing its service quiescence barrier'
            }
            $activationQuiescedAt = (
                ConvertFrom-DefenseClawServiceQuiescenceTimestamp `
                    -Value $quiescenceProperty.Value
            ).ToString('o')
            Set-DefenseClawServiceActivationPhase `
                -State $activationSnapshot `
                -Path $snapshot `
                -Phase activating
            if ($hadPreexistingService) {
                Wait-DefenseClawServiceFailureRestartQuiescence `
                    -ServicesQuiescedAt $activationQuiescedAt `
                    -GatewayServiceName $GatewayServiceName `
                    -GuardianServiceName $GuardianServiceName `
                    -CleanStopProven:(Test-DefenseClawCleanQuiescenceBarrier `
                        -ServicesQuiescedAt $activationQuiescedAt)
            }
            # The LocalSystem broker must be live before any restricted
            # gateway path can request a credential.
            if ((Test-DefenseClawLayoutBrokerEnabled -Layout $Layout)) {
                Set-DefenseClawServiceStartMode `
                    -Name $Layout.BrokerServiceName `
                    -StartMode 3
                Start-DefenseClawService -Name $Layout.BrokerServiceName
            }
            Set-DefenseClawServiceStartMode `
                -Name $Layout.SensorHelperServiceName `
                -StartMode 3
            Start-DefenseClawService -Name $Layout.SensorHelperServiceName
            # The guardian becomes startable, publishes a fresh successful
            # reconcile, and remains live while gateway is still disabled.
            Set-DefenseClawServiceStartMode `
                -Name $GuardianServiceName `
                -StartMode 3
            # A completed, fresh, digest-bound reconcile with failed targets
            # activates degraded only for Secure Client or for accounts the
            # standalone target runtime plan explicitly skipped.
            try {
                [void](Wait-DefenseClawFreshGuardianReconcile `
                    -Layout $Layout `
                    -GatewayServiceName $GatewayServiceName `
                    -GuardianServiceName $GuardianServiceName `
                    -ExpectedManifestSHA256 $expectedGuardianManifestSHA256 `
                    -AllowFailedTargets:$acceptDegradedTargets `
                    -AllowedFailedTargetSIDs $allowedFailedTargetSIDs)
            }
            finally {
                if (Test-DefenseClawStandaloneProfile) {
                    Set-DefenseClawUserNativeOTLPTransactionPostimages `
                        -SnapshotPath $snapshot -Layout $Layout
                }
            }
            # The protected Guardian receipt is now exact for this manifest.
            # Promote the monotonic deployment activation state inside the
            # still-open transaction before the gateway can become startable.
            $managedHooksActivation =
                New-DefenseClawManagedHooksActivationRecord `
                    -State activated `
                    -DeploymentGenerationID $deploymentGenerationID `
                    -ManifestSHA256 $expectedGuardianManifestSHA256 `
                    -TargetCount ([Convert]::ToInt64(
                        $targetRuntimePlan.target_count
                    ))
            $newMetadata.managed_hooks_activation = $managedHooksActivation
            $newMetadata.updated_at = [DateTime]::UtcNow.ToString('o')
            Write-DefenseClawJsonAtomic `
                -Value $newMetadata `
                -Path $Layout.MetadataPath `
                -Kind AdminFile
            # Only a freshly reconciling guardian authorizes gateway demand
            # start. A queued gateway failure restart is now safe to run.
            Set-DefenseClawServiceStartMode `
                -Name $GatewayServiceName `
                -StartMode 3
            Start-DefenseClawService -Name $GatewayServiceName -FailureLogPath $Layout.GatewayLogPath
            # The enumerator
            # must be demand-started + RUNNING before the pending-state
            # assertion below, which requires every managed service to
            # be StartMode 3 AND (via -RequireReadiness below) the
            # enumerator SCM process to be Running. Promotion to
            # StartMode 2 happens later alongside gateway + guardian
            # only after full readiness succeeds.
            $enumeratorServiceName = Get-DefenseClawEnumeratorServiceName -GuardianServiceName $GuardianServiceName
            Set-DefenseClawServiceStartMode `
                -Name $enumeratorServiceName `
                -StartMode 3
            Start-DefenseClawService -Name $enumeratorServiceName
            Assert-DefenseClawManagedServiceConfigurations `
                -Layout $Layout `
                -GatewayServiceName $GatewayServiceName `
                -GuardianServiceName $GuardianServiceName `
                -PendingTransaction
            Wait-DefenseClawEnterpriseReadiness `
                -Layout $Layout `
                -GatewayServiceName $GatewayServiceName `
                -GuardianServiceName $GuardianServiceName `
                -AllowFailedTargets:$acceptDegradedTargets `
                -AllowedFailedTargetSIDs $allowedFailedTargetSIDs
            # Canonicalize dynamic logs/authorization after the service-created
            # files exist, then verify exact effective rights.
            Set-DefenseClawManagedAcls -Layout $Layout -GatewayServiceName $GatewayServiceName
            Assert-DefenseClawEnterpriseDeployment `
                -Layout $Layout `
                -GatewayServiceName $GatewayServiceName `
                -GuardianServiceName $GuardianServiceName `
                -RequireReadiness `
                -PendingTransaction `
                -AcceptDegradedTargets:$acceptDegradedTargets `
                -AllowedFailedTargetSIDs $allowedFailedTargetSIDs
            # Only fully verified live state may become boot-active. A crash
            # before pending cleanup can start only validated services.
            Set-DefenseClawServiceStartMode `
                -Name $GuardianServiceName `
                -StartMode 2
            if ((Test-DefenseClawLayoutBrokerEnabled -Layout $Layout)) {
                Set-DefenseClawServiceStartMode `
                    -Name $Layout.BrokerServiceName `
                    -StartMode 2
            }
            Set-DefenseClawServiceStartMode `
                -Name $Layout.SensorHelperServiceName `
                -StartMode 2
            Set-DefenseClawServiceStartMode `
                -Name $GatewayServiceName `
                -StartMode 2
            # Promote the (already-running) enumerator
            # from demand-start to auto-start now that readiness has
            # been proven. Without this, boot would leave the
            # enumerator disabled and new user profiles would never
            # get picked up.
            Set-DefenseClawServiceStartMode `
                -Name $enumeratorServiceName `
                -StartMode 2
            Assert-DefenseClawEnterpriseDeployment `
                -Layout $Layout `
                -GatewayServiceName $GatewayServiceName `
                -GuardianServiceName $GuardianServiceName `
                -RequireReadiness `
                -AcceptDegradedTargets:$acceptDegradedTargets `
                -AllowedFailedTargetSIDs $allowedFailedTargetSIDs
            if ($priorDeferredConfigPending) {
                # Keep the authenticated activation marker set through every
                # mutable policy/runtime step and the complete live readiness
                # proof. A failure before this point rolls back to the prior
                # stopped deferred deployment; Reconcile cannot activate it.
                $newMetadata.deferred_config_pending = $false
                $newMetadata.updated_at = [DateTime]::UtcNow.ToString('o')
                Write-DefenseClawJsonAtomic `
                    -Value $newMetadata `
                    -Path $Layout.MetadataPath `
                    -Kind AdminFile
            }
        }
        # -NoStart intentionally leaves all managed services disabled. Enabling them
        # without first running a fresh guardian reconcile would let a queued
        # SCM restart violate the guardian-before-gateway invariant.
        Complete-DefenseClawTransaction -SnapshotPath $snapshot -Layout $Layout
    }
    catch {
        $operationError = $_
        try {
            Restore-DefenseClawTransaction -SnapshotPath $snapshot -Layout $Layout
            Complete-DefenseClawTransaction `
                -SnapshotPath $snapshot `
                -Layout $Layout `
                -Rollback
        }
        catch {
            if (Test-DefenseClawTrustStrictAncestors) {
                throw "$Action failed ($($operationError.Exception.Message)); rollback also failed and pending recovery was retained: $($_.Exception.Message)"
            }
            # The pending transaction stays on disk: Repair resumes it, and
            # the next Install clears it through its automatic recovery. The
            # caller sees the error that actually failed the action.
            Write-DefenseClawResilienceEvent -Marker defenseclaw_degraded -Fields @{
                subsystem = 'rollback'
                path      = [string]$Layout.PendingPath
                reason    = "rollback did not complete; the pending transaction is kept for recovery: $($_.Exception.Message)"
            }
            throw $operationError
        }
        try {
            if (-not $recoverCommittedManagedHooksLifecycle -and
                (Microsoft.PowerShell.Management\Test-Path `
                -LiteralPath $Layout.ManagedHooksLifecycleJournalPath `
                -PathType Leaf)) {
                [void](Invoke-DefenseClawManagedHooksLifecycleSnapshotCommand `
                    -Layout $Layout `
                    -GatewayServiceName $GatewayServiceName `
                    -Action retire)
            }
        }
        catch {
            if (Test-DefenseClawTrustStrictAncestors) {
                throw (
                    "$Action failed ($($operationError.Exception.Message)); " +
                    'the exact prior machine enrollment was restored, but its ' +
                    "completed lifecycle journal could not be retired: $($_.Exception.Message)"
                )
            }
            Write-DefenseClawResilienceEvent -Marker defenseclaw_degraded -Fields @{
                subsystem = 'rollback'
                path      = [string]$Layout.ManagedHooksLifecycleJournalPath
                reason    = "prior enrollment restored; the completed lifecycle journal is kept for recovery: $($_.Exception.Message)"
            }
        }
        throw $operationError
    }
    try {
        if ($Action -eq 'Install' -and (Test-DefenseClawStandaloneProfile)) {
            # The enumerator can publish a new protected targets manifest
            # after readiness. Rebind only one the guardian has adopted
            # before the committed journal checks that exact manifest.
            [void](Sync-DefenseClawStandaloneManagedHooksActivationBinding `
                -Layout $Layout `
                -GatewayServiceName $GatewayServiceName)
        }
        [void](Invoke-DefenseClawManagedHooksLifecycleSnapshotCommand `
            -Layout $Layout `
            -GatewayServiceName $GatewayServiceName `
            -Action retire)
    }
    catch {
        # Secure Client: the transaction is committed and the services are
        # live; retiring the completed journal is housekeeping. The journal
        # stays for the next lifecycle action to retire, and the action
        # succeeds. Standalone also rebinds its activation in this step, so it
        # keeps the failure.
        if ((Test-DefenseClawTrustStrictAncestors) -or (Test-DefenseClawStandaloneProfile)) {
            throw (
                "$Action committed, but its protected managed-hook lifecycle " +
                "journal could not be retired: $($_.Exception.Message)"
            )
        }
        Write-DefenseClawResilienceEvent -Marker defenseclaw_degraded -Fields @{
            subsystem = 'lifecycle_journal'
            path      = [string]$Layout.ManagedHooksLifecycleJournalPath
            reason    = "$Action committed; the completed lifecycle journal could not be retired and is kept for the next action: $($_.Exception.Message)"
        }
    }
    $result = Get-DefenseClawLifecycleStatus `
        -Action $Action `
        -Layout $Layout `
        -GatewayServiceName $GatewayServiceName `
        -GuardianServiceName $GuardianServiceName `
        -AcceptDegradedTargets:$acceptDegradedTargets `
        -AllowedFailedTargetSIDs $allowedFailedTargetSIDs
    if ($NoStart) {
        $result.ok = $true
    }
    return $result
}

function Suspend-DefenseClawSensorHelperForServicing {
    <#
        Uninstall: New-DefenseClawTransaction disables and stops the services
        it records (gateway, guardian, enumerator, broker), not the sensor
        helper, which a healthy deployment keeps automatic. The servicing
        assertion before the services are deleted requires every managed
        service disabled, so an uninstall of a running deployment failed
        there ("service DefenseClawSensorHelper startup mode drift: 2,
        expected 4") and rolled back. Both profiles register the helper.
        Disable and stop it once the gateway that depends on it is stopped.
        A rollback brings it back with the restored gateway.
    #>
    param([Parameter(Mandatory)][hashtable]$Layout)
    $name = [string](Get-DefenseClawOptionalLayoutValue -Layout $Layout -Name SensorHelperServiceName)
    if ([string]::IsNullOrWhiteSpace($name) -or
        -not (Test-DefenseClawServiceExists -Name $name)) {
        return $false
    }
    Assert-DefenseClawStandaloneSensorHelperOwned -Name $name -Layout $Layout
    Set-DefenseClawServiceStartMode -Name $name -StartMode 4
    Stop-DefenseClawService -Name $name
    return $true
}

function Invoke-DefenseClawForcedUninstallPreparation {
    <#
        Standalone Setup /uninstall FORCE=1, the last resort when no
        lifecycle can recover a pending transaction (for example a snapshot
        that cannot be taken, GAP-0920, or a teardown journal that no longer
        matches, GAP-1041). It reads nothing of the transaction: it stops the
        DefenseClaw services (after checking they are this deployment's) and
        moves StateRoot aside, so the uninstall goes on as the state-absent
        exact-scope purge, which removes the exact services, their IPC grant,
        InstallRoot and the machine-wide hook files, and names what stays.
        Returns the preparation (StateRoot, where it was moved, empty when
        there was none, and each service's prior state) for
        Restore-DefenseClawForcedUninstallPreparation. When stopping the
        services or moving StateRoot fails (GAP-1438: a process holds
        StateRoot open), the services get back the startup mode and running
        state they had and the failure is rethrown, so a refused forced
        uninstall does not leave the host unprotected. A move refused because
        a file inside StateRoot is in use says so and names the next step
        (GAP-1474).
    #>
    param(
        [Parameter(Mandatory)][hashtable]$Layout,
        [Parameter(Mandatory)][string]$GatewayServiceName,
        [Parameter(Mandatory)][string]$GuardianServiceName
    )
    $enumeratorServiceName = Get-DefenseClawEnumeratorServiceName -GuardianServiceName $GuardianServiceName
    Assert-DefenseClawOwnedServiceOrAbsent `
        -Strict `
        -Name $GatewayServiceName `
        -ExpectedGatewayPath $Layout.GatewayPath
    Assert-DefenseClawOwnedServiceOrAbsent `
        -Strict `
        -Name $GuardianServiceName `
        -ExpectedGatewayPath $Layout.GatewayPath `
        -ExpectedManifestPath $Layout.ManifestPath `
        -Guardian
    Assert-DefenseClawOwnedServiceOrAbsent `
        -Strict `
        -Name $enumeratorServiceName `
        -ExpectedGatewayPath $Layout.GatewayPath `
        -ExpectedManifestPath $Layout.ManifestPath `
        -Enumerator
    Assert-DefenseClawOwnedServiceOrAbsent `
        -Strict `
        -Name $Layout.SensorHelperServiceName `
        -ExpectedGatewayPath $Layout.SensorHelperPath `
        -ExpectedSensorHelperImage (Get-DefenseClawSensorHelperImage `
            -Layout $Layout `
            -GatewayServiceName $GatewayServiceName) `
        -SensorHelper
    # Dependents first. Each service's prior state is read before any is touched.
    $prior = [Collections.Generic.List[object]]::new()
    foreach ($name in @(
            $enumeratorServiceName,
            $GuardianServiceName,
            $GatewayServiceName,
            [string]$Layout.SensorHelperServiceName
        )) {
        if (Test-DefenseClawServiceExists -Name $name) {
            $prior.Add([pscustomobject]@{
                    name = $name
                    start_mode = Get-DefenseClawServiceStartMode -Name $name
                    running = (Get-DefenseClawServiceState -Name $name) -in @('running', 'startpending')
                })
        }
    }
    $preparation = [pscustomobject]@{
        state_root = [IO.Path]::GetFullPath([string]$Layout.StateRoot).TrimEnd('\')
        moved_state_root = ''
        install_rollback_intent = ''
        moved_install_rollback_intent = ''
        services = $prior.ToArray()
        restored = $false
    }
    try {
        foreach ($service in $prior) {
            Set-DefenseClawServiceStartMode -Name $service.name -StartMode 4
            Stop-DefenseClawService -Name $service.name
        }
        if (-not (Microsoft.PowerShell.Management\Test-Path -LiteralPath $preparation.state_root -PathType Container)) {
            return $preparation
        }
        Assert-DefenseClawNoReparsePath -Path $preparation.state_root
        $coworkForcedOwnership = $null
        if (Test-DefenseClawStandaloneProfile) {
            try { $coworkForcedOwnership = Get-DefenseClawCoworkOwnership -Layout $Layout }
            catch { Microsoft.PowerShell.Utility\Write-Warning ('Cowork host artifacts were kept because ownership could not be proven: ' + $_.Exception.Message) }
        }
        # The bundle.lock this uninstall holds (GAP-2438) is an open handle
        # inside StateRoot, and Windows refuses to move a folder with an open
        # file under it: the printed FORCE=1 failed 1603 'Access to the path
        # ... is denied' every time (GAP-2506). Release it first, as the
        # StateRoot removal does; every bundle run waits for lifecycle.lock,
        # which this run still holds.
        Exit-DefenseClawPurgeBundleLock
        $moved = $preparation.state_root + '.forced-uninstall-' + [DateTime]::UtcNow.ToString('yyyyMMddTHHmmssZ')
        try {
            [IO.Directory]::Move($preparation.state_root, $moved)
        }
        catch {
            # Another program's open file under StateRoot (no delete
            # sharing) fails the move with the raw .NET "Access to the path
            # ... is denied", which named no file in use and no next step
            # (GAP-1474). Say what it is and what to do.
            $cause = $_.Exception
            if ($cause -is [Management.Automation.MethodInvocationException] -and $null -ne $cause.InnerException) {
                $cause = $cause.InnerException
            }
            if ($cause -isnot [IO.IOException] -and $cause -isnot [UnauthorizedAccessException]) {
                throw
            }
            throw ('the forced uninstall could not move StateRoot ' + $preparation.state_root +
                ' aside because a file or folder inside it is in use by another program (' +
                (ConvertTo-DefenseClawBoundedDiagnostic -Value $cause.Message -MaxLength 256) +
                '); nothing was removed. Close the program that holds it open (an editor or a console whose ' +
                'current folder is inside it, a log reader, a backup or anti-virus scan) and run ' + (Format-DefenseClawSetupAction -Action '/uninstall FORCE=1') + ' again.')
        }
        $preparation.moved_state_root = $moved
        if ($null -ne $coworkForcedOwnership) {
            try {
                # FORCE deliberately has no rollback. Keep the private record
                # in the renamed root for its normal forced-state cleanup, and
                # retire only unchanged external files/settings proven by it.
                Invoke-DefenseClawCoworkDelivery -Layout $Layout `
                    -GatewayServiceName $GatewayServiceName -SnapshotPath '' -Remove `
                    -OwnershipRecord $coworkForcedOwnership -PreservePrivateState
            }
            catch { Microsoft.PowerShell.Utility\Write-Warning ('Cowork host artifact removal did not finish; unproven or changed artifacts were kept: ' + $_.Exception.Message) }
        }
        return $preparation
    }
    catch {
        $failure = $_
        $notRestored = @(Restore-DefenseClawForcedUninstallPreparation -Preparation $preparation)
        if ($notRestored.Count -eq 0) {
            throw $failure
        }
        throw ('the forced uninstall stopped before StateRoot was moved aside (' + $failure.Exception.Message + '); these services were not restored: ' + ($notRestored -join '; '))
    }
}

function Restore-DefenseClawForcedUninstallPreparation {
    <#
        Undoes Invoke-DefenseClawForcedUninstallPreparation for a forced
        uninstall that was refused: StateRoot moves back to its path, then
        each service gets back the startup mode and running state it had.
        It acts once per preparation; a second call does nothing. Returns
        what could not be put back, so the caller rethrows the original
        refusal with it rather than a restore error.
    #>
    param([Parameter(Mandatory)]$Preparation)
    if ([bool]$Preparation.restored) {
        return
    }
    $Preparation.restored = $true
    $notRestored = [Collections.Generic.List[string]]::new()
    $movedIntentProperty = $Preparation.PSObject.Properties['moved_install_rollback_intent']
    $movedIntent = if ($null -ne $movedIntentProperty) { [string]$movedIntentProperty.Value } else { '' }
    if (-not [string]::IsNullOrEmpty($movedIntent)) {
        try {
            [IO.File]::Move($movedIntent, [string]$Preparation.install_rollback_intent)
            $Preparation.moved_install_rollback_intent = ''
        }
        catch {
            $notRestored.Add('install receipt ' + [string]$Preparation.install_rollback_intent + ' (still at ' + $movedIntent + '): ' + (ConvertTo-DefenseClawBoundedDiagnostic -Value $_.Exception.Message -MaxLength 256))
        }
    }
    $moved = [string]$Preparation.moved_state_root
    if (-not [string]::IsNullOrEmpty($moved)) {
        try {
            [IO.Directory]::Move($moved, [string]$Preparation.state_root)
            $Preparation.moved_state_root = ''
        }
        catch {
            $notRestored.Add('StateRoot (still at ' + $moved + '): ' + (ConvertTo-DefenseClawBoundedDiagnostic -Value $_.Exception.Message -MaxLength 256))
        }
    }
    # Reverse order: the gateway needs its sensor helper running.
    $services = @($Preparation.services)
    for ($index = $services.Count - 1; $index -ge 0; $index--) {
        $service = $services[$index]
        try {
            Set-DefenseClawServiceStartMode -Name $service.name -StartMode $service.start_mode
            if ($service.running) {
                Start-DefenseClawService -Name $service.name
            }
        }
        catch {
            $notRestored.Add($service.name + ': ' + (ConvertTo-DefenseClawBoundedDiagnostic -Value $_.Exception.Message -MaxLength 256))
        }
    }
    return [string[]]$notRestored.ToArray()
}

function Move-DefenseClawForcedUninstallInstallReceipt {
    <#
        A failed initial install leaves its fresh-install rollback receipt
        beside the lifecycle lock, bound to the pending transaction in
        StateRoot. The forced uninstall preparation moves StateRoot aside, so
        the pre-layout recovery refused the receipt ("bound install
        preparation lost its protected pending transaction") and every forced
        retry failed the same way (GAP-1365). A forced uninstall reads nothing
        of the transaction: the receipt moves aside too, and the state-absent
        exact-scope purge removes what the install created. A receipt of a
        committed install stays, for the recovery to complete. When the
        forced uninstall is refused, Restore-DefenseClawForcedUninstallPreparation
        puts it back; when it completes, Complete-DefenseClawForcedUninstall
        removes it.
    #>
    param(
        [Parameter(Mandatory)][hashtable]$Layout,
        [Parameter(Mandatory)]$Preparation
    )
    $path = [string]$Layout.InstallRollbackIntentPath
    if ([string]::IsNullOrWhiteSpace($path) -or
        -not (Microsoft.PowerShell.Management\Test-Path -LiteralPath $path -PathType Leaf)) {
        return
    }
    Assert-DefenseClawNoReparsePath -Path $path
    $phase = ''
    try {
        $receipt = Microsoft.PowerShell.Management\Get-Content -LiteralPath $path -Raw |
            Microsoft.PowerShell.Utility\ConvertFrom-Json
        $phaseProperty = $receipt.PSObject.Properties['phase']
        if ($null -ne $phaseProperty) {
            $phase = [string]$phaseProperty.Value
        }
    }
    catch {
        # An unreadable receipt cannot be completed either; move it aside.
        $phase = ''
    }
    if ($phase -ceq 'committed') {
        return
    }
    $moved = $path + '.forced-uninstall-' + [DateTime]::UtcNow.ToString('yyyyMMddTHHmmssZ')
    [IO.File]::Move($path, $moved)
    $Preparation.install_rollback_intent = $path
    $Preparation.moved_install_rollback_intent = $moved
}

function Invoke-DefenseClawForcedUninstall {
    <#
        Standalone Setup /uninstall FORCE=1: the preparation, then the
        state-absent exact-scope purge. When anything after the preparation
        is refused (GAP-1486: the purge's validate-only pass meets a sharing
        violation under InstallRoot), StateRoot moves back, the services get
        back the startup mode and running state they had, and the refusal is
        rethrown, so the gateway and guardian keep enforcing. A forced
        uninstall that completes restores nothing.
    #>
    param(
        [Parameter(Mandatory)][hashtable]$Layout,
        [hashtable]$Sources = @{},
        [Parameter(Mandatory)][string]$GatewayServiceName,
        [Parameter(Mandatory)][string]$GuardianServiceName,
        [switch]$Purge,
        [string]$RequestedCertificationCodexHome,
        [switch]$RequestedCoreHardeningCertification,
        [int]$SelfUninstallCallerPID
    )
    $preparation = Invoke-DefenseClawForcedUninstallPreparation `
        -Layout $Layout `
        -GatewayServiceName $GatewayServiceName `
        -GuardianServiceName $GuardianServiceName
    try {
        Move-DefenseClawForcedUninstallInstallReceipt `
            -Layout $Layout `
            -Preparation $preparation
        # The exact-scope purge refuses any file in InstallRoot whose
        # descriptor is not canonical, which DefenseClaw's own residue (a
        # guardian's <hook>.restore-<hex> temporary, a replacement backup) is
        # not: the printed FORCE=1 command then failed 1603 'foreign
        # descriptor' and named no program (GAP-1902). Remove that residue
        # first, as every normal uninstall does; one a program still runs is
        # named with its fix.
        Remove-DefenseClawStandaloneInstallTreeReplacementBackups -Layout $Layout
        $recovery = Invoke-DefenseClawPreLayoutRecovery `
            -Action Uninstall `
            -Layout $Layout `
            -Sources $Sources `
            -GatewayServiceName $GatewayServiceName `
            -GuardianServiceName $GuardianServiceName `
            -Purge:$Purge `
            -RequestedCertificationCodexHome $RequestedCertificationCodexHome `
            -RequestedCoreHardeningCertification:$RequestedCoreHardeningCertification `
            -SelfUninstallCallerPID $SelfUninstallCallerPID
        if (-not [bool]$recovery.handled) {
            throw 'the forced uninstall did not reach the state-absent removal'
        }
    }
    catch {
        $failure = $_
        $notRestored = @(Restore-DefenseClawForcedUninstallPreparation -Preparation $preparation)
        if ($notRestored.Count -eq 0) {
            throw $failure
        }
        throw ('the forced uninstall was refused (' + $failure.Exception.Message + '); these were not restored: ' + ($notRestored -join '; '))
    }
    return Complete-DefenseClawForcedUninstall `
        -Result $recovery.result `
        -MovedStateRoot $preparation.moved_state_root `
        -MovedInstallReceipt $preparation.moved_install_rollback_intent `
        -Layout $Layout
}

function Restore-DefenseClawForcedUninstallCodexPolicy {
    <#
        Standalone Setup /uninstall FORCE=1 skips the managed-hook teardown,
        so Codex requirements.toml is still DefenseClaw's merged postimage,
        whose hooks run the defenseclaw-hook.exe the forced purge removed,
        and the only copy of the administrator's original is the ownership
        record in the StateRoot the preparation moved aside. That folder used
        to be deleted with the record in it (GAP-0028). Before it goes, the
        original is put back (Invoke-DefenseClawNuclearCodexRequirements:
        only from a protected record for a hook in this InstallRoot, and only
        while the file is still byte for byte the recorded postimage), and
        DefenseClaw's Codex
        state and lock go with it. Returns '' when nothing more needs the
        moved StateRoot, or why it must stay: then the record is kept for a
        restore by hand.
    #>
    param(
        [hashtable]$Layout = @{},
        [Parameter(Mandatory)][string]$MovedStateRoot
    )
    $ownershipPath = [IO.Path]::Combine($MovedStateRoot, 'install', 'codex-requirements-ownership.json')
    if (-not (Test-DefenseClawPathPresentNoFollow -Path $ownershipPath)) {
        return ''
    }
    $installRoot = [string]$Layout['InstallRoot']
    if ([string]::IsNullOrWhiteSpace($installRoot)) {
        return 'the forced uninstall did not resolve its InstallRoot, so it could not prove the Codex ownership record is this deployment''s'
    }
    $folder = [IO.Path]::Combine($script:ProgramData, 'OpenAI', 'Codex')
    $owner = Get-DefenseClawNuclearConnectorOwner `
        -StatePath ([IO.Path]::Combine($folder, '.defenseclaw-managed-hooks.state')) `
        -InstallRoot $installRoot
    if ($owner.Owner -cin @('foreign', 'unknown')) {
        return "the Codex machine policy in $folder is not this deployment's to restore ($($owner.Owner): $($owner.Detail))"
    }
    $scoped = $Layout.Clone()
    $scoped['StateRoot'] = $MovedStateRoot
    $warnings = [Collections.Generic.List[string]]::new()
    $outcome = Invoke-DefenseClawNuclearCodexRequirements `
        -Layout $scoped `
        -Warnings $warnings
    if ($outcome -ceq 'kept') {
        return ($warnings -join '; ')
    }
    foreach ($leaf in @('.defenseclaw-managed-hooks.state', '.defenseclaw-managed-hooks.lock')) {
        $remaining = [Collections.Generic.List[string]]::new()
        [void](Remove-DefenseClawNuclearPath -Path ([IO.Path]::Combine($folder, $leaf)) -Remaining $remaining)
    }
    return ''
}

function Complete-DefenseClawForcedUninstall {
    <#
        Removes the StateRoot a forced uninstall moved aside, as every
        standalone uninstall removes StateRoot, and marks the result. A folder
        that cannot be removed is named in forced_state_root_kept.
    #>
    param(
        [Parameter(Mandatory)]$Result,
        [AllowEmptyString()][string]$MovedStateRoot,
        [AllowEmptyString()][string]$MovedInstallReceipt,
        [hashtable]$Layout = @{}
    )
    $kept = ''
    $codexKeep = ''
    if (-not [string]::IsNullOrWhiteSpace($MovedStateRoot)) {
        try {
            $codexKeep = [string](Restore-DefenseClawForcedUninstallCodexPolicy `
                -Layout $Layout `
                -MovedStateRoot $MovedStateRoot)
        }
        catch {
            $codexKeep = 'the Codex machine policy could not be checked: ' + $_.Exception.Message
        }
    }
    if (-not [string]::IsNullOrWhiteSpace($MovedInstallReceipt)) {
        try {
            Microsoft.PowerShell.Management\Remove-Item -LiteralPath $MovedInstallReceipt -Force -ErrorAction Stop
        }
        catch {
            $Result |
                Microsoft.PowerShell.Utility\Add-Member -MemberType NoteProperty -Name forced_install_receipt_kept -Value ("${MovedInstallReceipt}: " + (ConvertTo-DefenseClawBoundedDiagnostic -Value $_.Exception.Message -MaxLength 512)) -Force
        }
    }
    if ($codexKeep) {
        # The ownership record in it is the only copy of the administrator's
        # original Codex requirements.toml (GAP-0028).
        $kept = "${MovedStateRoot}: kept because " + (ConvertTo-DefenseClawBoundedDiagnostic -Value $codexKeep -MaxLength 768) +
            "; the administrator's original is the base64 preimage in install\codex-requirements-ownership.json there"
    }
    elseif (-not [string]::IsNullOrWhiteSpace($MovedStateRoot)) {
        try {
            Remove-DefenseClawManagedTree `
                -Path $MovedStateRoot `
                -RequiredBase $script:ProgramData `
                -Label 'moved StateRoot'
        }
        catch {
            $kept = "${MovedStateRoot}: " + (ConvertTo-DefenseClawBoundedDiagnostic -Value $_.Exception.Message -MaxLength 512)
        }
    }
    $Result |
        Microsoft.PowerShell.Utility\Add-Member -MemberType NoteProperty -Name forced -Value $true -Force
    if ($kept) {
        $Result |
            Microsoft.PowerShell.Utility\Add-Member -MemberType NoteProperty -Name forced_state_root_kept -Value $kept -Force
    }
    return $Result
}

function Get-DefenseClawTeardownJournalPhase {
    <#
        The phase a managed-hook teardown journal records, or an empty string
        when it cannot be read: an unreadable journal is not provably
        finished, and the teardown command reports it.
    #>
    param([Parameter(Mandatory)][string]$Path)
    try {
        $journal = Microsoft.PowerShell.Management\Get-Content -LiteralPath $Path -Raw |
            Microsoft.PowerShell.Utility\ConvertFrom-Json
        $phaseProperty = $journal.PSObject.Properties['phase']
        if ($null -ne $phaseProperty) {
            return [string]$phaseProperty.Value
        }
    }
    catch {
        return ''
    }
    return ''
}

function Remove-DefenseClawRolledBackTeardownJournal {
    <#
        Standalone. Removes the managed-hook teardown journal of a teardown
        that was rolled back (phase rolled_back) when no transaction is
        pending: the rollback that wrote that phase finished, so nothing reads
        it again. Left behind, it made the next uninstall fail "managed-hook
        teardown journal does not match the protected deployment" once the
        deployment changed, and that failed uninstall stayed pending
        (GAP-1041). With -Stale the removal is reported as
        stale_lifecycle_journal_removed. Returns whether it removed the file.
    #>
    param(
        [Parameter(Mandatory)][hashtable]$Layout,
        [switch]$Stale
    )
    $path = [string]$Layout.ManagedHooksTeardownJournalPath
    if (-not (Microsoft.PowerShell.Management\Test-Path -LiteralPath $path -PathType Leaf) -or
        (Microsoft.PowerShell.Management\Test-Path -LiteralPath $Layout.PendingPath)) {
        return $false
    }
    Assert-DefenseClawNoReparsePath -Path $path
    if ((Get-DefenseClawTeardownJournalPhase -Path $path) -cne 'rolled_back') {
        return $false
    }
    Microsoft.PowerShell.Management\Remove-Item -LiteralPath $path -Force
    if ($Stale) {
        $script:DefenseClawStaleTeardownJournalRemoved = $path
    }
    return $true
}

function Get-DefenseClawNuclearSafeRootPattern {
    <#
        The only roots the Secure Client nuclear --purge uninstall may touch:
        the production Secure Client InstallRoot and StateRoot, or their
        -Cert certification siblings, the -Lifecycle receipt directory, and
        anything below them. Built from Get-DefenseClawProfileRoots so the
        vendor literals stay in one place.
    #>
    param(
        # Also admit the .retired-<32 hex> siblings a failed rename left
        # beside those roots (the purge removes them).
        [switch]$AllowRetired
    )
    $roots = Get-DefenseClawProfileRoots -EnterpriseProfile SecureClient
    $alternatives = foreach ($root in @($roots.InstallRoot, $roots.StateRoot)) {
        [regex]::Escape([IO.Path]::GetFullPath([string]$root).TrimEnd('\'))
    }
    $retired = if ($AllowRetired) { '(\.retired-[0-9a-f]{32})?' } else { '' }
    return '^(' + ($alternatives -join '|') + ')(-Cert|-Lifecycle)?' + $retired + '(\\|$)'
}

function Invoke-DefenseClawNuclearSilentExec {
    # Helper for the nuclear path only. Runs a native console-subsystem
    # binary (sc.exe, taskkill.exe, icacls.exe) without spawning a visible
    # console window. The outer DefenseClawSetup EXE launches
    # install-enterprise.ps1 under a PowerShell host that does not inherit
    # an interactive console - so every `& $exe ...` style call flashes a
    # brief console window per invocation. Using ProcessStartInfo with
    # CreateNoWindow=true keeps the nuclear teardown silent regardless of
    # how the Setup EXE invoked its PowerShell host.
    #
    # MUST use ProcessStartInfo.Arguments (not .ArgumentList): the
    # ArgumentList collection is .NET Core 2.1+ only, and Windows
    # PowerShell 5.1 (the default host shipped with Windows and the one
    # the Setup EXE spawns) runs on .NET Framework 4.x which does not
    # have it. ConvertTo-DefenseClawWindowsCommandLine applies the
    # standard CommandLineToArgvW quoting rules so each argument is parsed
    # as a distinct token by the callee.
    #
    # Both output streams are drained concurrently, standard input is
    # closed so a prompting tool reads end-of-file instead of waiting, and
    # the child is killed when it outlives -TimeoutSeconds: a flood of
    # per-file errors on stderr can never deadlock the purge, and no child
    # can hang it.
    #
    # Errors are intentionally not thrown - this is the nuclear path, not a
    # validator. Non-zero exit codes are expected (service already gone,
    # file already removed, etc). -PassThru returns the exit code and
    # output for the callers that classify them.
    param(
        [Parameter(Mandatory)][string]$File,
        [string[]]$Arguments = @(),
        [ValidateRange(1, 1800)][int]$TimeoutSeconds = 120,
        [switch]$PassThru
    )
    $result = [pscustomobject]@{
        exit_code = -1
        timed_out = $false
        output    = ''
    }
    $process = $null
    try {
        $psi = [Diagnostics.ProcessStartInfo]::new()
        $psi.FileName               = $File
        $psi.Arguments              = ConvertTo-DefenseClawWindowsCommandLine `
            -Arguments $Arguments
        $psi.UseShellExecute        = $false
        $psi.CreateNoWindow         = $true
        $psi.RedirectStandardInput  = $true
        $psi.RedirectStandardOutput = $true
        $psi.RedirectStandardError  = $true
        $process = [Diagnostics.Process]::Start($psi)
        if ($null -ne $process) {
            $stdout = $process.StandardOutput.ReadToEndAsync()
            $stderr = $process.StandardError.ReadToEndAsync()
            $process.StandardInput.Close()
            if (-not $process.WaitForExit($TimeoutSeconds * 1000)) {
                $result.timed_out = $true
                try {
                    $process.Kill()
                }
                catch {
                    Microsoft.PowerShell.Utility\Write-Verbose "could not stop timed-out $File : $($_.Exception.Message)"
                }
                [void]$process.WaitForExit(5000)
            }
            else {
                # The parameterless wait also flushes the asynchronous reads.
                $process.WaitForExit()
                $result.exit_code = [int]$process.ExitCode
            }
            if ($stdout.Wait(5000) -and $stderr.Wait(5000)) {
                $result.output = [string]$stdout.Result + [string]$stderr.Result
            }
        }
    }
    catch {
        $result.output = [string]$_.Exception.Message
    }
    finally {
        if ($null -ne $process) {
            $process.Dispose()
        }
    }
    if ($PassThru) {
        return $result
    }
}

# Probes a service by name through sc.exe query, so a descriptor that denies
# Administrators query reads as present-but-unreadable instead of absent.
# Returns absent, present, unreadable or marked_for_delete.
function Get-DefenseClawNuclearServicePresence {
    param([Parameter(Mandatory)][string]$Name)
    $query = Invoke-DefenseClawNuclearSilentExec `
        -File $script:ScExe `
        -Arguments @('query', $Name) `
        -TimeoutSeconds 30 `
        -PassThru
    switch ([int]$query.exit_code) {
        1060 { return 'absent' }
        5 { return 'unreadable' }
        1072 { return 'marked_for_delete' }
        0 {
            return 'present'
        }
        default {
            return 'present'
        }
    }
}

# True when Windows already has file operations queued for the next restart.
function Test-DefenseClawPendingFileRenameOperations {
    try {
        $value = Microsoft.PowerShell.Management\Get-ItemProperty `
            -LiteralPath 'HKLM:\SYSTEM\CurrentControlSet\Control\Session Manager' `
            -Name PendingFileRenameOperations `
            -ErrorAction Stop
        return (@($value.PendingFileRenameOperations | Microsoft.PowerShell.Core\Where-Object {
                    -not [string]::IsNullOrWhiteSpace([string]$_)
                }).Count -gt 0)
    }
    catch {
        return $false
    }
}

# Removes one DefenseClaw tree or file for the purge, whatever its ACL or
# owner. The privileged native walk deletes without rewriting any descriptor;
# without the native helper, icacls makes Administrators the owner (by SID,
# so no localized prompt answer is involved) and grants them access before
# Remove-Item. Locked entries are retried, then queued for deletion at the
# next restart. A root that still survives is re-stamped canonically, so the
# next Install never meets an inherited "Users create" residue. Returns the
# leftover description, or '' when the path is gone.
#
# -AcceptScheduledDelete (the purge): a path whose every surviving entry was
# queued for deletion at the next restart is not a failure. It sets
# reboot_required, logs defenseclaw_recover naming what was queued, and
# returns ''. With -RetireSiblingPattern a surviving directory is first
# renamed to a <leaf>.retired-<128-bit> sibling that matches the pattern, so
# the next Install finds its own name free; the sibling is what gets queued.
function Remove-DefenseClawNuclearPath {
    <#
        Two callers, told apart by their parameters.

        -Remaining: the standalone forced uninstall's Codex state and lock.
        Removes one DefenseClaw path (a file or a folder tree) below
        ProgramData or Program Files, never through a link. Every
        component from the volume root down must be a real folder or file
        (Assert-DefenseClawNuclearPathNoLink); the folders between that base
        and the path are held open (OpenDirectoryPinNoFollow) while the path
        goes, so none can be swapped for a junction meanwhile; and the tree
        goes through Remove-DefenseClawNoFollowTree. Only a path SYSTEM,
        Administrators or TrustedInstaller owns gets its drifted access
        recovered (-RecoverAccess); one a standard user created where
        DefenseClaw's would be is removed with that user's own access or left.
        Returns whether the path is gone; what stays is added to Remaining.

        -Role, -RebootRequired, -AcceptScheduledDelete and
        -RetireSiblingPattern: the Secure Client purge (see the comment above).
        Returns the leftover description, or '' when the path is gone.
    #>
    [CmdletBinding(DefaultParameterSetName = 'NoFollow')]
    param(
        [Parameter(Mandatory)][string]$Path,
        [Parameter(Mandatory, ParameterSetName = 'NoFollow')][AllowEmptyCollection()]
        [Collections.Generic.List[string]]$Remaining,
        [Parameter(Mandatory, ParameterSetName = 'Purge')][string]$Role,
        [Parameter(Mandatory, ParameterSetName = 'Purge')][ref]$RebootRequired,
        [Parameter(ParameterSetName = 'Purge')][switch]$AcceptScheduledDelete,
        [Parameter(ParameterSetName = 'Purge')][string]$RetireSiblingPattern = ''
    )
    if ($PSCmdlet.ParameterSetName -ceq 'NoFollow') {
        try {
            $full = [IO.Path]::GetFullPath($Path).TrimEnd('\')
            Assert-DefenseClawNuclearPathNoLink -Path $full
            if (-not (Test-DefenseClawPathPresentNoFollow -Path $full)) {
                return $true
            }
        }
        catch {
            $Remaining.Add("${Path}: $($_.Exception.Message); left as found")
            return $false
        }
        $base = $null
        foreach ($candidate in @($script:ProgramData, $script:ProgramFiles)) {
            $candidateFull = [IO.Path]::GetFullPath([string]$candidate).TrimEnd('\')
            if ($full.StartsWith($candidateFull + '\', [StringComparison]::OrdinalIgnoreCase)) {
                $base = $candidateFull
                break
            }
        }
        if ($null -eq $base) {
            $Remaining.Add("${full}: outside ProgramData and Program Files; left as found")
            return $false
        }
        $recoverAccess = Test-DefenseClawNuclearTrustedOwner -Path $full
        $nativeSecurity = Initialize-DefenseClawNativeSecurity
        $pins = [Collections.Generic.List[IntPtr]]::new()
        try {
            $parts = @($full.Substring($base.Length + 1).Split([char]'\'))
            $current = $base
            for ($index = 0; $index -lt $parts.Count - 1; $index++) {
                $current = [IO.Path]::Combine($current, [string]$parts[$index])
                $pins.Add($nativeSecurity::OpenDirectoryPinNoFollow($current))
            }
            return [bool](Remove-DefenseClawNoFollowTree `
                -Path $full `
                -Remaining $Remaining `
                -RecoverAccess:$recoverAccess)
        }
        catch {
            $Remaining.Add("${full}: $($_.Exception.Message); left as found")
            return $false
        }
        finally {
            foreach ($pin in $pins) {
                $nativeSecurity::CloseDirectoryPin($pin)
            }
        }
    }
    if (-not (Microsoft.PowerShell.Management\Test-Path -LiteralPath $Path)) {
        return ''
    }
    $nativeSecurity = $null
    try {
        $nativeSecurity = Initialize-DefenseClawNativeSecurity
    }
    catch {
        Microsoft.PowerShell.Utility\Write-Verbose "native purge helper unavailable, using icacls: $($_.Exception.Message)"
    }
    $detail = ''
    for ($attempt = 1; $attempt -le 4; $attempt++) {
        if ($null -ne $nativeSecurity) {
            try {
                $failures = @($nativeSecurity::DeleteTreePrivileged($Path))
                if ($failures.Count -gt 0) {
                    $detail = [string]$failures[0]
                }
            }
            catch {
                $detail = [string]$_.Exception.Message
            }
        }
        if (Microsoft.PowerShell.Management\Test-Path -LiteralPath $Path) {
            [void](Invoke-DefenseClawNuclearSilentExec `
                -File $script:IcaclsExe `
                -Arguments @($Path, '/setowner', "*$script:AdministratorsSID", '/T', '/C', '/L', '/Q') `
                -TimeoutSeconds 600)
            $grant = if (Microsoft.PowerShell.Management\Test-Path -LiteralPath $Path -PathType Container) {
                "*$($script:AdministratorsSID):(OI)(CI)F"
            }
            else {
                "*$($script:AdministratorsSID):F"
            }
            [void](Invoke-DefenseClawNuclearSilentExec `
                -File $script:IcaclsExe `
                -Arguments @($Path, '/grant', $grant, '/T', '/C', '/L', '/Q') `
                -TimeoutSeconds 600)
            try {
                Microsoft.PowerShell.Management\Remove-Item `
                    -LiteralPath $Path `
                    -Recurse `
                    -Force `
                    -ErrorAction Stop
            }
            catch {
                $detail = [string]$_.Exception.Message
            }
        }
        if (-not (Microsoft.PowerShell.Management\Test-Path -LiteralPath $Path)) {
            return ''
        }
        Microsoft.PowerShell.Utility\Start-Sleep -Milliseconds (400 * $attempt)
    }
    # A directory still held open is moved aside first when the caller
    # allows it: renaming works while files inside are in use far more often
    # than deleting, and it frees the name for the next Install.
    $scheduleRoot = $Path
    if (-not [string]::IsNullOrWhiteSpace($RetireSiblingPattern) -and
        (Microsoft.PowerShell.Management\Test-Path -LiteralPath $Path -PathType Container)) {
        $sibling = [IO.Path]::GetFullPath($Path).TrimEnd('\') +
            '.retired-' + [Guid]::NewGuid().ToString('N')
        if ($sibling -match $RetireSiblingPattern -and
            -not (Microsoft.PowerShell.Management\Test-Path -LiteralPath $sibling)) {
            try {
                [IO.Directory]::Move($Path, $sibling)
                $scheduleRoot = $sibling
                Microsoft.PowerShell.Utility\Write-Verbose "moved surviving $Path aside to $sibling"
            }
            catch {
                Microsoft.PowerShell.Utility\Write-Verbose "could not move surviving $Path aside: $($_.Exception.Message)"
            }
        }
    }
    # Whatever is still held open is queued for the next restart, deepest
    # entries first so each folder is empty by the time its turn comes.
    $scheduled = $false
    # A restart only removes a queued folder once it is empty, so a listing
    # that skipped a child (access denied, say) cannot be reported as queued.
    $listingComplete = $false
    if ($null -ne $nativeSecurity) {
        # Bind the listing to no-follow handles: a path walk could enumerate
        # the target of a root or child swapped for a junction after
        # discovery. A reparse point is listed as the link itself.
        $listingErrors = [Collections.Generic.List[object]]::new()
        $treeFailures = [string[]]@()
        $treeEntries = [string[]]@()
        try {
            $treeEntries = [string[]]$nativeSecurity::ListTreeNoFollow($scheduleRoot, [ref]$treeFailures)
        }
        catch {
            $listingErrors.Add("$scheduleRoot : $($_.Exception.Message)")
        }
        foreach ($treeFailure in @($treeFailures)) {
            if (-not [string]::IsNullOrEmpty([string]$treeFailure)) {
                $listingErrors.Add([string]$treeFailure)
            }
        }
        if (@($treeEntries).Count -eq 0 -and $listingErrors.Count -eq 0) {
            $listingErrors.Add("$scheduleRoot : could not be opened for listing")
        }
        $leftovers = @(
            @(@($treeEntries) | Microsoft.PowerShell.Core\Where-Object {
                    -not [string]::Equals([string]$_, $scheduleRoot, [StringComparison]::OrdinalIgnoreCase)
                } | Microsoft.PowerShell.Utility\Sort-Object -Property Length -Descending) +
            @($scheduleRoot)
        )
        $listingComplete = ($listingErrors.Count -eq 0)
        if (-not $listingComplete) {
            $detail += " (could not list every entry for restart deletion: $(@($listingErrors)[0]))"
        }
        $scheduled = $true
        foreach ($leftover in $leftovers) {
            try {
                if (-not $nativeSecurity::ScheduleDeleteOnRestart($leftover)) {
                    $scheduled = $false
                }
            }
            catch {
                $scheduled = $false
            }
        }
        if ($scheduled) {
            $RebootRequired.Value = $true
        }
        # $scheduleRoot is where the folder is now: $Path itself, or the
        # .retired sibling it was renamed to.
        if (Microsoft.PowerShell.Management\Test-Path -LiteralPath $scheduleRoot -PathType Container) {
            try {
                $canonical = New-DefenseClawCanonicalPathAcl `
                    -IsDirectory $true `
                    -Kind AdminDirectory `
                    -GatewayServiceSID $script:AdministratorsSID
                [void]$nativeSecurity::SetPathSecurityDescriptorPrivilegedNoFollow(
                    $scheduleRoot,
                    $canonical.GetSecurityDescriptorSddlForm(
                        [Security.AccessControl.AccessControlSections]::All
                    ),
                    $true
                )
            }
            catch {
                Microsoft.PowerShell.Utility\Write-Verbose "could not re-stamp surviving $scheduleRoot : $($_.Exception.Message)"
            }
        }
    }
    if ($scheduled -and $listingComplete -and $AcceptScheduledDelete) {
        $recoverFields = @{
            path   = $scheduleRoot
            role   = $Role
            reason = 'still in use; queued for deletion at the next restart'
        }
        if ($scheduleRoot -cne $Path) {
            $recoverFields['original'] = $Path
        }
        Write-DefenseClawResilienceEvent -Marker defenseclaw_recover -Fields $recoverFields
        return ''
    }
    foreach ($privilege in @($script:MissingFilePrivileges)) {
        if (-not $detail.Contains([string]$privilege)) {
            $detail += " ($privilege missing)"
        }
    }
    if ($scheduleRoot -cne $Path) {
        return ('{0} {1} survived the purge (moved aside to {2}): {3}' -f $Role, $Path, $scheduleRoot, $detail)
    }
    return ('{0} {1} survived the purge: {2}' -f $Role, $Path, $detail)
}

# True when $Path is an existing directory and neither it nor any ancestor is
# a reparse point, so a purge of it cannot be redirected into another folder.
function Test-DefenseClawNuclearRealDirectoryPath {
    param([Parameter(Mandatory)][string]$Path)
    $reparse = [IO.FileAttributes]::ReparsePoint
    try {
        $current = [IO.Path]::GetFullPath($Path)
        if (([IO.File]::GetAttributes($current) -band [IO.FileAttributes]::Directory) -eq 0) {
            return $false
        }
        while (-not [string]::IsNullOrEmpty($current)) {
            if (([IO.File]::GetAttributes($current) -band $reparse) -ne 0) {
                return $false
            }
            $current = [IO.Path]::GetDirectoryName($current)
        }
        return $true
    }
    catch {
        Microsoft.PowerShell.Utility\Write-Verbose "user data folder $Path is unreadable: $($_.Exception.Message)"
    }
    return $false
}

# True when <profile>\.defenseclaw is a real folder (no reparse point in its path) that
# holds the managed runtime's own evidence: an immutable runtime generation
# (hooks\.managed-runtime-<connector>-<id>.json) or a hook contract lock bound
# to a managed gateway service. A per-user DefenseClaw install never writes
# either, so its data is not taken by the managed purge.
function Test-DefenseClawNuclearManagedUserDataFolder {
    param([Parameter(Mandatory)][string]$Path)
    $reparse = [IO.FileAttributes]::ReparsePoint
    if (-not (Test-DefenseClawNuclearRealDirectoryPath -Path $Path)) {
        return $false
    }
    try {
        $hooks = [IO.Path]::Combine($Path, 'hooks')
        if ([IO.Directory]::Exists($hooks) -and
            ([IO.File]::GetAttributes($hooks) -band $reparse) -eq 0) {
            foreach ($bundle in @(Microsoft.PowerShell.Management\Get-ChildItem `
                    -LiteralPath $hooks `
                    -Force `
                    -File `
                    -Filter '.managed-runtime-*.json' `
                    -ErrorAction SilentlyContinue)) {
                if ([string]$bundle.Name -cmatch '^\.managed-runtime-(claudecode|codex|cursor)-[^\\/]+\.json$' -and
                    ($bundle.Attributes -band $reparse) -eq 0) {
                    return $true
                }
            }
        }
        $lock = [IO.Path]::Combine($Path, 'hook_contract_lock.json')
        if ([IO.File]::Exists($lock)) {
            $lockInfo = [IO.FileInfo]::new($lock)
            if (($lockInfo.Attributes -band $reparse) -eq 0 -and
                $lockInfo.Length -le 1048576 -and
                [IO.File]::ReadAllText($lock).Contains('"managed_gateway_service_name"')) {
                return $true
            }
        }
    }
    catch {
        Microsoft.PowerShell.Utility\Write-Verbose "user data folder $Path is unreadable: $($_.Exception.Message)"
    }
    return $false
}

# Returns every registered local profile as { sid, home }, with home the
# expanded full ProfileImagePath without a trailing separator. An unreadable
# profile list returns nothing, which keeps the purge away from every home.
function Get-DefenseClawNuclearRegisteredProfiles {
    $registered = [Collections.Generic.List[object]]::new()
    try {
        foreach ($entry in @(Microsoft.PowerShell.Management\Get-ChildItem `
                -LiteralPath 'HKLM:\SOFTWARE\Microsoft\Windows NT\CurrentVersion\ProfileList' `
                -ErrorAction Stop)) {
            $image = [string](Microsoft.PowerShell.Management\Get-ItemProperty `
                -LiteralPath $entry.PSPath `
                -Name ProfileImagePath `
                -ErrorAction SilentlyContinue).ProfileImagePath
            if (-not [string]::IsNullOrWhiteSpace($image)) {
                $registered.Add([pscustomobject]@{
                    sid  = [string]$entry.PSChildName
                    home = [IO.Path]::GetFullPath(
                        [Environment]::ExpandEnvironmentVariables($image)
                    ).TrimEnd('\')
                })
            }
        }
    }
    catch {
        Microsoft.PowerShell.Utility\Write-Verbose "profile list is unreadable: $($_.Exception.Message)"
    }
    return $registered.ToArray()
}

# Lists each enrolled user's DefenseClaw data folder, before anything of the
# deployment is removed. Users come from the protected target manifest's
# data_dir rows and, because those rows are optional (Go derives the default
# <home>\.defenseclaw, and the installer-rendered manifest never writes one)
# and the manifest can be missing or unreadable, also from every registered
# interactive profile whose <profile>\.defenseclaw holds managed-runtime
# evidence. Only a canonical <profile>\.defenseclaw under a registered local
# profile, a real folder with no reparse point in its path, is returned, together with that profile's setup staging folders, so
# the purge never reaches anything else in a home.
function Get-DefenseClawNuclearUserDataPaths {
    param([Parameter(Mandatory)][string]$StateRoot)
    $paths = [Collections.Generic.List[string]]::new()
    $manifest = [IO.Path]::Combine($StateRoot, 'hook-guardian', 'targets.yaml')
    $profiles = @{}
    $interactiveProfiles = [Collections.Generic.List[string]]::new()
    foreach ($registered in @(Get-DefenseClawNuclearRegisteredProfiles)) {
        $profiles[([string]$registered.home).ToUpperInvariant()] = $true
        if ([string]$registered.sid -match '^S-1-(5-21|12-1)-[0-9-]+$') {
            $interactiveProfiles.Add([string]$registered.home)
        }
    }
    $addStaging = {
        param([string]$ProfileHome)
        foreach ($staging in @(Microsoft.PowerShell.Management\Get-ChildItem `
                -LiteralPath $ProfileHome `
                -Force `
                -Filter '.defenseclaw.setup-*' `
                -ErrorAction SilentlyContinue)) {
            if ([string]$staging.Name -cmatch '^\.defenseclaw\.setup-[0-9a-f]{32}$' -and
                (Test-DefenseClawNuclearRealDirectoryPath -Path ([string]$staging.FullName)) -and
                -not $paths.Contains([string]$staging.FullName)) {
                $paths.Add([string]$staging.FullName)
            }
        }
    }
    $text = ''
    try {
        if ([IO.File]::Exists($manifest) -and
            ([IO.FileInfo]::new($manifest)).Length -le 4194304) {
            $text = [IO.File]::ReadAllText($manifest)
        }
    }
    catch {
        Microsoft.PowerShell.Utility\Write-Verbose "target manifest is unreadable: $($_.Exception.Message)"
    }
    foreach ($match in [regex]::Matches($text, '(?m)^\s*-?\s*data_dir:\s*["'']?([^"''\r\n]+?)["'']?\s*$')) {
        $raw = $match.Groups[1].Value.Replace('\\', '\')
        try {
            $data = [IO.Path]::GetFullPath($raw).TrimEnd('\')
        }
        catch {
            continue
        }
        $profileHome = [IO.Path]::GetDirectoryName($data)
        if ([string]::IsNullOrWhiteSpace($profileHome) -or
            -not [string]::Equals([IO.Path]::GetFileName($data), '.defenseclaw', [StringComparison]::OrdinalIgnoreCase) -or
            -not $profiles.ContainsKey($profileHome.TrimEnd('\').ToUpperInvariant())) {
            continue
        }
        # A manifest row is administrator-authored but still names a path
        # inside a user's home: a link there must not steer the purge.
        if (-not (Test-DefenseClawNuclearRealDirectoryPath -Path $data)) {
            continue
        }
        if (-not $paths.Contains($data)) {
            $paths.Add($data)
        }
        & $addStaging $profileHome
    }
    foreach ($profileHome in $interactiveProfiles) {
        $data = [IO.Path]::Combine($profileHome, '.defenseclaw')
        $known = $false
        foreach ($path in $paths) {
            if ([string]::Equals($path, $data, [StringComparison]::OrdinalIgnoreCase)) {
                $known = $true
                break
            }
        }
        if ($known -or -not (Test-DefenseClawNuclearManagedUserDataFolder -Path $data)) {
            continue
        }
        $paths.Add($data)
        & $addStaging $profileHome
    }
    return $paths.ToArray()
}

# Lists this scope's gateway and broker worker processes, and with
# -IncludeSensorHelper its sensor helper (the purge; the Install quiesce keeps
# that service running). Only an image under this deployment's InstallRoot
# (or a retired sibling of it) counts, so a side-by-side scope's workers are
# never counted or stopped. A process whose image path cannot be read is not
# attributed to this scope.
function Get-DefenseClawScopeWorkerProcesses {
    param(
        [AllowEmptyString()][string]$InstallRoot = '',
        [switch]$IncludeSensorHelper
    )
    $found = [Collections.Generic.List[object]]::new()
    if ([string]::IsNullOrWhiteSpace($InstallRoot)) {
        return @()
    }
    $root = [IO.Path]::GetFullPath($InstallRoot).TrimEnd('\')
    $nativeSecurityType = $null
    try {
        $nativeSecurityType = Initialize-DefenseClawNativeSecurity
    }
    catch {
        $nativeSecurityType = $null
    }
    $images = @('defenseclaw-cmid-broker.exe', 'defenseclaw-gateway.exe')
    if ($IncludeSensorHelper) {
        $images += 'defenseclaw-sensor-helper.exe'
    }
    foreach ($image in $images) {
        $candidates = @(Microsoft.PowerShell.Management\Get-Process `
            -Name ([IO.Path]::GetFileNameWithoutExtension($image)) `
            -ErrorAction SilentlyContinue)
        foreach ($candidate in $candidates) {
            $imagePath = ''
            if ($null -ne $nativeSecurityType) {
                try {
                    $imagePath = [string]$nativeSecurityType::GetProcessImagePath(
                        [uint32]$candidate.Id
                    )
                }
                catch {
                    $imagePath = ''
                }
            }
            if ([string]::IsNullOrWhiteSpace($imagePath)) {
                try {
                    $imagePath = [string]$candidate.Path
                }
                catch {
                    $imagePath = ''
                }
            }
            if ([string]::IsNullOrWhiteSpace($imagePath)) {
                Microsoft.PowerShell.Utility\Write-Verbose "not attributing $image pid=$($candidate.Id) to this scope: its image path is unreadable"
                continue
            }
            try {
                $full = [IO.Path]::GetFullPath($imagePath)
            }
            catch {
                continue
            }
            if ($full.StartsWith($root + '\', [StringComparison]::OrdinalIgnoreCase) -or
                $full.StartsWith($root + '.retired-', [StringComparison]::OrdinalIgnoreCase)) {
                $found.Add([pscustomobject]@{
                    Id    = [int]$candidate.Id
                    Image = $image
                    Path  = $full
                })
            }
        }
    }
    return @($found.ToArray())
}

# Terminates this scope's exact-image workers (see
# Get-DefenseClawScopeWorkerProcesses) and waits, bounded, for them to go.
# Returns the workers still running after the wait. SCM failure actions must
# already be disarmed, or the kill is answered with a restart.
function Stop-DefenseClawScopeWorkerProcesses {
    param(
        [AllowEmptyString()][string]$InstallRoot = '',
        [int]$WaitSeconds = 10,
        [switch]$IncludeSensorHelper
    )
    $workers = @(Get-DefenseClawScopeWorkerProcesses `
        -InstallRoot $InstallRoot `
        -IncludeSensorHelper:$IncludeSensorHelper)
    if ($workers.Count -eq 0) {
        return @()
    }
    foreach ($worker in $workers) {
        try {
            Microsoft.PowerShell.Management\Stop-Process `
                -Id $worker.Id `
                -Force `
                -ErrorAction Stop
            Write-DefenseClawResilienceEvent -Marker defenseclaw_recover -Fields @{
                path    = [string]$worker.Path
                process = [string]$worker.Id
                reason  = 'terminated a worker of this deployment that outlived its service stop'
            }
        }
        catch {
            Microsoft.PowerShell.Utility\Write-Verbose "could not terminate $($worker.Image) pid=$($worker.Id): $($_.Exception.Message)"
        }
    }
    $deadline = [DateTime]::UtcNow.AddSeconds([Math]::Max(1, $WaitSeconds))
    $remaining = @()
    do {
        $remaining = @(Get-DefenseClawScopeWorkerProcesses `
            -InstallRoot $InstallRoot `
            -IncludeSensorHelper:$IncludeSensorHelper)
        if ($remaining.Count -eq 0) {
            return @()
        }
        Microsoft.PowerShell.Utility\Start-Sleep -Milliseconds 250
    } while ([DateTime]::UtcNow -lt $deadline)
    return @($remaining)
}

function Get-DefenseClawManagedUserRuntimeEntryNames {
    <#
        The entries DefenseClaw's managed runtime writes into an account's
        %USERPROFILE%\.defenseclaw: the root leaves of the managed runtime
        cleanup contract (windowsManagedRuntimeCleanupSpecs in
        internal/enterprisehooks/target_runtime_setup_windows.go). hooks
        holds the hook scripts, .hookcfg and .hookcfg.lock, the per-connector
        .hookcfg.<connector> and hook tokens, and the runtime generations;
        hook_contract_lock.json and its lock file are the hook contract
        lock; inventory.db and its SQLite sidecars are the gateway's
        inventory; logs holds hook-failures.jsonl, which the managed hook
        appends to when a hook fails or fails open (hookexec
        logHookFailure). Nothing else in the folder is removed, and a folder
        that carries a per-user install's markers is never touched.
    #>
    return @(
        'hooks',
        'logs',
        'hook_contract_lock.json',
        'hook_contract_lock.json.lock',
        'inventory.db',
        'inventory.db-journal',
        'inventory.db-shm',
        'inventory.db-wal'
    )
}

function Get-DefenseClawPerUserInstallLeftoverNames {
    <#
        The entries a per-user (non-managed) DefenseClaw install keeps in
        %USERPROFILE%\.defenseclaw and the managed runtime never writes
        there (windowsPerUserInstallLeftovers in
        internal/enterprisehooks/target_runtime_setup_windows.go). A folder
        that holds one belongs to a per-user install and is left as found.
    #>
    return @('config.yaml', 'audit.db', '.venv', 'installer')
}

function Test-DefenseClawPathPresentNoFollow {
    # Whether something (a link included) is at Path, without following it.
    param([Parameter(Mandatory)][string]$Path)
    try {
        [void][IO.File]::GetAttributes($Path)
        return $true
    }
    catch [IO.FileNotFoundException], [IO.DirectoryNotFoundException] {
        return $false
    }
}

function Remove-DefenseClawNoFollowTree {
    <#
        Removes Path, a file or a folder, never through a link: a link or
        junction (at Path or anywhere below it) is left as found and named
        in Remaining, and so is anything that could not be removed. Each
        folder is held (OpenDirectoryPinNoFollow) while its entries go, so
        it cannot be replaced by a junction meanwhile. Returns whether Path
        is gone. With -RecoverAccess (Remove-DefenseClawNuclearPath, inside a
        root an administrator owns) an entry that cannot be opened or removed gets
        Administrators ownership and its inherited access back
        (Reset-DefenseClawNuclearEntryAccess, that entry only, never
        recursive) and is tried once more.
    #>
    param(
        [Parameter(Mandatory)][string]$Path,
        [Parameter(Mandatory)][AllowEmptyCollection()]
        [Collections.Generic.List[string]]$Remaining,
        [int]$Depth = 0,
        [switch]$RecoverAccess
    )
    try {
        $attributes = [IO.File]::GetAttributes($Path)
    }
    catch [IO.FileNotFoundException], [IO.DirectoryNotFoundException] {
        return $true
    }
    catch {
        $Remaining.Add("${Path}: $($_.Exception.Message)")
        return $false
    }
    if (($attributes -band [IO.FileAttributes]::ReparsePoint) -ne 0) {
        $Remaining.Add("${Path}: a link or junction; left as found")
        return $false
    }
    $attempts = 1
    if ($RecoverAccess) {
        $attempts = 2
    }
    if (($attributes -band [IO.FileAttributes]::Directory) -eq 0) {
        for ($attempt = 1; ; $attempt++) {
            try {
                if (($attributes -band [IO.FileAttributes]::ReadOnly) -ne 0) {
                    [IO.File]::SetAttributes(
                        $Path,
                        [IO.FileAttributes]([int]$attributes -band (-bnot [int][IO.FileAttributes]::ReadOnly))
                    )
                }
                [IO.File]::Delete($Path)
                return $true
            }
            catch {
                if ($attempt -ge $attempts) {
                    $Remaining.Add("${Path}: $($_.Exception.Message)")
                    return $false
                }
                Reset-DefenseClawNuclearEntryAccess -Path $Path
            }
        }
    }
    if ($Depth -ge 32) {
        $Remaining.Add("${Path}: nested too deep; left as found")
        return $false
    }
    $nativeSecurity = Initialize-DefenseClawNativeSecurity
    $complete = $true
    for ($attempt = 1; ; $attempt++) {
        $pin = [IntPtr]::Zero
        $listed = $false
        $retry = $false
        try {
            $pin = $nativeSecurity::OpenDirectoryPinNoFollow($Path)
            $children = @([IO.Directory]::GetFileSystemEntries($Path))
            $listed = $true
            foreach ($child in $children) {
                if (-not (Remove-DefenseClawNoFollowTree `
                        -Path ([string]$child) `
                        -Remaining $Remaining `
                        -Depth ($Depth + 1) `
                        -RecoverAccess:$RecoverAccess)) {
                    $complete = $false
                }
            }
        }
        catch {
            if (-not $listed -and $attempt -lt $attempts) {
                $retry = $true
            }
            else {
                $Remaining.Add("${Path}: $($_.Exception.Message)")
                $complete = $false
            }
        }
        finally {
            $nativeSecurity::CloseDirectoryPin($pin)
        }
        if (-not $retry) {
            break
        }
        # The folder could not be opened or listed: recover its access, then
        # open it again without following.
        Reset-DefenseClawNuclearEntryAccess -Path $Path
    }
    if (-not $complete) {
        return $false
    }
    for ($attempt = 1; ; $attempt++) {
        try {
            # Non-recursive: a junction put here meanwhile goes as the link only.
            [IO.Directory]::Delete($Path, $false)
            return $true
        }
        catch {
            if ($attempt -ge $attempts) {
                $Remaining.Add("${Path}: $($_.Exception.Message)")
                return $false
            }
            Reset-DefenseClawNuclearEntryAccess -Path $Path
        }
    }
}

function Assert-DefenseClawNuclearPathNoLink {
    <#
        Throws unless every component of Path that exists, from the volume
        root down to Path itself, is a real folder or file and not a link or
        junction. Each component is read without following it, so a dangling
        junction is caught as well; a missing component ends the walk, as
        nothing below it can exist.
    #>
    param([Parameter(Mandatory)][string]$Path)
    $full = [IO.Path]::GetFullPath($Path).TrimEnd('\')
    $volume = [IO.Path]::GetPathRoot($full)
    if ([string]::IsNullOrEmpty($volume) -or $full.Length -le $volume.TrimEnd('\').Length) {
        throw "managed path has no folder below its volume root: $full"
    }
    $current = $volume
    foreach ($part in $full.Substring($volume.Length).Split([char]'\')) {
        if ([string]::IsNullOrEmpty($part)) {
            continue
        }
        $current = [IO.Path]::Combine($current, $part)
        try {
            $attributes = [IO.File]::GetAttributes($current)
        }
        catch [IO.FileNotFoundException], [IO.DirectoryNotFoundException] {
            return
        }
        if (($attributes -band [IO.FileAttributes]::ReparsePoint) -ne 0) {
            throw "reparse points are not allowed in managed path: $current"
        }
    }
}

function Test-DefenseClawNuclearTrustedOwner {
    # Whether SYSTEM, Administrators or TrustedInstaller owns Path (checked
    # not to be a link first), as every folder DefenseClaw's installer
    # creates is. A folder a standard user created where DefenseClaw's would
    # be is owned by that user.
    param([Parameter(Mandatory)][string]$Path)
    try {
        $owner = (Microsoft.PowerShell.Security\Get-Acl -LiteralPath $Path).GetOwner(
            [Security.Principal.SecurityIdentifier]
        ).Value
    }
    catch {
        return $false
    }
    return $owner -in @(
        $script:SystemSID,
        $script:AdministratorsSID,
        $script:TrustedInstallerSID
    )
}

function Reset-DefenseClawNuclearEntryAccess {
    <#
        Remove-DefenseClawNuclearPath only: gives one entry Administrators
        ownership and its inherited access list back so a DefenseClaw entry whose access
        list drifted can be removed. Never recursive (no takeown /R, no
        icacls /T) and never on a link: the entry is read again without
        following just before, and icacls /L acts on a link itself.
    #>
    param([Parameter(Mandatory)][string]$Path)
    try {
        $attributes = [IO.File]::GetAttributes($Path)
    }
    catch {
        return
    }
    if (($attributes -band [IO.FileAttributes]::ReparsePoint) -ne 0) {
        return
    }
    Invoke-DefenseClawNuclearSilentExec `
        -File ([IO.Path]::Combine($script:System32, 'takeown.exe')) `
        -Arguments @('/F', $Path, '/A')
    Invoke-DefenseClawNuclearSilentExec `
        -File $script:IcaclsExe `
        -Arguments @($Path, '/reset', '/C', '/L')
}

function Remove-DefenseClawManagedUserRuntimeFolder {
    <#
        Removes DefenseClaw's own managed runtime entries
        (Get-DefenseClawManagedUserRuntimeEntryNames) from one profile's
        .defenseclaw folder, without following a link: the profile and the
        folder are held while their entries go, and a link or junction at
        the folder or below it is left as found. A folder a per-user install
        left (Get-DefenseClawPerUserInstallLeftoverNames) is not changed.
        The folder itself goes only when nothing else stays in it. Returns
        $null when the profile has no such folder, otherwise what was
        removed and what stays (with the reason).
    #>
    param([Parameter(Mandatory)][string]$UserHome)
    $dataDir = [IO.Path]::Combine($UserHome, '.defenseclaw')
    $outcome = [pscustomobject][ordered]@{
        data_dir = $dataDir
        removed = [Collections.Generic.List[string]]::new()
        remaining = [Collections.Generic.List[string]]::new()
        folder_removed = $false
    }
    try {
        $attributes = [IO.File]::GetAttributes($dataDir)
    }
    catch [IO.FileNotFoundException], [IO.DirectoryNotFoundException] {
        return $null
    }
    if (($attributes -band [IO.FileAttributes]::ReparsePoint) -ne 0) {
        $outcome.remaining.Add("${dataDir}: a link or junction; left as found")
        return $outcome
    }
    if (($attributes -band [IO.FileAttributes]::Directory) -eq 0) {
        $outcome.remaining.Add("${dataDir}: not a folder; left as found")
        return $outcome
    }
    $nativeSecurity = Initialize-DefenseClawNativeSecurity
    $homePin = [IntPtr]::Zero
    $dataPin = [IntPtr]::Zero
    try {
        $homePin = $nativeSecurity::OpenDirectoryPinNoFollow($UserHome)
        $dataPin = $nativeSecurity::OpenDirectoryPinNoFollow($dataDir)
        foreach ($leftover in @(Get-DefenseClawPerUserInstallLeftoverNames)) {
            if (Test-DefenseClawPathPresentNoFollow -Path ([IO.Path]::Combine($dataDir, $leftover))) {
                $outcome.remaining.Add(
                    "${dataDir}: kept: it holds $leftover, which a per-user DefenseClaw install leaves; that install's data was not removed"
                )
                return $outcome
            }
        }
        foreach ($name in @(Get-DefenseClawManagedUserRuntimeEntryNames)) {
            $entry = [IO.Path]::Combine($dataDir, $name)
            if (-not (Test-DefenseClawPathPresentNoFollow -Path $entry)) {
                continue
            }
            if (Remove-DefenseClawNoFollowTree -Path $entry -Remaining $outcome.remaining) {
                $outcome.removed.Add($entry)
            }
        }
        $nativeSecurity::CloseDirectoryPin($dataPin)
        $dataPin = [IntPtr]::Zero
        $left = @([IO.Directory]::GetFileSystemEntries($dataDir))
        if ($left.Count -eq 0) {
            # Non-recursive: only an empty folder (or a link put in its
            # place meanwhile, as the link itself) goes.
            [IO.Directory]::Delete($dataDir, $false)
            $outcome.folder_removed = $true
        }
        else {
            $names = @(
                $left |
                    Microsoft.PowerShell.Utility\Select-Object -First 16 |
                    Microsoft.PowerShell.Core\ForEach-Object {
                        [IO.Path]::GetFileName([string]$_)
                    }
            )
            $more = ''
            if ($left.Count -gt $names.Count) {
                $more = " and $($left.Count - $names.Count) more"
            }
            $outcome.remaining.Add(
                "${dataDir}: kept: it still holds $($names -join ', ')$more"
            )
        }
    }
    catch {
        $outcome.remaining.Add("${dataDir}: $($_.Exception.Message)")
    }
    finally {
        $nativeSecurity::CloseDirectoryPin($dataPin)
        $nativeSecurity::CloseDirectoryPin($homePin)
    }
    return $outcome
}

function Get-DefenseClawManagedUserRuntimeHomes {
    # Every local or Entra ID account profile on this computer (enrolled or
    # not: the cleanup removes only DefenseClaw's own entries).
    $profileList = 'HKLM:\SOFTWARE\Microsoft\Windows NT\CurrentVersion\ProfileList'
    foreach ($key in @(Microsoft.PowerShell.Management\Get-ChildItem -LiteralPath $profileList -ErrorAction SilentlyContinue)) {
        $sid = [string]$key.PSChildName
        if ($sid -cnotmatch '^S-1-(5-21|12-1)-[0-9-]+$') {
            continue
        }
        $userHome = [Environment]::ExpandEnvironmentVariables(
            [string](Microsoft.PowerShell.Management\Get-ItemPropertyValue -LiteralPath $key.PSPath -Name ProfileImagePath -ErrorAction SilentlyContinue)
        )
        if ([string]::IsNullOrWhiteSpace($userHome) -or
            -not [IO.Path]::IsPathRooted($userHome)) {
            continue
        }
        $userHome = [IO.Path]::GetFullPath($userHome).TrimEnd('\')
        $account = $sid
        try {
            $account = [Security.Principal.SecurityIdentifier]::new($sid).Translate([Security.Principal.NTAccount]).Value
        }
        catch {
            $account = $sid
        }
        [pscustomobject][ordered]@{
            sid = $sid
            account = $account
            home = $userHome
        }
    }
}

function Remove-DefenseClawManagedUserRuntimeLeftovers {
    <#
        Secure Client uninstall with purge: removes DefenseClaw's own managed
        runtime entries from every account's .defenseclaw folder
        (Remove-DefenseClawManagedUserRuntimeFolder), and the folder when
        nothing else stays. A stale DACL there (for example another
        product's grant) refused the next install of the account. It does
        not fail: what stays is returned ("account (SID): path: reason") for
        the result's warnings, never as a failed uninstall.
    #>
    $removed = [Collections.Generic.List[string]]::new()
    $remaining = [Collections.Generic.List[string]]::new()
    try {
        $accountHomes = @(Get-DefenseClawManagedUserRuntimeHomes)
    }
    catch {
        $remaining.Add("account profiles: $($_.Exception.Message)")
        $accountHomes = @()
    }
    foreach ($accountHome in $accountHomes) {
        $label = "$($accountHome.account) ($($accountHome.sid))"
        try {
            $outcome = Remove-DefenseClawManagedUserRuntimeFolder -UserHome ([string]$accountHome.home)
        }
        catch {
            $remaining.Add("${label}: $($accountHome.home): $($_.Exception.Message)")
            continue
        }
        if ($null -eq $outcome) {
            continue
        }
        foreach ($path in @($outcome.removed)) {
            $removed.Add("${label}: $path")
        }
        if ([bool]$outcome.folder_removed) {
            $removed.Add("${label}: $($outcome.data_dir)")
        }
        foreach ($entry in @($outcome.remaining)) {
            $remaining.Add("${label}: $entry")
        }
    }
    return [pscustomobject][ordered]@{
        removed = [string[]]@($removed.ToArray())
        remaining = [string[]]@($remaining.ToArray())
    }
}

function Test-DefenseClawManagedUserRuntimeCleanupScope {
    # Only a deployment in the real Secure Client roots (production or
    # -Cert) cleans the accounts' folders; a smoke run's temporary roots
    # never touch the profiles of the computer it runs on.
    param([Parameter(Mandatory)][hashtable]$Layout)
    if (Test-DefenseClawStandaloneProfile) {
        return $false
    }
    $pattern = Get-DefenseClawNuclearSafeRootPattern
    foreach ($name in @('InstallRoot', 'StateRoot')) {
        $root = [string]$Layout[$name]
        if ([string]::IsNullOrWhiteSpace($root)) {
            return $false
        }
        try {
            $root = [IO.Path]::GetFullPath($root).TrimEnd('\')
        }
        catch {
            return $false
        }
        if ($root -notmatch $pattern) {
            return $false
        }
    }
    return $true
}

function Add-DefenseClawManagedUserRuntimeCleanupResult {
    # Records the per-user runtime cleanup of a Secure Client purge on a
    # lifecycle result; what stays becomes warnings, never ok:false.
    param([Parameter(Mandatory)]$Result)
    $cleanup = Remove-DefenseClawManagedUserRuntimeLeftovers
    $Result |
        Microsoft.PowerShell.Utility\Add-Member `
            -MemberType NoteProperty `
            -Name user_runtime_removed `
            -Value ([string[]]@($cleanup.removed)) `
            -Force
    $Result |
        Microsoft.PowerShell.Utility\Add-Member `
            -MemberType NoteProperty `
            -Name user_runtime_remaining `
            -Value ([string[]]@($cleanup.remaining)) `
            -Force
    if (@($cleanup.remaining).Count -gt 0) {
        $warnings = [Collections.Generic.List[string]]::new()
        $existing = $Result.PSObject.Properties['warnings']
        if ($null -ne $existing -and $null -ne $existing.Value) {
            foreach ($item in @($existing.Value)) {
                $warnings.Add([string]$item)
            }
        }
        foreach ($entry in @($cleanup.remaining)) {
            $warning = "uninstall left per-user DefenseClaw runtime state: $entry"
            $warnings.Add($warning)
            Microsoft.PowerShell.Utility\Write-Warning -Message $warning
        }
        $Result |
            Microsoft.PowerShell.Utility\Add-Member `
                -MemberType NoteProperty `
                -Name warnings `
                -Value ([string[]]@($warnings.ToArray())) `
                -Force
    }
    return $Result
}

function Test-DefenseClawNuclearPathWithin {
    # Whether Path, canonicalized, is strictly below Root.
    param(
        [AllowEmptyString()][string]$Path,
        [Parameter(Mandatory)][string]$Root
    )
    if ([string]::IsNullOrWhiteSpace($Path)) {
        return $false
    }
    try {
        $full = [IO.Path]::GetFullPath($Path).TrimEnd('\')
        $rootFull = [IO.Path]::GetFullPath($Root).TrimEnd('\')
    }
    catch {
        return $false
    }
    return $full.StartsWith($rootFull + '\', [StringComparison]::OrdinalIgnoreCase)
}

function Get-DefenseClawNuclearSHA256 {
    param([Parameter(Mandatory)][AllowEmptyCollection()][byte[]]$Bytes)
    $algorithm = [Security.Cryptography.SHA256]::Create()
    try {
        return ([BitConverter]::ToString($algorithm.ComputeHash($Bytes))).Replace('-', '').ToLowerInvariant()
    }
    finally {
        $algorithm.Dispose()
    }
}

function Read-DefenseClawNuclearFileBytes {
    # The bytes of a regular file read without following a link at it or
    # above it; $null when it is absent. Larger than MaximumBytes throws.
    param(
        [Parameter(Mandatory)][string]$Path,
        [Parameter(Mandatory)][int64]$MaximumBytes
    )
    Assert-DefenseClawNuclearPathNoLink -Path $Path
    try {
        $attributes = [IO.File]::GetAttributes($Path)
    }
    catch [IO.FileNotFoundException], [IO.DirectoryNotFoundException] {
        return $null
    }
    if (($attributes -band [IO.FileAttributes]::Directory) -ne 0) {
        throw "$Path is not a regular file"
    }
    $stream = [IO.File]::Open(
        $Path,
        [IO.FileMode]::Open,
        [IO.FileAccess]::Read,
        [IO.FileShare]::Read
    )
    try {
        if ($stream.Length -gt $MaximumBytes) {
            throw "$Path exceeds $MaximumBytes bytes"
        }
        $bytes = [byte[]]::new([int]$stream.Length)
        $offset = 0
        while ($offset -lt $bytes.Length) {
            $read = $stream.Read($bytes, $offset, $bytes.Length - $offset)
            if ($read -le 0) {
                throw "$Path changed while it was read"
            }
            $offset += $read
        }
        return ,$bytes
    }
    finally {
        $stream.Dispose()
    }
}

function Assert-DefenseClawNuclearRecordTrusted {
    # A DefenseClaw ownership record decides what the purge removes only when
    # no one but SYSTEM, Administrators or TrustedInstaller owns or can write
    # it, so a record a standard user planted never does.
    param([Parameter(Mandatory)][string]$Path)
    $null = Assert-DefenseClawPathAcl `
        -Path $Path `
        -AllowedWriterSIDs @(
            $script:SystemSID,
            $script:AdministratorsSID,
            $script:TrustedInstallerSID
        ) `
        -AllowUsersRead `
        -AllowInheritance
}

function Read-DefenseClawNuclearRecord {
    <#
        Reads a DefenseClaw ownership record (JSON) the forced uninstall
        decides by: $null when it is absent, otherwise its bytes and parsed
        value. It throws for a link, a folder, a record over MaximumBytes,
        one a standard user could have written
        (Assert-DefenseClawNuclearRecordTrusted) and one that is not JSON.
    #>
    param(
        [Parameter(Mandatory)][string]$Path,
        [int64]$MaximumBytes = 8388608
    )
    $bytes = Read-DefenseClawNuclearFileBytes -Path $Path -MaximumBytes $MaximumBytes
    if ($null -eq $bytes) {
        return $null
    }
    $null = Assert-DefenseClawNuclearRecordTrusted -Path $Path
    $value = [Text.UTF8Encoding]::new($false, $true).GetString($bytes) |
        Microsoft.PowerShell.Utility\ConvertFrom-Json
    if ($value -isnot [pscustomobject]) {
        throw "$Path is not a JSON object"
    }
    return [pscustomobject]@{ Bytes = $bytes; Value = $value }
}

function Get-DefenseClawNuclearRecordField {
    # A record field, or $null when the record does not carry it.
    param(
        [Parameter(Mandatory)]$Record,
        [Parameter(Mandatory)][string]$Name
    )
    $property = $Record.PSObject.Properties[$Name]
    if ($null -eq $property) {
        return $null
    }
    return $property.Value
}

function Write-DefenseClawNuclearFileContent {
    # Replaces a regular file's content with Bytes: written beside it and
    # swapped in with File.Replace, which keeps the file's access list. The
    # caller has checked the file and its folders are not links.
    param(
        [Parameter(Mandatory)][string]$Path,
        [Parameter(Mandatory)][AllowEmptyCollection()][byte[]]$Bytes
    )
    $temporary = [IO.Path]::Combine(
        [IO.Path]::GetDirectoryName($Path),
        '.defenseclaw-purge-' + [Guid]::NewGuid().ToString('N') + '.tmp'
    )
    $stream = [IO.File]::Open(
        $temporary,
        [IO.FileMode]::CreateNew,
        [IO.FileAccess]::Write,
        [IO.FileShare]::None
    )
    try {
        $stream.Write($Bytes, 0, $Bytes.Length)
        $stream.Flush($true)
    }
    finally {
        $stream.Dispose()
    }
    try {
        [void][IO.File]::Replace($temporary, $Path, [NullString]::Value)
    }
    catch {
        [IO.File]::Delete($temporary)
        throw
    }
}

function Get-DefenseClawNuclearConnectorOwner {
    <#
        Who owns one agent's DefenseClaw machine policy, from its protected
        ownership state (.defenseclaw-managed-hooks.state): 'owned' when the
        hook executable it records runs from this purge's InstallRoot,
        'foreign' when it runs from anywhere else (the standalone profile or
        another scope wrote it), 'none' when there is no state, and
        'unknown' when the state cannot be trusted or read.
    #>
    param(
        [Parameter(Mandatory)][string]$StatePath,
        [Parameter(Mandatory)][string]$InstallRoot
    )
    try {
        $record = Read-DefenseClawNuclearRecord -Path $StatePath
    }
    catch {
        return [pscustomobject]@{ Owner = 'unknown'; State = $null; Detail = $_.Exception.Message }
    }
    if ($null -eq $record) {
        return [pscustomobject]@{ Owner = 'none'; State = $null; Detail = '' }
    }
    $hook = [string](Get-DefenseClawNuclearRecordField -Record $record.Value -Name 'hook_executable')
    if (Test-DefenseClawNuclearPathWithin -Path $hook -Root $InstallRoot) {
        return [pscustomobject]@{ Owner = 'owned'; State = $record.Value; Detail = $hook }
    }
    return [pscustomobject]@{ Owner = 'foreign'; State = $record.Value; Detail = $hook }
}

function Invoke-DefenseClawNuclearCodexRequirements {
    <#
        Codex requirements.toml on a standalone forced uninstall
        (Restore-DefenseClawForcedUninstallCodexPolicy). It is the
        administrator's Codex machine policy, so it changes only as
        DefenseClaw's protected ownership record
        (<StateRoot>\install\codex-requirements-ownership.json) allows, and
        only while the file is still byte for byte what DefenseClaw wrote
        (postimage_sha256) for a hook in this InstallRoot: the
        administrator's preimage is put back, or a file DefenseClaw created
        is removed. Without such a record, or after anyone changed the file,
        it stays as found with a warning. Returns 'absent', 'removed',
        'restored' or 'kept'.
    #>
    param(
        [Parameter(Mandatory)][hashtable]$Layout,
        [Parameter(Mandatory)][AllowEmptyCollection()]
        [Collections.Generic.List[string]]$Warnings
    )
    $path = [IO.Path]::Combine($script:ProgramData, 'OpenAI', 'Codex', 'requirements.toml')
    $ownershipPath = [IO.Path]::Combine([string]$Layout.StateRoot, 'install', 'codex-requirements-ownership.json')
    $keep = "forced uninstall left the Codex machine policy $path as found"
    try {
        $current = Read-DefenseClawNuclearFileBytes -Path $path -MaximumBytes 4194304
        if ($null -eq $current) {
            return 'absent'
        }
        $record = Read-DefenseClawNuclearRecord -Path $ownershipPath -MaximumBytes 8388608
        if ($null -eq $record) {
            $Warnings.Add("${keep}: no DefenseClaw ownership record ($ownershipPath) shows this deployment wrote it; remove DefenseClaw's hooks from it by hand if any remain")
            return 'kept'
        }
        $ownership = $record.Value
        $recordedPath = [string](Get-DefenseClawNuclearRecordField -Record $ownership -Name 'requirements_path')
        $hookBinary = [string](Get-DefenseClawNuclearRecordField -Record $ownership -Name 'hook_binary')
        $postimage = [string](Get-DefenseClawNuclearRecordField -Record $ownership -Name 'postimage_sha256')
        if ([string]::IsNullOrWhiteSpace($recordedPath) -or
            -not [string]::Equals(
                [IO.Path]::GetFullPath($recordedPath).TrimEnd('\'),
                [IO.Path]::GetFullPath($path).TrimEnd('\'),
                [StringComparison]::OrdinalIgnoreCase) -or
            -not (Test-DefenseClawNuclearPathWithin -Path $hookBinary -Root ([string]$Layout.InstallRoot)) -or
            [bool](Get-DefenseClawNuclearRecordField -Record $ownership -Name 'pending') -or
            $postimage -cnotmatch '^[0-9a-f]{64}$') {
            $Warnings.Add("${keep}: its DefenseClaw ownership record ($ownershipPath) is not complete for this deployment")
            return 'kept'
        }
        if ((Get-DefenseClawNuclearSHA256 -Bytes $current) -cne $postimage) {
            $Warnings.Add("${keep}: it changed after DefenseClaw wrote it; remove DefenseClaw's hooks from it by hand")
            return 'kept'
        }
        if (-not [bool](Get-DefenseClawNuclearRecordField -Record $ownership -Name 'preimage_existed')) {
            $remaining = [Collections.Generic.List[string]]::new()
            if (Remove-DefenseClawNuclearPath -Path $path -Remaining $remaining) {
                return 'removed'
            }
            foreach ($entry in $remaining) {
                $Warnings.Add("${keep}: $entry")
            }
            return 'kept'
        }
        $encoded = [string](Get-DefenseClawNuclearRecordField -Record $ownership -Name 'preimage')
        $preimage = [byte[]]@()
        if (-not [string]::IsNullOrEmpty($encoded)) {
            $preimage = [Convert]::FromBase64String($encoded)
        }
        if ((Get-DefenseClawNuclearSHA256 -Bytes $preimage) -cne
            [string](Get-DefenseClawNuclearRecordField -Record $ownership -Name 'preimage_sha256')) {
            $Warnings.Add("${keep}: the administrator's original in its DefenseClaw ownership record does not match its recorded digest")
            return 'kept'
        }
        Write-DefenseClawNuclearFileContent -Path $path -Bytes $preimage
        return 'restored'
    }
    catch {
        $Warnings.Add("${keep}: $($_.Exception.Message)")
        return 'kept'
    }
}

function Invoke-DefenseClawNuclearUninstall {
    # Managed-mode bulldoze: uninstall --purge is a hammer. We don't care
    # what the previous state was; the point is a clean slate for the
    # next install. Skip metadata parsing, ACL validation, identity
    # authentication, and every "refuse-on-drift" gate.
    #
    # Safety invariants (STILL ENFORCED):
    #   1. All deletes are confined to %ProgramFiles%\Cisco\Cisco Secure
    #      Client\DefenseClaw* and %ProgramData%\Cisco\Cisco Secure
    #      Client\DefenseClaw*. No path outside those bases can be
    #      affected, regardless of what the caller passes in.
    #   2. Services deleted are only those named with the current scope's
    #      Gateway/Guardian service names (incl. derived Broker +
    #      Enumerator variants).
    #
    # Operators who need the legacy refuse-on-drift uninstall posture
    # restore it with DEFENSECLAW_MANAGED_TRUST_STRICT_ANCESTORS=1.
    param(
        [Parameter(Mandatory)][hashtable]$Layout,
        [Parameter(Mandatory)][string]$GatewayServiceName,
        [Parameter(Mandatory)][string]$GuardianServiceName,
        # Set only by Install recovery, which purges while it holds the shared
        # lifecycle lock; a direct purge does not take the lock.
        [switch]$LifecycleLockHeld
    )
    $warnings = [Collections.Generic.List[string]]::new()
    # Everything the purge could not remove, and whether a restart finishes
    # it. ok is true only when nothing is left.
    $incomplete = [Collections.Generic.List[string]]::new()
    $rebootRequired = $false
    $pendingRenamesBefore = Test-DefenseClawPendingFileRenameOperations
    $enumeratorName = Get-DefenseClawEnumeratorServiceName `
        -GuardianServiceName $GuardianServiceName
    $brokerName = Get-DefenseClawCMIDBrokerServiceName `
        -GatewayServiceName $GatewayServiceName
    # Every path the purge deletes must match this safe-root scope guard.
    # The bases come from the Secure Client profile roots (the machine's real
    # Program Files and ProgramData, never a literal C:\), never from the
    # caller's Layout, so a caller cannot subvert the hammer by passing an
    # attacker-chosen Layout.
    $safeRootPattern = Get-DefenseClawNuclearSafeRootPattern -AllowRetired
    # 0. List every enrolled user's data folder first, while the target
    #    manifest is still in place and before any teardown step runs.
    $userDataPaths = @()
    if (-not [string]::IsNullOrWhiteSpace([string]$Layout.StateRoot) -and
        [string]$Layout.StateRoot -match $safeRootPattern) {
        $userDataPaths = @(Get-DefenseClawNuclearUserDataPaths -StateRoot ([string]$Layout.StateRoot))
    }

    # 1. Tear down every managed service in dependency-safe order
    #    (Gateway -> Guardian -> Enumerator -> Broker). Design principles:
    #
    #    A. Disarm SCM auto-restart via ChangeServiceConfig2A, THEN raw
    #       registry removal as persistence belt-and-braces. Install
    #       stamps FailureActions (5s/15s/60s restart schedule) +
    #       FailureActionsOnNonCrashFailures=1 via
    #       Set-DefenseClawExactFailureActions, and SCM caches those
    #       values in memory at service register time. A raw registry
    #       Remove-ItemProperty updates the on-disk value but does NOT
    #       invalidate SCM's in-memory cache - the next service exit
    #       still fires the cached 5s/15s/60s schedule, respawning the
    #       worker ~5s later. `sc.exe failure` and `sc.exe failureflag`
    #       both call ChangeServiceConfig2A, which updates SCM's in-
    #       memory cache AND the registry atomically. '//' is the
    #       documented empty-actions sentinel. Keep Remove-ItemProperty
    #       after the sc.exe calls so the registry stays explicitly
    #       empty across reboots even if ChangeServiceConfig2A ever
    #       changes behaviour.
    #
    #    B. Graceful stop with wait, in dependency-safe order. Stop
    #       Gateway first (nothing depends on it); work toward Broker
    #       last (Gateway depends on it, so Broker's stop would be
    #       refused with ERROR_DEPENDENT_SERVICES_RUNNING if Gateway
    #       were still Running). The old flow used `sc stop` async
    #       without waiting, which raced Broker's stop against
    #       Gateway's STOP_PENDING transition - sc.exe swallowed the
    #       dependency refusal, the broker worker stayed running,
    #       taskkill then racked up a crash exit, SCM's cached
    #       FailureActions fired, broker respawned.
    #
    #    C. Taskkill is a FALLBACK, not the primary path. Services
    #       that stop cleanly through SCM exit code 0 - no failure
    #       action fires regardless of what the registry says. Only
    #       services whose stop handler wedges past the timeout need
    #       a kill. At that point SCM is already disarmed from step A,
    #       so a late kill is harmless.
    #
    #    D. sc delete after every worker is gone. Deletes a running
    #       service row is accepted by SCM but marks PENDING_DELETE
    #       and defers to reboot; deleting a stopped service is
    #       immediate.
    #
    #    All native-exe invocations route through
    #    Invoke-DefenseClawNuclearSilentExec so no console window
    #    flashes under the outer Setup EXE's PowerShell host.
    # The sensor helper is a fourth worker service on this branch; it runs
    # from InstallRoot\bin, so it must go before the tree removal too.
    $sensorHelperName = Get-DefenseClawSensorHelperServiceName `
        -GatewayServiceName $GatewayServiceName
    $teardownOrder = @(
        $GatewayServiceName,
        $GuardianServiceName,
        $enumeratorName,
        $sensorHelperName,
        $brokerName
    ) | Microsoft.PowerShell.Core\Where-Object {
        -not [string]::IsNullOrWhiteSpace($_)
    }

    # 1a. Disarm SCM FIRST (ChangeServiceConfig2A + registry).
    foreach ($name in $teardownOrder) {
        Invoke-DefenseClawNuclearSilentExec `
            -File $script:ScExe `
            -Arguments @('failure', $name, 'reset=', '0', 'actions=', '//')
        Invoke-DefenseClawNuclearSilentExec `
            -File $script:ScExe `
            -Arguments @('failureflag', $name, '0')
        $serviceKey = "HKLM:\SYSTEM\CurrentControlSet\Services\$name"
        if (Microsoft.PowerShell.Management\Test-Path -LiteralPath $serviceKey) {
            Microsoft.PowerShell.Management\Remove-ItemProperty `
                -LiteralPath $serviceKey `
                -Name FailureActions `
                -ErrorAction SilentlyContinue
            Microsoft.PowerShell.Management\Remove-ItemProperty `
                -LiteralPath $serviceKey `
                -Name FailureActionsOnNonCrashFailures `
                -ErrorAction SilentlyContinue
        }
        Invoke-DefenseClawNuclearSilentExec `
            -File $script:ScExe `
            -Arguments @('config', $name, 'start=', 'disabled')
    }

    # 1b. Graceful stop + wait, in dependency-safe reverse order.
    #     Each service waits up to 15 s to reach Stopped. The sensor
    #     helper and Broker are last because Gateway depends on them; by
    #     the time we stop them, Gateway has already drained.
    $stopTimeout = [TimeSpan]::FromSeconds(15)
    $workerSurvivors = [Collections.Generic.List[string]]::new()
    foreach ($name in $teardownOrder) {
        $service = $null
        try {
            $service = Microsoft.PowerShell.Management\Get-Service `
                -Name $name -ErrorAction Stop
        }
        catch {
            # Gone, or a descriptor that denies Administrators query. Only
            # the latter still needs the stop and the worker fallback.
            if ((Get-DefenseClawNuclearServicePresence -Name $name) -ne 'absent') {
                [void](Invoke-DefenseClawNuclearSilentExec `
                    -File $script:ScExe `
                    -Arguments @('stop', $name) `
                    -TimeoutSeconds 30)
                $workerSurvivors.Add($name)
            }
            continue
        }
        if ($service.Status -eq [ServiceProcess.ServiceControllerStatus]::Stopped) {
            continue
        }
        Invoke-DefenseClawNuclearSilentExec `
            -File $script:ScExe `
            -Arguments @('stop', $name)
        try {
            $service.WaitForStatus(
                [ServiceProcess.ServiceControllerStatus]::Stopped,
                $stopTimeout
            )
        }
        catch {
            # WaitForStatus throws System.ServiceProcess.TimeoutException if
            # the service didn't reach Stopped within the window. Fall
            # through to the taskkill fallback below - the service row
            # is tracked here but will be deleted in step 1d regardless.
            $workerSurvivors.Add($name)
        }
    }

    # 1c. Fallback: terminate this scope's exact worker images (image
    #     path under this InstallRoot) whether or not a service stop
    #     reported success: a worker that outlives its service (a stop
    #     that timed out, or a stray started outside SCM) keeps the
    #     install tree locked. SCM is disarmed from step 1a so this does
    #     NOT trigger a failure-action respawn. Another scope's workers,
    #     matched by name only, are never touched.
    #
    #     DO NOT kill defenseclaw.exe or defenseclaw-hook.exe:
    #     defenseclaw.exe is the Setup EXE trailer-extracted bootstrap
    #     binary that spawns the PowerShell host running THIS code;
    #     killing its tree would take our own PowerShell with it,
    #     aborting the uninstall with Windows exit 1603 and a WER crash
    #     dialog.
    $workerWait = 5
    if ($workerSurvivors.Count -gt 0) {
        $workerWait = 10
    }
    [void](Stop-DefenseClawScopeWorkerProcesses `
        -InstallRoot ([string]$Layout.InstallRoot) `
        -WaitSeconds $workerWait `
        -IncludeSensorHelper)

    # 1d. Delete the service rows. Each service is Stopped by now (or
    #     the row itself is already gone and sc.exe delete silently
    #     no-ops); no PENDING_DELETE flag survives to reboot.
    foreach ($name in $teardownOrder) {
        $delete = Invoke-DefenseClawNuclearSilentExec `
            -File $script:ScExe `
            -Arguments @('delete', $name) `
            -TimeoutSeconds 60 `
            -PassThru
        if ([int]$delete.exit_code -eq 1072) {
            # Another process still holds a handle; SCM removes the row when
            # it closes, at the latest on restart.
            $rebootRequired = $true
        }
        elseif ([int]$delete.exit_code -eq 5) {
            # A descriptor that denies Administrators DELETE. Removing the
            # service key takes effect when SCM next loads its database.
            $serviceKey = "HKLM:\SYSTEM\CurrentControlSet\Services\$name"
            try {
                Microsoft.PowerShell.Management\Remove-Item `
                    -LiteralPath $serviceKey `
                    -Recurse `
                    -Force `
                    -ErrorAction Stop
                $rebootRequired = $true
                Write-DefenseClawResilienceEvent -Marker defenseclaw_recover -Fields @{
                    service = $name
                    reason  = 'service descriptor denied delete; removed its registry key for the next restart'
                }
            }
            catch {
                $incomplete.Add("service $name could not be deleted: $($_.Exception.Message)")
            }
        }
    }

    # 1c. Short settle delay so NT closes the released handles before the
    #     Remove-Item -Recurse starts walking the trees. 500 ms is enough
    #     in practice; Remove-Item still retries up to 3 times below.
    Microsoft.PowerShell.Utility\Start-Sleep -Milliseconds 500

    # 2. Remove InstallRoot, StateRoot, their retired siblings, every enrolled
    #    user's setup staging folders and this scope's lifecycle receipts.
    #    Each path must pass the safe-root scope guard above before anything
    #    is deleted. The -Lifecycle sibling is a separate tree outside
    #    StateRoot (install-rollback journal, purge intent, self-uninstall
    #    receipt, managed-hook cleanup receipt). It is shared with the other
    #    scopes and holds the persistent lifecycle lock, so only this scope's
    #    receipts, intents and helper files are removed from it. It is not
    #    read from $Layout because the sole nuclear caller passes a reduced
    #    hashtable with only InstallRoot and StateRoot keys. The enrolled
    #    users' data folders were listed in step 0, before anything of the
    #    deployment was touched.
    $nuclearLifecycleDir = [string](
        Get-DefenseClawProfileRoots -EnterpriseProfile SecureClient
    ).LifecycleDirectory
    $treeEntries = [Collections.Generic.List[hashtable]]::new()
    foreach ($rootEntry in @(
        @{ Role = 'InstallRoot'; Path = [string]$Layout.InstallRoot },
        @{ Role = 'StateRoot';   Path = [string]$Layout.StateRoot }
    )) {
        if ([string]::IsNullOrWhiteSpace($rootEntry.Path)) { continue }
        $treeEntries.Add($rootEntry)
        $parent = [IO.Path]::GetDirectoryName($rootEntry.Path)
        $leaf = [IO.Path]::GetFileName($rootEntry.Path)
        if ([string]::IsNullOrWhiteSpace($parent) -or
            -not (Microsoft.PowerShell.Management\Test-Path -LiteralPath $parent -PathType Container)) {
            continue
        }
        foreach ($retired in @(Microsoft.PowerShell.Management\Get-ChildItem `
                -LiteralPath $parent `
                -Force `
                -Directory `
                -Filter "$leaf.retired-*" `
                -ErrorAction SilentlyContinue)) {
            if ([string]$retired.Name -cmatch ('^' + [regex]::Escape($leaf) + '\.retired-[0-9a-f]{32}$')) {
                $treeEntries.Add(@{ Role = "retired $($rootEntry.Role)"; Path = [string]$retired.FullName })
            }
        }
    }
    if ((Microsoft.PowerShell.Management\Test-Path -LiteralPath $nuclearLifecycleDir -PathType Container) -and
        $nuclearLifecycleDir -match $safeRootPattern -and
        -not [string]::IsNullOrWhiteSpace([string]$Layout.InstallRoot) -and
        -not [string]::IsNullOrWhiteSpace([string]$Layout.StateRoot)) {
        $purgeScope = Get-DefenseClawStableScopeSHA256 -Values @(
            [IO.Path]::GetFullPath([string]$Layout.InstallRoot).TrimEnd('\'),
            [IO.Path]::GetFullPath([string]$Layout.StateRoot).TrimEnd('\'),
            $GatewayServiceName,
            $GuardianServiceName
        )
        # A listing that fails must not look like "no receipts": this
        # scope's receipts may still be there, so the purge is incomplete.
        $lifecycleEntries = @()
        try {
            $lifecycleEntries = @(Microsoft.PowerShell.Management\Get-ChildItem `
                    -LiteralPath $nuclearLifecycleDir `
                    -Force `
                    -ErrorAction Stop)
        }
        catch {
            $incomplete.Add(
                "LifecycleDir $nuclearLifecycleDir could not be listed for this scope's receipts: $($_.Exception.Message)"
            )
        }
        foreach ($scoped in $lifecycleEntries) {
            if ([string]$scoped.Name -like "*-$purgeScope.*") {
                $treeEntries.Add(@{ Role = 'lifecycle receipt'; Path = [string]$scoped.FullName })
            }
        }
    }
    foreach ($pathEntry in $treeEntries) {
        $path = [string]$pathEntry.Path
        $role = [string]$pathEntry.Role
        if ($path -notmatch $safeRootPattern) {
            $warnings.Add(
                "nuclear uninstall refused $role outside safe-root scope: $path"
            )
            continue
        }
        # Only the roots themselves may be moved aside: their retired
        # sibling grammar is what the safe-root pattern and the next purge
        # recognise.
        $retirePattern = ''
        if ($role -cin @('InstallRoot', 'StateRoot')) {
            $retirePattern = $safeRootPattern
        }
        $leftover = Remove-DefenseClawNuclearPath `
            -Path $path `
            -Role $role `
            -RebootRequired ([ref]$rebootRequired) `
            -AcceptScheduledDelete `
            -RetireSiblingPattern $retirePattern
        if (-not [string]::IsNullOrEmpty($leftover)) {
            $incomplete.Add($leftover)
        }
    }
    # The shared lifecycle folder goes too once nothing of another scope is
    # left in it: only this scope's receipts were removed above, and an
    # empty folder (or one holding just the shared lock file) belongs to
    # no deployment.
    if ((Microsoft.PowerShell.Management\Test-Path -LiteralPath $nuclearLifecycleDir -PathType Container) -and
        $nuclearLifecycleDir -match $safeRootPattern) {
        # A listing that fails must not look empty: the folder could still
        # hold another scope's receipt.
        $remaining = $null
        try {
            $remaining = @(Microsoft.PowerShell.Management\Get-ChildItem `
                    -LiteralPath $nuclearLifecycleDir `
                    -Force `
                    -ErrorAction Stop |
                Microsoft.PowerShell.Core\Where-Object { [string]$_.Name -cne 'lifecycle.lock' })
        }
        catch {
            $warnings.Add(
                "nuclear uninstall could not enumerate lifecycle directory: $($_.Exception.Message)"
            )
        }
        if ($null -ne $remaining -and $remaining.Count -eq 0) {
            $leftover = Remove-DefenseClawNuclearPath `
                -Path $nuclearLifecycleDir `
                -Role 'LifecycleDir' `
                -RebootRequired ([ref]$rebootRequired) `
                -AcceptScheduledDelete
            if (-not [string]::IsNullOrEmpty($leftover)) {
                if ($LifecycleLockHeld) {
                    # This process holds the shared lock, so the folder is in
                    # use by this very recovery; it holds no state.
                    $warnings.Add($leftover)
                }
                else {
                    # Another lifecycle action may own the lock: the purge
                    # is not finished.
                    $incomplete.Add($leftover)
                }
            }
        }
    }
    # A user's .defenseclaw holds only that user's hook state and logs; no
    # service, ACL or policy depends on it once StateRoot is gone, and the
    # next Install re-creates it. One that cannot be removed is logged and the
    # purge still succeeds.
    foreach ($userData in $userDataPaths) {
        # An enrolled user's .defenseclaw itself is left to step 4, which
        # removes DefenseClaw's own managed entries without following a link
        # and never touches a per-user install's folder; its setup staging
        # folders go here.
        if ([string]::Equals(
                [IO.Path]::GetFileName([string]$userData),
                '.defenseclaw',
                [StringComparison]::OrdinalIgnoreCase)) {
            continue
        }
        $leftover = Remove-DefenseClawNuclearPath `
            -Path ([string]$userData) `
            -Role 'user data folder' `
            -RebootRequired ([ref]$rebootRequired) `
            -AcceptScheduledDelete
        if (-not [string]::IsNullOrEmpty($leftover)) {
            Write-DefenseClawResilienceEvent -Marker defenseclaw_degraded -Fields @{
                subsystem = 'purge'
                path      = [string]$userData
                reason    = "user data folder survived the purge; continuing: $(ConvertTo-DefenseClawBoundedDiagnostic -Value $leftover)"
            }
        }
    }

    # 3a. Delete DefenseClaw-owned sidecar files inside each agent config
    #     directory, whatever their ACL. These sidecars are our own
    #     per-connector state/lock/receipt files - no other owner.
    #     The hooks' runtime selector (state and lock) goes too: once
    #     StateRoot and its Guardian activation are gone, a selector left
    #     behind made the next install refuse ("legacy deployment has no
    #     Guardian activation but <connector> runtime selector is
    #     present") and a different build's Guardian report contract drift.
    $claudeManaged = [IO.Path]::Combine($script:ProgramFiles, 'ClaudeCode', 'managed-settings.d')
    $codexManaged = [IO.Path]::Combine($script:ProgramData, 'OpenAI', 'Codex')
    $cursorManaged = [IO.Path]::Combine($script:ProgramData, 'Cursor')
    $copilotManaged = [IO.Path]::Combine($script:ProgramData, 'GitHub', 'Copilot')
    $sidecars = @(
        # Legacy production IPC dir (orphan NT SERVICE SIDs land here).
        [string](Get-DefenseClawProfileRoots -EnterpriseProfile SecureClient).ManagedIPCDirectory,
        # Claude Code managed hooks sidecars.
        [IO.Path]::Combine($claudeManaged, '90-defenseclaw.json'),
        [IO.Path]::Combine($claudeManaged, '.defenseclaw-managed-hooks.state'),
        [IO.Path]::Combine($claudeManaged, '.defenseclaw-managed-hooks.lock'),
        [IO.Path]::Combine($claudeManaged, '.defenseclaw-managed-runtime-selector.state'),
        [IO.Path]::Combine($claudeManaged, '.defenseclaw-managed-runtime-selector.lock'),
        # Codex managed hooks sidecars.
        [IO.Path]::Combine($codexManaged, '.defenseclaw-managed-hooks.state'),
        [IO.Path]::Combine($codexManaged, '.defenseclaw-managed-hooks.lock'),
        [IO.Path]::Combine($codexManaged, '.defenseclaw-managed-hooks.receipt'),
        [IO.Path]::Combine($codexManaged, '.defenseclaw-managed-runtime-selector.state'),
        [IO.Path]::Combine($codexManaged, '.defenseclaw-managed-runtime-selector.lock'),
        # Cursor managed hooks sidecars + the adapter stub we drop.
        [IO.Path]::Combine($cursorManaged, 'defenseclaw-hook.ps1'),
        [IO.Path]::Combine($cursorManaged, '.defenseclaw-managed-hooks.state'),
        [IO.Path]::Combine($cursorManaged, '.defenseclaw-managed-hooks.lock'),
        [IO.Path]::Combine($cursorManaged, '.defenseclaw-managed-hooks.receipt'),
        [IO.Path]::Combine($cursorManaged, '.defenseclaw-managed-runtime-selector.state'),
        [IO.Path]::Combine($cursorManaged, '.defenseclaw-managed-runtime-selector.lock'),
        # GitHub Copilot (the CLI and the GitHub Copilot app): DefenseClaw's
        # policy.d drop-in and DefenseClaw's own enrollment and runtime
        # selector folder beside it.
        [IO.Path]::Combine($copilotManaged, 'policy.d', '90-defenseclaw.json'),
        [IO.Path]::Combine($copilotManaged, 'DefenseClaw')
    )
    foreach ($fixedPath in $sidecars) {
        $leftover = Remove-DefenseClawNuclearPath `
            -Path $fixedPath `
            -Role 'agent sidecar' `
            -RebootRequired ([ref]$rebootRequired) `
            -AcceptScheduledDelete
        if (-not [string]::IsNullOrEmpty($leftover)) {
            $incomplete.Add($leftover)
        }
    }

    # The Copilot policy folders hold nothing once DefenseClaw's files are
    # gone, unless an administrator added policy of their own; only empty
    # ones are removed.
    foreach ($copilotFolder in @(
        [IO.Path]::Combine($copilotManaged, 'policy.d'),
        $copilotManaged,
        [IO.Path]::GetDirectoryName($copilotManaged)
    )) {
        if ((Microsoft.PowerShell.Management\Test-Path -LiteralPath $copilotFolder -PathType Container) -and
            $null -eq (Microsoft.PowerShell.Management\Get-ChildItem -LiteralPath $copilotFolder -Force -ErrorAction SilentlyContinue |
                Microsoft.PowerShell.Utility\Select-Object -First 1)) {
            Microsoft.PowerShell.Management\Remove-Item -LiteralPath $copilotFolder -Force -ErrorAction SilentlyContinue
        }
    }

    # 3b. Agent-config files that are SHARED with the host agent (Codex
    #     requirements.toml, Cursor hooks.json). In managed_enterprise
    #     mode these are DefenseClaw-owned - allow_managed_hooks_only
    #     is set and the install stamped all current content. A content
    #     check gating deletion on a plaintext regex missed Cursor's
    #     EncodedCommand hook entries, and the uncleaned hooks.json then
    #     tripped install's ownership-metadata check. Nuclear ("clean
    #     slate") - just delete, same scope invariant as step 3a.
    foreach ($agentConfigPath in @(
        [IO.Path]::Combine($codexManaged, 'requirements.toml'),
        [IO.Path]::Combine($cursorManaged, 'hooks.json')
    )) {
        $leftover = Remove-DefenseClawNuclearPath `
            -Path $agentConfigPath `
            -Role 'agent config' `
            -RebootRequired ([ref]$rebootRequired) `
            -AcceptScheduledDelete
        if (-not [string]::IsNullOrEmpty($leftover)) {
            $incomplete.Add($leftover)
        }
    }

    # 4. DefenseClaw's own per-user runtime entries in every account's
    #    .defenseclaw (hooks, the hook contract lock and its lock file, the
    #    inventory database), never through a link and never a per-user
    #    install's folder; the folder goes only when it ends up empty. The
    #    hammer above never reached the profiles, so a stale folder (with,
    #    for example, the read grant Codex's sandbox adds) refused the next
    #    install. What stays is a warning, not a failed uninstall.
    $userRuntime = [pscustomobject]@{ removed = [string[]]@(); remaining = [string[]]@() }
    try {
        $userRuntime = Remove-DefenseClawManagedUserRuntimeLeftovers
    }
    catch {
        $userRuntime.remaining = [string[]]@("per-user runtime cleanup: $($_.Exception.Message)")
    }
    foreach ($entry in @($userRuntime.remaining)) {
        $warnings.Add("nuclear uninstall left per-user DefenseClaw runtime state: $entry")
    }

    # Probe actual SCM + process state so the return reflects reality
    # instead of the previously hard-coded "absent"/false. If sc.exe
    # delete silently failed (prior bug: ArgumentList-only helper on
    # Windows PowerShell 5.1 no-op'd the entire native-exec stack), the
    # service row survives and we need to surface that so the caller
    # does not conclude success. Same for lingering worker processes
    # holding file handles.
    $serviceStateProbe = {
        param($name)
        if ([string]::IsNullOrWhiteSpace($name)) { return 'absent' }
        try {
            $svc = Microsoft.PowerShell.Management\Get-Service `
                -Name $name -ErrorAction Stop
            if (Test-DefenseClawServiceMarkedForDelete -Name $name) {
                # sc delete succeeded but a handle (services.msc, an EDR
                # agent, a test) still holds the row; SCM removes it when
                # that handle closes, at the latest at the next restart.
                return 'marked_for_delete'
            }
            return $svc.Status.ToString().ToLowerInvariant()
        }
        catch {
            # Access denied on query is "present, unreadable", not gone.
            return (Get-DefenseClawNuclearServicePresence -Name $name)
        }
    }
    $gatewayState    = & $serviceStateProbe $GatewayServiceName
    $brokerState     = & $serviceStateProbe $brokerName
    $guardianState   = & $serviceStateProbe $GuardianServiceName
    $enumeratorState = & $serviceStateProbe $enumeratorName
    foreach ($row in @(
        @{ Name = $GatewayServiceName;  State = $gatewayState },
        @{ Name = $brokerName;          State = $brokerState },
        @{ Name = $GuardianServiceName; State = $guardianState },
        @{ Name = $enumeratorName;      State = $enumeratorState }
    )) {
        if ($row.State -eq 'marked_for_delete') {
            $rebootRequired = $true
        }
        elseif ($row.State -ne 'absent') {
            $warnings.Add("nuclear uninstall could not remove service $($row.Name) (state: $($row.State))")
            $incomplete.Add("service $($row.Name) is still registered (state: $($row.State))")
        }
    }
    # Only this scope's exact images count: a side-by-side deployment's
    # gateway is not a leftover of this purge. Survivors get one more
    # bounded terminate-and-wait before they are reported.
    foreach ($survivor in @(Stop-DefenseClawScopeWorkerProcesses `
            -InstallRoot ([string]$Layout.InstallRoot) `
            -WaitSeconds 10)) {
        $warnings.Add("nuclear uninstall left worker process alive: $($survivor.Image) pid=$($survivor.Id) image=$($survivor.Path)")
        $incomplete.Add("worker process $($survivor.Image) pid=$($survivor.Id) is still running")
    }

    foreach ($leftover in $incomplete) {
        $warnings.Add("nuclear uninstall incomplete: $leftover")
    }
    foreach ($warning in $warnings) {
        Microsoft.PowerShell.Utility\Write-Warning -Message (
            '{0}: {1}' -f $script:NuclearUninstallMarker, $warning
        )
    }
    if (-not $pendingRenamesBefore -and (Test-DefenseClawPendingFileRenameOperations)) {
        $rebootRequired = $true
    }
    foreach ($event in @(Get-DefenseClawResilienceEvents)) {
        $warnings.Add([string]$event)
    }

    return [pscustomobject]@{
        schema_version                           = 1
        ok                                       = ($incomplete.Count -eq 0)
        incomplete                               = @($incomplete.ToArray())
        reboot_required                          = [bool]$rebootRequired
        action                                   = 'uninstall'
        installed                                = $false
        purged                                   = $true
        nuclear                                  = $true
        install_root                             = [string]$Layout.InstallRoot
        state_root                               = [string]$Layout.StateRoot
        gateway_service                          = $GatewayServiceName
        broker_service                           = $brokerName
        guardian_service                         = $GuardianServiceName
        enumerator_service                       = $enumeratorName
        gateway_service_state                    = $gatewayState
        broker_service_state                     = $brokerState
        guardian_service_state                   = $guardianState
        enumerator_service_state                 = $enumeratorState
        gateway_ready                            = $false
        guardian_ready                           = $false
        cached_enterprise_clients_require_reload = $true
        user_runtime_removed                     = [string[]]@($userRuntime.removed)
        user_runtime_remaining                   = [string[]]@($userRuntime.remaining)
        errors                                   = @()
        warnings                                 = @($warnings.ToArray())
    }
}

function Invoke-DefenseClawUninstallLifecycle {
    param(
        [Parameter(Mandatory)][hashtable]$Layout,
        [Parameter(Mandatory)][string]$GatewayServiceName,
        [Parameter(Mandatory)][string]$GuardianServiceName,
        [switch]$Purge,
        [hashtable]$GatewaySource,
        [hashtable]$NativeCleanupSource,
        [int]$SelfUninstallCallerPID
    )
    # Standalone uninstall, including Purge, reaches this transaction after
    # the precommit holder checks. The Secure Client's legacy nuclear Purge
    # shortcut is selected before this function.
    $metadata = Get-DefenseClawDeploymentMetadata -Layout $Layout -Required
    Assert-DefenseClawMetadataIdentity `
        -Metadata $metadata `
        -GatewayServiceName $GatewayServiceName `
        -GuardianServiceName $GuardianServiceName
    if (-not (Test-DefenseClawMetadataInstalled -Metadata $metadata)) {
        # Uninstall is idempotent after the durable tombstone. This also
        # finishes the only safe post-commit cleanup if the previous process
        # died after transaction completion but before journal retirement.
        # A purge of the per-user state the finalize no longer does runs
        # with Setup's gateway (GAP-2094).
        $userStatePurgeSource = if ($null -ne $GatewaySource) {
            $GatewaySource
        }
        else {
            $NativeCleanupSource
        }
        return Invoke-DefenseClawCommittedUninstallCleanup `
            -Layout $Layout `
            -GatewayServiceName $GatewayServiceName `
            -GuardianServiceName $GuardianServiceName `
            -Purge:$Purge `
            -NativeCleanupSource $NativeCleanupSource `
            -UserStatePurgeSource $userStatePurgeSource
    }
    $managedHooksActivationProperty = $metadata.PSObject.Properties[
        'managed_hooks_activation'
    ]
    if ($null -eq $managedHooksActivationProperty -or
        $null -eq $managedHooksActivationProperty.Value) {
        throw 'Uninstall requires protected managed-hook activation evidence'
    }
    $managedHooksActivation =
        Assert-DefenseClawManagedHooksActivationRecord `
            -Record $managedHooksActivationProperty.Value
    Assert-DefenseClawOwnedServiceOrAbsent `
        -Name $GatewayServiceName `
        -ExpectedGatewayPath $Layout.GatewayPath
    Assert-DefenseClawOwnedServiceOrAbsent `
        -Name $GuardianServiceName `
        -ExpectedGatewayPath $Layout.GatewayPath `
        -ExpectedManifestPath $Layout.ManifestPath `
        -Guardian
    # ImagePath/ObjectName ownership alone is insufficient authorization for
    # deletion by service name. Authenticate the complete registry/SCM
    # contract before any teardown mutation.
    Assert-DefenseClawManagedServiceConfigurations `
        -Layout $Layout `
        -GatewayServiceName $GatewayServiceName `
        -GuardianServiceName $GuardianServiceName `
        -AnyStartMode
    Assert-DefenseClawStandaloneInstallTreeNotInUse `
        -Layout $Layout `
        -GatewayServiceName $GatewayServiceName `
        -GuardianServiceName $GuardianServiceName `
        -SelfUninstallCallerPID $SelfUninstallCallerPID
    Assert-DefenseClawStandaloneInstallRootNotHeld `
        -Layout $Layout `
        -GatewayServiceName $GatewayServiceName `
        -GuardianServiceName $GuardianServiceName `
        -SelfUninstallCallerPID $SelfUninstallCallerPID
    if ($Purge) {
        Assert-DefenseClawStandaloneStateFilesNotInUse `
            -Layout $Layout `
            -GatewayServiceName $GatewayServiceName `
            -GuardianServiceName $GuardianServiceName `
            -SelfUninstallCallerPID $SelfUninstallCallerPID
    }
    if (Test-DefenseClawStandaloneProfile) {
        # A refusal with no state change too. A non-purge uninstall re-stamps
        # every retained item administrator-only
        # (Set-DefenseClawPreservedStateAcls), and the next install adopts
        # them; a purge restores the Codex records and reads the guardian
        # records before it deletes the state (GAP-0590 review M3).
        Assert-DefenseClawStandaloneContentTrusted `
            -Layout $Layout `
            -GatewayServiceName $GatewayServiceName `
            -Scope $(if ($Purge) { 'Purge' } else { 'Retain' })
    }
    # The holder checks are refusals with no state change. Old replacement
    # backups are installation state, so retire them only afterward.
    Remove-DefenseClawStandaloneInstallTreeReplacementBackups -Layout $Layout
    if (Test-DefenseClawStandaloneProfile) {
        Assert-DefenseClawStandaloneUninstallInstallTree -Layout $Layout
    }
    else {
        Assert-DefenseClawManagedInstallTree -Layout $Layout
    }
    Assert-DefenseClawRecordedArtifactHashes `
        -Metadata $metadata `
        -Layout $Layout `
        -Action 'Uninstall'
    Remove-DefenseClawUninstallStateTreeLinks -Layout $Layout
    # A standalone uninstall removes the hooks after its tombstone commits
    # (pending.json keeps them registered until then) when the installed
    # helper can prepare that removal against the tombstone. An older
    # deployment's helper cannot, so its hooks are removed before the commit
    # as its own release did (GAP-1443, GAP-1447). Secure Client always
    # removes them before the commit. Asked before anything changes.
    $postCommitHookTeardown = [bool](
        (Test-DefenseClawStandaloneProfile) -and
        (Test-DefenseClawManagedHooksCommittedTeardownSupported `
            -Layout $Layout `
            -GatewayServiceName $GatewayServiceName)
    )
    # GAP-0571: the post-commit prepare authenticates the guardian evidence,
    # the enrollment and the runtime selectors and refuses anything it cannot
    # bind (a failed guardian row, a selector it cannot read). Ask the same
    # helper the same questions, read-only, while nothing has changed: a
    # refusal then leaves the deployment fully installed and says what to
    # repair, instead of a committed tombstone that every retry refuses. The
    # OWNER RIGHTS restore that runs first (GAP-0303) only tightens.
    $precheckRebound = $false
    if ($postCommitHookTeardown -and
        (Test-DefenseClawManagedHooksCommittedTeardownSupported `
            -Layout $Layout `
            -GatewayServiceName $GatewayServiceName `
            -Capability precommit_check)) {
        try {
            $precheckRebound = [bool](Invoke-DefenseClawUninstallPrecommitHookCheck `
                -Layout $Layout `
                -GatewayServiceName $GatewayServiceName `
                -GuardianServiceName $GuardianServiceName)
        }
        catch {
            $reason = $_.Exception.Message
            if (Test-DefenseClawDeletedAccountTeardownRefusal -Message $reason) {
                throw ("The uninstall stopped before it removed anything; DefenseClaw is still installed. " +
                    "An enrolled local account was deleted after the hook enumerator last ran, and its rows are still listed: " +
                    "$reason. Nothing needs repair: run the uninstall again after the enumerator's next pass " +
                    "(a few minutes), or restart the $(Get-DefenseClawEnumeratorServiceName -GuardianServiceName $GuardianServiceName) " +
                    "service first.")
            }
            throw ("The uninstall stopped before it removed anything; DefenseClaw is still installed. " +
                "The hook removal it runs after the commit would refuse this deployment: " +
                "$reason. Repair that (run $(Format-DefenseClawRepairAction -Layout $Layout), or undo the change to the file it names), " +
                "then run the uninstall again.")
        }
    }
    if ($precheckRebound) {
        # rel-1-0-6:GAP-0346: the check rebound the activation evidence to the
        # targets.yaml the enumerator published for a deleted account. The
        # tombstone below carries that evidence, so read it again: the record
        # read above names the manifest before the pass, and a tombstone with
        # it made the post-commit hook removal refuse every later run.
        $metadata = Get-DefenseClawDeploymentMetadata -Layout $Layout -Required
        Assert-DefenseClawMetadataIdentity `
            -Metadata $metadata `
            -GatewayServiceName $GatewayServiceName `
            -GuardianServiceName $GuardianServiceName
        $managedHooksActivation =
            Assert-DefenseClawManagedHooksActivationRecord `
                -Record $metadata.managed_hooks_activation
    }
    # The native InstallRoot seal/delete (#1068) admits only the Secure Client
    # tree and its single gateway socket. Standalone keeps the PowerShell
    # removal that knows its sensor-helper sockets and plugin folders.
    $useNativeInstallCleanup = [bool](
        $Purge -and
        -not (Test-DefenseClawStandaloneProfile) -and
        (Test-DefenseClawExternalInstallCleanupSource `
            -Layout $Layout `
            -Source $NativeCleanupSource)
    )
    if (Microsoft.PowerShell.Management\Test-Path `
        -LiteralPath $Layout.ManagedHooksLifecycleJournalPath `
        -PathType Leaf) {
        Invoke-DefenseClawCommittedManagedHooksLifecycleRetire `
            -Layout $Layout `
            -GatewayServiceName $GatewayServiceName `
            -GatewaySource $GatewaySource
    }
    if (Test-DefenseClawStandaloneProfile) {
        [void](Remove-DefenseClawRolledBackTeardownJournal -Layout $Layout -Stale)
    }
    $selfUninstallCallerIdentity = $null
    if ($SelfUninstallCallerPID -gt 0) {
        $selfUninstallCallerIdentity =
            Get-DefenseClawSelfUninstallCallerIdentity `
                -Layout $Layout `
                -CallerPID $SelfUninstallCallerPID
        # A self-uninstall renames InstallRoot aside after its commit. Stop
        # here, before anything changed, when another account could take the
        # freed name (GAP-0149 review, loop round 2).
        try {
            Assert-DefenseClawInstallRootNameReserved -InstallRoot $Layout.InstallRoot
        }
        catch {
            throw "The uninstall stopped before it removed anything: $($_.Exception.Message)"
        }
    }
    $gatewaySID = Get-DefenseClawServiceSID -ServiceName $GatewayServiceName
    $snapshot = $null
    $selfUninstallReceipt = $null
    $installRootIdentity = ''
    $stateRootIdentity = ''
    try {
        # New-DefenseClawTransaction records prior service state, then waits
        # for guardian and gateway process exit before snapshotting. The live
        # teardown journal is intentionally excluded: captured/prepared
        # preimages must survive generic restore until hidden rollback consumes
        # them. Therefore no LocalSystem auto-heal can occur after the
        # authoritative prepare+verify boundary.
        $snapshot = New-DefenseClawTransaction `
            -Layout $Layout `
            -GatewayServiceName $GatewayServiceName `
            -GuardianServiceName $GuardianServiceName `
            -PriorDeploymentActive `
            -IncludeCodexMachineState:$Layout.CodexTargetEnabled `
            -SkipLinkedCodexMachineState `
            -PreserveManagedHooksTeardownJournal `
            -SkipRedactionKeySnapshot `
            -ContentGateScope $(if ($Purge) { 'Purge' } else { 'Retain' })
        [void](Suspend-DefenseClawSensorHelperForServicing -Layout $Layout)
        if (Test-DefenseClawStandaloneProfile) {
            Invoke-DefenseClawCoworkDelivery -Layout $Layout `
                -GatewayServiceName $GatewayServiceName -SnapshotPath $snapshot -Remove
        }
        if ($useNativeInstallCleanup) {
            Assert-DefenseClawDescendant `
                -Path $snapshot `
                -Root $Layout.StateRoot `
                -Label 'uninstall transaction snapshot' |
                Microsoft.PowerShell.Core\Out-Null
            Assert-DefenseClawNoReparsePath -Path $snapshot
            $recordedSnapshot = Microsoft.PowerShell.Management\Get-Content `
                -LiteralPath $snapshot `
                -Raw |
                Microsoft.PowerShell.Utility\ConvertFrom-Json
            $installRootIdentity = ([string](
                $recordedSnapshot.install_root_identity
            )).ToLowerInvariant()
            if ($installRootIdentity -cnotmatch
                '^[a-f0-9]{8}:[a-f0-9]{16}$') {
                throw 'uninstall transaction did not record a valid InstallRoot identity'
            }
            $stateRootIdentity = ([string](
                $recordedSnapshot.state_root_identity
            )).ToLowerInvariant()
            if ($stateRootIdentity -cnotmatch
                '^[a-f0-9]{8}:[a-f0-9]{16}$') {
                throw 'uninstall transaction did not record a valid StateRoot identity'
            }
            $nativeSecurity = Initialize-DefenseClawNativeSecurity
            $currentInstallRoot =
                $nativeSecurity::GetDirectorySecuritySnapshotNoFollow(
                [string]$Layout.InstallRoot
            )
            if ([string]$currentInstallRoot.Identity -cne
                $installRootIdentity) {
                throw 'InstallRoot changed after uninstall transaction capture'
            }
        }
        if (-not $postCommitHookTeardown) {
            [void](Invoke-DefenseClawManagedHooksTeardownCommand `
                -Layout $Layout `
                -GatewayServiceName $GatewayServiceName `
                -GuardianServiceName $GuardianServiceName `
                -Action prepare)
            [void](Invoke-DefenseClawManagedHooksTeardownCommand `
                -Layout $Layout `
                -GatewayServiceName $GatewayServiceName `
                -GuardianServiceName $GuardianServiceName `
                -Action verify)
            Set-DefenseClawTransactionManagedHooksTeardownPrepared `
                -SnapshotPath $snapshot `
                -Layout $Layout
            if ([bool]$Layout.CodexTargetEnabled) {
                $codexRemoval = Invoke-DefenseClawCodexRequirementsCommand `
                    -Layout $Layout `
                    -GatewayServiceName $GatewayServiceName `
                    -Action remove `
                    -Teardown
                Complete-DefenseClawCodexRequirementsRemoval `
                    -Layout $Layout `
                    -GatewayServiceName $GatewayServiceName `
                    -Report $codexRemoval `
                    -Teardown
            }
        }
        if (Microsoft.PowerShell.Management\Test-Path `
            -LiteralPath $Layout.AgentApplicationControlAttestationPath `
            -PathType Leaf) {
            Microsoft.PowerShell.Management\Remove-Item `
                -LiteralPath $Layout.AgentApplicationControlAttestationPath `
                -Force
        }
        # Re-authenticate every service field and both ACL surfaces at the
        # deletion boundary. A concurrent administrative drift or same-name
        # takeover fails closed before either sc.exe delete.
        Assert-DefenseClawManagedServiceConfigurations `
            -Layout $Layout `
            -GatewayServiceName $GatewayServiceName `
            -GuardianServiceName $GuardianServiceName `
            -ServicingTransaction
        # Teardown order: enumerator → guardian → gateway.
        # The running enumerator is read-only, but removing it first freezes
        # profile-audit activity while Guardian and its authenticated manifest
        # are retired. Guardian teardown after remains unchanged.
        $enumeratorServiceName = Get-DefenseClawEnumeratorServiceName -GuardianServiceName $GuardianServiceName
        Assert-DefenseClawOwnedServiceOrAbsent `
            -Name $enumeratorServiceName `
            -ExpectedGatewayPath $Layout.GatewayPath `
            -ExpectedManifestPath $Layout.ManifestPath `
            -Enumerator
        Remove-DefenseClawService -Name $enumeratorServiceName
        Assert-DefenseClawOwnedServiceOrAbsent `
            -Name $GuardianServiceName `
            -ExpectedGatewayPath $Layout.GatewayPath `
            -ExpectedManifestPath $Layout.ManifestPath `
            -Guardian
        Remove-DefenseClawService -Name $GuardianServiceName
        Assert-DefenseClawOwnedServiceOrAbsent `
            -Name $GatewayServiceName `
            -ExpectedGatewayPath $Layout.GatewayPath
        Remove-DefenseClawService -Name $GatewayServiceName
        Assert-DefenseClawOwnedServiceOrAbsent `
            -Name $Layout.SensorHelperServiceName `
            -ExpectedGatewayPath $Layout.SensorHelperPath `
            -ExpectedSensorHelperImage (Get-DefenseClawSensorHelperImage `
                -Layout $Layout `
                -GatewayServiceName $GatewayServiceName) `
            -SensorHelper
        Remove-DefenseClawService -Name $Layout.SensorHelperServiceName
        if ((Test-DefenseClawLayoutBrokerEnabled -Layout $Layout)) {
            Assert-DefenseClawCMIDBrokerServiceOrAbsent `
                -Name $Layout.BrokerServiceName `
                -ExpectedImage (Get-DefenseClawCMIDBrokerImage `
                    -Layout $Layout `
                    -GatewayServiceName $GatewayServiceName)
            Remove-DefenseClawService -Name $Layout.BrokerServiceName
        }
        Remove-DefenseClawStandaloneManagedIPCDirectory -Layout $Layout
        Remove-DefenseClawSecureClientSensorHelperSocket -Layout $Layout
        if (-not (Test-DefenseClawStandaloneProfile)) {
            Remove-DefenseClawStandaloneOpenCodeManagedPlugin -Layout $Layout
        }
        $tombstone = New-DefenseClawDeploymentMetadata `
            -Layout $Layout `
            -GatewayServiceName $GatewayServiceName `
            -GuardianServiceName $GuardianServiceName `
            -Installed:$false `
            -ManagedHooksActivation $managedHooksActivation `
            -InstallRootIdentity $installRootIdentity `
            -StateRootIdentity $stateRootIdentity `
            -UninstallPurgeRequested ([bool]$Purge) `
            -UninstallPurgeUserStateRequested (
                [bool]$script:DefenseClawUninstallPurgeUserState
            )
        if ($tombstone -is [Collections.IDictionary] -and
            $tombstone.Contains('product_version')) {
            # The tombstone names the release that was removed, not the
            # Setup that removed it (GAP-1074).
            $removedVersion = $metadata.PSObject.Properties['product_version']
            if ($null -ne $removedVersion -and
                -not [string]::IsNullOrWhiteSpace([string]$removedVersion.Value)) {
                $tombstone['product_version'] = [string]$removedVersion.Value
            }
            else {
                $tombstone.Remove('product_version')
            }
        }
        Write-DefenseClawJsonAtomic -Value $tombstone -Path $Layout.MetadataPath -Kind AdminFile
        Set-DefenseClawPreservedStateAcls `
            -Layout $Layout `
            -GatewayServiceSID $gatewaySID `
            -Purge:$Purge
        if ($useNativeInstallCleanup) {
            # Restrict traversal before commit; the native post-commit seal
            # pins and stamps all descendants before the installed gateway
            # can be executed for finalization.
            Set-DefenseClawPathAcl `
                -Path $Layout.InstallRoot `
                -Kind AdminDirectory `
                -GatewayServiceSID $script:AdministratorsSID
        }
        elseif (-not (Test-DefenseClawStandaloneProfile)) {
            Set-DefenseClawInstallTreeRetirementAcls -Layout $Layout
        }
        if ($null -ne $selfUninstallCallerIdentity) {
            $selfUninstallReceipt =
                Publish-DefenseClawSelfUninstallReceipt `
                    -Layout $Layout `
                    -GatewayServiceName $GatewayServiceName `
                    -GuardianServiceName $GuardianServiceName `
                    -CallerIdentity $selfUninstallCallerIdentity `
                    -Purge:$Purge
            $retiredRoot = [string]$selfUninstallReceipt.retired_install_root
            if (Microsoft.PowerShell.Management\Test-Path `
                -LiteralPath $retiredRoot) {
                throw 'fresh self-uninstall retirement sibling unexpectedly exists'
            }
        }
        Complete-DefenseClawTransaction -SnapshotPath $snapshot -Layout $Layout
    }
    catch {
        $operationError = $_
        $rollbackErrors = [Collections.Generic.List[string]]::new()
        # Publication writes the protected receipt before returning its
        # authenticated representation. If the post-write authentication
        # check itself fails, discover that exact evidence before rollback.
        # Never silently strand external authority while generic transaction
        # state is retired.
        if ($null -ne $selfUninstallCallerIdentity -and
            $null -eq $selfUninstallReceipt -and
            (Microsoft.PowerShell.Management\Test-Path `
                -LiteralPath $Layout.SelfUninstallReceiptPath `
                -PathType Leaf)) {
            try {
                $selfUninstallReceipt =
                    Get-DefenseClawSelfUninstallReceipt `
                        -Layout $Layout `
                        -GatewayServiceName $GatewayServiceName `
                        -GuardianServiceName $GuardianServiceName `
                        -Required
            }
            catch {
                $rollbackErrors.Add(
                    'published self-uninstall receipt could not be ' +
                    "authenticated for rollback: $($_.Exception.Message)"
                )
            }
        }
        if ($null -ne $selfUninstallReceipt -and
            -not (Microsoft.PowerShell.Management\Test-Path `
                -LiteralPath $Layout.InstallRoot) -and
            (Microsoft.PowerShell.Management\Test-Path `
                -LiteralPath ([string]$selfUninstallReceipt.retired_install_root) `
                -PathType Container)) {
            try {
                Move-DefenseClawRetiredInstallTreeBack `
                    -Layout $Layout `
                    -Receipt $selfUninstallReceipt
            }
            catch {
                $rollbackErrors.Add(
                    "retired InstallRoot restore failed: $($_.Exception.Message)"
                )
            }
        }
        if (-not [string]::IsNullOrWhiteSpace([string]$snapshot)) {
            if ($useNativeInstallCleanup -and
                $installRootIdentity -cmatch
                    '^[a-f0-9]{8}:[a-f0-9]{16}$') {
                # A precommit failure must restore services and files. First
                # reopen any ACL-denied installed descendants through the
                # same identity-bound external helper, so ordinary rollback
                # can restamp its recorded managed files.
                try {
                    [void](Invoke-DefenseClawUninstallInstallRootNativeCleanup `
                        -Layout $Layout `
                        -Source $NativeCleanupSource `
                        -ExpectedIdentity $installRootIdentity `
                        -GatewayServiceSID $gatewaySID `
                        -Operation seal_only)
                }
                catch {
                    $rollbackErrors.Add(
                        "native InstallRoot ACL recovery failed: $($_.Exception.Message)"
                    )
                }
            }
            try {
                [void](Restore-DefenseClawTransactionWithManagedHooksRollback `
                    -SnapshotPath $snapshot `
                    -Layout $Layout)
            }
            catch {
                $rollbackErrors.Add(
                    "managed lifecycle/hook restore failed: $($_.Exception.Message)"
                )
            }
        }
        if ($rollbackErrors.Count -eq 0 -and
            $null -ne $selfUninstallReceipt) {
            try {
                Remove-DefenseClawSelfUninstallEvidence `
                    -Layout $Layout `
                    -Receipt $selfUninstallReceipt
            }
            catch {
                $rollbackErrors.Add(
                    "self-uninstall evidence retirement failed: $($_.Exception.Message)"
                )
            }
        }
        if ($rollbackErrors.Count -eq 0 -and
            -not [string]::IsNullOrWhiteSpace([string]$snapshot)) {
            try {
                Complete-DefenseClawTransaction `
                    -SnapshotPath $snapshot `
                    -Layout $Layout `
                    -Rollback
            }
            catch {
                $rollbackErrors.Add(
                    "transaction cleanup failed: $($_.Exception.Message)"
                )
            }
        }
        if ($rollbackErrors.Count -eq 0 -and (Test-DefenseClawStandaloneProfile)) {
            # The finished rollback was the last reader of the journal this
            # uninstall wrote (GAP-1041). A removal that fails here is
            # retried, and reported, by the next uninstall.
            try {
                [void](Remove-DefenseClawRolledBackTeardownJournal -Layout $Layout)
            }
            catch {
                Microsoft.PowerShell.Utility\Write-Verbose "rolled-back teardown journal stays: $($_.Exception.Message)"
            }
        }
        if ($rollbackErrors.Count -gt 0) {
            throw (
                "Uninstall failed ($($operationError.Exception.Message)); " +
                'rollback also failed and protected recovery state was retained: ' +
                ($rollbackErrors -join '; ')
            )
        }
        throw $operationError
    }
    $finalization = $null
    $retirementDeferred = ''
    try {
        if ($useNativeInstallCleanup) {
            [void](Invoke-DefenseClawUninstallInstallRootNativeCleanup `
                -Layout $Layout `
                -Source $NativeCleanupSource `
                -ExpectedIdentity $installRootIdentity `
                -GatewayServiceSID $gatewaySID `
                -Operation seal_only)
        }
        $finalization = Complete-DefenseClawCommittedManagedHooksFinalization `
            -Layout $Layout `
            -GatewayServiceName $GatewayServiceName `
            -GuardianServiceName $GuardianServiceName `
            -Purge:$Purge `
            -NativeSealed:$useNativeInstallCleanup
        if ($null -ne $selfUninstallReceipt) {
            $retiredRoot = [string]$selfUninstallReceipt.retired_install_root
            $retirementDeferred = Invoke-DefenseClawCommittedInstallRootRetirement `
                -Source $Layout.InstallRoot `
                -Destination $retiredRoot `
                -SelfUninstallCallerPID $SelfUninstallCallerPID
            if ([string]::IsNullOrEmpty($retirementDeferred)) {
                Set-DefenseClawRetiredInstallTreeAcls `
                    -Layout $Layout `
                    -RetiredRoot $retiredRoot
            }
        }
        else {
            if ($useNativeInstallCleanup) {
                [void](Invoke-DefenseClawUninstallInstallRootNativeCleanup `
                    -Layout $Layout `
                    -Source $NativeCleanupSource `
                    -ExpectedIdentity $installRootIdentity `
                    -GatewayServiceSID $gatewaySID `
                    -Operation delete)
            }
            else {
                Remove-DefenseClawManagedTree `
                    -Path $Layout.InstallRoot `
                    -RequiredBase $script:ProgramFiles `
                    -Label 'InstallRoot' `
                    -AllowAFUnixSocketAt (Get-DefenseClawOptionalLayoutValue -Layout $Layout -Name ManagedIPCSocketPath)
            }
        }
    }
    catch {
        throw (
            'Uninstall committed, but managed runtime finalization or binary ' +
            "retirement failed; retry Uninstall to finish cleanup: $($_.Exception.Message)"
        )
    }
    if (-not [string]::IsNullOrEmpty($retirementDeferred)) {
        return Start-DefenseClawDeferredSelfUninstallRetirement `
            -Layout $Layout `
            -GatewayServiceName $GatewayServiceName `
            -GuardianServiceName $GuardianServiceName `
            -Finalization $finalization `
            -Reason $retirementDeferred
    }
    try {
        # The authenticated rollback journal remains live through transaction
        # completion. Retire it only after the tombstone, binary deletion, and
        # pending-transaction cleanup are all durable.
        [void](Remove-DefenseClawCommittedManagedHooksTeardownJournal `
            -Layout $Layout `
            -GatewayServiceName $GatewayServiceName `
            -GuardianServiceName $GuardianServiceName)
    }
    catch {
        throw (
            'Uninstall committed, but protected managed-hook teardown journal ' +
            "retirement failed; retry Uninstall to finish cleanup: $($_.Exception.Message)"
        )
    }
    if ($null -ne $selfUninstallReceipt) {
        try {
            $selfUninstallReceipt =
                Set-DefenseClawSelfUninstallReceiptCommitted `
                    -Layout $Layout `
                    -GatewayServiceName $GatewayServiceName `
                    -GuardianServiceName $GuardianServiceName
            [void](Start-DefenseClawSelfUninstallHelper `
                -Layout $Layout `
                -Receipt $selfUninstallReceipt)
        }
        catch {
            throw (
                'Uninstall committed and canonical InstallRoot was retired, ' +
                'but detached self-cleanup could not start; protected recovery ' +
                "state was retained: $($_.Exception.Message)"
            )
        }
    }
    # The OpenAI\Codex tree is shared global vendor state. Enterprise
    # uninstall/purge never claims or removes it, including directories
    # DefenseClaw originally provisioned. Purge is authorized by an
    # authenticated receipt outside StateRoot before its first deletion.
    $result = Invoke-DefenseClawCommittedUninstallCleanup `
        -Layout $Layout `
        -GatewayServiceName $GatewayServiceName `
        -GuardianServiceName $GuardianServiceName `
        -Purge:$Purge `
        -GatewayServiceSID $gatewaySID `
        -NativeCleanupSource $NativeCleanupSource
    $result |
        Microsoft.PowerShell.Utility\Add-Member `
            -MemberType NoteProperty `
            -Name cached_enterprise_clients_require_reload `
            -Value $true `
            -Force
    $result = Add-DefenseClawUserRegistrationCleanupResult `
        -Result $result `
        -Layout $Layout `
        -Finalization $finalization
    # A Secure Client purge also removes DefenseClaw's own entries from the
    # accounts' .defenseclaw folders (the standalone purge removes those
    # folders in its finalize).
    if ($Purge -and (Test-DefenseClawManagedUserRuntimeCleanupScope -Layout $Layout)) {
        $result = Add-DefenseClawManagedUserRuntimeCleanupResult -Result $result
    }
    if ($null -ne $selfUninstallReceipt) {
        return Add-DefenseClawSelfUninstallResult `
            -Result $result `
            -Layout $Layout `
            -Receipt $selfUninstallReceipt `
            -CleanupPending:$true
    }
    return $result
}

function Repair-DefenseClawManagedServiceConfiguration {
    param(
        [Parameter(Mandatory)][hashtable]$Layout,
        [Parameter(Mandatory)][string]$GatewayServiceName,
        [Parameter(Mandatory)][string]$GuardianServiceName
    )
    try {
        Set-DefenseClawManagedServices `
            -GatewayServiceName $GatewayServiceName `
            -GuardianServiceName $GuardianServiceName `
            -BrokerServiceName $Layout.BrokerServiceName `
            -BrokerPath $Layout.BrokerPath `
            -BrokerPipeName $Layout.BrokerPipeName `
            -BrokerAuthKeyPath $Layout.BrokerAuthKeyPath `
            -ProviderLibraryPath $Layout.ProviderLibraryPath `
            -BrokerLogPath $Layout.BrokerLogPath `
            -GatewayPath $Layout.GatewayPath `
            -ManifestPath $Layout.ManifestPath `
            -RuntimeDirectory $Layout.RuntimeDirectory `
            -ConfigPath $Layout.ConfigPath `
            -AuthorizationDirectory $Layout.AuthorizationDirectory `
            -GatewayLogPath $Layout.GatewayLogPath `
            -GuardianLogPath $Layout.GuardianLogPath `
            -AgentApplicationControlAttested:$Layout.AgentApplicationControlAttested `
            -ClaudeEffectivePolicyVerified:$Layout.ClaudeEffectivePolicyVerified
        Write-DefenseClawResilienceEvent -Marker defenseclaw_repair -Fields @{
            service = "$GatewayServiceName,$GuardianServiceName,$($Layout.BrokerServiceName)"
            reason  = 'Reconcile re-applied the managed service configuration'
        }
    }
    catch {
        # What the re-apply could not fix is judged by the assertion that
        # follows; a partial write is not itself a failure.
        Write-DefenseClawResilienceEvent -Marker defenseclaw_accept -Fields @{
            service = $GatewayServiceName
            reason  = "managed service configuration re-apply did not complete: $($_.Exception.Message)"
        }
    }
}

function Invoke-DefenseClawReconcileLifecycle {
    param(
        [Parameter(Mandatory)][hashtable]$Layout,
        [Parameter(Mandatory)][string]$GatewayServiceName,
        [Parameter(Mandatory)][string]$GuardianServiceName
    )
    $metadata = Get-DefenseClawDeploymentMetadata -Layout $Layout -Required
    if (-not (Test-DefenseClawMetadataInstalled -Metadata $metadata)) {
        throw 'Reconcile requires an installed DefenseClaw enterprise deployment'
    }
    Assert-DefenseClawMetadataIdentity `
        -Metadata $metadata `
        -GatewayServiceName $GatewayServiceName `
        -GuardianServiceName $GuardianServiceName
    if ($null -ne $metadata.PSObject.Properties[
            'deferred_config_pending'
        ] -and [bool]$metadata.deferred_config_pending) {
        throw 'deferred configuration must be completed with Repair before Reconcile'
    }
    Assert-DefenseClawOwnedServiceOrAbsent `
        -Name $GatewayServiceName `
        -ExpectedGatewayPath $Layout.GatewayPath
    Assert-DefenseClawOwnedServiceOrAbsent `
        -Name $GuardianServiceName `
        -ExpectedGatewayPath $Layout.GatewayPath `
        -ExpectedManifestPath $Layout.ManifestPath `
        -Guardian
    Assert-DefenseClawRecordedArtifactHashes `
        -Metadata $metadata `
        -Layout $Layout `
        -Action 'Reconcile'
    if ([bool]$Layout.CodexTargetEnabled) {
        Assert-DefenseClawCodexMachinePolicyDirectory -Path $Layout.CodexVendorDirectory
        Assert-DefenseClawCodexMachinePolicyDirectory -Path $Layout.CodexMachinePolicyDirectory
        Assert-DefenseClawCodexMachinePolicyFilePreflight -Layout $Layout
        Assert-DefenseClawCodexManagedHooksStateFilePreflight -Layout $Layout
        [void](Get-DefenseClawCodexRequirementsAclBackup -Layout $Layout)
        [void](Invoke-DefenseClawCodexRequirementsCommand `
            -Layout $Layout `
            -GatewayServiceName $GatewayServiceName `
            -Action reconcile)
    }
    else {
        [void](Invoke-DefenseClawCodexRequirementsCommand `
            -Layout $Layout `
            -GatewayServiceName $GatewayServiceName `
            -Action inspect)
    }
    if (Test-DefenseClawStandaloneProfile) {
        Assert-DefenseClawStandaloneContentTrusted -Layout $Layout -GatewayServiceName $GatewayServiceName
    }
    Set-DefenseClawManagedAcls `
        -Layout $Layout `
        -GatewayServiceName $GatewayServiceName
    Set-DefenseClawStandaloneSecretsAcls `
        -Layout $Layout `
        -GatewayServiceSID (Get-DefenseClawServiceSID -ServiceName $GatewayServiceName)
    # Re-apply the managed service configuration before asserting it, as
    # Install does, without stopping a running service: SCM applies the
    # configuration on the next start, and a security template, an EDR or an
    # admin edit is drift to repair, not a reason to fail Reconcile.
    Repair-DefenseClawManagedServiceConfiguration `
        -Layout $Layout `
        -GatewayServiceName $GatewayServiceName `
        -GuardianServiceName $GuardianServiceName
    if ([bool]$Layout.CodexTargetEnabled) {
        Assert-DefenseClawCodexMachinePolicyFile -Layout $Layout
        Assert-DefenseClawCodexManagedHooksStateFile -Layout $Layout
        [void](Invoke-DefenseClawCodexRequirementsCommand `
            -Layout $Layout `
            -GatewayServiceName $GatewayServiceName `
            -Action verify)
    }
    Assert-DefenseClawEnterpriseDeployment `
        -Layout $Layout `
        -GatewayServiceName $GatewayServiceName `
        -GuardianServiceName $GuardianServiceName
    $generation = Wait-DefenseClawFreshGuardianReconcile `
        -Layout $Layout `
        -GatewayServiceName $GatewayServiceName `
        -GuardianServiceName $GuardianServiceName
    Set-DefenseClawManagedAcls -Layout $Layout -GatewayServiceName $GatewayServiceName
    Assert-DefenseClawEnterpriseDeployment `
        -Layout $Layout `
        -GatewayServiceName $GatewayServiceName `
        -GuardianServiceName $GuardianServiceName `
        -RequireReadiness
    $result = Get-DefenseClawLifecycleStatus `
        -Action 'Reconcile' `
        -Layout $Layout `
        -GatewayServiceName $GatewayServiceName `
        -GuardianServiceName $GuardianServiceName
    $result.guardian_generation = $generation
    return $result
}

function Get-DefenseClawStandaloneSquattedRoots {
    <#
        Standalone production roots only. On a device without other Cisco
        software, C:\ProgramData\Cisco does not exist until DefenseClaw creates
        it, and where it does exist it usually carries the ProgramData ACL that
        lets BUILTIN\Users create subfolders. A standard user can therefore
        create the vendor directory, the state root, or the lifecycle lock
        directory first and own it. The lifecycle never adopts such a tree.
        Returns each existing root (outermost first; nothing beneath a
        squatted one) whose owner is not SYSTEM, Administrators, or
        TrustedInstaller, is not a plain directory, or cannot be inspected.
    #>
    $roots = Get-DefenseClawProfileRoots -EnterpriseProfile Standalone
    $vendor = [IO.Path]::GetDirectoryName([string]$roots.StateRoot)
    $squatted = [Collections.Generic.List[object]]::new()
    foreach ($path in @($vendor, [string]$roots.StateRoot, [string]$roots.LifecycleDirectory)) {
        if (@($squatted | Microsoft.PowerShell.Core\Where-Object {
                    $path.StartsWith([string]$_.path + '\', [StringComparison]::OrdinalIgnoreCase)
                }).Count -gt 0) {
            continue
        }
        $item = Microsoft.PowerShell.Management\Get-Item -LiteralPath $path -Force -ErrorAction SilentlyContinue
        if ($null -eq $item) {
            continue
        }
        $owner = ''
        try {
            if (($item.Attributes -band [IO.FileAttributes]::ReparsePoint) -ne 0 -or
                -not $item.PSIsContainer) {
                $owner = 'not a plain directory'
            }
            else {
                $ownerSID = ConvertTo-DefenseClawSID -Identity (
                    Microsoft.PowerShell.Security\Get-Acl -LiteralPath $path
                ).Owner
                if ($ownerSID -notin @($script:SystemSID, $script:AdministratorsSID, $script:TrustedInstallerSID)) {
                    $owner = $ownerSID
                }
            }
        }
        catch {
            $owner = 'unreadable security descriptor'
        }
        if (-not [string]::IsNullOrEmpty($owner)) {
            $squatted.Add([pscustomobject]@{ path = $path; owner = $owner })
        }
    }
    return @($squatted.ToArray())
}

function Move-DefenseClawStandaloneSquattedRoots {
    <#
        Install only. Moves each squatted standalone root aside, in place, to
        <name>.untrusted-<UTC time>-<random> so the lifecycle can create its
        protected roots fresh. The tree is renamed, never opened, followed,
        re-owned, or deleted: a rename moves a reparse point itself, and the
        user keeps whatever they put there. A root that holds content an
        administrator owns (another product's data) is never moved, and the
        shared vendor directory is moved only while it holds nothing but
        DefenseClaw roots and content its own user owner created. Each move
        is reported in quarantined_paths. Fails closed with root_squatted when
        a root cannot be moved or is re-created before the lifecycle runs.
    #>
    param([Parameter(Mandatory)][object[]]$Squatted)
    $vendor = [IO.Path]::GetDirectoryName(
        [string](Get-DefenseClawProfileRoots -EnterpriseProfile Standalone).StateRoot
    )
    foreach ($entry in $Squatted) {
        $path = [string]$entry.path
        $item = Microsoft.PowerShell.Management\Get-Item -LiteralPath $path -Force
        # The planting account is read from the path itself before anything
        # removes or moves it (GAP-0618).
        $planter = Get-DefenseClawSquattedRootPlanter -Path $path
        $cause = Format-DefenseClawSquattedRootCause -Entry $entry -Planter $planter
        $children = @()
        if ($item.PSIsContainer -and
            ($item.Attributes -band [IO.FileAttributes]::ReparsePoint) -eq 0) {
            try {
                $children = @(Microsoft.PowerShell.Management\Get-ChildItem -LiteralPath $path -Force -ErrorAction Stop)
            }
            catch {
                # A tree that hides its content from administrators is not
                # another product's data; it is moved like any other.
                $children = @()
            }
        }
        # The vendor directory is a namespace other Cisco software shares.
        # Move it only while everything in it is a DefenseClaw root or belongs
        # to the user account (local, domain, or Entra ID) that owns the
        # directory itself: that is the squatter's own content, which the move
        # keeps intact. Content another principal owns, such as another
        # product's service account, blocks the move, as does a vendor
        # directory a service identity owns.
        # Owners are compared as SIDs: an account that no longer resolves (or
        # whose domain is unreachable) has no name to compare.
        $isVendor = [string]::Equals($path, $vendor, [StringComparison]::OrdinalIgnoreCase)
        $vendorOwner = $null
        if ($isVendor) {
            try {
                $vendorOwner = (Microsoft.PowerShell.Security\Get-Acl -LiteralPath $path).GetOwner(
                    [Security.Principal.SecurityIdentifier]
                ).Value
            }
            catch {
                $vendorOwner = $null
            }
        }
        $vendorOwnerIsUser = $null -ne $vendorOwner -and
            ([string]$vendorOwner -match '^S-1-(5-21|12-1)(-[0-9]+)+$')
        foreach ($child in $children) {
            $childOwner = $null
            try {
                $childOwner = (Microsoft.PowerShell.Security\Get-Acl -LiteralPath $child.FullName).GetOwner(
                    [Security.Principal.SecurityIdentifier]
                ).Value
            }
            catch {
                # Content that hides its owner from administrators is not
                # another product's data.
                $childOwner = $null
            }
            if ($null -ne $childOwner -and
                $childOwner -in @($script:SystemSID, $script:AdministratorsSID, $script:TrustedInstallerSID)) {
                throw (
                    "root_squatted: $path $cause, " +
                    "and holds administrator-owned content ($($child.FullName)); an administrator must " +
                    'move or remove it before DefenseClaw can install'
                )
            }
            if ($isVendor -and
                -not ([string]$child.Name).StartsWith('DefenseClaw', [StringComparison]::OrdinalIgnoreCase) -and
                -not ($vendorOwnerIsUser -and
                    ($null -eq $childOwner -or
                        [string]::Equals([string]$childOwner, [string]$vendorOwner, [StringComparison]::OrdinalIgnoreCase)))) {
                throw (
                    "root_squatted: $path $cause, " +
                    "and holds content other than DefenseClaw that its owner did not create ($($child.FullName)); " +
                    'an administrator must correct its ownership or remove it before DefenseClaw can install'
                )
            }
        }
        if (($item.Attributes -band [IO.FileAttributes]::ReparsePoint) -ne 0) {
            # A junction or symbolic link a standard user planted is removed
            # as a link (rmdir semantics: the reparse point goes, its target
            # is never opened or followed). It used to be renamed aside and
            # left in ProgramData with no word to the administrator
            # (GAP-0904).
            $target = ''
            try {
                $target = [string](@($item.Target) | Microsoft.PowerShell.Utility\Select-Object -First 1)
            }
            catch {
            }
            try {
                if ($item.PSIsContainer) {
                    [IO.Directory]::Delete($path)
                }
                else {
                    [IO.File]::Delete($path)
                }
            }
            catch {
                throw (
                    "root_squatted: $path is a link that $planter created, not an administrator, and could not " +
                    "be removed ($($_.Exception.Message)); an administrator must remove the link (rmdir `"$path`")"
                )
            }
            if (Microsoft.PowerShell.Management\Test-Path -LiteralPath $path) {
                throw "root_squatted: $path was re-created while DefenseClaw removed a planted link"
            }
            $script:DefenseClawSquattedRootNotes += (
                "removed the link $path that $planter created; it pointed at " +
                $(if ([string]::IsNullOrEmpty($target)) { 'an unreadable target' } else { $target }) +
                ', which was neither followed nor changed'
            )
            continue
        }
        $quarantine = '{0}.untrusted-{1}-{2}' -f $path,
            [DateTime]::UtcNow.ToString('yyyyMMddTHHmmssZ'),
            [Guid]::NewGuid().ToString('N').Substring(0, 8)
        try {
            if ($item.PSIsContainer) {
                [IO.Directory]::Move($path, $quarantine)
            }
            else {
                [IO.File]::Move($path, $quarantine)
            }
        }
        catch {
            throw (
                "root_squatted: $path $cause, and could not " +
                "be moved aside ($($_.Exception.Message)); retry after the owning user signs out, or " +
                'have an administrator remove it'
            )
        }
        if (Microsoft.PowerShell.Management\Test-Path -LiteralPath $path) {
            throw "root_squatted: $path was re-created while DefenseClaw moved an untrusted copy aside"
        }
        $script:DefenseClawQuarantinedRoots += $quarantine
        $kind = if ($item.PSIsContainer) { 'folder' } else { 'file' }
        $script:DefenseClawSquattedRootNotes += (
            "moved the $kind $path that $planter created aside to $quarantine, with its content; " +
            'review it and remove it (Remove-Item -LiteralPath "' + $quarantine + '" -Recurse -Force)'
        )
    }
}

# What Install did with each squatted root, for the result.
$script:DefenseClawSquattedRootNotes = @()

function Format-DefenseClawSquattedRootCause {
    # Why a squatted root is refused, naming the account that created it
    # (Get-DefenseClawSquattedRootPlanter) rather than a bare SID or a
    # category.
    param(
        [Parameter(Mandatory)][object]$Entry,
        [string]$Planter = ''
    )
    if ([string]::IsNullOrEmpty($Planter)) {
        $Planter = Get-DefenseClawSquattedRootPlanter -Path ([string]$Entry.path)
    }
    switch ([string]$Entry.owner) {
        'not a plain directory' {
            return "is a link or file that $Planter created, not a plain directory an administrator owns"
        }
        'unreadable security descriptor' {
            return "has a security descriptor DefenseClaw could not check (created by $Planter)"
        }
        default {
            return "is owned by $Planter, not an administrator"
        }
    }
}

function Get-DefenseClawSquattedRootPlanter {
    # The owner of a squatted path itself (a folder, a file, or a junction or
    # symbolic link, opened as the link and never followed), as an account
    # name next to its SID; the SID alone when the name does not resolve.
    # Read before the path is removed or moved. The generic phrase is only
    # for a path whose security descriptor cannot be opened at all: the
    # managed-directory snapshot used here before refuses a reparse point,
    # so every planted link was reported with no account (GAP-0618).
    param([Parameter(Mandatory)][string]$Path)
    try {
        $nativeSecurity = Initialize-DefenseClawNativeSecurity
        $descriptor = [byte[]]$nativeSecurity::GetPathSecurityDescriptorNoFollow($Path)
        $owner = [Security.AccessControl.RawSecurityDescriptor]::new($descriptor, 0).Owner
        if ($null -eq $owner) {
            return 'an unknown account'
        }
        try {
            return '{0} ({1})' -f $owner.Translate([Security.Principal.NTAccount]).Value, $owner.Value
        }
        catch {
            return $owner.Value
        }
    }
    catch {
        return 'an account DefenseClaw could not read'
    }
}

function Test-DefenseClawProfileDeploymentRecordTrusted {
    <#
        A deployment record counts only when an administrator could have
        written it: no reparse point on its path, the file and every ancestor
        below ProgramData owned by SYSTEM, Administrators, or TrustedInstaller,
        no other principal able to write the file, and none able to replace an
        ancestor. The default ProgramData ACL lets a standard user create the
        other profile's vendor directory, so a record that fails this test was
        not written by a DefenseClaw lifecycle and is ignored rather than
        trusted to block an administrator lifecycle.
    #>
    param([Parameter(Mandatory)][string]$Path)
    try {
        Assert-DefenseClawNoReparsePath -Path $Path
        # Strict: the AIFW-34262 advisory downgrade lets an install proceed
        # under AVC-owned ancestor ACLs, but it must not turn a record a
        # standard user could plant into evidence of the other profile.
        Assert-DefenseClawTrustedAncestors `
            -Path ([IO.Path]::GetDirectoryName($Path)) `
            -RequiredBase $script:ProgramData `
            -Strict
        Assert-DefenseClawPathAcl `
            -Path $Path `
            -AllowedWriterSIDs @(
                $script:SystemSID,
                $script:AdministratorsSID,
                $script:TrustedInstallerSID
            ) `
            -AllowInheritance
        return $true
    }
    catch {
        return $false
    }
}

function Test-DefenseClawProfileDeploymentInstalled {
    <#
        Reports whether a profile's deployment metadata records an installed
        deployment. An uninstall tombstone (installed=false) is not a
        deployment; metadata that cannot be read or parsed is treated as one,
        so a damaged record never lets the other profile adopt the services.
        An administrator (every mutation caller) honors only a record an
        administrator could have written; a record a standard user planted is
        reported as absent with untrusted=$true.
    #>
    param(
        [Parameter(Mandatory)]
        [ValidateSet('SecureClient', 'Standalone')]
        [string]$EnterpriseProfile
    )
    $roots = Get-DefenseClawProfileRoots -EnterpriseProfile $EnterpriseProfile
    $metadataPath = [IO.Path]::Combine(
        [string]$roots.StateRoot,
        'install',
        'deployment.json'
    )
    if (-not (Microsoft.PowerShell.Management\Test-Path `
            -LiteralPath $metadataPath `
            -PathType Leaf)) {
        return [pscustomobject]@{ installed = $false; path = $metadataPath }
    }
    if ((Test-DefenseClawAdministrator) -and
        -not (Test-DefenseClawProfileDeploymentRecordTrusted -Path $metadataPath)) {
        return [pscustomobject]@{
            installed = $false
            path = $metadataPath
            untrusted = $true
        }
    }
    $installed = $true
    try {
        $metadata = Microsoft.PowerShell.Management\Get-Content `
            -LiteralPath $metadataPath `
            -Raw | Microsoft.PowerShell.Utility\ConvertFrom-Json
        $installed = Test-DefenseClawMetadataInstalled -Metadata $metadata
    }
    catch {
        $installed = $true
    }
    return [pscustomobject]@{ installed = [bool]$installed; path = $metadataPath }
}

function Assert-DefenseClawNoOtherProfileDeployment {
    <#
        Profiles share the SCM service names, so one host carries at most one
        enterprise deployment. A standalone mutation refuses while an
        installed Secure Client deployment or its credential broker service
        exists; a Secure Client mutation refuses while an installed
        standalone deployment exists. Uninstall tombstones do not block.
    #>
    if (-not (Test-DefenseClawStandaloneProfile)) {
        $standalone = Test-DefenseClawProfileDeploymentInstalled -EnterpriseProfile Standalone
        if ([bool]$standalone.installed) {
            throw (
                'profile_conflict: a standalone DefenseClaw enterprise ' +
                "deployment exists ($($standalone.path)); uninstall it before " +
                'installing the Secure Client profile'
            )
        }
        return
    }
    $secureClient = Test-DefenseClawProfileDeploymentInstalled -EnterpriseProfile SecureClient
    if ([bool]$secureClient.installed) {
        throw (
            'profile_conflict: a Cisco Secure Client DefenseClaw deployment ' +
            "exists ($($secureClient.path)); uninstall it before installing " +
            'the standalone profile'
        )
    }
    if (Test-DefenseClawServiceExists -Name 'DefenseClawCMIDBroker') {
        throw (
            'profile_conflict: the Secure Client credential broker service ' +
            'DefenseClawCMIDBroker exists; uninstall the Secure Client ' +
            'deployment before installing the standalone profile'
        )
    }
}

function Assert-DefenseClawOtherProfileLifecycleIdle {
    <#
        Called while holding this profile's lifecycle lock. Each profile holds
        its own lock for the whole mutation, so probing the other profile's
        lock after taking ours closes the race in which racing installs of the
        two profiles both pass the pre-lock conflict check: whichever takes
        its lock second always sees the first one's lock held. Only a
        protected, administrator-owned lock file is honored, so a standard
        user cannot pre-create one to block administrator lifecycles.
    #>
    $other = if (Test-DefenseClawStandaloneProfile) { 'SecureClient' } else { 'Standalone' }
    $roots = Get-DefenseClawProfileRoots -EnterpriseProfile $other
    $path = [IO.Path]::Combine([string]$roots.LifecycleDirectory, 'lifecycle.lock')
    if (-not (Microsoft.PowerShell.Management\Test-Path -LiteralPath $path -PathType Leaf)) {
        return
    }
    try {
        Assert-DefenseClawNoReparsePath -Path $path
        $adminRights = New-DefenseClawRequiredRights -Kind Admin
        Assert-DefenseClawPathAcl `
            -Path $path `
            -AllowedWriterSIDs @(
                $script:SystemSID,
                $script:AdministratorsSID,
                $script:TrustedInstallerSID
            ) `
            -AllowedReaderSIDs @(
                $script:SystemSID,
                $script:AdministratorsSID,
                $script:TrustedInstallerSID
            ) `
            -RequiredRights $adminRights `
            -RejectUntrustedRead
    }
    catch {
        # Not a lock any DefenseClaw lifecycle created; it cannot serialize
        # anything, so it is ignored rather than trusted to block.
        return
    }
    try {
        $probe = [IO.File]::Open(
            $path,
            [IO.FileMode]::Open,
            [IO.FileAccess]::ReadWrite,
            [IO.FileShare]::None
        )
        $probe.Dispose()
    }
    catch [IO.IOException] {
        throw (
            "another DefenseClaw enterprise lifecycle mutation holds the protected file lock of the $other profile; " +
            'retry after it completes'
        )
    }
}

function Initialize-DefenseClawStandalonePayloadTrust {
    param(
        [Parameter(Mandatory)]
        [ValidateSet('Authenticode', 'HashPinned')]
        [string]$TrustMode,
        [string]$PayloadManifest,
        [string[]]$AllowedSigners = @()
    )
    $script:DefenseClawTrustMode = $TrustMode
    $script:DefenseClawPinnedPayloadSHA256 = @{}
    $script:DefenseClawAllowedSignerSHA256 = @()
    foreach ($signer in @($AllowedSigners)) {
        $value = ([string]$signer).Trim().ToLowerInvariant()
        if ([string]::IsNullOrWhiteSpace($value)) {
            continue
        }
        if ($value -cnotmatch '^[0-9a-f]{64}$') {
            throw "allowed signer must be a SHA-256 certificate thumbprint: $signer"
        }
        $script:DefenseClawAllowedSignerSHA256 += $value
    }
    if ($TrustMode -ceq 'Authenticode') {
        if (-not [string]::IsNullOrWhiteSpace($PayloadManifest)) {
            throw '-PayloadManifest applies only to -TrustMode HashPinned'
        }
        return
    }
    if ([string]::IsNullOrWhiteSpace($PayloadManifest)) {
        throw '-TrustMode HashPinned requires -PayloadManifest'
    }
    $manifestPath = Resolve-DefenseClawFullPath -Path $PayloadManifest -MustExist -Leaf
    # The manifest is the trust anchor for every unsigned payload file, so it
    # gets the same protected-source checks as an administrator config.
    [void](Assert-DefenseClawTrustedSource -Path $manifestPath -Label 'payload SHA-256 manifest')
    Assert-DefenseClawNoReparsePath -Path $manifestPath
    $item = Microsoft.PowerShell.Management\Get-Item -LiteralPath $manifestPath -Force
    if ([int64]$item.Length -gt 1048576) {
        throw 'payload SHA-256 manifest exceeds 1 MiB'
    }
    try {
        $document = Microsoft.PowerShell.Management\Get-Content `
            -LiteralPath $manifestPath `
            -Raw | Microsoft.PowerShell.Utility\ConvertFrom-Json
    }
    catch {
        throw "cannot parse payload SHA-256 manifest: $($_.Exception.Message)"
    }
    if ($null -eq $document.PSObject.Properties['schema_version'] -or
        [int]$document.schema_version -ne 1 -or
        $null -eq $document.PSObject.Properties['files']) {
        throw 'payload SHA-256 manifest must be schema_version 1 with a files map'
    }
    foreach ($property in $document.files.PSObject.Properties) {
        $name = [string]$property.Name
        $digest = ([string]$property.Value).Trim().ToLowerInvariant()
        if ($name -cnotmatch '^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$' -or
            $digest -cnotmatch '^[0-9a-f]{64}$') {
            throw "payload SHA-256 manifest has an invalid entry: $name"
        }
        $script:DefenseClawPinnedPayloadSHA256[$name.ToLowerInvariant()] = $digest
    }
    if ($script:DefenseClawPinnedPayloadSHA256.Count -eq 0) {
        throw 'payload SHA-256 manifest pins no files'
    }
}

function Test-DefenseClawStandalonePayloadTrusted {
    <#
        Standalone payload admission for a file whose Authenticode status is
        not Valid (HashPinned), or an extra signer pin on a Valid one.
        Returns $true only when the file is admitted by the standalone trust
        policy; Secure Client never reaches this path.
    #>
    param(
        [Parameter(Mandatory)][string]$Path,
        [Parameter(Mandatory)]$Signature,
        [string]$PinnedName = ''
    )
    if (-not (Test-DefenseClawStandaloneProfile)) {
        return $false
    }
    if ($Signature.Status -eq [Management.Automation.SignatureStatus]::Valid) {
        if (@($script:DefenseClawAllowedSignerSHA256).Count -eq 0) {
            return $true
        }
        if ($null -eq $Signature.SignerCertificate) {
            return $false
        }
        $sha256 = [Security.Cryptography.SHA256]::Create()
        try {
            $thumbprint = ([BitConverter]::ToString(
                $sha256.ComputeHash($Signature.SignerCertificate.RawData)
            )).Replace('-', '').ToLowerInvariant()
        }
        finally {
            $sha256.Dispose()
        }
        return $thumbprint -in @($script:DefenseClawAllowedSignerSHA256)
    }
    if ([string]$script:DefenseClawTrustMode -cne 'HashPinned') {
        return $false
    }
    $leaf = if ([string]::IsNullOrEmpty($PinnedName)) {
        [IO.Path]::GetFileName($Path).ToLowerInvariant()
    }
    else {
        $PinnedName.ToLowerInvariant()
    }
    if (-not $script:DefenseClawPinnedPayloadSHA256.ContainsKey($leaf)) {
        return $false
    }
    $actual = (Microsoft.PowerShell.Utility\Get-FileHash -LiteralPath $Path -Algorithm SHA256).Hash.ToLowerInvariant()
    return $actual -ceq [string]$script:DefenseClawPinnedPayloadSHA256[$leaf]
}

function Initialize-DefenseClawRecordedPayloadTrust {
    <#
        A hash-pinned standalone deployment re-admits its own installed
        payload on later Repair/Verify/Uninstall runs from the protected,
        administrator-owned deployment metadata that recorded each artifact
        digest, so those actions need no second manifest.
    #>
    param(
        [Parameter(Mandatory)]$Metadata,
        [Parameter(Mandatory)][hashtable]$Layout
    )
    $trustProperty = $Metadata.PSObject.Properties['trust_mode']
    if ($null -eq $trustProperty -or [string]$trustProperty.Value -cne 'hash_pinned') {
        return
    }
    if ([string]$script:DefenseClawTrustMode -cne 'HashPinned') {
        $script:DefenseClawTrustMode = 'HashPinned'
    }
    foreach ($property in $Metadata.hashes.PSObject.Properties) {
        $path = Get-DefenseClawArtifactPath -Layout $Layout -Name ([string]$property.Name)
        if ([string]::IsNullOrWhiteSpace([string]$path)) {
            continue
        }
        $leaf = [IO.Path]::GetFileName([string]$path).ToLowerInvariant()
        if (-not $script:DefenseClawPinnedPayloadSHA256.ContainsKey($leaf)) {
            $script:DefenseClawPinnedPayloadSHA256[$leaf] = ([string]$property.Value).ToLowerInvariant()
        }
    }
    # An interrupted transaction may already have installed its own installer
    # and module (rel-1-0-6 GAP-0649): the pair the bootstrap admitted by the
    # transaction's pins. Admit exactly that pair, and only while both files
    # on disk are it, in place of the recorded pair.
    $transactionPins = Get-DefenseClawPendingTransactionLifecyclePins -Layout $Layout
    if ($null -eq $transactionPins) {
        return
    }
    $pair = @(
        @([string]$Layout.InstallerPath, [string]$transactionPins.installer, 'installer'),
        @([string]$Layout.ModulePath, [string]$transactionPins.module, 'module')
    )
    foreach ($entry in $pair) {
        if (-not (Microsoft.PowerShell.Management\Test-Path -LiteralPath $entry[0] -PathType Leaf)) {
            return
        }
        $onDisk = (
            Microsoft.PowerShell.Utility\Get-FileHash -LiteralPath $entry[0] -Algorithm SHA256
        ).Hash.ToLowerInvariant()
        if ($onDisk -cne $entry[1]) {
            return
        }
    }
    foreach ($entry in $pair) {
        $leaf = [IO.Path]::GetFileName($entry[0]).ToLowerInvariant()
        $recorded = $Metadata.hashes.PSObject.Properties[$entry[2]]
        # A payload manifest's pin (Setup) is never replaced.
        if (-not $script:DefenseClawPinnedPayloadSHA256.ContainsKey($leaf) -or
            ($null -ne $recorded -and
                $script:DefenseClawPinnedPayloadSHA256[$leaf] -ceq ([string]$recorded.Value).ToLowerInvariant())) {
            $script:DefenseClawPinnedPayloadSHA256[$leaf] = $entry[1]
        }
    }
    # The CLI the transaction staged right after the pair, by the same rule
    # and only while the file on disk is it: an installed-CLI uninstall runs
    # it as its native cleanup executable (g649 review F4).
    $cliPath = [string]$Layout['CLIPath']
    if ([string]::IsNullOrEmpty([string]$transactionPins.cli) -or
        [string]::IsNullOrWhiteSpace($cliPath) -or
        -not (Microsoft.PowerShell.Management\Test-Path -LiteralPath $cliPath -PathType Leaf)) {
        return
    }
    $cliOnDisk = (
        Microsoft.PowerShell.Utility\Get-FileHash -LiteralPath $cliPath -Algorithm SHA256
    ).Hash.ToLowerInvariant()
    if ($cliOnDisk -cne [string]$transactionPins.cli) {
        return
    }
    $cliLeaf = [IO.Path]::GetFileName($cliPath).ToLowerInvariant()
    $recordedCli = $Metadata.hashes.PSObject.Properties['cli']
    if (-not $script:DefenseClawPinnedPayloadSHA256.ContainsKey($cliLeaf) -or
        ($null -ne $recordedCli -and
            $script:DefenseClawPinnedPayloadSHA256[$cliLeaf] -ceq ([string]$recordedCli.Value).ToLowerInvariant())) {
        $script:DefenseClawPinnedPayloadSHA256[$cliLeaf] = [string]$transactionPins.cli
    }
}

function Get-DefenseClawPendingTransactionLifecyclePins {
    <#
        The installer and module SHA-256 a pending transaction recorded before
        it copied them (Write-DefenseClawTransactionLifecyclePins), or $null
        without a pending transaction, without pins, or when the record is not
        an administrator-only file in this deployment's transactions folder
        (rel-1-0-6 GAP-0649).
    #>
    param([Parameter(Mandatory)][hashtable]$Layout)
    try {
        if (-not (Microsoft.PowerShell.Management\Test-Path -LiteralPath $Layout.PendingPath -PathType Leaf)) {
            return $null
        }
        Assert-DefenseClawNoReparsePath -Path $Layout.PendingPath
        $pending = Microsoft.PowerShell.Management\Get-Content -LiteralPath $Layout.PendingPath -Raw |
            Microsoft.PowerShell.Utility\ConvertFrom-Json
        $snapshot = $pending.PSObject.Properties['snapshot']
        if ($null -eq $snapshot -or [string]::IsNullOrWhiteSpace([string]$snapshot.Value)) {
            return $null
        }
        $transactions = [IO.Path]::GetFullPath([string]$Layout.TransactionsDirectory).TrimEnd('\') + '\'
        $directory = [IO.Path]::GetDirectoryName([IO.Path]::GetFullPath([string]$snapshot.Value))
        if (-not $directory.StartsWith($transactions, [StringComparison]::OrdinalIgnoreCase) -or
            $directory.Length -le $transactions.Length -or
            $directory.Substring($transactions.Length).Contains('\')) {
            return $null
        }
        $path = Microsoft.PowerShell.Management\Join-Path $directory 'lifecycle-pins.json'
        if (-not (Microsoft.PowerShell.Management\Test-Path -LiteralPath $path -PathType Leaf)) {
            return $null
        }
        Assert-DefenseClawNoReparsePath -Path $path
        Assert-DefenseClawPathAcl `
            -Path $path `
            -AllowedWriterSIDs @(
                $script:SystemSID,
                $script:AdministratorsSID,
                $script:TrustedInstallerSID
            ) `
            -AllowedReaderSIDs @(
                $script:SystemSID,
                $script:AdministratorsSID,
                $script:TrustedInstallerSID
            ) `
            -RequiredRights (New-DefenseClawRequiredRights -Kind Admin) `
            -RejectUntrustedRead
        if ([int64](Microsoft.PowerShell.Management\Get-Item -LiteralPath $path -Force).Length -gt 65536) {
            return $null
        }
        $pins = Microsoft.PowerShell.Management\Get-Content -LiteralPath $path -Raw |
            Microsoft.PowerShell.Utility\ConvertFrom-Json
        $schema = $pins.PSObject.Properties['schema_version']
        $installer = $pins.PSObject.Properties['installer']
        $module = $pins.PSObject.Properties['module']
        if ($null -eq $schema -or [string]$schema.Value -cne '1' -or
            $null -eq $installer -or [string]$installer.Value -cnotmatch '^[0-9a-f]{64}$' -or
            $null -eq $module -or [string]$module.Value -cnotmatch '^[0-9a-f]{64}$') {
            return $null
        }
        $cli = $pins.PSObject.Properties['cli']
        $cliDigest = ''
        if ($null -ne $cli) {
            if ([string]$cli.Value -cnotmatch '^[0-9a-f]{64}$') {
                return $null
            }
            $cliDigest = [string]$cli.Value
        }
        return [pscustomobject]@{
            installer = [string]$installer.Value
            module = [string]$module.Value
            cli = $cliDigest
        }
    }
    catch {
        return $null
    }
}

function Add-DefenseClawProductionUninstallNativeCleanupSource {
    <#
        A production uninstall authenticates its deployment metadata under the
        lifecycle lock (after Repair-DefenseClawUninstallAdminFileAcl), not at
        entry. A hash-pinned standalone deployment's payload, the installed
        unsigned defenseclaw.exe included, is admitted by the SHA-256 pins
        that metadata recorded, so those pins are loaded here, from metadata
        that just passed authentication, before the native cleanup executable
        is admitted (GAP-0023). Untrusted or absent metadata loads no pins:
        the executable then needs a valid signature or the caller's own
        payload manifest (Setup /uninstall passes its embedded one). Standalone
        only: Secure Client admitted the executable at entry, as before.
    #>
    param(
        [Parameter(Mandatory)][hashtable]$Sources,
        [Parameter(Mandatory)][hashtable]$Layout,
        [AllowNull()]$Metadata,
        [switch]$MetadataTrusted,
        [string]$NativeCleanupBinary,
        [string]$PayloadManifest,
        [switch]$AllowUnsigned
    )
    if (-not (Test-DefenseClawStandaloneProfile)) {
        return
    }
    if ($MetadataTrusted -and
        $null -ne $Metadata -and
        [string]::IsNullOrWhiteSpace($PayloadManifest)) {
        Initialize-DefenseClawRecordedPayloadTrust `
            -Metadata $Metadata `
            -Layout $Layout
    }
    Add-DefenseClawNativeCleanupSource `
        -Sources $Sources `
        -NativeCleanupBinary $NativeCleanupBinary `
        -AllowUnsigned:$AllowUnsigned
}

# Lists the leftover state an Install found for this deployment, for the log.
function Get-DefenseClawInstallLeftoverState {
    param(
        [Parameter(Mandatory)][hashtable]$Layout,
        [Parameter(Mandatory)][string]$GatewayServiceName,
        [Parameter(Mandatory)][string]$GuardianServiceName
    )
    $found = [Collections.Generic.List[string]]::new()
    foreach ($entry in @(
            @('pending transaction', [string]$Layout.PendingPath),
            @('transaction records', [string]$Layout.TransactionsDirectory),
            @('deployment metadata', [string]$Layout.MetadataPath),
            @('teardown journal', [string]$Layout.ManagedHooksTeardownJournalPath),
            @('lifecycle journal', [string]$Layout.ManagedHooksLifecycleJournalPath),
            @('install rollback receipt', [string]$Layout.InstallRollbackIntentPath),
            @('state purge intent', [string]$Layout.PurgeIntentPath),
            @('contract cleanup receipt', [string]$Layout.ManagedHookContractCleanupReceiptPath),
            @('self-uninstall receipt', [string]$Layout.SelfUninstallReceiptPath),
            @('InstallRoot', [string]$Layout.InstallRoot),
            @('StateRoot', [string]$Layout.StateRoot)
        )) {
        try {
            if (-not [string]::IsNullOrWhiteSpace([string]$entry[1]) -and
                (Microsoft.PowerShell.Management\Test-Path -LiteralPath ([string]$entry[1]))) {
                $found.Add(('{0} at {1}' -f $entry[0], $entry[1]))
            }
        }
        catch {
            $found.Add(('{0} at {1} (unreadable)' -f $entry[0], $entry[1]))
        }
    }
    foreach ($name in @(
            $GatewayServiceName,
            $GuardianServiceName,
            [string]$Layout.BrokerServiceName,
            (Get-DefenseClawEnumeratorServiceName -GuardianServiceName $GuardianServiceName)
        )) {
        if ([string]::IsNullOrWhiteSpace($name)) {
            continue
        }
        $presence = Get-DefenseClawNuclearServicePresence -Name $name
        if ($presence -ne 'absent') {
            $found.Add(('service {0} ({1})' -f $name, $presence))
        }
    }
    return $found.ToArray()
}

# An Install that finds leftover or wedged state it cannot complete - a pending
# transaction whose rollback fails, a receipt, journal or intent that is
# unreadable or inconsistent, a committed tree with extra files or re-applied
# inheritance, stale services - clears this deployment's state through the
# purge helpers and starts again from a clean slate. Every item found and
# everything the purge could not remove is logged for DART. Only this scope's
# roots, services, lifecycle receipts and agent sidecars are touched.
function Invoke-DefenseClawInstallAutoRecovery {
    param(
        [Parameter(Mandatory)][hashtable]$Layout,
        [Parameter(Mandatory)][string]$GatewayServiceName,
        [Parameter(Mandatory)][string]$GuardianServiceName,
        [Parameter(Mandatory)][string]$Reason
    )
    $leftovers = @(Get-DefenseClawInstallLeftoverState `
        -Layout $Layout `
        -GatewayServiceName $GatewayServiceName `
        -GuardianServiceName $GuardianServiceName)
    Write-DefenseClawResilienceEvent -Marker defenseclaw_recover -Fields @{
        stage  = 'install'
        reason = "leftover state stopped the Install; clearing this deployment and starting again: $Reason"
        found  = ($leftovers -join '; ')
    }
    $result = Invoke-DefenseClawNuclearUninstall `
        -Layout @{
            InstallRoot = [IO.Path]::GetFullPath([string]$Layout.InstallRoot).TrimEnd('\')
            StateRoot   = [IO.Path]::GetFullPath([string]$Layout.StateRoot).TrimEnd('\')
        } `
        -GatewayServiceName $GatewayServiceName `
        -GuardianServiceName $GuardianServiceName `
        -LifecycleLockHeld
    foreach ($item in $leftovers) {
        Write-DefenseClawResilienceEvent -Marker defenseclaw_recover -Fields @{
            stage   = 'install'
            cleared = [string]$item
        }
    }
    foreach ($item in @($result.incomplete)) {
        Write-DefenseClawResilienceEvent -Marker defenseclaw_recover -Fields @{
            stage  = 'install'
            reason = "could not clear: $item"
        }
    }
    return $result
}

function Invoke-DefenseClawEnterpriseLifecycle {
    [CmdletBinding()]
    param(
        [Parameter(Mandatory)]
        [ValidateSet('Install', 'Upgrade', 'Repair', 'Reconcile', 'Recover', 'Status', 'Verify', 'Uninstall')]
        [string]$Action,
        [string]$BrokerBinary,
        [string]$ProviderLibrary,
        [string]$GatewayBinary,
        [string]$ACPBinary,
        [string]$HookBinary,
        [string]$SensorHelperBinary,
        [string]$PolicyCompiler,
        [string]$CLIBinary,
        [string]$NativeCleanupBinary,
        [string]$Config,
        [string]$CoworkPackagePath,
        [string]$CoworkSignaturePath,
        [string]$Manifest,
        [ValidateSet('SecureClient', 'Standalone')]
        [string]$EnterpriseProfile = 'SecureClient',
        # Empty selects the exact production roots of -EnterpriseProfile.
        [string]$InstallRoot,
        [string]$StateRoot,
        [string]$GatewayServiceName = 'DefenseClawGateway',
        [string]$GuardianServiceName = 'DefenseClawHookGuardian',
        [string]$CertificationCodexHome,
        [switch]$CoreHardeningCertification,
        [switch]$NoStart,
        [switch]$Purge,
        [switch]$AllowUnsigned,
        [switch]$AttestAgentApplicationControl,
        [switch]$AttestClaudeEffectivePolicy,
        [string]$InstallerSource,
        [string]$ModuleSource,
        [int]$SelfUninstallCallerPID,
        # Retained for command-line compatibility, but rejected before layout
        # resolution until late config publication has an authenticated target
        # runtime preparation and activation transaction.
        [switch]$DeferredConfig,
        # Standalone-only payload trust. Authenticode (default) requires a
        # Valid signature and, when -AllowedSigners is non-empty, a signer
        # whose SHA-256 certificate thumbprint is listed (customer re-signing
        # or publisher pinning). HashPinned accepts an unsigned payload file
        # only when its SHA-256 appears in the administrator-supplied
        # -PayloadManifest. Neither relaxes the certification-only
        # -AllowUnsigned contract.
        [ValidateSet('Authenticode', 'HashPinned')]
        [string]$TrustMode = 'Authenticode',
        [string]$PayloadManifest,
        [string[]]$AllowedSigners = @(),
        [string]$ProductVersion,
        # Standalone: the launching CLI's own protected PowerShell temp folder
        # (install-enterprise.ps1 passes the TEMP it was started with).
        [string]$LauncherTemp,
        # Standalone Uninstall only: remove the deployment without recovering
        # its pending transaction (Setup /uninstall FORCE=1).
        [switch]$Force,
        # Standalone Verify only: the Verify of an ensure that found the
        # deployment compliant also collects old managed runtime generations
        # (Invoke-DefenseClawStandaloneRuntimeGenerationCollect, GAP-0211).
        [switch]$CollectRuntimeGenerations
    )
    $script:ResilienceEvents.Clear()
    $script:FilePrivilegePrerequisitesReported = $false
    $script:MissingFilePrivileges = @()
    Set-DefenseClawEnterpriseProfile -EnterpriseProfile $EnterpriseProfile
    if (-not [string]::IsNullOrWhiteSpace($CoworkPackagePath) -or
        -not [string]::IsNullOrWhiteSpace($CoworkSignaturePath)) {
        if (-not (Test-DefenseClawStandaloneProfile) -or $Action -notin @('Install', 'Upgrade', 'Repair')) {
            throw 'Cowork artifact inputs require standalone Install, Upgrade or Repair'
        }
    }
    if ($Action -eq 'Recover' -and -not (Test-DefenseClawStandaloneProfile)) {
        throw 'Recover is available only to standalone Setup after a timed-out lifecycle'
    }
    $script:DefenseClawLauncherTemp = [string]$LauncherTemp
    $script:DefenseClawRemoveLifecycleLockOnExit = $false
    $script:DefenseClawPurgeBundleLock = $null
    $script:DefenseClawUninstallPurgeUserState = (
        $Action -eq 'Uninstall' -and [bool]$Purge -and (Test-DefenseClawStandaloneProfile)
    )
    $script:DefenseClawVendorLinkExcuse = (
        $Action -eq 'Uninstall' -and (Test-DefenseClawStandaloneProfile)
    )
    # A standalone uninstall also removes the machine state under StateRoot
    # (owner decision 2026-10-01, GAP-1277); -Purge adds each enrolled
    # account's per-user data and binaries (the flag above). The Secure
    # Client profile keeps its state unless -Purge.
    if ($Action -eq 'Uninstall' -and (Test-DefenseClawStandaloneProfile)) {
        $Purge = [switch]$true
    }
    $entryProfileRoots = Get-DefenseClawProfileRoots
    if ([string]::IsNullOrWhiteSpace($InstallRoot)) {
        $InstallRoot = [string]$entryProfileRoots.InstallRoot
    }
    if ([string]::IsNullOrWhiteSpace($StateRoot)) {
        $StateRoot = [string]$entryProfileRoots.StateRoot
    }
    if (Test-DefenseClawStandaloneProfile) {
        Initialize-DefenseClawStandalonePayloadTrust `
            -TrustMode $TrustMode `
            -PayloadManifest $PayloadManifest `
            -AllowedSigners $AllowedSigners
        if ($Action -in @('Install', 'Upgrade', 'Repair') -and
            $GatewayServiceName -ceq 'DefenseClawGateway') {
            Assert-DefenseClawNoOtherProfileDeployment
        }
    }
    elseif ($TrustMode -cne 'Authenticode' -or
        -not [string]::IsNullOrWhiteSpace($PayloadManifest) -or
        @($AllowedSigners | Microsoft.PowerShell.Core\Where-Object {
            -not [string]::IsNullOrWhiteSpace([string]$_)
        }).Count -gt 0 -or
        -not [string]::IsNullOrWhiteSpace($ProductVersion)) {
        throw 'payload trust modes, allowed signers, and product version recording apply only to the standalone profile'
    }
    elseif ($Action -in @('Install', 'Upgrade', 'Repair') -and
        $GatewayServiceName -ceq 'DefenseClawGateway') {
        # The profiles share SCM service names. A host that carries a
        # standalone deployment must not be adopted by the Secure Client
        # lifecycle; on every other host this check is a no-op.
        Assert-DefenseClawNoOtherProfileDeployment
    }
    Assert-DefenseClawServiceName -Name $GatewayServiceName
    Assert-DefenseClawServiceName -Name $GuardianServiceName
    if ([string]::Equals($GatewayServiceName, $GuardianServiceName, [StringComparison]::OrdinalIgnoreCase)) {
        throw 'gateway and guardian Windows service names must be distinct'
    }
    if ($DeferredConfig -and $Action -ne 'Install') {
        throw '-DeferredConfig is valid only with Install'
    }
    if ($DeferredConfig -and
        ([string]::IsNullOrWhiteSpace($Config) -or
            [string]::IsNullOrWhiteSpace($Manifest))) {
        throw 'deferred Install requires protected placeholder config and manifest inputs'
    }
    $certificationServiceScope = [Text.RegularExpressions.Regex]::IsMatch(
        $GatewayServiceName,
        '^DefenseClawCertGateway_[a-f0-9]{10}$',
        [Text.RegularExpressions.RegexOptions]::CultureInvariant
    )
    $recoverProductionUninstallAcl = [bool](
        $Action -eq 'Uninstall' -and -not $certificationServiceScope
    )
    # The Secure Client nuclear uninstall shortcut keeps its historical
    # behavior. Standalone purge must use the authenticated transaction:
    # bypassing it removed the hook registrations before an interrupted
    # uninstall could be recovered.
    # The ordinary pre-layout recovery (Invoke-DefenseClawPreLayoutRecovery)
    # runs forensic-grade native descriptor checks on sibling scoped
    # install roots before the main uninstall lifecycle even starts; a
    # corrupted sibling from a prior test cycle hangs the recovery with
    # "Windows namespace purge object has a foreign descriptor". The
    # nuclear path intentionally skips that check and tears down the
    # current scope + agent-config residue via takeown + icacls /reset
    # + Remove-Item. Strict mode
    # (DEFENSECLAW_MANAGED_TRUST_STRICT_ANCESTORS=1) restores the full
    # forensic pipeline for hardened production deployments.
    #
    # Route to nuclear ONLY when both roots are inside the real managed-
    # mode safe-root scope. The PowerShell smoke-test harness uses temp
    # paths like C:\Users\<runner>\AppData\...\DefenseClaw-PowerShellSmoke
    # for isolation; those are not production/certification installs and
    # must stay on the regular validator path so smoke tests can observe
    # the authenticated teardown they are written for.
    $nuclearSafeRootPattern = Get-DefenseClawNuclearSafeRootPattern
    # Canonicalize both roots before matching the safe-root pattern.
    # A raw-string regex over the caller-supplied path accepts
    # traversal segments ("..\..") that still LITERALLY match the
    # pattern but resolve to a path outside the Cisco scope - which
    # the nuclear teardown would then takeown/icacls/remove-item.
    # [IO.Path]::GetFullPath normalizes "..", ".", redundant
    # separators, and alt-separators into the canonical absolute
    # path. Pass the canonicalized values through to the nuclear
    # function so the function body operates on the same shape the
    # safe-root check saw.
    $nuclearInstallRoot = if ([string]::IsNullOrWhiteSpace($InstallRoot)) {
        $InstallRoot
    }
    else {
        [IO.Path]::GetFullPath($InstallRoot).TrimEnd('\')
    }
    $nuclearStateRoot = if ([string]::IsNullOrWhiteSpace($StateRoot)) {
        $StateRoot
    }
    else {
        [IO.Path]::GetFullPath($StateRoot).TrimEnd('\')
    }
    if ($Action -eq 'Uninstall' -and $Purge -and
        -not (Test-DefenseClawStandaloneProfile) -and
        -not (Test-DefenseClawTrustStrictAncestors) -and
        $nuclearInstallRoot -match $nuclearSafeRootPattern -and
        $nuclearStateRoot   -match $nuclearSafeRootPattern) {
        Write-DefenseClawFilePrivilegePrerequisites
        return Invoke-DefenseClawNuclearUninstall `
            -Layout @{
                InstallRoot = $nuclearInstallRoot
                StateRoot   = $nuclearStateRoot
            } `
            -GatewayServiceName $GatewayServiceName `
            -GuardianServiceName $GuardianServiceName
    }
    # Install recovers by itself from leftover state of this deployment (see
    # Invoke-DefenseClawInstallAutoRecovery). Only an Install whose roots are
    # the real managed roots, outside the strict pin, and never over a live
    # deployment, which Upgrade, Repair and Reconcile repair instead.
    $installAutoRecoveryEligible = [bool](
        $Action -eq 'Install' -and
        -not (Test-DefenseClawStandaloneProfile) -and
        -not (Test-DefenseClawTrustStrictAncestors) -and
        $nuclearInstallRoot -match $nuclearSafeRootPattern -and
        $nuclearStateRoot -match $nuclearSafeRootPattern
    )
    $installLiveDeployment = $false
    $installRecoveryReason = ''
    $preLockMetadata = $null
    if ($certificationServiceScope -and
        $Action -in @('Install', 'Upgrade', 'Repair') -and
        -not $AllowUnsigned) {
        throw (
            'certification-scoped Install, Upgrade, or Repair requires ' +
            '-AllowUnsigned'
        )
    }
    $resolvedCertificationCodexHome = Resolve-DefenseClawCertificationCodexHome `
        -Path $CertificationCodexHome `
        -GatewayServiceName $GatewayServiceName `
        -GuardianServiceName $GuardianServiceName `
        -AllowMissing:($Action -in @('Status', 'Verify', 'Recover'))
    if ($Purge -and $Action -ne 'Uninstall') {
        throw '-Purge is valid only with Uninstall'
    }
    if ($Force -and ($Action -ne 'Uninstall' -or -not (Test-DefenseClawStandaloneProfile))) {
        throw '-Force is valid only with a standalone Uninstall'
    }
    if ($CollectRuntimeGenerations -and ($Action -ne 'Verify' -or -not (Test-DefenseClawStandaloneProfile))) {
        throw '-CollectRuntimeGenerations is valid only with a standalone Verify'
    }
    if ($SelfUninstallCallerPID -lt 0 -or
        ($SelfUninstallCallerPID -gt 0 -and $Action -ne 'Uninstall')) {
        throw '-SelfUninstallCallerPID is valid only as a positive PID with Uninstall'
    }
    if ($NoStart -and $Action -notin @('Install', 'Upgrade', 'Repair')) {
        throw '-NoStart is valid only with Install, Upgrade, or Repair'
    }
    if ($CoreHardeningCertification -and
        $Action -notin @('Install', 'Upgrade', 'Repair', 'Recover')) {
        throw '-CoreHardeningCertification is valid only with Install, Upgrade, Repair, or Recover'
    }
    if (-not [string]::IsNullOrWhiteSpace($resolvedCertificationCodexHome) -and
        -not $AllowUnsigned) {
        throw '-CertificationCodexHome requires -AllowUnsigned for every lifecycle action'
    }
    if ($CoreHardeningCertification -and
        (-not $AllowUnsigned -or
            [string]::IsNullOrWhiteSpace($resolvedCertificationCodexHome))) {
        throw '-CoreHardeningCertification requires -AllowUnsigned and -CertificationCodexHome'
    }
    if ($AttestAgentApplicationControl -and
        $Action -notin @('Install', 'Upgrade', 'Repair')) {
        throw '-AttestAgentApplicationControl is valid only with Install, Upgrade, or Repair'
    }
    if ($AttestClaudeEffectivePolicy -and
        $Action -notin @('Install', 'Upgrade', 'Repair')) {
        throw '-AttestClaudeEffectivePolicy is valid only with Install, Upgrade, or Repair'
    }
    if ($CoreHardeningCertification -and
        ($AttestAgentApplicationControl -or
            $AttestClaudeEffectivePolicy)) {
        throw (
            '-CoreHardeningCertification cannot be combined with production ' +
            'application-control or Claude-policy attestations'
        )
    }
    if ($Action -ne 'Status') {
        Assert-DefenseClawAdministrator
        Write-DefenseClawFilePrivilegePrerequisites
    }
    $script:DefenseClawQuarantinedRoots = @()
    $script:DefenseClawSquattedRootNotes = @()
    $script:DefenseClawTerminatedServiceProcesses = @()
    $script:DefenseClawSkippedRuntimeFiles = @()
    Set-DefenseClawRecoveryGatewayCandidate `
        -GatewayBinary $GatewayBinary `
        -InstallerSource $InstallerSource `
        -AllowUnsigned:$AllowUnsigned
    if ((Test-DefenseClawStandaloneProfile) -and
        $GatewayServiceName -ceq 'DefenseClawGateway' -and
        [string]::Equals($InstallRoot.TrimEnd('\'), [string]$entryProfileRoots.InstallRoot, [StringComparison]::OrdinalIgnoreCase) -and
        [string]::Equals($StateRoot.TrimEnd('\'), [string]$entryProfileRoots.StateRoot, [StringComparison]::OrdinalIgnoreCase) -and
        (Test-DefenseClawAdministrator)) {
        # A root a standard user created first would otherwise fail every
        # retry with a generic untrusted-owner error. Install moves such a
        # tree aside; every other action names it with a stable code.
        $squattedRoots = @(Get-DefenseClawStandaloneSquattedRoots)
        if ($squattedRoots.Count -gt 0) {
            if ($Action -ceq 'Install') {
                Move-DefenseClawStandaloneSquattedRoots -Squatted $squattedRoots
            }
            else {
                throw (
                    "root_squatted: $($squattedRoots[0].path) $(Format-DefenseClawSquattedRootCause -Entry $squattedRoots[0]); " +
                    'no DefenseClaw deployment can use it. Install (or ensure) moves it aside; ' +
                    'otherwise an administrator must remove it'
                )
            }
        }
    }

    $resolvedInstallRoot = Assert-DefenseClawSafeRoot `
        -Path $InstallRoot `
        -Label 'InstallRoot' `
        -RequiredBase $script:ProgramFiles
    $resolvedStateRoot = Assert-DefenseClawSafeRoot `
        -Path $StateRoot `
        -Label 'StateRoot' `
        -RequiredBase $script:ProgramData
    Assert-DefenseClawDistinctRoots `
        -InstallRoot $resolvedInstallRoot `
        -StateRoot $resolvedStateRoot
    if ($AllowUnsigned) {
        Assert-DefenseClawUnsignedCertificationScope `
            -Action $Action `
            -InstallRoot $resolvedInstallRoot `
            -StateRoot $resolvedStateRoot `
            -GatewayServiceName $GatewayServiceName `
            -GuardianServiceName $GuardianServiceName `
            -CertificationCodexHome $resolvedCertificationCodexHome
    }
    $layout = Get-DefenseClawLayout `
        -InstallRoot $resolvedInstallRoot `
        -StateRoot $resolvedStateRoot `
        -GatewayServiceName $GatewayServiceName `
        -GuardianServiceName $GuardianServiceName `
        -CertificationCodexHome $resolvedCertificationCodexHome `
        -CoreHardeningCertification:$CoreHardeningCertification `
        -AgentApplicationControlAttested:$AttestAgentApplicationControl
    if (Test-DefenseClawStandaloneProfile) {
        $layout.ProductVersion = [string]$ProductVersion
    }
    $installLayoutArguments = @{
        InstallRoot                     = $resolvedInstallRoot
        StateRoot                       = $resolvedStateRoot
        GatewayServiceName              = $GatewayServiceName
        GuardianServiceName             = $GuardianServiceName
        CertificationCodexHome          = $resolvedCertificationCodexHome
        CoreHardeningCertification      = [bool]$CoreHardeningCertification
        AgentApplicationControlAttested = [bool]$AttestAgentApplicationControl
    }

    # Keep the authoritative current/global/GUID drive identity adjacent to
    # the first managed metadata read, not only to caller argument parsing.
    Assert-DefenseClawLayoutVolumeIdentity `
        -Layout $layout `
        -GatewayServiceName $GatewayServiceName `
        -GuardianServiceName $GuardianServiceName `
        -AllowMissingCertificationCodexHome:($Action -in @('Status', 'Verify', 'Recover'))
    if ((Test-DefenseClawDeploymentMetadataPresent -Path $layout.MetadataPath) -and
        ($Action -ne 'Status' -or (Test-DefenseClawAdministrator)) -and
        -not $recoverProductionUninstallAcl) {
        # Protected metadata, not a caller-supplied certification path, is the
        # authority for continuing an existing core-hardening certification
        # deployment. Repair rebuilds an unreadable one under the lock; an
        # Install eligible for auto-recovery records it and clears it below.
        try {
            $entryMetadata = Get-DefenseClawDeploymentMetadata -Layout $layout
            if ($null -eq $entryMetadata -and $installAutoRecoveryEligible) {
                # The file exists but its reader gave up after its own
                # recovery; take the same registered-service check as a read
                # that throws, so this cannot purge a live deployment.
                throw "deployment metadata is unreadable: $($layout.MetadataPath)"
            }
            $preLockMetadata = $entryMetadata
            $installLiveDeployment = [bool](
                $null -ne $entryMetadata -and
                (Test-DefenseClawMetadataInstalled -Metadata $entryMetadata)
            )
        }
        catch {
            $metadataError = $_
            $entryMetadata = $null
            if ($installAutoRecoveryEligible) {
                # Unreadable metadata cannot say whether the deployment is
                # live. A registered Gateway or Guardian, running or not,
                # says it may be: the Install stops here and leaves it in
                # place rather than purging it, as Install did before it
                # recovered by itself. Upgrade and Repair heal it; Uninstall
                # clears it. The checked probe reports absence only on Win32
                # 1060; a query SCM refuses counts as present, so a hardened
                # service descriptor can never lead to a purge.
                foreach ($liveService in @($GatewayServiceName, $GuardianServiceName)) {
                    $serviceRegistered = $true
                    try {
                        $serviceRegistered = Test-DefenseClawServiceExists -Name $liveService
                    }
                    catch {
                        $serviceRegistered = $true
                    }
                    if ($serviceRegistered) {
                        $installLiveDeployment = $true
                        throw $metadataError
                    }
                }
                $installRecoveryReason = "deployment metadata: $($metadataError.Exception.Message)"
            }
            elseif ($Action -ne 'Repair' -or
                -not ([string]$metadataError.Exception.Message).StartsWith(
                    $script:UnreadableMetadataMessage,
                    [StringComparison]::Ordinal)) {
                throw
            }
        }
        if ((Test-DefenseClawStandaloneProfile) -and
            $null -ne $entryMetadata -and
            [string]::IsNullOrWhiteSpace($PayloadManifest)) {
            Initialize-DefenseClawRecordedPayloadTrust `
                -Metadata $entryMetadata `
                -Layout $layout
        }
    }
    $applicationControlAttestationExists = Microsoft.PowerShell.Management\Test-Path `
        -LiteralPath $layout.AgentApplicationControlAttestationPath `
        -PathType Leaf
    if ($applicationControlAttestationExists -and
        ($Action -ne 'Status' -or (Test-DefenseClawAdministrator)) -and
        -not $recoverProductionUninstallAcl -and
        [string]::IsNullOrEmpty($installRecoveryReason)) {
        try {
            $existingApplicationControlAttestation =
                Get-DefenseClawAgentApplicationControlAttestation -Layout $layout
            $layout.AgentApplicationControlAttested = [bool](
                $existingApplicationControlAttestation.agent_application_control_enforced
            )
            $layout.ClaudeEffectivePolicyVerified = [bool](
                $existingApplicationControlAttestation.claude_effective_policy_verified
            )
            if (Test-DefenseClawStandaloneProfile) {
                $layout['ClaudeEffectivePolicyStaleReason'] = [string](
                    $existingApplicationControlAttestation.claude_effective_policy_stale_reason
                )
            }
        }
        catch {
            if (-not $installAutoRecoveryEligible -or $installLiveDeployment) {
                throw
            }
            $installRecoveryReason = "application-control attestation: $($_.Exception.Message)"
        }
    }
    if ($AttestAgentApplicationControl) {
        if ([bool]$layout.CoreHardeningCertification) {
            throw '-AttestAgentApplicationControl is forbidden in core-hardening certification mode'
        }
        $layout.AgentApplicationControlAttested = $true
    }
    if ($AttestClaudeEffectivePolicy) {
        if ([bool]$layout.CoreHardeningCertification) {
            throw '-AttestClaudeEffectivePolicy is forbidden in core-hardening certification mode'
        }
        $layout.ClaudeEffectivePolicyVerified = $true
        # A fresh live proof supersedes recorded evidence for another
        # Claude policy identity.
        if (Test-DefenseClawStandaloneProfile) {
            $layout['ClaudeEffectivePolicyStaleReason'] = ''
        }
    }
    if ($Action -eq 'Status') {
        Assert-DefenseClawLayoutVolumeIdentity `
            -Layout $layout `
            -GatewayServiceName $GatewayServiceName `
            -GuardianServiceName $GuardianServiceName `
            -AllowMissingCertificationCodexHome
        return Get-DefenseClawLifecycleStatus `
            -Action $Action `
            -Layout $layout `
            -GatewayServiceName $GatewayServiceName `
            -GuardianServiceName $GuardianServiceName
    }
    if ($Action -eq 'Verify') {
        Assert-DefenseClawLayoutVolumeIdentity `
            -Layout $layout `
            -GatewayServiceName $GatewayServiceName `
            -GuardianServiceName $GuardianServiceName `
            -AllowMissingCertificationCodexHome
        if (Microsoft.PowerShell.Management\Test-Path -LiteralPath $layout.PendingPath -PathType Leaf) {
            throw 'cannot verify while a lifecycle transaction is pending; run Repair'
        }
        Assert-DefenseClawEnterpriseDeployment `
            -Layout $layout `
            -GatewayServiceName $GatewayServiceName `
            -GuardianServiceName $GuardianServiceName `
            -RequireReadiness
        if ($CollectRuntimeGenerations) {
            Invoke-DefenseClawStandaloneRuntimeGenerationCollect `
                -Layout $layout `
                -GatewayServiceName $GatewayServiceName
        }
        return Get-DefenseClawLifecycleStatus `
            -Action $Action `
            -Layout $layout `
            -GatewayServiceName $GatewayServiceName `
            -GuardianServiceName $GuardianServiceName
    }

    Assert-DefenseClawAdministrator
    if ($Action -ne 'Install' -and
        -not ($Action -eq 'Uninstall' -and $Purge) -and
        -not (Microsoft.PowerShell.Management\Test-Path `
            -LiteralPath $resolvedStateRoot `
            -PathType Container)) {
        throw "$Action requires an existing managed StateRoot: $resolvedStateRoot"
    }
    # A production uninstall skips the entry metadata read above, so a
    # hash-pinned standalone deployment's recorded pins are not loaded yet.
    # Its native cleanup executable (the installed, unsigned defenseclaw.exe)
    # is admitted under the lifecycle lock instead, once the metadata is
    # authenticated (GAP-0023); admitting it here would judge it by
    # Authenticode alone and refuse it. Secure Client still admits it here,
    # as before (Secure Client is out of scope for this fix).
    $entryNativeCleanupBinary = if ($recoverProductionUninstallAcl -and
        (Test-DefenseClawStandaloneProfile)) {
        ''
    }
    else {
        $NativeCleanupBinary
    }
    $sources = Get-DefenseClawLifecycleSources `
        -Action $Action `
        -BrokerBinary $BrokerBinary `
        -ProviderLibrary $ProviderLibrary `
        -GatewayBinary $GatewayBinary `
        -ACPBinary $ACPBinary `
        -HookBinary $HookBinary `
        -SensorHelperBinary $SensorHelperBinary `
        -PolicyCompiler $PolicyCompiler `
        -CLIBinary $CLIBinary `
        -NativeCleanupBinary $entryNativeCleanupBinary `
        -Config $Config `
        -Manifest $Manifest `
        -InstallerSource $InstallerSource `
        -ModuleSource $ModuleSource `
        -AllowUnsigned:$AllowUnsigned `
        -DeferredConfig:$DeferredConfig
    $script:DefenseClawOwnerRightsSource = $null
    $script:DefenseClawOwnerRightsRestored = $false
    if ((Test-DefenseClawStandaloneProfile) -and $sources.ContainsKey('gateway')) {
        $script:DefenseClawOwnerRightsSource = [hashtable]$sources['gateway']
    }

    # Secure creation is race-safe and validates every existing ancestor
    # before the first lifecycle coordination object is opened. The lock then
    # lives in a protected ProgramData directory, so an unprivileged process
    # cannot precreate or hold a competing object as it could with Global\.
    Assert-DefenseClawLayoutVolumeIdentity `
        -Layout $layout `
        -GatewayServiceName $GatewayServiceName `
        -GuardianServiceName $GuardianServiceName
    Assert-DefenseClawLifecycleSourcesCurrent -Sources $sources
    $standaloneFleetStateKnown = $false
    $standaloneFleetEnabled = $false
    if ($Action -in @('Install', 'Upgrade', 'Repair') -and
        $sources.ContainsKey('gateway')) {
        if (Test-DefenseClawStandaloneProfile) {
            # Deferred Install publishes placeholders with services stopped;
            # Repair later supplies the real config and performs Fleet opt-in.
            if (-not $DeferredConfig) {
                $standaloneFleetEnabled = Test-DefenseClawStandaloneFleetSourceEnabled `
                    -Layout $layout `
                    -Sources $sources
                $standaloneFleetStateKnown = $true
                if ($standaloneFleetEnabled) {
                    if (-not [string]::IsNullOrWhiteSpace($PolicyCompiler)) {
                        Add-DefenseClawStandaloneFleetCompilerSource `
                            -Sources $sources `
                            -PolicyCompiler $PolicyCompiler `
                            -AllowUnsigned:$AllowUnsigned
                    }
                    elseif ([string]::IsNullOrEmpty((Get-DefenseClawRecordedStandaloneCompilerPath -Layout $layout))) {
                        # GAP-0274: Setup carries no compiler. It keeps the
                        # recorded compiler of a Fleet-enabled 1.0.2 install
                        # in place, unchanged, and installs none.
                        throw ('Fleet-enabled standalone Setup carries no Fleet policy compiler and this host has no recorded one to keep; turn Fleet off in the config, then ' + (Format-DefenseClawRerunStep) + ' with that config')
                    }
                }
            }
        }
        # Secure Client keeps its 1.0.1 lifecycle with no Fleet step: the
        # gateway refuses a Secure Client config with fleet.enabled when it
        # loads it (resolveEnterpriseConfig).
    }
    # Before the lock only without a record to recover: its recovery, after
    # the lock, can change the deployment record, and the check after it
    # decides (Test-DefenseClawPreLayoutRecoveryPending).
    if ($Action -eq 'Install' -and $DeferredConfig -and
        (Test-DefenseClawStandaloneProfile) -and
        -not (Test-DefenseClawPreLayoutRecoveryPending -Layout $layout)) {
        Assert-DefenseClawDeferredInstallIsFresh -Layout $layout
    }
    Initialize-DefenseClawManagedRoot `
        -Path $layout.LifecycleLockDirectory `
        -Label 'lifecycle lock directory' `
        -RequiredBase $script:ProgramData
    $lifecycleLock = Enter-DefenseClawLifecycleLock -Layout $layout
    # The vendor folders DefenseClaw touched, before an uninstall removes its
    # files (GAP-0704 rule i, review 3 L4).
    $touchedVendorFolders = [string[]]@()
    if ($Action -ceq 'Uninstall' -and (Test-DefenseClawStandaloneProfile)) {
        try {
            $touchedVendorFolders = [string[]]@(Get-DefenseClawTouchedUnrecordedVendorFolders)
        }
        catch {
            Microsoft.PowerShell.Utility\Write-Verbose "touched vendor folders not listed: $($_.Exception.Message)"
        }
    }
    try {
        # Revalidate current/global/GUID drive identity after the bounded lock
        # wait, before any filesystem or SCM mutation. Source descriptors are
        # rebound here and again immediately before each atomic source copy.
        Assert-DefenseClawLayoutVolumeIdentity `
            -Layout $layout `
            -GatewayServiceName $GatewayServiceName `
            -GuardianServiceName $GuardianServiceName `
            -AllowMissingCertificationCodexHome:($Action -eq 'Recover')
        Assert-DefenseClawLifecycleSourcesCurrent -Sources $sources
        if ($standaloneFleetStateKnown) {
            $recheckedFleetEnabled = Test-DefenseClawStandaloneFleetSourceEnabled `
                -Layout $layout `
                -Sources $sources
            if ($recheckedFleetEnabled -ne $standaloneFleetEnabled) {
                throw 'standalone Fleet enablement changed while waiting for the lifecycle lock'
            }
        }
        # The profiles share SCM service names but keep separate lifecycle
        # locks. While holding this profile's lock, refuse if the other
        # profile's lifecycle is mid-mutation, and repeat the deployment
        # conflict check that ran before the lock wait. On a host with no
        # footprint of the other profile both checks are no-ops.
        Assert-DefenseClawOtherProfileLifecycleIdle
        if ($Action -eq 'Recover') {
            # Setup's original child is gone. Reuse the protected pending
            # journal under the same lifecycle lock, then stop: starting a
            # second install here could time out and stop the services again.
            return Invoke-DefenseClawTimeoutRecovery `
                -Layout $layout `
                -GatewayServiceName $GatewayServiceName `
                -GuardianServiceName $GuardianServiceName
        }
        if ($Action -eq 'Uninstall' -and $Purge -and (Test-DefenseClawStandaloneProfile)) {
            # The uninstall removes StateRoot: hold bundle.lock too, in the
            # order no bundle run inverts for long (GAP-2438).
            $script:DefenseClawPurgeBundleLock = Enter-DefenseClawBundleStoreLock -Layout $layout
        }
        if ($Action -in @('Install', 'Upgrade', 'Repair') -and
            $GatewayServiceName -ceq 'DefenseClawGateway') {
            Assert-DefenseClawNoOtherProfileDeployment
        }
        if ($Action -eq 'Repair' -and (Test-DefenseClawStandaloneProfile)) {
            Assert-DefenseClawRepairRollbackConfig `
                -Layout $layout `
                -Sources $sources `
                -GatewayServiceName $GatewayServiceName
            [void](Repair-DefenseClawUnreadableDeploymentMetadata `
                -Layout $layout `
                -Sources $sources `
                -GatewayServiceName $GatewayServiceName `
                -GuardianServiceName $GuardianServiceName)
        }

        if ($Action -eq 'Install') {
            # Pending and pre-layout recovery can restore shared hooks. Reject
            # an active foreign owner before entering either recovery path.
            Assert-DefenseClawInstallSharedHookScopeExclusive `
                -Layout $layout `
                -GatewayServiceName $GatewayServiceName `
                -GuardianServiceName $GuardianServiceName
        }

        if ($recoverProductionUninstallAcl) {
            $untrustedEvidenceReason = ''
            $uninstallMetadataExists = $false
            # p0-round:GAP-1365, GAP-1585: set only where deployment.json is
            # absent from an existing admin-only StateRoot (a first install
            # killed before it wrote the record). A record that is present
            # but fails authentication never sets it.
            $uninstallMetadataMissing = $false
            $uninstallMetadata = $null
            try {
                # Authenticate ownership and repair only recoverable ACL
                # drift under the lifecycle lock, before trusting metadata.
                $uninstallMetadataExists = Repair-DefenseClawUninstallAdminFileAcl `
                    -Layout $layout `
                    -Kind deployment
                if ($uninstallMetadataExists) {
                    $uninstallMetadata = Get-DefenseClawDeploymentMetadata `
                        -Layout $layout `
                        -Required
                }
            }
            catch {
                if (-not $Purge) {
                    throw
                }
                $untrustedEvidenceReason = $_.Exception.Message
            }
            if (-not $uninstallMetadataExists -and $Purge -and
                [string]::IsNullOrWhiteSpace($untrustedEvidenceReason)) {
                # Test-Path can misreport an ACL-denied StateRoot as absent.
                # Probe its exact inode before choosing the state-absent path.
                $nativeSecurity = Initialize-DefenseClawNativeSecurity
                $stateRootBefore =
                    $nativeSecurity::GetDirectorySecuritySnapshotNoFollowIfExists(
                        [string]$layout.StateRoot
                    )
                if ($null -ne $stateRootBefore) {
                    $untrustedEvidenceReason =
                        'deployment.json is missing from an existing StateRoot'
                    $uninstallMetadataMissing = Test-DefenseClawForcedUninstallStateRootAdminOnly `
                        -Layout $layout
                }
            }
            Add-DefenseClawProductionUninstallNativeCleanupSource `
                -Sources $sources `
                -Layout $layout `
                -Metadata $(if ($uninstallMetadataExists) { $uninstallMetadata } else { $null }) `
                -MetadataTrusted:([string]::IsNullOrWhiteSpace($untrustedEvidenceReason)) `
                -NativeCleanupBinary $NativeCleanupBinary `
                -PayloadManifest $PayloadManifest `
                -AllowUnsigned:$AllowUnsigned
            if (Test-DefenseClawUninstallUsesUntrustedMetadataPurge `
                    -Reason $untrustedEvidenceReason `
                    -MetadataMissing $uninstallMetadataMissing `
                    -Force:$Force) {
                return Invoke-DefenseClawUntrustedMetadataRecoveryPurge `
                    -Layout $layout `
                    -Sources $sources `
                    -GatewayServiceName $GatewayServiceName `
                    -GuardianServiceName $GuardianServiceName `
                    -Reason $untrustedEvidenceReason
            }
            if ($uninstallMetadataExists) {
                # Attestation problems remain distinct from deployment
                # metadata trust failures and must not trigger this fallback.
                $nativeSecurity = Initialize-DefenseClawNativeSecurity
                $attestationSnapshot =
                    $nativeSecurity::GetRegularFileSecuritySnapshotNoFollowIfExists(
                        [string]$layout.AgentApplicationControlAttestationPath
                    )
                if ($null -ne $attestationSnapshot) {
                    $attestationHashProperty = $uninstallMetadata.PSObject.Properties[
                        'agent_application_control_attestation_sha256'
                    ]
                    $attestationHash = if ($null -eq $attestationHashProperty) {
                        ''
                    }
                    else {
                        [string]$attestationHashProperty.Value
                    }
                    if ($attestationHash -cmatch '^[0-9a-f]{64}$') {
                        [void](Repair-DefenseClawUninstallAdminFileAcl `
                            -Layout $layout `
                            -Kind attestation `
                            -ExpectedSHA256 $attestationHash)
                    }
                    # Older metadata did not bind this file by hash. Preserve
                    # its original strict read rather than blessing unknown bytes.
                    $existingApplicationControlAttestation =
                        Get-DefenseClawAgentApplicationControlAttestation `
                            -Layout $layout
                    $layout.AgentApplicationControlAttested = [bool](
                        $existingApplicationControlAttestation.agent_application_control_enforced
                    )
                    $layout.ClaudeEffectivePolicyVerified = [bool](
                        $existingApplicationControlAttestation.claude_effective_policy_verified
                    )
                }
            }
        }

        # An eligible Install that leftover state stops is cleared once
        # through the purge helpers and then runs again from the top of the
        # recovery lanes; any other failure, or a second one, is the result.
        # Only a Secure Client Install is eligible
        # ($installAutoRecoveryEligible).
        $installRecoveryAttempted = $false
        while ($true) {
            if ($installAutoRecoveryEligible -and
                -not $installLiveDeployment -and
                -not $installRecoveryAttempted -and
                -not [string]::IsNullOrEmpty($installRecoveryReason)) {
                $installRecoveryAttempted = $true
                [void](Invoke-DefenseClawInstallAutoRecovery `
                    -Layout $layout `
                    -GatewayServiceName $GatewayServiceName `
                    -GuardianServiceName $GuardianServiceName `
                    -Reason $installRecoveryReason)
                $layout = Get-DefenseClawLayout @installLayoutArguments
                $layout.ClaudeEffectivePolicyVerified = [bool]$AttestClaudeEffectivePolicy
            }
            try {
                # A purge receipt lives outside StateRoot and is authenticated before
                # any managed layout directory is created. It is therefore sufficient
                # authority to resume a crash-interrupted purge after StateRoot itself
                # has been partially or completely deleted.
                if ($Force) {
                    return Invoke-DefenseClawForcedUninstall `
                        -Layout $layout `
                        -Sources $sources `
                        -GatewayServiceName $GatewayServiceName `
                        -GuardianServiceName $GuardianServiceName `
                        -Purge:$Purge `
                        -RequestedCertificationCodexHome $resolvedCertificationCodexHome `
                        -RequestedCoreHardeningCertification:$CoreHardeningCertification `
                        -SelfUninstallCallerPID $SelfUninstallCallerPID
                }
                $preLayoutRecovery = Invoke-DefenseClawPreLayoutRecovery `
                    -Action $Action `
                    -Layout $layout `
                    -Sources $sources `
                    -GatewayServiceName $GatewayServiceName `
                    -GuardianServiceName $GuardianServiceName `
                    -Purge:$Purge `
                    -RequestedCertificationCodexHome $resolvedCertificationCodexHome `
                    -RequestedCoreHardeningCertification:$CoreHardeningCertification `
                    -SelfUninstallCallerPID $SelfUninstallCallerPID
                if ([bool]$preLayoutRecovery.handled) {
                    return $preLayoutRecovery.result
                }
                if ($Action -eq 'Install' -and $DeferredConfig -and
                    (Test-DefenseClawStandaloneProfile)) {
                    Assert-DefenseClawDeferredInstallIsFresh -Layout $layout
                }

                if ($Action -eq 'Reconcile') {
                    Assert-DefenseClawLayoutVolumeIdentity `
                        -Layout $layout `
                        -GatewayServiceName $GatewayServiceName `
                        -GuardianServiceName $GuardianServiceName
                    if (-not (Microsoft.PowerShell.Management\Test-Path -LiteralPath $layout.InstallRoot -PathType Container)) {
                        throw 'Reconcile requires an existing managed InstallRoot'
                    }
                    if (Microsoft.PowerShell.Management\Test-Path -LiteralPath $layout.PendingPath -PathType Leaf) {
                        $reconcileRecovery = Recover-DefenseClawPendingTransaction `
                            -Layout $layout `
                            -GatewayServiceName $GatewayServiceName `
                            -GuardianServiceName $GuardianServiceName
                        if ([bool]$reconcileRecovery.fresh_install_rollback) {
                            throw 'Reconcile recovered a failed initial install; run Install to create a deployment'
                        }
                    }
                    [void](Sync-DefenseClawStandaloneManagedHooksActivationBinding `
                        -Layout $layout `
                        -GatewayServiceName $GatewayServiceName)
                    return Invoke-DefenseClawReconcileLifecycle `
                        -Layout $layout `
                        -GatewayServiceName $GatewayServiceName `
                        -GuardianServiceName $GuardianServiceName
                }

                # Capture the exact absence baseline before the first managed-root
                # mutation. Fresh-install rollback records these booleans together with
                # the no-follow directory identities in its protected snapshot, so it
                # can delete only roots this transaction actually introduced.
                $nativeSecurity = Initialize-DefenseClawNativeSecurity
                $installRootBaseline =
                    $nativeSecurity::GetDirectorySecuritySnapshotNoFollowIfExists(
                        [string]$layout.InstallRoot
                    )
                $stateRootBaseline =
                    $nativeSecurity::GetDirectorySecuritySnapshotNoFollowIfExists(
                        [string]$layout.StateRoot
                    )
                $installRootCreatedForTransaction = $false
                $stateRootCreatedForTransaction = $false
                $installPreparationIntent = $null
                if ($Action -eq 'Install') {
                    # Publish protected absence/preimage authority before the first
                    # root mutation. If the process dies, the exact-scope receipt is
                    # still available outside StateRoot for fail-closed recovery.
                    $installPreparationIntent =
                        New-DefenseClawInstallPreparationIntent `
                            -Layout $layout `
                            -GatewayServiceName $GatewayServiceName `
                            -GuardianServiceName $GuardianServiceName `
                            -InstallRootBaseline $installRootBaseline `
                            -StateRootBaseline $stateRootBaseline
                }
                Assert-DefenseClawLayoutVolumeIdentity `
                    -Layout $layout `
                    -GatewayServiceName $GatewayServiceName `
                    -GuardianServiceName $GuardianServiceName
                if ($null -ne $installPreparationIntent) {
                    $installRootCreatedForTransaction = [bool](
                        Initialize-DefenseClawTransactionManagedRoot `
                            -Layout $layout `
                            -GatewayServiceName $GatewayServiceName `
                            -GuardianServiceName $GuardianServiceName `
                            -Root install_root `
                            -Path $layout.InstallRoot `
                            -Label 'InstallRoot' `
                            -RequiredBase $script:ProgramFiles `
                            -AllowUsersRead
                    )
                }
                else {
                    [void](Initialize-DefenseClawManagedRoot `
                        -Path $layout.InstallRoot `
                        -Label 'InstallRoot' `
                        -RequiredBase $script:ProgramFiles `
                        -AllowUsersRead `
                        -KeepProtectedAcl:(Test-DefenseClawStandaloneProfile))
                }
                if ($null -ne $installPreparationIntent) {
                    $stateRootCreatedForTransaction = [bool](
                        Initialize-DefenseClawTransactionManagedRoot `
                            -Layout $layout `
                            -GatewayServiceName $GatewayServiceName `
                            -GuardianServiceName $GuardianServiceName `
                            -Root state_root `
                            -Path $layout.StateRoot `
                            -Label 'StateRoot' `
                            -RequiredBase $script:ProgramData
                    )
                }
                else {
                    [void](Initialize-DefenseClawManagedRoot `
                        -Path $layout.StateRoot `
                        -Label 'StateRoot' `
                        -RequiredBase $script:ProgramData `
                        -KeepProtectedAcl:(Test-DefenseClawStandaloneProfile))
                }
                New-DefenseClawLayoutDirectories -Layout $layout
                if ($Action -in @('Install', 'Upgrade', 'Repair')) {
                    # A computer installed before 1.0.9 has no record of the
                    # two Cisco folders Setup created (GAP-0526, GAP-0091).
                    Add-DefenseClawStandaloneUpgradeVendorFolderRecords -Layout $layout -StateRoot ([string]$layout.StateRoot)
                }
                $pendingRecovery = Recover-DefenseClawPendingTransaction `
                    -Layout $layout `
                    -GatewayServiceName $GatewayServiceName `
                    -GuardianServiceName $GuardianServiceName `
                    -AllowDeferredActivation:($Action -in @('Upgrade', 'Repair', 'Uninstall'))
                Assert-DefenseClawRecoveryActivatedForAction `
                    -Recovery $pendingRecovery `
                    -Action $Action
                if (Test-DefenseClawRecoveryRestoredOtherRelease `
                        -Layout $layout `
                        -Recovery $pendingRecovery `
                        -Action $Action `
                        -Sources $sources) {
                    return Get-DefenseClawRecoveryRestoredOtherReleaseResult `
                        -Layout $layout `
                        -Action $Action `
                        -GatewayServiceName $GatewayServiceName `
                        -GuardianServiceName $GuardianServiceName
                }
                if ([bool]$pendingRecovery.fresh_install_rollback) {
                    if ($Action -eq 'Uninstall' -and $Purge) {
                        $result = Get-DefenseClawLifecycleStatus `
                            -Action 'Uninstall' `
                            -Layout $layout `
                            -GatewayServiceName $GatewayServiceName `
                            -GuardianServiceName $GuardianServiceName
                        $result |
                            Microsoft.PowerShell.Utility\Add-Member `
                                -MemberType NoteProperty `
                                -Name purged `
                                -Value $true `
                                -Force
                        $result = Add-DefenseClawStandalonePurgeMachineLeftovers -Layout $layout -Result $result
                        return Add-DefenseClawUninstallContractResult -Result $result
                    }
                    if ($Action -ne 'Install') {
                        throw "$Action recovered a failed initial install; run Install or Uninstall -Purge"
                    }
                    # Recovery retired the earlier exact-scope receipt. Start a new
                    # protected preparation transaction before recreating either
                    # root, so a second crash cannot reproduce the original gap.
                    $recoveredInstallBaseline =
                        $nativeSecurity::GetDirectorySecuritySnapshotNoFollowIfExists(
                            [string]$layout.InstallRoot
                        )
                    $recoveredStateBaseline =
                        $nativeSecurity::GetDirectorySecuritySnapshotNoFollowIfExists(
                            [string]$layout.StateRoot
                        )
                    $installPreparationIntent =
                        New-DefenseClawInstallPreparationIntent `
                            -Layout $layout `
                            -GatewayServiceName $GatewayServiceName `
                            -GuardianServiceName $GuardianServiceName `
                            -InstallRootBaseline $recoveredInstallBaseline `
                            -StateRootBaseline $recoveredStateBaseline
                    $installRootCreatedForTransaction = [bool](
                        Initialize-DefenseClawTransactionManagedRoot `
                            -Layout $layout `
                            -GatewayServiceName $GatewayServiceName `
                            -GuardianServiceName $GuardianServiceName `
                            -Root install_root `
                            -Path $layout.InstallRoot `
                            -Label 'InstallRoot' `
                            -RequiredBase $script:ProgramFiles `
                            -AllowUsersRead
                    )
                    $stateRootCreatedForTransaction = [bool](
                        Initialize-DefenseClawTransactionManagedRoot `
                            -Layout $layout `
                            -GatewayServiceName $GatewayServiceName `
                            -GuardianServiceName $GuardianServiceName `
                            -Root state_root `
                            -Path $layout.StateRoot `
                            -Label 'StateRoot' `
                            -RequiredBase $script:ProgramData
                    )
                    New-DefenseClawLayoutDirectories -Layout $layout
                }

                if ($Action -eq 'Install' -and (Test-DefenseClawStandaloneProfile) -and
                    -not (Microsoft.PowerShell.Management\Test-Path -LiteralPath $layout.PendingPath)) {
                    # A fresh install first removes the hook machine state an earlier
                    # deployment of this scope left, before its snapshot can make a
                    # rollback restore it (GAP-0575).
                    $priorDeployment = $null
                    try {
                        $priorDeployment = Get-DefenseClawDeploymentMetadata -Layout $layout
                    }
                    catch {
                        $priorDeployment = $false
                    }
                    if ($null -eq $priorDeployment -or
                        ($false -ne $priorDeployment -and -not (Test-DefenseClawMetadataInstalled -Metadata $priorDeployment))) {
                        foreach ($kept in @(Remove-DefenseClawStandaloneOrphanedHookMachineState -Layout $layout)) {
                            Microsoft.PowerShell.Utility\Write-Verbose "orphaned hook machine state stays: $kept"
                        }
                    }
                }
                if ($Action -in @('Upgrade', 'Repair', 'Uninstall')) {
                    # Upgrade and Repair install their authenticated gateway in the
                    # transaction, so it may prove the guardian's records when the
                    # installed one is missing or replaced (GAP-1417).
                    $bindingGatewaySource = $null
                    if ($Action -in @('Upgrade', 'Repair') -and $sources.ContainsKey('gateway')) {
                        $bindingGatewaySource = [hashtable]$sources['gateway']
                    }
                    [void](Sync-DefenseClawStandaloneManagedHooksActivationBinding `
                        -Layout $layout `
                        -GatewayServiceName $GatewayServiceName `
                        -GatewaySource $bindingGatewaySource)
                }
                if ($Action -eq 'Uninstall') {
                    $nativeCleanupSource = if ($sources.ContainsKey('native_cleanup')) {
                        [hashtable]$sources['native_cleanup']
                    }
                    else {
                        $null
                    }
                    return Invoke-DefenseClawUninstallLifecycle `
                        -Layout $layout `
                        -GatewayServiceName $GatewayServiceName `
                        -GuardianServiceName $GuardianServiceName `
                        -Purge:$Purge `
                        -GatewaySource $sources['gateway'] `
                        -NativeCleanupSource $nativeCleanupSource `
                        -SelfUninstallCallerPID $SelfUninstallCallerPID
                }
                return Invoke-DefenseClawInstallLikeLifecycle `
                    -Action $Action `
                    -Layout $layout `
                    -Sources $sources `
                    -CoworkPackagePath $CoworkPackagePath -CoworkSignaturePath $CoworkSignaturePath `
                    -StandaloneFleetStateKnown:$standaloneFleetStateKnown `
                    -StandaloneFleetEnabled:$standaloneFleetEnabled `
                    -GatewayServiceName $GatewayServiceName `
                    -GuardianServiceName $GuardianServiceName `
                    -RefreshApplicationControlAttestation:(
                        $AttestAgentApplicationControl -or
                        $AttestClaudeEffectivePolicy
                    ) `
                    -RefreshClaudeEffectivePolicyAttestation:$AttestClaudeEffectivePolicy `
                    -InstallRootCreatedForTransaction:$installRootCreatedForTransaction `
                    -StateRootCreatedForTransaction:$stateRootCreatedForTransaction `
                    -DeferredConfig:$DeferredConfig `
                    -NoStart:($NoStart -or $DeferredConfig)
            }
            catch {
                # The retry's own failure is the result, but the failure
                # that started the recovery is the likelier root cause, so
                # both are reported.
                if ($installRecoveryAttempted -and
                    -not [string]::IsNullOrEmpty($installRecoveryReason)) {
                    throw ('{0} (retried after clearing leftover state; first failure: {1})' -f
                        [string]$_.Exception.Message,
                        (ConvertTo-DefenseClawBoundedDiagnostic -Value $installRecoveryReason))
                }
                # A service still marked for deletion needs a restart; a
                # purge-and-retry cannot clear it and would only discard
                # state, so the precise prerequisite is the result.
                if (-not $installAutoRecoveryEligible -or
                    $installLiveDeployment -or
                    $installRecoveryAttempted -or
                    (Test-DefenseClawServicePendingDeleteFailure -Message ([string]$_.Exception.Message))) {
                    throw
                }
                $installRecoveryReason = [string]$_.Exception.Message
            }
        }
    }
    catch {
        Add-DefenseClawRecoveryEvidenceToError -ErrorRecord $_ -Layout $layout
        throw
    }
    finally {
        Exit-DefenseClawPurgeBundleLock
        Exit-DefenseClawLifecycleLock -Lock $lifecycleLock
        $leftNothing = Test-DefenseClawStandaloneUninstallLeftNothing -Action $Action -Layout $layout
        $createdFolders = [string[]]@()
        $script:DefenseClawCreatedFoldersKept.Clear()
        $script:DefenseClawMdmRotationJournalKept = ''
        if ($leftNothing) {
            # LEAD STEER (GAP-1913): a purge removes the kit's journal; a
            # plain uninstall keeps it and says so. The note also goes into
            # the result (mdm_rotation_journal_kept, read by
            # install-enterprise.ps1), so the Setup and CLI JSON name a kept
            # or left journal, not only the warning stream. A standalone
            # uninstall always runs with $Purge (it removes StateRoot), so
            # the purge the administrator asked for is the per-user flag.
            $purgeRequested = if (Test-DefenseClawStandaloneProfile) {
                [bool]$script:DefenseClawUninstallPurgeUserState
            }
            else {
                [bool]$Purge
            }
            if ($purgeRequested) {
                Remove-DefenseClawMdmRotationJournal -Purge
            }
            elseif ([IO.Directory]::Exists([IO.Path]::Combine($script:ProgramData, 'Cisco\DefenseClaw-MDM\rotation'))) {
                $script:DefenseClawMdmRotationJournalKept = (
                    'kept the MDM kit credential rotation journal ' +
                    [IO.Path]::Combine($script:ProgramData, 'Cisco\DefenseClaw-MDM\rotation') +
                    ' (it can hold a copy of an earlier credential); run the uninstall with PURGE=1 to remove it')
                Microsoft.PowerShell.Utility\Write-Warning -Message $script:DefenseClawMdmRotationJournalKept
            }
        }
        # Then the lock and the recorded folders below C:\ProgramData\Cisco,
        # once the MDM journal is gone (a journal kept there keeps that
        # folder and its record, review 2 L1).
        if ($script:DefenseClawRemoveLifecycleLockOnExit -or $leftNothing) {
            $script:DefenseClawRemoveLifecycleLockOnExit = $false
            $createdFolders = [string[]]@(Remove-DefenseClawStandaloneLifecycleLockLeftover -Layout $layout)
        }
        # Last, once the lock and its folder are gone: the vendor folders
        # this deployment created, if they are empty (GAP-0091).
        Remove-DefenseClawStandaloneCreatedFolders -Path $createdFolders
        # A self-uninstall leaves the recorded folders to its finalizer, which
        # runs after this result; the result names the ones it will keep
        # (review 2 L3).
        if ($Action -ceq 'Uninstall') {
            Write-DefenseClawUninstallCreatedFolderReport -Layout $layout -Touched $touchedVendorFolders -LeftNothing:([bool]$leftNothing)
        }
    }
}

# The last uninstall's note on an MDM kit rotation journal it kept or left
# (GAP-1913); install-enterprise.ps1 copies it into the result.
$script:DefenseClawMdmRotationJournalKept = ''

function Get-DefenseClawMdmRotationJournalKept {
    return [string]$script:DefenseClawMdmRotationJournalKept
}

function Remove-DefenseClawMdmRotationJournal {
    <#
        Once an uninstall removed the deployment and its credentials, the MDM
        kit's credential rotation journal goes too, whichever route ran it:
        packaging/mdm/windows/uninstall.ps1 removes it (GAP-1585), and a
        direct enterprise windows uninstall or Setup /uninstall now does the
        same, as Linux and macOS do (GAP-1615). An entry can hold a plaintext
        copy of an earlier credential, so each is overwritten with zeros
        before it is deleted. A journal that is not administrator-only, or
        that holds a folder or a link, is left and named on the warning
        stream. -Purge also removes the kit's empty state folder.
    #>
    param(
        [switch]$Purge,
        [string]$StateDirectory = ''
    )
    $script:DefenseClawMdmRotationJournalKept = ''
    try {
        $state = $StateDirectory
        if ([string]::IsNullOrWhiteSpace($state)) {
            $state = [IO.Path]::Combine($script:ProgramData, 'Cisco\DefenseClaw-MDM')
        }
        $journal = [IO.Path]::Combine($state, 'rotation')
        $item = Microsoft.PowerShell.Management\Get-Item -LiteralPath $journal -Force -ErrorAction SilentlyContinue
        if ($null -ne $item) {
            if (-not $item.PSIsContainer -or ($item.Attributes -band [IO.FileAttributes]::ReparsePoint) -ne 0) {
                $script:DefenseClawMdmRotationJournalKept = "left the MDM kit credential rotation journal $journal as it is: it is not an administrator-only folder; check it and remove it by hand"
                Microsoft.PowerShell.Utility\Write-Warning -Message $script:DefenseClawMdmRotationJournalKept
                return
            }
            Assert-DefenseClawPathAcl -Path $journal -AllowedWriterSIDs @($script:SystemSID, $script:AdministratorsSID)
            $entries = @(Microsoft.PowerShell.Management\Get-ChildItem -LiteralPath $journal -Force)
            foreach ($entry in $entries) {
                if ($entry.PSIsContainer -or ($entry.Attributes -band [IO.FileAttributes]::ReparsePoint) -ne 0) {
                    $script:DefenseClawMdmRotationJournalKept = "left the MDM kit credential rotation journal $journal as it is: it holds $($entry.Name), which the MDM kit does not write; check it and remove it by hand"
                    Microsoft.PowerShell.Utility\Write-Warning -Message $script:DefenseClawMdmRotationJournalKept
                    return
                }
            }
            foreach ($entry in $entries) {
                if ($entry.Length -gt 0) {
                    [IO.File]::WriteAllBytes($entry.FullName, [byte[]]::new($entry.Length))
                }
                Microsoft.PowerShell.Management\Remove-Item -LiteralPath $entry.FullName -Force
            }
            [IO.Directory]::Delete($journal, $false)
        }
        $lock = Microsoft.PowerShell.Management\Get-Item -LiteralPath ([IO.Path]::Combine($state, 'rotation.lock')) -Force -ErrorAction SilentlyContinue
        if ($null -ne $lock -and -not $lock.PSIsContainer -and ($lock.Attributes -band [IO.FileAttributes]::ReparsePoint) -eq 0) {
            Microsoft.PowerShell.Management\Remove-Item -LiteralPath $lock.FullName -Force -ErrorAction SilentlyContinue
        }
        if ($Purge -and [IO.Directory]::Exists($state) -and
            @(Microsoft.PowerShell.Management\Get-ChildItem -LiteralPath $state -Force).Count -eq 0) {
            [IO.Directory]::Delete($state, $false)
        }
    }
    catch {
        $script:DefenseClawMdmRotationJournalKept = "could not remove the MDM kit credential rotation journal: $($_.Exception.Message)"
        Microsoft.PowerShell.Utility\Write-Warning -Message $script:DefenseClawMdmRotationJournalKept
    }
}

function Test-DefenseClawStandaloneUninstallLeftNothing {
    <#
        Every standalone uninstall that leaves no deployment (no StateRoot, no
        InstallRoot) drops the lifecycle lock and its empty folder, as the
        install reference says, whichever path removed the deployment: a
        PURGE=1 over a tombstone an earlier release (1.0.2) wrote set no flag
        and left them (GAP-1897). The lock goes only once no other run holds
        it.
    #>
    param(
        [AllowEmptyString()][string]$Action,
        [hashtable]$Layout
    )
    if ($Action -cne 'Uninstall' -or $null -eq $Layout -or -not (Test-DefenseClawStandaloneProfile)) {
        return $false
    }
    foreach ($root in @([string]$Layout.StateRoot, [string]$Layout.InstallRoot)) {
        if ([string]::IsNullOrWhiteSpace($root) -or
            (Microsoft.PowerShell.Management\Test-Path -LiteralPath $root)) {
            return $false
        }
    }
    return $true
}

Microsoft.PowerShell.Core\Export-ModuleMember -Function Invoke-DefenseClawEnterpriseLifecycle, Get-DefenseClawMdmRotationJournalKept, Get-DefenseClawCreatedFoldersKept
