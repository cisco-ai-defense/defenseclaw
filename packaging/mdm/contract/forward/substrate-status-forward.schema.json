{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://defenseclaw.cisco.com/schemas/enterprise/management/forward/substrate-status-forward-v1.json",
  "title": "forwardable defenseclaw substrate status --json",
  "description": "Forwardable members of substrate-status.schema.json (defenseclaw substrate status --json). Project with allowlist-and-drop (forward/project.py). Everything but the checks' free-text messages passes: cluster and atespace names, the issuer digest, versions, counts, enums and times; no account, person or credential name appears in the document.",
  "type": "object",
  "additionalProperties": false,
  "required": [],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "command": {
      "const": "status"
    },
    "management_contract": {
      "const": 1
    },
    "product_version": {
      "type": "string",
      "pattern": "^v?[0-9]+\\.[0-9]+\\.[0-9]+(-[0-9A-Za-z.-]+)?$"
    },
    "generated_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,9})?(Z|[+-][0-9]{2}:[0-9]{2})$"
    },
    "cluster": {
      "$ref": "#/$defs/cluster"
    },
    "health": {
      "$ref": "#/$defs/health"
    },
    "atespaces": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/atespace"
      },
      "description": "The launcher and managed atespaces, sorted by name."
    },
    "inventory": {
      "$ref": "#/$defs/inventory"
    },
    "activity": {
      "$ref": "#/$defs/activity"
    },
    "batches": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/batch"
      }
    },
    "checks": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/check"
      },
      "minItems": 8,
      "maxItems": 8
    }
  },
  "$defs": {
    "cluster": {
      "type": "object",
      "additionalProperties": false,
      "required": [],
      "properties": {
        "cluster_name": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,99}$",
          "description": "k8s.cluster.name, as on every telemetry record."
        },
        "namespace": {
          "type": "string",
          "pattern": "^[a-z0-9]([-a-z0-9]{0,61}[a-z0-9])?$",
          "description": "The DefenseClaw release namespace."
        },
        "issuer_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$",
          "description": "SHA-256 of substrate.identity.issuer: a fleet compares these to find two clusters sharing an issuer (E13) without the URL."
        },
        "issuer_default": {
          "type": "boolean",
          "description": "The issuer has Substrate's default shape (https://idp.<namespace>.svc), which every cluster shares."
        },
        "substrate_version": {
          "type": "string",
          "pattern": "^v?[0-9]+\\.[0-9]+\\.[0-9]+(-[0-9A-Za-z.-]+)?$",
          "description": "The Agent Substrate release (ate-api-server image tag). Absent when it could not be read."
        },
        "substrate_version_supported": {
          "type": "boolean"
        },
        "supported_versions": {
          "type": "string",
          "pattern": "^[<>=v0-9. +-]{1,64}$",
          "description": "substrate.supported_versions, for example \">=1.0.0 <1.1.0\"."
        }
      }
    },
    "replicas": {
      "type": "object",
      "additionalProperties": false,
      "required": [],
      "properties": {
        "desired": {
          "type": "integer",
          "minimum": 0
        },
        "ready": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "health": {
      "type": "object",
      "additionalProperties": false,
      "required": [],
      "properties": {
        "state": {
          "enum": [
            "healthy",
            "degraded",
            "down"
          ],
          "description": "down: no gateway replica, or the registered callout has none. degraded: a component is short, the leader or its lease is missing, or a check failed."
        },
        "gateway": {
          "$ref": "#/$defs/replicas"
        },
        "leader": {
          "type": "object",
          "additionalProperties": false,
          "required": [],
          "properties": {
            "ready": {
              "type": "boolean"
            },
            "lease_held": {
              "type": "boolean"
            },
            "store_schema": {
              "type": "integer",
              "minimum": 1,
              "description": "From the defenseclaw-store-state ConfigMap; absent before the leader first wrote it."
            }
          }
        },
        "controller": {
          "type": "object",
          "additionalProperties": false,
          "required": [],
          "properties": {
            "desired": {
              "type": "integer",
              "minimum": 0
            },
            "ready": {
              "type": "integer",
              "minimum": 0
            },
            "lag_seconds": {
              "type": "integer",
              "minimum": 0,
              "description": "Age in whole seconds (rounded up) of the oldest actor change the active controller has not acted on."
            }
          }
        },
        "callout": {
          "type": "object",
          "additionalProperties": false,
          "required": [],
          "properties": {
            "desired": {
              "type": "integer",
              "minimum": 0
            },
            "ready": {
              "type": "integer",
              "minimum": 0
            },
            "registered": {
              "type": "boolean",
              "description": "atenet-egress sends allowed requests to the DefenseClaw callout."
            },
            "body_mode": {
              "enum": [
                "body",
                "headers_only"
              ],
              "description": "body: the Substrate body opt-in (agent-substrate#3817) is on; the callout reads MCP and listed-host bodies up to 1 MiB."
            }
          }
        }
      }
    },
    "atespace": {
      "type": "object",
      "additionalProperties": false,
      "required": [],
      "properties": {
        "atespace": {
          "type": "string",
          "pattern": "^[a-z0-9]([-a-z0-9]{0,61}[a-z0-9])?$"
        },
        "launcher": {
          "type": "boolean",
          "description": "A launcher atespace: only DefenseClaw creates, forks and proxies actors there."
        },
        "actors": {
          "type": "integer",
          "minimum": 0
        },
        "policies": {
          "type": "integer",
          "minimum": 0,
          "description": "Actors with a DefenseClaw egress policy."
        },
        "drift": {
          "type": "integer",
          "minimum": 0,
          "description": "Foreign policy changes reverted in the last 10 minutes."
        },
        "conflicts": {
          "type": "integer",
          "minimum": 0,
          "description": "Actors marked policy_conflict (three reverts in 10 minutes; E14)."
        },
        "unattested": {
          "type": "integer",
          "minimum": 0,
          "description": "Actors from templates without a valid attestation (no network)."
        }
      }
    },
    "inventory": {
      "type": "object",
      "additionalProperties": false,
      "required": [],
      "properties": {
        "actors": {
          "type": "integer",
          "minimum": 0
        },
        "running": {
          "type": "integer",
          "minimum": 0
        },
        "suspended": {
          "type": "integer",
          "minimum": 0
        },
        "templates": {
          "type": "integer",
          "minimum": 0
        },
        "unattested_templates": {
          "type": "integer",
          "minimum": 0
        },
        "foreign_actors": {
          "type": "integer",
          "minimum": 0,
          "description": "Actors DefenseClaw did not create, attributed by atespace and template."
        }
      }
    },
    "activity": {
      "type": "object",
      "additionalProperties": false,
      "required": [],
      "properties": {
        "window_seconds": {
          "type": "integer",
          "minimum": 1
        },
        "hook_decisions": {
          "type": "integer",
          "minimum": 0
        },
        "blocked": {
          "type": "integer",
          "minimum": 0
        },
        "model_requests": {
          "type": "integer",
          "minimum": 0
        },
        "cost_micro_usd": {
          "type": "integer",
          "minimum": 0,
          "description": "Model spend in the window, in millionths of a US dollar."
        }
      },
      "description": "The last window's activity and model spend (1.0.10 tokenomics). Absent when usage is not reported."
    },
    "batch": {
      "type": "object",
      "additionalProperties": false,
      "required": [],
      "properties": {
        "batch_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
        },
        "tasks": {
          "type": "integer",
          "minimum": 0
        },
        "running": {
          "type": "integer",
          "minimum": 0
        },
        "succeeded": {
          "type": "integer",
          "minimum": 0
        },
        "failed": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": [],
      "properties": {
        "id": {
          "enum": [
            "substrate_version",
            "issuer_unique",
            "snapshot_bucket",
            "openfga_grants",
            "callout_registered",
            "ingress_clients",
            "actor_service_routes",
            "api_access_label"
          ]
        },
        "status": {
          "enum": [
            "pass",
            "warn",
            "fail",
            "skip"
          ]
        },
        "edge_case": {
          "type": "string",
          "pattern": "^E[0-9]{1,2}$",
          "description": "The plan edge case the check guards (E1 actor routes, E2 proxy takeover, E10 snapshots, E13 issuer)."
        }
      }
    }
  }
}
