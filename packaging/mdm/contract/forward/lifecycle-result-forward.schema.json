{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://defenseclaw.cisco.com/schemas/enterprise/management/forward/lifecycle-result-forward-v1.json",
  "title": "forwardable lifecycle result",
  "description": "Forwardable members of lifecycle-result.schema.json (bundle apply, <os> status, verify, ensure). Forward schema (private #14 option A): the members a management agent may send off the device. Project with allowlist-and-drop (forward/project.py): a member not listed here, or a value outside its pattern or enum, is removed, never rejected, so members a newer DefenseClaw adds are not forwarded until this file lists them. Only DefenseClaw-minted ids, bundle and receipt ids, digests, counts, codes, booleans, enums, versions and times pass; account names and identifiers (user, uid, SID, UPN, group), paths and messages never do.",
  "type": "object",
  "additionalProperties": false,
  "required": [],
  "properties": {
    "schema_version": {
      "const": 2
    },
    "ok": {
      "type": "boolean"
    },
    "action": {
      "type": "string",
      "enum": [
        "install",
        "upgrade",
        "repair",
        "ensure",
        "reconcile",
        "status",
        "verify",
        "uninstall"
      ]
    },
    "noop": {
      "type": "boolean"
    },
    "noop_reason": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{0,63}$"
    },
    "profile": {
      "type": "string",
      "enum": [
        "standalone",
        "secure_client"
      ]
    },
    "platform": {
      "type": "string",
      "enum": [
        "linux",
        "darwin",
        "windows"
      ]
    },
    "product_version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]{0,8})\\.(0|[1-9][0-9]{0,8})\\.(0|[1-9][0-9]{0,8})(-[0-9A-Za-z.-]{1,64})?(\\+[0-9A-Za-z.-]{1,64})?$"
    },
    "installed_version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]{0,8})\\.(0|[1-9][0-9]{0,8})\\.(0|[1-9][0-9]{0,8})(-[0-9A-Za-z.-]{1,64})?(\\+[0-9A-Za-z.-]{1,64})?$"
    },
    "installed": {
      "type": "boolean"
    },
    "pending_apply": {
      "type": "boolean"
    },
    "transaction_pending": {
      "type": "boolean"
    },
    "coverage_complete": {
      "type": "boolean"
    },
    "security_complete": {
      "type": "boolean"
    },
    "exit_code": {
      "type": "integer"
    },
    "floor_source": {
      "type": "string",
      "enum": [
        "trust_anchor_min_version",
        "last_confirmed_bundle"
      ]
    },
    "readiness": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "gateway": {
          "type": "boolean"
        },
        "guardian": {
          "type": "boolean"
        },
        "enumerator": {
          "type": "boolean"
        },
        "sensor_helper": {
          "type": "boolean"
        }
      }
    },
    "enrollment": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "targets": {
          "type": "integer",
          "minimum": 0
        },
        "pending": {
          "type": "integer",
          "minimum": 0
        },
        "failed": {
          "type": "integer",
          "minimum": 0
        },
        "exempt": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "inspection": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "local": {
          "type": "string",
          "enum": [
            "active",
            "disabled",
            "unknown",
            ""
          ]
        },
        "ai_defense": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{0,63}$"
        }
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "effective_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "config_generation": {
          "type": "integer",
          "minimum": 0
        },
        "applied": {
          "type": "boolean"
        },
        "gateway_reported_digest": {
          "type": "string",
          "pattern": "^(|sha256:[0-9a-f]{64})$"
        },
        "config_unrecorded": {
          "type": "boolean"
        }
      }
    },
    "bundle": {
      "$ref": "#/$defs/bundleState"
    },
    "last_refusal": {
      "$ref": "#/$defs/bundleRefusal"
    },
    "connectors": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9_-]{0,31}$"
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "enabled": {
            "type": "boolean"
          },
          "detected": {
            "type": "boolean"
          },
          "hooks_installed": {
            "type": "string",
            "enum": [
              "all",
              "partial",
              "none",
              "unknown"
            ]
          },
          "effective_mode": {
            "type": "string",
            "enum": [
              "observe",
              "action"
            ]
          },
          "effective_hook_fail_mode": {
            "type": "string",
            "enum": [
              "open",
              "closed"
            ]
          },
          "managed_hook": {
            "type": "boolean"
          }
        }
      }
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "state": {
          "type": "string",
          "enum": [
            "ok",
            "failing",
            "idle",
            "unknown"
          ]
        },
        "failing_accounts": {
          "type": "integer",
          "minimum": 0
        },
        "stale_accounts": {
          "type": "integer",
          "minimum": 0
        },
        "serving_offline_cache": {
          "type": "boolean"
        },
        "reason_code": {
          "type": "string",
          "enum": [
            "gateway_not_ready",
            "gateway_did_not_report"
          ]
        }
      }
    },
    "openshell": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "install": {
          "type": "string",
          "enum": [
            "prerequisite",
            "setup"
          ]
        },
        "installed": {
          "type": "boolean"
        },
        "driver": {
          "type": "string",
          "enum": [
            "vm",
            "docker",
            "auto"
          ]
        },
        "driver_available": {
          "type": "string",
          "enum": [
            "vm",
            "docker",
            "none"
          ]
        },
        "reason_code": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{0,63}$"
        }
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/message"
      }
    },
    "errors": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/message"
      }
    }
  },
  "$defs": {
    "message": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "code": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{0,63}$"
        }
      }
    },
    "sessions": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "state": {
          "type": "string",
          "enum": [
            "known",
            "unknown"
          ]
        },
        "count": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "bundleState": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "receipt_id": {
          "type": "string",
          "pattern": "^[br]-[0-7][0-9A-HJKMNP-TV-Z]{25}$"
        },
        "delivery_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._:-]{1,128}$"
        },
        "bundle_id": {
          "type": "string",
          "pattern": "^(b-[0-7][0-9A-HJKMNP-TV-Z]{25})?$"
        },
        "version": {
          "type": "integer",
          "minimum": 0
        },
        "state": {
          "type": "string",
          "enum": [
            "received",
            "verified",
            "staged",
            "applied",
            "confirmed",
            "failed"
          ]
        },
        "disabled_by_bundle": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{0,63}$"
          },
          "maxItems": 64
        },
        "warning_codes": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{0,63}$"
          },
          "maxItems": 64
        },
        "error_code": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{0,63}$"
        },
        "effective_policy_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "config_generation": {
          "type": "integer",
          "minimum": 0
        },
        "applied_at": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,9})?(Z|[+-][0-9]{2}:[0-9]{2})$"
        },
        "confirmed_at": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,9})?(Z|[+-][0-9]{2}:[0-9]{2})$"
        },
        "restart": {
          "type": "boolean"
        },
        "restart_required": {
          "type": "boolean"
        },
        "sessions_restart_required": {
          "$ref": "#/$defs/sessions"
        },
        "current_bundle_id": {
          "type": "string",
          "pattern": "^b-[0-7][0-9A-HJKMNP-TV-Z]{25}$"
        },
        "current_version": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "bundleRefusal": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "receipt_id": {
          "type": "string",
          "pattern": "^[br]-[0-7][0-9A-HJKMNP-TV-Z]{25}$"
        },
        "delivery_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._:-]{1,128}$"
        },
        "bundle_id": {
          "type": "string",
          "pattern": "^b-[0-7][0-9A-HJKMNP-TV-Z]{25}$"
        },
        "version": {
          "type": "integer",
          "minimum": 0
        },
        "error_code": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{0,63}$"
        },
        "warning_codes": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{0,63}$"
          },
          "maxItems": 64
        },
        "disabled_by_bundle": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{0,63}$"
          },
          "maxItems": 64
        },
        "time": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,9})?(Z|[+-][0-9]{2}:[0-9]{2})$"
        }
      }
    }
  }
}
