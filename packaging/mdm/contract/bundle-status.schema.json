      "bundle": {
        "receipt_id": "b-01JAB3K9QX4M2N8P6R5T0V1WYZ",
        "bundle_id": "b-01JAB3K9QX4M2N8P6R5T0V1WYZ",
        "version": 13,
        "state": "confirmed",
        "effective_policy_digest": "sha256:4f2a0c6e8b1d3f5a7c9e0b2d4f6a8c0e2b4d6f8a0c2e4b6d8f0a2c4e6b8d0f2a",
        "config_generation": 41,
        "applied_at": "2026-10-16T21:05:01.120Z",
