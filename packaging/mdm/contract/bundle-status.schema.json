        "count": 0,
        "entries": []
      },
      "alert_only_rule_count": 0,
      "gateway_checked": true,
      "gateway_digest": "sha256:4f2a0c6e8b1d3f5a7c9e0b2d4f6a8c0e2b4d6f8a0c2e4b6d8f0a2c4e6b8d0f2a",
      "applied": true,
      "warnings": [],
      "errors": []
    }
  ]
}
