{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://defenseclaw.cisco.com/schemas/enterprise/management/substrate-status-v1.json",
  "title": "defenseclaw substrate status --json",
  "description": "The one document `defenseclaw substrate status --json` prints (internal/substrate/fleet StatusDocument): the cluster, the health of the gateway, leader, controller and callout, the actors of each launcher and managed atespace, the inventory (absent when it could not be read), and the doctor checks. Exit code 0 with the document; 2 for invalid arguments; 75 when the cluster or the Substrate API could not be reached (no document).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "atespaces",
    "checks",
    "cluster",
    "command",
    "generated_at",
    "health",
    "management_contract",
    "product_version",
    "schema_version"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "command": {
      "const": "status"
    },
    "management_contract": {
      "const": 1
    },
    "product_version": {
      "type": "string",
      "pattern": "^v?[0-9]+\\.[0-9]+\\.[0-9]+(-[0-9A-Za-z.-]+)?$"
    },
    "generated_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,9})?(Z|[+-][0-9]{2}:[0-9]{2})$"
    },
    "cluster": {
      "$ref": "#/$defs/cluster"
    },
    "health": {
      "$ref": "#/$defs/health"
    },
    "atespaces": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/atespace"
      },
      "description": "The launcher and managed atespaces, sorted by name; empty when the actors could not be read."
    },
    "inventory": {
      "$ref": "#/$defs/inventory",
      "description": "Every actor and template in the cluster, as the gateway's ServiceAccount (a global viewer) reads them. Absent when they could not be read."
    },
    "policy_conflicts": {
      "$ref": "#/$defs/policy_conflicts",
      "description": "The agents in policy_conflict per atespace (from 1.0.10). The policy_conflict check fails while one is there, and warns when they could not be counted."
    },
    "bundles": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/bundle_stage"
      },
      "description": "The signed policy bundles in force, one per stage (from 1.0.11); left out when substrate.bundles is off. The bundle_state check fails when one no longer verifies."
    },
    "checks": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/check"
      },
      "minItems": 12,
      "maxItems": 14
    }
  },
  "$defs": {
    "cluster": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cluster_name",
        "issuer_default",
        "issuer_sha256",
        "namespace",
        "substrate_version_supported",
        "supported_versions"
      ],
      "properties": {
        "cluster_name": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,99}$",
          "description": "k8s.cluster.name, as on every telemetry record."
        },
        "namespace": {
          "type": "string",
          "pattern": "^[a-z0-9]([-a-z0-9]{0,61}[a-z0-9])?$",
          "description": "The DefenseClaw release namespace."
        },
        "issuer_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$",
          "description": "SHA-256 of substrate.identity.issuer: a fleet compares these to find two clusters sharing an issuer (E13) without the URL."
        },
        "issuer_default": {
          "type": "boolean",
          "description": "The issuer has Substrate's default shape (https://idp.<namespace>.svc), which every cluster shares."
        },
        "substrate_version": {
          "type": "string",
          "pattern": "^v?[0-9]+\\.[0-9]+\\.[0-9]+(-[0-9A-Za-z.-]+)?$",
          "description": "The Agent Substrate release (ate-api-server image tag). Absent when it could not be read."
        },
        "substrate_version_supported": {
          "type": "boolean"
        },
        "supported_versions": {
          "type": "string",
          "pattern": "^[<>=v0-9. +-]{1,64}$",
          "description": "substrate.supported_versions, for example \">=1.0.0 <1.1.0\"."
        }
      }
    },
    "replicas": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "desired",
        "ready"
      ],
      "properties": {
        "desired": {
          "type": "integer",
          "minimum": 0
        },
        "ready": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "health": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "callout",
        "controller",
        "gateway",
        "leader",
        "state"
      ],
      "properties": {
        "state": {
          "enum": [
            "healthy",
            "degraded",
            "down"
          ],
          "description": "down: no gateway replica, or the registered callout has none. degraded: a component is short, the leader or its lease is missing, or a check failed."
        },
        "gateway": {
          "$ref": "#/$defs/replicas"
        },
        "leader": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "lease_held",
            "ready"
          ],
          "properties": {
            "ready": {
              "type": "boolean"
            },
            "lease_held": {
              "type": "boolean"
            },
            "store_schema": {
              "type": "integer",
              "minimum": 1,
              "description": "From the defenseclaw-store-state ConfigMap; absent before the leader first wrote it."
            }
          }
        },
        "controller": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "desired",
            "ready"
          ],
          "properties": {
            "desired": {
              "type": "integer",
              "minimum": 0
            },
            "ready": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "callout": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "body_mode",
            "desired",
            "ready",
            "registered"
          ],
          "properties": {
            "desired": {
              "type": "integer",
              "minimum": 0
            },
            "ready": {
              "type": "integer",
              "minimum": 0
            },
            "registered": {
              "type": "boolean",
              "description": "atenet-egress sends allowed requests to the DefenseClaw callout."
            },
            "body_mode": {
              "enum": [
                "body",
                "headers_only"
              ],
              "description": "body: the Substrate body opt-in (agent-substrate#3817) is on; the callout reads MCP and listed-host bodies up to 1 MiB."
            }
          }
        }
      }
    },
    "atespace": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "actors",
        "atespace",
        "launcher",
        "states"
      ],
      "properties": {
        "atespace": {
          "type": "string",
          "pattern": "^[a-z0-9]([-a-z0-9]{0,61}[a-z0-9])?$"
        },
        "launcher": {
          "type": "boolean",
          "description": "A launcher atespace: only DefenseClaw creates, forks and proxies actors there."
        },
        "actors": {
          "type": "integer",
          "minimum": 0,
          "description": "Every actor in the atespace."
        },
        "states": {
          "$ref": "#/$defs/actorStates"
        },
        "conflicts": {
          "type": "integer",
          "minimum": 0,
          "description": "Its agents in policy_conflict (from 1.0.10); absent when they were not counted (policy_conflicts.reason says why)."
        }
      }
    },
    "inventory": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "actors",
        "states",
        "templates"
      ],
      "properties": {
        "actors": {
          "type": "integer",
          "minimum": 0,
          "description": "Every actor in the cluster."
        },
        "templates": {
          "type": "integer",
          "minimum": 0,
          "description": "Every actor template in the cluster."
        },
        "states": {
          "$ref": "#/$defs/actorStates"
        }
      }
    },
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "message",
        "status"
      ],
      "properties": {
        "id": {
          "enum": [
            "substrate_version",
            "issuer_unique",
            "actor_keys",
            "sign_in_server",
            "snapshot_bucket",
            "openfga_grants",
            "bundle_state",
            "callout_registered",
            "ingress_clients",
            "actor_service_routes",
            "api_access_label",
            "policy_conflict",
            "worker_drain",
            "relay_tls"
          ]
        },
        "status": {
          "enum": [
            "pass",
            "warn",
            "fail",
            "skip"
          ]
        },
        "message": {
          "type": "string",
          "description": "For the administrator; kept on the cluster."
        },
        "edge_case": {
          "type": "string",
          "pattern": "^E[0-9]{1,2}$",
          "description": "The plan edge case the check guards (E1 actor routes, E2 proxy takeover, E10 snapshots, E13 issuer)."
        }
      }
    },
    "actorStates": {
      "type": "object",
      "propertyNames": {
        "pattern": "^(unspecified|resuming|running|suspending|suspended|crashed|deleting|reverting)$"
      },
      "additionalProperties": {
        "type": "integer",
        "minimum": 1
      },
      "description": "Actors by lifecycle state (Substrate's ActorState in lower case); a state with no actor is absent."
    },
    "policy_conflicts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "agents",
        "atespaces",
        "read"
      ],
      "description": "The agents in policy_conflict (GAP-0398): after repeated foreign changes to an agent's network policy the controller keeps it on the DefenseClaw rule only (deny-only) until an administrator resets it. Read with the administrator's DefenseClaw sign-in (every person's agents); without one the count is unknown: read is false, reason says why, agents is null and atespaces is empty, never a 0.",
      "properties": {
        "read": {
          "type": "boolean",
          "description": "Every person's agents were listed and counted."
        },
        "reason": {
          "enum": [
            "no_sign_in",
            "signed_out",
            "not_administrator",
            "unreachable",
            "not_read"
          ],
          "description": "Why they were not counted (absent when read): no_sign_in no DefenseClaw context here; signed_out the sign-in expired or was refused; not_administrator the cluster listed only the caller's own agents; unreachable the admin listener did not answer; not_read this command does not count them."
        },
        "agents": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "description": "Every agent in policy_conflict; null when not counted."
        },
        "atespaces": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/atespace_conflicts"
          },
          "description": "Every launcher and managed atespace, and every other one with an agent in policy_conflict, sorted by name; empty when not counted."
        }
      }
    },
    "atespace_conflicts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "atespace",
        "conflicts"
      ],
      "properties": {
        "atespace": {
          "type": "string",
          "pattern": "^[a-z0-9]([-a-z0-9]{0,61}[a-z0-9])?$"
        },
        "conflicts": {
          "type": "integer",
          "minimum": 0,
          "description": "Its agents in policy_conflict."
        }
      }
    },
    "bundle_stage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "applied_at",
        "atespaces",
        "bundle_id",
        "key_id",
        "manifest_sha256",
        "receipt_id",
        "source",
        "stage",
        "state",
        "version"
      ],
      "description": "One rollout stage and the signed policy bundle in force there (GAP-0432): bundle_id, version, key_id and receipt_id name the bundle and its apply receipt.",
      "properties": {
        "stage": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]{0,62}$"
        },
        "atespaces": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^(\\*|[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?)$"
          }
        },
        "bundle_id": {
          "type": "string",
          "pattern": "^b-[0-7][0-9A-HJKMNP-TV-Z]{25}$"
        },
        "version": {
          "type": "integer",
          "minimum": 0
        },
        "key_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "manifest_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "applied_at": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,9})?(Z|[+-][0-9]{2}:[0-9]{2})$"
        },
        "source": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{0,31}$",
          "description": "Where the apply came from: admin, inbox, or the name of another source (a registry source fills the same fields)."
        },
        "state": {
          "enum": [
            "verified",
            "unverified",
            "unchecked"
          ],
          "description": "verified: the bundle verifies against the current trust anchors; unverified: it no longer does and is not enforced (problem names the code); unchecked: verify could not check it from where it ran."
        },
        "problem": {
          "type": "string",
          "pattern": "^[a-z_]+$",
          "description": "The bundle error code when state is unverified."
        },
        "receipt_id": {
          "type": "string",
          "pattern": "^r-[0-9a-f]{16}$",
          "description": "Names the apply receipt: r- and the first 16 hex digits of the SHA-256 of applied_at, source, stage and manifest_sha256 joined with a newline. Receipts carry no id of their own."
        }
      }
    }
  },
  "examples": [
    {
      "schema_version": 1,
      "command": "status",
      "management_contract": 1,
      "product_version": "1.0.10",
      "generated_at": "2026-11-13T15:04:05Z",
      "cluster": {
        "cluster_name": "dc-substrate-e1",
        "namespace": "defenseclaw-system",
        "issuer_sha256": "4b0f3f5c0a8a5b1e8d2c2f6b0d7f7d8a9e0c1b2a3f4e5d6c7b8a9f0e1d2c3b4a",
        "issuer_default": true,
        "substrate_version": "1.0.0",
        "substrate_version_supported": true,
        "supported_versions": ">=1.0.0 <1.1.0"
      },
      "health": {
        "state": "healthy",
        "gateway": {
          "desired": 2,
          "ready": 2
        },
        "leader": {
          "ready": true,
          "lease_held": true,
          "store_schema": 1
        },
        "controller": {
          "desired": 2,
          "ready": 2
        },
        "callout": {
          "desired": 2,
          "ready": 2,
          "registered": true,
          "body_mode": "headers_only"
        }
      },
      "atespaces": [
        {
          "atespace": "eng-web",
          "launcher": true,
          "actors": 3,
          "states": {
            "running": 1,
            "suspended": 2
          },
          "conflicts": 0
        }
      ],
      "inventory": {
        "actors": 4,
        "states": {
          "running": 1,
          "suspended": 2,
          "crashed": 1
        },
        "templates": 2
      },
      "policy_conflicts": {
        "read": true,
        "agents": 0,
        "atespaces": [
          {
            "atespace": "eng-web",
            "conflicts": 0
          }
        ]
      },
      "checks": [
        {
          "id": "substrate_version",
          "status": "pass",
          "message": "ok"
        },
        {
          "id": "issuer_unique",
          "status": "warn",
          "message": "the default issuer is fine for one cluster; set a unique one before adding another",
          "edge_case": "E13"
        },
        {
          "id": "actor_keys",
          "status": "pass",
          "message": "ok"
        },
        {
          "id": "sign_in_server",
          "status": "pass",
          "message": "ok"
        },
        {
          "id": "snapshot_bucket",
          "status": "pass",
          "message": "ok"
        },
        {
          "id": "openfga_grants",
          "status": "pass",
          "message": "ok"
        },
        {
          "id": "bundle_state",
          "status": "skip",
          "message": "signed policy bundles are off (substrate.bundles.enabled)"
        },
        {
          "id": "callout_registered",
          "status": "pass",
          "message": "ok"
        },
        {
          "id": "ingress_clients",
          "status": "pass",
          "message": "ok"
        },
        {
          "id": "actor_service_routes",
          "status": "pass",
          "message": "ok"
        },
        {
          "id": "api_access_label",
          "status": "pass",
          "message": "ok"
        },
        {
          "id": "policy_conflict",
          "status": "pass",
          "message": "no agent is in policy_conflict"
        },
        {
          "id": "worker_drain",
          "status": "pass",
          "message": "ok"
        },
        {
          "id": "relay_tls",
          "status": "pass",
          "message": "ok"
        }
      ]
    }
  ]
}
