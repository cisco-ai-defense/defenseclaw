{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://defenseclaw.cisco.com/schemas/enterprise/management/substrate-status-v1.json",
  "title": "defenseclaw substrate status --json",
  "description": "The one document `defenseclaw substrate status --json` prints (internal/substrate/fleet StatusDocument): the cluster, the health of the gateway, leader, controller and callout, the policy state per atespace, the inventory, optional activity and spend, unattended batches, and the doctor checks. Exit code 0 with the document; 2 for invalid arguments; 75 when the cluster or the Substrate API could not be reached (no document).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "atespaces",
    "batches",
    "checks",
    "cluster",
    "command",
    "generated_at",
    "health",
    "inventory",
    "management_contract",
    "product_version",
    "schema_version"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "command": {
      "const": "status"
    },
    "management_contract": {
      "const": 1
    },
    "product_version": {
      "type": "string",
      "pattern": "^v?[0-9]+\\.[0-9]+\\.[0-9]+(-[0-9A-Za-z.-]+)?$"
    },
    "generated_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,9})?(Z|[+-][0-9]{2}:[0-9]{2})$"
    },
    "cluster": {
      "$ref": "#/$defs/cluster"
    },
    "health": {
      "$ref": "#/$defs/health"
    },
    "atespaces": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/atespace"
      },
      "description": "The launcher and managed atespaces, sorted by name."
    },
    "inventory": {
      "$ref": "#/$defs/inventory"
    },
    "activity": {
      "$ref": "#/$defs/activity"
    },
    "batches": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/batch"
      }
    },
    "checks": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/check"
      },
      "minItems": 8,
      "maxItems": 8
    }
  },
  "$defs": {
    "cluster": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cluster_name",
        "issuer_default",
        "issuer_sha256",
        "namespace",
        "substrate_version_supported",
        "supported_versions"
      ],
      "properties": {
        "cluster_name": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,99}$",
          "description": "k8s.cluster.name, as on every telemetry record."
        },
        "namespace": {
          "type": "string",
          "pattern": "^[a-z0-9]([-a-z0-9]{0,61}[a-z0-9])?$",
          "description": "The DefenseClaw release namespace."
        },
        "issuer_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$",
          "description": "SHA-256 of substrate.identity.issuer: a fleet compares these to find two clusters sharing an issuer (E13) without the URL."
        },
        "issuer_default": {
          "type": "boolean",
          "description": "The issuer has Substrate's default shape (https://idp.<namespace>.svc), which every cluster shares."
        },
        "substrate_version": {
          "type": "string",
          "pattern": "^v?[0-9]+\\.[0-9]+\\.[0-9]+(-[0-9A-Za-z.-]+)?$",
          "description": "The Agent Substrate release (ate-api-server image tag). Absent when it could not be read."
        },
        "substrate_version_supported": {
          "type": "boolean"
        },
        "supported_versions": {
          "type": "string",
          "pattern": "^[<>=v0-9. +-]{1,64}$",
          "description": "substrate.supported_versions, for example \">=1.0.0 <1.1.0\"."
        }
      }
    },
    "replicas": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "desired",
        "ready"
      ],
      "properties": {
        "desired": {
          "type": "integer",
          "minimum": 0
        },
        "ready": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "health": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "callout",
        "controller",
        "gateway",
        "leader",
        "state"
      ],
      "properties": {
        "state": {
          "enum": [
            "healthy",
            "degraded",
            "down"
          ],
          "description": "down: no gateway replica, or the registered callout has none. degraded: a component is short, the leader or its lease is missing, or a check failed."
        },
        "gateway": {
          "$ref": "#/$defs/replicas"
        },
        "leader": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "lease_held",
            "ready"
          ],
          "properties": {
            "ready": {
              "type": "boolean"
            },
            "lease_held": {
              "type": "boolean"
            },
            "store_schema": {
              "type": "integer",
              "minimum": 1,
              "description": "From the defenseclaw-store-state ConfigMap; absent before the leader first wrote it."
            }
          }
        },
        "controller": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "desired",
            "ready"
          ],
          "properties": {
            "desired": {
              "type": "integer",
              "minimum": 0
            },
            "ready": {
              "type": "integer",
              "minimum": 0
            },
            "lag_seconds": {
              "type": "integer",
              "minimum": 0,
              "description": "Age in whole seconds (rounded up) of the oldest actor change the active controller has not acted on."
            }
          }
        },
        "callout": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "body_mode",
            "desired",
            "ready",
            "registered"
          ],
          "properties": {
            "desired": {
              "type": "integer",
              "minimum": 0
            },
            "ready": {
              "type": "integer",
              "minimum": 0
            },
            "registered": {
              "type": "boolean",
              "description": "atenet-egress sends allowed requests to the DefenseClaw callout."
            },
            "body_mode": {
              "enum": [
                "body",
                "headers_only"
              ],
              "description": "body: the Substrate body opt-in (agent-substrate#3817) is on; the callout reads MCP and listed-host bodies up to 1 MiB."
            }
          }
        }
      }
    },
    "atespace": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "actors",
        "atespace",
        "conflicts",
        "drift",
        "launcher",
        "policies",
        "unattested"
      ],
      "properties": {
        "atespace": {
          "type": "string",
          "pattern": "^[a-z0-9]([-a-z0-9]{0,61}[a-z0-9])?$"
        },
        "launcher": {
          "type": "boolean",
          "description": "A launcher atespace: only DefenseClaw creates, forks and proxies actors there."
        },
        "actors": {
          "type": "integer",
          "minimum": 0
        },
        "policies": {
          "type": "integer",
          "minimum": 0,
          "description": "Actors with a DefenseClaw egress policy."
        },
        "drift": {
          "type": "integer",
          "minimum": 0,
          "description": "Foreign policy changes reverted in the last 10 minutes."
        },
        "conflicts": {
          "type": "integer",
          "minimum": 0,
          "description": "Actors marked policy_conflict (three reverts in 10 minutes; E14)."
        },
        "unattested": {
          "type": "integer",
          "minimum": 0,
          "description": "Actors from templates without a valid attestation (no network)."
        }
      }
    },
    "inventory": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "actors",
        "foreign_actors",
        "running",
        "suspended",
        "templates",
        "unattested_templates"
      ],
      "properties": {
        "actors": {
          "type": "integer",
          "minimum": 0
        },
        "running": {
          "type": "integer",
          "minimum": 0
        },
        "suspended": {
          "type": "integer",
          "minimum": 0
        },
        "templates": {
          "type": "integer",
          "minimum": 0
        },
        "unattested_templates": {
          "type": "integer",
          "minimum": 0
        },
        "foreign_actors": {
          "type": "integer",
          "minimum": 0,
          "description": "Actors DefenseClaw did not create, attributed by atespace and template."
        }
      }
    },
    "activity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "blocked",
        "cost_micro_usd",
        "hook_decisions",
        "model_requests",
        "window_seconds"
      ],
      "properties": {
        "window_seconds": {
          "type": "integer",
          "minimum": 1
        },
        "hook_decisions": {
          "type": "integer",
          "minimum": 0
        },
        "blocked": {
          "type": "integer",
          "minimum": 0
        },
        "model_requests": {
          "type": "integer",
          "minimum": 0
        },
        "cost_micro_usd": {
          "type": "integer",
          "minimum": 0,
          "description": "Model spend in the window, in millionths of a US dollar."
        }
      },
      "description": "The last window's activity and model spend (1.0.10 tokenomics). Absent when usage is not reported."
    },
    "batch": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "batch_id",
        "failed",
        "running",
        "succeeded",
        "tasks"
      ],
      "properties": {
        "batch_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
        },
        "tasks": {
          "type": "integer",
          "minimum": 0
        },
        "running": {
          "type": "integer",
          "minimum": 0
        },
        "succeeded": {
          "type": "integer",
          "minimum": 0
        },
        "failed": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "message",
        "status"
      ],
      "properties": {
        "id": {
          "enum": [
            "substrate_version",
            "issuer_unique",
            "snapshot_bucket",
            "openfga_grants",
            "callout_registered",
            "ingress_clients",
            "actor_service_routes",
            "api_access_label"
          ]
        },
        "status": {
          "enum": [
            "pass",
            "warn",
            "fail",
            "skip"
          ]
        },
        "message": {
          "type": "string",
          "description": "For the administrator; kept on the cluster."
        },
        "edge_case": {
          "type": "string",
          "pattern": "^E[0-9]{1,2}$",
          "description": "The plan edge case the check guards (E1 actor routes, E2 proxy takeover, E10 snapshots, E13 issuer)."
        }
      }
    }
  },
  "examples": [
    {
      "schema_version": 1,
      "command": "status",
      "management_contract": 1,
      "product_version": "1.0.10",
      "generated_at": "2026-11-13T15:04:05Z",
      "cluster": {
        "cluster_name": "dc-substrate-e1",
        "namespace": "defenseclaw-system",
        "issuer_sha256": "4b0f3f5c0a8a5b1e8d2c2f6b0d7f7d8a9e0c1b2a3f4e5d6c7b8a9f0e1d2c3b4a",
        "issuer_default": true,
        "substrate_version": "1.0.0",
        "substrate_version_supported": true,
        "supported_versions": ">=1.0.0 <1.1.0"
      },
      "health": {
        "state": "healthy",
        "gateway": {
          "desired": 2,
          "ready": 2
        },
        "leader": {
          "ready": true,
          "lease_held": true,
          "store_schema": 1
        },
        "controller": {
          "desired": 2,
          "ready": 2,
          "lag_seconds": 1
        },
        "callout": {
          "desired": 2,
          "ready": 2,
          "registered": true,
          "body_mode": "headers_only"
        }
      },
      "atespaces": [
        {
          "atespace": "eng-web",
          "launcher": true,
          "actors": 3,
          "policies": 3,
          "drift": 0,
          "conflicts": 0,
          "unattested": 0
        }
      ],
      "inventory": {
        "actors": 3,
        "running": 1,
        "suspended": 2,
        "templates": 2,
        "unattested_templates": 0,
        "foreign_actors": 0
      },
      "activity": {
        "window_seconds": 3600,
        "hook_decisions": 120,
        "blocked": 2,
        "model_requests": 40,
        "cost_micro_usd": 1250000
      },
      "batches": [
        {
          "batch_id": "b-20261113-1",
          "tasks": 50,
          "running": 10,
          "succeeded": 38,
          "failed": 2
        }
      ],
      "checks": [
        {
          "id": "substrate_version",
          "status": "pass",
          "message": "ok"
        },
        {
          "id": "issuer_unique",
          "status": "warn",
          "message": "the default issuer is fine for one cluster; set a unique one before adding another",
          "edge_case": "E13"
        },
        {
          "id": "snapshot_bucket",
          "status": "pass",
          "message": "ok"
        },
        {
          "id": "openfga_grants",
          "status": "pass",
          "message": "ok"
        },
        {
          "id": "callout_registered",
          "status": "pass",
          "message": "ok"
        },
        {
          "id": "ingress_clients",
          "status": "pass",
          "message": "ok"
        },
        {
          "id": "actor_service_routes",
          "status": "pass",
          "message": "ok"
        },
        {
          "id": "api_access_label",
          "status": "pass",
          "message": "ok"
        }
      ]
    }
  ]
}
