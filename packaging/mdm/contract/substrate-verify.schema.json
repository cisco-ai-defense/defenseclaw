{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://defenseclaw.cisco.com/schemas/enterprise/management/substrate-verify-v1.json",
  "title": "defenseclaw substrate verify --json",
  "description": "The one document `defenseclaw substrate verify --json` prints (internal/substrate/fleet VerifyDocument): the doctor checks and one verdict for a fleet gate. Exit code 0 when no check failed, 1 when one did, 2 for invalid arguments, 75 when the cluster could not be reached (no document).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "checks",
    "cluster",
    "command",
    "generated_at",
    "management_contract",
    "ok",
    "product_version",
    "schema_version"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "command": {
      "const": "verify"
    },
    "management_contract": {
      "const": 1
    },
    "product_version": {
      "type": "string",
      "pattern": "^v?[0-9]+\\.[0-9]+\\.[0-9]+(-[0-9A-Za-z.-]+)?$"
    },
    "generated_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,9})?(Z|[+-][0-9]{2}:[0-9]{2})$"
    },
    "cluster": {
      "$ref": "#/$defs/cluster"
    },
    "ok": {
      "type": "boolean",
      "description": "False when any check failed; the command then exits 1."
    },
    "policy_conflicts": {
      "$ref": "#/$defs/policy_conflicts",
      "description": "The agents in policy_conflict per atespace (from 1.0.10). The policy_conflict check fails while one is there, and warns when they could not be counted."
    },
    "bundles": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/bundle_stage"
      },
      "description": "The signed policy bundles in force, one per stage (from 1.0.11); left out when substrate.bundles is off. The bundle_state check fails when one no longer verifies."
    },
    "checks": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/check"
      },
      "minItems": 12,
      "maxItems": 14
    }
  },
  "$defs": {
    "cluster": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cluster_name",
        "issuer_default",
        "issuer_sha256",
        "namespace",
        "substrate_version_supported",
        "supported_versions"
      ],
      "properties": {
        "cluster_name": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,99}$",
          "description": "k8s.cluster.name, as on every telemetry record."
        },
        "namespace": {
          "type": "string",
          "pattern": "^[a-z0-9]([-a-z0-9]{0,61}[a-z0-9])?$",
          "description": "The DefenseClaw release namespace."
        },
        "issuer_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$",
          "description": "SHA-256 of substrate.identity.issuer: a fleet compares these to find two clusters sharing an issuer (E13) without the URL."
        },
        "issuer_default": {
          "type": "boolean",
          "description": "The issuer has Substrate's default shape (https://idp.<namespace>.svc), which every cluster shares."
        },
        "substrate_version": {
          "type": "string",
          "pattern": "^v?[0-9]+\\.[0-9]+\\.[0-9]+(-[0-9A-Za-z.-]+)?$",
          "description": "The Agent Substrate release (ate-api-server image tag). Absent when it could not be read."
        },
        "substrate_version_supported": {
          "type": "boolean"
        },
        "supported_versions": {
          "type": "string",
          "pattern": "^[<>=v0-9. +-]{1,64}$",
          "description": "substrate.supported_versions, for example \">=1.0.0 <1.1.0\"."
        }
      }
    },
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "message",
        "status"
      ],
      "properties": {
        "id": {
          "enum": [
            "substrate_version",
            "issuer_unique",
            "actor_keys",
            "sign_in_server",
            "snapshot_bucket",
            "openfga_grants",
            "bundle_state",
            "callout_registered",
            "ingress_clients",
            "actor_service_routes",
            "api_access_label",
            "policy_conflict",
            "worker_drain",
            "relay_tls"
          ]
        },
        "status": {
          "enum": [
            "pass",
            "warn",
            "fail",
            "skip"
          ]
        },
        "message": {
          "type": "string",
          "description": "For the administrator; kept on the cluster."
        },
        "edge_case": {
          "type": "string",
          "pattern": "^E[0-9]{1,2}$",
          "description": "The plan edge case the check guards (E1 actor routes, E2 proxy takeover, E10 snapshots, E13 issuer)."
        }
      }
    },
    "policy_conflicts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "agents",
        "atespaces",
        "read"
      ],
      "description": "The agents in policy_conflict (GAP-0398): after repeated foreign changes to an agent's network policy the controller keeps it on the DefenseClaw rule only (deny-only) until an administrator resets it. Read with the administrator's DefenseClaw sign-in (every person's agents); without one the count is unknown: read is false, reason says why, agents is null and atespaces is empty, never a 0.",
      "properties": {
        "read": {
          "type": "boolean",
          "description": "Every person's agents were listed and counted."
        },
        "reason": {
          "enum": [
            "no_sign_in",
            "signed_out",
            "not_administrator",
            "unreachable",
            "not_read"
          ],
          "description": "Why they were not counted (absent when read): no_sign_in no DefenseClaw context here; signed_out the sign-in expired or was refused; not_administrator the cluster listed only the caller's own agents; unreachable the admin listener did not answer; not_read this command does not count them."
        },
        "agents": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "description": "Every agent in policy_conflict; null when not counted."
        },
        "atespaces": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/atespace_conflicts"
          },
          "description": "Every launcher and managed atespace, and every other one with an agent in policy_conflict, sorted by name; empty when not counted."
        }
      }
    },
    "atespace_conflicts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "atespace",
        "conflicts"
      ],
      "properties": {
        "atespace": {
          "type": "string",
          "pattern": "^[a-z0-9]([-a-z0-9]{0,61}[a-z0-9])?$"
        },
        "conflicts": {
          "type": "integer",
          "minimum": 0,
          "description": "Its agents in policy_conflict."
        }
      }
    },
    "bundle_stage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "applied_at",
        "atespaces",
        "bundle_id",
        "key_id",
        "manifest_sha256",
        "receipt_id",
        "source",
        "stage",
        "state",
        "version"
      ],
      "description": "One rollout stage and the signed policy bundle in force there (GAP-0432): bundle_id, version, key_id and receipt_id name the bundle and its apply receipt.",
      "properties": {
        "stage": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]{0,62}$"
        },
        "atespaces": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^(\\*|[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?)$"
          }
        },
        "bundle_id": {
          "type": "string",
          "pattern": "^b-[0-7][0-9A-HJKMNP-TV-Z]{25}$"
        },
        "version": {
          "type": "integer",
          "minimum": 0
        },
        "key_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "manifest_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "applied_at": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,9})?(Z|[+-][0-9]{2}:[0-9]{2})$"
        },
        "source": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{0,31}$",
          "description": "Where the apply came from: admin, inbox, or the name of another source (a registry source fills the same fields)."
        },
        "state": {
          "enum": [
            "verified",
            "unverified",
            "unchecked"
          ],
          "description": "verified: the bundle verifies against the current trust anchors; unverified: it no longer does and is not enforced (problem names the code); unchecked: verify could not check it from where it ran."
        },
        "problem": {
          "type": "string",
          "pattern": "^[a-z_]+$",
          "description": "The bundle error code when state is unverified."
        },
        "receipt_id": {
          "type": "string",
          "pattern": "^r-[0-9a-f]{16}$",
          "description": "Names the apply receipt: r- and the first 16 hex digits of the SHA-256 of applied_at, source, stage and manifest_sha256 joined with a newline. Receipts carry no id of their own."
        }
      }
    }
  },
  "examples": [
    {
      "schema_version": 1,
      "command": "verify",
      "management_contract": 1,
      "product_version": "1.0.10",
      "generated_at": "2026-11-13T15:04:05Z",
      "cluster": {
        "cluster_name": "dc-substrate-e1",
        "namespace": "defenseclaw-system",
        "issuer_sha256": "4b0f3f5c0a8a5b1e8d2c2f6b0d7f7d8a9e0c1b2a3f4e5d6c7b8a9f0e1d2c3b4a",
        "issuer_default": true,
        "substrate_version": "1.0.0",
        "substrate_version_supported": true,
        "supported_versions": ">=1.0.0 <1.1.0"
      },
      "ok": true,
      "policy_conflicts": {
        "read": true,
        "agents": 0,
        "atespaces": []
      },
      "checks": [
        {
          "id": "substrate_version",
          "status": "pass",
          "message": "ok"
        },
        {
          "id": "issuer_unique",
          "status": "warn",
          "message": "the default issuer is fine for one cluster; set a unique one before adding another",
          "edge_case": "E13"
        },
        {
          "id": "actor_keys",
          "status": "pass",
          "message": "ok"
        },
        {
          "id": "sign_in_server",
          "status": "pass",
          "message": "ok"
        },
        {
          "id": "snapshot_bucket",
          "status": "pass",
          "message": "ok"
        },
        {
          "id": "openfga_grants",
          "status": "pass",
          "message": "ok"
        },
        {
          "id": "bundle_state",
          "status": "skip",
          "message": "signed policy bundles are off (substrate.bundles.enabled)"
        },
        {
          "id": "callout_registered",
          "status": "pass",
          "message": "ok"
        },
        {
          "id": "ingress_clients",
          "status": "pass",
          "message": "ok"
        },
        {
          "id": "actor_service_routes",
          "status": "pass",
          "message": "ok"
        },
        {
          "id": "api_access_label",
          "status": "pass",
          "message": "ok"
        },
        {
          "id": "policy_conflict",
          "status": "pass",
          "message": "no agent is in policy_conflict"
        },
        {
          "id": "worker_drain",
          "status": "pass",
          "message": "ok"
        },
        {
          "id": "relay_tls",
          "status": "pass",
          "message": "ok"
        }
      ]
    }
  ]
}
