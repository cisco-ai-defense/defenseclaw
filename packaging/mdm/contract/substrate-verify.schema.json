{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://defenseclaw.cisco.com/schemas/enterprise/management/substrate-verify-v1.json",
  "title": "defenseclaw substrate verify --json",
  "description": "The one document `defenseclaw substrate verify --json` prints (internal/substrate/fleet VerifyDocument): the doctor checks and one verdict for a fleet gate. Exit code 0 when no check failed, 1 when one did, 2 for invalid arguments, 75 when the cluster could not be reached (no document).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "checks",
    "cluster",
    "command",
    "generated_at",
    "management_contract",
    "ok",
    "product_version",
    "schema_version"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "command": {
      "const": "verify"
    },
    "management_contract": {
      "const": 1
    },
    "product_version": {
      "type": "string",
      "pattern": "^v?[0-9]+\\.[0-9]+\\.[0-9]+(-[0-9A-Za-z.-]+)?$"
    },
    "generated_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,9})?(Z|[+-][0-9]{2}:[0-9]{2})$"
    },
    "cluster": {
      "$ref": "#/$defs/cluster"
    },
    "ok": {
      "type": "boolean",
      "description": "False when any check failed; the command then exits 1."
    },
    "checks": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/check"
      },
      "minItems": 8,
      "maxItems": 8
    }
  },
  "$defs": {
    "cluster": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cluster_name",
        "issuer_default",
        "issuer_sha256",
        "namespace",
        "substrate_version_supported",
        "supported_versions"
      ],
      "properties": {
        "cluster_name": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,99}$",
          "description": "k8s.cluster.name, as on every telemetry record."
        },
        "namespace": {
          "type": "string",
          "pattern": "^[a-z0-9]([-a-z0-9]{0,61}[a-z0-9])?$",
          "description": "The DefenseClaw release namespace."
        },
        "issuer_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$",
          "description": "SHA-256 of substrate.identity.issuer: a fleet compares these to find two clusters sharing an issuer (E13) without the URL."
        },
        "issuer_default": {
          "type": "boolean",
          "description": "The issuer has Substrate's default shape (https://idp.<namespace>.svc), which every cluster shares."
        },
        "substrate_version": {
          "type": "string",
          "pattern": "^v?[0-9]+\\.[0-9]+\\.[0-9]+(-[0-9A-Za-z.-]+)?$",
          "description": "The Agent Substrate release (ate-api-server image tag). Absent when it could not be read."
        },
        "substrate_version_supported": {
          "type": "boolean"
        },
        "supported_versions": {
          "type": "string",
          "pattern": "^[<>=v0-9. +-]{1,64}$",
          "description": "substrate.supported_versions, for example \">=1.0.0 <1.1.0\"."
        }
      }
    },
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "message",
        "status"
      ],
      "properties": {
        "id": {
          "enum": [
            "substrate_version",
            "issuer_unique",
            "snapshot_bucket",
            "openfga_grants",
            "callout_registered",
            "ingress_clients",
            "actor_service_routes",
            "api_access_label"
          ]
        },
        "status": {
          "enum": [
            "pass",
            "warn",
            "fail",
            "skip"
          ]
        },
        "message": {
          "type": "string",
          "description": "For the administrator; kept on the cluster."
        },
        "edge_case": {
          "type": "string",
          "pattern": "^E[0-9]{1,2}$",
          "description": "The plan edge case the check guards (E1 actor routes, E2 proxy takeover, E10 snapshots, E13 issuer)."
        }
      }
    }
  },
  "examples": [
    {
      "schema_version": 1,
      "command": "verify",
      "management_contract": 1,
      "product_version": "1.0.10",
      "generated_at": "2026-11-13T15:04:05Z",
      "cluster": {
        "cluster_name": "dc-substrate-e1",
        "namespace": "defenseclaw-system",
        "issuer_sha256": "4b0f3f5c0a8a5b1e8d2c2f6b0d7f7d8a9e0c1b2a3f4e5d6c7b8a9f0e1d2c3b4a",
        "issuer_default": true,
        "substrate_version": "1.0.0",
        "substrate_version_supported": true,
        "supported_versions": ">=1.0.0 <1.1.0"
      },
      "ok": true,
      "checks": [
        {
          "id": "substrate_version",
          "status": "pass",
          "message": "ok"
        },
        {
          "id": "issuer_unique",
          "status": "warn",
          "message": "the default issuer is fine for one cluster; set a unique one before adding another",
          "edge_case": "E13"
        },
        {
          "id": "snapshot_bucket",
          "status": "pass",
          "message": "ok"
        },
        {
          "id": "openfga_grants",
          "status": "pass",
          "message": "ok"
        },
        {
          "id": "callout_registered",
          "status": "pass",
          "message": "ok"
        },
        {
          "id": "ingress_clients",
          "status": "pass",
          "message": "ok"
        },
        {
          "id": "actor_service_routes",
          "status": "pass",
          "message": "ok"
        },
        {
          "id": "api_access_label",
          "status": "pass",
          "message": "ok"
        }
      ]
    }
  ]
}
