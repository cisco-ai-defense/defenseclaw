{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "defenseclaw-substrate chart values",
  "type": "object",
  "additionalProperties": false,
  "definitions": {
    "resources": {
      "type": "object"
    },
    "port": {
      "type": "integer",
      "minimum": 1,
      "maximum": 65535
    },
    "hpa": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "minReplicas",
        "maxReplicas"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "minReplicas": {
          "type": "integer",
          "minimum": 2
        },
        "maxReplicas": {
          "type": "integer",
          "minimum": 2
        },
        "targetCPUUtilizationPercentage": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        }
      }
    },
    "pdb": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "minAvailable": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "args": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "dnsLabel": {
      "type": "string",
      "pattern": "^[a-z0-9]([-a-z0-9]{0,61}[a-z0-9])?$"
    }
  },
  "properties": {
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository"
      ],
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "tag": {
          "type": "string"
        },
        "digest": {
          "type": "string",
          "pattern": "^(sha256:[a-f0-9]{64})?$"
        },
        "pullPolicy": {
          "enum": [
            "Always",
            "IfNotPresent",
            "Never"
          ]
        }
      }
    },
    "imagePullSecrets": {
      "type": "array"
    },
    "substrate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "namespace",
        "apiAddress",
        "apiAudience",
        "egressSpiffeId",
        "egressPodLabels"
      ],
      "properties": {
        "namespace": {
          "$ref": "#/definitions/dnsLabel"
        },
        "apiAddress": {
          "type": "string",
          "pattern": "^[a-z0-9.-]+:[0-9]{1,5}$"
        },
        "apiAudience": {
          "type": "string",
          "minLength": 1
        },
        "egressSpiffeId": {
          "type": "string",
          "pattern": "^spiffe://"
        },
        "egressPodLabels": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "string"
          }
        },
        "actorKeys": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "url": {
              "type": "string",
              "pattern": "^(https://[^?#\\s]+)?$"
            },
            "caConfigMap": {
              "anyOf": [
                {
                  "const": ""
                },
                {
                  "$ref": "#/definitions/dnsLabel"
                }
              ]
            }
          }
        },
        "credentialProvider": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "grant": {
              "type": "boolean"
            },
            "policyConfigMap": {
              "type": "string",
              "minLength": 1
            },
            "deployment": {
              "type": "string",
              "minLength": 1
            },
            "secretsNamespace": {
              "$ref": "#/definitions/dnsLabel"
            },
            "createUserSecretsNamespace": {
              "type": "boolean"
            }
          }
        },
        "podPorts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "integer",
            "minimum": 1,
            "maximum": 65535
          }
        },
        "router": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "address": {
              "type": "string",
              "pattern": "^$|^[A-Za-z0-9.-]+:[0-9]{1,5}$"
            },
            "serverName": {
              "type": "string"
            },
            "caFile": {
              "type": "string"
            },
            "podPort": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65535
            },
            "relayPort": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65535
            }
          }
        },
        "launcher": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "keyReplay": {
              "type": "string",
              "pattern": "^\\s*([Aa][Ss][Kk]|[Oo][Nn]|[Oo][Ff][Ff])?\\s*$"
            }
          }
        },
        "files": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "push": {
              "type": "boolean"
            },
            "sync": {
              "type": "boolean"
            }
          }
        },
        "git": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "httpsRewrite": {
              "type": "array",
              "maxItems": 64,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "from",
                  "to"
                ],
                "properties": {
                  "from": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 256,
                    "pattern": "^[^\\s\"\\\\]+[:/]$"
                  },
                  "to": {
                    "type": "string",
                    "maxLength": 256,
                    "pattern": "^https://[^\\s\"\\\\@]+/$"
                  }
                }
              }
            },
            "submodules": {
              "type": "boolean"
            },
            "lfs": {
              "type": "boolean"
            },
            "pushBranch": {
              "type": "string",
              "pattern": "^\\s*([Aa][Ll][Ll][Oo][Ww]|[Aa][Ss][Kk]|[Dd][Ee][Nn][Yy])?\\s*$"
            }
          }
        }
      }
    },
    "deploymentMode": {
      "type": "string",
      "enum": [
        "",
        "managed_enterprise",
        "unmanaged_byod",
        "ci_cd",
        "server"
      ]
    },
    "managed": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "serviceAccountName": {
          "type": "string",
          "minLength": 1
        },
        "dataSizeLimit": {
          "type": "string",
          "pattern": "^[0-9]+(Mi|Gi)$"
        }
      }
    },
    "config": {
      "type": "object",
      "description": "DefenseClaw config.yaml; the config schema (schemas/config) validates it in the pre-upgrade hook.",
      "properties": {
        "substrate": {
          "type": "object",
          "properties": {
            "launcher_atespaces": {
              "type": "object",
              "additionalProperties": {
                "type": "array",
                "items": {
                  "$ref": "#/definitions/dnsLabel"
                }
              }
            },
            "identity": {
              "type": "object",
              "properties": {
                "issuer": {
                  "type": "string",
                  "pattern": "^https://"
                },
                "revocation": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "enabled": {"type": "boolean"},
                    "sync_interval": {"type": "string", "pattern": "^[0-9]+(ms|s|m)$"},
                    "max_stale": {"type": "string", "pattern": "^[0-9]+(ms|s|m|h)$", "description": "at least 2 x sync_interval, at most 1h"},
                    "max_tokens_per_person": {"type": "integer", "minimum": 1, "maximum": 4096}
                  }
                }
              }
            },
            "launcher": {
              "type": "object",
              "properties": {
                "upload_scan": {
                  "type": "object",
                  "additionalProperties": false,
                  "description": "The secret scan of a project copy before upload (Linux and macOS launchers). secret_action hold_back is the admin-off switch for in-source replacement.",
                  "properties": {
                    "max_file_bytes": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 67108864
                    },
                    "time_budget": {
                      "type": "string"
                    },
                    "secret_action": {
                      "type": "string",
                      "enum": [
                        "replace",
                        "hold_back"
                      ]
                    },
                    "placeholder_form": {
                      "type": "string",
                      "enum": [
                        "token",
                        "env"
                      ]
                    }
                  }
                },
                "key_replay": {
                  "type": "string",
                  "pattern": "^\\s*([Aa][Ss][Kk]|[Oo][Nn]|[Oo][Ff][Ff])?\\s*$"
                }
              }
            },
            "files": {
              "type": "object",
              "properties": {
                "push": {
                  "type": "boolean"
                },
                "sync": {
                  "type": "boolean"
                }
              }
            },
            "git": {
              "type": "object",
              "properties": {
                "https_rewrite": {
                  "type": "array",
                  "maxItems": 64,
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "from",
                      "to"
                    ],
                    "properties": {
                      "from": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 256,
                        "pattern": "^[^\\s\"\\\\]+[:/]$"
                      },
                      "to": {
                        "type": "string",
                        "maxLength": 256,
                        "pattern": "^https://[^\\s\"\\\\@]+/$"
                      }
                    }
                  }
                },
                "submodules": {
                  "type": "boolean"
                },
                "lfs": {
                  "type": "boolean"
                },
                "push_branch": {
                  "type": "string",
                  "pattern": "^\\s*([Aa][Ll][Ll][Oo][Ww]|[Aa][Ss][Kk]|[Dd][Ee][Nn][Yy])?\\s*$"
                }
              }
            }
          }
        }
      }
    },
    "managedAtespaces": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/dnsLabel"
      },
      "uniqueItems": true
    },
    "podCertificates": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        }
      }
    },
    "gateway": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "replicas": {
          "type": "integer",
          "minimum": 2
        },
        "hpa": {
          "$ref": "#/definitions/hpa"
        },
        "pdb": {
          "$ref": "#/definitions/pdb"
        },
        "ports": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "actor": {
              "$ref": "#/definitions/port"
            },
            "admin": {
              "$ref": "#/definitions/port"
            },
            "metrics": {
              "$ref": "#/definitions/port"
            }
          }
        },
        "args": {
          "$ref": "#/definitions/args"
        },
        "resources": {
          "$ref": "#/definitions/resources"
        },
        "nodeSelector": {
          "type": "object"
        },
        "tolerations": {
          "type": "array"
        },
        "affinity": {
          "type": "object"
        },
        "relaySessionSecret": {
          "type": "string",
          "minLength": 1
        },
        "relayCASecret": {
          "type": "string",
          "minLength": 1
        },
        "authDelegatorBinding": {
          "type": "string",
          "maxLength": 63
        },
        "llmCredentialsSecret": {
          "type": "string",
          "minLength": 1
        },
        "extraArgs": {
          "$ref": "#/definitions/args"
        },
        "adminGroups": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "oidcCA": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "configMap": {
              "type": "string"
            },
            "key": {
              "type": "string",
              "minLength": 1,
              "pattern": "^[-._a-zA-Z0-9]+$"
            },
            "secret": {
              "type": "string"
            }
          }
        },
        "extraEnv": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "extraVolumes": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "extraVolumeMounts": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "skillScanner": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "image": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "repository"
              ],
              "properties": {
                "repository": {
                  "type": "string",
                  "minLength": 1
                },
                "tag": {
                  "type": "string"
                },
                "digest": {
                  "type": "string",
                  "pattern": "^(sha256:[a-f0-9]{64})?$"
                }
              }
            },
            "resources": {
              "$ref": "#/definitions/resources"
            }
          }
        }
      }
    },
    "leader": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "leaseName": {
          "$ref": "#/definitions/dnsLabel"
        },
        "port": {
          "$ref": "#/definitions/port"
        },
        "store": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "size": {
              "type": "string",
              "pattern": "^[0-9]+(Mi|Gi|Ti)$"
            },
            "storageClassName": {
              "type": "string"
            },
            "keepOnUninstall": {
              "type": "boolean"
            }
          }
        },
        "args": {
          "$ref": "#/definitions/args"
        },
        "resources": {
          "$ref": "#/definitions/resources"
        },
        "nodeSelector": {
          "type": "object"
        },
        "tolerations": {
          "type": "array"
        },
        "affinity": {
          "type": "object"
        }
      }
    },
    "controller": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "args": {
          "$ref": "#/definitions/args"
        },
        "resources": {
          "$ref": "#/definitions/resources"
        },
        "nodeSelector": {
          "type": "object"
        },
        "tolerations": {
          "type": "array"
        },
        "affinity": {
          "type": "object"
        },
        "templateAnchorsSecret": {
          "type": "string"
        },
        "templateRegistrySecret": {
          "type": "string"
        }
      }
    },
    "callout": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "hpa": {
          "$ref": "#/definitions/hpa"
        },
        "replicas": {
          "type": "integer",
          "minimum": 2
        },
        "pdb": {
          "$ref": "#/definitions/pdb"
        },
        "port": {
          "$ref": "#/definitions/port"
        },
        "ports": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "health": {
              "$ref": "#/definitions/port"
            }
          }
        },
        "args": {
          "$ref": "#/definitions/args"
        },
        "resources": {
          "$ref": "#/definitions/resources"
        },
        "nodeSelector": {
          "type": "object"
        },
        "tolerations": {
          "type": "array"
        },
        "affinity": {
          "type": "object"
        },
        "judge": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "tokenSecret": {
              "type": "string"
            }
          }
        },
        "actorSecrets": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "secretName": {
              "type": "string"
            }
          }
        }
      }
    },
    "serviceAccounts": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "apiTokenExpirationSeconds": {
          "type": "integer",
          "minimum": 600,
          "maximum": 86400
        },
        "annotations": {
          "type": "object"
        },
        "componentAnnotations": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "gateway": {
              "type": "object"
            },
            "controller": {
              "type": "object"
            },
            "callout": {
              "type": "object"
            }
          }
        }
      }
    },
    "networkPolicy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "adminFrom": {
          "type": "array"
        },
        "egress": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "otlpPorts": {
              "type": "array",
              "items": {
                "type": "integer",
                "minimum": 1,
                "maximum": 65535
              }
            },
            "extra": {
              "type": "array"
            }
          }
        }
      }
    },
    "admin": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "expose": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "ClusterIP",
                "LoadBalancer",
                "Ingress"
              ]
            },
            "loadBalancer": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "sourceRanges": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "pattern": "^[0-9a-fA-F:.]+/[0-9]{1,3}$"
                  }
                },
                "annotations": {
                  "type": "object"
                }
              }
            },
            "ingress": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "className": {
                  "type": "string"
                },
                "host": {
                  "type": "string"
                },
                "tlsSecretName": {
                  "type": "string"
                },
                "annotations": {
                  "type": "object"
                }
              }
            }
          }
        },
        "tlsSecretName": {
          "type": "string"
        },
        "url": {
          "type": "string"
        }
      }
    },
    "bootstrap": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "ownerTokenSecret": {
          "type": "string"
        },
        "deleteTokenAfterUse": {
          "type": "boolean"
        },
        "backoffLimit": {
          "type": "integer",
          "minimum": 0
        },
        "resources": {
          "$ref": "#/definitions/resources"
        }
      }
    },
    "hooks": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "backoffLimit": {
          "type": "integer",
          "minimum": 0
        },
        "activeDeadlineSeconds": {
          "type": "integer",
          "minimum": 60
        },
        "resources": {
          "$ref": "#/definitions/resources"
        }
      }
    },
    "clusterName": {
      "type": "string",
      "maxLength": 253
    },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "prometheusRule": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "labels": {
              "type": "object"
            },
            "namespaceLabel": {
              "type": "string",
              "pattern": "^([a-zA-Z_][a-zA-Z0-9_]*)?$"
            }
          }
        }
      }
    },
    "observability": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "redactionProfile": {
          "type": "string",
          "minLength": 1
        },
        "local": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "image": {
              "type": "string"
            },
            "resources": {
              "$ref": "#/definitions/resources"
            }
          }
        },
        "tokenomics": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "defaultPricing": {
              "type": "boolean"
            }
          }
        }
      }
    },
    "podSecurityContext": {
      "type": "object"
    },
    "containerSecurityContext": {
      "type": "object"
    },
    "podAnnotations": {
      "type": "object"
    },
    "podLabels": {
      "type": "object"
    },
    "homeSizeLimit": {
      "type": "string",
      "pattern": "^[0-9]+(Mi|Gi)$"
    },
    "homeMedium": {
      "type": "string",
      "enum": [
        "",
        "Memory"
      ]
    },
    "bundles": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "anchorsSecret": {
          "type": "string",
          "minLength": 1,
          "maxLength": 253
        },
        "inbox": {
          "type": "string",
          "minLength": 1,
          "maxLength": 253
        },
        "oci": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "stages": {
              "type": "array",
              "maxItems": 8,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["stage", "ref"],
                "properties": {
                  "stage": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 63
                  },
                  "ref": {
                    "type": "string",
                    "pattern": "^[^@:]+(:[0-9]{1,5})?(/[^@:/]+)+@sha256:[a-f0-9]{64}$"
                  },
                  "atespaces": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 63
                    }
                  }
                }
              }
            },
            "timeout": {
              "type": "string",
              "pattern": "^(|[0-9]+(\\.[0-9]+)?(s|m))$"
            },
            "authHosts": {
              "type": "array",
              "maxItems": 16,
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 253,
                "pattern": "^[A-Za-z0-9]([A-Za-z0-9-]*[A-Za-z0-9])?(\\.[A-Za-z0-9]([A-Za-z0-9-]*[A-Za-z0-9])?)+(:[0-9]{1,5})?$"
              }
            },
            "credentialsSecret": {
              "type": "string",
              "maxLength": 253
            },
            "ca": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "configMap": {
                  "type": "string",
                  "maxLength": 253
                },
                "secret": {
                  "type": "string",
                  "maxLength": 253
                },
                "key": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 253
                }
              }
            }
          }
        }
      }
    }
  }
}
