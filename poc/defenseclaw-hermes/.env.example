# DefenseClaw POC — Environment Variables
# Copy to .env and fill in your values.

# Required: LLM provider API key (OpenAI, or any OpenAI-compatible)
LLM_API_KEY=sk-your-openai-key-here

# Optional: custom LLM endpoint (default: https://api.openai.com/v1)
# For Circuit API: https://chat-ai.cisco.com/pulse-circuit-api/openai
# LLM_API_BASE=https://api.openai.com/v1

# Internal auth key (auto-generated if left as default)
DEFENSECLAW_MASTER_KEY=sk-defenseclaw-poc

# Debug: set to true for verbose LiteLLM logs
# LITELLM_VERBOSE=false
