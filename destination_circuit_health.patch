// TestDestinationCircuitTransitionV8DebugEmitError is a temporary diagnostic
// test to surface the actual error from emitDestinationCircuitTransitionV8
// (normally discarded by the caller) while root-causing a test failure.
// Remove before opening the PR.
func TestDestinationCircuitTransitionV8DebugEmitError(t *testing.T) {
	runtime, _ := newProxyGeneratedTraceRuntime(t)
	ctx, _ := platformHealthCorrelatedContext(t)

	err := emitDestinationCircuitTransitionV8(
		ctx, runtime, time.Now().UTC(), "soc_primary", "splunk_hec",
		delivery.CircuitOpen, 3, delivery.FailureClassTransient,
	)
	if err != nil {
		t.Fatalf("emitDestinationCircuitTransitionV8 returned error: %v", err)
	}
}
