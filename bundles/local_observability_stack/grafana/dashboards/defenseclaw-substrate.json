{
  "annotations": {
    "list": []
  },
  "description": "DefenseClaw on Agent Substrate: control-plane health (policy lag, unattested templates, policy conflicts, idle suspends, rate limiting), hook, resume and leader latency, actor lifecycle by trigger and phase, and egress through the callout (decisions, bodies read, secrets injected, blocked requests). Metrics carry no actor, atespace or person label; names appear only in the log panels.",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "liveNow": false,
  "links": [
    {
      "title": "Overview",
      "type": "link",
      "url": "/d/defenseclaw-overview?${__url_time_range}",
      "icon": "external link",
      "targetBlank": false
    },
    {
      "title": "Sandboxes",
      "type": "link",
      "url": "/d/defenseclaw-sandboxes?${__url_time_range}",
      "icon": "external link",
      "targetBlank": false
    },
    {
      "title": "Agent 360",
      "type": "link",
      "url": "/d/defenseclaw-agent-360?${__url_time_range}",
      "icon": "external link",
      "targetBlank": false
    }
  ],
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Control plane health",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Policy lag p99 (s)",
      "description": "99th percentile of the time from a policy or profile change to the egress policy being active, from defenseclaw.substrate.policy_lag. Alert: over 10 s for 10 minutes. The metric has no actor, atespace or person label.",
      "datasource": {
        "type": "prometheus",
        "uid": "defenseclaw-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "defenseclaw-prometheus"
          },
          "expr": "histogram_quantile(0.99, sum by (le) (rate(defenseclaw_substrate_policy_lag_seconds_bucket{deployment_environment_name=~\"$environment\"}[$__range])))",
          "refId": "A",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "decimals": 1,
          "noValue": "0",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 5
              },
              {
                "color": "red",
                "value": 10
              }
            ]
          },
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Unattested templates",
      "description": "Agent Substrate templates DefenseClaw has seen without a valid attestation. Actors from them have no network. Zero is healthy.",
      "datasource": {
        "type": "prometheus",
        "uid": "defenseclaw-prometheus"
      },
      "gridPos": {
        "x": 4,
        "y": 1,
        "w": 4,
        "h": 4
