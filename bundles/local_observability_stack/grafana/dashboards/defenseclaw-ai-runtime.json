{
  "uid": "defenseclaw-ai-runtime",
  "title": "DefenseClaw \u2014 AI Discovery Runtime Planes",
  "description": "What actually ran, next to AI Discovery's inventory of what is present. Coverage is the first row on purpose: findings from a blinded host must not be read as a clean result.",
  "tags": [
    "defenseclaw",
    "ai-discovery",
    "runtime"
  ],
  "editable": true,
  "graphTooltip": 1,
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "preload": false,
  "liveNow": false,
  "timezone": "browser",
  "weekStart": "",
  "fiscalYearStartMonth": 0,
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "timepicker": {},
  "annotations": {
    "list": []
  },
  "templating": {
    "list": []
  },
  "links": [
    {
      "title": "AI Discovery",
      "type": "link",
      "url": "/d/defenseclaw-ai-discovery?${__url_time_range}",
      "icon": "external link",
      "targetBlank": false
    },
    {
      "title": "Overview",
      "type": "link",
      "url": "/d/defenseclaw-overview?${__url_time_range}",
      "icon": "external link",
      "targetBlank": false
    },
    {
      "title": "Agent Identity",
      "type": "link",
      "url": "/d/defenseclaw-agent-identity?${__url_time_range}",
      "icon": "external link",
      "targetBlank": false
    }
  ],
  "panels": [
    {
      "type": "row",
      "title": "Coverage \u2014 can this host see anything?",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "collapsed": false
    },
    {
      "type": "stat",
      "title": "Planes not running",
      "description": "Selected planes that are not producing observations. Any non-zero value means findings from this host are incomplete. A detector reporting clean because it was never able to look is indistinguishable, on a dashboard, from a host that is genuinely clean \u2014 which is why this tile is first.",
      "datasource": {
        "type": "loki",
        "uid": "defenseclaw-loki"
      },
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 3,
        "h": 5
      },
      "targets": [
        {
          "expr": "count(sum by (body_defenseclaw_ai_runtime_plane) (count_over_time(({service_name=\"defenseclaw\"} | json | __error__=\"\" | event_name=\"ai.runtime.plane_health\" | body_defenseclaw_ai_runtime_plane_running=\"false\")[5m]))) or vector(0)",
          "refId": "A",
          "instant": true,
          "datasource": {
            "type": "loki",
            "uid": "defenseclaw-loki"
          }
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "area"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              },
              {
                "color": "red",
                "value": 2
              }
            ]
          }
        }
      }
    },
    {
      "type": "stat",
      "title": "Processes observed",
      "description": "Processes inspected in the latest runtime poll. This remains useful evidence when no process crosses the finding threshold.",
      "datasource": {
        "type": "loki",
        "uid": "defenseclaw-loki"
      },
      "gridPos": {
        "x": 3,
        "y": 1,
        "w": 3,
        "h": 5
      },
      "targets": [
        {
          "expr": "max(max_over_time(({service_name=\"defenseclaw\"} | json | __error__=\"\" | event_name=\"ai.runtime.plane_health\" | unwrap body_defenseclaw_ai_runtime_processes_observed)[5m]))",
          "refId": "A",
          "instant": true,
          "datasource": {
            "type": "loki",
            "uid": "defenseclaw-loki"
          }
        }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "value",
        "graphMode": "area"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "orange", "value": null },
              { "color": "green", "value": 1 }
            ]
          }
        }
      }
    },
    {
      "type": "stat",
      "title": "Connections observed",
      "description": "Network connections inspected in the latest runtime poll, including ordinary traffic that did not produce a finding.",
      "datasource": {
        "type": "loki",
        "uid": "defenseclaw-loki"
      },
      "gridPos": {
        "x": 6,
        "y": 1,
        "w": 3,
        "h": 5
      },
      "targets": [
        {
          "expr": "max(max_over_time(({service_name=\"defenseclaw\"} | json | __error__=\"\" | event_name=\"ai.runtime.plane_health\" | unwrap body_defenseclaw_ai_runtime_connections_observed)[5m]))",
          "refId": "A",
          "instant": true,
          "datasource": {
            "type": "loki",
            "uid": "defenseclaw-loki"
          }
        }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "value",
        "graphMode": "area"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "orange", "value": null },
              { "color": "green", "value": 1 }
            ]
          }
        }
      }
    },
    {
      "type": "stat",
      "title": "Unattributable connections",
      "description": "Outbound connections observed with no owning process. On an unprivileged POSIX host this is how much of the machine's egress cannot be named \u2014 the difference between a quiet host and a blind sensor. Windows reports the owning pid in every row, so a non-zero value there means something else.",
      "datasource": {
        "type": "loki",
        "uid": "defenseclaw-loki"
      },
      "gridPos": {
        "x": 9,
        "y": 1,
        "w": 3,
        "h": 5
      },
      "targets": [
        {
          "expr": "max(max_over_time(({service_name=\"defenseclaw\"} | json | __error__=\"\" | event_name=\"ai.runtime.plane_health\" | unwrap body_defenseclaw_ai_runtime_connections_unattributed)[5m]))",
          "refId": "A",
          "instant": true,
          "datasource": {
            "type": "loki",
            "uid": "defenseclaw-loki"
          }
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "area"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              }
            ]
          }
        }
      }
    },
    {
      "type": "stat",
      "title": "Processes not fully readable",
      "description": "Processes this run could see but not fully read. Non-zero is ordinary on an unprivileged run and is a coverage statement rather than an error.",
      "datasource": {
        "type": "loki",
        "uid": "defenseclaw-loki"
      },
      "gridPos": {
        "x": 12,
        "y": 1,
        "w": 3,
        "h": 5
      },
      "targets": [
        {
          "expr": "max(max_over_time(({service_name=\"defenseclaw\"} | json | __error__=\"\" | event_name=\"ai.runtime.plane_health\" | unwrap body_defenseclaw_ai_runtime_processes_skipped)[5m]))",
          "refId": "A",
          "instant": true,
          "datasource": {
            "type": "loki",
            "uid": "defenseclaw-loki"
          }
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "area"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "blue",
                "value": 1
              }
            ]
          }
        }
      }
    },
    {
      "type": "stat",
      "title": "Partial poll cycles",
      "description": "Cycles reported with outcome `partial` rather than `completed`. A degraded poll is never reported as a complete one, so this counts exactly the cycles whose findings must be read as incomplete.",
      "datasource": {
        "type": "loki",
        "uid": "defenseclaw-loki"
      },
      "gridPos": {
        "x": 15,
        "y": 1,
        "w": 3,
        "h": 5
      },
      "targets": [
        {
          "expr": "max(count_over_time(({service_name=\"defenseclaw\"} | json | __error__=\"\" | event_name=\"ai.runtime.plane_health\" | outcome=\"partial\")[5m])) or vector(0)",
          "refId": "A",
          "instant": true,
          "datasource": {
            "type": "loki",
            "uid": "defenseclaw-loki"
          }
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "area"
      },
      "fieldConfig": {
        "defaults": {
          "noValue": "No partial polls",
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              }
            ]
          }
        }
      }
    },
    {
      "type": "stat",
      "title": "Plane C events classified",
      "description": "Kernel observations classified into an AI-agent tactic during the latest Plane C poll. This is useful positive evidence even when no observation becomes a finding.",
      "datasource": {
        "type": "loki",
        "uid": "defenseclaw-loki"
      },
      "gridPos": {
        "x": 18,
        "y": 1,
        "w": 3,
        "h": 5
      },
      "targets": [
        {
          "expr": "max(max_over_time(({service_name=\"defenseclaw\"} | json | __error__=\"\" | event_name=\"ai.runtime.plane_health\" | unwrap body_defenseclaw_ai_runtime_host_plane_observations)[5m]))",
          "refId": "A",
          "instant": true,
          "datasource": {
            "type": "loki",
            "uid": "defenseclaw-loki"
          }
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "area"
      },
      "fieldConfig": {
        "defaults": {
          "noValue": "No Plane C poll data",
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "orange",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        }
      }
    },
    {
      "type": "stat",
      "title": "Plane C events gated",
      "description": "Kernel observations excluded because they were outside a discovered AI-agent process lineage. This shows how much host noise Plane C filtered without exporting process or payload content.",
      "datasource": {
        "type": "loki",
        "uid": "defenseclaw-loki"
      },
      "gridPos": {
        "x": 21,
        "y": 1,
        "w": 3,
        "h": 5
      },
      "targets": [
        {
          "expr": "max(max_over_time(({service_name=\"defenseclaw\"} | json | __error__=\"\" | event_name=\"ai.runtime.plane_health\" | unwrap body_defenseclaw_ai_runtime_host_plane_gated)[5m]))",
          "refId": "A",
          "instant": true,
          "datasource": {
            "type": "loki",
            "uid": "defenseclaw-loki"
          }
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "area"
      },
      "fieldConfig": {
        "defaults": {
          "noValue": "No Plane C poll data",
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        }
      }
    },
    {
      "type": "logs",
      "title": "Plane health \u2014 every plane, every cycle",
      "description": "One record per plane per cycle, emitted whether the plane is up or down. If health were reported only while a plane worked, a dead subscription would leave no trace, and absence is the hardest thing to alert on. `body_defenseclaw_ai_runtime_plane_reason` names the mechanism when running and the remediation when not.",
      "datasource": {
        "type": "loki",
        "uid": "defenseclaw-loki"
      },
      "gridPos": {
        "x": 0,
        "y": 6,
        "w": 14,
        "h": 9
      },
      "targets": [
        {
          "expr": "{service_name=\"defenseclaw\"} | json | __error__=\"\" | event_name=\"ai.runtime.plane_health\"",
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "defenseclaw-loki"
          }
        }
      ],
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "dedupStrategy": "none",
        "enableLogDetails": true,
        "sortOrder": "Descending"
      },
      "fieldConfig": {
        "defaults": {
          "noValue": "No plane health samples in range"
        },
        "overrides": []
      }
    },
    {
      "type": "table",
      "title": "Plane C source \u2014 which backend, and what it lost",
      "description": "The process backend behind Plane C per host: the DefenseClaw-side `native` sources (cn_proc, fanotify) or the host's own Tetragon read by the root sensor helper. Events lost comes from the backend's own counters and shows `unknown` when they could not be read. Container events were counted and kept out of host agent sessions.",
      "datasource": {
        "type": "loki",
        "uid": "defenseclaw-loki"
      },
      "gridPos": {
        "x": 14,
        "y": 6,
        "w": 10,
        "h": 9
      },
      "targets": [
        {
          "expr": "sum by (host_name, backend, mechanism) (count_over_time(({service_name=\"defenseclaw\"} | json | __error__=\"\" | event_name=\"ai.runtime.plane_health\" | body_defenseclaw_ai_runtime_plane=\"c\" | label_format backend=\"{{.body_defenseclaw_ai_runtime_plane_backend}}\", mechanism=\"{{.body_defenseclaw_ai_runtime_plane_mechanism}}\")[$__range]))",
          "refId": "CYCLES",
          "datasource": {
            "type": "loki",
            "uid": "defenseclaw-loki"
          },
          "instant": true,
          "queryType": "instant"
        },
        {
          "expr": "max by (host_name, backend, mechanism) (max_over_time(({service_name=\"defenseclaw\"} | json | __error__=\"\" | event_name=\"ai.runtime.plane_health\" | body_defenseclaw_ai_runtime_plane=\"c\" | body_defenseclaw_ai_runtime_loss_known=\"true\" | label_format backend=\"{{.body_defenseclaw_ai_runtime_plane_backend}}\", mechanism=\"{{.body_defenseclaw_ai_runtime_plane_mechanism}}\" | unwrap body_defenseclaw_ai_runtime_events_lost | __error__=\"\")[$__range]))",
          "refId": "LOST",
          "datasource": {
            "type": "loki",
            "uid": "defenseclaw-loki"
          },
          "instant": true,
          "queryType": "instant"
        },
        {
          "expr": "sum by (host_name, backend, mechanism) (sum_over_time(({service_name=\"defenseclaw\"} | json | __error__=\"\" | event_name=\"ai.runtime.plane_health\" | body_defenseclaw_ai_runtime_plane=\"c\" | label_format backend=\"{{.body_defenseclaw_ai_runtime_plane_backend}}\", mechanism=\"{{.body_defenseclaw_ai_runtime_plane_mechanism}}\" | unwrap body_defenseclaw_ai_runtime_container_events | __error__=\"\")[$__range]))",
          "refId": "CONTAINER",
          "datasource": {
            "type": "loki",
            "uid": "defenseclaw-loki"
          },
          "instant": true,
          "queryType": "instant"
        }
      ],
      "transformations": [
        {
          "id": "renameByRegex",
          "options": {
            "regexp": "Value #(\\w+)",
            "renamePattern": "$1"
          }
        },
        {
          "id": "merge"
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "renameByName": {
              "host_name": "Host",
              "backend": "Backend",
              "mechanism": "Mechanism",
              "CYCLES": "Cycles",
              "LOST": "Events lost",
              "CONTAINER": "Container events"
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "No Plane C poll data",
          "custom": {
            "align": "left"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Events lost"
            },
            "properties": [
              {
                "id": "noValue",
                "value": "unknown"
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true
      }
    },
    {
      "type": "row",
      "title": "Findings \u2014 what actually ran",
      "gridPos": {
        "x": 0,
        "y": 15,
        "w": 24,
        "h": 1
      },
      "collapsed": false
    },
    {
      "type": "timeseries",
      "title": "Findings by severity",
      "description": "Scored runtime findings over time, banded. No single host-plane tactic reaches high on its own; a high or critical band means several observations combined, or a kill chain progressed.",
      "datasource": {
        "type": "loki",
        "uid": "defenseclaw-loki"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "sum by (body_defenseclaw_ai_runtime_severity) (count_over_time(({service_name=\"defenseclaw\"} | json | __error__=\"\" | event_name=\"ai.runtime.finding\")[$__interval]))",
          "refId": "A",
          "legendFormat": "{{body_defenseclaw_ai_runtime_severity}}",
          "datasource": {
            "type": "loki",
            "uid": "defenseclaw-loki"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "No runtime findings in range",
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10
          }
        }
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "type": "timeseries",
      "title": "Inventory agreement",
      "description": "How the discovery inventory answered each finding. `unaccounted` is the interesting reading: a complete scan that explains none of what the runtime planes are watching. `unobserved` means there was no usable inventory and the score was left untouched in both directions.",
      "datasource": {
        "type": "loki",
        "uid": "defenseclaw-loki"
      },
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "sum by (body_defenseclaw_ai_runtime_correlation_verdict) (count_over_time(({service_name=\"defenseclaw\"} | json | __error__=\"\" | event_name=\"ai.runtime.finding\")[$__interval]))",
          "refId": "A",
          "legendFormat": "{{body_defenseclaw_ai_runtime_correlation_verdict}}",
          "datasource": {
            "type": "loki",
            "uid": "defenseclaw-loki"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "No runtime findings to correlate",
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10
          }
        }
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "type": "logs",
      "title": "Runtime findings",
      "description": "One record per scored finding. `body_defenseclaw_ai_runtime_signals` is the evidence trail behind the score, rendered signal_id=weight. `body_defenseclaw_ai_runtime_cmdline` and `..._providers` are content-class fields, so whether they appear here depends on the redaction profile this destination selected.",
      "datasource": {
        "type": "loki",
        "uid": "defenseclaw-loki"
      },
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 24,
        "h": 10
      },
      "targets": [
        {
          "expr": "{service_name=\"defenseclaw\"} | json | __error__=\"\" | event_name=\"ai.runtime.finding\"",
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "defenseclaw-loki"
          }
        }
      ],
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "dedupStrategy": "none",
        "enableLogDetails": true,
        "sortOrder": "Descending"
      },
      "fieldConfig": {
        "defaults": {
          "noValue": "No runtime findings in range"
        },
        "overrides": []
      }
    },
    {
      "type": "row",
      "title": "Host plane \u2014 what an agent did to the machine",
      "gridPos": {
        "x": 0,
        "y": 34,
        "w": 24,
        "h": 1
      },
      "collapsed": false
    },
    {
      "type": "timeseries",
      "title": "Tactics by stage",
      "description": "Observed host-plane tactics, in kill-chain order. Every one is gated on an AI agent appearing in the process lineage: a developer running sudo produces nothing here, the same sudo under an agent produces a signal. Renders empty unless the host plane is enabled, which is worth knowing before reading an empty row as a clean host.",
      "datasource": {
        "type": "loki",
        "uid": "defenseclaw-loki"
      },
      "gridPos": {
        "x": 0,
        "y": 35,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "sum by (body_defenseclaw_ai_runtime_tactic) (count_over_time(({service_name=\"defenseclaw\"} | json | __error__=\"\" | event_name=\"ai.runtime.activity\")[$__interval]))",
          "refId": "A",
          "legendFormat": "{{body_defenseclaw_ai_runtime_tactic}}",
          "datasource": {
            "type": "loki",
            "uid": "defenseclaw-loki"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "No Plane C tactics in range",
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10
          }
        }
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "type": "timeseries",
      "title": "Tactics by responsible agent",
      "description": "The same observations grouped by the agent the lineage attributed them to, which is what turns \"something read a credential\" into \"this agent read a credential\".",
      "datasource": {
        "type": "loki",
        "uid": "defenseclaw-loki"
      },
      "gridPos": {
        "x": 12,
        "y": 35,
        "w": 12,
        "h": 8
      },
