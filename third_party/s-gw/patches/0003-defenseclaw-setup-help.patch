Subject: [PATCH 3/7] Keep restricted setup help side-effect free

---
 src/cli.ts                        | 21 +++++------
 tests/defenseclaw-runtime.test.ts | 61 ++++++++++++++++++++++++++++++-
 2 files changed, 70 insertions(+), 12 deletions(-)

diff --git a/src/cli.ts b/src/cli.ts
index 08f6f72..63b0f69 100644
--- a/src/cli.ts
+++ b/src/cli.ts
@@ -96,7 +96,7 @@ async function main(): Promise<void> {
   }
 
   if (first === "setup" && (second === "-h" || hasFlag(parsed.flags, "help"))) {
-    printSetupHelp();
+    printRestrictedSetupHelp();
     return;
   }
 
@@ -2374,19 +2374,18 @@ Approval and authorization changes are available through:
 `);
 }
 
-function printSetupHelp(): void {
-  process.stdout.write(`Usage: s-gw setup [options]
+function printRestrictedSetupHelp(): void {
+  process.stdout.write(`Usage: s-gw setup --no-open-console --no-service --no-menubar --no-agents
 
-Initialize the local credential store and install the requested desktop integrations.
+Configure the credential store for the restricted DefenseClaw runtime.
+
+Required options:
+  --no-open-console                  DefenseClaw owns the approval console
+  --no-service                       DefenseClaw owns the credential service lifecycle
+  --no-menubar                       DefenseClaw does not install the s-gw menu-bar helper
+  --no-agents                        DefenseClaw manages agent integration
 
 Options:
-  --port PORT                         Console port (default: 8718)
-  --passphrase-stdin                  Read the unlock passphrase from stdin
-  --menubar-count MODE               pending, credentials, or none
-  --no-open-app                      Do not open the native app
-  --no-service                       Do not install or start the console service
-  --no-menubar                       Do not install or start the menu-bar helper
-  --no-agents                        Do not configure detected coding agents
   -h, --help                         Show this help and exit
 `);
 }
