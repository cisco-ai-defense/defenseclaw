     expect(cli.indexOf("rejectDefenseClawAuthorizationMutation(first, second, third, parsed.flags)")).toBeLessThan(
       cli.indexOf("const store = new SecretStore()")
     );
@@ -76,6 +81,60 @@ describe("DefenseClaw local console launch", () => {
     expect(tsconfig).toContain('"src/console-server.ts"');
   });
 
+  it.each(["--help", "-h"])("prints restricted setup help for %s without side effects", async (helpFlag) => {
+    const tmpDir = await mkdtemp(path.join(os.tmpdir(), "sgw-defenseclaw-setup-help-"));
+    const home = path.join(tmpDir, "home");
+    const recoveryHome = path.join(tmpDir, "recovery");
+    const trapDir = path.join(tmpDir, "bin");
+    const sideEffectMarker = path.join(tmpDir, "service-or-ui-command-ran");
+
+    try {
+      await mkdir(trapDir);
+      if (process.platform !== "win32") {
+        const trap = `#!/bin/sh\nprintf '%s\\n' "$0" >> '${sideEffectMarker}'\nexit 97\n`;
+        for (const command of ["launchctl", "open", "systemctl", "xdg-open"]) {
+          const commandPath = path.join(trapDir, command);
+          await writeFile(commandPath, trap, { mode: 0o755 });
+          await chmod(commandPath, 0o755);
+        }
+      }
+
+      const result = spawnSync(
+        process.execPath,
+        [tsxCli, path.join(repoRoot, "src", "cli.ts"), "setup", helpFlag],
+        {
+          cwd: repoRoot,
+          encoding: "utf8",
+          env: {
+            ...process.env,
+            PATH: `${trapDir}${path.delimiter}${process.env.PATH || ""}`,
+            SGW_DISABLE_KEYCHAIN: "1",
+            SGW_DISABLE_ONEPASSWORD_BACKUP: "1",
+            SGW_DISABLE_UPDATE_CHECK: "1",
+            SGW_HOME: home,
+            SGW_MASTER_PASSPHRASE: "synthetic-defenseclaw-setup-help-passphrase",
+            SGW_RECOVERY_HOME: recoveryHome,
+            SGW_TEST_HOME_ROOT: tmpDir,
+            SGW_TEST_MODE: "1"
+          },
+          timeout: 10_000
+        }
+      );
+
+      expect(result.status).toBe(0);
+      expect(result.stderr).toBe("");
+      expect(result.stdout).toContain(
+        "Usage: s-gw setup --no-open-console --no-service --no-menubar --no-agents"
+      );
+      expect(result.stdout).toContain("restricted DefenseClaw runtime");
+      await expect(access(home)).rejects.toThrow();
+      await expect(access(recoveryHome)).rejects.toThrow();
+      await expect(access(sideEffectMarker)).rejects.toThrow();
+    } finally {
+      await rm(tmpDir, { recursive: true, force: true });
+    }
+  });
+
   it("rejects approval and authorization mutations before creating store state", async () => {
