-      stdio: ["ignore", "ignore", "pipe"]
-    });
-
-    if (result.error) {
-      throw result.error;
-    }
-    if (result.status === 0) {
-      return true;
-    }
-    if (result.status === 44) {
-      return false;
-    }
-    throw new Error(result.stderr.trim() || `Keychain inspector failed with status ${result.status}`);
+    if (info.provider === "security-cli") return keychainItemExistsWithSecurityCli(info);
+    throw missingCredentialStoreError();
