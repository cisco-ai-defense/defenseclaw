new file mode 100644
index 0000000..44b2872
--- /dev/null
+++ b/src/trusted-windows-command.ts
@@ -0,0 +1,22 @@
+import { lstatSync, realpathSync } from "node:fs";
+import path from "node:path";
+import { trustedWindowsPowerShellSync } from "./windows-system.js";
+
+export function trustedWindowsPowershell(): string {
+  const candidate = process.env.SGW_TRUSTED_POWERSHELL;
+  if (!candidate || !path.win32.isAbsolute(candidate)) {
+    throw new Error("The trusted Windows PowerShell path is unavailable.");
+  }
+
+  const resolved = realpathSync(candidate);
+  const systemPowershell = trustedWindowsPowerShellSync();
+  if (path.win32.normalize(resolved).toLowerCase() !== path.win32.normalize(candidate).toLowerCase()
+    || path.win32.normalize(resolved).toLowerCase() !== path.win32.normalize(systemPowershell).toLowerCase()) {
+    throw new Error("The trusted Windows PowerShell path changed during validation.");
+  }
+  const info = lstatSync(candidate);
+  if (info.isSymbolicLink() || !info.isFile()) {
+    throw new Error("The trusted Windows PowerShell path is unsafe.");
+  }
+  return systemPowershell;
+}
