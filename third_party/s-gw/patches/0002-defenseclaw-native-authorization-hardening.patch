+async function allowCommandAsNativeFixture(handle: string, command: string): Promise<void> {
+  const names = ["SGW_HOME", "SGW_RECOVERY_HOME", "SGW_MASTER_PASSPHRASE", "SGW_DISABLE_KEYCHAIN"];
+  const previous = new Map(names.map((name) => [name, process.env[name]]));
+
+  try {
+    for (const name of names) {
+      process.env[name] = testEnv[name];
+    }
+    await new SecretStore(tmpHome).allowCommand(handle, command);
+  } finally {
+    for (const [name, value] of previous) {
+      if (value === undefined) {
+        delete process.env[name];
+      } else {
+        process.env[name] = value;
+      }
+    }
+  }
+}
