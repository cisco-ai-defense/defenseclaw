+  it("rejects command authorization on every enrollment alias before creating store state", async () => {
+    const rejectedRoutes = [
+      ["secret", "add", "--allow-command", "/usr/bin/env"],
+      ["secret", "add-keychain", "--allow-command=/usr/bin/env"],
+      ["secret", "add-kc", "--allow-command", "/usr/bin/env"],
+      ["secret", "add-1password", "--allow-command=/usr/bin/env"],
+      ["secret", "add-op", "--allow-command", "/usr/bin/env"],
+      ["onepassword", "import", "--allow-command=/usr/bin/env"],
+      ["onepassword", "capture", "--allow-command", "/usr/bin/env"],
+      ["guard", "run", "Codex", "--allow-command=/usr/bin/env"],
+      ["run", "Codex", "--allow-command", "/usr/bin/env"],
+      ["secret", "add", "--allow-command"]
+    ];
+
+    for (const [index, route] of rejectedRoutes.entries()) {
+      const tmpDir = await mkdtemp(path.join(os.tmpdir(), `sgw-native-command-auth-${index}-`));
+      const home = path.join(tmpDir, "home");
+      const recoveryHome = path.join(tmpDir, "recovery");
+
+      try {
+        const result = spawnSync(tsxBin, [path.join(repoRoot, "src", "cli.ts"), ...route], {
+          cwd: repoRoot,
+          encoding: "utf8",
+          env: {
+            ...process.env,
+            SGW_DISABLE_KEYCHAIN: "1",
+            SGW_DISABLE_ONEPASSWORD_BACKUP: "1",
+            SGW_DISABLE_UPDATE_CHECK: "1",
+            SGW_HOME: home,
+            SGW_RECOVERY_HOME: recoveryHome,
+            SGW_TEST_HOME_ROOT: tmpDir,
+            SGW_TEST_MODE: "1"
+          },
+          timeout: 10_000
+        });
+
+        expect(result.status, route.join(" ")).not.toBe(0);
+        expect(result.stderr, route.join(" ")).toContain("DefenseClaw owns authenticated approval and authorization changes");
+        await expect(access(home), route.join(" ")).rejects.toThrow();
+        await expect(access(recoveryHome), route.join(" ")).rejects.toThrow();
+      } finally {
+        await rm(tmpDir, { recursive: true, force: true });
+      }
+    }
+  }, 30_000);
+
   it("stores a generated Linux unlock key through the Secret Service helper", async () => {
     const tmpDir = await mkdtemp(path.join(os.tmpdir(), "sgw-linux-setup-"));
     const helperPath = path.join(tmpDir, "s-gw-secret-service-helper");
@@ -152,6 +220,7 @@ describe("DefenseClaw local console launch", () => {
