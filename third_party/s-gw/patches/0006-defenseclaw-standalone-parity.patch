 3 files changed, 74 insertions(+), 7 deletions(-)

diff --git a/src/cli.ts b/src/cli.ts
index 63b0f69..ca34be5 100644
--- a/src/cli.ts
+++ b/src/cli.ts
@@ -2253,6 +2253,10 @@ function rejectDefenseClawAuthorizationMutation(
   third: string | undefined,
   flags: Record<string, string | boolean | string[]>
 ): void {
+  if (first === "__windows-login-start") {
+    throw nativeAuthorizationGuidance();
+  }
+
   if (Object.prototype.hasOwnProperty.call(flags, "allow-command")) {
     throw nativeAuthorizationGuidance();
   }
diff --git a/src/trusted-windows-command.ts b/src/trusted-windows-command.ts
index 44b2872..c9b8a6b 100644
--- a/src/trusted-windows-command.ts
+++ b/src/trusted-windows-command.ts
@@ -1,4 +1,4 @@
-import { lstatSync, realpathSync } from "node:fs";
+import { closeSync, constants, fstatSync, lstatSync, openSync, realpathSync } from "node:fs";
 import path from "node:path";
 import { trustedWindowsPowerShellSync } from "./windows-system.js";
 
@@ -9,14 +9,35 @@ export function trustedWindowsPowershell(): string {
   }
 
   const resolved = realpathSync(candidate);
-  const systemPowershell = trustedWindowsPowerShellSync();
-  if (path.win32.normalize(resolved).toLowerCase() !== path.win32.normalize(candidate).toLowerCase()
-    || path.win32.normalize(resolved).toLowerCase() !== path.win32.normalize(systemPowershell).toLowerCase()) {
+  if (path.win32.normalize(resolved).toLowerCase() !== path.win32.normalize(candidate).toLowerCase()) {
     throw new Error("The trusted Windows PowerShell path changed during validation.");
   }
   const info = lstatSync(candidate);
   if (info.isSymbolicLink() || !info.isFile()) {
     throw new Error("The trusted Windows PowerShell path is unsafe.");
   }
+
+  const systemPowershell = trustedWindowsPowerShellSync();
+  const systemInfo = lstatSync(systemPowershell);
+  if (systemInfo.isSymbolicLink() || !systemInfo.isFile()
+    || !sameFile(candidate, systemPowershell)) {
+    throw new Error("The trusted Windows PowerShell path changed during validation.");
+  }
   return systemPowershell;
 }
+
+function sameFile(candidate: string, systemPowershell: string): boolean {
+  const candidateFd = openSync(candidate, constants.O_RDONLY);
+  let systemFd: number | undefined;
+  try {
+    systemFd = openSync(systemPowershell, constants.O_RDONLY);
+    const candidateInfo = fstatSync(candidateFd, { bigint: true });
+    const systemInfo = fstatSync(systemFd, { bigint: true });
+    return systemInfo.ino !== 0n
+      && candidateInfo.dev === systemInfo.dev
+      && candidateInfo.ino === systemInfo.ino;
+  } finally {
+    closeSync(candidateFd);
+    if (systemFd !== undefined) closeSync(systemFd);
+  }
+}
