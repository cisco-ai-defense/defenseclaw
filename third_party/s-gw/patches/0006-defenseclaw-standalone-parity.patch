     expect(sshAcl).not.toContain('spawn("powershell.exe"');
   });
 
+  it.skipIf(process.platform !== "win32")(
+    "binds the host PowerShell path to the kernel-anchored executable",
+    async () => {
+      const windowsRoot = process.env.SystemRoot?.trim();
+      if (!windowsRoot) throw new Error("SystemRoot is unavailable in the Windows test environment.");
+
+      const candidate = path.win32.join(
+        windowsRoot,
+        "System32",
+        "WindowsPowerShell",
+        "v1.0",
+        "powershell.exe"
+      );
+      const expected = candidate;
+      const tmpDir = await mkdtemp(path.join(os.tmpdir(), "sgw-defenseclaw-powershell-"));
+      const decoy = path.join(tmpDir, "powershell.exe");
+      const testMode = process.env.SGW_TEST_MODE;
+      const trusted = process.env.SGW_TRUSTED_POWERSHELL;
+
+      try {
+        delete process.env.SGW_TEST_MODE;
+        process.env.SGW_TRUSTED_POWERSHELL = candidate;
+        expect(trustedWindowsPowershell()).toBe(expected);
+
+        await copyFile(process.execPath, decoy);
+        process.env.SGW_TRUSTED_POWERSHELL = decoy;
+        expect(() => trustedWindowsPowershell()).toThrow(/changed during validation/i);
+      } finally {
+        if (testMode === undefined) delete process.env.SGW_TEST_MODE;
+        else process.env.SGW_TEST_MODE = testMode;
+        if (trusted === undefined) delete process.env.SGW_TRUSTED_POWERSHELL;
+        else process.env.SGW_TRUSTED_POWERSHELL = trusted;
+        await rm(tmpDir, { recursive: true, force: true });
+      }
+    }
+  );
+
   it("contains no TypeScript proxy-tokenizer or approval mutation fallback", async () => {
